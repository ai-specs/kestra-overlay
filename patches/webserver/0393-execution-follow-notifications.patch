+
+const {useCoreStore} = await import("../../../src/stores/core")
+describe("follow notification ownership", () => {
+    beforeEach(() => {setActivePinia(createPinia());followExecutionMock.mockReset()})
+    it.each([401, 403, 404, undefined])("classifies actual follow status %s", async status => {
+        followExecutionMock.mockImplementation(async (_params, options) => {
+            if(status) await options.fetch(new Request("http://localhost/follow"))
+            throw new Error("stream failed")
+        })
+        const fetchMock=vi.spyOn(globalThis,"fetch").mockResolvedValue(new Response(null,{status:status ?? 200}))
+        const store=useExecutionsStore();const core=useCoreStore()
+        store.followExecution({id:"exec-1"}, key=>key)
+        await vi.waitFor(()=>expect(core.message).toBeDefined())
+        expect(core.message?.content).toBe(status === 404 ? "errors.404.flow or execution" : status ? `errors.${status}.content` : "something_went_wrong.loading_execution")
+        store.closeSSE();expect(core.message).toBeUndefined();fetchMock.mockRestore()
+    })
+    it("cleans only the owned error on unmount",async()=>{
+        followExecutionMock.mockRejectedValue(new Error("offline"))
+        const store=useExecutionsStore();const core=useCoreStore()
+        store.followExecution({id:"exec-1"},key=>key)
+        await vi.waitFor(()=>expect(core.message).toBeDefined())
+        core.message={title:"another error"};store.closeSSE()
+        expect(core.message?.title).toBe("another error")
+    })
+    it("expires only its own error within eight seconds", async()=>{
+        vi.useFakeTimers()
+        try {
+            followExecutionMock.mockRejectedValue(new Error("offline"))
+            const store=useExecutionsStore();const core=useCoreStore()
+            store.followExecution({id:"exec-1"},key=>key)
+            await vi.advanceTimersByTimeAsync(0)
+            expect(core.message?.duration).toBe(8000)
+            await vi.advanceTimersByTimeAsync(8000)
+            expect(core.message).toBeUndefined()
+            store.closeSSE()
+        } finally {vi.useRealTimers()}
+    })
+    it("clears an owned error when following again",async()=>{
+        followExecutionMock.mockRejectedValue(new Error("offline"))
+        const store=useExecutionsStore();const core=useCoreStore()
+        store.followExecution({id:"exec-1"},key=>key)
+        await vi.waitFor(()=>expect(core.message).toBeDefined())
+        followExecutionMock.mockImplementation(fakeFollowStream([{sseId:"end",execution:{id:"exec-1",state:{current:"SUCCESS"}}}]))
+        store.followExecution({id:"exec-1"},key=>key)
+        await vi.waitFor(()=>expect(core.message).toBeUndefined())
+        store.closeSSE()
+    })
+
+})
