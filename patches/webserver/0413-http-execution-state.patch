+    private static io.kestra.core.models.flows.State.Type preparedStateType(Execution execution) {
+        var state = execution.getState();
+        if (state == null || state.getCurrent() == null || state.getCurrent() == io.kestra.core.models.flows.State.Type.CREATED
+            || state.getCurrent() == io.kestra.core.models.flows.State.Type.RESTARTED) return null;
+        if (state.getCurrent() == io.kestra.core.models.flows.State.Type.FAILED) return state.getCurrent();
+        throw new IllegalArgumentException("Unsupported prepared execution state: " + state.getCurrent());
+    }
