@@ -0,0 +1,80 @@
+package io.kestra.webserver.oidc.services;
+
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.OptionalLong;
+import javax.sql.DataSource;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.data.connection.jdbc.advice.DelegatingDataSource;
+import jakarta.inject.Singleton;
+
+@Singleton
+@Requires(property = "kestra.oidc.enabled", value = "true")
+public final class OidcIdentityLifecycle {
+    public static final String CLAIM = "authentication_version";
+    private final DataSource source;
+    public OidcIdentityLifecycle(DataSource source) { this.source = DelegatingDataSource.unwrapDataSource(source); }
+    public OptionalLong activeVersion(String subject) {
+        try (var connection = source.getConnection()) { return activeVersion(connection, subject); }
+        catch (SQLException failure) { throw new IllegalStateException("Cannot validate identity lifecycle"); }
+    }
+    public static OptionalLong activeVersion(Connection connection, String subject) throws SQLException {
+        try (var statement = connection.prepareStatement("SELECT authentication_version FROM oidc_user WHERE username=? AND user_state='ACTIVE'")) {
+            statement.setString(1, subject);
+            try (var rows = statement.executeQuery()) { return rows.next() ? OptionalLong.of(rows.getLong(1)) : OptionalLong.empty(); }
+        }
+    }
+    public boolean matches(String subject, Object claim) {
+        if (claim != null && !(claim instanceof Number)) return false;
+        long version;
+        try { version = claim == null ? 0 : new java.math.BigDecimal(claim.toString()).longValueExact(); }
+        catch (ArithmeticException | NumberFormatException invalid) { return false; }
+        var active = activeVersion(subject);
+        return active.isPresent() && active.getAsLong() == version;
+    }
+
+    public boolean machineSubject(String subject) {
+        try (var connection = source.getConnection(); var statement = connection.prepareStatement(
+            "SELECT EXISTS(SELECT 1 FROM oidc_client WHERE client_id=? AND client_kind='system' AND active),"
+            + "EXISTS(SELECT 1 FROM oidc_user WHERE username=?)")) {
+            statement.setString(1, subject); statement.setString(2, subject);
+            try (var rows = statement.executeQuery()) { return rows.next() && rows.getBoolean(1) && !rows.getBoolean(2); }
+        } catch (SQLException failure) { throw new IllegalStateException("Cannot validate machine identity"); }
+    }
+
+    public void bindAuthorizationCode(String code, String subject, long version) {
+        try (var connection = source.getConnection()) {
+            connection.setAutoCommit(false);
+            try {
+                try (var lock = connection.prepareStatement("SELECT authentication_version FROM oidc_user WHERE username=? AND user_state='ACTIVE' FOR SHARE")) {
+                    lock.setString(1, subject);
+                    try (var rows = lock.executeQuery()) {
+                        if (!rows.next() || rows.getLong(1) != version) throw new io.kestra.webserver.oidc.OidcException(com.nimbusds.oauth2.sdk.OAuth2Error.INVALID_GRANT);
+                    }
+                }
+                try (var statement = connection.prepareStatement("UPDATE oidc_authorization_code SET authentication_version=? WHERE code=? AND subject=? AND NOT used")) {
+                    statement.setLong(1, version); statement.setString(2, code); statement.setString(3, subject);
+                    if (statement.executeUpdate() != 1) throw new io.kestra.webserver.oidc.OidcException(com.nimbusds.oauth2.sdk.OAuth2Error.INVALID_GRANT);
+                }
+                connection.commit();
+            } catch (RuntimeException | SQLException failure) { connection.rollback(); throw failure; }
+        } catch (SQLException failure) { throw new IllegalStateException("Cannot bind authorization identity"); }
+    }
+    public OptionalLong authenticate(String subject, String password) {
+        if (subject == null || password == null) return OptionalLong.empty();
+        try (var connection = source.getConnection(); var statement = connection.prepareStatement(
+            "SELECT u.authentication_version,a.credential FROM oidc_user u JOIN oidc_user_auth_method a ON a.user_id=u.username "
+            + "WHERE u.username=? AND u.user_state='ACTIVE' AND a.type='PASSWORD' AND a.state='ACTIVE'")) {
+            statement.setString(1, subject);
+            long version;
+            try (var rows = statement.executeQuery()) {
+                if (!rows.next() || !org.mindrot.jbcrypt.BCrypt.checkpw(password, rows.getString(2))) return OptionalLong.empty();
+                version = rows.getLong(1);
+            }
+            try (var update = connection.prepareStatement("UPDATE oidc_user SET last_login_at=now() WHERE username=? AND authentication_version=? AND user_state='ACTIVE'")) {
+                update.setString(1, subject); update.setLong(2, version);
+                return update.executeUpdate() == 1 ? OptionalLong.of(version) : OptionalLong.empty();
+            }
+        } catch (SQLException failure) { throw new IllegalStateException("Cannot authenticate identity lifecycle"); }
+    }
+}
