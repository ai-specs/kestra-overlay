+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class OidcAccountLifecycleGuardTest {
+    private static final String ISSUER="https://issuer.example";
+    private static final String FIND="SELECT username,name,email,user_state,directory_revision FROM oidc_user WHERE username=?";
+    private static final String UPDATE="UPDATE oidc_user SET user_state=COALESCE(?,user_state),directory_revision=directory_revision+1,authentication_version=authentication_version+1,updated_at=now() WHERE username=? AND directory_revision=?";
+    private static final String PASSWORD="INSERT INTO oidc_user_auth_method(user_id,type,credential) VALUES (?,'PASSWORD',?) ON CONFLICT(user_id,type) DO UPDATE SET credential=EXCLUDED.credential,state='ACTIVE',updated_at=now()";
+    private final DataSource source=mock(DataSource.class);
+    private final Connection connection=mock(Connection.class);
+    private final BeanProvider<IdentityLifecycleGuardV1> guards=mock(BeanProvider.class);
+    private final IdentityLifecycleGuardV1 guard=mock(IdentityLifecycleGuardV1.class);
+    private final OidcProtocolStateV1 protocol=mock(OidcProtocolStateV1.class);
+
+    private OidcUserDirectory directory(boolean enabled)throws Exception {
+        when(source.getConnection()).thenReturn(connection);when(guards.isUnique()).thenReturn(true);when(guards.get()).thenReturn(guard);
+        var configuration=new OidcConfiguration();configuration.setIssuer(ISSUER);
+        return new OidcUserDirectory(source,guards,protocol,configuration,enabled);
+    }
+
+    private ResultSet user()throws Exception {
+        var statement=mock(PreparedStatement.class);var result=mock(ResultSet.class);
+        when(connection.prepareStatement(FIND)).thenReturn(statement);when(statement.executeQuery()).thenReturn(result);when(result.next()).thenReturn(true);
+        when(result.getString("username")).thenReturn("alice");when(result.getString("name")).thenReturn("Alice");
+        when(result.getString("email")).thenReturn("alice@example.invalid");when(result.getString("user_state")).thenReturn("ACTIVE");
+        when(result.getLong("directory_revision")).thenReturn(4L,5L);return result;
+    }
+
+    private PreparedStatement mutation(String sql)throws Exception {
+        var statement=mock(PreparedStatement.class);when(connection.prepareStatement(sql)).thenReturn(statement);when(statement.executeUpdate()).thenReturn(1);return statement;
+    }
+
+    private void noMutation()throws Exception {
+        verify(connection,never()).prepareStatement(argThat(sql->sql.startsWith("UPDATE ") || sql.startsWith("INSERT ") || sql.startsWith("DELETE ")));
+        verify(connection,never()).commit();
+    }
+
+    @Test void accountDeactivationLocksAndGuardsBeforeAllStandardMutations()throws Exception {
+        var directory=directory(true);user();var update=mutation(UPDATE);
+        var tokens=mutation("UPDATE oidc_token SET revoked=true WHERE subject=?");var codes=mutation("UPDATE oidc_authorization_code SET used=true WHERE subject=?");
+        assertEquals(5,directory.setActive("alice",4,false).revision());
+        var order=inOrder(connection,protocol,guard,update,tokens,codes);
+        order.verify(connection).setTransactionIsolation(Connection.TRANSACTION_READ_COMMITTED);order.verify(connection).setAutoCommit(false);
+        order.verify(protocol).lockSecurityState(connection);order.verify(connection).prepareStatement(FIND);
+        order.verify(guard).beforeChange(connection,new IdentityLifecycleGuardV1.Change(IdentityLifecycleGuardV1.Kind.ACCOUNT_DEACTIVATE,ISSUER,"alice",null));
+        order.verify(update).executeUpdate();order.verify(tokens).executeUpdate();order.verify(codes).executeUpdate();order.verify(connection).commit();order.verify(connection).close();
+        verify(source).getConnection();
+    }
+
+    @Test void rejectedGuardPreservesItsReasonAndCannotTouchCredentialsTokensOrCodes()throws Exception {
+        var directory=directory(true);user();
+        var rejection=new IdentityLifecycleGuardV1.Rejected(IdentityLifecycleGuardV1.Failure.LAST_ADMIN);
+        doThrow(rejection).when(guard).beforeChange(eq(connection),any());
+        assertSame(rejection,assertThrows(IdentityLifecycleGuardV1.Rejected.class,()->directory.setActive("alice",4,false)));
+        verify(connection).rollback();verify(connection).close();noMutation();
+    }
+
+    @Test void missingOrDuplicateGuardFailsClosedWithoutAnyIdentityMutation()throws Exception {
+        var directory=directory(true);when(guards.isUnique()).thenReturn(false);
+        assertEquals(IdentityLifecycleGuardV1.Failure.UNAVAILABLE,
+            assertThrows(IdentityLifecycleGuardV1.Rejected.class,()->directory.setActive("alice",4,false)).failure());
+        verifyNoInteractions(protocol,guard);noMutation();verify(connection).rollback();
+    }
+
+    @Test void staleRevisionIsCheckedUnderTheSecurityLockBeforeCallingTheGuard()throws Exception {
+        var directory=directory(true);user();
+        assertEquals(UserDirectoryV1.Failure.CONFLICT,assertThrows(UserDirectoryV1.DirectoryException.class,()->directory.setActive("alice",3,false)).failure());
+        verify(protocol).lockSecurityState(connection);verifyNoInteractions(guard);noMutation();
+    }
+
+    @Test void passwordResetUsesTheSameGuardAndConnectionBeforeChangingAuthenticationState()throws Exception {
+        var directory=directory(true);user();var update=mutation(UPDATE);var password=mutation(PASSWORD);
+        mutation("UPDATE oidc_token SET revoked=true WHERE subject=?");mutation("UPDATE oidc_authorization_code SET used=true WHERE subject=?");
+        assertEquals(5,directory.resetPassword("alice",4,"TestPassword123!").revision());
+        var order=inOrder(guard,update,password,connection);
+        order.verify(guard).beforeChange(connection,new IdentityLifecycleGuardV1.Change(IdentityLifecycleGuardV1.Kind.PASSWORD_RESET,ISSUER,"alice",null));
+        order.verify(update).executeUpdate();order.verify(password).executeUpdate();order.verify(connection).commit();verify(source).getConnection();
+    }
+
+    @Test void unexpectedGuardFailureRollsBackAndFeatureOffKeepsStandardAccountLifecycle()throws Exception {
+        var directory=directory(true);user();doThrow(new SQLException("guard unavailable")).when(guard).beforeChange(eq(connection),any());
