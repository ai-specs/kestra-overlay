+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+import static org.junit.jupiter.api.Assertions.*;
+
+class UserDirectoryContractTest extends OidcPostgresTestBase {
+    private OidcUserDirectory directory;
+    private OidcUserService users;
+    private String subject;
+    @BeforeEach void prepare() {
+        directory = new OidcUserDirectory(dataSource());
+        users = new OidcUserService(dataSource(), new ObjectMapper());
+        subject = "directory-" + UUID.randomUUID();
+    }
+    private UserDirectoryV1.User create() { return directory.create(subject, "Initial", "initial@example.invalid", "InitialPassword123!"); }
+    private void failure(UserDirectoryV1.Failure expected, Runnable action) {
+        assertEquals(expected, assertThrows(UserDirectoryV1.DirectoryException.class, action::run).failure());
+    }
+    @Test void duplicateCreatePreservesCredentialsAndRoles() {
+        create();
+        failure(UserDirectoryV1.Failure.CONFLICT, () -> directory.create(subject, "Other", "other@example.invalid", "OtherPassword123!"));
+        assertTrue(users.validateCredentials(subject, "InitialPassword123!"));
+        assertFalse(users.validateCredentials(subject, "OtherPassword123!"));
+        assertTrue(users.bySubject(subject).orElseThrow().roles().isEmpty());
+        assertEquals("Initial", directory.find(subject).orElseThrow().name());
+    }
+    @Test void profileUpdateHasCompareAndSetAndNoAuthenticationChange() {
+        var initial = create();
+        var lifecycle = new OidcIdentityLifecycle(dataSource());
+        var sessions = new OidcSessionService(new OidcConfiguration(), lifecycle);
+        String session = sessions.create(subject);
+        var changed = directory.update(subject, initial.revision(), "Changed", "changed@example.invalid");
+        assertEquals(initial.revision() + 1, changed.revision());
+        failure(UserDirectoryV1.Failure.CONFLICT, () -> directory.update(subject, initial.revision(), "Stale", "stale@example.invalid"));
+        assertEquals("Changed", directory.find(subject).orElseThrow().name());
+        assertEquals(subject, sessions.subject(session).orElseThrow());
+        assertTrue(lifecycle.matches(subject, 0L));
+        assertTrue(lifecycle.matches(subject, null));
+        assertFalse(lifecycle.matches(subject, 0.5));
+        assertFalse(lifecycle.matches(subject, "0"));
+    }
+    @Test void resetInvalidatesSessionCookieAndAllStoredTokens() throws Exception {
+        var initial = create();
+        var configuration = new OidcConfiguration();
+        var lifecycle = new OidcIdentityLifecycle(dataSource());
+        var sessions = new OidcSessionService(configuration, lifecycle);
+        String session = sessions.create(subject);
+        var tokens = new OidcTokenService(dataSource(), new ObjectMapper(), configuration, new OidcJwkService(dataSource()));
+        String client = "client-" + UUID.randomUUID();
+        try (var connection = dataSource().getConnection(); var statement = connection.prepareStatement(
+            "INSERT INTO oidc_client(client_id,client_kind) VALUES (?,'system')")) {
+            statement.setString(1, client); statement.executeUpdate();
+        }
+        String access = tokens.issueAccessToken(client, subject, "Initial", null, List.of(), new Scope("openid")).getValue();
+        String refresh = tokens.issueRefreshToken(client, subject, new Scope("openid")).getValue();
+        var oldId = tokens.issueIdToken(client, subject, "Initial", null, List.of(), null);
+        var codes = new io.kestra.webserver.oidc.services.OidcAuthorizationCodeService(dataSource(), new ObjectMapper(), configuration);
+        String code = codes.create(client, subject, "http://localhost/callback", List.of("openid"), null, null, null).getValue();
+        var changed = directory.resetPassword(subject, initial.revision(), "NewPassword123!");
+        assertTrue(sessions.subject(session).isEmpty());
+        assertFalse(sessions.extend(session));
+        assertThrows(OidcException.class, () -> tokens.validateAccessToken(access));
+        assertThrows(OidcException.class, () -> tokens.validateRefreshToken(refresh, client));
+        assertThrows(OidcException.class, () -> codes.consume(code, client, "http://localhost/callback", null));
+        assertFalse(lifecycle.matches(subject, oldId.getJWTClaimsSet().getClaim(OidcIdentityLifecycle.CLAIM)));
+        assertTrue(users.validateCredentials(subject, "NewPassword123!"));
+        assertFalse(users.validateCredentials(subject, "InitialPassword123!"));
+        assertEquals(initial.revision() + 1, changed.revision());
+        assertEquals(1L, tokens.issueIdToken(client, subject, "Initial", null, List.of(), null).getJWTClaimsSet()
+            .getLongClaim(OidcIdentityLifecycle.CLAIM));
+        assertThrows(OidcException.class, () -> tokens.issueAuthorizationTokens(client, users.bySubject(subject).orElseThrow(),
+            new Scope("openid"), null, null, code));
+        assertThrows(OidcException.class, () -> codes.createForSession(0, client, subject,
+            "http://localhost/callback", List.of("openid"), null, null, null));
+    }
+    @Test void reactivationDoesNotReviveOldIdentity() {
+        var initial = create();
+        var lifecycle = new OidcIdentityLifecycle(dataSource());
+        var sessions = new OidcSessionService(new OidcConfiguration(), lifecycle);
+        String session = sessions.create(subject);
+        var inactive = directory.setActive(subject, initial.revision(), false);
+        assertFalse(users.validateCredentials(subject, "InitialPassword123!"));
+        var active = directory.setActive(subject, inactive.revision(), true);
+        assertTrue(active.active());
+        assertTrue(sessions.subject(session).isEmpty());
+        assertFalse(lifecycle.matches(subject, 0L));
+        assertTrue(lifecycle.matches(subject, 2L));
+    }
+    @Test void paginationAndSerializedResultsHaveNoSecrets() throws Exception {
+        long total = directory.list(1, 100).total();
+        create();
+        assertEquals(total + 1, directory.list(1, 100).total());
+        assertTrue(directory.list(1_000_000, 100).items().isEmpty());
+        String serialized = new ObjectMapper().writeValueAsString(directory.find(subject).orElseThrow());
+        assertFalse(serialized.contains("password"));
+        assertFalse(serialized.contains("roles"));
+        assertFalse(serialized.contains("credential"));
+        failure(UserDirectoryV1.Failure.INVALID, () -> directory.list(0, 20));
+        failure(UserDirectoryV1.Failure.INVALID, () -> directory.list(1, 101));
+    }
+    @Test void invalidAndMissingMutationsHaveNoSideEffects() {
+        failure(UserDirectoryV1.Failure.INVALID, () -> directory.create(subject, "Initial", "initial@example.invalid", "short"));
+        assertTrue(directory.find(subject).isEmpty());
+        var initial = create();
+        failure(UserDirectoryV1.Failure.INVALID, () -> directory.resetPassword(subject, initial.revision(), "界".repeat(25)));
+        assertTrue(users.validateCredentials(subject, "InitialPassword123!"));
+        failure(UserDirectoryV1.Failure.NOT_FOUND, () -> directory.setActive("missing-" + subject, 0, false));
+        failure(UserDirectoryV1.Failure.CONFLICT, () -> directory.resetPassword(subject, 99, "UnwantedPassword123!"));
+        assertTrue(users.validateCredentials(subject, "InitialPassword123!"));
+    }
+    @Test void concurrentWritersHaveOneWinner() {
+        var initial = create();
+        var successes = new AtomicInteger();
+        var conflicts = new AtomicInteger();
+        try (var executor = Executors.newFixedThreadPool(2)) {
+            var start = new CompletableFuture<Void>();
+            var writes = List.of("First", "Second").stream().map(name -> CompletableFuture.runAsync(() -> {
+                start.join();
+                try { directory.update(subject, initial.revision(), name, "changed@example.invalid"); successes.incrementAndGet(); }
+                catch (UserDirectoryV1.DirectoryException failure) {
+                    assertEquals(UserDirectoryV1.Failure.CONFLICT, failure.failure()); conflicts.incrementAndGet();
+                }
+            }, executor)).toList();
+            start.complete(null);
+            CompletableFuture.allOf(writes.toArray(CompletableFuture[]::new)).join();
+        }
+        assertEquals(1, successes.get()); assertEquals(1, conflicts.get());
+    }
+    @Test void cookieLifecycleFilterDeniesStaleButPreservesForeignIssuer() {
+        var initial = create();
+        var configuration = new OidcConfiguration();
+        var filter = new OidcIdentityLifecycleFilter(configuration, new OidcIdentityLifecycle(dataSource()));
+        var request = HttpRequest.GET("/api/v1/configs");
+        request.setAttribute(SecurityFilter.AUTHENTICATION,
+            Authentication.build(subject, List.of(), Map.of("iss", configuration.getIssuer(), OidcIdentityLifecycle.CLAIM, 0L)));
+        assertEquals(200, Mono.from(filter.doFilter(request, ignored -> Mono.just(HttpResponse.ok()))).block().code());
+        directory.resetPassword(subject, initial.revision(), "RotatedPassword123!");
+        assertEquals(401, Mono.from(filter.doFilter(request, ignored -> { throw new AssertionError("stale identity reached handler"); })).block().code());
+        for (String path : List.of("/oidc/logout", "/oidc/login", "/oauth/login/kestra", "/oauth/callback/kestra")) {
+            var protocol = HttpRequest.GET(path);
+            protocol.setAttribute(SecurityFilter.AUTHENTICATION, request.getAttribute(SecurityFilter.AUTHENTICATION, Authentication.class).orElseThrow());
+            assertEquals(200, Mono.from(filter.doFilter(protocol, ignored -> Mono.just(HttpResponse.ok()))).block().code());
+        }
+        var stalePage = HttpRequest.GET("/ui/main/flows");
+        stalePage.setAttribute(SecurityFilter.AUTHENTICATION, request.getAttribute(SecurityFilter.AUTHENTICATION, Authentication.class).orElseThrow());
+        assertEquals(307, Mono.from(filter.doFilter(stalePage, ignored -> { throw new AssertionError("stale page reached handler"); })).block().code());
+        request.setAttribute(SecurityFilter.AUTHENTICATION,
+            Authentication.build(subject, List.of(), Map.of("iss", "https://external.example.invalid")));
+        assertEquals(200, Mono.from(filter.doFilter(request, ignored -> Mono.just(HttpResponse.ok()))).block().code());
+    }
+    @Test void credentialFailureRollsBackAccountCreation() throws Exception {
+        String identifier = "probe_" + UUID.randomUUID().toString().replace("-", "");
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("CREATE FUNCTION " + identifier + "() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF NEW.user_id='"
+                + subject + "' THEN RAISE EXCEPTION 'controlled credential failure'; END IF; RETURN NEW; END $$");
+            statement.execute("CREATE TRIGGER " + identifier + " BEFORE INSERT ON oidc_user_auth_method FOR EACH ROW EXECUTE FUNCTION " + identifier + "()");
+            try {
+                failure(UserDirectoryV1.Failure.UNAVAILABLE, this::create);
+                assertTrue(directory.find(subject).isEmpty());
+            } finally {
+                statement.execute("DROP TRIGGER " + identifier + " ON oidc_user_auth_method");
+                statement.execute("DROP FUNCTION " + identifier + "()");
+            }
+        }
+    }
+    @Test void passwordCheckDoesNotUpgradeToANewerIdentityVersion() {
+        var initial = create();
+        var lifecycle = new OidcIdentityLifecycle(dataSource());
+        long authenticated = lifecycle.authenticate(subject, "InitialPassword123!").orElseThrow();
+        directory.resetPassword(subject, initial.revision(), "ChangedPassword123!");
+        assertFalse(lifecycle.matches(subject, authenticated));
+        var sessions = new OidcSessionService(new OidcConfiguration(), lifecycle);
+        assertTrue(sessions.authenticate(users, subject, "InitialPassword123!").isEmpty());
+        String fresh = sessions.authenticate(users, subject, "ChangedPassword123!").orElseThrow();
+        assertEquals(subject, sessions.subject(fresh).orElseThrow());
+    }
+    @Test void matchingClientAndUserNamesCannotBypassRevocation() throws Exception {
+        var initial = create();
+        try (var connection = dataSource().getConnection(); var statement = connection.prepareStatement(
+            "INSERT INTO oidc_client(client_id,client_kind) VALUES (?,'system')")) {
+            statement.setString(1, subject); statement.executeUpdate();
+        }
+        var configuration = new OidcConfiguration();
+        var lifecycle = new OidcIdentityLifecycle(dataSource());
+        assertFalse(lifecycle.machineSubject(subject));
+        var filter = new OidcIdentityLifecycleFilter(configuration, lifecycle);
+        var request = HttpRequest.GET("/api/v1/configs");
+        request.setAttribute(SecurityFilter.AUTHENTICATION, Authentication.build(subject, List.of(),
+            Map.of("iss", configuration.getIssuer(), "client_id", subject, OidcIdentityLifecycle.CLAIM, 0L)));
+        directory.resetPassword(subject, initial.revision(), "ChangedPassword123!");
+        assertEquals(401, Mono.from(filter.doFilter(request, ignored -> {throw new AssertionError("colliding identity bypassed lifecycle");})).block().code());
+    }
+}
