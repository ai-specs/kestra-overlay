+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class OidcClientLifecycleGuardTest {
+    private static final String ISSUER="https://issuer.example";
+    private static final String STATE="SELECT client_kind,owner_subject,pending_expires_at,client_name,active FROM oidc_client WHERE client_id=?";
+    private static final String INTERACTION="DELETE FROM oidc_client_management WHERE interaction=? AND client_id=? AND subject=? AND session_id=? AND expires_at>now()";
+    private final DataSource source=mock(DataSource.class);
+    private final Connection connection=mock(Connection.class);
+    private final OidcProtocolStateV1 protocol=mock(OidcProtocolStateV1.class);
+    private final BeanProvider<IdentityLifecycleGuardV1> guards=mock(BeanProvider.class);
+    private final IdentityLifecycleGuardV1 guard=mock(IdentityLifecycleGuardV1.class);
+    private final OidcConfiguration configuration=new OidcConfiguration();
+
+    private PreparedStatement statement(String sql)throws Exception {
+        var statement=mock(PreparedStatement.class);when(connection.prepareStatement(sql)).thenReturn(statement);when(statement.executeUpdate()).thenReturn(1);return statement;
+    }
+
+    private void state(String sql)throws Exception {
+        var statement=statement(sql);var row=mock(ResultSet.class);when(statement.executeQuery()).thenReturn(row);when(row.next()).thenReturn(true);
+        when(row.getString(1)).thenReturn("owned");when(row.getString(2)).thenReturn("alice");when(row.getString(4)).thenReturn("Application");when(row.getBoolean(5)).thenReturn(true);
+    }
+
+    private OidcOwnershipService service(boolean enabled)throws Exception {
+        configuration.setIssuer(ISSUER);when(source.getConnection()).thenReturn(connection);
+        when(guards.isUnique()).thenReturn(true);when(guards.get()).thenReturn(guard);
+        when(protocol.account(connection,ISSUER,"alice")).thenReturn(Optional.of(new OidcProtocolStateV1.Account(ISSUER,"alice",true,true,0)));
+        state(STATE);state(STATE+" FOR UPDATE");statement("SELECT pg_advisory_xact_lock(1500150)");
+        var active=statement("SELECT user_state FROM oidc_user WHERE username=? FOR SHARE");var row=mock(ResultSet.class);
+        when(active.executeQuery()).thenReturn(row);when(row.next()).thenReturn(true);when(row.getString(1)).thenReturn("ACTIVE");
+        return new OidcOwnershipService(source,new ObjectMapper(),20,configuration,new OidcConsentPolicy(),guards,protocol,enabled);
+    }
+
+    private void mutations()throws Exception {
+        statement(INTERACTION);
+        for(String sql:List.of("UPDATE oidc_client SET active=FALSE WHERE client_id=?","UPDATE oidc_token SET revoked=TRUE WHERE client_id=?",
+            "UPDATE oidc_authorization_code SET used=TRUE WHERE client_id=?","DELETE FROM oidc_consent WHERE client_id=?","DELETE FROM oidc_client WHERE client_id=?"))statement(sql);
+    }
+
+    private void noMutation()throws Exception {
+        verify(connection,never()).prepareStatement(argThat(sql->sql.startsWith("UPDATE ") || sql.startsWith("INSERT ") || sql.startsWith("DELETE ")));
+        verify(connection,never()).commit();
+    }
+
+    @Test void revocationGuardsTheAuthorizedOwnerBeforePrivateLocksAndManagementConsumption()throws Exception {
+        var service=service(true);mutations();service.revoke("client","alice",false,"interaction","session");
+        var order=inOrder(connection,protocol,guard);
+        order.verify(connection).setTransactionIsolation(Connection.TRANSACTION_READ_COMMITTED);order.verify(connection).setAutoCommit(false);
+        order.verify(protocol).lockSecurityState(connection);order.verify(connection).prepareStatement(STATE);order.verify(protocol).account(connection,ISSUER,"alice");
+        order.verify(guard).beforeChange(connection,new IdentityLifecycleGuardV1.Change(IdentityLifecycleGuardV1.Kind.CLIENT_REVOKE,ISSUER,null,"client"));
+        order.verify(connection).prepareStatement("SELECT pg_advisory_xact_lock(1500150)");order.verify(connection).prepareStatement(STATE+" FOR UPDATE");
+        order.verify(connection).prepareStatement(INTERACTION);order.verify(connection).prepareStatement("UPDATE oidc_client SET active=FALSE WHERE client_id=?");
+        order.verify(connection).commit();verify(source).getConnection();
+    }
+
+    @Test void deletionUsesAnExplicitClientDeleteGuardBeforeRemovingTheClient()throws Exception {
+        var service=service(true);mutations();service.revoke("client","alice",true);
+        var order=inOrder(guard,connection);
+        order.verify(guard).beforeChange(connection,new IdentityLifecycleGuardV1.Change(IdentityLifecycleGuardV1.Kind.CLIENT_DELETE,ISSUER,null,"client"));
+        order.verify(connection).prepareStatement("DELETE FROM oidc_client WHERE client_id=?");order.verify(connection).commit();
+    }
+
+    @Test void guardRejectionCannotConsumeManagementInteractionOrChangeAnyCredential()throws Exception {
+        var service=service(true);var rejection=new IdentityLifecycleGuardV1.Rejected(IdentityLifecycleGuardV1.Failure.LAST_ADMIN);
+        doThrow(rejection).when(guard).beforeChange(eq(connection),any());
+        assertSame(rejection,assertThrows(IdentityLifecycleGuardV1.Rejected.class,()->service.revoke("client","alice",false,"interaction","session")));
+        noMutation();verify(connection).rollback();verify(connection).close();verify(connection,never()).prepareStatement(STATE+" FOR UPDATE");
+    }
+
+    @Test void missingDuplicateAndFailedGuardCannotFallBackToStandardRevocation()throws Exception {
+        var service=service(true);when(guards.isUnique()).thenReturn(false);
+        assertEquals(IdentityLifecycleGuardV1.Failure.UNAVAILABLE,assertThrows(IdentityLifecycleGuardV1.Rejected.class,()->service.revoke("client","alice",false)).failure());
+        when(guards.isUnique()).thenReturn(true);doThrow(new SQLException("unavailable")).when(guard).beforeChange(eq(connection),any());
+        assertEquals(IdentityLifecycleGuardV1.Failure.UNAVAILABLE,assertThrows(IdentityLifecycleGuardV1.Rejected.class,()->service.revoke("client","alice",false)).failure());
+        noMutation();verify(connection,times(2)).rollback();
+    }
+
+    @Test void foreignOwnerAndInactiveSubjectCannotReachTheLifecycleGuard()throws Exception {
+        var service=service(true);
+        assertThrows(IllegalArgumentException.class,()->service.revoke("client","other",false));
+        when(protocol.account(connection,ISSUER,"alice")).thenReturn(Optional.of(new OidcProtocolStateV1.Account(ISSUER,"alice",false,false,0)));
+        assertThrows(IllegalArgumentException.class,()->service.revoke("client","alice",false));
+        verifyNoInteractions(guard);noMutation();
+    }
+
+    @Test void featureOffKeepsExistingStandardOwnerRevocation()throws Exception {
+        var service=service(false);mutations();service.revoke("client","alice",false,"interaction","session");
+        verifyNoInteractions(protocol,guard);verify(connection).commit();verify(connection,never()).prepareStatement(STATE);
+    }
+
+    @Test void controllerReturnsSanitizedNonCachingGuardErrors()throws Exception {
+        configuration.setIssuer(ISSUER);var service=mock(OidcOwnershipService.class);var sessions=mock(OidcSessionService.class);var users=mock(OidcUserService.class);
+        when(sessions.sessionIdFrom(any())).thenReturn(Optional.of("session"));when(sessions.subject("session")).thenReturn(Optional.of("alice"));
+        when(users.bySubject("alice")).thenReturn(Optional.of(new OidcUserService.OidcUser("alice","Alice","alice@example.invalid",false,List.of())));
+        var controller=new OidcOwnedClientController(service,sessions,configuration,users);
+        var request=HttpRequest.POST("/oidc/clients/client/revoke","").header("Origin",ISSUER);
+        for(var failure:IdentityLifecycleGuardV1.Failure.values()) {
+            doThrow(new IdentityLifecycleGuardV1.Rejected(failure)).when(service).revoke("client","alice",false,"interaction","session");
+            var response=controller.revoke("client",request,Map.of("action","revoke","interaction","interaction"));
+            assertEquals(switch(failure){case FORBIDDEN->HttpStatus.FORBIDDEN;case LAST_ADMIN->HttpStatus.CONFLICT;case UNAVAILABLE->HttpStatus.SERVICE_UNAVAILABLE;},response.getStatus());
+            assertEquals("no-store",response.getHeaders().get("Cache-Control"));
+            assertEquals(java.util.Set.of("error"),((Map<?,?>)response.getBody().orElseThrow()).keySet());
+            assertEquals(switch(failure){case FORBIDDEN->"access_denied";case LAST_ADMIN->"last_administrator";case UNAVAILABLE->"identity_unavailable";},
+                ((Map<?,?>)response.getBody().orElseThrow()).get("error"));
+        }
+    }
+}
