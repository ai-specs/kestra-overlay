@@ -0,0 +1,59 @@
+package io.kestra.webserver.oidc.controllers;
+
+import org.reactivestreams.Publisher;
+import reactor.core.publisher.Mono;
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.kestra.webserver.oidc.services.OidcIdentityLifecycle;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.MutableHttpResponse;
+import io.micronaut.http.annotation.Filter;
+import io.micronaut.http.filter.HttpServerFilter;
+import io.micronaut.http.filter.ServerFilterChain;
+import io.micronaut.http.filter.ServerFilterPhase;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+
+@Filter("/**")
+@Requires(property = "kestra.oidc.enabled", value = "true")
+public final class OidcIdentityLifecycleFilter implements HttpServerFilter {
+    private final OidcConfiguration configuration;
+    private final OidcIdentityLifecycle lifecycle
+;
+    @jakarta.inject.Inject
+    private io.micronaut.context.BeanProvider<io.kestra.webserver.oidc.services.OidcTrustedIdentity> projectIdentities
+;
+    public OidcIdentityLifecycleFilter(OidcConfiguration configuration, OidcIdentityLifecycle lifecycle) {
+        this.configuration = configuration; this.lifecycle = lifecycle;
+    }
+    @Override public int getOrder() { return ServerFilterPhase.SECURITY.order() + 1; }
+    @Override public Publisher<MutableHttpResponse<?>> doFilter(HttpRequest<?> request, ServerFilterChain chain) {
+        String path = request.getPath();
+        if (path.startsWith("/oauth/") || path.startsWith("/.well-known/") || path.startsWith("/ui/assets/")
+            || path.equals("/api/v1/configs/login") || java.util.Set.of("/oidc/login", "/oidc/logout", "/oidc/setup",
+                "/oidc/authorize", "/oidc/token", "/oidc/jwks", "/oidc/userinfo", "/oidc/introspect", "/oidc/revoke",
+                "/oidc/register", "/oidc/consent").contains(path)) return chain.proceed(request);
+        var authentication = request.getAttribute(SecurityFilter.AUTHENTICATION, Authentication.class).orElse(null);
+        if (authentication == null) return chain.proceed(request);
+        var attributes = authentication.getAttributes();
+        if (!configuration.getIssuer().equals(String.valueOf(attributes.get("iss")))) return chain.proceed(request);
+        return Mono.fromCallable(() ->
+{
+                if (projectIdentities != null && projectIdentities.isPresent()) {
+                    if (!projectIdentities.isUnique()) return false;
+                    projectIdentities.get().validate(authentication);
+                }
+                return
+ authentication.getName().equals(attributes.get("client_id")) && lifecycle.machineSubject(authentication.getName())
+                || lifecycle.matches(authentication.getName(), attributes.get(OidcIdentityLifecycle.CLAIM))
+;
+            }
+)
+            .subscribeOn(reactor.core.scheduler.Schedulers.boundedElastic())
+            .timeout(java.time.Duration.ofSeconds(5))
+            .onErrorReturn(false)
+            .flatMapMany(valid -> valid ? chain.proceed(request) : Mono.just(path.startsWith("/ui/")
+                ? HttpResponse.temporaryRedirect(java.net.URI.create("/oidc/logout")) : HttpResponse.unauthorized()));
+    }
+}
