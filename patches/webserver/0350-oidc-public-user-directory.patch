@@ -0,0 +1,178 @@
+package io.kestra.webserver.oidc.services;
+
+import java.nio.charset.StandardCharsets;
+import java.sql.Connection;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.util.ArrayList;
+import java.util.Optional;
+import javax.sql.DataSource;
+import io.kestra.webserver.oidc.UserDirectoryV1;
+import io.kestra.webserver.oidc.IdentityLifecycleGuardV1;
+import io.kestra.webserver.oidc.OidcProtocolStateV1;
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.data.connection.jdbc.advice.DelegatingDataSource;
+import jakarta.inject.Singleton;
+import org.mindrot.jbcrypt.BCrypt;
+
+@Singleton
+@Requires(property = "kestra.oidc.enabled", value = "true")
+public final class OidcUserDirectory implements UserDirectoryV1 {
+    private final DataSource source;
+    private final BeanProvider<IdentityLifecycleGuardV1> guards;
+    private final OidcProtocolStateV1 protocol;
+    private final OidcConfiguration configuration;
+    private final boolean applicationGroups;
+
+    @jakarta.inject.Inject
+    public OidcUserDirectory(DataSource source,
+        BeanProvider<IdentityLifecycleGuardV1> guards,OidcProtocolStateV1 protocol,OidcConfiguration configuration,
+        @io.micronaut.context.annotation.Value("${kestra.rbac.application-groups.enabled:false}") boolean applicationGroups) {
+        this.source=DelegatingDataSource.unwrapDataSource(source);this.guards=guards;this.protocol=protocol;
+        this.configuration=configuration;this.applicationGroups=applicationGroups;
+    }
+
+    public OidcUserDirectory(DataSource source) {
+        this(source,null,null,null,false);
+    }
+    private interface Work<Result> { Result run(Connection connection) throws SQLException; }
+    private <Result> Result transaction(Work<Result> work) {
+        return transaction(false,work);
+    }
+    private <Result> Result transaction(boolean authenticationChange,Work<Result> work) {
+        try (Connection connection = source.getConnection()) {
+            connection.setTransactionIsolation(authenticationChange?Connection.TRANSACTION_READ_COMMITTED:Connection.TRANSACTION_REPEATABLE_READ);
+            connection.setAutoCommit(false);
+            try {
+                Result result = work.run(connection);
+                connection.commit();
+                return result;
+            } catch (RuntimeException | SQLException failure) {
+                try{connection.rollback();}catch(SQLException rollback){failure.addSuppressed(rollback);}
+                if (failure instanceof DirectoryException directory) throw directory;
+                if (failure instanceof IdentityLifecycleGuardV1.Rejected rejected) throw rejected;
+                if (failure instanceof SQLException sql && ("23505".equals(sql.getSQLState()) || "40001".equals(sql.getSQLState())))
+                    throw new DirectoryException(Failure.CONFLICT);
+                throw new DirectoryException(Failure.UNAVAILABLE);
+            }
+        } catch (SQLException failure) {
+            throw new DirectoryException(Failure.UNAVAILABLE);
+        }
+    }
+    private static String text(String value) {
+        if (value == null || value.isBlank() || value.length() > 256 || !value.equals(value.trim())
+            || value.codePoints().anyMatch(Character::isISOControl)) throw new DirectoryException(Failure.INVALID);
+        return value;
+    }
+    private static String hash(String password) {
+        if (password == null || password.length() < 8 || password.getBytes(StandardCharsets.UTF_8).length > 72)
+            throw new DirectoryException(Failure.INVALID);
+        return BCrypt.hashpw(password, BCrypt.gensalt());
+    }
+    private static User read(ResultSet rows) throws SQLException {
+        return new User(rows.getString("username"), rows.getString("name"), rows.getString("email"),
+            "ACTIVE".equals(rows.getString("user_state")), rows.getLong("directory_revision"));
+    }
+    private static Optional<User> find(Connection connection, String subject) throws SQLException {
+        try (var statement = connection.prepareStatement(
+            "SELECT username,name,email,user_state,directory_revision FROM oidc_user WHERE username=?")) {
+            statement.setString(1, subject);
+            try (var rows = statement.executeQuery()) { return rows.next() ? Optional.of(read(rows)) : Optional.empty(); }
+        }
+    }
+    @Override public Optional<User> find(String subject) {
+        text(subject);
+        return transaction(connection -> find(connection, subject));
+    }
+    @Override public Page list(int page, int size) {
+        if (page < 1 || size < 1 || size > 100 || page > 1_000_000) throw new DirectoryException(Failure.INVALID);
+        return transaction(connection -> {
+            long total;
+            try (var statement = connection.createStatement(); var rows = statement.executeQuery("SELECT count(*) FROM oidc_user")) {
+                rows.next(); total = rows.getLong(1);
+            }
+            var users = new ArrayList<User>();
+            try (var statement = connection.prepareStatement(
+                "SELECT username,name,email,user_state,directory_revision FROM oidc_user ORDER BY username LIMIT ? OFFSET ?")) {
+                statement.setInt(1, size); statement.setLong(2, (long)(page - 1) * size);
+                try (var rows = statement.executeQuery()) { while (rows.next()) users.add(read(rows)); }
+            }
+            return new Page(users, total, page, size);
+        });
+    }
+    @Override public User create(String username, String name, String email, String password) {
+        String subject = text(username);
+        String display = text(name == null ? subject : name);
+        String address = text(email == null ? (subject.contains("@") ? subject : subject + "@localhost") : email);
+        String credential = hash(password);
+        return transaction(connection -> {
+            try (var statement = connection.prepareStatement("INSERT INTO oidc_user(username,name,email,roles) VALUES (?,?,?,'[]'::jsonb)")) {
+                statement.setString(1, subject); statement.setString(2, display); statement.setString(3, address); statement.executeUpdate();
+            }
+            password(connection, subject, credential);
+            return find(connection, subject).orElseThrow();
+        });
+    }
+    private static void password(Connection connection, String subject, String credential) throws SQLException {
+        try (var statement = connection.prepareStatement("INSERT INTO oidc_user_auth_method(user_id,type,credential) VALUES (?,'PASSWORD',?) "
+            + "ON CONFLICT(user_id,type) DO UPDATE SET credential=EXCLUDED.credential,state='ACTIVE',updated_at=now()")) {
+            statement.setString(1, subject); statement.setString(2, credential); statement.executeUpdate();
+        }
+    }
+    private static void changed(Connection connection, String subject, int count) throws SQLException {
+        if (count != 1) throw new DirectoryException(find(connection, subject).isPresent() ? Failure.CONFLICT : Failure.NOT_FOUND);
+    }
+    @Override public User update(String subject, long revision, String name, String email) {
+        text(subject); text(name); text(email);
+        if (revision < 0) throw new DirectoryException(Failure.INVALID);
+        return transaction(connection -> {
+            try (var statement = connection.prepareStatement("UPDATE oidc_user SET name=?,email=?,email_verified=CASE WHEN email=? THEN email_verified ELSE false END,"
+                + "directory_revision=directory_revision+1,updated_at=now() WHERE username=? AND directory_revision=?")) {
+                statement.setString(1, name); statement.setString(2, email); statement.setString(3, email);
+                statement.setString(4, subject); statement.setLong(5, revision);
+                changed(connection, subject, statement.executeUpdate());
+            }
+            return find(connection, subject).orElseThrow();
+        });
+    }
+    @Override public User setActive(String subject, long revision, boolean active) {
+        return authenticationChange(subject, revision, active, null);
+    }
+    @Override public User resetPassword(String subject, long revision, String password) {
+        return authenticationChange(subject, revision, null, hash(password));
+    }
+    private User authenticationChange(String subject, long revision, Boolean active, String credential) {
+        text(subject);
+        if (revision < 0) throw new DirectoryException(Failure.INVALID);
+        return transaction(true,connection -> {
+            if(applicationGroups) {
+                if(protocol==null || guards==null || !guards.isUnique() || configuration==null)
+                    throw new IdentityLifecycleGuardV1.Rejected(IdentityLifecycleGuardV1.Failure.UNAVAILABLE);
+                protocol.lockSecurityState(connection);
+                var current=find(connection,subject).orElseThrow(()->new DirectoryException(Failure.NOT_FOUND));
+                if(current.revision()!=revision)throw new DirectoryException(Failure.CONFLICT);
+                var kind=active==null?IdentityLifecycleGuardV1.Kind.PASSWORD_RESET:
+                    active?IdentityLifecycleGuardV1.Kind.ACCOUNT_ACTIVATE:IdentityLifecycleGuardV1.Kind.ACCOUNT_DEACTIVATE;
+                guards.get().beforeChange(connection,new IdentityLifecycleGuardV1.Change(kind,configuration.getIssuer(),subject,null));
+            }
+
+            try (var statement = connection.prepareStatement("UPDATE oidc_user SET user_state=COALESCE(?,user_state),"
+                + "directory_revision=directory_revision+1,authentication_version=authentication_version+1,updated_at=now() "
+                + "WHERE username=? AND directory_revision=?")) {
+                statement.setString(1, active == null ? null : active ? "ACTIVE" : "INACTIVE");
+                statement.setString(2, subject); statement.setLong(3, revision);
+                changed(connection, subject, statement.executeUpdate());
+            }
+            if (credential != null) password(connection, subject, credential);
+            try (var statement = connection.prepareStatement("UPDATE oidc_token SET revoked=true WHERE subject=?")) {
+                statement.setString(1, subject); statement.executeUpdate();
+            }
+            try (var statement = connection.prepareStatement("UPDATE oidc_authorization_code SET used=true WHERE subject=?")) {
+                statement.setString(1, subject); statement.executeUpdate();
+            }
+            return find(connection, subject).orElseThrow();
+        });
+    }
+}
