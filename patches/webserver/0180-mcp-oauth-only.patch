index 0000000..5a76f4c
--- /dev/null
+++ b/webserver/src/test/java/io/kestra/webserver/oidc/McpOAuthOnlyTest.java
@@ -0,0 +1,51 @@
+package io.kestra.webserver.oidc;
+
+import java.util.Optional;
+import io.kestra.mcp.McpToolRoute;
+import io.kestra.core.mcp.models.McpServer;
+import io.kestra.webserver.controllers.api.McpServerController;
+import io.kestra.webserver.models.api.ApiMcpServer;
+import io.kestra.webserver.filter.McpServerAuthenticationFilter;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpStatus;
+import io.micronaut.http.filter.ServerFilterChain;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.mockStatic;
+import static org.mockito.Mockito.when;
+import static org.mockito.Mockito.verifyNoInteractions;
+
+class McpOAuthOnlyTest {
+    @Test
+    void privatePublicAndUnknownMcpRoutesRejectBasicWithoutOidc() {
+        final var chain = mock(ServerFilterChain.class);
+        final var filter = new McpServerAuthenticationFilter();
+        try (var routes = mockStatic(McpToolRoute.class)) {
+            for (final String id : java.util.List.of("private", "public", "missing")) {
+                final var request = HttpRequest.POST("/api/v1/main/mcp/" + id, "{}").header("Authorization", "Basic dGVzdDp0ZXN0");
+                routes.when(() -> McpToolRoute.serverId(request)).thenReturn(Optional.of(id));
+                assertEquals(HttpStatus.UNAUTHORIZED, Mono.from(filter.doFilter(request, chain)).block().getStatus());
+            }
+            verifyNoInteractions(chain);
+        }
+    }
+
+    @Test
+    void apiRejectsBasicAndApiTokenWithoutEditionGate() throws Exception {
+        final var controller = new McpServerController(null, null, null, null);
+        final var validate = McpServerController.class.getDeclaredMethod("validateMcp", ApiMcpServer.class);
+        validate.setAccessible(true);
+        for (final var type : java.util.List.of(McpServer.AuthType.BASIC, McpServer.AuthType.API_TOKEN)) {
+            final var value = new ApiMcpServer("server", "", "", McpServer.ServerType.PRIVATE, type, null, null, false, false, null, null);
+            final var error = assertThrows(java.lang.reflect.InvocationTargetException.class, () -> validate.invoke(controller, value));
+            assertInstanceOf(io.micronaut.http.exceptions.HttpStatusException.class, error.getCause());
+        }
+        assertDoesNotThrow(() -> validate.invoke(controller, new ApiMcpServer("server", "", "", McpServer.ServerType.PRIVATE,
+            McpServer.AuthType.OAUTH, null, null, false, false, null, null)));
+    }
+}
