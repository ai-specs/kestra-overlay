+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.CALLS_REAL_METHODS;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+class NamespaceScopeContractTest {
+    @Test
+    void shouldPreserveExactSubtreeUnionAndLegacySemanticsAcrossConsumers() throws Exception {
+        AccessScope mixed = AccessScope.namespaces(List.of("team.tree"), List.of("team.exact"));
+        List<String> candidates = List.of("team.exact", "team.exact.child", "team.exact2", "team.tree", "team.tree.child", "team.tree2");
+        assertScope(mixed, candidates, List.of("team.exact", "team.tree", "team.tree.child"));
+        assertScope(AccessScope.namespaces(List.of(), List.of("team.exact")), candidates, List.of("team.exact"));
+        assertScope(new AccessScope(AccessScope.Kind.NAMESPACES, List.of("team.tree")), candidates, List.of("team.tree", "team.tree.child"));
+        assertScope(new AccessScope(AccessScope.Kind.NAMESPACES, List.of(), List.of()), candidates, List.of());
+        assertScope(AccessScope.namespaces(null, null), candidates, List.of());
+        assertScope(AccessScope.denyAll(), candidates, List.of());
+        assertScope(AccessScope.global(), candidates, candidates);
+        assertThat(McpToolScope.cacheKey(AccessScope.namespaces(List.of(), List.of("team.exact"))))
+            .isNotEqualTo(McpToolScope.cacheKey(AccessScope.namespaces(List.of("team.exact"))))
+            .isEqualTo(McpToolScope.cacheKey(AccessScope.namespaces(List.of(), List.of("team.exact", "team.exact"))));
+    }
+
+    private void assertScope(AccessScope scope, List<String> candidates, List<String> expected) throws Exception {
+        NamespaceAccessControl accessControl = resource -> scope;
+        assertThat(candidates.stream().filter(namespace -> accessControl.namespaceAllowed(QueryFilter.Resource.NAMESPACE, namespace)).toList())
+            .containsExactlyElementsOf(expected);
+        assertThat(candidates.stream().filter(namespace -> McpToolScope.allows(scope, namespace)).toList())
+            .containsExactlyElementsOf(expected);
+        AbstractJdbcRepository repository = new AbstractJdbcRepository() {
+            @Override
+            protected NamespaceAccessControl namespaceAccessControl() {
+                return accessControl;
+            }
+        };
+        AbstractJdbcLogDataStore logs = mock(AbstractJdbcLogDataStore.class, CALLS_REAL_METHODS);
+        setField(AbstractJdbcLogDataStore.class, logs, "accessControl", (LogDataStoreAccessControl) () -> scope);
+        Method jdbcAcl = AbstractJdbcRepository.class.getDeclaredMethod("aclCondition", QueryFilter.Resource.class);
+        jdbcAcl.setAccessible(true);
+        Method logAcl = AbstractJdbcLogDataStore.class.getDeclaredMethod("aclCondition");
+        logAcl.setAccessible(true);
+        for (Condition condition : List.of((Condition) jdbcAcl.invoke(repository, QueryFilter.Resource.FLOW), (Condition) logAcl.invoke(logs))) {
+            try (var connection = DriverManager.getConnection("jdbc:h2:mem:;DATABASE_TO_LOWER=TRUE")) {
+                var context = DSL.using(connection, SQLDialect.H2);
+                context.execute("create table candidates (namespace varchar(255), position int)");
+                for (int index = 0; index < candidates.size(); index++) {
+                    context.insertInto(DSL.table("candidates"), DSL.field("namespace"), DSL.field("position"))
+                        .values(candidates.get(index), index).execute();
+                }
+                assertThat(context.select(DSL.field("namespace", String.class)).from("candidates")
+                    .where(condition).orderBy(DSL.field("position")).fetch(0, String.class))
+                    .containsExactlyElementsOf(expected);
+            }
+        }
+    }
+
+    @Test
+    void shouldFilterSynthesizedAndForcedCandidatesBeforePaginationAndTotal() throws Exception {
+        NamespaceController<Namespace> controller = controller(AccessScope.namespaces(List.of(), List.of("team.exact", "other.exact")));
+        var first = controller.searchNamespaces(1, 1, List.of("id:asc"), false, null);
+        var second = controller.searchNamespaces(2, 1, List.of("id:asc"), false, null);
+        assertThat(first.getTotal()).isEqualTo(2);
+        assertThat(first.getResults()).extracting(Namespace::getId).containsExactly("other.exact");
+        assertThat(second.getTotal()).isEqualTo(2);
+        assertThat(second.getResults()).extracting(Namespace::getId).containsExactly("team.exact");
+        Method namespaces = NamespaceController.class.getDeclaredMethod("getNamespaces", io.micronaut.data.model.Pageable.class, String.class, List.class, boolean.class);
+        namespaces.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        ArrayListTotal<Namespace> forced = (ArrayListTotal<Namespace>) namespaces.invoke(controller, PageableUtils.from(1, 1), null,
+            List.of("team", "system", "team.exact.child", "team.exact"), false);
+        assertThat(forced).extracting(Namespace::getId).containsExactly("other.exact", "team.exact");
+        assertThat(forced.getTotal()).isEqualTo(2);
+        var denied = controller(AccessScope.denyAll()).searchNamespaces(1, 10, null, false, null);
+        assertThat(denied.getResults()).isEmpty();
+        assertThat(denied.getTotal()).isZero();
+        var global = controller(AccessScope.global()).searchNamespaces(1, 50, null, false, null);
+        assertThat(global.getResults()).extracting(Namespace::getId).contains("team", "system", "team.exact.child");
+    }
+
+    private NamespaceController<Namespace> controller(AccessScope scope) throws Exception {
+        NamespaceController<Namespace> controller = new NamespaceController<>();
+        FlowRepositoryInterface flows = mock(FlowRepositoryInterface.class);
+        when(flows.findDistinctNamespace("main")).thenReturn(List.of("team.exact", "team.exact.child", "team.exact2", "other.exact"));
+        TenantService tenants = mock(TenantService.class);
+        when(tenants.resolveTenant()).thenReturn("main");
+        setField(NamespaceController.class, controller, "flowRepository", flows);
+        setField(NamespaceController.class, controller, "tenantService", tenants);
+        setField(NamespaceController.class, controller, "systemFlowsConfiguration", new SystemFlowsConfiguration("system"));
+        setField(NamespaceController.class, controller, "namespaceAccessControl", (NamespaceAccessControl) resource -> scope);
+        setField(NamespaceController.class, controller, "namespaceSearchable", Searchable.<Namespace>builder().sortableExtractor("id", Namespace::getId).build());
+        return controller;
+    }
+
+    private static void setField(Class<?> declaringType, Object target, String name, Object value) throws Exception {
+        Field field = declaringType.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(target, value);
+    }
+}
