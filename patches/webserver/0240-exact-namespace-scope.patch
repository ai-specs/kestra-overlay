+        var first = controller.searchNamespaces(1, 1, List.of("id:asc"), false, null);
+        var second = controller.searchNamespaces(2, 1, List.of("id:asc"), false, null);
+        assertThat(first.getTotal()).isEqualTo(2);
+        assertThat(first.getResults()).extracting(Namespace::getId).containsExactly("other.exact");
+        assertThat(second.getTotal()).isEqualTo(2);
+        assertThat(second.getResults()).extracting(Namespace::getId).containsExactly("team.exact");
+        Method namespaces = NamespaceController.class.getDeclaredMethod("getNamespaces", io.micronaut.data.model.Pageable.class, String.class, List.class, boolean.class);
+        namespaces.setAccessible(true);
+        @SuppressWarnings("unchecked")
+        ArrayListTotal<Namespace> forced = (ArrayListTotal<Namespace>) namespaces.invoke(controller, PageableUtils.from(1, 1), null,
+            List.of("team", "system", "team.exact.child", "team.exact"), false);
+        assertThat(forced).extracting(Namespace::getId).containsExactly("other.exact", "team.exact");
+        assertThat(forced.getTotal()).isEqualTo(2);
+        var denied = controller(AccessScope.denyAll()).searchNamespaces(1, 10, null, false, null);
+        assertThat(denied.getResults()).isEmpty();
+        assertThat(denied.getTotal()).isZero();
+        var global = controller(AccessScope.global()).searchNamespaces(1, 50, null, false, null);
+        assertThat(global.getResults()).extracting(Namespace::getId).contains("team", "system", "team.exact.child");
+    }
