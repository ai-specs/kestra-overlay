+    @Test
+    void shouldPreserveExactSubtreeUnionAndLegacySemanticsAcrossConsumers() throws Exception {
+        AccessScope mixed = AccessScope.namespaces(List.of("team.tree"), List.of("team.exact"));
+        List<String> candidates = List.of("team.exact", "team.exact.child", "team.exact2", "team.tree", "team.tree.child", "team.tree2");
+        assertScope(mixed, candidates, List.of("team.exact", "team.tree", "team.tree.child"));
+        assertScope(AccessScope.namespaces(List.of(), List.of("team.exact")), candidates, List.of("team.exact"));
+        assertScope(new AccessScope(AccessScope.Kind.NAMESPACES, List.of("team.tree")), candidates, List.of("team.tree", "team.tree.child"));
+        assertScope(new AccessScope(AccessScope.Kind.NAMESPACES, List.of(), List.of()), candidates, List.of());
+        assertScope(AccessScope.namespaces(null, null), candidates, List.of());
+        assertScope(AccessScope.denyAll(), candidates, List.of());
+        assertScope(AccessScope.global(), candidates, candidates);
+        assertThat(McpToolScope.cacheKey(AccessScope.namespaces(List.of(), List.of("team.exact"))))
+            .isNotEqualTo(McpToolScope.cacheKey(AccessScope.namespaces(List.of("team.exact"))))
+            .isEqualTo(McpToolScope.cacheKey(AccessScope.namespaces(List.of(), List.of("team.exact", "team.exact"))));
+    }
+
+    private void assertScope(AccessScope scope, List<String> candidates, List<String> expected) throws Exception {
+        NamespaceAccessControl accessControl = resource -> scope;
+        assertThat(candidates.stream().filter(namespace -> accessControl.namespaceAllowed(QueryFilter.Resource.NAMESPACE, namespace)).toList())
+            .containsExactlyElementsOf(expected);
+        assertThat(candidates.stream().filter(namespace -> McpToolScope.allows(scope, namespace)).toList())
+            .containsExactlyElementsOf(expected);
+        AbstractJdbcRepository repository = new AbstractJdbcRepository() {
+            @Override
+            protected NamespaceAccessControl namespaceAccessControl() {
+                return accessControl;
+            }
+        };
+        AbstractJdbcLogDataStore logs = mock(AbstractJdbcLogDataStore.class, CALLS_REAL_METHODS);
+        setField(AbstractJdbcLogDataStore.class, logs, "accessControl", (LogDataStoreAccessControl) () -> scope);
+        Method jdbcAcl = AbstractJdbcRepository.class.getDeclaredMethod("aclCondition", QueryFilter.Resource.class);
+        jdbcAcl.setAccessible(true);
+        Method logAcl = AbstractJdbcLogDataStore.class.getDeclaredMethod("aclCondition");
+        logAcl.setAccessible(true);
+        for (Condition condition : List.of((Condition) jdbcAcl.invoke(repository, QueryFilter.Resource.FLOW), (Condition) logAcl.invoke(logs))) {
+            try (var connection = DriverManager.getConnection("jdbc:h2:mem:;DATABASE_TO_LOWER=TRUE")) {
+                var context = DSL.using(connection, SQLDialect.H2);
+                context.execute("create table candidates (namespace varchar(255), position int)");
+                for (int index = 0; index < candidates.size(); index++) {
+                    context.insertInto(DSL.table("candidates"), DSL.field("namespace"), DSL.field("position"))
+                        .values(candidates.get(index), index).execute();
+                }
+                assertThat(context.select(DSL.field("namespace", String.class)).from("candidates")
+                    .where(condition).orderBy(DSL.field("position")).fetch(0, String.class))
+                    .containsExactlyElementsOf(expected);
+            }
+        }
+    }
