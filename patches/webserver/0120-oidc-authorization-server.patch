+package io.kestra.webserver.oidc;
+
+import java.time.Duration;
+import java.util.List;
+
+import io.micronaut.context.annotation.ConfigurationProperties;
+import io.micronaut.context.annotation.Requires;
+
+/**
+ * Configuration of the built-in OIDC server ({@code kestra.oidc.*}). Only loaded when the
+ * feature flag is on, like every other server bean.
+ */
+@ConfigurationProperties("kestra.oidc")
+@Requires(property = "kestra.oidc.enabled", value = "true", defaultValue = "false")
+public class OidcConfiguration {
+
+    /** The OIDC issuer identifier — all endpoints are derived from it (e.g. http://localhost:8080). */
+    private String issuer = "http://localhost:8080";
+
+    private Duration accessTokenTtl = Duration.ofHours(1);
+
+    private Duration refreshTokenTtl = Duration.ofHours(24);
+
+    /** Short-lived by design (security checklist D1). */
+    private Duration authorizationCodeTtl = Duration.ofMinutes(5);
+
+    private Duration sessionTtl = Duration.ofHours(8);
+
+    /** Accounts seeded into an empty user directory at startup (bcrypt-hashed at runtime, never stored in config as hashes). */
+    private List<UserSeed> users = List.of();
+
+    /** A bootstrap account: the hardened persona's static-declaration option (裁定③). */
+    public record UserSeed(String username, String name, String email, String password, List<String> roles) {}
+
+    public String getIssuer() {
+        return issuer;
+    }
+
+    public void setIssuer(String issuer) {
+        this.issuer = issuer;
+    }
+
+    public Duration getAccessTokenTtl() {
+        return accessTokenTtl;
+    }
+
+    public void setAccessTokenTtl(Duration accessTokenTtl) {
+        this.accessTokenTtl = accessTokenTtl;
+    }
+
+    public Duration getRefreshTokenTtl() {
+        return refreshTokenTtl;
+    }
+
+    public void setRefreshTokenTtl(Duration refreshTokenTtl) {
+        this.refreshTokenTtl = refreshTokenTtl;
+    }
+
+    public Duration getAuthorizationCodeTtl() {
+        return authorizationCodeTtl;
+    }
+
+    public void setAuthorizationCodeTtl(Duration authorizationCodeTtl) {
+        this.authorizationCodeTtl = authorizationCodeTtl;
+    }
+
+    public Duration getSessionTtl() {
+        return sessionTtl;
+    }
+
+    public void setSessionTtl(Duration sessionTtl) {
+        this.sessionTtl = sessionTtl;
+    }
+
+    public List<UserSeed> getUsers() {
+        return users;
+    }
+
+    public void setUsers(List<UserSeed> users) {
+        this.users = users;
+    }
+}
