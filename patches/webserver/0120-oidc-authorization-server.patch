+
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.kestra.webserver.oidc.OidcException;
+import io.kestra.webserver.oidc.services.NimbusHttpAdapter;
+import io.kestra.webserver.oidc.services.OidcAuthorizationCodeService;
+import io.kestra.webserver.oidc.services.OidcClientService;
+import io.kestra.webserver.oidc.services.OidcJwkService;
+import io.kestra.webserver.oidc.services.OidcSessionService;
+import io.kestra.webserver.oidc.services.OidcTokenService;
+import io.kestra.webserver.oidc.services.OidcUserService;
+
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.HttpHeaders;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.MediaType;
+import io.micronaut.http.annotation.Body;
+import io.micronaut.http.annotation.Consumes;
+import io.micronaut.http.annotation.Controller;
+import io.micronaut.http.annotation.Get;
+import io.micronaut.http.annotation.Post;
+import io.micronaut.http.annotation.Produces;
+import io.micronaut.scheduling.TaskExecutors;
+import io.micronaut.scheduling.annotation.ExecuteOn;
+import jakarta.inject.Inject;
+
+/**
+ * The OAuth2/OIDC protocol endpoints of the built-in server:
+ * JWKS, authorize, token (authorization_code / client_credentials / refresh_token),
+ * userinfo, introspection and revocation.
+ *
+ * <p>Never leaks detail in errors beyond the RFC error code (C3/C1): {@code invalid_client}
+ * says nothing about whether the id or the secret was wrong.
+ */
+@Controller("/oidc")
+@Requires(property = "kestra.oidc.enabled", value = "true", defaultValue = "false")
+@ExecuteOn(TaskExecutors.IO)
+public class OidcProviderController {
+
+    private final OidcConfiguration configuration;
+    private final OidcClientService clientService;
+    private final OidcAuthorizationCodeService authCodeService;
+    private final OidcTokenService tokenService;
+    private final OidcJwkService jwkService;
+    private final OidcUserService userService;
+    private final OidcSessionService sessionService;
+
+    @Inject
+    public OidcProviderController(
+        final OidcConfiguration configuration,
+        final OidcClientService clientService,
+        final OidcAuthorizationCodeService authCodeService,
+        final OidcTokenService tokenService,
+        final OidcJwkService jwkService,
+        final OidcUserService userService,
+        final OidcSessionService sessionService
+    ) {
+        this.configuration = configuration;
+        this.clientService = clientService;
+        this.authCodeService = authCodeService;
+        this.tokenService = tokenService;
+        this.jwkService = jwkService;
+        this.userService = userService;
+        this.sessionService = sessionService;
+    }
+
+    @Get("/jwks")
+    @Produces(MediaType.APPLICATION_JSON)
+    public HttpResponse<?> jwks() {
+        return HttpResponse.ok(jwkService.publicJwkSet().toJSONObject());
+    }
+
+    @Get("/authorize")
+    public HttpResponse<?> authorize(final HttpRequest<?> request) {
+        final var parameters = queryParams(request);
+        if (parameters.containsKey("code_challenge") && parameters.get("code_challenge").stream().anyMatch(String::isBlank)) {
+            return HttpResponse.badRequest(Map.of("error", "invalid_request"));
+        }
+        final AuthenticationRequest authRequest;
+        try {
+            authRequest = AuthenticationRequest.parse(queryParams(request));
+        } catch (ParseException e) {
+            return HttpResponse.badRequest("Invalid authorization request");
+        }
+
+        final ClientID clientId = authRequest.getClientID();
+        final URI redirectUri = authRequest.getRedirectionURI();
+        final State state = authRequest.getState();
+
+        final Optional<OidcClientService.OidcClient> clientOpt = clientId == null
+            ? Optional.empty()
+            : clientService.find(clientId.getValue());
+        if (clientOpt.isEmpty()) {
+            return HttpResponse.badRequest("Unknown client_id");
+        }
+        final OidcClientService.OidcClient client = clientOpt.get();
+        if (!client.active()) {
+            return HttpResponse.badRequest("Unknown client_id");
+        }
+
+        if (redirectUri == null || !clientService.isRedirectUriRegistered(client, redirectUri.toString())) {
+            // E1: never redirect with an unregistered URI — 400, no redirect leakage.
+            return HttpResponse.badRequest("redirect_uri is not registered for this client");
+        }
+
+        final ResponseType responseType = authRequest.getResponseType();
+        if (responseType == null || !responseType.contains(ResponseType.Value.CODE)) {
+            return authorizeError(redirectUri, state, OAuth2Error.UNSUPPORTED_RESPONSE_TYPE);
+        }
+
+
+ List<String> requestedScopes = authRequest.getScope() != null
+            ? authRequest.getScope().toStringList()
+            : client.scopes();
+
+
+
+        // A2: public clients must use PKCE with S256.
+        final CodeChallenge codeChallenge = authRequest.getCodeChallenge();
+        final CodeChallengeMethod codeChallengeMethod = authRequest.getCodeChallengeMethod();
+        if (clientService.isPublic(client)
+            && (codeChallenge == null || codeChallengeMethod != CodeChallengeMethod.S256)) {
+            return authorizeError(redirectUri, state, OAuth2Error.INVALID_REQUEST
+                .appendDescription(": public clients must use PKCE (code_challenge_method=S256)"));
+        }
+
+        final Optional<String> subject = sessionService.sessionIdFrom(request).flatMap(sessionService::subject);
+        if (subject.isEmpty()) {
+            // Not logged into the provider yet — the login page (0130) returns here afterwards.
+            final String returnTo = URLEncoder.encode(request.getUri().toString(), StandardCharsets.UTF_8);
+            return HttpResponse.temporaryRedirect(URI.create("/oidc/login?from=" + returnTo));
+        }
+
+        final AuthorizationCode code = authCodeService.create(
+            client.clientId(),
+            subject.get(),
+            redirectUri.toString(),
+            requestedScopes,
+            codeChallenge != null ? codeChallenge.getValue() : null,
+            codeChallengeMethod,
+            authRequest.getNonce() != null ? authRequest.getNonce().getValue() : null
+        );
+
+        final AuthorizationSuccessResponse success = new AuthorizationSuccessResponse(
+            redirectUri,
+new AuthorizationCode(tokenService.bindProjectCode(
+ code
+.getValue(), client.clientId(), subject.get(), requestedScopes))
+, null, state, ResponseMode.QUERY
+        );
+        sessionService.sessionIdFrom(request).ifPresent(id -> {
+            if (sessionService.isOneShot(id)) {
+                sessionService.revoke(id);
+            }
+        });
+        return HttpResponse.temporaryRedirect(success.toURI());
+    }
+
+    @Post("/token")
+    @Consumes(MediaType.APPLICATION_FORM_URLENCODED)
+    @Produces(MediaType.APPLICATION_JSON)
+    public HttpResponse<?> token(final HttpRequest<?> request, @Body final Map<String, String> form) {
+        try {
+            final HTTPRequest nimbus = NimbusHttpAdapter.toNimbusFormPost(request, form);
+            final TokenRequest tokenRequest = TokenRequest.parse(nimbus);
+
+            final ClientID clientId = authenticateClient(tokenRequest);
+            final OidcClientService.OidcClient client = clientService.require(clientId.getValue());
+
+            final AuthorizationGrant grant = tokenRequest.getAuthorizationGrant();
+            final String grantType = grant.getType().getValue();
+            if (!clientService.isGrantTypeAllowed(client, grantType)) {
+                throw new OidcException(OAuth2Error.UNAUTHORIZED_CLIENT.appendDescription(": grant type not enabled for this client"));
+            }
+
+            if (clientService.isPublic(client)
+                && grant instanceof AuthorizationCodeGrant publicGrant
+                && publicGrant.getCodeVerifier() == null) {
+                throw new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": PKCE code_verifier is required for public clients"));
+            }
+
+            if (grant instanceof AuthorizationCodeGrant authorizationCodeGrant) {
+                return authorizationCodeToken(client, tokenRequest, authorizationCodeGrant);
+            } else if (grant instanceof ClientCredentialsGrant) {
+                return clientCredentialsToken(client, tokenRequest);
+            } else if (grant instanceof RefreshTokenGrant refreshTokenGrant) {
+                return refreshTokenToken(client, tokenRequest, refreshTokenGrant);
+            } else {
+                throw new OidcException(OAuth2Error.UNSUPPORTED_GRANT_TYPE);
+            }
+        } catch (ParseException e) {
+            return tokenErrorResponse(new ErrorObject("invalid_request", null, 400));
+        } catch (OidcException e) {
+            return tokenErrorResponse(e.error());
+        }
+    }
+
+    @Get("/userinfo")
+    @Produces(MediaType.APPLICATION_JSON)
+    public HttpResponse<?> userInfoGet(final HttpRequest<?> request) {
+        return userInfo(request);
+    }
+
+    @Post("/userinfo")
+    @Produces(MediaType.APPLICATION_JSON)
+    public HttpResponse<?> userInfoPost(final HttpRequest<?> request) {
+        return userInfo(request);
+    }
+
+    private HttpResponse<?> userInfo(final HttpRequest<?> request) {
+        final String authorization = request.getHeaders().get("Authorization");
+        if (authorization == null || !authorization.toLowerCase().startsWith("bearer ")) {
+            return HttpResponse.unauthorized();
+        }
+        try {
+            final JWTClaimsSet claims = tokenService.validateAccessToken(authorization.substring(7).trim());
+            final UserInfo userInfo = new UserInfo(new Subject(claims.getSubject()));
+            if (claims.getClaim("name") != null) {
+                userInfo.setName((String) claims.getClaim("name"));
+            }
+            if (claims.getClaim("email") != null) {
+                userInfo.setEmailAddress((String) claims.getClaim("email"));
+            }
+            if (claims.getClaim("roles") != null) {
+                userInfo.setClaim("roles", claims.getClaim("roles"));
+            }
+            return HttpResponse.ok(userInfo.toJSONObject());
+        } catch (OidcException e) {
+            return HttpResponse.unauthorized();
+        }
+    }
+
+    @Post("/introspect")
+    @Consumes(MediaType.APPLICATION_FORM_URLENCODED)
+    @Produces(MediaType.APPLICATION_JSON)
+    public HttpResponse<?> introspect(final HttpRequest<?> request, @Body final Map<String, String> form) {
+        final TokenIntrospectionRequest introspectionRequest;
+        try {
+            final HTTPRequest nimbus = NimbusHttpAdapter.toNimbusFormPost(request, form);
+            introspectionRequest = TokenIntrospectionRequest.parse(nimbus);
+        } catch (ParseException e) {
+            return HttpResponse.badRequest("Invalid introspection request");
+        }
+        // RFC 7662: only authenticated confidential clients may introspect.
+        if (introspectionRequest.getClientAuthentication() == null) {
+            return tokenErrorResponse(OAuth2Error.INVALID_CLIENT);
+        }
+        if (!authenticate(introspectionRequest.getClientAuthentication())) {
+            return tokenErrorResponse(OAuth2Error.INVALID_CLIENT);
+        }
+
+        final String value = introspectionRequest.getToken().getValue();
+        final Optional<OidcTokenService.StoredToken> stored = tokenService.findByValue(value);
+        final boolean active = stored.isPresent()
+            && !stored.get().revoked()
+            && (stored.get().expiresAt() == null || stored.get().expiresAt().isAfter(java.time.Instant.now()));
+
+        final TokenIntrospectionSuccessResponse.Builder builder = new TokenIntrospectionSuccessResponse.Builder(active);
+        if (active) {
+            final OidcTokenService.StoredToken token = stored.get();
+            builder.clientID(new ClientID(token.clientId()));
+            builder.username(token.subject() != null ? token.subject() : token.clientId());
+            builder.tokenType(AccessTokenType.BEARER);
+            builder.scope(new Scope(token.scopes().toArray(new String[0])));
+            if (token.issuedAt() != null) {
+                builder.issueTime(Date.from(token.issuedAt()));
+            }
+            if (token.expiresAt() != null) {
+                builder.expirationTime(Date.from(token.expiresAt()));
+            }
+        }
+        return HttpResponse.ok(builder.build().toJSONObject());
+    }
+
+    @Post("/revoke")
+    @Consumes(MediaType.APPLICATION_FORM_URLENCODED)
+    public HttpResponse<?> revoke(final HttpRequest<?> request, @Body final Map<String, String> form) {
+        // RFC 7009: requires client authentication; unknown tokens are a 200 (no leakage).
+        try {
+            final HTTPRequest nimbus = NimbusHttpAdapter.toNimbusFormPost(request, form);
+            final TokenRevocationRequest revocationRequest = TokenRevocationRequest.parse(nimbus);
+            if (revocationRequest.getClientAuthentication() != null
+                && !authenticate(revocationRequest.getClientAuthentication())) {
+                return tokenErrorResponse(OAuth2Error.INVALID_CLIENT);
+            }
+            tokenService.revoke(revocationRequest.getToken().getValue());
+            return HttpResponse.ok();
+        } catch (ParseException e) {
+            return HttpResponse.badRequest("Invalid revocation request");
+        }
+    }
+
+    private ClientID authenticateClient(final TokenRequest tokenRequest) {
+        final ClientAuthentication clientAuth = tokenRequest.getClientAuthentication();
+        if (clientAuth == null) {
+            // Public client on the code grant: no secret; the code's client binding + PKCE
+            // (checked in consume) carry the security.
+            if (tokenRequest.getClientID() == null) {
+                throw new OidcException(OAuth2Error.INVALID_CLIENT);
+            }
+            if (clientService.find(tokenRequest.getClientID().getValue()).filter(clientService::isPublic).isEmpty()) {
+                throw new OidcException(OAuth2Error.INVALID_CLIENT);
+            }
+            return tokenRequest.getClientID();
+        }
+        if (!authenticate(clientAuth)) {
+            throw new OidcException(OAuth2Error.INVALID_CLIENT);
+        }
+        return clientAuth.getClientID();
+    }
+
+    private boolean authenticate(final ClientAuthentication clientAuth) {
+        if (clientAuth instanceof ClientSecretBasic basic) {
+            return clientService.authenticate(
+                basic.getClientID().getValue(),
+                basic.getClientSecret() != null ? basic.getClientSecret().getValue() : null
+            );
+        }
+        if (clientAuth instanceof ClientSecretPost post) {
+            return clientService.authenticate(
+                post.getClientID().getValue(),
+                post.getClientSecret() != null ? post.getClientSecret().getValue() : null
+            );
+        }
+        return false;
+    }
+
+    private HttpResponse<?> authorizationCodeToken(
+        final OidcClientService.OidcClient client,
+        final TokenRequest tokenRequest,
+        final AuthorizationCodeGrant grant
+    ) {
+        final URI redirectUri = grant.getRedirectionURI();
+        final OidcAuthorizationCodeService.StoredCode stored = authCodeService.consume(
+            grant.getAuthorizationCode().getValue(),
+            client.clientId(),
+            redirectUri != null ? redirectUri.toString() : null,
+            grant.getCodeVerifier()
+        );
+
+        List<String> scopes = stored.scopes();
+        if (tokenRequest.getScope() != null) {
+            final List<String> requested = tokenRequest.getScope().toStringList();
+            if (!clientService.isScopeAllowed(client, requested)) {
+                throw new OidcException(OAuth2Error.INVALID_SCOPE);
+            }
+            scopes = requested;
+        }
+        final Scope scope = new Scope(scopes.toArray(new String[0]));
+
+        final OidcUserService.OidcUser user = userService.bySubject(stored.subject())
+            .orElseThrow(() -> new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": unknown subject")));
+        final BearerAccessToken accessToken = tokenService.issueAccessToken(
+            client.clientId(), user.sub(), user.name(), user.email(), user.roles(), scope);
+        final RefreshToken refreshToken = tokenService.issueRefreshToken(client.clientId(), user.sub(), scope);
+
+        if (scope.contains("openid")) {
+            final SignedJWT idToken = tokenService.issueIdToken(
+                client.clientId(), user.sub(), user.name(), user.email(), user.roles(), stored.nonce());
+            final OIDCTokenResponse response = new OIDCTokenResponse(new OIDCTokens(idToken, accessToken, refreshToken));
+            return tokenOk(response.toJSONObject());
+        }
+        final AccessTokenResponse response = new AccessTokenResponse(
+            new com.nimbusds.oauth2.sdk.token.Tokens(accessToken, refreshToken));
+        return tokenOk(response.toJSONObject());
+    }
+
+    private HttpResponse<?> clientCredentialsToken(
+        final OidcClientService.OidcClient client,
+        final TokenRequest tokenRequest
+    ) {
+        final Scope scope = tokenRequest.getScope() != null
+            ? tokenRequest.getScope()
+            : new Scope(client.scopes().toArray(new String[0]));
+        if (!clientService.isScopeAllowed(client, scope.toStringList())) {
+            throw new OidcException(OAuth2Error.INVALID_SCOPE);
+        }
+        // Machine identity = the client itself (subject = client id).
+        final BearerAccessToken accessToken = tokenService.issueAccessToken(
+            client.clientId(), client.clientId(), client.clientId(), null, List.of(), scope);
+        final AccessTokenResponse response = new AccessTokenResponse(
+            new com.nimbusds.oauth2.sdk.token.Tokens(accessToken, null));
+        return tokenOk(response.toJSONObject());
+    }
+
+    private HttpResponse<?> refreshTokenToken(
+        final OidcClientService.OidcClient client,
+        final TokenRequest tokenRequest,
+        final RefreshTokenGrant grant
+    ) {
+        final OidcTokenService.StoredToken stored = tokenService.validateRefreshToken(
+            grant.getRefreshToken().getValue(), client.clientId());
+        tokenService.revoke(stored.value()); // rotation: the old refresh token dies on use
+
+        List<String> scopes = stored.scopes();
+        if (tokenRequest.getScope() != null) {
+            final List<String> requested = tokenRequest.getScope().toStringList();
+            if (!clientService.isScopeAllowed(client, requested)) {
+                throw new OidcException(OAuth2Error.INVALID_SCOPE);
+            }
+            scopes = requested;
+        }
+        final Scope scope = new Scope(scopes.toArray(new String[0]));
+
+        final OidcUserService.OidcUser user = userService.bySubject(stored.subject())
+            .orElseThrow(() -> new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": unknown subject")));
+        final BearerAccessToken accessToken = tokenService.issueAccessToken(
+            client.clientId(), user.sub(), user.name(), user.email(), user.roles(), scope);
+        final RefreshToken refreshToken = tokenService.issueRefreshToken(client.clientId(), user.sub(), scope);
+        final AccessTokenResponse response = new AccessTokenResponse(
+            new com.nimbusds.oauth2.sdk.token.Tokens(accessToken, refreshToken));
+        return tokenOk(response.toJSONObject());
+    }
+
+    private HttpResponse<?> authorizeError(final URI redirectUri, final State state, final ErrorObject error) {
+        final AuthenticationErrorResponse errorResponse = new AuthenticationErrorResponse(redirectUri, error, state, ResponseMode.QUERY);
+        return HttpResponse.temporaryRedirect(errorResponse.toURI());
+    }
+
+    private HttpResponse<?> tokenOk(final Map<String, Object> body) {
+        return HttpResponse.ok(body).header(HttpHeaders.CACHE_CONTROL, "no-store");
+    }
+
+    private HttpResponse<?> tokenErrorResponse(final ErrorObject error) {
+        return HttpResponse.status(io.micronaut.http.HttpStatus.valueOf(error.getHTTPStatusCode() <= 0 ? 400 : error.getHTTPStatusCode()))
+            .body(new TokenErrorResponse(error).toJSONObject())
+            .header(HttpHeaders.CACHE_CONTROL, "no-store");
+    }
+
+    private static Map<String, List<String>> queryParams(final HttpRequest<?> request) {
+        final Map<String, List<String>> params = new LinkedHashMap<>();
+        request.getParameters().forEach((name, values) -> params.put(name, values));
+        return params;
+    }
+}
