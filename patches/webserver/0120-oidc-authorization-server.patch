+package io.kestra.webserver.oidc;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.time.Duration;
+import java.util.List;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.nimbusds.oauth2.sdk.pkce.CodeChallengeMethod;
+import com.nimbusds.oauth2.sdk.pkce.CodeVerifier;
+
+import io.kestra.webserver.oidc.services.OidcAuthorizationCodeService;
+import io.kestra.webserver.oidc.services.OidcClientService;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * D1 (one-shot codes) + PKCE verification for the R-OIDC-SERVER security checklist.
+ */
+class OidcAuthorizationCodeServiceTest extends OidcPostgresTestBase {
+
+    private OidcAuthorizationCodeService service;
+    private OidcConfiguration configuration;
+
+    @BeforeEach
+    void setUp() {
+        final ObjectMapper mapper = new ObjectMapper();
+        configuration = new OidcConfiguration();
+        service = new OidcAuthorizationCodeService(OidcPostgresTestBase.dataSource(), mapper, configuration);
+        final OidcClientService clients = new OidcClientService(OidcPostgresTestBase.dataSource(), mapper);
+        clients.delete("code-client");
+        clients.create("code-client", "s3cret",
+            List.of("https://app.example.org/cb"), List.of("authorization_code", "refresh_token"),
+            List.of("openid", "profile"));
+    }
+
+    private String createCode() {
+        return service.create("code-client", "alice", "https://app.example.org/cb",
+            List.of("openid"), null, null, null).getValue();
+    }
+
+    @Test
+    void anonymousAuthorizeReturnsToTheCompleteRequestAfterLogin() {
+        final var mapper = new ObjectMapper();
+        final var source = OidcPostgresTestBase.dataSource();
+        final var keys = new io.kestra.webserver.oidc.services.OidcJwkService(source);
+        final var controller = new io.kestra.webserver.oidc.controllers.OidcProviderController(
+            configuration, new OidcClientService(source, mapper), service,
+            new io.kestra.webserver.oidc.services.OidcTokenService(source, mapper, configuration, keys),
+            keys, new io.kestra.webserver.oidc.services.OidcUserService(source, mapper),
+            new io.kestra.webserver.oidc.services.OidcSessionService(configuration));
+        final String authorize = "/oidc/authorize?client_id=code-client&redirect_uri=https%3A%2F%2Fapp.example.org%2Fcb"
+            + "&response_type=code&scope=openid&state=round-trip&nonce=nonce-test";
+        final var request = org.mockito.Mockito.spy(io.micronaut.http.HttpRequest.GET(authorize));
+        org.mockito.Mockito.doReturn(new io.micronaut.http.simple.SimpleHttpRequest<Void>(
+            io.micronaut.http.HttpMethod.GET, "/", null).getCookies()).when(request).getCookies();
+        final var response = controller.authorize(request);
+        final String location = response.getHeaders().get("Location");
+        assertTrue(location.startsWith("/oidc/login?from="));
+        assertEquals(authorize, java.net.URLDecoder.decode(location.substring("/oidc/login?from=".length()),
+            java.nio.charset.StandardCharsets.UTF_8));
+    }
+
+    @Test
+    void consumesValidCodeAndMarksItUsed() {
+        final String code = createCode();
+        final var stored = service.consume(code, "code-client", "https://app.example.org/cb", null);
+        assertEquals("alice", stored.subject());
+        assertTrue(service.find(code).orElseThrow().used(), "consumed code must be marked used");
+    }
+
+    @Test
+    void codeIsOneShotReplayRejected() {
+        final String code = createCode();
+        service.consume(code, "code-client", "https://app.example.org/cb", null);
+        assertThrows(OidcException.class,
+            () -> service.consume(code, "code-client", "https://app.example.org/cb", null),
+            "replaying a used code must fail (D1)");
+    }
+
+    @Test
+    void unknownCodeRejected() {
+        assertThrows(OidcException.class, () -> service.consume("no-such-code", "code-client", null, null));
+    }
+
+    @Test
+    void wrongClientRejected() {
+        final String code = createCode();
+        assertThrows(OidcException.class, () -> service.consume(code, "other-client", null, null));
+    }
+
+    @Test
+    void redirectMismatchRejected() {
+        final String code = createCode();
+        assertThrows(OidcException.class,
+            () -> service.consume(code, "code-client", "https://app.example.org/other", null));
+    }
+
+    @Test
+    void expiredCodeRejected() {
+        configuration.setAuthorizationCodeTtl(Duration.ofSeconds(-1));
+        final String code = createCode();
+        assertThrows(OidcException.class,
+            () -> service.consume(code, "code-client", "https://app.example.org/cb", null));
+    }
+
+    @Test
+    void pkceS256VerifierMustMatchChallenge() {
+        final CodeVerifier verifier = new CodeVerifier();
+        final String challenge = s256(verifier);
+        final String code = service.create("code-client", "alice", "https://app.example.org/cb",
+            List.of("openid"), challenge, CodeChallengeMethod.S256, null).getValue();
+
+        service.consume(code, "code-client", "https://app.example.org/cb", verifier);
+
+        final String code2 = service.create("code-client", "alice", "https://app.example.org/cb",
+            List.of("openid"), challenge, CodeChallengeMethod.S256, null).getValue();
+        assertThrows(OidcException.class,
+            () -> service.consume(code2, "code-client", "https://app.example.org/cb", new CodeVerifier()),
+            "wrong verifier must fail PKCE");
+    }
+
+    @Test
+    void storedChallengeRequiresVerifier() {
+        final String challenge = s256(new CodeVerifier());
+        final String code = service.create("code-client", "alice", "https://app.example.org/cb",
+            List.of("openid"), challenge, CodeChallengeMethod.S256, null).getValue();
+        assertThrows(OidcException.class,
+            () -> service.consume(code, "code-client", "https://app.example.org/cb", null),
+            "missing verifier against a stored challenge must fail");
+    }
+
+    static String s256(final CodeVerifier verifier) {
+        try {
+            final byte[] digest = java.security.MessageDigest.getInstance("SHA-256")
+                .digest(verifier.getValue().getBytes(java.nio.charset.StandardCharsets.US_ASCII));
+            return java.util.Base64.getUrlEncoder().withoutPadding().encodeToString(digest);
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+}
