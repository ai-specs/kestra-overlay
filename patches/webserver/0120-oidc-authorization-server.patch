+package io.kestra.webserver.oidc;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.util.List;
+
+import io.kestra.webserver.oidc.controllers.OidcDiscoveryController;
+
+import io.micronaut.http.HttpResponse;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * Discovery metadata correctness (endpoint derivation, grants, S256-only PKCE).
+ */
+class OidcDiscoveryControllerTest {
+
+    @Test
+    void metadataDerivesEndpointsFromIssuer() {
+        final OidcConfiguration configuration = new OidcConfiguration();
+        configuration.setIssuer("https://kestra.example.org");
+        final HttpResponse<?> response = new OidcDiscoveryController(configuration).openIdConfiguration();
+        @SuppressWarnings("unchecked")
+        final java.util.Map<String, Object> metadata = (java.util.Map<String, Object>) response.body();
+
+        assertEquals("https://kestra.example.org", metadata.get("issuer"));
+        assertEquals("https://kestra.example.org/oidc/authorize", metadata.get("authorization_endpoint"));
+        assertEquals("https://kestra.example.org/oidc/token", metadata.get("token_endpoint"));
+        assertEquals("https://kestra.example.org/oidc/jwks", metadata.get("jwks_uri"));
+        assertEquals("https://kestra.example.org/oidc/userinfo", metadata.get("userinfo_endpoint"));
+        assertEquals(List.of("authorization_code", "client_credentials", "refresh_token"), metadata.get("grant_types_supported"));
+        assertEquals(List.of("S256"), metadata.get("code_challenge_methods_supported"),
+            "hardened persona: plain PKCE is not advertised");
+    }
+}
