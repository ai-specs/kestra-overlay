--- /dev/null
+++ b/webserver/src/main/java/io/kestra/webserver/oidc/services/OidcTokenService.java
@@ -0,0 +1,341 @@
+package io.kestra.webserver.oidc.services;
+
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.sql.Timestamp;
+import java.time.Instant;
+import java.util.Date;
+import java.util.List;
+import java.util.Optional;
+
+import javax.sql.DataSource;
+
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.nimbusds.jose.JWSAlgorithm;
+import com.nimbusds.jose.JWSHeader;
+import com.nimbusds.jose.JWSObject;
+import com.nimbusds.jose.JWSSigner;
+import com.nimbusds.jose.crypto.RSASSASigner;
+import com.nimbusds.jose.crypto.RSASSAVerifier;
+import com.nimbusds.jwt.JWTClaimsSet;
+import com.nimbusds.jwt.SignedJWT;
+import com.nimbusds.oauth2.sdk.OAuth2Error;
+import com.nimbusds.oauth2.sdk.Scope;
+import com.nimbusds.oauth2.sdk.auth.Secret;
+import com.nimbusds.oauth2.sdk.id.Audience;
+import com.nimbusds.oauth2.sdk.id.ClientID;
+import com.nimbusds.oauth2.sdk.id.Issuer;
+import com.nimbusds.oauth2.sdk.id.Subject;
+import com.nimbusds.oauth2.sdk.token.BearerAccessToken;
+import com.nimbusds.oauth2.sdk.token.RefreshToken;
+import com.nimbusds.openid.connect.sdk.claims.IDTokenClaimsSet;
+
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.kestra.webserver.oidc.OidcException;
+
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.data.connection.jdbc.advice.DelegatingDataSource;
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+
+/**
+ * Issues and validates the OIDC server's tokens (table {@code oidc_token}).
+ *
+ * <p>Access tokens are RS256 JWTs signed with the newest active JWK and mirrored into the
+ * table for introspection/revocation (RFC 7009); refresh tokens are opaque random values.
+ * Validation enforces: RS256 ONLY (any other JOSE algorithm — including {@code alg=none} —
+ * is rejected before any verification attempt, checklist B2), signature against the published
+ * JWKS (so pre-rotation keys keep validating, B3), issuer, expiry, and revocation state.
+ */
+@Singleton
+@Requires(property = "kestra.oidc.enabled", value = "true", defaultValue = "false")
+public class OidcTokenService {
+
+    private static final TypeReference<List<String>> STRING_LIST = new TypeReference<>() {};
+
+    private final DataSource dataSource;
+    private final ObjectMapper objectMapper;
+    private final OidcConfiguration configuration;
+    private final OidcJwkService jwkService;
+
+    @Inject
+    public OidcTokenService(
+        final DataSource dataSource,
+        final ObjectMapper objectMapper,
+        final OidcConfiguration configuration,
+        final OidcJwkService jwkService
+    ) {
+        this.dataSource = DelegatingDataSource.unwrapDataSource(dataSource);
+        this.objectMapper = objectMapper;
+        this.configuration = configuration;
+        this.jwkService = jwkService;
+    }
+
+    /** A stored token record (mirror of the table row). */
+    public record StoredToken(
+        long id, String clientId, String subject, String tokenType, String value,
+        List<String> scopes, Instant issuedAt, Instant expiresAt, boolean revoked
+    ) {}
+
+    /** Issues an access token (RS256 JWT), signs it with the newest active key and persists it. */
+    public BearerAccessToken issueAccessToken(
+        final String clientId,
+        final String subject,
+        final String name,
+        final String email,
+        final List<String> roles,
+        final Scope scope
+    ) {
+        final Instant now = Instant.now();
+        final Instant exp = now.plus(configuration.getAccessTokenTtl());
+        final JWTClaimsSet.Builder claims = new JWTClaimsSet.Builder()
+            .issuer(configuration.getIssuer())
+            .subject(subject)
+            .audience(List.of(clientId))
+            .expirationTime(Date.from(exp))
+            .issueTime(Date.from(now))
+            .jwtID(java.util.UUID.randomUUID().toString())
+            .claim("scope", String.join(" ", scope.toStringList()))
+            .claim("token_type", "access_token");
+        if (name != null) {
+            claims.claim("name", name);
+        }
+        if (email != null) {
+            claims.claim("email", email);
+        }
+        if (roles != null && !roles.isEmpty()) {
+            claims.claim("roles", roles);
+        }
+        final String jwt = sign(claims.build()).serialize();
+        persist("access", clientId, subject, scope.toStringList(), jwt, now, exp);
+        return new BearerAccessToken(jwt, configuration.getAccessTokenTtl().getSeconds(), scope);
+    }
+
+    /** Issues a new opaque refresh token and persists it. */
+    public RefreshToken issueRefreshToken(final String clientId, final String subject, final Scope scope) {
+        final RefreshToken refreshToken = new RefreshToken();
+        final Instant now = Instant.now();
+        persist("refresh", clientId, subject, scope.toStringList(), refreshToken.getValue(), now, now.plus(configuration.getRefreshTokenTtl()));
+        return refreshToken;
+    }
+
+    /** Issues an OIDC ID token (RS256 JWT) for the given client (audience). */
+    public SignedJWT issueIdToken(
+        final String clientId,
+        final String subject,
+        final String name,
+        final String email,
+        final List<String> roles,
+        final String nonce
+    ) {
+        final Instant now = Instant.now();
+        final Instant exp = now.plus(configuration.getAccessTokenTtl());
+        final IDTokenClaimsSet idTokenClaims = new IDTokenClaimsSet(
+            new Issuer(configuration.getIssuer()),
+            new Subject(subject),
+            List.of(new Audience(clientId)),
+            Date.from(exp),
+            Date.from(now)
+        );
+        idTokenClaims.setClaim("name", name);
+        if (email != null) {
+            idTokenClaims.setClaim("email", email);
+        }
+        if (roles != null && !roles.isEmpty()) {
+            idTokenClaims.setClaim("roles", roles);
+        }
+        if (nonce != null) {
+            idTokenClaims.setClaim("nonce", nonce);
+        }
+        try {
+            final JWTClaimsSet base = idTokenClaims.toJWTClaimsSet();
+            final JWTClaimsSet jwtClaims = new JWTClaimsSet.Builder(base)
+                .jwtID(java.util.UUID.randomUUID().toString())
+                .build();
+            return sign(jwtClaims);
+        } catch (com.nimbusds.oauth2.sdk.ParseException e) {
+            throw new IllegalStateException("Failed to build ID token claims", e);
+        }
+    }
+
+    /**
+     * Parses and validates an access token: JOSE algorithm MUST be RS256 (B2), signature via
+     * the published JWKS (B3 rotation overlap), issuer, expiry, mirror-existence, revocation.
+     */
+    public JWTClaimsSet validateAccessToken(final String value) {
+        final SignedJWT signedJWT = parseAndVerify(value);
+        final JWTClaimsSet claims = claimsOf(signedJWT);
+        if (claims.getIssuer() != null && !configuration.getIssuer().equals(claims.getIssuer())) {
+            throw new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": token issuer mismatch"));
+        }
+        final Date exp = claims.getExpirationTime();
+        if (exp == null || exp.before(new Date())) {
+            throw new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": token expired"));
+        }
+        final StoredToken stored = findByValue(value)
+            .orElseThrow(() -> new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": unknown token")));
+        if (stored.revoked()) {
+            throw new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": token revoked"));
+        }
+        if (!"access".equals(stored.tokenType())) {
+            throw new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": not an access token"));
+        }
+        return claims;
+    }
+
+    /** Validates a refresh token for exchange, returning its stored record. */
+    public StoredToken validateRefreshToken(final String value, final String expectedClientId) {
+        final StoredToken stored = findByValue(value)
+            .orElseThrow(() -> new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": unknown refresh token")));
+        if (stored.revoked()) {
+            throw new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": refresh token revoked"));
+        }
+        if (stored.expiresAt() != null && stored.expiresAt().isBefore(Instant.now())) {
+            throw new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": refresh token expired"));
+        }
+        if (!"refresh".equals(stored.tokenType())) {
+            throw new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": not a refresh token"));
+        }
+        if (!stored.clientId().equals(expectedClientId)) {
+            throw new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": refresh token issued to a different client"));
+        }
+        return stored;
+    }
+
+    public Optional<StoredToken> findByValue(final String value) {
+        final String sql = """
+            SELECT id, client_id, subject, token_type, value, scopes, issued_at, expires_at, revoked
+            FROM oidc_token WHERE value = ?""";
+        try (Connection connection = dataSource.getConnection();
+             PreparedStatement ps = connection.prepareStatement(sql)) {
+            ps.setString(1, value);
+            try (ResultSet rs = ps.executeQuery()) {
+                return rs.next() ? Optional.of(map(rs)) : Optional.empty();
+            }
+        } catch (SQLException e) {
+            throw new IllegalStateException("Failed to load OIDC token", e);
+        }
+    }
+
+    /** Marks a token revoked (RFC 7009). Idempotent for unknown tokens. */
+    public void revoke(final String value) {
+        final String sql = "UPDATE oidc_token SET revoked = TRUE WHERE value = ?";
+        try (Connection connection = dataSource.getConnection();
+             PreparedStatement ps = connection.prepareStatement(sql)) {
+            ps.setString(1, value);
+            ps.executeUpdate();
+        } catch (SQLException e) {
+            throw new IllegalStateException("Failed to revoke OIDC token", e);
+        }
+    }
+
+    private SignedJWT sign(final JWTClaimsSet claims) {
+        final var key = jwkService.activeSigningKey();
+        try {
+            final JWSSigner signer = new RSASSASigner(key);
+            final SignedJWT jwt = new SignedJWT(
+                new JWSHeader.Builder(JWSAlgorithm.RS256).keyID(key.getKeyID()).build(),
+                claims
+            );
+            jwt.sign(signer);
+            return jwt;
+        } catch (Exception e) {
+            throw new IllegalStateException("Failed to sign JWT", e);
+        }
+    }
+
+    /** RS256-only parse + signature verification against the published JWKS (kid lookup). */
+    private SignedJWT parseAndVerify(final String value) {
+        final SignedJWT jwt;
+        try {
+            jwt = SignedJWT.parse(value);
+        } catch (java.text.ParseException e) {
+            throw new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": malformed token"));
+        }
+        if (!JWSAlgorithm.RS256.equals(jwt.getHeader().getAlgorithm())) {
+            // B2: alg=none and algorithm-confusion tokens die here, before any key lookup.
+            throw new OidcException(OAuth2Error.INVALID_REQUEST.appendDescription(": only RS256 tokens are accepted"));
+        }
+        final String kid = jwt.getHeader().getKeyID();
+        final boolean verified = jwkService.publicJwkSet().getKeys().stream()
+            .filter(jwk -> jwk.getKeyID() != null && jwk.getKeyID().equals(kid))
+            .findFirst()
+            .map(jwk -> {
+                try {
+                    return jwt.verify(new RSASSAVerifier((com.nimbusds.jose.jwk.RSAKey) jwk));
+                } catch (Exception e) {
+                    return false;
+                }
+            })
+            .orElse(false);
+        if (!verified) {
+            throw new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": bad signature"));
+        }
+        return jwt;
+    }
+
+    private JWTClaimsSet claimsOf(final SignedJWT jwt) {
+        try {
+            return jwt.getJWTClaimsSet();
+        } catch (java.text.ParseException e) {
+            throw new OidcException(OAuth2Error.INVALID_GRANT.appendDescription(": unreadable claims"));
+        }
+    }
+
+    private void persist(
+        final String type, final String clientId, final String subject,
+        final List<String> scopes, final String value, final Instant issuedAt, final Instant expiresAt
+    ) {
+        final String sql = """
+            INSERT INTO oidc_token (client_id, subject, token_type, value, scopes, issued_at, expires_at)
+            VALUES (?, ?, ?, ?, ?::jsonb, ?, ?)""";
+        try (Connection connection = dataSource.getConnection();
+             PreparedStatement ps = connection.prepareStatement(sql)) {
+            ps.setString(1, clientId);
+            ps.setString(2, subject);
+            ps.setString(3, type);
+            ps.setString(4, value);
+            ps.setString(5, toJson(scopes));
+            ps.setTimestamp(6, Timestamp.from(issuedAt));
+            ps.setTimestamp(7, Timestamp.from(expiresAt));
+            ps.executeUpdate();
+        } catch (SQLException e) {
+            throw new IllegalStateException("Failed to persist OIDC token", e);
+        }
+    }
+
+    private StoredToken map(final ResultSet rs) throws SQLException {
+        final Timestamp issuedAt = rs.getTimestamp("issued_at");
+        final Timestamp expiresAt = rs.getTimestamp("expires_at");
+        return new StoredToken(
+            rs.getLong("id"),
+            rs.getString("client_id"),
+            rs.getString("subject"),
+            rs.getString("token_type"),
+            rs.getString("value"),
+            fromJson(rs.getString("scopes")),
+            issuedAt == null ? null : issuedAt.toInstant(),
+            expiresAt == null ? null : expiresAt.toInstant(),
+            rs.getBoolean("revoked")
+        );
+    }
+
+    private String toJson(final List<String> list) {
+        try {
+            return objectMapper.writeValueAsString(list == null ? List.of() : list);
+        } catch (Exception e) {
+            throw new IllegalStateException("Failed to serialize scopes", e);
+        }
+    }
+
+    private List<String> fromJson(final String json) {
+        try {
+            return objectMapper.readValue(json == null ? "[]" : json, STRING_LIST);
+        } catch (Exception e) {
+            throw new IllegalStateException("Failed to parse scopes", e);
+        }
+    }
+}
