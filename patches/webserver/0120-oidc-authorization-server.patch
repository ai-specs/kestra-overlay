@@ -0,0 +1,47 @@
+package io.kestra.webserver.oidc.services;
+
+import java.net.URI;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+import java.util.stream.Collectors;
+
+import com.nimbusds.oauth2.sdk.http.HTTPRequest;
+
+import io.micronaut.http.HttpRequest;
+
+/**
+ * Bridges Micronaut requests into Nimbus {@link HTTPRequest}s so the SDK's request parsers
+ * (TokenRequest / introspection / revocation) can be reused verbatim.
+ */
+public final class NimbusHttpAdapter {
+
+    private NimbusHttpAdapter() {
+    }
+
+    /** Builds a Nimbus POST request (form body) carrying Micronaut's Authorization header. */
+    public static HTTPRequest toNimbusFormPost(final HttpRequest<?> request, final Map<String, String> form) {
+        final URI requestUri = request.getUri();
+        final URI uri = requestUri.isAbsolute() ? requestUri : URI.create("http://localhost" + requestUri);
+        try {
+            final HTTPRequest nimbus = new HTTPRequest(HTTPRequest.Method.POST, uri);
+            nimbus.setContentType("application/x-www-form-urlencoded");
+            final String authorization = request.getHeaders().get("Authorization");
+            if (authorization != null) {
+                nimbus.setAuthorization(authorization);
+            }
+            final String body = form.entrySet().stream()
+                .filter(entry -> entry.getKey() != null && entry.getValue() != null)
+                .map(entry -> urlEncode(entry.getKey()) + "=" + urlEncode(entry.getValue()))
+                .collect(Collectors.joining("&"));
+            nimbus.setQuery(body);
+            return nimbus;
+        } catch (Exception e) {
+            throw new IllegalStateException("Failed to build Nimbus request", e);
+        }
+    }
+
+    private static String urlEncode(final String value) {
+        return URLEncoder.encode(value, StandardCharsets.UTF_8);
+    }
+}
