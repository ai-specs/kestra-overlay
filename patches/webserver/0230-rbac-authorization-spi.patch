@@ -0,0 +1,18 @@
+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import java.util.concurrent.CompletionStage;
+
+/** Public overlay contract. Policy and role interpretation belong to the consumer jar. */
+public interface RbacAuthorizer {
+    enum Action { READ, LIST, CREATE, UPDATE, DELETE, EXECUTE, ACCESS_OUTPUTS }
+    enum Kind { FLOW, EXECUTION, TRIGGER, NAMESPACE, KVSTORE, SECRET, NAMESPACE_FILE,
+        LOG, METRIC, DASHBOARD, BLUEPRINT, MCP_SERVER, AI, SYSTEM }
+    enum Scope { INSTANCE, TENANT, NAMESPACE }
+    record Principal(String subject, List<String> roles, String clientId, String audience, List<String> scopes) {
+        public Principal { roles = List.copyOf(roles); scopes = List.copyOf(scopes); }
+    }
+    record Resource(Kind kind, Scope scope, String tenant, String namespace, String id) {}
+    record Requirement(Resource resource, Action action) {}
+    CompletionStage<Boolean> authorize(Principal principal, Resource resource, Action action);
+}
