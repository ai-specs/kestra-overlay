@@ -0,0 +1,20 @@
+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import java.util.concurrent.CompletionStage;
+
+/** Shared REST/MCP execution dependency resolver (name retained for binary compatibility).
+ * Resolve input/output resource reads from the actual runtime flow declaration before execution.
+ * Null/exception means unresolved (deny). An empty list explicitly declares no extra resource reads.
+ * FLOW READ/EXECUTE and EXECUTION CREATE/ACCESS_OUTPUTS are independently enforced by the gate.
+ * This contract does not authorize or sandbox tasks executed later by the workflow engine.
+ */
+public interface McpAuthorizationResolver {
+    /** flowSource is JacksonMapper.ofYaml() serialization of the ProcessedFlow.flow() used for
+     * input validation, preserving runtime defaults, variables, checks and labels. It is an internal
+     * Flow declaration, not uploaded author YAML: tenantId may be null in OSS; tenant is authoritative
+     * transport identity. On FlowWithException, the authored Flow is supplied (matching validation).
+     */
+    record Invocation(String tenant, String namespace, String flowId, String executionId, String flowSource) {}
+    CompletionStage<List<RbacAuthorizer.Requirement>> resolve(RbacAuthorizer.Principal principal, Invocation invocation);
+}
