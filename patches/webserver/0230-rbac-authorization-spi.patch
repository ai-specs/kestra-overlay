+    @SuppressWarnings({"rawtypes", "unchecked"})
+    @Test void exactOauthLoginAndCallbackAreProtocolButUnknownPathsAreNot() {
+        var filter=new RestRbacFilter(new RbacConfiguration(true,false),provider(null),new RbacGate(provider(null)),mock(ProblemFactory.class));
