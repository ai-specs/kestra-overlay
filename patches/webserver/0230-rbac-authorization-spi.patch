+package io.kestra.webserver.rbac;
+
+import java.util.*;
+import java.util.concurrent.CompletableFuture;
+import java.net.http.HttpClient;
+import io.kestra.core.junit.annotations.KestraTest;
+import io.micronaut.context.annotation.Property;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.annotation.*;
+import io.micronaut.runtime.server.EmbeddedServer;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.AuthenticationFetcher;
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+import static org.junit.jupiter.api.Assertions.*;
+
+@KestraTest(environments="h2")
+@Property(name="kestra.server-type",value="WEBSERVER")
+@Property(name="kestra.rbac.enabled",value="true")
+@Property(name="micronaut.security.enabled",value="true")
+@Property(name="micronaut.security.filter.enabled",value="true")
+@Property(name="micronaut.security.intercept-url-map[0].pattern",value="/**")
+@Property(name="micronaut.security.intercept-url-map[0].access[0]",value="isAnonymous()")
+@Property(name="rbac.http.probe",value="true")
+class RbacHttpProbeTest {
+    @Inject EmbeddedServer server;
+    @Test void realNettyGatePreservesBodyAndClosesUnknownAndAnonymousWebhook() throws Exception {
+        var client=HttpClient.newBuilder().followRedirects(HttpClient.Redirect.NEVER).build();
+        var response=client.send(java.net.http.HttpRequest.newBuilder(server.getURI().resolve("/rbac-probe"))
+            .header("X-Probe-Identity","alice").header("Content-Type","text/plain")
+            .POST(java.net.http.HttpRequest.BodyPublishers.ofString("namespace: private.ns")).build(),java.net.http.HttpResponse.BodyHandlers.ofString());
+        assertEquals(200,response.statusCode(),response.body());assertEquals("namespace: private.ns",response.body());
+        for (String path:List.of("/api/v1/main/unknown","/api/v1/main/executions/webhook/private/flow/key")) {
+            var anonymous=client.send(java.net.http.HttpRequest.newBuilder(server.getURI().resolve(path)).GET().build(),java.net.http.HttpResponse.BodyHandlers.ofString());
+            assertEquals(401,anonymous.statusCode(),anonymous.body());
+            var unknown=client.send(java.net.http.HttpRequest.newBuilder(server.getURI().resolve(path)).header("X-Probe-Identity","alice").GET().build(),java.net.http.HttpResponse.BodyHandlers.ofString());
+            assertEquals(403,unknown.statusCode(),unknown.body());assertTrue(unknown.headers().firstValue("content-type").orElse("").contains("application/problem+json"));
+        }
+    }
+    @Test void forbiddenExecutionExceptionUsesActualProblemPipeline() throws Exception {
+        var response=HttpClient.newHttpClient().send(java.net.http.HttpRequest.newBuilder(server.getURI().resolve("/rbac-probe/denied"))
+            .header("X-Probe-Identity","alice").header("Content-Type","text/plain")
+            .POST(java.net.http.HttpRequest.BodyPublishers.ofString("namespace: private.ns")).build(),java.net.http.HttpResponse.BodyHandlers.ofString());
+        assertEquals(403,response.statusCode(),response.body());assertTrue(response.headers().firstValue("content-type").orElse("").contains("application/problem+json"));
+        assertTrue(response.body().contains("403"));
+    }
+    @Test void chunkedBodyIsIdenticalForResolverAndController() throws Exception {
+        String payload="namespace: private.ns\n"+"x".repeat(262144);
+        var client=HttpClient.newBuilder().version(HttpClient.Version.HTTP_1_1).build();
+        var response=client.send(java.net.http.HttpRequest.newBuilder(server.getURI().resolve("/rbac-probe/chunked"))
+            .header("X-Probe-Identity","alice").header("Content-Type","text/plain")
+            .POST(java.net.http.HttpRequest.BodyPublishers.ofInputStream(() -> new java.io.ByteArrayInputStream(payload.getBytes(java.nio.charset.StandardCharsets.UTF_8))))
+            .build(),java.net.http.HttpResponse.BodyHandlers.ofString());
+        assertEquals(200,response.statusCode(),response.body());assertEquals(payload,response.body());
+    }
+    @Controller("/rbac-probe") @Requires(property="rbac.http.probe",value="true")
+    static class ProbeController {
+        @Post("/denied") @Consumes("text/plain") String denied(@Body String body) { throw new io.micronaut.http.exceptions.HttpStatusException(io.micronaut.http.HttpStatus.FORBIDDEN,"Execution authorization denied"); }
+        @Post("/chunked") @Consumes("text/plain") @Produces("text/plain") String chunked(@Body String body) { return body; }
+        @Post(consumes="text/plain",produces="text/plain") String echo(@Body String body) { return body; }
+    }
+    @Singleton @Requires(property="rbac.http.probe",value="true")
+    static class ProbeAuthentication implements AuthenticationFetcher<io.micronaut.http.HttpRequest<?>> {
+        public org.reactivestreams.Publisher<Authentication> fetchAuthentication(io.micronaut.http.HttpRequest<?> request) {
+            return "alice".equals(request.getHeaders().get("X-Probe-Identity"))
+                ? Mono.just(Authentication.build("alice",List.of("reader"))) : Mono.empty();
+        }
+    }
+    @Singleton @Requires(property="rbac.http.probe",value="true")
+    static class ProbeResolver implements RestAuthorizationResolver {
+        public java.util.concurrent.CompletionStage<Plan> resolve(RbacAuthorizer.Principal principal, Request request) {
+            String expected=request.path().equals("/rbac-probe/chunked") ? "namespace: private.ns\n"+"x".repeat(262144) : "namespace: private.ns";
+            if (!request.path().startsWith("/rbac-probe") || !new String(request.body(),java.nio.charset.StandardCharsets.UTF_8).equals(expected)) return CompletableFuture.completedFuture(null);
+            return CompletableFuture.completedFuture(new Plan(List.of(new RbacAuthorizer.Requirement(
+                new RbacAuthorizer.Resource(RbacAuthorizer.Kind.FLOW,RbacAuthorizer.Scope.NAMESPACE,"main","private.ns","probe"),RbacAuthorizer.Action.CREATE)),Coverage.SINGLE));
+        }
+    }
+    @Singleton @Requires(property="rbac.http.probe",value="true")
+    static class ProbeAuthorizer implements RbacAuthorizer {
+        public java.util.concurrent.CompletionStage<Boolean> authorize(Principal principal,Resource resource,Action action) {
+            return CompletableFuture.completedFuture(principal.subject().equals("alice") && principal.roles().equals(List.of("reader")));
+        }
+    }
+}
