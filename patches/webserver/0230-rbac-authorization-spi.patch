@@ -0,0 +1,72 @@
+package io.kestra.webserver.rbac;
+
+import java.time.Duration;
+import java.util.List;
+import io.kestra.core.models.flows.Flow;
+import io.kestra.core.serializers.JacksonMapper;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.security.authentication.Authentication;
+import jakarta.inject.Singleton;
+import reactor.core.publisher.Flux;
+import reactor.core.publisher.Mono;
+
+/** Authorize the actual runtime declaration before inputs/checks/commands; contains no policy. */
+@Singleton
+public class RbacExecutionGate {
+    private final RbacConfiguration configuration;
+    private final RbacGate gate;
+    private final BeanProvider<McpAuthorizationResolver> resolvers;
+    public RbacExecutionGate(RbacConfiguration configuration, RbacGate gate, BeanProvider<McpAuthorizationResolver> resolvers) {
+        this.configuration=configuration; this.gate=gate; this.resolvers=resolvers;
+    }
+    public Mono<Boolean> authorize(Authentication authentication, String tenant, Flow flow, String executionId, boolean outputs) {
+        return checked(authentication, tenant, flow, executionId, outputs, () -> Mono.just(true)).onErrorReturn(false);
+    }
+
+    public <Result> Mono<Result> checked(Authentication authentication, String tenant, Flow flow, String executionId,
+        boolean outputs, java.util.function.Supplier<Mono<Result>> action) {
+        if (!configuration.enabled()) return Mono.defer(action);
+        var principal = authentication == null ? null : new RbacAuthorizer.Principal(authentication.getName(),
+            List.copyOf(authentication.getRoles()), null, null, List.of());
+        return gate.boundary(principal, tenant, () -> authorizeCurrent(authentication, tenant, flow, executionId, outputs)
+            .flatMap(allowed -> allowed ? Mono.defer(action) : Mono.error(new io.micronaut.http.exceptions.HttpStatusException(
+                io.micronaut.http.HttpStatus.FORBIDDEN, "Execution authorization denied"))))
+            .singleOrEmpty();
+    }
+
+    private Mono<Boolean> authorizeCurrent(Authentication authentication, String tenant, Flow flow, String executionId, boolean outputs) {
+        if (!configuration.enabled()) return Mono.just(true);
+        return Mono.defer(() -> {
+            if (authentication == null) return Mono.just(false);
+            var principal=new RbacAuthorizer.Principal(authentication.getName(),List.copyOf(authentication.getRoles()),null,null,List.of());
+            var resource=new RbacAuthorizer.Resource(RbacAuthorizer.Kind.FLOW,RbacAuthorizer.Scope.NAMESPACE,tenant,flow.getNamespace(),flow.getId());
+            var execution=new RbacAuthorizer.Resource(RbacAuthorizer.Kind.EXECUTION,RbacAuthorizer.Scope.NAMESPACE,tenant,flow.getNamespace(),executionId);
+            return gate.authorize(principal,resource,RbacAuthorizer.Action.READ)
+                .flatMap(allowed -> allowed ? gate.authorize(principal,resource,RbacAuthorizer.Action.EXECUTE) : Mono.just(false))
+                .flatMap(allowed -> allowed ? gate.authorize(principal,execution,RbacAuthorizer.Action.CREATE) : Mono.just(false))
+                .flatMap(allowed -> allowed && outputs ? gate.authorize(principal,execution,RbacAuthorizer.Action.ACCESS_OUTPUTS) : Mono.just(allowed))
+                .flatMap(allowed -> allowed ? dependencies(principal,tenant,flow,executionId) : Mono.just(false));
+        }).timeout(Duration.ofSeconds(10)).defaultIfEmpty(false).onErrorReturn(false);
+    }
+    public Mono<Void> finishRequest() { return gate.finishCurrent(); }
+
+    public <Result> Mono<Result> readResult(Authentication authentication, String tenant, String namespace, String executionId,
+        java.util.function.Supplier<Mono<Result>> action) {
+        if (!configuration.enabled()) return Mono.defer(action);
+        var principal = authentication == null ? null : new RbacAuthorizer.Principal(authentication.getName(),
+            List.copyOf(authentication.getRoles()), null, null, List.of());
+        var resource = new RbacAuthorizer.Resource(RbacAuthorizer.Kind.EXECUTION, RbacAuthorizer.Scope.NAMESPACE,
+            tenant, namespace, executionId);
+        return gate.boundary(principal, tenant, () -> gate.authorize(principal, resource, RbacAuthorizer.Action.ACCESS_OUTPUTS)
+            .flatMap(allowed -> allowed ? Mono.defer(action) : Mono.error(new io.micronaut.http.exceptions.HttpStatusException(
+                io.micronaut.http.HttpStatus.FORBIDDEN, "Execution output authorization denied")))).singleOrEmpty();
+    }
+    public Mono<Boolean> dependencies(RbacAuthorizer.Principal principal,String tenant,Flow flow,String executionId) {
+        return Mono.defer(() -> {
+            if (!resolvers.isUnique()) return Mono.just(false);
+            return Mono.fromCallable(() -> new McpAuthorizationResolver.Invocation(tenant,flow.getNamespace(),flow.getId(),executionId,JacksonMapper.ofYaml().writeValueAsString(flow)))
+                .flatMap(invocation -> Mono.fromCompletionStage(resolvers.get().resolve(principal,invocation)))
+                .flatMap(requirements -> Flux.fromIterable(requirements).concatMap(requirement -> gate.authorize(principal,requirement.resource(),requirement.action())).all(Boolean.TRUE::equals));
+        }).timeout(Duration.ofSeconds(10)).defaultIfEmpty(false).onErrorReturn(false);
+    }
+}
