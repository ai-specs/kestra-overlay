@@ -0,0 +1,22 @@
+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CompletionStage;
+
+/** Resolve all actual operations before invocation. Unknown/unsafe routes return no plan (deny).
+ * A collection plan must cover its complete query domain; a batch covers every side effect.
+ * No response post-filtering or permission model is implemented by the overlay.
+ */
+public interface RestAuthorizationResolver {
+    enum Coverage { SINGLE, COMPLETE_QUERY, COMPLETE_BATCH }
+    record Request(String method, String path, Map<String, List<String>> query, String contentType,
+        byte[] body, String controller, String handler, List<String> parameterTypes) {
+        public Request { query = query.entrySet().stream().collect(java.util.stream.Collectors.toUnmodifiableMap(Map.Entry::getKey, e -> List.copyOf(e.getValue()))); body = body.clone(); parameterTypes = List.copyOf(parameterTypes); }
+        @Override public byte[] body() { return body.clone(); }
+    }
+    record Plan(List<RbacAuthorizer.Requirement> requirements, Coverage coverage) {
+        public Plan { requirements = List.copyOf(requirements); }
+    }
+    CompletionStage<Plan> resolve(RbacAuthorizer.Principal principal, Request request);
+}
diff --git a/webserver/src/main/java/io/kestra/webserver/rbac/RestRbacFilter.java b/webserver/src/main/java/io/kestra/webserver/rbac/RestRbacFilter.java
new file mode 100644
index 0000000..e4fc901
--- /dev/null
+++ b/webserver/src/main/java/io/kestra/webserver/rbac/RestRbacFilter.java
@@ -0,0 +1,100 @@
+package io.kestra.webserver.rbac;
+
+import java.time.Duration;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.http.*;
+import io.micronaut.http.annotation.Filter;
+import io.micronaut.http.filter.*;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import io.micronaut.web.router.RouteAttributes;
+import io.kestra.webserver.errors.ProblemFactory;
+import jakarta.inject.Singleton;
+import org.reactivestreams.Publisher;
+import reactor.core.publisher.Flux;
+import reactor.core.publisher.Mono;
+
+/** Independent gate: an earlier SecurityRule ALLOWED cannot bypass this filter. */
+@Singleton
+@Filter("/**")
+public class RestRbacFilter implements HttpServerFilter {
+    private final RbacConfiguration configuration;
+    private final BeanProvider<RestAuthorizationResolver> resolvers;
+    private final RbacGate gate;
+    private final ProblemFactory problems;
+    public RestRbacFilter(RbacConfiguration configuration, BeanProvider<RestAuthorizationResolver> resolvers,
+        RbacGate gate, ProblemFactory problems) {
+        this.configuration = configuration; this.resolvers = resolvers; this.gate = gate; this.problems = problems;
+    }
+    @Override public int getOrder() { return ServerFilterPhase.SECURITY.order() + 1; }
+    @Override public Publisher<MutableHttpResponse<?>> doFilter(HttpRequest<?> request, ServerFilterChain chain) {
+        if (!configuration.enabled() || protocol(request)) return chain.proceed(request);
+        Authentication authentication = request.getAttribute(SecurityFilter.AUTHENTICATION, Authentication.class).orElse(null);
+        if (authentication == null) return Mono.just(error(request, HttpStatus.UNAUTHORIZED));
+        return Mono.defer(() -> {
+            if (!resolvers.isUnique()) return Mono.just(false);
+            var route = RouteAttributes.getRouteMatch(request).orElse(null);
+            if (!(route instanceof io.micronaut.web.router.MethodBasedRouteMatch<?, ?> methodRoute)) return Mono.just(false);
+            var principal = new RbacAuthorizer.Principal(authentication.getName(), List.copyOf(authentication.getRoles()),
+                string(authentication, "client_id"), string(authentication, "aud"), List.of());
+            Map<String, List<String>> query = new LinkedHashMap<>();
+            request.getParameters().names().forEach(name -> query.put(name, List.copyOf(request.getParameters().getAll(name))));
+            String controller = methodRoute.getDeclaringType().getName();
+            String handler = methodRoute.getMethodName();
+            return body(request).flatMap(bytes -> Mono.fromCompletionStage(resolvers.get().resolve(principal,
+                new RestAuthorizationResolver.Request(request.getMethodName(), request.getPath(), query,
+                    request.getContentType().map(Object::toString).orElse(null), bytes, controller, handler, java.util.Arrays.stream(methodRoute.getArgumentTypes()).map(Class::getName).toList()))))
+                .flatMap(plan -> {
+                    if (plan.coverage() == null || plan.requirements().isEmpty()) return Mono.just(false);
+                    return Flux.fromIterable(plan.requirements()).concatMap(requirement -> gate.authorize(principal,
+                        requirement.resource(), requirement.action(), plan.coverage() == RestAuthorizationResolver.Coverage.COMPLETE_QUERY)).all(Boolean.TRUE::equals);
+                });
+        }).subscribeOn(reactor.core.scheduler.Schedulers.boundedElastic()).timeout(Duration.ofSeconds(10)).defaultIfEmpty(false).onErrorReturn(false)
+            .flatMapMany(allowed -> allowed ? chain.proceed(request) : Mono.just(error(request, HttpStatus.FORBIDDEN)));
+    }
+    private Mono<byte[]> body(HttpRequest<?> request) {
+        if (!(request instanceof ServerHttpRequest<?> server)) {
+            return Mono.just(request.getBody(byte[].class).orElse(new byte[0]));
+        }
+        return Mono.using(() -> server.byteBody().split(io.micronaut.http.body.ByteBody.SplitBackpressureMode.NEW), split -> Mono.fromCompletionStage(split.buffer())
+            .map(available -> { try (available) { return available.toByteArray(); } }), split -> split.close());
+    }
+    private static String string(Authentication authentication, String name) {
+        Object value = authentication.getAttributes().get(name); return value instanceof String s ? s : null;
+    }
+    private MutableHttpResponse<?> error(HttpRequest<?> request, HttpStatus status) {
+        return HttpResponse.status(status).contentType(MediaType.APPLICATION_JSON_PROBLEM_TYPE)
+            .body(problems.detailForStatus(request, null, status.getCode(), null, List.of()));
+    }
+    private static boolean protocol(HttpRequest<?> request) {
+        String path = request.getPath();
+        if (path.contains("%") || path.contains("..") || path.contains("//")) return false;
+        var route = RouteAttributes.getRouteMatch(request).orElse(null);
+        if (!(route instanceof io.micronaut.web.router.MethodBasedRouteMatch<?, ?> method)) return false;
+        if (io.micronaut.security.oauth2.routes.OauthController.class.isAssignableFrom(method.getDeclaringType())) {
+            return path.matches("/oauth/(login|callback)/[^/]+")
+                && (method.getMethodName().equals("login") || method.getMethodName().equals("callback"));
+        }
+        if (io.micronaut.security.oauth2.routes.EndSessionController.class.isAssignableFrom(method.getDeclaringType())) {
+            return path.equals("/oauth/logout") && method.getMethodName().equals("endSession");
+        }
+        String controller = method.getDeclaringType().getName();
+        if (controller.equals("io.kestra.webserver.controllers.RootController")) return path.equals("/ping");
+        if (controller.equals("io.kestra.webserver.controllers.api.MiscController")) return path.equals("/api/v1/configs/login");
+        if (controller.equals("io.kestra.webserver.controllers.api.UiController")) return path.equals("/ui") || path.startsWith("/ui/");
+        if (controller.equals("io.kestra.webserver.mcp.McpResourceMetadataController")) return path.startsWith("/.well-known/oauth-protected-resource");
+        if (controller.equals("io.kestra.webserver.oidc.controllers.OidcDiscoveryController")) return path.equals("/.well-known/openid-configuration");
+        if (controller.equals("io.kestra.webserver.oidc.controllers.OidcLoginController")) return path.equals("/oidc/login") || path.equals("/oidc/logout");
+        if (controller.equals("io.kestra.webserver.oidc.controllers.OidcProviderController")) return java.util.Set.of(
+            "/oidc/jwks", "/oidc/authorize", "/oidc/token", "/oidc/consent", "/oidc/userinfo", "/oidc/introspect", "/oidc/revoke").contains(path);
+        if (controller.equals("io.kestra.webserver.oidc.controllers.OidcOwnedClientController")) return path.equals("/oidc/clients")
+            || path.matches("/oidc/clients/[^/]+(/revoke)?");
+        if (controller.equals("io.kestra.webserver.oidc.controllers.OidcRegistrationController")) return path.equals("/oidc/register");
+        if (controller.equals("io.kestra.webserver.oidc.controllers.OidcSetupController")) return path.equals("/oidc/setup");
+        if (controller.equals("io.kestra.webserver.controllers.api.McpToolController")) return path.matches("/api/v1/[^/]+/mcp/[^/]+");
+        return false;
+    }
+}
