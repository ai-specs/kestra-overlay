+package io.kestra.webserver.rbac;
+
+import java.util.*;
+import io.kestra.webserver.controllers.api.ExecutionController;
+import io.kestra.core.models.flows.Flow;
+import io.kestra.core.runners.FlowInputOutput;
+import io.kestra.core.runners.FlowMetaStoreInterface;
+import io.kestra.core.services.FlowService;
+import io.kestra.core.tenant.TenantService;
+import io.kestra.core.queues.DispatchQueueInterface;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpStatus;
+import io.micronaut.http.context.ServerRequestContext;
+import io.micronaut.http.exceptions.HttpStatusException;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class RbacExecutionActivationTest {
+    void set(Object target,String name,Object value) throws Exception {
+        var field=ExecutionController.class.getDeclaredField(name);field.setAccessible(true);field.set(target,value);
+    }
+    @Test void productionCreateExecutionCapturesIdentityBeforeSubscriptionAndDeniesBeforeInputsOrQueue() throws Exception {
+        var controller=new ExecutionController();var flowService=mock(FlowService.class);var inputs=mock(FlowInputOutput.class);
+        var queue=mock(DispatchQueueInterface.class);var meta=mock(FlowMetaStoreInterface.class);var tenant=mock(TenantService.class);
+        var gate=mock(RbacExecutionGate.class);var flow=Flow.builder().namespace("private.ns").id("flow").tasks(List.of()).build();
+        when(tenant.resolveTenant()).thenReturn("main");when(flowService.getFlowIfExecutableOrThrow(any(),any(),any(),any())).thenReturn(flow);
+        when(meta.findByIdForRuntime(any(),any(),any(),any())).thenReturn(Optional.empty());
+        when(gate.checked(any(),any(),any(),any(),anyBoolean(),any())).thenReturn(Mono.error(new HttpStatusException(HttpStatus.FORBIDDEN,"Execution authorization denied")));
+        set(controller,"modelValidator",mock(io.kestra.core.models.validations.ModelValidator.class));set(controller,"flowService",flowService);set(controller,"flowInputOutput",inputs);set(controller,"executionCommandQueue",queue);
+        set(controller,"flowMetaStore",meta);set(controller,"tenantService",tenant);set(controller,"rbacExecutionGate",gate);
+        var request=HttpRequest.POST("/api/v1/main/executions/private.ns/flow","");
+        var identity=Authentication.build("alice",List.of("reader"));request.setAttribute(SecurityFilter.AUTHENTICATION,identity);
+        java.util.function.Supplier<org.reactivestreams.Publisher<?>> invocation=() -> controller.createExecution("private.ns","flow",null,null,true,Optional.empty(),Optional.empty(),Optional.empty(),Optional.empty());
+        var publisher=ServerRequestContext.with(request,invocation);
+        var exception=assertThrows(HttpStatusException.class,() -> Mono.from(publisher).block());assertEquals(HttpStatus.FORBIDDEN,exception.getStatus());
+        verify(gate).checked(eq(identity),eq("main"),argThat(actual -> actual.getNamespace().equals("private.ns") && actual.getId().equals("flow")),anyString(),eq(true),any());verifyNoInteractions(inputs,queue);
+    }
+}
