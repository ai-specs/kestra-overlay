@@ -0,0 +1,42 @@
+package io.kestra.webserver.rbac;
+
+import java.time.Duration;
+import io.micronaut.context.BeanProvider;
+import jakarta.inject.Singleton;
+import reactor.core.publisher.Mono;
+
+@Singleton
+public class RbacGate {
+    private final BeanProvider<RbacAuthorizer> authorizers;
+    public RbacGate(BeanProvider<RbacAuthorizer> authorizers) { this.authorizers = authorizers; }
+    public Mono<Boolean> authorize(RbacAuthorizer.Principal principal, RbacAuthorizer.Resource resource,
+        RbacAuthorizer.Action action) {
+        return authorize(principal, resource, action, false);
+    }
+    public Mono<Boolean> authorize(RbacAuthorizer.Principal principal, RbacAuthorizer.Resource resource,
+        RbacAuthorizer.Action action, boolean completeQuery) {
+        return Mono.defer(() -> {
+            if (principal == null || principal.subject() == null || principal.subject().isBlank()
+                || action == null || !(valid(resource) || queryDomain(resource, action, completeQuery)) || !authorizers.isUnique()) return Mono.just(false);
+            return Mono.fromCompletionStage(authorizers.get().authorize(principal, resource, action));
+        }).timeout(Duration.ofSeconds(5)).defaultIfEmpty(false).onErrorReturn(false);
+    }
+    private static boolean queryDomain(RbacAuthorizer.Resource resource, RbacAuthorizer.Action action, boolean completeQuery) {
+        return completeQuery && resource != null && resource.kind() != null && resource.scope() == RbacAuthorizer.Scope.TENANT
+            && resource.tenant() != null && !resource.tenant().isBlank() && resource.namespace() == null && resource.id() == null
+            && (action == RbacAuthorizer.Action.LIST || action == RbacAuthorizer.Action.READ);
+    }
+    static boolean valid(RbacAuthorizer.Resource resource) {
+        if (resource == null || resource.kind() == null || resource.scope() == null) return false;
+        if (resource.scope() == RbacAuthorizer.Scope.INSTANCE) return resource.kind() == RbacAuthorizer.Kind.SYSTEM
+            && resource.tenant() == null && resource.namespace() == null && resource.id() == null;
+        if (resource.scope() == RbacAuthorizer.Scope.TENANT) return resource.tenant() != null && !resource.tenant().isBlank()
+            && resource.namespace() == null && tenantKind(resource.kind());
+        return resource.scope() == RbacAuthorizer.Scope.NAMESPACE && resource.tenant() != null && !resource.tenant().isBlank()
+            && resource.namespace() != null && !resource.namespace().isBlank();
+    }
+    private static boolean tenantKind(RbacAuthorizer.Kind kind) {
+        return kind == RbacAuthorizer.Kind.SYSTEM || kind == RbacAuthorizer.Kind.MCP_SERVER
+            || kind == RbacAuthorizer.Kind.AI || kind == RbacAuthorizer.Kind.DASHBOARD || kind == RbacAuthorizer.Kind.BLUEPRINT;
+    }
+}
