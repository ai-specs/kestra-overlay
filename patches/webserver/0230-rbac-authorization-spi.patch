+        var context=new McpSessionFactory().build("main","default","session","alice","ui","api",List.of(McpCapabilityGate.FLOW_READ,McpCapabilityGate.EXECUTION_WRITE),List.of("reader"));
+        assertFalse(unified.preflight(context,"main","exec",flow).block()); assertTrue(new McpCapabilityGate(true,true,false,null).preflight(context,"main","exec",flow).block());
+        var resolver=mock(McpAuthorizationResolver.class);
