@@ -0,0 +1,73 @@
+package io.kestra.webserver.rbac;
+
+import io.kestra.core.models.AccessScope;
+import io.kestra.core.models.QueryFilter;
+import io.kestra.core.repositories.NamespaceAccessControl;
+import io.kestra.jdbc.repository.AbstractJdbcRepository;
+import java.sql.DriverManager;
+import java.util.List;
+import org.jooq.Condition;
+import org.jooq.SQLDialect;
+import org.jooq.impl.DSL;
+import org.junit.jupiter.api.Test;
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+
+class TypedResourceDomainBoundaryTest {
+    private QueryDomain domain(boolean restricted) {
+        return new QueryDomain(List.of("a"), List.of(), List.of(), true, true, DomainKind.RESTRICTED,
+            List.of(new QueryDomain.ResourceDomain(List.of("a"), List.of(), List.of(), restricted ? List.of("one") : List.of(),
+                QueryDomain.ResourceScope.NAMESPACE, restricted ? QueryDomain.IdScope.RESTRICTED_IDS : QueryDomain.IdScope.ALL_IDS)));
+    }
+    private TypedNamespaceAccessControl control(QueryDomain domain) throws Exception {
+        var result = mock(TypedNamespaceAccessControl.class, CALLS_REAL_METHODS);
+        doReturn(domain).when(result).domain(any());
+        var field = TypedNamespaceAccessControl.class.getDeclaredField("gate"); field.setAccessible(true); field.set(result, mock(TypedAuthorizationGate.class));
+        return result;
+    }
+    private Condition jdbc(TypedNamespaceAccessControl control, QueryFilter.Resource resource) throws Exception {
+        AbstractJdbcRepository repository = new AbstractJdbcRepository() {
+            protected NamespaceAccessControl namespaceAccessControl() { return control; }
+        };
+        var method = AbstractJdbcRepository.class.getDeclaredMethod("aclCondition", QueryFilter.Resource.class); method.setAccessible(true);
+        return (Condition) method.invoke(repository, resource);
+    }
+    @Test void nonFlowAllIdsQueriesRemainUsableAndNamespaceFiltered() throws Exception {
+        try (var connection = DriverManager.getConnection("jdbc:h2:mem:;DATABASE_TO_LOWER=TRUE")) {
+            var db = DSL.using(connection, SQLDialect.H2);
+            db.execute("create table candidates(namespace varchar(255), id varchar(255))");
+            db.execute("insert into candidates values ('a','one'),('a','two'),('b','one')");
+            for (var resource : List.of(QueryFilter.Resource.NAMESPACE, QueryFilter.Resource.LOG, QueryFilter.Resource.TRIGGER,
+                QueryFilter.Resource.KV_METADATA, QueryFilter.Resource.NAMESPACE_FILE_METADATA)) {
+                var condition = jdbc(control(domain(false)), resource);
+                assertThat(db.fetchCount(db.selectFrom(DSL.table("candidates")).where(condition))).as(resource.name()).isEqualTo(2);
+                assertThat(db.select(DSL.field("namespace", String.class)).from("candidates").where(condition).limit(1).fetch(0, String.class)).containsExactly("a");
+                assertThat(db.fetchCount(db.selectFrom(DSL.table("candidates")).where(jdbc(control(domain(true)), resource)))).as(resource.name()+" restricted").isZero();
+            }
+        }
+    }
+    @Test void namespaceOnlyAndLogConsumersNeverDropRestrictedIds() throws Exception {
+        var restricted = control(domain(true));
+        assertThat(restricted.namespaceAllowed(QueryFilter.Resource.FLOW, "a")).isFalse();
+        assertThat(restricted.namespaceScope(QueryFilter.Resource.FLOW).kind()).isEqualTo(AccessScope.Kind.DENY_ALL);
+        assertThat(new TypedLogAccessControl(restricted).namespaceScope().kind()).isEqualTo(AccessScope.Kind.DENY_ALL);
+        assertThat(restricted.resourceReadAllowed(QueryFilter.Resource.LOG, "main", "a", "one")).isFalse();
+        assertThat(restricted.resourceReadAllowed(QueryFilter.Resource.FLOW, "main", "a", "one")).isTrue();
+        assertThat(restricted.resourceReadAllowed(QueryFilter.Resource.FLOW, "main", "a", "two")).isFalse();
+        var all = control(domain(false));
+        assertThat(all.namespaceAllowed(QueryFilter.Resource.FLOW, "a")).isTrue();
+        assertThat(all.namespaceAllowed(QueryFilter.Resource.FLOW, "b")).isFalse();
+        assertThat(new TypedLogAccessControl(all).namespaceScope().namespaceAllowed("a")).isTrue();
+        assertThat(new TypedLogAccessControl(all).namespaceScope().namespaceAllowed("b")).isFalse();
+    }
+    @Test void exactResourcePredicatesPreserveNamespaceIdAssociation() throws Exception {
+        var terms = List.of(new QueryDomain.ResourceDomain(List.of("a"), List.of(), List.of(), List.of("one")),
+            new QueryDomain.ResourceDomain(List.of("b"), List.of(), List.of(), List.of("two")));
+        var control = control(new QueryDomain(List.of("a","b"),List.of(),List.of(),true,true,DomainKind.RESTRICTED,terms));
+        assertThat(control.resourceReadAllowed(QueryFilter.Resource.FLOW,"main","a","one")).isTrue();
+        assertThat(control.resourceReadAllowed(QueryFilter.Resource.FLOW,"main","b","two")).isTrue();
+        assertThat(control.resourceReadAllowed(QueryFilter.Resource.FLOW,"main","a","two")).isFalse();
+        assertThat(control.resourceReadAllowed(QueryFilter.Resource.FLOW,"main","b","one")).isFalse();
+    }
+}
