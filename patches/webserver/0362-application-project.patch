+package io.kestra.webserver.oidc;
+
+import io.kestra.core.repositories.AuthorizationInvocationContext;
+import io.kestra.webserver.oidc.projects.ProjectDirectoryState;
+import io.kestra.webserver.oidc.services.OidcIdentityLifecycle;
+import io.kestra.webserver.oidc.services.OidcTrustedIdentity;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.context.env.Environment;
+import io.micronaut.core.propagation.PropagatedContext;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+/** Host context probes only; real OAuth callback and browser evidence remain release gates. */
+class OidcTrustedIdentityTest {
+    private static final String ISSUER = "https://identity.example.invalid";
+    private static final String RESOURCE = ISSUER + "/api/v1/main/mcp/default";
+    private final ProjectDirectoryState directory = mock(ProjectDirectoryState.class);
+    private final OidcIdentityLifecycle lifecycle = mock(OidcIdentityLifecycle.class);
+    private final OidcConfiguration configuration = new OidcConfiguration();
+    private Set<String> declaredScopes = Set.of("read");
+
+    private OidcTrustedIdentity service() throws Exception {
+        configuration.setIssuer(ISSUER);
+        when(lifecycle.matches("alice", 3L)).thenReturn(true);
+        var project = new ApplicationDirectoryV1.Project("project", "main", ISSUER, "Project", true, 19, 7);
+        var scope = new ApplicationDirectoryV1.ScopeDefinition("project", "read", "Reader", "", true, List.of(), List.of(), 1);
+        var member = new ApplicationDirectoryV1.ClientMembership("project", "ui", true, Set.of("ui", RESOURCE), Set.of("read"), true, 1);
+        var assignment = new ApplicationDirectoryV1.SubjectAssignment("project", ISSUER, "alice", Set.of("read"), 1, 1);
+        when(directory.snapshot("project")).thenReturn(new ProjectDirectoryState.Snapshot(project, List.of(scope), List.of(member), List.of(assignment), 19));
+        var provider = new BeanProvider<ProjectDirectoryState>() {
+            public ProjectDirectoryState get() { return directory; }
+            public boolean isUnique() { return true; }
+        };
+        ApplicationScopeDeclarationsV1 declarations = (groupId, clientId) -> new ApplicationScopeDeclarationsV1.Projection(
+            groupId, clientId, declaredScopes.stream().map(key -> new ApplicationScopeDeclarationsV1.Scope(key,
+                List.of(new ApplicationScopeDeclarationsV1.Permission("view-flows", "View flows")))).toList());
+        var declarationProvider = new BeanProvider<ApplicationScopeDeclarationsV1>() {
+            public ApplicationScopeDeclarationsV1 get() { return declarations; }
+            public boolean isUnique() { return true; }
+        };
+        var result = new OidcTrustedIdentity(provider, declarationProvider, configuration, lifecycle);
+        var environment = mock(Environment.class);
+        when(environment.getProperty("kestra.oidc.bootstrap.client-name", String.class)).thenReturn(Optional.of("kestra"));
+        when(environment.getProperty("micronaut.security.oauth2.clients.kestra.client-id", String.class)).thenReturn(Optional.of("ui"));
+        var field = OidcTrustedIdentity.class.getDeclaredField("environment"); field.setAccessible(true); field.set(result, environment);
+        return result;
+    }
+    private Authentication identity(String audience, long epoch, Set<String> scopes) {
+        var claim = Map.of("application_group_id", "project", "client_id", "ui", "authorization_version", epoch,
+            "application_group_scopes", scopes, "protocol_scopes", Set.of("openid"));
+        return Authentication.build("alice", List.of("legacy-admin"), Map.of("iss", ISSUER, "aud", List.of(audience),
+            OidcTrustedIdentity.CLAIM, claim, OidcIdentityLifecycle.CLAIM, 3L, "resource", RESOURCE));
+    }
+    @Test void uiContextPreservesDistinctRevisionAndEpoch() throws Exception {
+        var service = service();
+        var request = HttpRequest.GET("/api/v1/main/flows/search");
+        request.setAttribute(SecurityFilter.AUTHENTICATION, identity("ui", 7, Set.of("read")));
+        try (var scope = PropagatedContext.getOrEmpty().plus(new AuthorizationInvocationContext(request, false)).propagate()) {
+            var value = service.current();
+            assertThat(value.directoryRevision()).isEqualTo(19);
+            assertThat(value.authorizationVersion()).isEqualTo(7);
+            assertThat(value.projectScopes()).containsExactly("read");
+        }
+    }
+    @Test void mcpUsesCurrentResourceAuthenticationInsteadOfAmbientCookie() throws Exception {
+        var service = service();
+        var request = HttpRequest.POST("/api/v1/main/mcp/default", "");
+        request.setAttribute("io.kestra.mcp.authentication", identity(RESOURCE, 7, Set.of("read")));
+        request.setAttribute(SecurityFilter.AUTHENTICATION, Authentication.build("foreign-cookie"));
+        try (var scope = PropagatedContext.getOrEmpty().plus(new AuthorizationInvocationContext(request, false)).propagate()) {
+            assertThat(service.current().subject()).isEqualTo("alice");
+        }
+    }
+    @Test void rejectsOldEpochUnknownScopeAndIncorrectUiAudience() throws Exception {
+        var service = service();
+        assertThatThrownBy(() -> service.validate(identity("ui", 6, Set.of("read")))).isInstanceOf(IllegalStateException.class);
+        assertThatThrownBy(() -> service.validate(identity("ui", 7, Set.of("read", "unknown")))).isInstanceOf(IllegalStateException.class);
+        assertThatThrownBy(() -> service.validate(identity(RESOURCE, 7, Set.of("read")))).isInstanceOf(IllegalStateException.class);
+    }
+    @Test void missingContextNeverCreatesTrustedIdentity() throws Exception {
+        var service = service();
+        assertThatThrownBy(service::current).isInstanceOf(IllegalStateException.class);
+    }
+    @Test void revokedApplicationDeclarationRejectsExistingIdentity() throws Exception {
+        var service = service();
+        assertThat(service.validate(identity("ui", 7, Set.of("read"))).projectScopes()).containsExactly("read");
+        declaredScopes = Set.of();
+        assertThatThrownBy(() -> service.validate(identity("ui", 7, Set.of("read"))))
+            .isInstanceOf(IllegalStateException.class);
+    }
+    @Test void missingDeclarationProviderRejectsTrustedIdentity() throws Exception {
+        configuration.setIssuer(ISSUER);
+        BeanProvider<ApplicationScopeDeclarationsV1> absent = new BeanProvider<>() {
+            public ApplicationScopeDeclarationsV1 get() { throw new IllegalStateException("missing"); }
+            public boolean isUnique() { return false; }
+        };
+        var service = new OidcTrustedIdentity(new BeanProvider<>() {
+            public ProjectDirectoryState get() { return directory; }
+            public boolean isUnique() { return true; }
+        }, absent, configuration, lifecycle);
+        assertThatThrownBy(() -> service.validate(identity("ui", 7, Set.of("read"))))
+            .isInstanceOf(IllegalStateException.class);
+    }
+}
