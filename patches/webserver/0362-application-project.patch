+package io.kestra.webserver.rbac;
+
+import io.kestra.core.repositories.TenantResourceAccessControl;
+import io.kestra.core.repositories.GlobalTenantResourceAccessControl;
+import io.kestra.core.repositories.AuthorizationInvocationContext;
+import io.micronaut.context.annotation.Replaces;
+import io.micronaut.context.annotation.Requires;
+import jakarta.inject.Singleton;
+import java.util.List;
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+
+@Singleton
+@Replaces(GlobalTenantResourceAccessControl.class)
+@Requires(property = "kestra.rbac.enabled", value = "true")
+@Requires(property = "kestra.rbac.typed.enabled", value = "true")
+public final class TypedTenantResourceAccessControl implements TenantResourceAccessControl {
+    private final TypedAuthorizationGate gate;
+    public TypedTenantResourceAccessControl(TypedAuthorizationGate gate) { this.gate = gate; }
+    public Domain domain(String resource, String tenant) {
+        var empty = new Domain(Kind.RESTRICTED_IDS, List.of());
+        if (!"MCP_SERVER".equals(resource)) return empty;
+        var owner = AuthorizationEvaluations.current();
+        if (owner == null) return AuthorizationInvocationContext.isInternal() ? new Domain(Kind.ALL_IDS, List.of()) : empty;
+        if (!owner.matches(owner.principal, tenant)) return empty;
+        var operation = new Operation(1, Source.REST, Resource.MCP_SERVER, Action.LIST, tenant, null, null,
+            QueryDomain.unrestricted(), Coverage.COMPLETE_QUERY, Aggregate.NONE, SideEffect.READ_ONLY);
+        try {
+            var decision = gate.authorize(owner.principal, operation).block();
+            if (decision == null || !decision.allowed()) return empty;
+            var scope = decision.scope();
+            if (scope.resourceDomains().isEmpty()) return scope.kind() == DomainKind.GLOBAL ? new Domain(Kind.ALL_IDS, List.of()) : empty;
+            var terms = scope.resourceDomains().stream().filter(term -> term.resourceScope() == QueryDomain.ResourceScope.TENANT).toList();
+            if (terms.stream().anyMatch(term -> term.idScope() == QueryDomain.IdScope.ALL_IDS)) return new Domain(Kind.ALL_IDS, List.of());
+            return new Domain(Kind.RESTRICTED_IDS, terms.stream().flatMap(term -> term.resourceIds().stream()).distinct().toList());
+        } catch (RuntimeException failure) { return empty; }
+    }
+}
