+            statement.execute("INSERT INTO oidc_user(username,name,email) VALUES('alice','Alice','alice@example.invalid') ON CONFLICT(username) DO UPDATE SET user_state='ACTIVE',authentication_version=0");
+            statement.execute("INSERT INTO oidc_client(client_id,client_secret,client_kind,scopes,active) VALUES('ui','secret','system','[\"openid\",\"profile\"]',true) ON CONFLICT(client_id) DO UPDATE SET active=true,client_kind='system',client_secret='secret',scopes='[\"openid\",\"profile\"]'");
