+class OidcProjectTokenIssuanceTest extends OidcPostgresTestBase {
+    private static final String ISSUER = "https://identity.example.invalid";
+
+    @Test
+    void shouldSignSeparatedProtocolAndProjectClaims() throws Exception {
+        var directory = directory(Set.of("read"), 1);
+        var service = service(directory);
+        assertThat(service.applicationScopeDescription("ui", "read")).contains("Reader", "View flows");
+        var tokens = service.issueAuthorizationTokens("ui", user(), new Scope("openid", "profile", "read"), null, "nonce", "application-group-v1.project.1.code");
+        JWTClaimsSet claims = service.validateAccessToken(tokens.getAccessToken().getValue());
+        var claim = (Map<?, ?>) claims.getClaim("kestra_application_group_v1");
+        assertThat((java.util.Collection<?>) claim.get("application_group_scopes")).extracting(Object::toString).containsExactly("read");
+        assertThat((java.util.Collection<?>) claim.get("protocol_scopes")).extracting(Object::toString).containsExactlyInAnyOrder("openid", "profile");
+        assertThat(claims.getStringClaim("scope").split(" ")).containsExactlyInAnyOrder("openid", "profile", "read");
+    }
+
+    @Test
+    void shouldIssueZeroProjectScopesForUnassignedSubject() throws Exception {
+        var directory = directory(Set.of(), 1);
+        var service = service(directory);
+        var tokens = service.issueAuthorizationTokens("ui", user(), new Scope("openid", "profile"), null, null, "application-group-v1.project.1.code");
+        var claim = (Map<?, ?>) service.validateAccessToken(tokens.getAccessToken().getValue()).getClaim("kestra_application_group_v1");
+        assertThat((java.util.Collection<?>) claim.get("application_group_scopes")).isEmpty();
+    }
+
+    @Test
+    void shouldRejectAccessAfterProjectEpochChanges() throws Exception {
+        var directory = directory(Set.of("read"), 1);
+        var service = service(directory);
+        var tokens = service.issueAuthorizationTokens("ui", user(), new Scope("openid", "read"), null, null, "application-group-v1.project.1.code");
+        when(directory.forClient(anyString())).thenReturn(Optional.of(snapshot(Set.of("read"), 2)));
+        assertThatThrownBy(() -> service.validateAccessToken(tokens.getAccessToken().getValue()))
+            .isInstanceOf(RuntimeException.class);
+    }
+
+    private OidcTokenService service(ProjectDirectoryState directory) throws Exception {
+        var configuration = new OidcConfiguration();
+        configuration.setIssuer(ISSUER);
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("INSERT INTO oidc_user(username,name,email) VALUES('alice','Alice','alice@example.invalid') ON CONFLICT(username) DO UPDATE SET user_state='ACTIVE'");
+            statement.execute("INSERT INTO oidc_client(client_id,client_secret,client_kind,scopes,active) VALUES('ui','secret','system','[\"openid\",\"profile\"]',true) ON CONFLICT(client_id) DO UPDATE SET active=true,client_kind='system'");
+            statement.execute("INSERT INTO oidc_authorization_code(code,client_id,subject,redirect_uri,expires_at,used,authentication_version) VALUES('application-group-v1.project.1.code','ui','alice','https://identity.example.invalid/callback',now()+interval '5 minutes',true,0) ON CONFLICT(code) DO UPDATE SET used=true,authentication_version=0");
+        }
+        var service = new OidcTokenService(dataSource(), new ObjectMapper(), configuration,
+            new OidcJwkService(dataSource()), provider(directory), provider(declarations()));
+        var mode = OidcTokenService.class.getDeclaredField("applicationProjects");
+        mode.setAccessible(true); mode.set(service, true);
+        return service;
+    }
+
+    private static <T> BeanProvider<T> provider(T value) { return new BeanProvider<>() { public T get() { return value; } public boolean isUnique() { return true; } public boolean isPresent() { return true; } }; }
+
+    private static ApplicationScopeDeclarationsV1 declarations() {
+        return (groupId, clientId) -> new ApplicationScopeDeclarationsV1.Projection(groupId, clientId,
+            List.of(new ApplicationScopeDeclarationsV1.Scope("read",
