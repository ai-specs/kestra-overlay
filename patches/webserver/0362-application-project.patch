@@ -0,0 +1,115 @@
+package io.kestra.webserver.oidc.services;
+
+import io.kestra.core.repositories.AuthorizationInvocationContext;
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.kestra.webserver.oidc.ApplicationScopeDeclarationsV1;
+import io.kestra.webserver.oidc.TrustedIdentityV1;
+import io.kestra.webserver.oidc.projects.ProjectDirectoryState;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import jakarta.inject.Singleton;
+import java.util.Collection;
+import java.util.Map;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+@Singleton
+@Requires(property = "kestra.rbac.application-groups.enabled", value = "true")
+public final class OidcTrustedIdentity implements TrustedIdentityV1 {
+    public static final String CLAIM = "kestra_application_group_v1";
+    private final BeanProvider<ProjectDirectoryState> directories;
+    private final BeanProvider<ApplicationScopeDeclarationsV1> declarations;
+    private final OidcConfiguration configuration;
+    private final OidcIdentityLifecycle lifecycle;
+    @jakarta.inject.Inject
+    private io.micronaut.context.env.Environment environment;
+
+    public OidcTrustedIdentity(BeanProvider<ProjectDirectoryState> directories,
+        BeanProvider<ApplicationScopeDeclarationsV1> declarations,
+        OidcConfiguration configuration, OidcIdentityLifecycle lifecycle) {
+        this.directories = directories;
+        this.declarations = declarations;
+        this.configuration = configuration;
+        this.lifecycle = lifecycle;
+    }
+
+    @Override
+    public Identity current() {
+        var request = AuthorizationInvocationContext.currentRequest().orElseThrow(() -> denied());
+        var authentication = request.getAttribute("io.kestra.mcp.authentication", Authentication.class)
+            .or(() -> request.getAttribute(SecurityFilter.AUTHENTICATION, Authentication.class))
+            .orElseThrow(() -> denied());
+        return validate(authentication);
+    }
+
+    public Identity validate(Authentication authentication) {
+        var attributes = authentication.getAttributes();
+        if (!configuration.getIssuer().equals(attributes.get("iss")) || !directories.isUnique()
+            || !declarations.isUnique()) throw denied();
+        Object raw = attributes.get(CLAIM);
+        if (!(raw instanceof Map<?, ?> claim)) throw denied();
+        String projectId = text(claim.get("application_group_id"));
+        var snapshot = directories.get().snapshot(projectId);
+        var project = snapshot.project();
+        long epoch = number(claim.get("authorization_version"));
+        long authenticationVersion = number(attributes.get(OidcIdentityLifecycle.CLAIM));
+        if (!project.active() || !configuration.getIssuer().equals(project.issuer())
+            || project.authorizationVersion() != epoch
+            || !lifecycle.matches(authentication.getName(), authenticationVersion)) throw denied();
+        String clientId = text(claim.get("client_id"));
+        var audiences = strings(attributes.get("aud"));
+        var member = snapshot.memberships().stream().filter(value -> value.approved()
+            && value.clientId().equals(clientId)).findFirst().orElseThrow(() -> denied());
+        if (audiences.isEmpty() || !member.audiences().containsAll(audiences)) throw denied();
+        var request = AuthorizationInvocationContext.currentRequest().orElse(null);
+        var mcpIdentity = request == null ? null : request.getAttribute("io.kestra.mcp.authentication", Authentication.class).orElse(null);
+        if (mcpIdentity != null) {
+            Object resource = attributes.get("resource");
+            if (resource == null || !audiences.equals(Set.of(String.valueOf(resource)))) throw denied();
+        } else {
+            if (environment == null) throw denied();
+            String name = environment.getProperty("kestra.oidc.bootstrap.client-name", String.class).orElse("kestra");
+            String uiClient = environment.getProperty("micronaut.security.oauth2.clients." + name + ".client-id", String.class).orElseThrow(() -> denied());
+            if (!clientId.equals(uiClient) || !audiences.equals(Set.of(uiClient)) || !member.firstPartyUi()) throw denied();
+        }
+        var scopes = strings(claim.get("application_group_scopes"));
+        var protocols = strings(claim.get("protocol_scopes"));
+        var assignment = snapshot.assignments().stream().filter(value -> value.subject().equals(authentication.getName())
+            && value.issuer().equals(project.issuer())).findFirst();
+        var allowed = snapshot.scopes().stream().filter(value -> value.active()).map(value -> value.scope()).collect(Collectors.toSet());
+        allowed.retainAll(member.allowedProjectScopes());
+        allowed.retainAll(assignment.map(value -> value.projectScopes()).orElse(Set.of()));
+        var declared = declarations.get().current(project.id(), clientId);
+        if (!project.id().equals(declared.applicationGroupId()) || !clientId.equals(declared.clientId())) throw denied();
+        allowed.retainAll(declared.supportedScopeKeys());
+        if (!allowed.containsAll(scopes)) throw denied();
+        var knownProtocols = new java.util.HashSet<>(Set.of("openid", "profile", "email"));
+        knownProtocols.addAll(directories.get().protocolScopes().stream().map(value -> value.scope()).toList());
+        if (!knownProtocols.containsAll(protocols) || protocols.contains("kestra:application-group-scopes")) throw denied();
+        return new Identity(1, project.issuer(), authentication.getName(), clientId, audiences,
+            project.tenant(), project.id(), protocols, scopes, authenticationVersion, epoch, snapshot.directoryRevision());
+    }
+
+    private static String text(Object value) {
+        if (!(value instanceof String text) || text.isBlank()) throw denied();
+        return text;
+    }
+
+    private static long number(Object value) {
+        if (!(value instanceof Number)) throw denied();
+        try { return new java.math.BigDecimal(value.toString()).longValueExact(); }
+        catch (ArithmeticException | NumberFormatException failure) { throw denied(); }
+    }
+
+    private static Set<String> strings(Object value) {
+        if (value instanceof String text) return Set.of(text);
+        if (!(value instanceof Collection<?> collection)) throw denied();
+        return collection.stream().map(OidcTrustedIdentity::text).collect(Collectors.toUnmodifiableSet());
+    }
+
+    private static IllegalStateException denied() {
+        return new IllegalStateException("Trusted project identity is unavailable");
+    }
+}
