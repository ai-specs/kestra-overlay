+            true, mock(BeanProvider.class), mock(BeanProvider.class), mock(BeanProvider.class), true))
+            .isInstanceOf(IllegalArgumentException.class);
+    }
+
+    @Test
+    void shouldNeverFallBackToV1WhenProjectProviderIsMissing() {
+        BeanProvider<AuthorizationEvaluationProviderV1> legacy = mock(BeanProvider.class);
+        when(legacy.isUnique()).thenReturn(true);
+        BeanProvider<AuthorizationEvaluationProviderV2> modern = mock(BeanProvider.class);
+        BeanProvider<TrustedIdentityV1> identities = mock(BeanProvider.class);
+        when(identities.isUnique()).thenReturn(true);
+        var evaluations = new AuthorizationEvaluations(true, new RbacConfiguration(true, false),
+            true, legacy, modern, identities, true);
+        var principal = new RbacAuthorizer.Principal("alice", List.of(), null, null, List.of());
+        assertThatThrownBy(() -> evaluations.boundary(principal, "main", () -> Mono.just(true)).blockLast())
+            .isInstanceOf(IllegalStateException.class);
+        verify(legacy, never()).get();
+    }
+}
