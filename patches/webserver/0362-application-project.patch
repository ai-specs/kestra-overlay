+        SingleConnectionSource(DataSource delegate){this.delegate=delegate;}
+        int active(){return 1-permit.availablePermits();}
+        public Connection getConnection()throws java.sql.SQLException {
+            try{if(!permit.tryAcquire(300,java.util.concurrent.TimeUnit.MILLISECONDS))throw new java.sql.SQLException("Nested connection borrow");}
+            catch(InterruptedException failure){Thread.currentThread().interrupt();throw new java.sql.SQLException(failure);}
+            final Connection connection;
+            try{connection=delegate.getConnection();}catch(java.sql.SQLException failure){permit.release();throw failure;}
