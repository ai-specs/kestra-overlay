+    }
+
+    private ProjectDirectoryState directory(Set<String> assignment, long epoch) throws Exception {
+        var state = mock(ProjectDirectoryState.class);
+        when(state.activated()).thenReturn(true);
+        when(state.activated(any())).thenReturn(true);
+        when(state.forClient(anyString())).thenReturn(Optional.of(snapshot(assignment, epoch)));
+        when(state.forClient(any(), anyString())).thenReturn(Optional.of(snapshot(assignment, epoch)));
+        when(state.protocolScopes()).thenReturn(List.of());
+        when(state.protocolScopes(any())).thenReturn(List.of());
+        return state;
+    }
+
+    private ProjectDirectoryState.Snapshot snapshot(Set<String> assignment, long epoch) {
+        var project = new ApplicationDirectoryV1.Project("project", "main", ISSUER, "Project", true, 1, epoch);
+        var definition = new ApplicationDirectoryV1.ScopeDefinition("project", "read", "Reader", "", true, List.of(), List.of(), 1);
+        var member = new ApplicationDirectoryV1.ClientMembership("project", "ui", true, Set.of("ui"), Set.of("read"), true, 1);
+        var subject = new ApplicationDirectoryV1.SubjectAssignment("project", ISSUER, "alice", assignment, 1, epoch);
+        return new ProjectDirectoryState.Snapshot(project, List.of(definition), List.of(member), List.of(subject), 1);
+    }
+
+    private OidcUserService.OidcUser user() {
+        return new OidcUserService.OidcUser("alice", "Alice", "alice@example.invalid", false, List.of());
+    }
