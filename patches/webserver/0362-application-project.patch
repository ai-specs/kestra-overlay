+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import static org.assertj.core.api.Assertions.*;
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+
+class QueryDomainFailClosedTest {
+    private QueryDomain scoped(String namespace, String id) {
+        return new QueryDomain(List.of(namespace),List.of(),List.of(),true,true,DomainKind.RESTRICTED,
+            List.of(new QueryDomain.ResourceDomain(List.of(namespace),List.of(),List.of(),List.of(id))));
+    }
+    @Test void incompatibleResourceScopesIntersectToExplicitDeny() {
+        var left = scoped("a","one");
+        var right = new QueryDomain(List.of(),List.of(),List.of(),true,true,DomainKind.GLOBAL,
+            List.of(new QueryDomain.ResourceDomain(List.of(),List.of(),List.of(),List.of("two"),QueryDomain.ResourceScope.TENANT,QueryDomain.IdScope.RESTRICTED_IDS)));
+        assertThat(left.resourceAllowed("a","other")).isFalse();
+        assertThat(right.resourceAllowed("a","other")).isFalse();
+        var intersection = left.intersect(right);
+        assertThat(intersection.resourceAllowed("a","other")).isFalse();
+        assertThat(intersection.resourceAllowed("a","one")).isFalse();
+        assertThat(intersection.kind()).isEqualTo(DomainKind.RESTRICTED);
+        assertThat(intersection.exactNamespaces()).isEmpty();
+    }
+    @Test void disjointIdsAndNamespacesNeverBecomeLegacyNamespaceGrants() {
+        for (var other : List.of(scoped("a","two"),scoped("b","one"))) {
+            var empty = scoped("a","one").intersect(other);
+            assertThat(empty.resourceAllowed("a","one")).isFalse();
+            assertThat(empty.contains("a")).isFalse();
+            assertThat(empty.resourceDomains()).isEmpty();
+        }
+    }
+    @Test void rejectsContradictoryTenantOuterDomainAndAllIdsSelectors() {
+        var tenant = new QueryDomain.ResourceDomain(List.of(),List.of(),List.of(),List.of("one"),QueryDomain.ResourceScope.TENANT,QueryDomain.IdScope.RESTRICTED_IDS);
+        assertThatThrownBy(() -> new QueryDomain(List.of("a"),List.of(),List.of(),true,true,DomainKind.RESTRICTED,List.of(tenant))).isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> new QueryDomain.ResourceDomain(List.of("a"),List.of(),List.of(),List.of("one"),QueryDomain.ResourceScope.NAMESPACE,QueryDomain.IdScope.ALL_IDS)).isInstanceOf(IllegalArgumentException.class);
+    }
+    @Test void emptyRestrictedTermDeniesAndValidIntersectionKeepsAssociation() {
+        var empty = new QueryDomain(List.of("a"),List.of(),List.of(),true,true,DomainKind.RESTRICTED,
+            List.of(new QueryDomain.ResourceDomain(List.of("a"),List.of(),List.of(),List.of())));
+        assertThat(empty.resourceAllowed("a","one")).isFalse();
+        assertThat(empty.contains("a")).isFalse();
+        var both = scoped("a","one").intersect(scoped("a","one"));
+        assertThat(both.resourceAllowed("a","one")).isTrue();
+        assertThat(both.resourceAllowed("a","two")).isFalse();
+    }
+}
diff --git a/webserver/src/test/java/io/kestra/webserver/rbac/TypedResourceDomainBoundaryTest.java b/webserver/src/test/java/io/kestra/webserver/rbac/TypedResourceDomainBoundaryTest.java
