+package io.kestra.webserver.oidc.services;
+
+import io.kestra.core.repositories.AuthorizationInvocationContext;
+import io.kestra.webserver.oidc.ApplicationGroupProtocolProjectionV1;
+import io.kestra.webserver.oidc.ApplicationGroupScopeIssuance;
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.kestra.webserver.oidc.OidcProtocolStateV1;
+import io.kestra.webserver.oidc.TrustedIdentityV1;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.data.connection.jdbc.advice.DelegatingDataSource;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import jakarta.inject.Singleton;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.Collection;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import javax.sql.DataSource;
+
+@Singleton
+@Requires(property="kestra.rbac.application-groups.enabled",value="true")
+public final class OidcTrustedIdentity implements TrustedIdentityV1 {
+    public static final String CLAIM="kestra_application_group_v1";
+    private final BeanProvider<ApplicationGroupProtocolProjectionV1> projections;
+    private final OidcProtocolStateV1 protocol;
+    private final OidcConfiguration configuration;
+    private final DataSource source;
+
+    public OidcTrustedIdentity(BeanProvider<ApplicationGroupProtocolProjectionV1> projections,
+        OidcProtocolStateV1 protocol,OidcConfiguration configuration,DataSource source) {
+        this.projections=Objects.requireNonNull(projections);this.protocol=Objects.requireNonNull(protocol);
+        this.configuration=Objects.requireNonNull(configuration);this.source=DelegatingDataSource.unwrapDataSource(source);
+    }
+
+    @Override public Identity current() {
+        var request=AuthorizationInvocationContext.currentRequest().orElseThrow(OidcTrustedIdentity::denied);
+        var authentication=request.getAttribute("io.kestra.mcp.authentication",Authentication.class)
+            .or(()->request.getAttribute(SecurityFilter.AUTHENTICATION,Authentication.class)).orElseThrow(OidcTrustedIdentity::denied);
+        return validate(authentication);
+    }
+
+    public Identity validate(Authentication authentication) {
+        try{return validateCurrent(authentication);}
+        catch(RuntimeException failure){throw denied();}
+    }
+
+    public void validateSession(Authentication authentication) {
+        if(authentication!=null && authentication.getAttributes().containsKey(CLAIM)) {validate(authentication);return;}
+        if(authentication==null || !configuration.getIssuer().equals(authentication.getAttributes().get("iss")))throw denied();
+        var audiences=strings(authentication.getAttributes().get("aud"),true);
+        if(audiences.size()!=1)throw denied();
+        String clientId=audiences.iterator().next();
+        try(var connection=source.getConnection()) {
+            connection.setTransactionIsolation(Connection.TRANSACTION_READ_COMMITTED);connection.setAutoCommit(false);
+            try {
+                protocol.lockSecurityState(connection);
+                var client=protocol.client(connection,configuration.getIssuer(),clientId).orElseThrow(OidcTrustedIdentity::denied);
+                var account=protocol.account(connection,configuration.getIssuer(),authentication.getName()).orElseThrow(OidcTrustedIdentity::denied);
+                if(!client.active() || !client.configuredLoginClient() || !clientId.equals(client.clientId())
+                    || !configuration.getIssuer().equals(client.issuer()) || !account.active()
+                    || !authentication.getName().equals(account.subject()) || !configuration.getIssuer().equals(account.issuer())
+                    || account.authenticationVersion()!=number(authentication.getAttributes().get(OidcIdentityLifecycle.CLAIM)))throw denied();
+                if(projections.isPresent()) {
+                    if(!projections.isUnique())throw denied();
+                    var target=new ApplicationGroupProtocolProjectionV1.Request(configuration.getIssuer(),"main",clientId,authentication.getName(),null);
+                    var result=projections.get().current(connection,target);
+                    if(result==null || result.contractVersion()!=1 || result.activated() || result.projection().isPresent())throw denied();
+                }
+                connection.commit();
+            }catch(SQLException|RuntimeException failure) {
+                try{connection.rollback();}catch(SQLException rollback){failure.addSuppressed(rollback);}throw failure;
+            }
+        }catch(SQLException|RuntimeException failure){throw denied();}
+    }
+
+    private Identity validateCurrent(Authentication authentication) {
+        if(authentication==null || !configuration.getIssuer().equals(authentication.getAttributes().get("iss")) || !projections.isUnique())throw denied();
+        Object raw=authentication.getAttributes().get(CLAIM);
+        if(!(raw instanceof Map<?,?> claim))throw denied();
+        var target=new ApplicationGroupProtocolProjectionV1.Request(configuration.getIssuer(),"main",text(claim.get("client_id")),
+            authentication.getName(),text(claim.get("application_group_id")));
+        long epoch=number(claim.get("authorization_version"));
+        long authenticationVersion=number(authentication.getAttributes().get(OidcIdentityLifecycle.CLAIM));
+        if(epoch<=0 || authenticationVersion<0)throw denied();
+        var audiences=strings(authentication.getAttributes().get("aud"),true);
+        var scopes=strings(claim.get("application_group_scopes"),false);
+        var protocols=strings(claim.get("protocol_scopes"),false);
+        try(var connection=source.getConnection()) {
+            connection.setTransactionIsolation(Connection.TRANSACTION_READ_COMMITTED);connection.setAutoCommit(false);
+            try {
+                protocol.lockSecurityState(connection);
+                var account=protocol.account(connection,target.issuer(),target.subject()).orElseThrow(OidcTrustedIdentity::denied);
+                if(!account.issuer().equals(target.issuer()) || !account.subject().equals(target.subject()) || !account.active()
+                    || account.authenticationVersion()!=authenticationVersion)throw denied();
+                var client=protocol.client(connection,target.issuer(),target.clientId()).orElseThrow(OidcTrustedIdentity::denied);
+                if(!client.issuer().equals(target.issuer()) || !client.clientId().equals(target.clientId()) || !client.active())throw denied();
+                var result=projections.get().current(connection,target);
+                if(result==null || result.contractVersion()!=ApplicationGroupProtocolProjectionV1.CONTRACT_VERSION || !result.activated())throw denied();
+                var projection=result.projection().orElseThrow(OidcTrustedIdentity::denied);
+                var allowed=projection.eligibleScopeKeys(target);
+                if(!projection.active() || !projection.approved() || projection.authorizationVersion()!=epoch
+                    || audiences.isEmpty() || !projection.audiences().containsAll(audiences) || !allowed.containsAll(scopes))throw denied();
+                var request=AuthorizationInvocationContext.currentRequest().orElse(null);
+                var bearer=request==null?null:request.getAttribute("io.kestra.mcp.authentication",Authentication.class).orElse(null);
+                if(bearer!=null) {
+                    if(bearer!=authentication || !audiences.equals(Set.of(text(authentication.getAttributes().get("resource")))))throw denied();
+                }else if(!client.configuredLoginClient() || !audiences.equals(Set.of(target.clientId())))throw denied();
+                var vocabulary=new HashSet<>(Set.of("openid","profile","email","offline_access"));
+                vocabulary.addAll(configuration.getMcpScopes());
+                if(!vocabulary.containsAll(protocols) || !client.registeredScopes().containsAll(protocols)
+                    || protocols.contains(ApplicationGroupScopeIssuance.UI_SELECTOR)
+                    || projection.scopes().stream().anyMatch(scope->vocabulary.contains(scope.key())))throw denied();
+                var identity=new Identity(1,target.issuer(),target.subject(),target.clientId(),audiences,target.tenant(),
+                    projection.applicationGroupId(),protocols,scopes,authenticationVersion,epoch,projection.revision());
+                connection.commit();return identity;
+            }catch(SQLException|RuntimeException failure) {
+                try{connection.rollback();}catch(SQLException rollback){failure.addSuppressed(rollback);}
+                throw failure;
+            }
+        }catch(SQLException|RuntimeException failure){throw denied();}
+    }
+
+    private static String text(Object value) {
+        if(!(value instanceof String text) || text.isBlank() || !text.equals(text.trim()) || text.codePoints().anyMatch(Character::isISOControl))throw denied();
+        return text;
+    }
+
+    private static long number(Object value) {
+        if(!(value instanceof Number))throw denied();
+        try{return new java.math.BigDecimal(value.toString()).longValueExact();}
+        catch(ArithmeticException|NumberFormatException failure){throw denied();}
+    }
+
+    private static Set<String> strings(Object value,boolean scalar) {
+        if(scalar && value instanceof String)return Set.of(text(value));
+        if(!(value instanceof Collection<?> collection))throw denied();
+        var result=new HashSet<String>();
+        for(var item:collection)if(!result.add(text(item)))throw denied();
+        return Set.copyOf(result);
+    }
+
+    private static IllegalStateException denied() {return new IllegalStateException("Trusted application group identity is unavailable");}
+}
