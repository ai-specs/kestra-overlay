+        assertThat((java.util.Collection<?>)claim.get("application_group_scopes")).extracting(Object::toString).containsExactly("read");
+        long before=tokenCount();
+        assertThatThrownBy(()->service.issueAuthorizationTokens("ui",user(),new Scope("openid","read","unknown"),null,null,"application-group-v1.applicationGroup.1.code"))
+            .isInstanceOf(OidcException.class);
+        assertThat(tokenCount()).isEqualTo(before);
+    }
