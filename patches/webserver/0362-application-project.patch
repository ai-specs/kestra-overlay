+package io.kestra.core.repositories;
+
+import java.util.List;
+
+/** Tenant resource list domain, enforced before pagination and total. */
+public interface TenantResourceAccessControl {
+    enum Kind { ALL_IDS, RESTRICTED_IDS }
+    record Domain(Kind kind, List<String> ids) {
+        public Domain {
+            java.util.Objects.requireNonNull(kind);
+            ids = List.copyOf(ids);
+            if (kind == Kind.ALL_IDS && !ids.isEmpty()) throw new IllegalArgumentException("ALL_IDS cannot contain selectors");
+        }
+    }
+    Domain domain(String resource, String tenant);
+}
