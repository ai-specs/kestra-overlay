+package io.kestra.webserver.rbac;
+
+import io.kestra.core.repositories.ExecutionRepositoryInterface;
+import io.kestra.webserver.ui.UiExtensionDescriptorV1;
+import io.kestra.webserver.ui.UiExtensionRegistry;
+import io.micronaut.context.BeanProvider;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+
+class ExtensionResourceAdapterTest {
+    private OssRestOperationAdapter adapter() throws Exception {
+        var registry = mock(UiExtensionRegistry.class);
+        when(registry.descriptors()).thenReturn(List.of(new UiExtensionDescriptorV1(1, "probe", "ui-extensions/probe", "page.js", List.of(), Map.of(), Map.of("en", "Probe"), null)));
+        var adapter = new OssRestOperationAdapter(mock(ExecutionRepositoryInterface.class));
+        var field = OssRestOperationAdapter.class.getDeclaredField("extensionRegistries"); field.setAccessible(true);
+        field.set(adapter, new BeanProvider<UiExtensionRegistry>() { public UiExtensionRegistry get() { return registry; } public boolean isUnique() { return true; } });
+        return adapter;
+    }
+    private OssRestOperationAdapter.Request request(String method, String path, String controller, String handler, Map<String,Object> variables) {
+        return new OssRestOperationAdapter.Request(new RestAuthorizationResolver.Request(method,path,Map.of(),null,new byte[0],controller,handler,List.of()),variables);
+    }
+    @Test void resolvesRegisteredAssetsAndApiByActualMethod() throws Exception {
+        var adapter = adapter();
+        var asset = adapter.resolve(request("GET", "/ui-extensions/main/probe/page.js", "io.kestra.webserver.controllers.api.UiExtensionController", "asset", Map.of("tenant", "main", "id", "probe"))).getFirst();
+        assertThat(asset.resource()).isEqualTo(Resource.EXTENSION); assertThat(asset.action()).isEqualTo(Action.READ); assertThat(asset.resourceId()).isEqualTo("probe");
+        var write = adapter.resolve(request("PUT", "/api/v1/main/extensions/probe/projects/p", "external.ExampleController", "save", Map.of("tenant", "main", "id", "p"))).getFirst();
+        assertThat(write.resource()).isEqualTo(Resource.EXTENSION); assertThat(write.resourceId()).isEqualTo("probe"); assertThat(write.action()).isEqualTo(Action.UPDATE); assertThat(write.sideEffect()).isEqualTo(SideEffect.STORAGE_WRITE);
+    }
+    @Test void rejectsUnknownAndPrefixCollisionWithoutUsingChildObjectId() throws Exception {
+        var adapter = adapter();
+        assertThat(adapter.resolve(request("GET", "/api/v1/main/extensions/unknown/projects/p", "external.ExampleController", "read", Map.of("tenant", "main", "id", "probe")))).isEmpty();
+        assertThat(adapter.resolve(request("GET", "/ui-extensions/main/unknown/page.js", "io.kestra.webserver.controllers.api.UiExtensionController", "asset", Map.of("tenant", "main", "id", "unknown")))).isEmpty();
+    }
+}
diff --git a/webserver/src/test/java/io/kestra/webserver/rbac/QueryDomainFailClosedTest.java b/webserver/src/test/java/io/kestra/webserver/rbac/QueryDomainFailClosedTest.java
new file mode 100644
index 0000000..46d8177
--- /dev/null
+++ b/webserver/src/test/java/io/kestra/webserver/rbac/QueryDomainFailClosedTest.java
@@ -0,0 +1,47 @@
+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import static org.assertj.core.api.Assertions.*;
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+
+class QueryDomainFailClosedTest {
+    private QueryDomain scoped(String namespace, String id) {
+        return new QueryDomain(List.of(namespace),List.of(),List.of(),true,true,DomainKind.RESTRICTED,
+            List.of(new QueryDomain.ResourceDomain(List.of(namespace),List.of(),List.of(),List.of(id))));
+    }
+    @Test void incompatibleResourceScopesIntersectToExplicitDeny() {
+        var left = scoped("a","one");
+        var right = new QueryDomain(List.of(),List.of(),List.of(),true,true,DomainKind.GLOBAL,
+            List.of(new QueryDomain.ResourceDomain(List.of(),List.of(),List.of(),List.of("two"),QueryDomain.ResourceScope.TENANT,QueryDomain.IdScope.RESTRICTED_IDS)));
+        assertThat(left.resourceAllowed("a","other")).isFalse();
+        assertThat(right.resourceAllowed("a","other")).isFalse();
+        var intersection = left.intersect(right);
+        assertThat(intersection.resourceAllowed("a","other")).isFalse();
+        assertThat(intersection.resourceAllowed("a","one")).isFalse();
+        assertThat(intersection.kind()).isEqualTo(DomainKind.RESTRICTED);
+        assertThat(intersection.exactNamespaces()).isEmpty();
+    }
+    @Test void disjointIdsAndNamespacesNeverBecomeLegacyNamespaceGrants() {
+        for (var other : List.of(scoped("a","two"),scoped("b","one"))) {
+            var empty = scoped("a","one").intersect(other);
+            assertThat(empty.resourceAllowed("a","one")).isFalse();
+            assertThat(empty.contains("a")).isFalse();
+            assertThat(empty.resourceDomains()).isEmpty();
+        }
+    }
+    @Test void rejectsContradictoryTenantOuterDomainAndAllIdsSelectors() {
+        var tenant = new QueryDomain.ResourceDomain(List.of(),List.of(),List.of(),List.of("one"),QueryDomain.ResourceScope.TENANT,QueryDomain.IdScope.RESTRICTED_IDS);
+        assertThatThrownBy(() -> new QueryDomain(List.of("a"),List.of(),List.of(),true,true,DomainKind.RESTRICTED,List.of(tenant))).isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> new QueryDomain.ResourceDomain(List.of("a"),List.of(),List.of(),List.of("one"),QueryDomain.ResourceScope.NAMESPACE,QueryDomain.IdScope.ALL_IDS)).isInstanceOf(IllegalArgumentException.class);
+    }
+    @Test void emptyRestrictedTermDeniesAndValidIntersectionKeepsAssociation() {
+        var empty = new QueryDomain(List.of("a"),List.of(),List.of(),true,true,DomainKind.RESTRICTED,
+            List.of(new QueryDomain.ResourceDomain(List.of("a"),List.of(),List.of(),List.of())));
+        assertThat(empty.resourceAllowed("a","one")).isFalse();
+        assertThat(empty.contains("a")).isFalse();
+        var both = scoped("a","one").intersect(scoped("a","one"));
+        assertThat(both.resourceAllowed("a","one")).isTrue();
+        assertThat(both.resourceAllowed("a","two")).isFalse();
+    }
+}
diff --git a/webserver/src/test/java/io/kestra/webserver/rbac/TypedResourceDomainBoundaryTest.java b/webserver/src/test/java/io/kestra/webserver/rbac/TypedResourceDomainBoundaryTest.java
new file mode 100644
index 0000000..7c3a436
--- /dev/null
+++ b/webserver/src/test/java/io/kestra/webserver/rbac/TypedResourceDomainBoundaryTest.java
@@ -0,0 +1,73 @@
+package io.kestra.webserver.rbac;
+
+import io.kestra.core.models.AccessScope;
+import io.kestra.core.models.QueryFilter;
+import io.kestra.core.repositories.NamespaceAccessControl;
+import io.kestra.jdbc.repository.AbstractJdbcRepository;
+import java.sql.DriverManager;
+import java.util.List;
+import org.jooq.Condition;
+import org.jooq.SQLDialect;
+import org.jooq.impl.DSL;
+import org.junit.jupiter.api.Test;
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+
+class TypedResourceDomainBoundaryTest {
+    private QueryDomain domain(boolean restricted) {
+        return new QueryDomain(List.of("a"), List.of(), List.of(), true, true, DomainKind.RESTRICTED,
+            List.of(new QueryDomain.ResourceDomain(List.of("a"), List.of(), List.of(), restricted ? List.of("one") : List.of(),
+                QueryDomain.ResourceScope.NAMESPACE, restricted ? QueryDomain.IdScope.RESTRICTED_IDS : QueryDomain.IdScope.ALL_IDS)));
+    }
+    private TypedNamespaceAccessControl control(QueryDomain domain) throws Exception {
+        var result = mock(TypedNamespaceAccessControl.class, CALLS_REAL_METHODS);
+        doReturn(domain).when(result).domain(any());
+        var field = TypedNamespaceAccessControl.class.getDeclaredField("gate"); field.setAccessible(true); field.set(result, mock(TypedAuthorizationGate.class));
+        return result;
+    }
+    private Condition jdbc(TypedNamespaceAccessControl control, QueryFilter.Resource resource) throws Exception {
+        AbstractJdbcRepository repository = new AbstractJdbcRepository() {
+            protected NamespaceAccessControl namespaceAccessControl() { return control; }
+        };
+        var method = AbstractJdbcRepository.class.getDeclaredMethod("aclCondition", QueryFilter.Resource.class); method.setAccessible(true);
+        return (Condition) method.invoke(repository, resource);
+    }
+    @Test void nonFlowAllIdsQueriesRemainUsableAndNamespaceFiltered() throws Exception {
+        try (var connection = DriverManager.getConnection("jdbc:h2:mem:;DATABASE_TO_LOWER=TRUE")) {
+            var db = DSL.using(connection, SQLDialect.H2);
+            db.execute("create table candidates(namespace varchar(255), id varchar(255))");
+            db.execute("insert into candidates values ('a','one'),('a','two'),('b','one')");
+            for (var resource : List.of(QueryFilter.Resource.NAMESPACE, QueryFilter.Resource.LOG, QueryFilter.Resource.TRIGGER,
+                QueryFilter.Resource.KV_METADATA, QueryFilter.Resource.NAMESPACE_FILE_METADATA)) {
+                var condition = jdbc(control(domain(false)), resource);
+                assertThat(db.fetchCount(db.selectFrom(DSL.table("candidates")).where(condition))).as(resource.name()).isEqualTo(2);
+                assertThat(db.select(DSL.field("namespace", String.class)).from("candidates").where(condition).limit(1).fetch(0, String.class)).containsExactly("a");
+                assertThat(db.fetchCount(db.selectFrom(DSL.table("candidates")).where(jdbc(control(domain(true)), resource)))).as(resource.name()+" restricted").isZero();
+            }
+        }
+    }
+    @Test void namespaceOnlyAndLogConsumersNeverDropRestrictedIds() throws Exception {
+        var restricted = control(domain(true));
+        assertThat(restricted.namespaceAllowed(QueryFilter.Resource.FLOW, "a")).isFalse();
+        assertThat(restricted.namespaceScope(QueryFilter.Resource.FLOW).kind()).isEqualTo(AccessScope.Kind.DENY_ALL);
+        assertThat(new TypedLogAccessControl(restricted).namespaceScope().kind()).isEqualTo(AccessScope.Kind.DENY_ALL);
+        assertThat(restricted.resourceReadAllowed(QueryFilter.Resource.LOG, "main", "a", "one")).isFalse();
+        assertThat(restricted.resourceReadAllowed(QueryFilter.Resource.FLOW, "main", "a", "one")).isTrue();
+        assertThat(restricted.resourceReadAllowed(QueryFilter.Resource.FLOW, "main", "a", "two")).isFalse();
+        var all = control(domain(false));
+        assertThat(all.namespaceAllowed(QueryFilter.Resource.FLOW, "a")).isTrue();
+        assertThat(all.namespaceAllowed(QueryFilter.Resource.FLOW, "b")).isFalse();
+        assertThat(new TypedLogAccessControl(all).namespaceScope().namespaceAllowed("a")).isTrue();
+        assertThat(new TypedLogAccessControl(all).namespaceScope().namespaceAllowed("b")).isFalse();
+    }
+    @Test void exactResourcePredicatesPreserveNamespaceIdAssociation() throws Exception {
+        var terms = List.of(new QueryDomain.ResourceDomain(List.of("a"), List.of(), List.of(), List.of("one")),
+            new QueryDomain.ResourceDomain(List.of("b"), List.of(), List.of(), List.of("two")));
+        var control = control(new QueryDomain(List.of("a","b"),List.of(),List.of(),true,true,DomainKind.RESTRICTED,terms));
+        assertThat(control.resourceReadAllowed(QueryFilter.Resource.FLOW,"main","a","one")).isTrue();
+        assertThat(control.resourceReadAllowed(QueryFilter.Resource.FLOW,"main","b","two")).isTrue();
+        assertThat(control.resourceReadAllowed(QueryFilter.Resource.FLOW,"main","a","two")).isFalse();
+        assertThat(control.resourceReadAllowed(QueryFilter.Resource.FLOW,"main","b","one")).isFalse();
+    }
+}
