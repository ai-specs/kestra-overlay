+import en from "./translations/en.json"
+import {loadLocaleMessages, setI18nLanguage, setupI18n} from "./translations/i18n"
+import {SUPPORT_LOCALES} from "./translations/languages"
+
+// The standalone OIDC form shares the host's catalogue and vue-i18n loader.
+// It does not boot the application, fetch business configuration, or alter form submission.
+const i18n = setupI18n({
+    locale: "en", messages: en, legacy: false, warnHtmlMessage: false,
+} as any)
+
+async function translate() {
+    let locale = "en"
+    try { locale = localStorage.getItem("lang") || "en" } catch (_) { /* Keep English without storage. */ }
+    if (!SUPPORT_LOCALES.includes(locale)) locale = "en"
+    if (locale !== "en") await loadLocaleMessages(i18n, locale, {})
+    setI18nLanguage(i18n, locale)
+    // i18n-keys: setup.login_title, setup.form.username, setup.form.password, setup.login, setup.validation.incorrect_creds
+    for (const element of document.querySelectorAll<HTMLElement>("[data-i18n]")) {
+        element.textContent = i18n.global.t(element.dataset.i18n!)
+    }
+    document.title = i18n.global.t("setup.login_title")
+    document.documentElement.dataset.i18nReady = locale
+}
+
+void translate().catch(error => console.error("OIDC translation loading failed", error))
+window.addEventListener("storage", event => {
+    if (event.key === "lang" || event.key === null) void translate()
+})
diff --git a/ui/vite.oidc.config.js b/ui/vite.oidc.config.js
new file mode 100644
index 0000000..f9cb24a
--- /dev/null
+++ b/ui/vite.oidc.config.js
@@ -0,0 +1,28 @@
+import {defineConfig} from "vite"
+import path from "node:path"
+
+// Keep the login graph independent of business UI and its chunk-merging plugins.
+export default defineConfig({
+    base: "./",
+    plugins: [{
+        name: "authentication-entry-boundary",
+        generateBundle() {
+            for (const id of this.getModuleIds()) {
+                if (/src\/(main\.ts|App\.vue|routes\/|stores\/|override\/)/.test(id)) {
+                    this.error(`Authentication translation entry imports business UI: ${id}`)
+                }
+            }
+        },
+    }],
+    build: {
+        outDir: "../webserver/src/main/resources/ui",
+        emptyOutDir: false,
+        rollupOptions: {
+            input: path.resolve(import.meta.dirname, "src/oidc-login-i18n.ts"),
+            output: {
+                entryFileNames: "assets/oidc-login-i18n.js",
+                chunkFileNames: "assets/oidc-[name]-[hash].js",
+            },
+        },
+    },
+})
