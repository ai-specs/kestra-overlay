+package io.kestra.webserver.oidc;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.List;
+import java.util.Map;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.kestra.webserver.oidc.controllers.OidcLoginController;
+import io.kestra.webserver.oidc.services.OidcSessionService;
+import io.kestra.webserver.oidc.services.OidcUserService;
+
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.HttpStatus;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * D2 (login/logout session lifecycle) + the open-redirect guard on {@code from} (E1)
+ * for the R-OIDC-SERVER security checklist.
+ */
+class OidcLoginControllerTest extends OidcPostgresTestBase {
+
+    private OidcLoginController controller;
+    private OidcSessionService sessions;
+
+    @BeforeEach
+    void setUp() {
+        final OidcUserService users = new OidcUserService(OidcPostgresTestBase.dataSource(), new ObjectMapper());
+        users.delete("alice");
+        users.create(new OidcUserService.CreateUserRequest("alice", "Alice", "alice@example.org", "correct-horse", List.of("user")));
+        final OidcConfiguration configuration = new OidcConfiguration();
+        sessions = new OidcSessionService(configuration);
+        controller = new OidcLoginController(users, sessions);
+    }
+
+    @Test
+    void loginPageRendersForm() {
+        final HttpResponse<String> response = controller.loginPage(java.util.Optional.of("/ui/flows"), java.util.Optional.empty());
+        assertEquals(HttpStatus.OK, response.getStatus());
+        final String html = response.body();
+        assertTrue(html.contains("form") && html.contains("name=\"username\""), "login page must render the form");
+        assertTrue(html.contains("value=\"/ui/flows\""), "the sanitized from must ride along as a hidden field");
+    }
+
+    @Test
+    void validCredentialsSetSessionAndRedirectBack() {
+        final HttpRequest<Map<String, String>> request = HttpRequest.POST("/oidc/login",
+            Map.of("username", "alice", "password", "correct-horse", "from", "/ui/flows"));
+        final HttpResponse<?> response = controller.loginSubmit(request, Map.of(
+            "username", "alice", "password", "correct-horse", "from", "/ui/flows"));
+
+        assertEquals(HttpStatus.TEMPORARY_REDIRECT, response.getStatus());
+        assertEquals("/ui/flows", response.getHeaders().get("Location"));
+        final var cookie = response.getCookie(OidcSessionService.SESSION_COOKIE_NAME).orElse(null);
+        assertNotNull(cookie, "a session cookie must be set on login");
+        assertTrue(cookie.isHttpOnly(), "session cookie must be HttpOnly");
+
+        // The session must resolve back to the subject (authorize relies on this).
+        assertTrue(sessions.subject(cookie.getValue()).isPresent());
+        assertEquals("alice", sessions.subject(cookie.getValue()).orElseThrow());
+    }
+
+    @Test
+    void invalidCredentialsRenderErrorWithUnauthorized() {
+        final var request = HttpRequest.POST("/oidc/login", Map.of("username", "alice", "password", "wrong"));
+        final HttpResponse<?> response = controller.loginSubmit(request, Map.of(
+            "username", "alice", "password", "wrong", "from", "/ui/flows"));
+        assertEquals(HttpStatus.UNAUTHORIZED, response.getStatus());
+        assertTrue(((String) response.body()).contains("Invalid username or password"));
+    }
+
+    @Test
+    void logoutRevokesSessionAndClearsCookie() {
+        final String sessionId = sessions.create("alice");
+        final var request = new io.micronaut.http.simple.SimpleHttpRequest<Void>(io.micronaut.http.HttpMethod.GET, "/oidc/logout", null)
+            .cookie(io.micronaut.http.cookie.Cookie.of(OidcSessionService.SESSION_COOKIE_NAME, sessionId));
+        final HttpResponse<?> response = controller.logout(request);
+
+        assertEquals(HttpStatus.TEMPORARY_REDIRECT, response.getStatus());
+        assertTrue(sessions.subject(sessionId).isEmpty(), "logout must revoke the session");
+        final var cleared = response.getCookie(OidcSessionService.SESSION_COOKIE_NAME).orElse(null);
+        assertNotNull(cleared);
+        assertEquals(0L, cleared.getMaxAge(), "logout must clear the cookie");
+    }
+
+    @Test
+    void fromIsSanitizedAgainstOpenRedirect() {
+        assertNull(OidcLoginController.sanitizeFrom("https://evil.example.org/"), "absolute URLs rejected");
+        assertNull(OidcLoginController.sanitizeFrom("//evil.example.org/"), "protocol-relative rejected");
+        assertNull(OidcLoginController.sanitizeFrom("/\\evil.example.org/"), "backslash trick rejected");
+        assertNull(OidcLoginController.sanitizeFrom(null));
+        assertNull(OidcLoginController.sanitizeFrom("  "));
+        assertEquals("/ui/flows", OidcLoginController.sanitizeFrom(" /ui/flows "));
+        assertEquals("/oidc/authorize?client_id=x", OidcLoginController.sanitizeFrom("/oidc/authorize?client_id=x"));
+    }
+
+    @Test
+    void maliciousFromFallsBackToDefaultLanding() {
+        final var request = HttpRequest.POST("/oidc/login", Map.of());
+        final HttpResponse<?> response = controller.loginSubmit(request, Map.of(
+            "username", "alice", "password", "correct-horse", "from", "https://evil.example.org/"));
+        assertEquals(HttpStatus.TEMPORARY_REDIRECT, response.getStatus());
+        assertEquals("/ui/", response.getHeaders().get("Location"), "open-redirect target must fall back to /ui/");
+    }
+}
