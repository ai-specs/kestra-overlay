@@ -0,0 +1,144 @@
+package io.kestra.webserver.oidc.controllers;
+
+import java.net.URI;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+
+import io.kestra.webserver.oidc.services.OidcSessionService;
+import io.kestra.webserver.oidc.services.OidcUserService;
+
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.MediaType;
+import io.micronaut.http.annotation.Body;
+import io.micronaut.http.annotation.Consumes;
+import io.micronaut.http.annotation.Controller;
+import io.micronaut.http.annotation.Get;
+import io.micronaut.http.annotation.Post;
+import io.micronaut.http.annotation.Produces;
+import io.micronaut.http.annotation.QueryValue;
+import io.micronaut.scheduling.TaskExecutors;
+import io.micronaut.scheduling.annotation.ExecuteOn;
+import jakarta.inject.Inject;
+
+/**
+ * The IdP login/logout pages of the built-in OIDC server.
+ *
+ * <p>Flow: an unauthenticated browser hitting a protected route is redirected here (either by
+ * {@link OidcAuthorizationExceptionHandler} or by {@code /oidc/authorize}); after a successful
+ * credential check the user gets an {@code oidc_session} cookie and is sent back to {@code from}
+ * (a sanitized same-origin relative path — open-redirect guard E1).
+ */
+@Controller("/oidc")
+@Requires(property = "kestra.oidc.enabled", value = "true", defaultValue = "false")
+@ExecuteOn(TaskExecutors.IO)
+public class OidcLoginController {
+
+    /** Fallback landing page when a login carries no usable {@code from}. */
+    static final String DEFAULT_LANDING = "/ui/";
+
+    private final OidcUserService userService;
+    private final OidcSessionService sessionService;
+
+    @Inject
+    public OidcLoginController(final OidcUserService userService, final OidcSessionService sessionService) {
+        this.userService = userService;
+        this.sessionService = sessionService;
+    }
+
+    @Get("/login")
+    @Produces(MediaType.TEXT_HTML)
+    public HttpResponse<String> loginPage(
+        @QueryValue final java.util.Optional<String> from,
+        @QueryValue final java.util.Optional<String> error
+    ) {
+        return HttpResponse.ok(loginPageHtml(sanitizeFrom(from.orElse(null)), error.isPresent()))
+            .contentType(MediaType.TEXT_HTML_TYPE)
+            .header(io.micronaut.http.HttpHeaders.CACHE_CONTROL, "no-store");
+    }
+
+    @Post("/login")
+    @Consumes(MediaType.APPLICATION_FORM_URLENCODED)
+    public HttpResponse<?> loginSubmit(final HttpRequest<?> request, @Body final java.util.Map<String, String> form) {
+        final String username = form.get("username") == null ? "" : form.get("username").trim();
+        final String password = form.get("password");
+        final String from = sanitizeFrom(form.get("from"));
+
+        if (!userService.validateCredentials(username, password)) {
+            return HttpResponse.ok(loginPageHtml(from, true))
+                .contentType(MediaType.TEXT_HTML_TYPE)
+                .status(io.micronaut.http.HttpStatus.UNAUTHORIZED)
+                .header(io.micronaut.http.HttpHeaders.CACHE_CONTROL, "no-store");
+        }
+
+        final String sessionId = sessionService.create(username);
+        return HttpResponse.temporaryRedirect(URI.create(from == null ? DEFAULT_LANDING : from))
+            .cookie(sessionService.sessionCookie(request, sessionId))
+            .header(io.micronaut.http.HttpHeaders.CACHE_CONTROL, "no-store");
+    }
+
+    /** OIDC end-session endpoint: revokes the session and clears the cookie. */
+    @Get("/logout")
+    public HttpResponse<?> logout(final HttpRequest<?> request) {
+        sessionService.sessionIdFrom(request).ifPresent(sessionService::revoke);
+        return HttpResponse.temporaryRedirect(URI.create(DEFAULT_LANDING))
+            .cookie(io.micronaut.http.cookie.Cookie.of(OidcSessionService.SESSION_COOKIE_NAME, "")
+                .path("/")
+                .maxAge(java.time.Duration.ZERO));
+    }
+
+    /**
+     * Only same-origin relative paths are accepted as post-login targets: must start with
+     * {@code /} but not {@code //} or {@code /\} (protocol-relative/open-redirect guard, E1).
+     */
+    public static String sanitizeFrom(final String from) {
+        if (from == null || from.isBlank()) {
+            return null;
+        }
+        final String trimmed = from.trim();
+        if (!trimmed.startsWith("/") || trimmed.startsWith("//") || trimmed.startsWith("/\\") || trimmed.length() > 2048) {
+            return null;
+        }
+        return trimmed;
+    }
+
+    /** The login form — self-contained HTML (no external assets), CSP-friendly. */
+    private String loginPageHtml(final String from, final boolean failed) {
+        final String safeFrom = from == null ? DEFAULT_LANDING : from;
+        return """
+            <!DOCTYPE html>
+            <html lang="en">
+            <head><meta charset="utf-8"><title>Sign in</title></head>
+            <body>
+            <main style="font-family:system-ui,sans-serif;max-width:22rem;margin:12vh auto;">
+            %s
+            <form method="post" action="/oidc/login">
+            <input type="hidden" name="from" value="%s">
+            <p><label>Username<br><input name="username" autocomplete="username" required></label></p>
+            <p><label>Password<br><input type="password" name="password" autocomplete="current-password" required></label></p>
+            <p><button type="submit">Sign in</button></p>
+            </form>
+            </main>
+            </body>
+            </html>
+            """.formatted(
+            failed ? "<p style=\"color:#b00;\">Invalid username or password.</p>" : "",
+            htmlEscape(safeFrom)
+        );
+    }
+
+    private static String htmlEscape(final String value) {
+        final StringBuilder sb = new StringBuilder(value.length());
+        for (final char c : value.toCharArray()) {
+            switch (c) {
+                case '<' -> sb.append("&lt;");
+                case '>' -> sb.append("&gt;");
+                case '"' -> sb.append("&quot;");
+                case '&' -> sb.append("&amp;");
+                default -> sb.append(c);
+            }
+        }
+        return sb.toString();
+    }
+}
