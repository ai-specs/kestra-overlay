+package io.kestra.webserver.oidc;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import io.kestra.webserver.oidc.controllers.OidcAuthorizationExceptionHandler;
+
+import io.micronaut.core.util.SupplierUtil;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.HttpStatus;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.authentication.AuthorizationException;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * The redirect-vs-401 split of the authorization exception handler (F1/anonymous-face
+ * behaviour): browsers go to the IdP login page, API clients get a bare 401.
+ */
+class OidcAuthorizationExceptionHandlerTest {
+
+    private final OidcAuthorizationExceptionHandler handler = new OidcAuthorizationExceptionHandler();
+
+    private AuthorizationException denied() {
+        return new AuthorizationException(SupplierUtil.memoized(() -> Authentication.build("anonymous")).get());
+    }
+
+    @Test
+    void browserGetsRedirectToLoginCarryingFrom() {
+        final HttpRequest<?> request = HttpRequest.GET("/api/v1/main/flows").header("Accept", "text/html");
+        final HttpResponse<?> response = handler.handle(request, denied());
+        assertEquals(HttpStatus.TEMPORARY_REDIRECT, response.getStatus());
+        assertEquals("/oidc/login?from=%2Fapi%2Fv1%2Fmain%2Fflows", response.getHeaders().get("Location"));
+    }
+
+    @Test
+    void apiClientGetsBareUnauthorized() {
+        final HttpRequest<?> request = HttpRequest.GET("/api/v1/main/flows").header("Accept", "application/json");
+        final HttpResponse<?> response = handler.handle(request, denied());
+        assertEquals(HttpStatus.UNAUTHORIZED, response.getStatus());
+    }
+
+    @Test
+    void noAcceptHeaderGetsUnauthorized() {
+        final HttpResponse<?> response = handler.handle(HttpRequest.GET("/api/v1/main/flows"), denied());
+        assertEquals(HttpStatus.UNAUTHORIZED, response.getStatus());
+    }
+}
diff --git a/webserver/src/test/java/io/kestra/webserver/oidc/OidcLoginControllerTest.java b/webserver/src/test/java/io/kestra/webserver/oidc/OidcLoginControllerTest.java
