@@ -0,0 +1,22 @@
+package io.kestra.webserver.oidc;
+
+import com.nimbusds.oauth2.sdk.ErrorObject;
+
+/**
+ * OAuth2/OIDC protocol error of the built-in server. Carries the RFC 6749 error object so the
+ * token endpoint renders the exact error response (e.g. {@code invalid_client} → 401 with no
+ * detail beyond the code — never leak whether the client or the secret was wrong).
+ */
+public class OidcException extends RuntimeException {
+
+    private final ErrorObject error;
+
+    public OidcException(final ErrorObject error) {
+        super(error.getCode() + (error.getDescription() != null ? ": " + error.getDescription() : ""));
+        this.error = error;
+    }
+
+    public ErrorObject error() {
+        return error;
+    }
+}
