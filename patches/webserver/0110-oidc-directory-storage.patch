+/**
+ * PostgreSQL migration for the OIDC server user directory and client registry:
+ * {@code oidc_user}, {@code oidc_user_auth_method}, {@code oidc_client}. No seed data —
+ * accounts and clients are created via the admin endpoints or config bootstrap.
+ *
+ * <p>Gated by the repository backend only (schema is provisioned even while the feature is off).
+ */
+@Singleton
+@Requires(property = "kestra.repository.type", value = "postgres")
