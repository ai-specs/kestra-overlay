@@ -0,0 +1,80 @@
+package io.kestra.webserver.oidc;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.List;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.kestra.webserver.oidc.services.OidcClientService;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * C1 (secret authentication) + E1 (redirect_uri exact match) for the R-OIDC-SERVER
+ * security checklist.
+ */
+class OidcClientServiceTest extends OidcPostgresTestBase {
+
+    private OidcClientService service;
+
+    @BeforeEach
+    void setUp() {
+        service = new OidcClientService(OidcPostgresTestBase.dataSource(), new ObjectMapper());
+        service.delete("confidential-app");
+        service.delete("public-app");
+    }
+
+    private OidcClientService.OidcClient confidential() {
+        service.create("confidential-app", "s3cret",
+            List.of("https://app.example.org/callback"),
+            List.of("authorization_code", "client_credentials", "refresh_token"),
+            List.of("openid", "profile", "email"));
+        return service.require("confidential-app");
+    }
+
+    @Test
+    void authenticatesCorrectSecretAndRejectsWrongOne() {
+        confidential();
+
+        assertTrue(service.authenticate("confidential-app", "s3cret"));
+        assertFalse(service.authenticate("confidential-app", "s3cret-typo"), "wrong secret must fail");
+        assertFalse(service.authenticate("confidential-app", null), "missing secret must fail");
+        assertFalse(service.authenticate("unknown-app", "s3cret"), "unknown client must fail");
+    }
+
+    @Test
+    void inactiveClientCannotAuthenticate() {
+        final var client = confidential();
+        assertTrue(client.active());
+        service.updateActive("confidential-app", false);
+        assertFalse(service.authenticate("confidential-app", "s3cret"), "inactive client must fail");
+    }
+
+    @Test
+    void redirectUriMustMatchExactly() {
+        final var client = confidential();
+
+        assertTrue(service.isRedirectUriRegistered(client, "https://app.example.org/callback"));
+        assertFalse(service.isRedirectUriRegistered(client, "https://app.example.org/callback/"), "trailing slash is a different URI");
+        assertFalse(service.isRedirectUriRegistered(client, "https://app.example.org/callback?x=1"), "query string is a different URI");
+        assertFalse(service.isRedirectUriRegistered(client, "https://evil.example.org/callback?return=https://app.example.org/callback"), "prefix/embedding tricks must fail");
+        assertFalse(service.isRedirectUriRegistered(client, "https://app.example.org"), "shorter prefix must fail");
+        assertFalse(service.isRedirectUriRegistered(client, null));
+    }
+
+    @Test
+    void publicClientHasEmptySecretAndIsRecognised() {
+        service.create("public-app", null,
+            List.of("http://localhost:5173/callback"),
+            List.of("authorization_code", "refresh_token"),
+            List.of("openid", "profile"));
+
+        final var client = service.require("public-app");
+        assertTrue(service.isPublic(client), "empty secret = public client (must use PKCE)");
+        assertFalse(service.authenticate("public-app", ""), "public client cannot authenticate with a secret");
+        assertTrue(service.isGrantTypeAllowed(client, "authorization_code"));
+        assertFalse(service.isGrantTypeAllowed(client, "client_credentials"), "grant not registered for this client");
+    }
+}
