index 0000000..db18e59
--- /dev/null
+++ b/webserver/src/main/resources/migrations/2.0.91-oidc-server-directory-postgres.sql
@@ -0,0 +1,48 @@
+-- ============================================================================
+-- R-OIDC-SERVER user directory + client registry (id 2.0.91-oidc-server-directory).
+-- Backend: PostgreSQL. ZITADEL-aligned core, trimmed for the hardened persona:
+--   * oidc_user             — the human user record; username is the OIDC sub.
+--   * oidc_user_auth_method — auth methods per user; PASSWORD rows carry the bcrypt hash
+--                             (never plaintext — security checklist C2).
+--   * oidc_client           — OAuth2/OIDC clients. Public clients (PKCE) are stored with an
+--                             EMPTY secret; confidential clients keep a real secret
+--                             (constant-time comparison at the token endpoint).
+-- No seed data: accounts/clients are created via the admin endpoints or config bootstrap.
+-- ============================================================================
+CREATE TABLE IF NOT EXISTS oidc_user
+(
+    username                 TEXT        PRIMARY KEY,             -- = OIDC sub / login name
+    name                     TEXT        NOT NULL,                -- display name
+    email                    TEXT        NOT NULL,
+    email_verified           BOOLEAN     NOT NULL DEFAULT FALSE,
+    user_state               TEXT        NOT NULL DEFAULT 'ACTIVE', -- ACTIVE / INACTIVE
+    password_change_required BOOLEAN     NOT NULL DEFAULT FALSE,
+    last_login_at            TIMESTAMPTZ,
+    roles                    JSONB       NOT NULL DEFAULT '["user"]'::jsonb,
+    created_at               TIMESTAMPTZ NOT NULL DEFAULT now(),
+    updated_at               TIMESTAMPTZ NOT NULL DEFAULT now()
+);
+
+CREATE TABLE IF NOT EXISTS oidc_user_auth_method
+(
+    id          BIGSERIAL   PRIMARY KEY,
+    user_id     TEXT        NOT NULL REFERENCES oidc_user (username) ON DELETE CASCADE,
+    type        TEXT        NOT NULL,                  -- PASSWORD / TOTP / PASSKEY (future)
+    state       TEXT        NOT NULL DEFAULT 'ACTIVE',
+    credential  TEXT,                                  -- PASSWORD rows: bcrypt hash
+    name        TEXT,
+    created_at  TIMESTAMPTZ NOT NULL DEFAULT now(),
+    updated_at  TIMESTAMPTZ NOT NULL DEFAULT now(),
+    UNIQUE (user_id, type)
+);
+
+CREATE TABLE IF NOT EXISTS oidc_client
+(
+    client_id     TEXT        NOT NULL PRIMARY KEY,
+    client_secret TEXT        NOT NULL DEFAULT '',     -- EMPTY for public (PKCE) clients
+    redirect_uris JSONB       NOT NULL DEFAULT '[]'::jsonb,
+    grant_types   JSONB       NOT NULL DEFAULT '["authorization_code","client_credentials","refresh_token"]'::jsonb,
+    scopes        JSONB       NOT NULL DEFAULT '["openid","profile","email"]'::jsonb,
+    active        BOOLEAN     NOT NULL DEFAULT TRUE,
+    created_at    TIMESTAMPTZ NOT NULL DEFAULT now()
+);
diff --git a/webserver/src/test/java/io/kestra/webserver/oidc/OidcClientServiceTest.java b/webserver/src/test/java/io/kestra/webserver/oidc/OidcClientServiceTest.java
