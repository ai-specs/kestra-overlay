+package io.kestra.webserver.oidc;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.List;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.kestra.webserver.oidc.services.OidcUserService;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * C2 (bcrypt-only password storage) + validateCredentials behaviour for the R-OIDC-SERVER
+ * security checklist.
+ */
+class OidcUserServiceTest extends OidcPostgresTestBase {
+
+    private OidcUserService service;
+
+    @BeforeEach
+    void setUp() {
+        service = new OidcUserService(OidcPostgresTestBase.dataSource(), new ObjectMapper());
+        service.delete("alice");
+    }
+
+    @Test
+    void validatesCorrectPasswordAndRejectsWrongOne() {
+        service.create(new OidcUserService.CreateUserRequest("alice", "Alice", "alice@example.org", "correct-horse", List.of("user")));
+
+        assertTrue(service.validateCredentials("alice", "correct-horse"));
+        assertFalse(service.validateCredentials("alice", "wrong-horse"));
+        assertFalse(service.validateCredentials("unknown-user", "correct-horse"));
+        assertFalse(service.validateCredentials("alice", null));
+    }
+
+    @Test
+    void storesOnlyBcryptHashesNeverPlaintext() {
+        service.create(new OidcUserService.CreateUserRequest("alice", "Alice", "alice@example.org", "correct-horse", List.of("user")));
+
+        final String hash = service.storedPasswordHash("alice").orElseThrow();
+        assertNotEquals("correct-horse", hash, "plaintext password must never be stored");
+        assertTrue(hash.startsWith("$2"), "stored credential must be a bcrypt hash");
+    }
+
+    @Test
+    void rejectsInactiveUserEvenWithCorrectPassword() {
+        service.create(new OidcUserService.CreateUserRequest("alice", "Alice", "alice@example.org", "correct-horse", List.of("user")));
+        service.updateUserState("alice", "INACTIVE");
+
+        assertFalse(service.validateCredentials("alice", "correct-horse"));
+    }
+
+    @Test
+    void passwordRotationInvalidatesOldPassword() {
+        service.create(new OidcUserService.CreateUserRequest("alice", "Alice", "alice@example.org", "old-password", List.of("user")));
+        service.setPassword("alice", "new-password");
+
+        assertFalse(service.validateCredentials("alice", "old-password"));
+        assertTrue(service.validateCredentials("alice", "new-password"));
+    }
+}
