+package io.kestra.webserver.oidc;
+
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.Optional;
+import java.util.Set;
+
+public interface OidcProtocolStateV1 {
+    int CONTRACT_VERSION=1;
+
+    void lockSecurityState(Connection connection)throws SQLException;
+
+    Optional<Account> account(Connection connection,String issuer,String subject)throws SQLException;
+
+    Optional<Client> client(Connection connection,String issuer,String clientId)throws SQLException;
+
+    Optional<PendingClient> pendingClient(Connection connection,String issuer,String clientId)throws SQLException;
+
+    Installation verifyInstallation(Connection connection,String issuer,String suppliedInstallationId)throws SQLException;
+
+    record Account(String issuer,String subject,boolean active,boolean canLogin,long authenticationVersion) {
+        public Account {
+            OidcProtocolValues.issuer(issuer);OidcProtocolValues.opaque(subject);
+            if(authenticationVersion<0 || canLogin && !active)throw new IllegalArgumentException("Invalid account state");
+        }
+    }
+
+    record Client(String issuer,String clientId,boolean active,Set<String> registeredScopes,boolean configuredLoginClient) {
+        public Client {
+            OidcProtocolValues.issuer(issuer);OidcProtocolValues.opaque(clientId);
+            registeredScopes=OidcProtocolValues.scopes(registeredScopes);
+        }
+    }
+
+    record PendingClient(String issuer,String clientId,Set<String> registeredScopes) {
+        public PendingClient {
+            OidcProtocolValues.issuer(issuer);OidcProtocolValues.opaque(clientId);
+            registeredScopes=OidcProtocolValues.scopes(registeredScopes);
+        }
+    }
+
+    record Installation(String issuer,String installationId,String configuredLoginClientId) {
+        public Installation {
+            OidcProtocolValues.issuer(issuer);OidcProtocolValues.opaque(configuredLoginClientId);OidcProtocolValues.opaque(installationId);
+        }
+    }
+}
