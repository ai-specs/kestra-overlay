+package io.kestra.webserver.oidc;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Optional;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+import static io.kestra.webserver.oidc.ApplicationGroupProtocolProjectionV1.*;
+import static org.junit.jupiter.api.Assertions.*;
+
+class ApplicationGroupProtocolProjectionV1Test {
+    private static final String ISSUER="https://issuer.example";
+    private static List<Scope> scopes() { return List.of(new Scope("read","Reader","Read access"),new Scope("write","Writer","Write access")); }
+    private static Projection projection(boolean active,boolean approved,Set<String> supported,Set<String> granted) {
+        return new Projection("group","main",ISSUER,"client","subject",active,approved,1,1,Set.of("resource"),scopes(),supported,granted);
+    }
+    private static Request request() { return new Request(ISSUER,"main","client","subject","group"); }
+
+    @Test void scopeEligibilityUsesExactSupportAndUserGrantIntersection() {
+        var projection=projection(true,true,Set.of("read"),Set.of("read","write"));
+        assertEquals(Set.of("read"),projection.eligibleScopeKeys(request()));
+        assertEquals(Set.of(),projection(false,true,Set.of("read"),Set.of("read")).eligibleScopeKeys(request()));
+        assertEquals(Set.of(),projection(true,false,Set.of("read"),Set.of("read")).eligibleScopeKeys(request()));
+        assertEquals(Set.of(),projection(true,true,Set.of("read"),Set.of()).eligibleScopeKeys(request()));
+        assertThrows(IllegalArgumentException.class,()->projection(true,true,Set.of("Reader"),Set.of("read")));
+    }
+
+    @Test void everyProtocolTargetMustMatchBeforeScopesCanBeUsed() {
+        var projection=projection(true,true,Set.of("read"),Set.of("read"));
+        for(var wrong:List.of(new Request(ISSUER+"/","main","client","subject","group"),
+            new Request(ISSUER,"other-tenant","client","subject","group"),
+            new Request(ISSUER,"main","other","subject","group"),new Request(ISSUER,"main","client","other","group"),
+            new Request(ISSUER,"main","client","subject","other")))
+            assertThrows(IllegalArgumentException.class,()->projection.eligibleScopeKeys(wrong));
+        assertEquals(Set.of("read"),projection.eligibleScopeKeys(new Request(ISSUER,"main","client","subject",null)));
+    }
+
+    @Test void duplicateScopeMetadataUndefinedReferencesAndInvalidAudienceFailClosed() {
+        assertThrows(IllegalArgumentException.class,()->new Projection("group","main",ISSUER,"client","subject",true,true,1,1,Set.of("resource"),
+            List.of(new Scope("read","Reader",""),new Scope("read","Other","")),Set.of("read"),Set.of()));
+        assertThrows(IllegalArgumentException.class,()->new Projection("group","main",ISSUER,"client","subject",true,true,1,1,Set.of("resource"),
+            List.of(new Scope("read","Reader",""),new Scope("other","Reader","")),Set.of("read"),Set.of()));
+        assertThrows(IllegalArgumentException.class,()->projection(true,true,Set.of("undefined"),Set.of()));
+        assertThrows(IllegalArgumentException.class,()->projection(true,true,Set.of(),Set.of("undefined")));
+        assertThrows(IllegalArgumentException.class,()->new Projection("group","main",ISSUER,"client","subject",true,true,1,1,Set.of("*"),scopes(),Set.of(),Set.of()));
+        assertThrows(IllegalArgumentException.class,()->new Projection("group","main",ISSUER,"client","subject",true,true,1,0,Set.of("resource"),scopes(),Set.of(),Set.of()));
+    }
+
+    @Test void projectionOwnsCollectionsAndUninitializedResultCannotContainGroupIdentity() {
+        var metadata=new ArrayList<>(scopes());var supported=new HashSet<>(Set.of("read"));
+        var projection=new Projection("group","main",ISSUER,"client","subject",true,true,1,1,Set.of("resource"),metadata,supported,Set.of("read"));
+        metadata.clear();supported.clear();assertEquals(2,projection.scopes().size());
+        assertEquals(Set.of("read"),projection.eligibleScopeKeys(request()));
+        assertThrows(UnsupportedOperationException.class,()->projection.scopes().clear());
+        assertThrows(IllegalArgumentException.class,()->new Result(1,false,Optional.of(projection)));
+        assertThrows(IllegalArgumentException.class,()->new Result(2,true,Optional.of(projection)));
+        assertEquals(Optional.empty(),new Result(1,false,Optional.empty()).projection());
+        assertEquals(Optional.empty(),new Result(1,true,Optional.empty()).projection());
+    }
+
+    @Test void protocolInspectionAndLifecycleContractsHaveNoCredentialsOrGroupMutations() {
+        assertEquals(List.of("current"),java.util.Arrays.stream(ApplicationGroupProtocolProjectionV1.class.getDeclaredMethods())
+            .filter(method->java.lang.reflect.Modifier.isPublic(method.getModifiers())).map(java.lang.reflect.Method::getName).toList());
+        var account=new OidcProtocolStateV1.Account(ISSUER,"subject",true,true,0);
+        assertTrue(account.canLogin());
+        assertThrows(IllegalArgumentException.class,()->new OidcProtocolStateV1.Account(ISSUER,"subject",false,true,0));
+        assertThrows(IllegalArgumentException.class,()->new OidcProtocolStateV1.Client(ISSUER,"client",true,Set.of("two scopes"),false));
+        assertThrows(IllegalArgumentException.class,()->new IdentityLifecycleGuardV1.Change(IdentityLifecycleGuardV1.Kind.CLIENT_DELETE,ISSUER,"subject","client"));
+        assertThrows(IllegalArgumentException.class,()->new IdentityLifecycleGuardV1.Change(IdentityLifecycleGuardV1.Kind.ACCOUNT_DEACTIVATE,ISSUER,null,"client"));
+        assertEquals("subject",new IdentityLifecycleGuardV1.Change(IdentityLifecycleGuardV1.Kind.PASSWORD_RESET,ISSUER,"subject",null).subject());
+        assertEquals("client",new IdentityLifecycleGuardV1.Change(IdentityLifecycleGuardV1.Kind.CLIENT_REVOKE,ISSUER,null,"client").clientId());
+        for(var type:List.of(Projection.class,OidcProtocolStateV1.Account.class,OidcProtocolStateV1.Client.class))
+            assertTrue(java.util.Arrays.stream(type.getRecordComponents()).noneMatch(component->
+                Set.of("password","credential","secret","firstPartyUi","permissions","runtimeGrants").contains(component.getName())));
+    }
+}
