+package io.kestra.webserver.oidc;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.kestra.webserver.oidc.services.OidcInstallationReceipt;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.context.env.Environment;
+import jakarta.inject.Singleton;
+import java.nio.file.Path;
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.SQLException;
+import java.util.HashSet;
+import java.util.Objects;
+import java.util.Optional;
+
+@Singleton
+@Requires(property="kestra.oidc.enabled",value="true")
+public final class OidcProtocolState implements OidcProtocolStateV1 {
+    private final String issuer;
+    private final String configuredLoginClientId;
+    private final OidcInstallationReceipt receipt;
+    private final ObjectMapper mapper;
+
+    @jakarta.inject.Inject
+    public OidcProtocolState(OidcConfiguration configuration,Environment environment,ObjectMapper mapper) {
+        this(configuration.getIssuer(),loginClient(environment),new OidcInstallationReceipt(receiptPath(environment)),mapper);
+    }
+
+    public OidcProtocolState(String issuer,String configuredLoginClientId,OidcInstallationReceipt receipt,ObjectMapper mapper) {
+        OidcProtocolValues.issuer(issuer);
+        if(configuredLoginClientId!=null)OidcProtocolValues.opaque(configuredLoginClientId);
+        this.issuer=issuer;this.configuredLoginClientId=configuredLoginClientId;
+        this.receipt=Objects.requireNonNull(receipt);this.mapper=Objects.requireNonNull(mapper);
+    }
+
+    private static String loginClient(Environment environment) {
+        var name=environment.getProperty("kestra.oidc.bootstrap.client-name",String.class).orElse("kestra");
+        return environment.getProperty("micronaut.security.oauth2.clients."+name+".client-id",String.class).orElse(null);
+    }
+
+    private static Path receiptPath(Environment environment) {
+        var storage=environment.getProperty("kestra.storage.local.base-path",String.class).orElse("/app/storage");
+        return Path.of(environment.getProperty("kestra.oidc.bootstrap.receipt-path",String.class).orElse(storage+"/.oidc-installation"));
+    }
+
+    @Override public void lockSecurityState(Connection connection)throws SQLException {
+        transaction(connection);
+        if(!"PostgreSQL".equals(connection.getMetaData().getDatabaseProductName()))
+            throw new IllegalStateException("Protocol security transactions require PostgreSQL");
+        try(var statement=prepare(connection,"SELECT pg_advisory_xact_lock(1380073797)")){statement.execute();}
+    }
+
+    @Override public Optional<Account> account(Connection connection,String issuer,String subject)throws SQLException {
+        target(connection,issuer,subject);
+        try(var statement=prepare(connection,"SELECT user_state,authentication_version,EXISTS(SELECT 1 FROM oidc_user_auth_method method WHERE method.user_id=account.username AND method.type='PASSWORD' AND method.state='ACTIVE' AND method.credential IS NOT NULL AND method.credential<>'') FROM oidc_user account WHERE username=?")) {
+            statement.setString(1,subject);
+            try(var result=statement.executeQuery()) {
+                if(!result.next())return Optional.empty();
+                boolean active="ACTIVE".equals(result.getString(1));
+                return Optional.of(new Account(issuer,subject,active,active && result.getBoolean(3),result.getLong(2)));
+            }
+        }
+    }
+
+    @Override public Optional<Client> client(Connection connection,String issuer,String clientId)throws SQLException {
+        target(connection,issuer,clientId);
+        try(var statement=prepare(connection,"SELECT active,scopes,client_kind,client_secret IS NOT NULL AND client_secret<>'' FROM oidc_client WHERE client_id=?")) {
+            statement.setString(1,clientId);
+            try(var result=statement.executeQuery()) {
+                if(!result.next())return Optional.empty();
+                var scopes=scopes(result.getString(2));
+                String kind=result.getString(3);
+                return Optional.of(new Client(issuer,clientId,result.getBoolean(1) && java.util.Set.of("system","owned").contains(kind),scopes,
+                    clientId.equals(configuredLoginClientId) && "system".equals(kind) && result.getBoolean(4)));
+            }
+        }
+    }
+
+    @Override public Optional<PendingClient> pendingClient(Connection connection,String issuer,String clientId)throws SQLException {
+        target(connection,issuer,clientId);
+        try(var statement=prepare(connection,"SELECT scopes FROM oidc_client WHERE client_id=? AND active AND client_kind='pending' AND pending_expires_at>now()")) {
+            statement.setString(1,clientId);
+            try(var result=statement.executeQuery()) {
+                return result.next()?Optional.of(new PendingClient(issuer,clientId,scopes(result.getString(1)))):Optional.empty();
+            }
+        }
+    }
+
+    private java.util.Set<String> scopes(String json) {
+        var scopes=new HashSet<String>();
+        try(var parser=mapper.createParser(json)) {
+            com.fasterxml.jackson.databind.JsonNode document=mapper.readTree(parser);
+            if(document==null || !document.isArray() || parser.nextToken()!=null)throw new IllegalStateException("Invalid protocol client scopes");
+            for(var scope:document)if(!scope.isTextual() || !scopes.add(scope.textValue()))throw new IllegalStateException("Invalid protocol client scopes");
+            return OidcProtocolValues.scopes(scopes);
+        }catch(java.io.IOException failure){throw new IllegalStateException("Invalid protocol client scopes",failure);}
+    }
+
+    @Override public Installation verifyInstallation(Connection connection,String issuer,String suppliedInstallationId)throws SQLException {
+        target(connection,issuer,suppliedInstallationId);
+        if(configuredLoginClientId==null)throw new IllegalStateException("Configured login client unavailable");
+        var installationId=receipt.read().orElseThrow(()->new IllegalStateException("Installation receipt unavailable"));
+        if(!installationId.equals(suppliedInstallationId))throw new IllegalArgumentException("Installation identity mismatch");
+        try(var statement=prepare(connection,"SELECT installation_id FROM oidc_setup WHERE singleton=true FOR SHARE");var result=statement.executeQuery()) {
+            if(!result.next() || !installationId.equals(result.getString(1)))throw new IllegalStateException("Installation identity mismatch");
+        }
+        var client=client(connection,issuer,configuredLoginClientId).orElseThrow(()->new IllegalStateException("Configured login client unavailable"));
+        if(!client.active() || !client.configuredLoginClient() || !client.registeredScopes().contains("openid"))
+            throw new IllegalStateException("Configured login client unavailable");
+        return new Installation(issuer,installationId,configuredLoginClientId);
+    }
+
+    private void target(Connection connection,String requestedIssuer,String id)throws SQLException {
+        if(!issuer.equals(requestedIssuer))throw new IllegalArgumentException("Issuer mismatch");
+        OidcProtocolValues.opaque(id);transaction(connection);
+    }
+
+    private static void transaction(Connection connection)throws SQLException {
+        Objects.requireNonNull(connection);
+        if(connection.getAutoCommit() || connection.isReadOnly() || connection.getTransactionIsolation()!=Connection.TRANSACTION_READ_COMMITTED)
+            throw new IllegalStateException("An explicit READ_COMMITTED protocol transaction is required");
+    }
+
+    private static PreparedStatement prepare(Connection connection,String sql)throws SQLException {
+        var statement=connection.prepareStatement(sql);statement.setQueryTimeout(5);return statement;
+    }
+}
