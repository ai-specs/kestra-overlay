+package io.kestra.webserver.oidc;
+
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.Set;
+import static io.kestra.webserver.oidc.OidcProtocolValues.*;
+
+public interface ApplicationGroupProtocolProjectionV1 {
+    int CONTRACT_VERSION=1;
+
+    Result current(Connection connection,Request request)throws SQLException;
+
+    record Request(String issuer,String tenant,String clientId,String subject,String expectedApplicationGroupId) {
+        public Request {
+            OidcProtocolValues.issuer(issuer);opaque(tenant);opaque(clientId);opaque(subject);
+            if(expectedApplicationGroupId!=null)groupId(expectedApplicationGroupId);
+        }
+    }
+
+    record Scope(String key,String name,String description) {
+        public Scope {
+            if(key==null || !key.matches("[a-z][a-z0-9-]{0,63}") || name==null || name.isBlank() || description==null)
+                throw new IllegalArgumentException("Invalid scope metadata");
+        }
+    }
+
+    record Projection(String applicationGroupId,String tenant,String issuer,String clientId,String subject,
+        boolean active,boolean approved,long revision,long authorizationVersion,Set<String> audiences,
+        List<Scope> scopes,Set<String> supportedScopeKeys,Set<String> grantedScopeKeys) {
+        public Projection {
+            groupId(applicationGroupId);opaque(tenant);OidcProtocolValues.issuer(issuer);opaque(clientId);opaque(subject);
+            if(revision<=0 || authorizationVersion<=0)throw new IllegalArgumentException("Invalid group versions");
+            audiences=Set.copyOf(audiences);scopes=List.copyOf(scopes);
+            supportedScopeKeys=Set.copyOf(supportedScopeKeys);grantedScopeKeys=Set.copyOf(grantedScopeKeys);
+            audiences.forEach(OidcProtocolValues::opaque);
+            if(audiences.stream().anyMatch(value->value.contains("*")) || approved && audiences.isEmpty())
+                throw new IllegalArgumentException("Exact application audiences required");
+            var keys=new HashSet<String>();var names=new HashSet<String>();
+            for(var scope:scopes)if(!keys.add(scope.key()) || !names.add(scope.name()))
+                throw new IllegalArgumentException("Duplicate scope key or name");
+            if(!keys.containsAll(supportedScopeKeys) || !keys.containsAll(grantedScopeKeys))
+                throw new IllegalArgumentException("Undefined scope reference");
+        }
+
+        public Set<String> eligibleScopeKeys(Request request) {
+            if(!issuer.equals(request.issuer()) || !tenant.equals(request.tenant()) || !clientId.equals(request.clientId()) || !subject.equals(request.subject())
+                || request.expectedApplicationGroupId()!=null && !applicationGroupId.equals(request.expectedApplicationGroupId()))
+                throw new IllegalArgumentException("Protocol projection target mismatch");
+            if(!active || !approved)return Set.of();
+            var eligible=new HashSet<>(supportedScopeKeys);eligible.retainAll(grantedScopeKeys);
+            return Set.copyOf(eligible);
+        }
+    }
+
+    record Result(int contractVersion,boolean activated,Optional<Projection> projection) {
+        public Result {
+            Objects.requireNonNull(projection);
+            if(contractVersion!=CONTRACT_VERSION || !activated && projection.isPresent())
+                throw new IllegalArgumentException("Invalid protocol projection state");
+        }
+    }
+
+    private static void groupId(String value) {
+        if(value==null || !value.matches("[A-Za-z0-9][A-Za-z0-9_-]{0,127}"))throw new IllegalArgumentException("Invalid group id");
+    }
+
+}
