+package io.kestra.webserver.oidc;
+
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.Objects;
+
+public interface IdentityLifecycleGuardV1 {
+    int CONTRACT_VERSION=1;
+
+    void beforeChange(Connection connection,Change change)throws SQLException;
+
+    enum Kind { ACCOUNT_DEACTIVATE,ACCOUNT_ACTIVATE,PASSWORD_RESET,CLIENT_REVOKE,CLIENT_DELETE }
+    enum Failure { FORBIDDEN,LAST_ADMIN,UNAVAILABLE }
+
+    final class Rejected extends RuntimeException {
+        private final Failure failure;
+        public Rejected(Failure failure) { super("Identity lifecycle guard: "+Objects.requireNonNull(failure));this.failure=failure; }
+        public Failure failure() {return failure;}
+    }
+
+    record Change(Kind kind,String issuer,String subject,String clientId) {
+        public Change {
+            Objects.requireNonNull(kind);
+            OidcProtocolValues.issuer(issuer);
+            boolean clientChange=kind==Kind.CLIENT_REVOKE || kind==Kind.CLIENT_DELETE;
+            if(clientChange) {
+                if(subject!=null)throw new IllegalArgumentException("Client change requires a client target only");
+                OidcProtocolValues.opaque(clientId);
+            }else {
+                if(clientId!=null)throw new IllegalArgumentException("Account change requires an account target only");
+                OidcProtocolValues.opaque(subject);
+            }
+        }
+    }
+}
