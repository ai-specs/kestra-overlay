diff --git a/webserver/src/test/java/io/kestra/webserver/oidc/ApplicationDirectoryV1Test.java b/webserver/src/test/java/io/kestra/webserver/oidc/ApplicationDirectoryV1Test.java
new file mode 100644
index 0000000..e4b4fb3
