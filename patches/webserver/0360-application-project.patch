+package io.kestra.webserver.oidc;
+
+import static org.assertj.core.api.Assertions.*;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.Set;
+
+class TrustedIdentityV1Test {
+    @Test
+    void rejectsWrongVersionAndPreservesSets() {
+        assertThatThrownBy(
+                        () ->
+                                new TrustedIdentityV1.Identity(
+                                        2,
+                                        "i",
+                                        "s",
+                                        "c",
+                                        Set.of("a"),
+                                        "t",
+                                        "p",
+                                        Set.of(),
+                                        Set.of(),
+                                        0,
+                                        0,
+                                        0))
+                .isInstanceOf(IllegalArgumentException.class);
+        var x =
+                new TrustedIdentityV1.Identity(
+                        1,
+                        "i",
+                        "s",
+                        "c",
+                        Set.of("a"),
+                        "t",
+                        "p",
+                        Set.of("openid"),
+                        Set.of("read"),
+                        1,
+                        2,
+                        3);
+        assertThat(x.projectScopes()).containsExactly("read");
+    }
+}
