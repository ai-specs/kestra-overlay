@@ -0,0 +1,108 @@
+package io.kestra.webserver.oidc;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.Set;
+
+class ApplicationDirectoryV1Test {
+    @Test
+    void shouldValidateFrozenIdentifiers() {
+        var project =
+                new ApplicationDirectoryV1.Project(
+                        "team_A-1", "main", "issuer", "Team", true, 1, 2);
+        assertThat(project.id()).isEqualTo("team_A-1");
+        assertThatThrownBy(
+                        () ->
+                                new ApplicationDirectoryV1.Project(
+                                        "bad:id", "main", "issuer", "x", true, 1, 1))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(
+                        () ->
+                                new ApplicationDirectoryV1.ScopeDefinition(
+                                        "p", "bad scope", "Invalid", "x", true, List.of(), List.of(), 1))
+                .isInstanceOf(IllegalArgumentException.class);
+    }
+
+    @Test
+    void shouldKeepManagementDomainExplicit() {
+        var intent =
+                new ApplicationDirectoryV1.ManagementIntent(
+                        ApplicationDirectoryV1.ManagementDomain.IDENTITY, Set.of("READ", "MANAGE"));
+        assertThat(intent.domain()).isEqualTo(ApplicationDirectoryV1.ManagementDomain.IDENTITY);
+    }
+
+    @Test
+    void shouldRejectAmbiguousAllDomainsAndUnknownManagementActions() {
+        assertThatThrownBy(
+                        () ->
+                                new ApplicationDirectoryV1.NamespaceDomain(
+                                        ApplicationDirectoryV1.DomainKind.ALL,
+                                        Set.of("team"),
+                                        Set.of()))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(
+                        () ->
+                                new ApplicationDirectoryV1.ResourceIdDomain(
+                                        ApplicationDirectoryV1.DomainKind.ALL, Set.of("flow")))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(
+                        () ->
+                                new ApplicationDirectoryV1.ManagementIntent(
+                                        ApplicationDirectoryV1.ManagementDomain.IDENTITY,
+                                        Set.of("ADMIN")))
+                .isInstanceOf(IllegalArgumentException.class);
+    }
+
+    @Test
+    void shouldDefaultMembershipToNonFirstParty() {
+        var membership =
+                new ApplicationDirectoryV1.ClientMembership(
+                        "p", "client", true, Set.of("ui"), Set.of("read"), 1);
+        assertThat(membership.firstPartyUi()).isFalse();
+        var input =
+                new ApplicationDirectoryV1.MembershipInput(
+                        "client", true, Set.of("ui"), Set.of("read"));
+        assertThat(input.firstPartyUi()).isFalse();
+    }
+    @Test
+    void shouldRestrictManagementTargetsToLocalPolicy() {
+        var local = new ApplicationDirectoryV1.ManagementIntent(
+            ApplicationDirectoryV1.ManagementDomain.LOCAL_POLICY, Set.of("MANAGE"), Set.of("p2"));
+        assertThat(local.projectIds()).containsExactly("p2");
+        assertThat(new ApplicationDirectoryV1.ManagementIntent(
+            ApplicationDirectoryV1.ManagementDomain.IDENTITY, Set.of("READ")).projectIds()).isEmpty();
+        assertThatThrownBy(() -> new ApplicationDirectoryV1.ManagementIntent(
+            ApplicationDirectoryV1.ManagementDomain.BUSINESS_INSTANCE, Set.of("READ"), Set.of("p2")))
+            .isInstanceOf(IllegalArgumentException.class);
+    }
+    @Test
+    void shouldFreezePolicyBoundaryCollectionsWithoutSubjectDetails() {
+        var scopes = new java.util.ArrayList<ApplicationDirectoryV1.ScopeDefinition>();
+        var audiences = new java.util.HashSet<>(Set.of("ui"));
+        var boundary = new ApplicationDirectoryV1.PolicyBoundary(
+            new ApplicationDirectoryV1.Project("p", "main", "issuer", "P", true, 1, 1),
+            scopes, audiences, Set.of(), List.of());
+        scopes.clear(); audiences.clear();
+        assertThat(boundary.audiences()).containsExactly("ui");
+        assertThatThrownBy(() -> boundary.scopes().add(null)).isInstanceOf(UnsupportedOperationException.class);
+        assertThat(java.util.Arrays.stream(ApplicationDirectoryV1.PolicyBoundary.class.getRecordComponents())
+            .map(java.lang.reflect.RecordComponent::getName)).doesNotContain("subjects", "assignments", "credentials", "grants");
+    }
+    @Test void rejectsInvalidNamespaceAndOpaqueIdIntentsWithoutNormalization() {
+        for (String name : List.of("a..b", ".a", "a.", "a.*", " a", "a/b", "a\n")) {
+            assertThatThrownBy(() -> new ApplicationDirectoryV1.NamespaceDomain(ApplicationDirectoryV1.DomainKind.RESTRICTED,Set.of(name),Set.of())).isInstanceOf(IllegalArgumentException.class);
+            assertThatThrownBy(() -> new ApplicationDirectoryV1.NamespaceDomain(ApplicationDirectoryV1.DomainKind.RESTRICTED,Set.of(),Set.of(name))).isInstanceOf(IllegalArgumentException.class);
+        }
+        for (String id : List.of("", " ", " a", "a ", "a\n", "a\u0001b"))
+            assertThatThrownBy(() -> new ApplicationDirectoryV1.ResourceIdDomain(ApplicationDirectoryV1.DomainKind.RESTRICTED,Set.of(id))).isInstanceOf(IllegalArgumentException.class);
+        var names = new ApplicationDirectoryV1.NamespaceDomain(ApplicationDirectoryV1.DomainKind.RESTRICTED,Set.of("team_A-1.child"),Set.of("sub_tree"));
+        assertThat(names.exact()).containsExactly("team_A-1.child");
+        var ids = new ApplicationDirectoryV1.ResourceIdDomain(ApplicationDirectoryV1.DomainKind.RESTRICTED,Set.of("opaque:a/b%_中文"));
+        assertThat(ids.ids()).containsExactly("opaque:a/b%_中文");
+    }
+
+}
