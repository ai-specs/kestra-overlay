diff --git a/webserver/src/test/java/io/kestra/webserver/oidc/TrustedIdentityV1Test.java b/webserver/src/test/java/io/kestra/webserver/oidc/TrustedIdentityV1Test.java
new file mode 100644
index 0000000..db68c82
--- /dev/null
+++ b/webserver/src/test/java/io/kestra/webserver/oidc/TrustedIdentityV1Test.java
@@ -0,0 +1,44 @@
+package io.kestra.webserver.oidc;
+
+import static org.assertj.core.api.Assertions.*;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.Set;
+
+class TrustedIdentityV1Test {
+    @Test
+    void rejectsWrongVersionAndPreservesSets() {
+        assertThatThrownBy(
+                        () ->
+                                new TrustedIdentityV1.Identity(
+                                        2,
+                                        "i",
+                                        "s",
+                                        "c",
+                                        Set.of("a"),
+                                        "t",
+                                        "p",
+                                        Set.of(),
+                                        Set.of(),
+                                        0,
+                                        0,
+                                        0))
+                .isInstanceOf(IllegalArgumentException.class);
+        var x =
+                new TrustedIdentityV1.Identity(
+                        1,
+                        "i",
+                        "s",
+                        "c",
+                        Set.of("a"),
+                        "t",
+                        "p",
+                        Set.of("openid"),
+                        Set.of("read"),
+                        1,
+                        2,
+                        3);
+        assertThat(x.applicationGroupScopes()).containsExactly("read");
+    }
+}
