+++ b/webserver/src/main/java/io/kestra/webserver/oidc/ApplicationDirectoryV1.java
@@ -0,0 +1,271 @@
+package io.kestra.webserver.oidc;
+
+import java.util.List;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.Set;
+
+/**
+ * Server-local directory V1. Writes require current IDENTITY.MANAGE and optimistic revision checks.
+ * RESTRICTED empty sets deny all; ALL must carry no selectors. No local policy grants are stored.
+ */
+public interface ApplicationDirectoryV1 {
+    int CONTRACT_VERSION = 1;
+
+    final class DirectoryException extends RuntimeException {
+        private final Failure failure;
+
+        public DirectoryException(Failure failure) {
+            super("Application directory: " + Objects.requireNonNull(failure));
+            this.failure = failure;
+        }
+
+        public Failure failure() {
+            return failure;
+        }
+    }
+
+    enum ManagementDomain {
+        IDENTITY,
+        LOCAL_POLICY,
+        BUSINESS_INSTANCE
+    }
+
+    enum DomainKind {
+        ALL,
+        RESTRICTED
+    }
+
+    enum Failure {
+        INVALID,
+        NOT_FOUND,
+        CONFLICT,
+        FORBIDDEN,
+        LAST_ADMIN,
+        UNAVAILABLE,
+        UNSUPPORTED
+    }
+
+    record NamespaceDomain(DomainKind kind, Set<String> exact, Set<String> subtrees) {
+        public NamespaceDomain {
+            kind = Objects.requireNonNull(kind);
+            exact = Set.copyOf(exact);
+            subtrees = Set.copyOf(subtrees);
+            if (java.util.stream.Stream.concat(exact.stream(), subtrees.stream()).anyMatch(value ->
+                !value.matches("[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*")))
+                throw new IllegalArgumentException("Invalid namespace intent");
+            if (kind == DomainKind.ALL && (!exact.isEmpty() || !subtrees.isEmpty())) {
+                throw new IllegalArgumentException("ALL namespace domain cannot contain selectors");
+            }
+        }
+    }
+
+    record ResourceIdDomain(DomainKind kind, Set<String> ids) {
+        public ResourceIdDomain {
+            kind = Objects.requireNonNull(kind);
+            ids = Set.copyOf(ids);
+            if (ids.stream().anyMatch(value -> value.isBlank() || !value.equals(value.trim())
+                || value.chars().anyMatch(Character::isISOControl)))
+                throw new IllegalArgumentException("Invalid opaque resource identifier");
+            if (kind == DomainKind.ALL && !ids.isEmpty()) {
+                throw new IllegalArgumentException(
+                        "ALL resource domain cannot contain identifiers");
+            }
+        }
+    }
+
+    record ResourceIntent(
+            String vocabularyVersion,
+            String resourceType,
+            NamespaceDomain namespaces,
+            ResourceIdDomain resourceIds,
+            Set<String> actions) {
+        public ResourceIntent {
+            vocabularyVersion = Objects.requireNonNull(vocabularyVersion);
+            resourceType = Objects.requireNonNull(resourceType);
+            namespaces = Objects.requireNonNull(namespaces);
+            resourceIds = Objects.requireNonNull(resourceIds);
+            actions = Set.copyOf(actions);
+        }
+    }
+
+    record ManagementIntent(ManagementDomain domain, Set<String> actions, Set<String> projectIds) {
+        public ManagementIntent {
+            domain = Objects.requireNonNull(domain);
+            actions = Set.copyOf(actions);
+            projectIds = Set.copyOf(projectIds);
+            if (!Set.of("READ", "MANAGE").containsAll(actions)) {
+                throw new IllegalArgumentException("Unknown management action");
+            }
+            if (domain != ManagementDomain.LOCAL_POLICY && !projectIds.isEmpty()) {
+                throw new IllegalArgumentException("Only local policy may target projects");
+            }
+            if (projectIds.stream().anyMatch(value -> !value.matches("[A-Za-z0-9][A-Za-z0-9_-]{0,127}"))) {
+                throw new IllegalArgumentException("Invalid management project id");
+            }
+        }
+        public ManagementIntent(ManagementDomain domain, Set<String> actions) {
+            this(domain, actions, Set.of());
+        }
+    }
+
+    record Project(
+            String id,
+            String tenant,
+            String issuer,
+            String displayName,
+            boolean active,
+            long revision,
+            long authorizationVersion) {
+        public Project {
+            if (!id.matches("[A-Za-z0-9][A-Za-z0-9_-]{0,127}"))
+                throw new IllegalArgumentException("Invalid project id");
+        }
+    }
+
+    record ScopeDefinition(
+            String projectId,
+            String scope,
+            String name,
+            String description,
+            boolean active,
+            List<ResourceIntent> resourceIntents,
+            List<ManagementIntent> managementIntents,
+            long revision) {
+        public ScopeDefinition {
+            if (!scope.matches("[a-z][a-z0-9-]{0,63}"))
+                throw new IllegalArgumentException("Invalid scope key");
+            if (name == null || name.isBlank() || !name.equals(name.trim()))
+                throw new IllegalArgumentException("Scope name required");
+            if (description == null) throw new IllegalArgumentException("Scope description required");
+            resourceIntents = List.copyOf(resourceIntents);
+            managementIntents = List.copyOf(managementIntents);
+        }
+    }
+
+    record ClientMembership(
+            String projectId,
+            String clientId,
+            boolean approved,
+            Set<String> audiences,
+            Set<String> allowedProjectScopes,
+            boolean firstPartyUi,
+            long revision) {
+        public ClientMembership {
+            audiences = Set.copyOf(audiences);
+            allowedProjectScopes = Set.copyOf(allowedProjectScopes);
+        }
+
+        public ClientMembership(
+                String projectId,
+                String clientId,
+                boolean approved,
+                Set<String> audiences,
+                Set<String> allowedProjectScopes,
+                long revision) {
+            this(projectId, clientId, approved, audiences, allowedProjectScopes, false, revision);
+        }
+    }
+
+    record SubjectAssignment(
+            String projectId,
+            String issuer,
+            String subject,
+            Set<String> projectScopes,
+            long revision,
+            long authorizationVersion) {
+        public SubjectAssignment {
+            projectScopes = Set.copyOf(projectScopes);
+        }
+    }
+
+    record Page<T>(List<T> items, long total, int page, int size) {
+        public Page {
+            items = List.copyOf(items);
+        }
+    }
+
+    record ProjectInput(String id, String tenant, String displayName) {}
+
+    record ScopeInput(
+            String scope,
+            String name,
+            String description,
+            boolean active,
+            List<ResourceIntent> resourceIntents,
+            List<ManagementIntent> managementIntents) {}
+
+    record MembershipInput(
+            String clientId,
+            boolean approved,
+            Set<String> audiences,
+            Set<String> allowedProjectScopes,
+            boolean firstPartyUi) {
+        public MembershipInput(
+                String clientId,
+                boolean approved,
+                Set<String> audiences,
+                Set<String> allowedProjectScopes) {
+            this(clientId, approved, audiences, allowedProjectScopes, false);
+        }
+    }
+
+    record AssignmentInput(String issuer, String subject, Set<String> projectScopes) {}
+
+    record ProtocolScope(String scope, String category) {}
+
+    Page<Project> projects(int page, int size);
+
+    Optional<Project> project(String id);
+
+    Project createProject(ProjectInput input);
+
+    Project updateProject(String id, long revision, String name, boolean active);
+
+    Page<ScopeDefinition> scopes(String project, int page, int size);
+
+    Optional<ScopeDefinition> scope(String project, String scope);
+
+    ScopeDefinition createScope(String project, long revision, ScopeInput input);
+
+    ScopeDefinition updateScope(String project, String scope, long revision, ScopeInput input);
+
+    void deleteScope(String project, String scope, long revision);
+
+    Page<ClientMembership> clients(String project, int page, int size);
+
+    ClientMembership approveClient(String project, long revision, MembershipInput input);
+
+    ClientMembership updateClient(
+            String project, String client, long revision, MembershipInput input);
+
+    void removeClient(String project, String client, long revision);
+
+    Page<SubjectAssignment> assignments(String project, int page, int size);
+
+    Optional<SubjectAssignment> assignment(String project, String issuer, String subject);
+
+    SubjectAssignment assign(String project, long revision, AssignmentInput input);
+
+    SubjectAssignment replaceAssignment(
+            String project, String issuer, String subject, long revision, AssignmentInput input);
+
+    void revokeAssignment(String project, String issuer, String subject, long revision);
+
+    record PolicyBoundary(Project project, List<ScopeDefinition> scopes, Set<String> audiences,
+        Set<String> reachableManagementScopes, List<ProtocolScope> protocolScopes) {
+        public PolicyBoundary {
+            project = Objects.requireNonNull(project);
+            scopes = List.copyOf(scopes);
+            audiences = Set.copyOf(audiences);
+            reachableManagementScopes = Set.copyOf(reachableManagementScopes);
+            protocolScopes = List.copyOf(protocolScopes);
+        }
+    }
+
+    default List<PolicyBoundary> policyBoundaries() {
+        throw new DirectoryException(Failure.UNSUPPORTED);
+    }
+
+    List<ProtocolScope> protocolScopes();
+}
