diff --git a/webserver/src/main/java/io/kestra/webserver/oidc/ApplicationScopeDeclarationsV1.java b/webserver/src/main/java/io/kestra/webserver/oidc/ApplicationScopeDeclarationsV1.java
new file mode 100644
index 0000000..6f77e24
--- /dev/null
+++ b/webserver/src/main/java/io/kestra/webserver/oidc/ApplicationScopeDeclarationsV1.java
@@ -0,0 +1,45 @@
+package io.kestra.webserver.oidc;
+
+import java.util.List;
+import java.util.Set;
+
+public interface ApplicationScopeDeclarationsV1 {
+    int CONTRACT_VERSION = 1;
+
+    record Permission(String key, String name) {
+        public Permission {
+            if (key == null || !key.matches("[a-z][a-z0-9-]{0,63}") || name == null || name.isBlank())
+                throw new IllegalArgumentException("Invalid application permission declaration");
+        }
+    }
+
+    record Scope(String key, List<Permission> permissions) {
+        public Scope {
+            if (key == null || !key.matches("[a-z][a-z0-9-]{0,63}") || permissions == null || permissions.isEmpty())
+                throw new IllegalArgumentException("Invalid application scope declaration");
+            permissions = List.copyOf(permissions);
+            if (permissions.stream().map(Permission::key).distinct().count() != permissions.size())
+                throw new IllegalArgumentException("Duplicate application permission key");
+        }
+    }
+
+    record Projection(String applicationGroupId, String clientId, List<Scope> scopes) {
+        public Projection {
+            if (applicationGroupId == null || applicationGroupId.isBlank() || clientId == null || clientId.isBlank()
+                || scopes == null) throw new IllegalArgumentException("Invalid application declaration target");
+            scopes = List.copyOf(scopes);
+            if (scopes.stream().map(Scope::key).distinct().count() != scopes.size())
+                throw new IllegalArgumentException("Duplicate application scope key");
+        }
+
+        public Set<String> supportedScopeKeys() {
+            return scopes.stream().map(Scope::key).collect(java.util.stream.Collectors.toUnmodifiableSet());
+        }
+    }
+
+    Projection current(String applicationGroupId, String clientId);
+
+    default Projection current(java.sql.Connection connection, String applicationGroupId, String clientId) {
+        return current(applicationGroupId, clientId);
+    }
+}
diff --git a/webserver/src/main/java/io/kestra/webserver/oidc/TrustedIdentityV1.java b/webserver/src/main/java/io/kestra/webserver/oidc/TrustedIdentityV1.java
new file mode 100644
index 0000000..55799b3
--- /dev/null
+++ b/webserver/src/main/java/io/kestra/webserver/oidc/TrustedIdentityV1.java
@@ -0,0 +1,51 @@
+package io.kestra.webserver.oidc;
+
+import java.util.Set;
+
+/**
+ * Reads the current host-validated identity. Constructing an Identity DTO does not authenticate it.
+ * The host must validate signature, audience and applicationGroup epoch before establishing this context.
+ */
+public interface TrustedIdentityV1 {
+    Identity current();
+
+    /**
+     * directoryRevision is the immutable directory snapshot revision (ApplicationGroup.revision).
+     * authorizationVersion is the independently validated token/session revocation epoch
+     * (ApplicationGroup.authorizationVersion). These values need not be equal.
+     */
+    record Identity(
+            int contractVersion,
+            String issuer,
+            String subject,
+            String clientId,
+            Set<String> audiences,
+            String tenant,
+            String applicationGroupId,
+            Set<String> protocolScopes,
+            Set<String> applicationGroupScopes,
+            long authenticationVersion,
+            long authorizationVersion,
+            long directoryRevision) {
+        public Identity {
+            if (contractVersion != 1
+                    || issuer == null
+                    || subject == null
+                    || clientId == null
+                    || tenant == null
+                    || applicationGroupId == null)
+                throw new IllegalArgumentException("Invalid trusted identity");
+            audiences = Set.copyOf(audiences);
+            protocolScopes = Set.copyOf(protocolScopes);
+            applicationGroupScopes = Set.copyOf(applicationGroupScopes);
+        }
+    }
+
+    enum Failure {
+        UNAUTHENTICATED,
+        INVALID,
+        REVOKED,
+        UNAVAILABLE,
+        UNSUPPORTED
+    }
+}
