+            "https://evil.org/prefix/api/v1/main/mcp/first", "https://example.org/prefix/api/v1/main/mcp/first%2Fother",
+            "https://example.org/prefix/api/v1/main/mcp/../first", "https://example.org/prefix/api/v1/main/mcp/first?query")) {
+            assertThrows(IllegalArgumentException.class, () -> resources.parseExact(invalid));
+        }
+        assertThrows(IllegalArgumentException.class, () -> resources.parseExact(null));
+    }
+    @Test
+    void shouldSeparateServersAndPreserveDeploymentPrefix() {
+        final var resources = new McpResourceUrl("https://kestra.example.org/prefix/", null);
+        assertEquals("https://kestra.example.org/prefix/api/v1/main/mcp/first", resources.resource("main", "first").toString());
+        assertNotEquals(resources.resource("main", "first"), resources.resource("main", "second"));
+    }
+
+    @Test
+    void shouldRejectUntrustedOrAmbiguousBaseUrls() {
+        for (final String base : java.util.List.of("", "/relative", "https://example.org?query", "https://example.org#fragment", "https://user@example.org", "file:///tmp")) {
+            assertThrows(IllegalArgumentException.class, () -> new McpResourceUrl(base, null));
+        }
+        assertThrows(IllegalArgumentException.class, () -> new McpResourceUrl("https://example.org", null).resource("main", "../other"));
+    }
+}
