index 0000000000000000000000000000000000000000..7cfecf7cd6edc7f74c804c0187a1f20967973adf
--- /dev/null
+++ b/webserver/src/main/java/io/kestra/webserver/mcp/McpResourceUrl.java
@@ -0,0 +1,81 @@
+package io.kestra.webserver.mcp;
+
+import java.net.URI;
+import java.util.Objects;
+
+import io.micronaut.context.annotation.Value;
+import jakarta.inject.Singleton;
+import io.micronaut.context.BeanProvider;
+
+@Singleton
+@io.micronaut.context.annotation.Requires(property = "kestra.oidc.enabled", value = "true")
+public class McpResourceUrl {
+    public static class UnknownResourceException extends IllegalArgumentException {
+        public UnknownResourceException() { super("Unknown resource"); }
+    }
+    private final URI base;
+    private final BeanProvider<io.kestra.mcp.McpServerCache> servers;
+
+    public McpResourceUrl(@Value("${kestra.url:}") final String configuredBase, final BeanProvider<io.kestra.mcp.McpServerCache> servers) {
+        this.base = parse(configuredBase);
+        this.servers = servers;
+    }
+
+    public URI parseExact(final String value) {
+        if (value == null) throw new IllegalArgumentException("resource is required");
+        final URI candidate;
+        try { candidate = URI.create(value); } catch (IllegalArgumentException exception) { throw new IllegalArgumentException("Invalid resource"); }
+        if (candidate.getRawPath() == null || !base.getScheme().equalsIgnoreCase(candidate.getScheme()) || !base.getRawAuthority().equals(candidate.getRawAuthority())
+            || candidate.getRawQuery() != null || candidate.getRawFragment() != null || candidate.getUserInfo() != null
+            || !candidate.getRawPath().startsWith(base.getRawPath())) throw new IllegalArgumentException("Invalid resource");
+        final String suffix = candidate.getRawPath().substring(base.getRawPath().length());
+        if (!suffix.matches("api/v1/[a-z0-9][a-z0-9_-]*/mcp/[a-z0-9][a-z0-9_-]*") || suffix.contains("%") || suffix.contains("..")) {
+            throw new IllegalArgumentException("Invalid resource");
+        }
+        final String[] parts = suffix.split("/");
+        if (!io.kestra.core.tenant.TenantService.MAIN_TENANT.equals(parts[2])
+            || !resource(parts[2], parts[4]).toString().equals(value)) throw new IllegalArgumentException("Invalid resource");
+        if (!servers.isPresent()) throw new UnknownResourceException();
+        if (servers.get().get(parts[2], parts[4]).isEmpty()) throw new UnknownResourceException();
+        return candidate;
+    }
+
+    public URI resource(final String tenant, final String serverId) {
+        return URI.create(base.toString() + "api/v1/" + encode(tenant) + "/mcp/" + encode(serverId));
+    }
+
+    public URI metadata(final String tenant, final String serverId) {
+        return URI.create(base.getScheme() + "://" + base.getRawAuthority()
+            + "/.well-known/oauth-protected-resource" + resource(tenant, serverId).getRawPath());
+    }
+
+    public URI fromMetadataPath(final String path) {
+        final String prefix = base.getRawPath().substring(1);
+        if (!path.startsWith(prefix)) throw new IllegalArgumentException("Invalid resource");
+        final String suffix = path.substring(prefix.length());
+        final String[] parts = suffix.split("/");
+        if (parts.length != 5 || !"api".equals(parts[0]) || !"v1".equals(parts[1]) || !"mcp".equals(parts[3])) {
+            throw new IllegalArgumentException("Invalid resource");
+        }
+        return parseExact(resource(parts[2], parts[4]).toString());
+    }
+
+    private static URI parse(final String value) {
+        if (value == null || value.isBlank()) throw new IllegalArgumentException("kestra.url must be configured");
+        final URI uri;
+        try { uri = URI.create(value); } catch (IllegalArgumentException exception) { throw new IllegalArgumentException("kestra.url must be a valid absolute URL"); }
+        if (!uri.isAbsolute() || !("http".equalsIgnoreCase(uri.getScheme()) || "https".equalsIgnoreCase(uri.getScheme()))
+            || uri.getHost() == null || uri.getRawQuery() != null || uri.getRawFragment() != null || uri.getUserInfo() != null) {
+            throw new IllegalArgumentException("kestra.url must be an absolute HTTP(S) URL without query, fragment or userinfo");
+        }
+        if (!uri.normalize().equals(uri) || uri.getRawPath().contains("%") || uri.getRawPath().contains("//")) {
+            throw new IllegalArgumentException("kestra.url must have a canonical base path");
+        }
+        return URI.create(uri.toString().replaceAll("/+$", "") + "/");
+    }
+
+    private static String encode(final String value) {
+        if (!Objects.requireNonNull(value).matches("[a-z0-9][a-z0-9_-]*")) throw new IllegalArgumentException("Invalid MCP route identity");
+        return value;
+    }
+}
