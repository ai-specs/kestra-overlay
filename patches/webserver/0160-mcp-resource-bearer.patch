+import io.kestra.mcp.DefaultMcpToolAccessControl;
+import io.kestra.mcp.McpSessionFactory;
+import io.kestra.webserver.mcp.McpAuthenticationFetcher;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.security.authentication.Authentication;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+class McpIdentityPropagationTest {
+    @Test
+    void shouldPropagateVerifiedSubjectClientResourceAndScopes() {
+        final var request = HttpRequest.POST("/api/v1/main/mcp/first", "{}");
+        final var authentication = Authentication.build("alice", Map.of("client_id", "client-a"));
+        request.setAttribute("io.kestra.mcp.authentication", authentication);
+        assertEquals("alice", new DefaultMcpToolAccessControl().callerId(request).orElseThrow());
+        assertSame(authentication, Mono.from(new McpAuthenticationFetcher().fetchAuthentication(request)).block());
+        final var factory = new McpSessionFactory();
+        final var alice = factory.build("main", "first", "session", "alice", "client-a", "https://example.org/first", List.of("mcp:flows:read"));
+        final var bob = factory.build("main", "first", "session", "bob", "client-b", "https://example.org/first", List.of("mcp:flows:read"));
+        assertNotEquals(alice, bob);
+        assertEquals("alice", alice.get("userId"));
+        assertEquals("client-a", alice.get("clientId"));
+        assertEquals(List.of("mcp:flows:read"), alice.get("scopes"));
+    }
+}
