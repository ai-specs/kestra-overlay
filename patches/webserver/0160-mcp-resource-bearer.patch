+(
+attributes
+)));
+            return true;
+        }).subscribeOn(Schedulers.boundedElastic()).onErrorResume(McpResourceUrl.UnknownResourceException.class,
+            exception -> Mono.empty()).onErrorReturn(false)
+            .flatMapMany(authenticated -> authenticated ? chain.proceed(request)
