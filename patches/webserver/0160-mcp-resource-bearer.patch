+package io.kestra.webserver.mcp;
+
+import java.util.List;
+import java.util.Map;
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.annotation.Controller;
+import io.micronaut.http.annotation.Get;
+import io.micronaut.scheduling.TaskExecutors;
+import io.micronaut.scheduling.annotation.ExecuteOn;
+
+@Controller("/.well-known/oauth-protected-resource")
+@Requires(property = "kestra.oidc.enabled", value = "true")
+@ExecuteOn(TaskExecutors.IO)
+public class McpResourceMetadataController {
+    private final McpResourceUrl resources;
+    private final OidcConfiguration configuration;
+
+    public McpResourceMetadataController(final McpResourceUrl resources, final OidcConfiguration configuration) {
+        this.resources = resources;
+        this.configuration = configuration;
+    }
+
+    @Get("/{path:.*}")
+    public HttpResponse<?> metadata(final String path) {
+        try {
+            final String resource = resources.fromMetadataPath(path).toString();
+            return HttpResponse.ok(Map.of("resource", resource, "authorization_servers", List.of(configuration.getIssuer()), "bearer_methods_supported", List.of("header")))
+                .header("Cache-Control", "no-store");
+        } catch (IllegalArgumentException exception) { return HttpResponse.notFound(); }
+    }
+}
