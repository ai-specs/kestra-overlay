+            Object projectClaim = claims.getClaim(io.kestra.webserver.oidc.services.OidcTrustedIdentity.CLAIM);
+            if (projectClaim != null) identity.put(io.kestra.webserver.oidc.services.OidcTrustedIdentity.CLAIM, projectClaim);
+
+            request.setAttribute("io.kestra.mcp.identity", Map.
+copyOf
+(
+identity));
+            var attributes = new java.util.HashMap<String
+,
+Object>
+()
+;
+            attributes.put(
+ "client_id", stored.clientId()
+);
+            attributes.put(
+ "resource", resource
+);
+            attributes.put("scope"
+, stored.scopes()
+);
+            attributes.put("iss"
+,
+claims.getIssuer());
+            attributes.put("aud"
+,
+claims.getAudience(
+)
+);
+            Object version = claims.getClaim(io.kestra.webserver.oidc.services.OidcIdentityLifecycle.CLAIM);
+            if (version != null) attributes.put(io.kestra.webserver.oidc.services.OidcIdentityLifecycle.CLAIM, version);
+            if (projectClaim != null) attributes.put(io.kestra.webserver.oidc.services.OidcTrustedIdentity.CLAIM, projectClaim
+);
+            request.setAttribute("io.kestra.mcp.authentication", Authentication.build(claims.getSubject(), roles, Map.
