@@ -0,0 +1,56 @@
+package io.kestra.webserver.mcp;
+
+import java.util.Map;
+import io.kestra.mcp.McpToolRoute;
+import io.kestra.webserver.oidc.services.OidcTokenService;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.MutableHttpResponse;
+import io.micronaut.http.annotation.Filter;
+import io.micronaut.http.filter.HttpServerFilter;
+import io.micronaut.http.filter.ServerFilterChain;
+import io.micronaut.http.filter.ServerFilterPhase;
+import io.micronaut.security.authentication.Authentication;
+import org.reactivestreams.Publisher;
+import jakarta.inject.Singleton;
+import reactor.core.publisher.Mono;
+import reactor.core.scheduler.Schedulers;
+
+@Filter("/api/v1/*/mcp/*")
+@Singleton
+@Requires(property = "kestra.oidc.enabled", value = "true")
+@Requires(property = "kestra.server-type", pattern = "(WEBSERVER|STANDALONE)")
+public class McpBearerFilter implements HttpServerFilter {
+    private final McpResourceUrl resources;
+    private final OidcTokenService tokens;
+
+    public McpBearerFilter(final McpResourceUrl resources, final OidcTokenService tokens) {
+        this.resources = resources;
+        this.tokens = tokens;
+    }
+
+    @Override
+    public int getOrder() { return ServerFilterPhase.SECURITY.order() - 2; }
+
+    @Override
+    public Publisher<MutableHttpResponse<?>> doFilter(final HttpRequest<?> request, final ServerFilterChain chain) {
+        final var server = McpToolRoute.serverId(request);
+        if (server.isEmpty()) return chain.proceed(request);
+        return Mono.fromCallable(() -> {
+            if (request.getUri().getRawPath().contains("%")) throw new IllegalArgumentException("Noncanonical MCP route");
+            final String tenant = McpToolRoute.tenantId(request).orElseThrow();
+            final String resource = resources.parseExact(resources.resource(tenant, server.get()).toString()).toString();
+            final String header = request.getHeaders().get("Authorization");
+            if (header == null || !header.startsWith("Bearer ") || header.substring(7).isBlank()) throw new IllegalArgumentException("Invalid authentication");
+            final var claims = tokens.validateResourceAccessToken(header.substring(7), resource);
+            final var stored = tokens.findByValue(header.substring(7)).orElseThrow();
+            request.setAttribute("io.kestra.mcp.identity", Map.of("subject", claims.getSubject(), "client_id", stored.clientId(), "resource", resource, "scopes", stored.scopes()));
+            request.setAttribute("io.kestra.mcp.authentication", Authentication.build(claims.getSubject(), Map.of("client_id", stored.clientId(), "resource", resource, "scope", stored.scopes())));
+            return true;
+        }).subscribeOn(Schedulers.boundedElastic()).onErrorReturn(false)
+            .flatMapMany(authenticated -> authenticated ? chain.proceed(request)
+                : Mono.just(HttpResponse.unauthorized().header("WWW-Authenticate",
+                    "Bearer resource_metadata=\"" + resources.metadata("main", server.get()) + "\"").body(Map.of("error", "invalid_token"))));
+    }
+}
