+package io.kestra.webserver.oidc;
+
+import java.util.Optional;
+import java.util.List;
+import com.nimbusds.jwt.JWTClaimsSet;
+import io.kestra.mcp.McpToolRoute;
+import io.kestra.webserver.mcp.McpBearerFilter;
+import io.kestra.webserver.mcp.McpResourceUrl;
+import io.kestra.webserver.oidc.services.OidcTokenService;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.HttpStatus;
+import io.micronaut.http.filter.ServerFilterChain;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.mockStatic;
+import static org.mockito.Mockito.when;
+import static org.mockito.Mockito.verifyNoInteractions;
+import static org.mockito.Mockito.any;
+import static org.mockito.Mockito.anyString;
+
+class McpBearerFilterTest {
+    @Test
+    void shouldChallengeBasicCookieAndInvalidBearerWithoutExecuting() {
+        final var resources = mock(McpResourceUrl.class);
+        final var tokens = mock(OidcTokenService.class);
+        final var chain = mock(ServerFilterChain.class);
+        when(resources.resource("main", "first")).thenReturn(java.net.URI.create("https://example.org/api/v1/main/mcp/first"));
+        when(resources.parseExact(anyString())).thenReturn(java.net.URI.create("https://example.org/api/v1/main/mcp/first"));
+        when(resources.metadata("main", "first")).thenReturn(java.net.URI.create("https://example.org/.well-known/oauth-protected-resource/api/v1/main/mcp/first"));
+        when(tokens.validateResourceAccessToken(anyString(), anyString())).thenThrow(new IllegalArgumentException());
+        final var filter = new McpBearerFilter(resources, tokens);
+        try (var routes = mockStatic(McpToolRoute.class)) {
+            routes.when(() -> McpToolRoute.serverId(any())).thenReturn(Optional.of("first"));
+            routes.when(() -> McpToolRoute.tenantId(any())).thenReturn(Optional.of("main"));
+            for (final String header : List.of("", "Basic abc", "Bearer cross-resource")) {
+                final var request = HttpRequest.POST("/api/v1/main/mcp/first", "{}").header("Cookie", "JWT=old; oidc_session=old");
+                if (!header.isEmpty()) request.header("Authorization", header);
+                final var response = Mono.from(filter.doFilter(request, chain)).block();
+                assertEquals(HttpStatus.UNAUTHORIZED, response.getStatus());
+                assertTrue(response.getHeaders().get("WWW-Authenticate").contains("resource_metadata=\"https://example.org/.well-known/oauth-protected-resource/"));
+            }
+            verifyNoInteractions(chain);
+        }
+    }
+}
