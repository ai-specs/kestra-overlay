+        servers.save(null, new McpServer("main", "http-security", "", "", McpServer.ServerType.PRIVATE,
+            McpServer.AuthType.BASIC, null, null, false, false, false, null, null));
+        final var client = HttpClient.newBuilder().followRedirects(HttpClient.Redirect.NEVER).build();
+        for (final String authorization : List.of("", "Basic YWRtaW46cGFzc3dvcmQ=", "Bearer invalid")) {
+            final var builder = HttpRequest.newBuilder(server.getURI().resolve("/api/v1/main/mcp/http-security"))
