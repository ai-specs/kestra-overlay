@@ -0,0 +1,216 @@
+package io.kestra.webserver.oidc;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.List;
+import java.util.concurrent.Executors;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.nimbusds.jose.JWSAlgorithm;
+import com.nimbusds.jose.JWSHeader;
+import com.nimbusds.jose.JWSObject;
+import com.nimbusds.jose.Payload;
+import com.nimbusds.jwt.JWTClaimsSet;
+import com.nimbusds.oauth2.sdk.Scope;
+import com.nimbusds.oauth2.sdk.token.RefreshToken;
+
+import io.kestra.webserver.oidc.services.OidcClientService;
+import io.kestra.webserver.oidc.services.OidcJwkService;
+import io.kestra.webserver.oidc.services.OidcTokenService;
+import io.kestra.webserver.oidc.services.OidcUserService;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * A3 (client-credential-style issuance) + B1/B2 (RS256 verify, alg=none rejection)
+ * + refresh rotation for the R-OIDC-SERVER security checklist.
+ */
+class OidcResourceTokenTest extends OidcPostgresTestBase {
+
+    private static final String ISSUER = "http://kestra-oidc-test";
+
+    private OidcTokenService service;
+    private OidcClientService clients;
+
+    @BeforeEach
+    void setUp() throws Exception {
+        final ObjectMapper mapper = new ObjectMapper();
+        final OidcConfiguration configuration = new OidcConfiguration();
+        configuration.setIssuer(ISSUER);
+        service = new OidcTokenService(OidcPostgresTestBase.dataSource(), mapper, configuration,
+            new OidcJwkService(OidcPostgresTestBase.dataSource()));
+        clients = new OidcClientService(OidcPostgresTestBase.dataSource(), mapper);
+        clients.delete("machine-client");
+        clients.create("machine-client", "s3cret", List.of(), List.of("client_credentials"), List.of("openid"));
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("UPDATE oidc_client SET client_kind='system' WHERE client_id='machine-client'");
+        }
+    }
+
+    @Test
+    void shouldKeepRefreshUsableAfterInvalidScopeAndRotateOnceConcurrently() throws Exception {
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("INSERT INTO oidc_user(username,name,email) VALUES ('rotation-user','User','user@example.org') ON CONFLICT(username) DO UPDATE SET user_state='ACTIVE'");
+        }
+        final var user = new OidcUserService.OidcUser("rotation-user", "User", "user@example.org", false, List.of());
+        final var refresh = service.issueRefreshToken("machine-client", user.sub(), new Scope("openid"));
+        final var stored = service.validateRefreshToken(refresh.getValue(), "machine-client");
+        assertThrows(OidcException.class, () -> service.rotateRefreshToken(stored, user, new Scope("openid", "email")));
+        assertTrue(!service.findByValue(refresh.getValue()).orElseThrow().revoked());
+        try (var executor = Executors.newFixedThreadPool(2)) {
+            final var results = executor.invokeAll(List.<java.util.concurrent.Callable<Integer>>of(
+                () -> rotate(stored, user), () -> rotate(stored, user)));
+            assertEquals(1, results.get(0).get() + results.get(1).get());
+        }
+        assertTrue(service.findByValue(refresh.getValue()).orElseThrow().revoked());
+    }
+
+    private int rotate(final OidcTokenService.StoredToken stored, final OidcUserService.OidcUser user) {
+        try { service.rotateRefreshToken(stored, user, new Scope("openid")); return 1; }
+        catch (OidcException exception) { return 0; }
+    }
+
+    @Test
+    void shouldRollBackRotationWhenNewTokenPersistenceFails() throws Exception {
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("INSERT INTO oidc_user(username,name,email) VALUES ('rotation-user','User','user@example.org') ON CONFLICT(username) DO UPDATE SET user_state='ACTIVE'");
+        }
+        final var user = new OidcUserService.OidcUser("rotation-user", "User", "user@example.org", false, List.of());
+        final var refresh = service.issueRefreshToken("machine-client", user.sub(), new Scope("openid"));
+        final var stored = service.validateRefreshToken(refresh.getValue(), "machine-client");
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("ALTER TABLE oidc_token ADD CONSTRAINT rotation_failure CHECK (token_type<>'refresh' OR revoked OR value='" + refresh.getValue() + "') NOT VALID");
+        }
+        try {
+            assertThrows(IllegalStateException.class, () -> service.rotateRefreshToken(stored, user, new Scope("openid")));
+            assertTrue(!service.findByValue(refresh.getValue()).orElseThrow().revoked());
+            try (var connection = dataSource().getConnection(); var statement = connection.createStatement();
+                var result = statement.executeQuery("SELECT count(*) FROM oidc_token WHERE client_id='machine-client' AND token_type='access'")) {
+                result.next();
+                assertEquals(0, result.getInt(1));
+            }
+        } finally {
+            try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+                statement.execute("ALTER TABLE oidc_token DROP CONSTRAINT rotation_failure");
+            }
+        }
+        service.rotateRefreshToken(stored, user, new Scope("openid"));
+    }
+
+    @Test
+    void systemUserTokensRejectInactiveDeletedUserAndInactiveClient() throws Exception {
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("INSERT INTO oidc_user(username,name,email) VALUES ('lifecycle-user','User','user@example.org') ON CONFLICT(username) DO UPDATE SET user_state='ACTIVE'");
+        }
+        final var access = service.issueAccessToken("machine-client", "lifecycle-user", "User", null, List.of(), new Scope("openid"));
+        final var refresh = service.issueRefreshToken("machine-client", "lifecycle-user", new Scope("openid"));
+        service.validateAccessToken(access.getValue());
+        service.validateRefreshToken(refresh.getValue(), "machine-client");
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("UPDATE oidc_user SET user_state='INACTIVE' WHERE username='lifecycle-user'");
+        }
+        assertThrows(OidcException.class, () -> service.validateAccessToken(access.getValue()));
+        assertThrows(OidcException.class, () -> service.validateRefreshToken(refresh.getValue(), "machine-client"));
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("DELETE FROM oidc_user WHERE username='lifecycle-user'");
+        }
+        assertThrows(OidcException.class, () -> service.validateAccessToken(access.getValue()));
+        clients.updateActive("machine-client", false);
+        final var machine = service.issueAccessToken("machine-client", "machine-client", "Machine", null, List.of(), new Scope("openid"));
+        assertThrows(OidcException.class, () -> service.validateAccessToken(machine.getValue()));
+    }
+
+    @Test
+    void resourceTokensCannotCrossServersOrUseIdTokens() {
+        final String first = "https://example.org/api/v1/main/mcp/first";
+        final String second = "https://example.org/api/v1/main/mcp/second";
+        final var access = service.issueAccessToken("machine-client", "machine-client", "Machine", null,
+            List.of(), new Scope("openid"), first);
+        service.validateResourceAccessToken(access.getValue(), first);
+        assertThrows(OidcException.class, () -> service.validateResourceAccessToken(access.getValue(), second));
+        final var refresh = service.issueRefreshToken("machine-client", "machine-client", new Scope("openid"), first);
+        service.validateResourceRefreshToken(refresh.getValue(), "machine-client", first);
+        assertThrows(OidcException.class, () -> service.validateResourceRefreshToken(refresh.getValue(), "machine-client", second));
+        assertThrows(OidcException.class, () -> service.validateResourceRefreshToken(refresh.getValue(), "machine-client", null));
+        final var idToken = service.issueIdToken("machine-client", "machine-client", "Machine", null, List.of(), "nonce");
+        assertThrows(OidcException.class, () -> service.validateResourceAccessToken(idToken.serialize(), first));
+    }
+
+    @Test
+    void issuesAndValidatesAccessToken() {
+        final var access = service.issueAccessToken("machine-client", "machine-client",
+            "machine-client", null, List.of(), new Scope("openid"));
+        final JWTClaimsSet claims = service.validateAccessToken(access.getValue());
+        assertEquals("machine-client", claims.getSubject());
+        assertEquals(ISSUER, claims.getIssuer());
+        assertEquals(List.of("machine-client"), claims.getAudience());
+    }
+
+    @Test
+    void revokedAccessTokenRejected() {
+        final var access = service.issueAccessToken("machine-client", "machine-client",
+            "machine-client", null, List.of(), new Scope("openid"));
+        service.revoke(access.getValue());
+        assertThrows(OidcException.class, () -> service.validateAccessToken(access.getValue()));
+    }
+
+    @Test
+    void algNoneTokenRejectedBeforeAnyVerification() {
+        // B2: hand-crafted alg=none token (attack payload, not buildable via the SDK — nimbus 10
+        // itself refuses JWSHeader alg=none). Must die on the algorithm check, before key lookup.
+        final java.util.Base64.Encoder b64 = java.util.Base64.getUrlEncoder().withoutPadding();
+        final String header = b64.encodeToString("{\"alg\":\"none\"}".getBytes(java.nio.charset.StandardCharsets.UTF_8));
+        final String payload = b64.encodeToString("{\"sub\":\"forged\"}".getBytes(java.nio.charset.StandardCharsets.UTF_8));
+        final String serialized = header + "." + payload + ".";
+        assertThrows(OidcException.class, () -> service.validateAccessToken(serialized));
+    }
+
+    @Test
+    void garbageTokenRejected() {
+        assertThrows(OidcException.class, () -> service.validateAccessToken("not-a-jwt"));
+    }
+
+    @Test
+    void refreshTokensRotateAndBindToClient() {
+        final RefreshToken first = service.issueRefreshToken("machine-client", "machine-client", new Scope("openid"));
+        assertNotNull(first.getValue());
+
+        final var stored = service.validateRefreshToken(first.getValue(), "machine-client");
+        assertEquals("refresh", stored.tokenType());
+
+        service.revoke(stored.value());
+        assertThrows(OidcException.class, () -> service.validateRefreshToken(first.getValue(), "machine-client"),
+            "rotated (revoked) refresh token must no longer validate");
+
+        final RefreshToken second = service.issueRefreshToken("machine-client", "machine-client", new Scope("openid"));
+        assertThrows(OidcException.class, () -> service.validateRefreshToken(second.getValue(), "other-client"),
+            "refresh token bound to its client");
+    }
+
+    @Test
+    void accessTokensAreUniquePerIssuanceEvenInTheSameSecond() {
+        // Regression: refresh rotation within the same second used to mint a byte-identical
+        // access token (same claims + iat second) and die on oidc_token's UNIQUE(value).
+        final var first = service.issueAccessToken("machine-client", "machine-client",
+            "machine-client", null, List.of(), new Scope("openid"));
+        final var second = service.issueAccessToken("machine-client", "machine-client",
+            "machine-client", null, List.of(), new Scope("openid"));
+        assertNotEquals(first.getValue(), second.getValue(), "jti must make every access token unique");
+    }
