@@ -0,0 +1,40 @@
+package io.kestra.webserver.oidc;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Duration;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.modelcontextprotocol.client.McpClient;
+import io.modelcontextprotocol.client.transport.HttpClientStreamableHttpTransport;
+import io.modelcontextprotocol.json.jackson3.JacksonMcpJsonMapper;
+import tools.jackson.databind.json.JsonMapper;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class McpSdkInstanceTest {
+    @Test
+    void shouldInitializeAndListThroughRealSdkTransport() throws Exception {
+        final String instanceUrl = System.getenv("MCP_INSTANCE_URL");
+        final String tokenFile = System.getenv("MCP_TOKEN_FILE");
+        assumeTrue(instanceUrl != null && !instanceUrl.isBlank(), "Manual acceptance requires a running MCP instance via MCP_INSTANCE_URL");
+        assumeTrue(tokenFile != null && !tokenFile.isBlank() && Files.isRegularFile(Path.of(tokenFile)),
+            "Manual acceptance requires a locally obtained resource-bound token file via MCP_TOKEN_FILE");
+        final String token = new ObjectMapper().readTree(Files.readString(
+            Path.of(tokenFile))).get("access_token").asText();
+        final var transport = HttpClientStreamableHttpTransport.builder(instanceUrl)
+            .endpoint("/api/v1/main/mcp/default")
+            .customizeRequest(builder -> builder.header("Authorization", "Bearer " + token))
+            .jsonMapper(new JacksonMcpJsonMapper(JsonMapper.builder().build())).build();
+        final var client = McpClient.sync(transport).requestTimeout(Duration.ofSeconds(15)).build();
+        try {
+            assertNotNull(client.initialize().protocolVersion());
+            assertNotNull(client.listTools().tools());
+        } finally {
+            client.closeGracefully();
+        }
+    }
+}
