+package io.kestra.webserver.oidc;
+
+import java.util.List;
+import java.util.Map;
+import io.kestra.mcp.DefaultMcpToolAccessControl;
+import io.kestra.mcp.McpSessionFactory;
+import io.kestra.webserver.mcp.McpAuthenticationFetcher;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.security.authentication.Authentication;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+class McpIdentityPropagationTest {
+    @Test
+    void shouldPropagateVerifiedSubjectClientResourceAndScopes() {
+        final var request = HttpRequest.POST("/api/v1/main/mcp/first", "{}");
+        final var authentication = Authentication.build("alice", Map.of("client_id", "client-a"));
+        request.setAttribute("io.kestra.mcp.authentication", authentication);
+        assertEquals("alice", new DefaultMcpToolAccessControl().callerId(request).orElseThrow());
+        assertSame(authentication, Mono.from(new McpAuthenticationFetcher().fetchAuthentication(request)).block());
+        final var factory = new McpSessionFactory();
+        final var alice = factory.build("main", "first", "session", "alice", "client-a", "https://example.org/first", List.of("mcp:flows:read"));
+        final var bob = factory.build("main", "first", "session", "bob", "client-b", "https://example.org/first", List.of("mcp:flows:read"));
+        assertNotEquals(alice, bob);
+        assertEquals("alice", alice.get("userId"));
+        assertEquals("client-a", alice.get("clientId"));
+        assertEquals(List.of("mcp:flows:read"), alice.get("scopes"));
+    }
+}
diff --git a/webserver/src/test/java/io/kestra/webserver/oidc/McpResourceUrlTest.java b/webserver/src/test/java/io/kestra/webserver/oidc/McpResourceUrlTest.java
new file mode 100644
index 0000000..b5d6bf6
--- /dev/null
+++ b/webserver/src/test/java/io/kestra/webserver/oidc/McpResourceUrlTest.java
@@ -0,0 +1,51 @@
+package io.kestra.webserver.oidc;
+
+import io.kestra.webserver.mcp.McpResourceUrl;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class McpResourceUrlTest {
+    @Test
+    @SuppressWarnings("unchecked")
+    void shouldAcceptOnlyExistingCanonicalResource() {
+        final var provider = org.mockito.Mockito.mock(io.micronaut.context.BeanProvider.class);
+        final var repository = org.mockito.Mockito.mock(io.kestra.core.mcp.repositories.McpServerRepositoryInterface.class);
+        final var queue = org.mockito.Mockito.mock(io.kestra.core.queues.BroadcastQueueInterface.class);
+        final var cache = new io.kestra.mcp.McpServerCache(repository, queue, new io.kestra.mcp.McpConfig(null,
+            new io.kestra.mcp.McpConfig.ServerCacheConfig(10L, java.time.Duration.ofMinutes(5)), java.time.Duration.ofMinutes(5)));
+        org.mockito.Mockito.when(provider.get()).thenReturn(cache);
+        org.mockito.Mockito.when(repository.get("main", "first")).thenReturn(java.util.Optional.of(
+            org.mockito.Mockito.mock(io.kestra.core.mcp.models.McpServer.class)));
+        org.mockito.Mockito.when(repository.get("main", "second")).thenReturn(java.util.Optional.of(
+            org.mockito.Mockito.mock(io.kestra.core.mcp.models.McpServer.class)));
+        final var resources = new McpResourceUrl("https://example.org/prefix", provider);
+        assertEquals(resources.resource("main", "first"), resources.parseExact("https://example.org/prefix/api/v1/main/mcp/first"));
+        assertEquals(resources.resource("main", "second"), resources.parseExact("https://example.org/prefix/api/v1/main/mcp/second"));
+        assertEquals("https://example.org/.well-known/oauth-protected-resource/prefix/api/v1/main/mcp/first",
+            resources.metadata("main", "first").toString());
+        assertEquals(resources.resource("main", "first"), resources.fromMetadataPath("prefix/api/v1/main/mcp/first"));
+        for (final String invalid : java.util.List.of("https:opaque", "https://example.org/prefix/api/v1/main/mcp/missing",
+            "https://example.org/prefix/api/v1/other/mcp/first", "http://example.org/prefix/api/v1/main/mcp/first",
+            "https://evil.org/prefix/api/v1/main/mcp/first", "https://example.org/prefix/api/v1/main/mcp/first%2Fother",
+            "https://example.org/prefix/api/v1/main/mcp/../first", "https://example.org/prefix/api/v1/main/mcp/first?query")) {
+            assertThrows(IllegalArgumentException.class, () -> resources.parseExact(invalid));
+        }
+        assertThrows(IllegalArgumentException.class, () -> resources.parseExact(null));
+    }
+    @Test
+    void shouldSeparateServersAndPreserveDeploymentPrefix() {
+        final var resources = new McpResourceUrl("https://kestra.example.org/prefix/", null);
+        assertEquals("https://kestra.example.org/prefix/api/v1/main/mcp/first", resources.resource("main", "first").toString());
+        assertNotEquals(resources.resource("main", "first"), resources.resource("main", "second"));
+    }
+
+    @Test
+    void shouldRejectUntrustedOrAmbiguousBaseUrls() {
+        for (final String base : java.util.List.of("", "/relative", "https://example.org?query", "https://example.org#fragment", "https://user@example.org", "file:///tmp")) {
+            assertThrows(IllegalArgumentException.class, () -> new McpResourceUrl(base, null));
+        }
+        assertThrows(IllegalArgumentException.class, () -> new McpResourceUrl("https://example.org", null).resource("main", "../other"));
+    }
+}
