+package io.kestra.webserver.oidc;
+
+import java.util.List;
+import java.util.Optional;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class ApplicationGroupProtocolProjectionV2Test {
+    @Test void micronautDiscoversOneV2ProviderThroughTheExistingV1Slot() {
+        try(var context=io.micronaut.context.ApplicationContext.run(java.util.Map.of("oidc.resource.projection.discovery.test",true))) {
+            var providers=context.getBean(Consumer.class).providers();
+            assertTrue(providers.isPresent());assertTrue(providers.isUnique());
+            assertInstanceOf(ApplicationGroupProtocolProjectionV2.class,providers.get());
+            assertSame(context.getBean(ApplicationGroupProtocolProjectionV2.class),providers.get());
+        }
+    }
+
+    private static ApplicationGroupProtocolProjectionV2.Projection projection(Set<String> resources) {
+        return new ApplicationGroupProtocolProjectionV2.Projection("group","main","https://issuer.example","client","subject",true,true,
+            1,1,resources,List.of(new ApplicationGroupProtocolProjectionV1.Scope("read","Reader","")),Set.of("read"),Set.of("read"));
+    }
+
+    @Test void approvedV2AllowsEmptyResourcesWithoutInventingClientAudience() {
+        var projection=projection(Set.of());assertEquals(Set.of(),projection.resourceAudiences());
+        assertEquals(Set.of("read"),projection.eligibleScopeKeys(new ApplicationGroupProtocolProjectionV1.Request("https://issuer.example","main","client","subject",null)));
+        assertThrows(UnsupportedOperationException.class,()->projection.resourceAudiences().add("client"));
+    }
+
+    @Test void v1StillRejectsEmptyApprovedAudienceAndV2CannotBeReadAsV1() {
+        assertThrows(IllegalArgumentException.class,()->new ApplicationGroupProtocolProjectionV1.Projection("group","main","https://issuer.example","client","subject",true,true,
+            1,1,Set.of(),List.of(),Set.of(),Set.of()));
+        ApplicationGroupProtocolProjectionV2 provider=(connection,request)->new ApplicationGroupProtocolProjectionV2.Result(2,true,Optional.of(projection(Set.of())));
+        assertThrows(java.sql.SQLException.class,()->provider.current(null,new ApplicationGroupProtocolProjectionV1.Request("https://issuer.example","main","client","subject",null)));
+    }
+
+    @Test void resourceValuesRemainExactAndRejectBlankControlAndWildcard() {
+        for(String invalid:List.of(""," "," resource","resource ","resource\n","https://example/*"))
+            assertThrows(IllegalArgumentException.class,()->projection(Set.of(invalid)));
+        assertEquals(Set.of("https://example/resource"),projection(Set.of("https://example/resource")).resourceAudiences());
+    }
+
+    @Test void wrongVersionTargetAndInactiveResultCannotSupplyIdentity() {
+        assertThrows(IllegalArgumentException.class,()->new ApplicationGroupProtocolProjectionV2.Result(1,true,Optional.of(projection(Set.of()))));
+        assertThrows(IllegalArgumentException.class,()->new ApplicationGroupProtocolProjectionV2.Result(2,false,Optional.of(projection(Set.of()))));
+        assertThrows(IllegalArgumentException.class,()->projection(Set.of()).eligibleScopeKeys(
+            new ApplicationGroupProtocolProjectionV1.Request("https://issuer.example","main","other","subject",null)));
+    }
+
+    @io.micronaut.context.annotation.Factory
+    @io.micronaut.context.annotation.Requires(property="oidc.resource.projection.discovery.test",value="true")
+    static class Beans {
+        @jakarta.inject.Singleton Consumer consumer(io.micronaut.context.BeanProvider<ApplicationGroupProtocolProjectionV1> providers) {
