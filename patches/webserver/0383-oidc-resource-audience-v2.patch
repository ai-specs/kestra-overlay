@@ -0,0 +1,45 @@
+package io.kestra.webserver.oidc.services;
+
+import io.kestra.webserver.oidc.ApplicationGroupProtocolProjectionV1;
+import io.kestra.webserver.oidc.ApplicationGroupProtocolProjectionV2;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+
+final class OidcApplicationGroupProjection {
+    static final String AUDIENCE_VERSION = "audience_contract_version";
+
+    private OidcApplicationGroupProjection() {}
+
+    record State(int contractVersion, boolean activated, Optional<ApplicationGroupProtocolProjectionV2.Projection> projection) {}
+
+    static State current(ApplicationGroupProtocolProjectionV1 provider, Connection connection,
+                         ApplicationGroupProtocolProjectionV1.Request request) throws SQLException {
+        if (provider instanceof ApplicationGroupProtocolProjectionV2 resources) {
+            var result = resources.currentResources(connection, request);
+            if (result == null || result.contractVersion() != 2) throw new SQLException("Invalid resource projection");
+            return new State(2, result.activated(), result.projection());
+        }
+        var result = provider.current(connection, request);
+        if (result == null || result.contractVersion() != 1) throw new SQLException("Invalid protocol projection");
+        return new State(1, result.activated(), result.projection().map(value -> new ApplicationGroupProtocolProjectionV2.Projection(
+            value.applicationGroupId(), value.tenant(), value.issuer(), value.clientId(), value.subject(), value.active(),
+            value.approved(), value.revision(), value.authorizationVersion(), value.audiences(), value.scopes(),
+            value.supportedScopeKeys(), value.grantedScopeKeys())));
+    }
+
+    static void requireVersion(Map<?, ?> claim, int version) {
+        Object marker = claim.get(AUDIENCE_VERSION);
+        if (version == 1 ? marker != null : !(marker instanceof Number) || !"2".equals(marker.toString()))
+            throw new IllegalStateException("Audience contract changed; authenticate again");
+    }
+
+    static boolean audienceAllowed(ApplicationGroupProtocolProjectionV2.Projection projection, int version,
+                                   String clientId, String resource, Set<String> audiences) {
+        if (version == 1) return !audiences.isEmpty() && projection.resourceAudiences().containsAll(audiences);
+        return audiences.equals(Set.of(resource == null ? clientId : resource))
+            && (resource == null || projection.resourceAudiences().contains(resource));
+    }
+}
