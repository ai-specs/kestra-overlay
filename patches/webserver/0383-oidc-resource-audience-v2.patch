+package io.kestra.webserver.oidc;
+
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.Set;
+
+public interface ApplicationGroupProtocolProjectionV2 extends ApplicationGroupProtocolProjectionV1 {
+    int CONTRACT_VERSION = 2;
+
+    Result currentResources(Connection connection, Request request) throws SQLException;
+
+    @Override
+    default ApplicationGroupProtocolProjectionV1.Result current(Connection connection, Request request) throws SQLException {
+        throw new SQLException("Resource projection requires contract V2");
+    }
+
+    record Projection(String applicationGroupId, String tenant, String issuer, String clientId, String subject,
+                      boolean active, boolean approved, long revision, long authorizationVersion,
+                      Set<String> resourceAudiences, List<Scope> scopes, Set<String> supportedScopeKeys,
+                      Set<String> grantedScopeKeys) {
+        public Projection {
+            if (applicationGroupId == null || !applicationGroupId.matches("[A-Za-z0-9][A-Za-z0-9_-]{0,127}"))
+                throw new IllegalArgumentException("Invalid group id");
+            OidcProtocolValues.opaque(tenant); OidcProtocolValues.issuer(issuer);
+            OidcProtocolValues.opaque(clientId); OidcProtocolValues.opaque(subject);
+            if (revision <= 0 || authorizationVersion <= 0) throw new IllegalArgumentException("Invalid group versions");
+            resourceAudiences = Set.copyOf(resourceAudiences); scopes = List.copyOf(scopes);
+            supportedScopeKeys = Set.copyOf(supportedScopeKeys); grantedScopeKeys = Set.copyOf(grantedScopeKeys);
+            resourceAudiences.forEach(OidcProtocolValues::opaque);
+            if (resourceAudiences.stream().anyMatch(value -> value.contains("*")))
+                throw new IllegalArgumentException("Exact resource audiences required");
+            var keys = new HashSet<String>(); var names = new HashSet<String>();
+            for (var scope : scopes) if (!keys.add(scope.key()) || !names.add(scope.name()))
+                throw new IllegalArgumentException("Duplicate scope key or name");
+            if (!keys.containsAll(supportedScopeKeys) || !keys.containsAll(grantedScopeKeys))
+                throw new IllegalArgumentException("Undefined scope reference");
+        }
+
+        public Set<String> eligibleScopeKeys(Request request) {
+            if (!issuer.equals(request.issuer()) || !tenant.equals(request.tenant()) || !clientId.equals(request.clientId())
+                || !subject.equals(request.subject()) || request.expectedApplicationGroupId() != null
+                && !applicationGroupId.equals(request.expectedApplicationGroupId()))
+                throw new IllegalArgumentException("Protocol projection target mismatch");
+            if (!active || !approved) return Set.of();
+            var eligible = new HashSet<>(supportedScopeKeys); eligible.retainAll(grantedScopeKeys);
+            return Set.copyOf(eligible);
+        }
+    }
+
+    record Result(int contractVersion, boolean activated, Optional<Projection> projection) {
+        public Result {
+            Objects.requireNonNull(projection);
+            if (contractVersion != CONTRACT_VERSION || !activated && projection.isPresent())
+                throw new IllegalArgumentException("Invalid resource projection state");
+        }
+    }
+}
