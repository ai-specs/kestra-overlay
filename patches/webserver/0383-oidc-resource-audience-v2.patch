+            return (connection,request)->new ApplicationGroupProtocolProjectionV2.Result(2,false,Optional.empty());
+        }
+    }
+
+    record Consumer(io.micronaut.context.BeanProvider<ApplicationGroupProtocolProjectionV1> providers) {}
+}
