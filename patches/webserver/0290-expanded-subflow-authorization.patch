+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import java.util.Optional;
+import io.kestra.core.exceptions.ForbiddenException;
+import io.kestra.core.models.AccessScope;
+import io.kestra.core.models.executions.Execution;
+import io.kestra.core.models.flows.FlowWithSource;
+import io.kestra.core.models.hierarchies.SubflowGraphTask;
+import io.kestra.core.repositories.FlowRepositoryInterface;
+import io.kestra.core.repositories.NamespaceAccessControl;
+import io.kestra.core.services.FlowParsingService;
+import io.kestra.core.services.GraphService;
+import io.kestra.plugin.core.flow.Subflow;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class ExpandedSubflowAuthorizationTest {
+    @Test
+    void shouldAuthorizeActualExpandedOwnerBeforeExecutionGraphAclBypass() throws Exception {
+        var service = new GraphService();
+        var flows = mock(FlowRepositoryInterface.class);
+        var parser = mock(FlowParsingService.class);
+        when(parser.parse(any(FlowWithSource.class), eq(false))).thenAnswer(invocation -> invocation.getArgument(0));
+        var parent = FlowWithSource.builder().tenantId("main").namespace("team").id("parent").revision(1)
+            .tasks(List.of(Subflow.builder().id("child").type("io.kestra.plugin.core.flow.Subflow").namespace("other").flowId("target").build()))
+            .build();
+        var child = FlowWithSource.builder().tenantId("main").namespace("other").id("target").revision(1).tasks(List.of()).build();
+        set(service, "flowRepository", flows);
+        set(service, "flowParsingService", parser);
+        set(service, "namespaceAccessControl", (NamespaceAccessControl) resource -> AccessScope.namespaces(List.of(), List.of("team")));
+        var execution = Execution.builder().tenantId("main").namespace("team").flowId("parent").id("execution").build();
+        var graph = service.flowGraph(parent, List.of(), execution);
+        String selected = graph.getNodes().stream().filter(node -> node instanceof SubflowGraphTask).findFirst().orElseThrow().getUid();
+        assertThatThrownBy(() -> service.flowGraph(parent, List.of(selected), execution)).isInstanceOf(ForbiddenException.class);
+        verifyNoInteractions(flows);
+        set(service, "namespaceAccessControl", (NamespaceAccessControl) resource -> AccessScope.namespaces(List.of(), List.of("team", "other")));
+        when(flows.findByIdWithSourceWithoutAcl("main", "other", "target", Optional.empty())).thenReturn(Optional.of(child));
+        assertThatCode(() -> service.flowGraph(parent, List.of(selected), execution)).doesNotThrowAnyException();
+        verify(flows).findByIdWithSourceWithoutAcl("main", "other", "target", Optional.empty());
+    }
+
+    private void set(GraphService service, String fieldName, Object value) throws Exception {
+        var field = GraphService.class.getDeclaredField(fieldName);
+        field.setAccessible(true);
+        field.set(service, value);
+    }
+}
