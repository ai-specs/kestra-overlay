@@ -0,0 +1,117 @@
+package io.kestra.webserver.oidc;
+
+import static org.assertj.core.api.Assertions.*;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.Set;
+
+class ApplicationGroupScopeIssuanceTest {
+    private final Set<String> protocols =
+            Set.of(
+                    "openid",
+                    "profile",
+                    "email",
+                    "mcp:flows:read",
+                    ApplicationGroupScopeIssuance.UI_SELECTOR);
+
+    @Test
+    void shouldExpandOnlyConfiguredLoginClientIntersectionWithoutGrantingSelector() {
+        var result =
+                ApplicationGroupScopeIssuance.resolve(
+                        Set.of("openid", ApplicationGroupScopeIssuance.UI_SELECTOR),
+                        protocols,
+                        Set.of("A", "B", "C"),
+                        Set.of("A", "B"),
+                        Set.of("A", "C"),
+                        Set.of("openid", "A"),
+                        true,
+                        true);
+        assertThat(result.applicationGroupScopes()).containsExactly("A");
+        assertThat(result.protocolScopes())
+                .containsExactlyInAnyOrder("openid", ApplicationGroupScopeIssuance.UI_SELECTOR);
+    }
+
+    @Test
+    void shouldAllowProtocolLoginWithNoUiAssignments() {
+        var result =
+                ApplicationGroupScopeIssuance.resolve(
+                        Set.of("openid", ApplicationGroupScopeIssuance.UI_SELECTOR),
+                        protocols,
+                        Set.of("A"),
+                        Set.of("A"),
+                        Set.of(),
+                        Set.of("openid"),
+                        true,
+                        true);
+        assertThat(result.applicationGroupScopes()).isEmpty();
+        assertThat(result.protocolScopes()).contains("openid");
+    }
+
+    @Test
+    void shouldRejectDcrSelectorAndUngrantableExplicitScopes() {
+        assertThatThrownBy(
+                        () ->
+                                ApplicationGroupScopeIssuance.resolve(
+                                        Set.of(ApplicationGroupScopeIssuance.UI_SELECTOR),
+                                        protocols,
+                                        Set.of("A"),
+                                        Set.of("A"),
+                                        Set.of("A"),
+                                        Set.of("A"),
+                                        false,
+                                        true))
+                .isInstanceOf(ApplicationGroupScopeIssuance.InvalidScopeException.class);
+        assertThatThrownBy(
+                        () ->
+                                ApplicationGroupScopeIssuance.resolve(
+                                        Set.of("A"),
+                                        protocols,
+                                        Set.of("A"),
+                                        Set.of("A"),
+                                        Set.of(),
+                                        Set.of("A"),
+                                        false,
+                                        true))
+                .isInstanceOf(ApplicationGroupScopeIssuance.InvalidScopeException.class);
+        assertThatThrownBy(
+                        () ->
+                                ApplicationGroupScopeIssuance.resolve(
+                                        Set.of("mcp:unknown"),
+                                        protocols,
+                                        Set.of(),
+                                        Set.of(),
+                                        Set.of(),
+                                        Set.of(),
+                                        false,
+                                        true))
+                .isInstanceOf(ApplicationGroupScopeIssuance.InvalidScopeException.class);
+    }
+
+    @Test
+    void shouldNarrowConsentAndRejectExplicitScopesForDisabledProject() {
+        var result =
+                ApplicationGroupScopeIssuance.resolve(
+                        Set.of("A", "B"),
+                        protocols,
+                        Set.of("A", "B"),
+                        Set.of("A", "B"),
+                        Set.of("A", "B"),
+                        Set.of("A"),
+                        false,
+                        true);
+        assertThat(result.applicationGroupScopes()).containsExactly("A");
+        assertThatThrownBy(
+                        () ->
+                                ApplicationGroupScopeIssuance.resolve(
+                                        Set.of("A"),
+                                        protocols,
+                                        Set.of("A"),
+                                        Set.of("A"),
+                                        Set.of("A"),
+                                        Set.of("A"),
+                                        false,
+                                        false))
+                .isInstanceOf(ApplicationGroupScopeIssuance.InvalidScopeException.class);
+    }
+}
