+package io.kestra.webserver.oidc;
+
+import java.util.HashSet;
+import java.util.Set;
+
+public final class ApplicationGroupScopeIssuance {
+    public static final String UI_SELECTOR = "kestra:application-group-scopes";
+
+    private ApplicationGroupScopeIssuance() {}
+
+    public record Result(Set<String> protocolScopes, Set<String> applicationGroupScopes) {
+        public Result {
+            protocolScopes = Set.copyOf(protocolScopes);
+            applicationGroupScopes = Set.copyOf(applicationGroupScopes);
+        }
+    }
+
+    public static Result resolve(
+            Set<String> requested,
+            Set<String> registeredProtocolScopes,
+            Set<String> definedScopeKeys,
+            Set<String> supportedScopeKeys,
+            Set<String> grantedScopeKeys,
+            Set<String> consentedScopes,
+            boolean configuredLoginClient,
+            boolean applicationGroupActive) {
+        requested = Set.copyOf(requested);
+        registeredProtocolScopes = Set.copyOf(registeredProtocolScopes);
+        definedScopeKeys = Set.copyOf(definedScopeKeys);
+        supportedScopeKeys = Set.copyOf(supportedScopeKeys);
+        grantedScopeKeys = Set.copyOf(grantedScopeKeys);
+        consentedScopes = Set.copyOf(consentedScopes);
+        var protocols = new HashSet<String>();
+        var applicationGroups = new HashSet<String>();
+        var eligible = new HashSet<>(definedScopeKeys);
+        eligible.retainAll(supportedScopeKeys);
+        eligible.retainAll(grantedScopeKeys);
+        if (!applicationGroupActive) eligible.clear();
+        for (String scope : requested) {
+            if (UI_SELECTOR.equals(scope)) {
+                if (!configuredLoginClient || !registeredProtocolScopes.contains(UI_SELECTOR)) {
+                    throw new InvalidScopeException();
+                }
+                protocols.add(scope);
+                applicationGroups.addAll(eligible);
+            } else if (registeredProtocolScopes.contains(scope)) {
+                protocols.add(scope);
+            } else if (eligible.contains(scope)) {
+                applicationGroups.add(scope);
+            } else {
+                throw new InvalidScopeException();
+            }
+        }
+        applicationGroups.retainAll(consentedScopes);
+        var retainedProtocols = new HashSet<>(consentedScopes);
+        if (requested.contains(UI_SELECTOR)) retainedProtocols.add(UI_SELECTOR);
+        protocols.retainAll(retainedProtocols);
+        return new Result(protocols, applicationGroups);
+    }
+
+    public static final class InvalidScopeException extends RuntimeException {
+        public InvalidScopeException() {
+            super("invalid_scope");
+        }
+    }
+}
diff --git a/webserver/src/test/java/io/kestra/webserver/oidc/ApplicationGroupScopeIssuanceTest.java b/webserver/src/test/java/io/kestra/webserver/oidc/ApplicationGroupScopeIssuanceTest.java
