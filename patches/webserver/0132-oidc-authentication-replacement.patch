@@ -0,0 +1,36 @@
+package io.kestra.webserver.oidc.services;
+
+/** Browser theme bridge for standalone authentication pages. No identity or configuration is read. */
+public final class OidcPageTheme {
+    private OidcPageTheme() {}
+
+    /** Palette subset follows the pinned UI design system; keep its semantic token names. */
+    public static String head() {
+        return """
+            <style>
+            :root{color-scheme:light;--ks-bg-base:#f7f7f8;--ks-bg-input:#ffffff;--ks-text-primary:#08090a;--ks-text-secondary:#5f5f7c;--ks-text-error:#ed0011;--ks-border-default:#e9e9ee;--ks-border-focus:#631bf3;--ks-btn-primary-bg-default:#631bf3;--ks-btn-primary-bg-hover:#7738f5;--ks-btn-primary-bg-active:#5212d6;--ks-btn-primary-text:#ffffff}
+            html.dark{color-scheme:dark;--ks-bg-base:#14181f;--ks-bg-input:#14181f;--ks-text-primary:#ffffff;--ks-text-secondary:#cfd3d6;--ks-text-error:#ffacac;--ks-border-default:#2c303f}
+            html.dark-2{--ks-bg-base:#111115;--ks-bg-input:#111115;--ks-text-secondary:#adadbf;--ks-border-default:#2e2e3c;--ks-border-focus:#9869f7}
+            @media(prefers-color-scheme:dark){html:not(.light):not(.dark){color-scheme:dark;--ks-bg-base:#14181f;--ks-bg-input:#14181f;--ks-text-primary:#ffffff;--ks-text-secondary:#cfd3d6;--ks-text-error:#ffacac;--ks-border-default:#2c303f}}
+            </style>
+            <script>
+            (() => {
+                const root = document.documentElement;
+                const system = window.matchMedia('(prefers-color-scheme: dark)');
+                function apply() {
+                    let theme;
+                    try { theme = localStorage.getItem('theme'); } catch (_) { /* Storage can be unavailable. */ }
+                    if (!['light', 'dark', 'dark-2', 'syncWithSystem'].includes(theme)) theme = 'syncWithSystem';
+                    root.classList.remove('light', 'dark', 'dark-2', 'syncWithSystem');
+                    if (theme === 'syncWithSystem') root.classList.add(theme, system.matches ? 'dark' : 'light');
+                    else if (theme === 'dark-2') root.classList.add('dark', 'dark-2');
+                    else root.classList.add(theme);
+                }
+                apply();
+                system.addEventListener('change', apply);
+                window.addEventListener('storage', event => { if (event.key === 'theme' || event.key === null) apply(); });
+            })();
+            </script>
+            """;
+    }
+}
