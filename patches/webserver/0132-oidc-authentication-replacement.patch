+package io.kestra.webserver.oidc;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+import io.kestra.webserver.oidc.controllers.OidcLegacyAuthFilter;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpStatus;
+import org.junit.jupiter.api.Test;
+
+class OidcLegacyAuthFilterTest {
+    private final OidcLegacyAuthFilter filter = new OidcLegacyAuthFilter();
+
+    @Test
+    void rejectsLegacyAuthenticationEndpointsIncludingEncodedPath() {
+        for (final String path : new String[]{"/api/v1/login", "/api/v1/logout", "/api/v1/basicAuth",
+            "/api/v1/main/basicAuth", "/api/v1/basicAuthValidationErrors", "/api/v1/%6cogin"}) {
+            assertEquals(HttpStatus.NOT_FOUND, filter.filter(HttpRequest.GET(path)).getStatus());
+        }
+    }
+
+    @Test
+    void leavesApplicationEndpointsToOidcSecurity() {
+        assertNull(filter.filter(HttpRequest.GET("/api/v1/configs")));
+    }
+}
