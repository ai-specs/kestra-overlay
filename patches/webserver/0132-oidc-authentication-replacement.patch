@@ -0,0 +1,34 @@
+import * as VanillaAuth from "./basicAuth"
+
+let oidcEnabled = false
+let authenticated = false
+
+export function configureOidc(enabled: boolean) {
+    oidcEnabled = enabled
+}
+
+export function isOidc() {
+    return oidcEnabled
+}
+
+export function setAuthenticated(value: boolean) {
+    authenticated = value
+}
+
+export function isLoggedIn() {
+    return oidcEnabled ? authenticated : VanillaAuth.isLoggedIn()
+}
+
+export function login() {
+    authenticated = false
+    window.location.assign("/oauth/login/kestra")
+}
+
+export async function logout() {
+    authenticated = false
+    if (oidcEnabled) {
+        window.location.assign("/oidc/logout")
+        return true
+    }
+    return VanillaAuth.logout()
+}
