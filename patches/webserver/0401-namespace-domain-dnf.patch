@@ -0,0 +1,35 @@
+package io.kestra.jdbc.repository;
+
+import io.kestra.core.models.NamespaceDomain;
+import java.util.ArrayList;
+import org.jooq.Condition;
+import org.jooq.Field;
+import org.jooq.impl.DSL;
+
+public final class NamespaceDomainCondition {
+    private NamespaceDomainCondition() {}
+
+    public static Condition compile(NamespaceDomain domain, Field<String> namespace, Field<String> resourceId) {
+        var terms = new ArrayList<Condition>();
+        for (var term : domain.terms()) {
+            if (term.universe() != NamespaceDomain.Universe.NAMESPACE
+                || resourceId == null && term.idScope() == NamespaceDomain.IdScope.RESTRICTED_IDS)
+                return DSL.falseCondition();
+            var includes = new ArrayList<Condition>();
+            for (var exact : term.exactNamespaces()) includes.add(namespace.eq(exact));
+            for (var root : term.namespaceSubtrees()) includes.add(subtree(namespace, root));
+            Condition condition = term.allNamespaces()
+                ? namespace.likeRegex("^[A-Za-z0-9_-]+([.][A-Za-z0-9_-]+)*$") : DSL.or(includes);
+            for (var exact : term.excludedNamespaces()) condition = condition.and(namespace.ne(exact));
+            for (var root : term.excludedSubtrees()) condition = condition.and(subtree(namespace, root).not());
+            if (term.idScope() == NamespaceDomain.IdScope.RESTRICTED_IDS)
+                condition = condition.and(resourceId.in(term.resourceIds()));
+            terms.add(condition);
+        }
+        return DSL.or(terms);
+    }
+
+    private static Condition subtree(Field<String> namespace, String root) {
+        return namespace.eq(root).or(namespace.startsWith(root + "."));
+    }
+}
