+package io.kestra.core.models;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.stream.Stream;
+
+public record NamespaceDomain(List<Term> terms) {
+    public static final int VERSION = 2;
+    public static final int MAX_TERMS = 256;
+    public static final int MAX_SELECTORS = 128;
+    public static final int MAX_IDS = 256;
+    public static final int MAX_PAIRS = 4096;
+
+    public enum Universe { NAMESPACE, TENANT }
+    public enum IdScope { ALL_IDS, RESTRICTED_IDS }
+
+    public NamespaceDomain {
+        Objects.requireNonNull(terms);
+        if (terms.size() > MAX_TERMS) throw new IllegalArgumentException("Too many domain terms");
+        terms = terms.stream().filter(term -> !term.empty()).distinct().toList();
+    }
+
+    public record Term(Universe universe, boolean allNamespaces, List<String> exactNamespaces,
+        List<String> namespaceSubtrees, List<String> excludedNamespaces, List<String> excludedSubtrees,
+        IdScope idScope, List<String> resourceIds) {
+        public Term {
+            Objects.requireNonNull(universe);
+            Objects.requireNonNull(idScope);
+            exactNamespaces = names(exactNamespaces);
+            namespaceSubtrees = names(namespaceSubtrees);
+            excludedNamespaces = names(excludedNamespaces);
+            excludedSubtrees = names(excludedSubtrees);
+            if (exactNamespaces.size() + namespaceSubtrees.size() > MAX_SELECTORS
+                || excludedNamespaces.size() + excludedSubtrees.size() > MAX_SELECTORS)
+                throw new IllegalArgumentException("Too many namespace selectors");
+            Objects.requireNonNull(resourceIds);
+            if (resourceIds.size() > MAX_IDS || resourceIds.stream().anyMatch(value -> value == null || value.isBlank()
+                || !value.equals(value.trim()) || value.chars().anyMatch(Character::isISOControl)))
+                throw new IllegalArgumentException("Invalid ID selectors");
+            resourceIds = resourceIds.stream().distinct().toList();
+            if (idScope == IdScope.ALL_IDS && !resourceIds.isEmpty()) throw new IllegalArgumentException("ALL_IDS has selectors");
+            if (universe == Universe.TENANT && (allNamespaces || !exactNamespaces.isEmpty() || !namespaceSubtrees.isEmpty()
+                || !excludedNamespaces.isEmpty() || !excludedSubtrees.isEmpty()))
+                throw new IllegalArgumentException("TENANT has namespace selectors");
+            if (allNamespaces && (!exactNamespaces.isEmpty() || !namespaceSubtrees.isEmpty()))
+                throw new IllegalArgumentException("GLOBAL has positive selectors");
+        }
+
+        public boolean namespaceAllowed(String namespace) {
+            return universe == Universe.TENANT ? namespace == null : namespace != null
+                && namespace.matches("[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*")
+                && !excludedNamespaces.contains(namespace) && excludedSubtrees.stream().noneMatch(root -> within(namespace, root))
+                && (allNamespaces || exactNamespaces.contains(namespace) || namespaceSubtrees.stream().anyMatch(root -> within(namespace, root)));
+        }
+
+        public boolean allows(String namespace, String resourceId) {
+            return namespaceAllowed(namespace) && (idScope == IdScope.ALL_IDS || resourceId != null && resourceIds.contains(resourceId));
+        }
+
+        public boolean empty() {
+            return idScope == IdScope.RESTRICTED_IDS && resourceIds.isEmpty()
+                || universe == Universe.NAMESPACE && !allNamespaces
+                    && exactNamespaces.stream().noneMatch(this::namespaceAllowed)
+                    && namespaceSubtrees.stream().allMatch(root -> excludedSubtrees.stream().anyMatch(excluded -> within(root, excluded)));
+        }
+
+        private Term intersect(Term other) {
+            if (universe != other.universe) return null;
+            var ids = idScope == IdScope.ALL_IDS ? other.resourceIds : other.idScope == IdScope.ALL_IDS ? resourceIds
+                : resourceIds.stream().filter(other.resourceIds::contains).toList();
+            var scope = idScope == IdScope.ALL_IDS && other.idScope == IdScope.ALL_IDS ? IdScope.ALL_IDS : IdScope.RESTRICTED_IDS;
+            if (universe == Universe.TENANT) return new Term(universe, false, List.of(), List.of(), List.of(), List.of(), scope, ids);
+            var exact = allNamespaces ? other.exactNamespaces : other.allNamespaces ? exactNamespaces
+                : union(exactNamespaces.stream().filter(other::included).toList(), other.exactNamespaces.stream().filter(this::included).toList());
+            var roots = allNamespaces ? other.namespaceSubtrees : other.allNamespaces ? namespaceSubtrees
+                : namespaceSubtrees.stream().flatMap(root -> other.namespaceSubtrees.stream()
+                    .map(otherRoot -> within(root, otherRoot) ? root : within(otherRoot, root) ? otherRoot : null))
+                    .filter(Objects::nonNull).distinct().toList();
+            return new Term(universe, allNamespaces && other.allNamespaces, exact, roots,
+                union(excludedNamespaces, other.excludedNamespaces), union(excludedSubtrees, other.excludedSubtrees), scope, ids);
+        }
+
+        private boolean included(String namespace) {
+            return allNamespaces || exactNamespaces.contains(namespace) || namespaceSubtrees.stream().anyMatch(root -> within(namespace, root));
+        }
+    }
+
+    public boolean allows(String namespace, String resourceId) {
+        return terms.stream().anyMatch(term -> term.allows(namespace, resourceId));
+    }
+
+    public boolean contains(String namespace) {
+        return terms.stream().anyMatch(term -> term.namespaceAllowed(namespace));
+    }
+
+    public NamespaceDomain union(NamespaceDomain other) {
+        return new NamespaceDomain(Stream.concat(terms.stream(), other.terms.stream()).toList());
+    }
+
+    public NamespaceDomain intersect(NamespaceDomain other) {
+        if ((long) terms.size() * other.terms.size() > MAX_PAIRS) throw new IllegalArgumentException("Domain intersection too complex");
+        var result = new ArrayList<Term>();
+        for (var left : terms) for (var right : other.terms) {
+            var term = left.intersect(right);
+            if (term != null && !term.empty() && !result.contains(term)) {
+                result.add(term);
+                if (result.size() > MAX_TERMS) throw new IllegalArgumentException("Too many intersection terms");
+            }
+        }
+        return new NamespaceDomain(result);
+    }
+
+    private static List<String> names(List<String> values) {
+        Objects.requireNonNull(values);
+        if (values.size() > MAX_SELECTORS || values.stream().anyMatch(value -> value == null || !value.matches("[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*")))
+            throw new IllegalArgumentException("Invalid namespace selectors");
+        return values.stream().distinct().toList();
+    }
+
+    private static List<String> union(List<String> left, List<String> right) {
+        return Stream.concat(left.stream(), right.stream()).distinct().toList();
+    }
+
+    private static boolean within(String namespace, String root) {
+        return namespace.equals(root) || namespace.startsWith(root + ".");
+    }
+}
