@@ -0,0 +1,133 @@
+import {afterEach, describe, expect, it, vi} from "vitest"
+import {createExtensionRequest, extensionPath, ExtensionLifecycle, hostExtensionPath} from "./runtime"
+import type {UiExtensionContextV1} from "./protocol"
+
+const context = (overrides: Partial<UiExtensionContextV1> = {}): UiExtensionContextV1 => ({
+    contractVersion: 1,
+    tenant: "main",
+    path: "roles",
+    locale: "en",
+    supportedLocales: ["en"],
+    fallbackLocale: "en",
+    theme: "light",
+    themePreference: "light",
+    apiBase: "/api/v1/main",
+    assetBase: "/ui-extensions/main/roles",
+    styles: [],
+    signal: new AbortController().signal,
+    navigate: vi.fn(),
+    request: vi.fn(),
+    ...overrides,
+})
+
+describe("extensionPath", () => {
+    it("keeps host context prefixes without granting another API root", async () => {
+        const original = window.KESTRA_BASE_PATH
+        window.KESTRA_BASE_PATH = "/kestra"
+        try {
+            expect(hostExtensionPath("/ui-extensions/main/manifest")).toBe("/kestra/ui-extensions/main/manifest")
+            const fetcher = vi.fn(async () => new Response("allowed"))
+            const request = createExtensionRequest(new AbortController().signal, "/kestra/api/v1/main", fetcher)
+            await request("/kestra/api/v1/main/roles?size=20")
+            expect(fetcher).toHaveBeenCalledOnce()
+            await expect(request("/api/v1/main/roles")).rejects.toThrow("Invalid extension request URL")
+        } finally { window.KESTRA_BASE_PATH = original }
+    })
+    it("accepts only relative extension paths", () => {
+        expect(extensionPath("details/one")).toBe("details/one")
+        for (const invalid of ["/details", "../details", "details/../one", "details%2Fone", "details?x=1", "details#x", "details\\one", "details//one"]) {
+            expect(() => extensionPath(invalid)).toThrow("Invalid extension path")
+        }
+    })
+})
+
+describe("createExtensionRequest", () => {
+    afterEach(() => document.head.replaceChildren())
+
+    it("keeps query parameters, credentials, abort signal and CSRF while preserving 401/403 responses", async () => {
+        const meta = document.createElement("meta")
+        meta.name = "csrf-token"
+        meta.content = "csrf-value"
+        document.head.append(meta)
+        const signal = new AbortController().signal
+        const fetcher = vi.fn(async () => new Response("denied", {status: 403}))
+        const response = await createExtensionRequest(signal, "/api/v1/main", fetcher)("/api/v1/main/roles?scope=team", {
+            method: "post",
+            headers: {Authorization: "Bearer forbidden"},
+        })
+        expect(response.status).toBe(403)
+        expect(fetcher).toHaveBeenCalledOnce()
+        const [url, options] = fetcher.mock.calls[0]
+        expect(url.toString()).toBe("http://localhost:3000/api/v1/main/roles?scope=team")
+        expect(options).toMatchObject({method: "POST", credentials: "same-origin", redirect: "error", signal})
+        expect((options as RequestInit).headers).toBeInstanceOf(Headers)
+        expect(((options as RequestInit).headers as Headers).get("X-CSRF-TOKEN")).toBe("csrf-value")
+        expect(((options as RequestInit).headers as Headers).get("Authorization")).toBeNull()
+    })
+
+    it("rejects paths outside the API base and accepts an unchanged 401 response", async () => {
+        const fetcher = vi.fn(async () => new Response(null, {status: 401}))
+        await expect(createExtensionRequest(new AbortController().signal, "/api/v1/main", fetcher)("/api/v1/other/roles")).rejects.toThrow("Invalid extension request URL")
+        await expect(createExtensionRequest(new AbortController().signal, "/api/v1/main", fetcher)("/api/v1/main/roles")).resolves.toMatchObject({status: 401})
+    })
+})
+
+describe("ExtensionLifecycle", () => {
+    afterEach(() => vi.useRealTimers())
+
+    it("unmounts a late mount result after disposal", async () => {
+        let resolveMount!: (value: {update: () => void; unmount: () => void}) => void
+        const late = {update: vi.fn(), unmount: vi.fn()}
+        const lifecycle = new ExtensionLifecycle(document.createElement("div"), vi.fn())
+        const started = lifecycle.start(async () => ({contractVersion: 1, mount: () => new Promise(resolve => {resolveMount = resolve})}), context())
+        await new Promise(resolve => setTimeout(resolve, 0))
+        await lifecycle.dispose()
+        resolveMount(late)
+        await started
+        await Promise.resolve()
+        expect(late.unmount).toHaveBeenCalledOnce()
+    })
+
+    it("retains the latest pending context and serializes updates", async () => {
+        const releases: (() => void)[] = []
+        const mounted = {update: vi.fn()
+            .mockImplementationOnce(() => undefined)
+            .mockImplementationOnce(() => new Promise<void>(resolve => {releases.push(resolve)}))
+            .mockImplementation(() => undefined), unmount: vi.fn()}
+        const lifecycle = new ExtensionLifecycle(document.createElement("div"), vi.fn())
+        await lifecycle.start(async () => ({contractVersion: 1, mount: () => mounted}), context())
+        const first = lifecycle.update(context({path: "one"}))
+        const second = lifecycle.update(context({path: "two"}))
+        await new Promise(resolve => setTimeout(resolve, 0))
+        await vi.waitFor(() => expect(releases).toHaveLength(1))
+        releases[0]()
+        await Promise.all([first, second])
+        expect(mounted.update).toHaveBeenCalledTimes(3)
+        expect(mounted.update.mock.calls.at(-1)?.[0].path).toBe("two")
+    })
+
+    it("reports mount, update and timeout errors and disposes", async () => {
+        vi.useFakeTimers()
+        const onError = vi.fn()
+        const mounted = {update: vi.fn()
+            .mockImplementationOnce(() => undefined)
+            .mockImplementation(() => new Promise<void>(() => {})), unmount: vi.fn()}
+        const lifecycle = new ExtensionLifecycle(document.createElement("div"), onError)
+        await lifecycle.start(async () => ({contractVersion: 1, mount: () => mounted}), context())
+        const update = lifecycle.update(context({path: "stuck"}))
+        await vi.advanceTimersByTimeAsync(5000)
+        await update
+        expect(onError).toHaveBeenCalledWith(expect.objectContaining({message: "Extension lifecycle timed out"}))
+        expect(mounted.unmount).toHaveBeenCalledOnce()
+    })
+
+    it("reports module and lifecycle errors", async () => {
+        const onError = vi.fn()
+        const lifecycle = new ExtensionLifecycle(document.createElement("div"), onError)
+        await lifecycle.start(async () => {throw new Error("load failed")}, context())
+        expect(onError).toHaveBeenCalledWith(expect.objectContaining({message: "load failed"}))
+        const invalid = new ExtensionLifecycle(document.createElement("div"), onError)
+        await invalid.start(async () => ({contractVersion: 1, mount: () => ({unmount: vi.fn()} as never)}), context())
+        expect(onError).toHaveBeenCalledWith(expect.objectContaining({message: "Invalid extension lifecycle"}))
+    })
+})
