index 0000000..5b9f469
--- /dev/null
+++ b/ui/src/extensions/runtime.ts
@@ -0,0 +1,92 @@
+import type {MountedUiExtensionV1, UiExtensionContextV1, UiExtensionModuleV1} from "./protocol";
+import {getCsrfToken} from "../utils/csrf";
+
+export function hostExtensionPath(path: string): string {
+    return (window.KESTRA_BASE_PATH ?? "").replace(/\/$/, "") + path;
+}
+
+export function extensionPath(path: string): string {
+    if (path.startsWith("/") || path.includes("\\") || path.includes("%") || path.includes("?") || path.includes("#")
+        || path.split("/").some(segment => segment === "." || segment === "..") || path.includes("//")) {
+        throw new Error("Invalid extension path");
+    }
+    return path;
+}
+
+export function createExtensionRequest(signal: AbortSignal, apiBase: string, fetcher: typeof fetch = fetch) {
+    return async (path: string, options: RequestInit = {}): Promise<Response> => {
+        const url = new URL(path, window.location.origin);
+        const base = new URL(apiBase, window.location.origin);
+        const pathname = path.split("?")[0];
+        if (!path.startsWith("/") || path.startsWith("//") || url.origin !== window.location.origin || !url.pathname.startsWith(base.pathname + "/")
+            || pathname.includes("%") || pathname.includes("\\") || pathname.includes("//") || path.includes("#")
+            || pathname.split("/").some(segment => segment === "." || segment === "..")) {
+            throw new Error("Invalid extension request URL");
+        }
+        const headers = new Headers(options.headers);
+        headers.delete("Authorization");
+        const method = (options.method ?? "GET").toUpperCase();
+        if (!["GET", "HEAD", "OPTIONS"].includes(method)) {
+            const token = getCsrfToken();
+            if (!token) throw new Error("CSRF token is unavailable");
+            headers.set("X-CSRF-TOKEN", token);
+        }
+        return fetcher(url, {...options, method, headers, credentials: "same-origin", redirect: "error", signal: options.signal ? AbortSignal.any([signal, options.signal]) : signal});
+    };
+}
+
+export class ExtensionLifecycle {
+    private controller = new AbortController();
+    private mounted?: MountedUiExtensionV1;
+    private serial: Promise<void> = Promise.resolve();
+    private disposed = false;
+    private latest?: UiExtensionContextV1;
+
+    constructor(private container: HTMLElement, private onError: (error: unknown) => void) {}
+
+    get signal() {return this.controller.signal;}
+
+    async start(load: () => Promise<UiExtensionModuleV1>, context: UiExtensionContextV1) {
+        this.latest = context;
+        try {
+            const module = await this.bounded(load());
+            if (this.disposed) return;
+            if (module.contractVersion !== 1 || typeof module.mount !== "function") throw new Error("Unsupported extension module");
+            const pending = Promise.resolve(module.mount(this.container, context));
+            void pending.then(async mounted => {if (this.disposed) await mounted?.unmount?.();}).catch(error => this.onError(error));
+            const mounted = await this.bounded(pending);
+            if (!mounted || typeof mounted.update !== "function" || typeof mounted.unmount !== "function") throw new Error("Invalid extension lifecycle");
+            if (this.disposed) return;
+            this.mounted = mounted;
+            await this.update(this.latest);
+        } catch (error) {
+            if (!this.disposed) {this.onError(error); void this.dispose();}
+        }
+    }
+
+    update(context: UiExtensionContextV1) {
+        this.latest = context;
+        this.serial = this.serial.then(async () => {
+            if (!this.disposed && this.mounted) await this.bounded(Promise.resolve(this.mounted.update(this.latest!)));
+        }).catch(error => {if (!this.disposed) {this.onError(error); void this.dispose();}});
+        return this.serial;
+    }
+
+    async dispose() {
+        if (this.disposed) return;
+        this.disposed = true;
+        this.controller.abort();
+        try {await this.bounded(this.serial);}
+        catch (error) {this.onError(error);}
+        try {await this.bounded(Promise.resolve(this.mounted?.unmount()));}
+        catch (error) {this.onError(error);}
+        finally {this.container.replaceChildren(); this.container.shadowRoot?.replaceChildren();}
+    }
+
+    private bounded<Result>(promise: Promise<Result>): Promise<Result> {
+        return new Promise((resolve, reject) => {
+            const timer = setTimeout(() => reject(new Error("Extension lifecycle timed out")), 5000);
+            promise.then(resolve, reject).finally(() => clearTimeout(timer));
+        });
+    }
+}
