@@ -0,0 +1,68 @@
+package io.kestra.webserver.ui;
+
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import io.kestra.webserver.controllers.api.UiExtensionController;
+import io.kestra.webserver.rbac.RbacConfiguration;
+import io.kestra.webserver.rbac.TypedAuthorization;
+import io.kestra.webserver.rbac.TypedAuthorizationGate;
+import io.kestra.webserver.rbac.TypedAuthorizationResolver;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class UiExtensionControllerTest {
+    private static final UiExtensionDescriptorV1 DESCRIPTOR = new UiExtensionDescriptorV1(1, "probe", "ui-extensions/probe",
+        "page.js", List.of(), Map.of(), Map.of("en", "Probe"), null);
+    private BeanProvider<TypedAuthorizationResolver> provider() {
+        return new BeanProvider<>() {
+            @Override public TypedAuthorizationResolver get() {
+                return (principal, operation) -> CompletableFuture.completedFuture(
+                    principal.subject().equals("owner") && operation.resource() == TypedAuthorization.Resource.SYSTEM
+                        ? TypedAuthorization.Decision.allow(TypedAuthorization.QueryDomain.unrestricted())
+                        : TypedAuthorization.Decision.deny("Not a management identity"));
+            }
+            @Override public boolean isUnique() { return true; }
+            @Override public boolean isPresent() { return true; }
+        };
+    }
+    private UiExtensionController controller(boolean enabled) {
+        var registry = mock(UiExtensionRegistry.class);
+        when(registry.descriptors()).thenReturn(List.of(DESCRIPTOR));
+        return new UiExtensionController(registry, new RbacConfiguration(enabled, false), new TypedAuthorizationGate(provider()));
+    }
+    private HttpRequest<?> request(String subject) {
+        var request = HttpRequest.GET("/ui-extensions/main/manifest");
+        if (subject != null) request.setAttribute(SecurityFilter.AUTHENTICATION, Authentication.build(subject, List.of()));
+        return request;
+    }
+    @Test void shouldReturnEmptyMetadataForReaderAndNoIdentity() {
+        var controller = controller(true);
+        for (String subject : new String[]{"reader", null}) {
+            var response = controller.manifest("main", request(subject)).block();
+            assertEquals(200, response.code());
+            assertTrue(response.body().extensions().isEmpty());
+        }
+    }
+    @Test void shouldReturnOnlyExplicitManagementEntries() {
+        var response = controller(true).manifest("main", request("owner")).block();
+        assertEquals(200, response.code());
+        assertEquals(List.of(DESCRIPTOR), response.body().extensions());
+        assertEquals("no-store", response.getHeaders().get("Cache-Control"));
+    }
+    @Test void shouldRejectUnknownTenantAndNeverReturnSpaForMissingAssets() {
+        var controller = controller(true);
+        assertEquals(404, controller.manifest("other", request("owner")).block().code());
+        assertEquals(404, controller.asset("main", "probe", "missing.js").code());
+        assertEquals(404, controller.asset("main", "probe", "../page.js").code());
+        assertEquals(404, controller.asset("other", "probe", "page.js").code());
+    }
+    @Test void shouldPreserveExistingAuthenticatedNoRbacVisibility() {
+        assertEquals(1, controller(false).manifest("main", request("ordinary")).block().body().extensions().size());
+    }
+}
