diff --git a/ui/src/components/extensions/ExtensionPage.vue b/ui/src/components/extensions/ExtensionPage.vue
new file mode 100644
index 0000000..724cc46
--- /dev/null
+++ b/ui/src/components/extensions/ExtensionPage.vue
@@ -0,0 +1,85 @@
+<template>
+    <TopNavBar :title="title" />
+    <KsSkeleton v-if="loading" data-test="extension-loading" />
+    <KsAlert v-if="failed" type="error" :closable="false" :title="$t('errors.500.title')" data-test="extension-error" />
+    <div ref="container" data-test="extension-container" />
+</template>
+
+<script setup lang="ts">
+    import {computed, onBeforeUnmount, onMounted, ref, watch} from "vue";
+    import {useRoute, useRouter} from "vue-router";
+    import {useI18n} from "vue-i18n";
+    import {useMiscStore} from "override/stores/misc";
+    import {SUPPORT_LOCALES} from "../../translations/languages";
+    import {createExtensionRequest, extensionPath, ExtensionLifecycle, hostExtensionPath} from "../../extensions/runtime";
+    import type {UiExtensionContextV1, UiExtensionDescriptorV1, UiExtensionModuleV1} from "../../extensions/protocol";
+    import TopNavBar from "../layout/TopNavBar.vue";
+    import useRouteContext from "../../composables/useRouteContext";
+
+    const route = useRoute();
+    const router = useRouter();
+    const misc = useMiscStore();
+    const {locale} = useI18n({useScope: "global"});
+    const container = ref<HTMLElement>();
+    const descriptor = ref<UiExtensionDescriptorV1>();
+    const loading = ref(true);
+    const failed = ref(false);
+    const title = computed(() => descriptor.value?.titles[locale.value] ?? descriptor.value?.titles.en ?? String(route.params.extensionId));
+    useRouteContext(computed(() => ({title: title.value})));
+    let lifecycle: ExtensionLifecycle | undefined;
+    let generation = 0;
+    let observer: MutationObserver | undefined;
+
+    function context(): UiExtensionContextV1 {
+        const tenant = String(route.params.tenant ?? "main");
+        const id = String(route.params.extensionId);
+        const assetBase = hostExtensionPath(`/ui-extensions/${encodeURIComponent(tenant)}/${encodeURIComponent(id)}/`);
+        const path = Array.isArray(route.params.pathMatch) ? route.params.pathMatch.join("/") : String(route.params.pathMatch ?? "");
+        const signal = lifecycle!.signal;
+        return Object.freeze({
+            contractVersion: 1, tenant, path, locale: locale.value, supportedLocales: Object.freeze([...SUPPORT_LOCALES]), fallbackLocale: "en",
+            theme: document.documentElement.classList.contains("dark-2") ? "dark-2" : document.documentElement.classList.contains("dark") ? "dark" : "light",
+            themePreference: misc.theme === "syncWithSystem" ? "system" : misc.theme,
+            apiBase: hostExtensionPath(`/api/v1/${encodeURIComponent(tenant)}`), assetBase,
+            styles: Object.freeze(descriptor.value!.styles.map(style => assetBase + style)), signal,
+            navigate: async (next: string, options?: {replace?: boolean}) => {
+                const safe = extensionPath(next);
+                await router[options?.replace ? "replace" : "push"]({name: "extensions/page", params: {tenant, extensionId: id, pathMatch: safe.split("/")}});
+            },
+            request: createExtensionRequest(signal, hostExtensionPath(`/api/v1/${encodeURIComponent(tenant)}`)),
+        });
+    }
+
+    async function load() {
+        const current = ++generation;
+        await lifecycle?.dispose();
+        loading.value = true;
+        failed.value = false;
+        descriptor.value = undefined;
+        if (!container.value) return;
+        lifecycle = new ExtensionLifecycle(container.value, error => {console.error("[UiExtension]", error); failed.value = true; loading.value = false;});
+        const active = lifecycle;
+        try {
+            const response = await fetch(hostExtensionPath(`/ui-extensions/${encodeURIComponent(String(route.params.tenant ?? "main"))}/manifest`), {signal: active.signal, credentials: "same-origin", redirect: "error"});
+            if (!response.ok) throw new Error("Extension manifest unavailable");
+            const manifest = await response.json();
+            if (current !== generation) return;
+            descriptor.value = manifest.extensions.find((value: UiExtensionDescriptorV1) => value.id === route.params.extensionId);
+            if (manifest.contractVersion !== 1 || !descriptor.value) throw new Error("Extension not registered");
+            const initial = context();
+            await active.start(() => import(/* @vite-ignore */ initial.assetBase + descriptor.value!.entry) as Promise<UiExtensionModuleV1>, initial);
+            if (current === generation) {loading.value = false; await active.update(context());}
+        } catch (error) {
+            if (!active.signal.aborted) {console.error("[UiExtension]", error); failed.value = true; loading.value = false;}
+        }
+    }
+
+    watch(() => `${route.params.tenant}/${route.params.extensionId}`, () => {void load();});
+    watch(() => `${route.fullPath}/${locale.value}/${misc.theme}`, () => {if (descriptor.value && lifecycle) void lifecycle.update(context());});
+    onMounted(() => {
+        observer = new MutationObserver(() => {if (descriptor.value && lifecycle) void lifecycle.update(context());});
+        observer.observe(document.documentElement, {attributes: true, attributeFilter: ["class"]});
+        void load();
+    });
+    onBeforeUnmount(() => {generation++; observer?.disconnect(); void lifecycle?.dispose();});
+</script>
diff --git a/ui/src/extensions/protocol.ts b/ui/src/extensions/protocol.ts
new file mode 100644
index 0000000..30ca573
--- /dev/null
+++ b/ui/src/extensions/protocol.ts
@@ -0,0 +1,35 @@
+export interface UiExtensionDescriptorV1 {
+    contractVersion: 1;
+    id: string;
+    entry: string;
+    styles: readonly string[];
+    titles: Readonly<Record<string, string>>;
+    capabilityPath: string | null;
+}
+
+export interface UiExtensionContextV1 {
+    readonly contractVersion: 1;
+    readonly tenant: string;
+    readonly path: string;
+    readonly locale: string;
+    readonly supportedLocales: readonly string[];
+    readonly fallbackLocale: "en";
+    readonly theme: "light" | "dark" | "dark-2";
+    readonly themePreference: "light" | "dark" | "dark-2" | "system";
+    readonly apiBase: string;
+    readonly assetBase: string;
+    readonly styles: readonly string[];
+    readonly signal: AbortSignal;
+    navigate(path: string, options?: {replace?: boolean}): Promise<void>;
+    request(path: string, options?: RequestInit): Promise<Response>;
+}
+
+export interface MountedUiExtensionV1 {
+    update(context: UiExtensionContextV1): Promise<void> | void;
+    unmount(): Promise<void> | void;
+}
+
+export interface UiExtensionModuleV1 {
+    contractVersion: 1;
+    mount(container: HTMLElement, context: UiExtensionContextV1): Promise<MountedUiExtensionV1> | MountedUiExtensionV1;
+}
