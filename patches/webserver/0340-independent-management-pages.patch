+package io.kestra.webserver.controllers.api;
+
+import io.kestra.webserver.ui.UiExtensionDescriptorV1;
+import io.kestra.webserver.ui.UiExtensionRegistry;
+import io.kestra.webserver.rbac.RbacConfiguration;
+import io.kestra.webserver.rbac.RbacAuthorizer;
+import io.kestra.webserver.rbac.TypedAuthorization;
+import io.kestra.webserver.rbac.TypedAuthorizationGate;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import reactor.core.publisher.Mono;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.MediaType;
+import io.micronaut.http.annotation.Controller;
+import io.micronaut.http.annotation.Get;
+import io.micronaut.scheduling.TaskExecutors;
+import io.micronaut.scheduling.annotation.ExecuteOn;
+import io.swagger.v3.oas.annotations.Operation;
+import java.util.List;
+
+@Controller("/ui-extensions/{tenant}")
+@ExecuteOn(TaskExecutors.IO)
+public final class UiExtensionController {
+    private final UiExtensionRegistry registry;
+    private final RbacConfiguration configuration;
+    private final TypedAuthorizationGate gate;
+
+    public UiExtensionController(UiExtensionRegistry registry, RbacConfiguration configuration, TypedAuthorizationGate gate) {
+        this.registry = registry;
+        this.configuration = configuration;
+        this.gate = gate;
+    }
+
+    @Get("/manifest")
+    @Operation(summary = "List registered independent management pages")
+    public Mono<HttpResponse<Manifest>> manifest(String tenant, HttpRequest<?> request) {
+        if (!"main".equals(tenant)) return Mono.just(HttpResponse.notFound());
+        return managementAllowed(tenant, request).map(allowed -> HttpResponse.ok(new Manifest(1, allowed ? registry.descriptors() : List.of()))
+            .header("Cache-Control", "no-store"));
+    }
+
+    private Mono<Boolean> managementAllowed(String tenant, HttpRequest<?> request) {
+        if (!configuration.enabled()) return Mono.just(true);
+        Authentication authentication = request.getAttribute(SecurityFilter.AUTHENTICATION, Authentication.class).orElse(null);
+        if (authentication == null) return Mono.just(false);
+        var principal = new RbacAuthorizer.Principal(authentication.getName(), List.copyOf(authentication.getRoles()), null, null, List.of());
+        var operation = new TypedAuthorization.Operation(1, TypedAuthorization.Source.REST, TypedAuthorization.Resource.SYSTEM,
+            TypedAuthorization.Action.EXECUTE, tenant, null, null, TypedAuthorization.QueryDomain.unrestricted(),
+            TypedAuthorization.Coverage.SINGLE, TypedAuthorization.Aggregate.NONE, TypedAuthorization.SideEffect.READ_ONLY);
+        return gate.authorize(principal, operation).map(TypedAuthorization.Decision::allowed).onErrorReturn(false);
+    }
+
+    @Get("/{id}/{path:.*}")
+    @Operation(summary = "Read a declared independent management page resource")
+    public HttpResponse<byte[]> asset(String tenant, String id, String path) {
+        if (!"main".equals(tenant)) return HttpResponse.notFound();
+        return registry.asset(id, path).map(asset -> HttpResponse.ok(asset.bytes())
+            .contentType(MediaType.of(asset.mime())).header("Cache-Control", "no-cache")
+            .header("X-Content-Type-Options", "nosniff").header("ETag", "\"" + asset.sha256() + "\""))
+            .orElseGet(HttpResponse::notFound);
+    }
+
+    public record Manifest(int contractVersion, List<UiExtensionDescriptorV1> extensions) { }
+}
