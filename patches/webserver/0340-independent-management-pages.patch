index 0000000..ade0cf9
--- /dev/null
+++ b/webserver/src/main/resources/META-INF/kestra/ui-sdk/v1/shadow-styles.mjs
@@ -0,0 +1,14 @@
+export function prepareShadowStyles(stylesheet, postcss) {
+    if (!postcss || typeof postcss.parse !== "function") throw new Error("A compatible PostCSS 8 parser is required");
+    const root = postcss.parse(stylesheet);
+    root.walkAtRules("font-face", rule => rule.remove());
+    root.walkRules(rule => {
+        rule.selector = rule.selector
+            .replace(/html\.dark-2\b/g, ":host(.dark-2)")
+            .replace(/html\.dark\b/g, ":host(.dark)")
+            .replace(/:root\b/g, ":host")
+            .replace(/\bhtml\b/g, ":host")
+            .replace(/\bbody\b/g, ".extension-body");
+    });
+    return root.toString();
+}
