diff --git a/webserver/src/main/java/io/kestra/webserver/ui/UiExtensionRegistry.java b/webserver/src/main/java/io/kestra/webserver/ui/UiExtensionRegistry.java
new file mode 100644
index 0000000..a67fdcb
--- /dev/null
+++ b/webserver/src/main/java/io/kestra/webserver/ui/UiExtensionRegistry.java
@@ -0,0 +1,129 @@
+package io.kestra.webserver.ui;
+
+import jakarta.inject.Singleton;
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HexFormat;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+@Singleton
+public final class UiExtensionRegistry {
+    private static final Logger LOG = LoggerFactory.getLogger(UiExtensionRegistry.class);
+    private static final int MAX_RESOURCE_BYTES = 16 * 1024 * 1024;
+    private static final long MAX_EXTENSION_BYTES = 64L * 1024 * 1024;
+    private static final long MAX_REGISTRY_BYTES = 128L * 1024 * 1024;
+    private static final Map<String, String> MIME = Map.of("js", "application/javascript", "mjs", "application/javascript",
+        "css", "text/css", "json", "application/json", "png", "image/png", "svg", "image/svg+xml",
+        "woff2", "font/woff2", "jpg", "image/jpeg", "webp", "image/webp");
+    private final Map<String, Registered> registered;
+
+    public UiExtensionRegistry(Collection<UiExtensionProviderV1> providers) {
+        Map<String, Registered> accepted = new LinkedHashMap<>();
+        Set<String> duplicates = new java.util.HashSet<>();
+        long totalBytes = 0;
+        for (UiExtensionProviderV1 provider : providers) {
+            try {
+                for (UiExtensionDescriptorV1 descriptor : provider.extensions()) {
+                    try {
+                        if (accepted.containsKey(descriptor.id()) || duplicates.contains(descriptor.id())) {
+                            Registered removed = accepted.remove(descriptor.id());
+                            if (removed != null) totalBytes -= removed.size();
+                            duplicates.add(descriptor.id());
+                            throw new IllegalArgumentException("Duplicate UI extension identifier.");
+                        }
+                        Registered candidate = validate(descriptor, provider.getClass().getClassLoader(), MAX_REGISTRY_BYTES - totalBytes);
+                        accepted.put(descriptor.id(), candidate);
+                        totalBytes += candidate.size();
+                    } catch (RuntimeException invalid) {
+                        LOG.error("UI extension registration was rejected.", invalid);
+                    }
+                }
+            } catch (RuntimeException invalid) {
+                LOG.error("UI extension provider failed.", invalid);
+            }
+        }
+        registered = Map.copyOf(accepted);
+    }
+
+    public List<UiExtensionDescriptorV1> descriptors() {
+        return registered.values().stream().map(Registered::descriptor).sorted(java.util.Comparator.comparing(UiExtensionDescriptorV1::id)).toList();
+    }
+
+    public Optional<Asset> asset(String id, String path) {
+        if (!safePath(path)) return Optional.empty();
+        Registered extension = registered.get(id);
+        return extension == null ? Optional.empty() : Optional.ofNullable(extension.assets().get(path));
+    }
+
+    static Registered validate(UiExtensionDescriptorV1 descriptor, ClassLoader loader, long availableBytes) {
+        if (descriptor == null || descriptor.contractVersion() != 1 || descriptor.id() == null
+            || !descriptor.id().matches("[a-z][a-z0-9-]{0,63}") || !safePath(descriptor.resourceRoot())
+            || !descriptor.resourceRoot().equals("ui-extensions/" + descriptor.id()) || descriptor.files().isEmpty()
+            || descriptor.files().size() > 2048 || !descriptor.titles().containsKey("en")
+            || descriptor.titles().values().stream().anyMatch(title -> title == null || title.isBlank() || title.length() > 120)) {
+            throw new IllegalArgumentException("Invalid UI extension declaration.");
+        }
+        if (!safePath(descriptor.entry()) || !descriptor.entry().endsWith(".js") || !descriptor.files().containsKey(descriptor.entry())
+            || descriptor.styles().stream().anyMatch(path -> !safePath(path) || !path.endsWith(".css") || !descriptor.files().containsKey(path))) {
+            throw new IllegalArgumentException("UI extension entry or stylesheet is not declared.");
+        }
+        if (descriptor.capabilityPath() != null && (!descriptor.capabilityPath().startsWith("/api/v1/")
+            || !safePath(descriptor.capabilityPath().substring(1)))) {
+            throw new IllegalArgumentException("Invalid UI extension capability path.");
+        }
+        Map<String, Asset> assets = new LinkedHashMap<>();
+        long[] total = {0};
+        descriptor.files().forEach((path, resource) -> {
+            if (!safePath(path) || resource == null || resource.sha256() == null || !resource.sha256().matches("[a-f0-9]{64}")
+                || !java.util.Objects.equals(resource.mime(), MIME.get(path.substring(path.lastIndexOf('.') + 1))) || resource.mime() == null) {
+                throw new IllegalArgumentException("Invalid UI extension resource metadata.");
+            }
+            try (var stream = loader.getResourceAsStream(descriptor.resourceRoot() + "/" + path)) {
+                if (stream == null) throw new IllegalArgumentException("UI extension resource is missing.");
+                long budget = Math.min(MAX_RESOURCE_BYTES, Math.min(MAX_EXTENSION_BYTES - total[0], availableBytes - total[0]));
+                if (budget < 0) throw new IllegalArgumentException("UI extension resource budget is exhausted.");
+                byte[] bytes = stream.readNBytes((int) budget + 1);
+                if (bytes.length > budget) {
+                    throw new IllegalArgumentException("UI extension resource budget is exceeded.");
+                }
+                if (!hash(bytes).equals(resource.sha256())) {
+                    throw new IllegalArgumentException("UI extension resource digest or size is invalid.");
+                }
+                total[0] += bytes.length;
+                assets.put(path, new Asset(bytes, resource.mime(), resource.sha256()));
+            } catch (IOException failure) {
+                throw new UncheckedIOException(failure);
+            }
+        });
+        return new Registered(descriptor, Map.copyOf(assets), total[0]);
+    }
+
+    static boolean safePath(String path) {
+        return path != null && path.matches("[A-Za-z0-9_./-]+") && !path.startsWith("/") && !path.endsWith("/")
+            && java.util.Arrays.stream(path.split("/", -1)).noneMatch(segment -> segment.isEmpty() || segment.equals(".") || segment.equals(".."));
+    }
+
+    static String hash(byte[] bytes) {
+        try {
+            return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes));
+        } catch (NoSuchAlgorithmException failure) {
+            throw new IllegalStateException(failure);
+        }
+    }
+
+    record Registered(UiExtensionDescriptorV1 descriptor, Map<String, Asset> assets, long size) { }
+    public record Asset(byte[] bytes, String mime, String sha256) {
+        public Asset {bytes = bytes.clone();}
+        @Override public byte[] bytes() {return bytes.clone();}
+    }
+}
