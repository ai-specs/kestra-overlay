@@ -0,0 +1,32 @@
+import {ref, watch, onScopeDispose} from "vue";
+import {useRoute} from "vue-router";
+import type {UiExtensionDescriptorV1} from "./protocol";
+import {hostExtensionPath} from "./runtime";
+
+export function useUiExtensions() {
+    const route = useRoute();
+    const extensions = ref<UiExtensionDescriptorV1[]>([]);
+    let controller: AbortController | undefined;
+    watch(() => String(route.params.tenant ?? "main"), async tenant => {
+        controller?.abort();
+        const current = new AbortController();
+        controller = current;
+        extensions.value = [];
+        try {
+            const response = await fetch(hostExtensionPath(`/ui-extensions/${encodeURIComponent(tenant)}/manifest`), {signal: current.signal, credentials: "same-origin", redirect: "error"});
+            if (!response.ok) return;
+            const manifest = await response.json();
+            if (manifest.contractVersion !== 1 || !Array.isArray(manifest.extensions)) return;
+            const visible = await Promise.all(manifest.extensions.map(async (descriptor: UiExtensionDescriptorV1) => {
+                if (!descriptor.capabilityPath) return descriptor;
+                try {
+                    const capability = await fetch(hostExtensionPath(descriptor.capabilityPath), {signal: current.signal, credentials: "same-origin", redirect: "error"});
+                    return capability.ok && (await capability.json()).allowed === true ? descriptor : null;
+                } catch {return null;}
+            }));
+            if (!current.signal.aborted) extensions.value = visible.filter((value): value is UiExtensionDescriptorV1 => value !== null);
+        } catch {extensions.value = [];}
+    }, {immediate: true});
+    onScopeDispose(() => controller?.abort());
+    return extensions;
+}
