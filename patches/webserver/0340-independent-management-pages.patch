@@ -0,0 +1,85 @@
+package io.kestra.webserver.ui;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.net.URL;
+import java.net.URLClassLoader;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+class UiExtensionRegistryTest {
+    @Test
+    void shouldRejectResourceRootThatCanBeSharedByDifferentIds() throws Exception {
+        Path root = Files.createTempDirectory("ui-extension");
+        Files.createDirectories(root.resolve("ui-extensions/shared"));
+        byte[] body = "export const contractVersion=1".getBytes();
+        Files.write(root.resolve("ui-extensions/shared/page.js"), body);
+        String hash = UiExtensionRegistry.hash(body);
+        var descriptor = new UiExtensionDescriptorV1(1, "role", "ui-extensions/shared", "page.js", List.of(),
+            Map.of("page.js", new UiExtensionDescriptorV1.Resource(hash, "application/javascript")), Map.of("en", "Roles"), null);
+        assertThatThrownBy(() -> UiExtensionRegistry.validate(descriptor, new URLClassLoader(new URL[]{root.toUri().toURL()}), 128L * 1024 * 1024))
+            .isInstanceOf(IllegalArgumentException.class);
+    }
+
+    @Test
+    void shouldRejectExtensionWhenItsBudgetIsExceeded() throws Exception {
+        Path root = Files.createTempDirectory("ui-extension-budget");
+        Files.createDirectories(root.resolve("ui-extensions/roles"));
+        byte[] body = new byte[1024];
+        Files.write(root.resolve("ui-extensions/roles/page.js"), body);
+        var descriptor = new UiExtensionDescriptorV1(1, "roles", "ui-extensions/roles", "page.js", List.of(),
+            Map.of("page.js", new UiExtensionDescriptorV1.Resource(UiExtensionRegistry.hash(body), "application/javascript")), Map.of("en", "Roles"), null);
+        assertThatThrownBy(() -> UiExtensionRegistry.validate(descriptor, new URLClassLoader(new URL[]{root.toUri().toURL()}), 512))
+            .isInstanceOf(IllegalArgumentException.class).hasMessageContaining("budget");
+    }
+
+    @Test
+    void shouldCloneAssetBytesAtThePublicBoundary() {
+        byte[] body = {1, 2, 3};
+        var asset = new UiExtensionRegistry.Asset(body, "application/javascript", "a".repeat(64));
+        body[0] = 9;
+        byte[] returned = asset.bytes();
+        returned[1] = 9;
+        assertThat(asset.bytes()).containsExactly(1, 2, 3);
+    }
+
+    @Test
+    void shouldRejectMissingHashMismatchMimeAndUnsafePaths() throws Exception {
+        Path root = Files.createTempDirectory("ui-extension-validation");
+        Files.createDirectories(root.resolve("ui-extensions/roles"));
+        byte[] body = "export const contractVersion=1".getBytes();
+        Files.write(root.resolve("ui-extensions/roles/page.js"), body);
+        try (var loader = new URLClassLoader(new URL[]{root.toUri().toURL()})) {
+            for (var invalid : List.of(
+                new UiExtensionDescriptorV1(2, "roles", "ui-extensions/roles", "page.js", List.of(), Map.of("page.js", new UiExtensionDescriptorV1.Resource(UiExtensionRegistry.hash(body), "application/javascript")), Map.of("en", "Roles"), null),
+                new UiExtensionDescriptorV1(1, "roles", "ui-extensions/roles", "missing.js", List.of(), Map.of("missing.js", new UiExtensionDescriptorV1.Resource(UiExtensionRegistry.hash(body), "application/javascript")), Map.of("en", "Roles"), null),
+                new UiExtensionDescriptorV1(1, "roles", "ui-extensions/roles", "page.js", List.of(), Map.of("page.js", new UiExtensionDescriptorV1.Resource("0".repeat(64), "application/javascript")), Map.of("en", "Roles"), null),
+                new UiExtensionDescriptorV1(1, "roles", "ui-extensions/roles", "page.js", List.of(), Map.of("page.js", new UiExtensionDescriptorV1.Resource(UiExtensionRegistry.hash(body), "text/html")), Map.of("en", "Roles"), null),
+                new UiExtensionDescriptorV1(1, "roles", "ui-extensions/roles", "../page.js", List.of(), Map.of("../page.js", new UiExtensionDescriptorV1.Resource(UiExtensionRegistry.hash(body), "application/javascript")), Map.of("en", "Roles"), null))) {
+                assertThatThrownBy(() -> UiExtensionRegistry.validate(invalid, loader, 1024)).isInstanceOf(IllegalArgumentException.class);
+            }
+            var valid = new UiExtensionDescriptorV1(1, "roles", "ui-extensions/roles", "page.js", List.of(),
+                Map.of("page.js", new UiExtensionDescriptorV1.Resource(UiExtensionRegistry.hash(body), "application/javascript")), Map.of("en", "Roles"), null);
+            assertThat(UiExtensionRegistry.validate(valid, loader, 1024).size()).isEqualTo(body.length);
+        }
+        for (String invalid : List.of("../page.js", "a//page.js", "/page.js", "a%2fpage.js", "a\\page.js", "https://external/page.js")) {
+            assertThat(UiExtensionRegistry.safePath(invalid)).isFalse();
+        }
+    }
+
+    @Test
+    void shouldRejectDuplicateProviderIdsRatherThanPickOne() throws Exception {
+        byte[] body;
+        try (var resource = getClass().getClassLoader().getResourceAsStream("ui-extensions/http-probe/page.js")) { body = resource.readAllBytes(); }
+        var descriptor = new UiExtensionDescriptorV1(1, "http-probe", "ui-extensions/http-probe", "page.js", List.of(),
+            Map.of("page.js", new UiExtensionDescriptorV1.Resource(UiExtensionRegistry.hash(body), "application/javascript")), Map.of("en", "Probe"), null);
+        UiExtensionProviderV1 provider = () -> List.of(descriptor);
+        var registry = new UiExtensionRegistry(List.of(provider, provider));
+        assertThat(registry.descriptors()).isEmpty();
+        assertThat(registry.asset("http-probe", "page.js")).isEmpty();
+    }
+}
