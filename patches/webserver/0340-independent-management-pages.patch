+++ b/webserver/src/main/resources/META-INF/kestra/ui-sdk/v1/check-translations.mjs
@@ -0,0 +1,51 @@
+import {readFile} from "node:fs/promises";
+import {resolve} from "node:path";
+import {pathToFileURL} from "node:url";
+import {supportedLocales} from "./locales.mjs";
+
+function flatten(value, path = "", result = {}) {
+    if (typeof value === "string") {result[path] = value; return result;}
+    if (!value || typeof value !== "object") throw new Error(`Non-message value at ${path}`);
+    for (const [key, child] of Object.entries(value)) flatten(child, path ? `${path}.${key}` : key, result);
+    return result;
+}
+
+function placeholders(message) {
+    const literalFree = message.replace(/\\[{}]/g, "").replace(/\{'[^']*'\}/g, "");
+    if (/\{\{/.test(literalFree)) throw new Error("Nested interpolation braces");
+    const names = [...literalFree.matchAll(/\{([^{}]*)\}/g)].map(match => match[1].trim());
+    if (names.some(name => !/^(?:[A-Za-z_$][\w$]*|\d+)$/.test(name))) throw new Error("Invalid interpolation name");
+    return [...new Set(names)].sort().join(",");
+}
+
+export async function checkTranslations(directory) {
+    const reports = [];
+    const source = JSON.parse(await readFile(resolve(directory, "en.json"), "utf8"));
+    if (!source.en) throw new Error("English messages must be wrapped under en");
+    const english = flatten(source.en);
+    for (const locale of supportedLocales) {
+        const errors = [];
+        try {
+            const content = JSON.parse(await readFile(resolve(directory, `${locale}.json`), "utf8"));
+            if (!content[locale]) throw new Error(`Messages must be wrapped under ${locale}`);
+            const messages = flatten(content[locale]);
+            for (const key of Object.keys(english)) {
+                if (!(key in messages)) errors.push(`Missing: ${key}`);
+                else if (!messages[key].trim()) errors.push(`Empty: ${key}`);
+                else if (placeholders(messages[key]) !== placeholders(english[key])) errors.push(`Placeholders differ: ${key}`);
+            }
+            for (const key of Object.keys(messages)) if (!(key in english)) errors.push(`Extra: ${key}`);
+        } catch (error) {errors.push(String(error));}
+        reports.push({locale, errors});
+    }
+    return {contractVersion: 1, passed: reports.every(report => report.errors.length === 0), reports};
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
+    try {
+        if (!process.argv[2]) throw new Error("Usage: node check-translations.mjs <locale-directory>");
+        const report = await checkTranslations(process.argv[2]);
+        console.log(JSON.stringify(report, null, 2));
+        process.exitCode = report.passed ? 0 : 1;
+    } catch (error) {console.error(String(error)); process.exitCode = 1;}
+}
