+package io.kestra.webserver.ui;
+
+import java.net.http.HttpClient;
+import java.net.http.HttpResponse;
+import java.util.List;
+import java.util.Map;
+import java.util.HexFormat;
+import java.security.MessageDigest;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionStage;
+import io.kestra.core.junit.annotations.KestraTest;
+import io.kestra.webserver.rbac.RbacAuthorizer;
+import io.kestra.webserver.rbac.TypedAuthorization;
+import io.kestra.webserver.rbac.TypedAuthorizationResolver;
+import io.micronaut.context.annotation.Property;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.runtime.server.EmbeddedServer;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.AuthenticationFetcher;
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+import static org.junit.jupiter.api.Assertions.*;
+
+@KestraTest(environments = "h2")
+@Property(name = "kestra.server-type", value = "WEBSERVER")
+@Property(name = "kestra.rbac.enabled", value = "true")
+@Property(name = "kestra.rbac.typed.enabled", value = "true")
+@Property(name = "micronaut.security.enabled", value = "true")
+@Property(name = "micronaut.security.filter.enabled", value = "true")
+@Property(name = "micronaut.security.intercept-url-map[0].pattern", value = "/**")
+@Property(name = "micronaut.security.intercept-url-map[0].access[0]", value = "isAnonymous()")
+@Property(name = "mcp.http.security.fixture", value = "true")
+@Property(name = "ui.extension.http.probe", value = "true")
+class UiExtensionHttpTest {
+    @Inject EmbeddedServer server;
+    private HttpResponse<String> get(String path, String subject) throws Exception {
+        var request = java.net.http.HttpRequest.newBuilder(server.getURI().resolve(path)).GET();
+        if (subject != null) request.header("X-Ui-Probe", subject);
+        return HttpClient.newHttpClient().send(request.build(), HttpResponse.BodyHandlers.ofString());
+    }
+    @Test void shouldDiscoverMetadataWithoutGrantingManagementOrServingSpaAssets() throws Exception {
+        var reader = get("/ui-extensions/main/manifest", "reader");
+        assertEquals(200, reader.statusCode());
+        assertTrue(reader.body().contains("\"extensions\":[]"));
+        var owner = get("/ui-extensions/main/manifest", "owner");
+        assertEquals(200, owner.statusCode());
+        assertTrue(owner.body().contains("http-probe"));
+        assertEquals(401, get("/ui-extensions/main/manifest", null).statusCode());
+        assertEquals(403, get("/ui-extensions/main/http-probe/page.js", "reader").statusCode());
+        var asset = get("/ui-extensions/main/http-probe/page.js", "owner");
+        assertEquals(200, asset.statusCode());
+        assertTrue(asset.headers().firstValue("content-type").orElse("").contains("application/javascript"));
+        assertEquals("export const contractVersion = 1;\n", asset.body());
+        var missing = get("/ui-extensions/main/http-probe/missing.js", "owner");
+        assertEquals(404, missing.statusCode());
+        assertFalse(missing.body().contains("id=\"app\""));
+        assertEquals(200, get("/api/v1/configs", "reader").statusCode());
+    }
+    @Singleton
+    @Requires(property = "ui.extension.http.probe", value = "true")
+    static class Identity implements AuthenticationFetcher<io.micronaut.http.HttpRequest<?>> {
+        @Override public org.reactivestreams.Publisher<Authentication> fetchAuthentication(io.micronaut.http.HttpRequest<?> request) {
+            String subject = request.getHeaders().get("X-Ui-Probe");
+            return subject == null ? Mono.empty() : Mono.just(Authentication.build(subject, List.of()));
+        }
+    }
+    @Singleton
+    @Requires(property = "ui.extension.http.probe", value = "true")
+    static class Policy implements TypedAuthorizationResolver {
+        @Override public CompletionStage<TypedAuthorization.Decision> authorize(RbacAuthorizer.Principal principal, TypedAuthorization.Operation operation) {
+            return CompletableFuture.completedFuture(principal.subject().equals("owner") || operation.resource() == TypedAuthorization.Resource.METADATA
+                ? TypedAuthorization.Decision.allow(operation.queryDomain()) : TypedAuthorization.Decision.deny("Read-only identity"));
+        }
+    }
+    @Singleton
+    @Requires(property = "ui.extension.http.probe", value = "true")
+    static class Pages implements UiExtensionProviderV1 {
+        @Override public List<UiExtensionDescriptorV1> extensions() {
+            try (var resource = getClass().getClassLoader().getResourceAsStream("ui-extensions/http-probe/page.js")) {
+                String hash = HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(resource.readAllBytes()));
+                return List.of(new UiExtensionDescriptorV1(1, "http-probe", "ui-extensions/http-probe", "page.js", List.of(),
+                    Map.of("page.js", new UiExtensionDescriptorV1.Resource(hash, "application/javascript")), Map.of("en", "HTTP probe"), null));
+            } catch (Exception failure) { throw new IllegalStateException(failure); }
+        }
+    }
+}
diff --git a/webserver/src/test/java/io/kestra/webserver/ui/UiExtensionRegistryTest.java b/webserver/src/test/java/io/kestra/webserver/ui/UiExtensionRegistryTest.java
