@@ -0,0 +1,7 @@
+import contract from "./contract.json" with {type: "json"};
+export const supportedLocales = Object.freeze([...contract.supportedLocales]);
+export const fallbackLocale = contract.fallbackLocale;
+export function resolveLocale(value) {
+    const normalized = contract.localeAliases[value] ?? value;
+    return supportedLocales.includes(normalized) ? normalized : fallbackLocale;
+}
diff --git a/webserver/src/main/resources/META-INF/kestra/ui-sdk/v1/shadow-styles.mjs b/webserver/src/main/resources/META-INF/kestra/ui-sdk/v1/shadow-styles.mjs
