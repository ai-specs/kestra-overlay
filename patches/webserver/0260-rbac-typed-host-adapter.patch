+package io.kestra.webserver.rbac;
+
+import java.time.Duration;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import io.kestra.webserver.errors.ProblemFactory;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.*;
+import io.micronaut.http.annotation.Filter;
+import io.micronaut.http.filter.*;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import io.micronaut.web.router.MethodBasedRouteMatch;
+import io.micronaut.web.router.RouteAttributes;
+import jakarta.inject.Singleton;
+import org.reactivestreams.Publisher;
+import reactor.core.publisher.Flux;
+import reactor.core.publisher.Mono;
+
+@Singleton
+@Filter("/**")
+@Requires(property = "kestra.rbac.typed.enabled", value = "true")
+public final class TypedRestRbacFilter implements HttpServerFilter {
+    private final RbacConfiguration configuration;
+    private final OssRestOperationAdapter adapter;
+    private final TypedAuthorizationGate gate;
+    private final ProblemFactory problems;
+
+    public TypedRestRbacFilter(RbacConfiguration configuration, OssRestOperationAdapter adapter,
+        TypedAuthorizationGate gate, ProblemFactory problems) {
+        this.configuration = configuration;
+        this.adapter = adapter;
+        this.gate = gate;
+        this.problems = problems;
+    }
+
+    @Override
+    public int getOrder() {
+        return ServerFilterPhase.SECURITY.order() + 1;
+    }
+
+    @Override
+    public Publisher<MutableHttpResponse<?>> doFilter(HttpRequest<?> request, ServerFilterChain chain) {
+        if (!configuration.enabled() || RestRbacFilter.protocol(request)) return chain.proceed(request);
+        Authentication authentication = request.getAttribute(SecurityFilter.AUTHENTICATION, Authentication.class).orElse(null);
+        if (authentication == null) return Mono.just(error(request, HttpStatus.UNAUTHORIZED));
+        return Mono.defer(() -> {
+            var route = RouteAttributes.getRouteMatch(request).orElse(null);
+            if (!(route instanceof MethodBasedRouteMatch<?, ?> methodRoute)) return Mono.just(false);
+            var principal = new RbacAuthorizer.Principal(authentication.getName(), List.copyOf(authentication.getRoles()), null, null, List.of());
+            Map<String, List<String>> query = new LinkedHashMap<>();
+            request.getParameters().names().forEach(name -> query.put(name, List.copyOf(request.getParameters().getAll(name))));
+            return body(request).flatMap(bytes -> {
+                var operations = adapter.resolve(new OssRestOperationAdapter.Request(new RestAuthorizationResolver.Request(
+                    request.getMethodName(), request.getPath(), query, request.getContentType().map(Object::toString).orElse(null), bytes,
+                    methodRoute.getDeclaringType().getName(), methodRoute.getMethodName(),
+                    java.util.Arrays.stream(methodRoute.getArgumentTypes()).map(Class::getName).toList()), methodRoute.getVariableValues()));
+                if (operations.isEmpty()) return Mono.just(false);
+                var filters = io.kestra.webserver.converters.QueryFilterFormatBinder.getQueryFilters(query, 3, 20);
+                var requestedDomain = TypedQueryDomains.fromFilters(filters, true);
+                return Flux.fromIterable(operations).concatMap(operation -> gate.authorize(principal,
+                    operation.coverage() == TypedAuthorization.Coverage.COMPLETE_QUERY
+                        ? new TypedAuthorization.Operation(operation.contractVersion(), operation.source(), operation.resource(), operation.action(),
+                            operation.tenant(), operation.namespace(), operation.resourceId(), operation.queryDomain().intersect(requestedDomain),
+                            operation.coverage(), operation.aggregate(), operation.sideEffect()) : operation))
+                    .all(TypedAuthorization.Decision::allowed);
+            });
+        }).subscribeOn(reactor.core.scheduler.Schedulers.boundedElastic()).timeout(Duration.ofSeconds(10))
+            .defaultIfEmpty(false).onErrorReturn(false)
+            .flatMapMany(allowed -> allowed ? chain.proceed(request) : Mono.just(error(request, HttpStatus.FORBIDDEN)));
+    }
+
+    private Mono<byte[]> body(HttpRequest<?> request) {
+        if (!(request instanceof ServerHttpRequest<?> server)) return Mono.just(request.getBody(byte[].class).orElse(new byte[0]));
+        return Mono.using(() -> server.byteBody().split(io.micronaut.http.body.ByteBody.SplitBackpressureMode.NEW),
+            split -> Mono.fromCompletionStage(split.buffer()).map(available -> {
+                try (available) { return available.toByteArray(); }
+            }), split -> split.close());
+    }
+
+    private MutableHttpResponse<?> error(HttpRequest<?> request, HttpStatus status) {
+        return HttpResponse.status(status).contentType(MediaType.APPLICATION_JSON_PROBLEM_TYPE)
+            .body(problems.detailForStatus(request, null, status.getCode(), null, List.of()));
+    }
+}
