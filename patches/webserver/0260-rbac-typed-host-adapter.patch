@@ -0,0 +1,28 @@
+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import io.kestra.core.models.QueryFilter;
+import org.junit.jupiter.api.Test;
+
+import static io.kestra.core.models.QueryFilter.*;
+import static org.assertj.core.api.Assertions.assertThat;
+
+class TypedQueryDomainsTest {
+    @Test
+    void shouldCombineNamespaceFiltersWithBooleanSemanticsAndExactExclusions() {
+        var union = new QueryFilter(null, null, null, Logical.OR,
+            List.of(leaf(Op.EQUALS, "team.exact"), leaf(Op.PREFIX, "team.tree")));
+        var domain = TypedQueryDomains.fromFilters(List.of(union, leaf(Op.NOT_EQUALS, "team.tree.hidden")), true);
+        assertThat(List.of("team.exact", "team.exact.child", "team.tree", "team.tree.child", "team.tree.hidden", "team.tree2")
+            .stream().filter(domain::contains).toList()).containsExactly("team.exact", "team.tree", "team.tree.child");
+        var impossible = TypedQueryDomains.fromFilters(List.of(leaf(Op.EQUALS, "team"), leaf(Op.EQUALS, "other")), true);
+        assertThat(impossible.contains("team")).isFalse();
+        var withOtherField = new QueryFilter(null, null, null, Logical.OR, List.of(leaf(Op.EQUALS, "team"),
+            new QueryFilter(Field.FLOW_ID, Op.EQUALS, "flow", null, null)));
+        assertThat(TypedQueryDomains.fromFilters(List.of(withOtherField), true).contains("other")).isTrue();
+    }
+
+    private QueryFilter leaf(Op operation, Object value) {
+        return new QueryFilter(Field.NAMESPACE, operation, value, null, null);
+    }
+}
