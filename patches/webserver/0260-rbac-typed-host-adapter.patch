@@ -0,0 +1,100 @@
+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import com.fasterxml.jackson.databind.JsonNode;
+import io.kestra.core.serializers.JacksonMapper;
+import io.kestra.core.utils.PebbleUtil;
+import io.kestra.plugin.core.dashboard.data.*;
+import io.kestra.plugin.core.dashboard.chart.mardown.sources.FlowDescription;
+import io.micronaut.context.annotation.Value;
+import io.micronaut.http.HttpStatus;
+import io.micronaut.http.context.ServerRequestContext;
+import io.micronaut.http.exceptions.HttpStatusException;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import jakarta.inject.Singleton;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+
+@Singleton
+public final class TypedDashboardGate {
+    private final RbacConfiguration configuration;
+    private final boolean typedEnabled;
+    private final TypedAuthorizationGate gate;
+
+    public TypedDashboardGate(RbacConfiguration configuration, @Value("${kestra.rbac.typed.enabled:false}") boolean typedEnabled,
+        TypedAuthorizationGate gate) {
+        this.configuration = configuration;
+        this.typedEnabled = typedEnabled;
+        this.gate = gate;
+    }
+
+    public void authorize(String tenant, Object datasource) {
+        if (!configuration.enabled() || !typedEnabled) return;
+        var request = ServerRequestContext.currentRequest().orElseThrow(() -> denied());
+        var authentication = request.getAttribute(SecurityFilter.AUTHENTICATION, Authentication.class).orElseThrow(() -> denied());
+        var principal = new RbacAuthorizer.Principal(authentication.getName(), List.copyOf(authentication.getRoles()), null, null, List.of());
+        Resource resource;
+        Aggregate aggregate;
+        String namespace = null;
+        String id = null;
+        if (datasource != null && (datasource.getClass() == Executions.class || datasource.getClass() == ExecutionsKPI.class)) {
+            resource = Resource.EXECUTION;
+            aggregate = Aggregate.EXECUTION;
+        } else if (datasource != null && (datasource.getClass() == Logs.class || datasource.getClass() == LogsKPI.class)) {
+            resource = Resource.LOG;
+            aggregate = Aggregate.LOG;
+        } else if (datasource != null && datasource.getClass() == Triggers.class) {
+            resource = Resource.TRIGGER;
+            aggregate = Aggregate.TRIGGER;
+        } else if (datasource instanceof FlowDescription flow) {
+            resource = Resource.FLOW;
+            aggregate = Aggregate.FLOW_DESCRIPTION;
+            namespace = flow.getNamespace();
+            id = flow.getFlowId();
+        } else {
+            throw denied();
+        }
+        JsonNode definition = JacksonMapper.ofJson().valueToTree(datasource);
+        if (hasExpression(definition)) throw denied();
+        QueryDomain domain = namespace == null ? queryDomain(definition.path("where"))
+            : new QueryDomain(List.of(namespace), List.of(), List.of(), true, false);
+        var operation = new Operation(CONTRACT_VERSION, Source.DASHBOARD_AGGREGATE, resource, Action.READ, tenant, namespace, id,
+            domain, namespace == null ? Coverage.COMPLETE_QUERY : Coverage.SINGLE, aggregate, SideEffect.READ_ONLY);
+        Decision decision = gate.authorize(principal, operation).block();
+        if (decision == null || !decision.allowed()) throw denied();
+        request.setAttribute(TypedNamespaceAccessControl.class.getName() + "." + resource.name(), decision.scope());
+    }
+
+    private QueryDomain queryDomain(JsonNode filters) {
+        var parsed = new java.util.ArrayList<io.kestra.core.models.QueryFilter>();
+        for (JsonNode filter : filters) {
+            if ("OR".equals(filter.path("type").asText())) continue;
+            if (!"NAMESPACE".equals(filter.path("field").asText())) continue;
+            io.kestra.core.models.QueryFilter.Op action = switch (filter.path("type").asText()) {
+                case "EQUAL_TO" -> io.kestra.core.models.QueryFilter.Op.EQUALS;
+                case "PREFIX" -> io.kestra.core.models.QueryFilter.Op.PREFIX;
+                case "NOT_EQUAL_TO" -> io.kestra.core.models.QueryFilter.Op.NOT_EQUALS;
+                case "IN" -> io.kestra.core.models.QueryFilter.Op.IN;
+                case "NOT_IN" -> io.kestra.core.models.QueryFilter.Op.NOT_IN;
+                default -> null;
+            };
+            if (action == null) continue;
+            Object value = filter.has("values")
+                ? java.util.stream.StreamSupport.stream(filter.path("values").spliterator(), false).map(JsonNode::asText).toList()
+                : filter.path("value").asText();
+            parsed.add(new io.kestra.core.models.QueryFilter(io.kestra.core.models.QueryFilter.Field.NAMESPACE, action, value, null, null));
+        }
+        return TypedQueryDomains.fromFilters(parsed, false);
+    }
+
+    private boolean hasExpression(JsonNode node) {
+        if (node.isTextual()) return PebbleUtil.containsOpeningBlockDelimiter(node.asText());
+        for (JsonNode child : node) if (hasExpression(child)) return true;
+        return false;
+    }
+
+    private HttpStatusException denied() {
+        return new HttpStatusException(HttpStatus.FORBIDDEN, "Dashboard datasource is not authorized");
+    }
+}
