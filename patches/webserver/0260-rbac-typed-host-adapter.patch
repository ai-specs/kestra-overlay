@@ -0,0 +1,105 @@
+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import io.kestra.core.models.AccessScope;
+import io.kestra.core.models.QueryFilter;
+import io.kestra.core.repositories.GlobalNamespaceAccessControl;
+import io.kestra.core.repositories.NamespaceAccessControl;
+import io.micronaut.context.annotation.Replaces;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.context.ServerRequestContext;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import io.micronaut.web.router.RouteAttributes;
+import jakarta.inject.Singleton;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+
+@Singleton
+@Replaces(GlobalNamespaceAccessControl.class)
+@Requires(property = "kestra.rbac.enabled", value = "true")
+@Requires(property = "kestra.rbac.typed.enabled", value = "true")
+public final class TypedNamespaceAccessControl implements NamespaceAccessControl {
+    private final TypedAuthorizationGate gate;
+
+    public TypedNamespaceAccessControl(TypedAuthorizationGate gate) {
+        this.gate = gate;
+    }
+
+    public QueryDomain domain(QueryFilter.Resource resource) {
+        var request = ServerRequestContext.currentRequest().orElse(null);
+        if (request == null) return QueryDomain.unrestricted();
+        var authentication = request.getAttribute(SecurityFilter.AUTHENTICATION, Authentication.class).orElse(null);
+        if (authentication == null || resource == null) return QueryDomain.empty();
+        String cacheKey = TypedNamespaceAccessControl.class.getName() + "." + resource.name();
+        var cached = request.getAttribute(cacheKey, QueryDomain.class).orElse(null);
+        if (cached != null) return cached;
+        try {
+            var principal = new RbacAuthorizer.Principal(authentication.getName(), List.copyOf(authentication.getRoles()), null, null, List.of());
+            var route = RouteAttributes.getRouteMatch(request).orElseThrow();
+            String tenant = (String) route.getVariableValues().get("tenant");
+            Resource kind = switch (resource) {
+                case FLOW, TEMPLATE -> Resource.FLOW;
+                case EXECUTION, TASK -> Resource.EXECUTION;
+                case NAMESPACE -> Resource.NAMESPACE;
+                case LOG -> Resource.LOG;
+                case TRIGGER -> Resource.TRIGGER;
+                case KV_METADATA -> Resource.KVSTORE;
+                case NAMESPACE_FILE_METADATA -> Resource.NAMESPACE_FILE;
+                default -> null;
+            };
+            if (kind == null || !"main".equals(tenant)) return QueryDomain.empty();
+            var operation = new Operation(CONTRACT_VERSION, Source.REST, kind, Action.LIST, tenant, null, null,
+                QueryDomain.unrestricted(), Coverage.COMPLETE_QUERY, Aggregate.NONE, SideEffect.READ_ONLY);
+            var decision = gate.authorize(principal, operation).block();
+            QueryDomain result = decision != null && decision.allowed() ? decision.scope() : QueryDomain.empty();
+            request.setAttribute(cacheKey, result);
+            return result;
+        } catch (Exception failure) {
+            return QueryDomain.empty();
+        }
+    }
+
+    @Override
+    public AccessScope namespaceScope(QueryFilter.Resource resource) {
+        QueryDomain scope = domain(resource);
+        return scope.kind() == DomainKind.GLOBAL ? AccessScope.global()
+            : AccessScope.namespaces(scope.namespaceSubtrees(), scope.exactNamespaces());
+    }
+
+    @Override
+    public List<String> excludedNamespaces(QueryFilter.Resource resource) {
+        return domain(resource).excludedNamespaces();
+    }
+
+    @Override
+    public boolean resourceReadAllowed(QueryFilter.Resource resource, String tenantId, String namespace, String resourceId) {
+        if (gate.evaluationEnabled()) {
+            var owner = AuthorizationEvaluations.current();
+            if (owner == null) return io.kestra.core.repositories.AuthorizationInvocationContext.isInternal();
+            if (resource == null || namespace == null || resourceId == null || !java.util.Objects.equals(owner.tenant, tenantId)) return false;
+            Resource kind = switch (resource) {
+                case FLOW, TEMPLATE -> Resource.FLOW;
+                case EXECUTION, TASK -> Resource.EXECUTION;
+                case NAMESPACE -> Resource.NAMESPACE;
+                case LOG -> Resource.LOG;
+                case TRIGGER -> Resource.TRIGGER;
+                case KV_METADATA -> Resource.KVSTORE;
+                case NAMESPACE_FILE_METADATA -> Resource.NAMESPACE_FILE;
+                default -> null;
+            };
+            if (kind == null) return false;
+            var operation = new Operation(CONTRACT_VERSION, owner.principal.scopes().isEmpty() ? Source.REST : Source.MCP,
+                kind, Action.READ, owner.tenant, namespace, resourceId, new QueryDomain(List.of(namespace), List.of(), List.of(), true, false), Coverage.SINGLE,
+                Aggregate.NONE, SideEffect.READ_ONLY);
+            var decision = gate.authorize(owner.principal, operation).block();
+            return decision != null && decision.allowed() && decision.scope().contains(namespace);
+        }
+        return domain(resource).contains(namespace);
+    }
+
+    @Override
+    public boolean namespaceAllowed(QueryFilter.Resource resource, String namespace) {
+        return domain(resource).contains(namespace);
+    }
+}
