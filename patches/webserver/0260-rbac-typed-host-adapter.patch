+package io.kestra.webserver.rbac;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.net.URI;
+import com.fasterxml.jackson.core.JsonParser;
+import com.fasterxml.jackson.databind.DeserializationFeature;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.dataformat.yaml.YAMLFactory;
+import io.kestra.core.repositories.ExecutionRepositoryInterface;
+import jakarta.inject.Singleton;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+
+@Singleton
+public final class OssRestOperationAdapter {
+    private final ExecutionRepositoryInterface executions;
+    private final ObjectMapper yaml = new ObjectMapper(new YAMLFactory())
+        .enable(JsonParser.Feature.STRICT_DUPLICATE_DETECTION).enable(DeserializationFeature.FAIL_ON_TRAILING_TOKENS);
+
+    public OssRestOperationAdapter(ExecutionRepositoryInterface executions) {
+        this.executions = executions;
+    }
+
+    public record Request(RestAuthorizationResolver.Request route, Map<String, Object> variables) {
+        public Request {
+            variables = Map.copyOf(variables);
+        }
+        String variable(String key) {
+            Object value = variables.get(key);
+            return value instanceof String text ? text : null;
+        }
+    }
+
+    public List<Operation> resolve(Request request) {
+        if (request == null || request.route() == null) return List.of();
+        var route = request.route();
+        if (route.path() == null || route.path().contains("%") || route.path().contains("//")
+            || route.path().contains("\\") || List.of(route.path().split("/")).stream().anyMatch(segment -> segment.equals(".") || segment.equals("..")))
+            return List.of();
+        String tenant = request.variable("tenant");
+        if (tenant == null && Set.of("io.kestra.webserver.controllers.api.MiscController",
+            "io.kestra.webserver.controllers.api.PluginController").contains(route.controller())) tenant = "main";
+        if (!"main".equals(tenant)) return List.of();
+        String namespace = request.variable("namespace");
+        String id = request.variable("id");
+        String handler = route.handler();
+        try {
+            return switch (route.controller()) {
+                case "io.kestra.webserver.controllers.api.FlowController" -> flow(request, tenant, namespace, id);
+                case "io.kestra.webserver.controllers.api.ExecutionController" -> execution(request, tenant, namespace, id);
+                case "io.kestra.webserver.controllers.api.OutputController" -> switch (handler) {
+                    case "getExecutionOutputs", "getTaskRunOutputs", "getTaskOutputsInformation" ->
+                        ownedExecution(request, tenant, Resource.EXECUTION, Action.ACCESS_OUTPUTS);
+                    default -> administrative(tenant);
+                };
+                case "io.kestra.webserver.controllers.api.NamespaceController" -> switch (handler) {
+                    case "searchNamespaces", "autocompleteNamespaces" -> query(Resource.NAMESPACE, tenant, null);
+                    case "getNamespace" -> single(Resource.NAMESPACE, Action.READ, tenant, request.variable("id"), null);
+                    case "getFlowDependenciesFromNamespace" -> query(Resource.FLOW, tenant, namespace);
+                    default -> administrative(tenant);
+                };
+                case "io.kestra.webserver.controllers.api.LogController" -> logs(request, tenant, namespace);
+                case "io.kestra.webserver.controllers.api.MetricController" -> handler.equals("searchByExecution")
+                    ? ownedExecution(request, tenant, Resource.METRIC, Action.READ)
+                    : Set.of("listFlowMetrics", "listTaskMetrics", "listTasksWithMetrics", "aggregateMetricsFromFlow", "aggregateMetricsFromTask").contains(handler)
+                        ? single(Resource.METRIC, Action.READ, tenant, namespace, request.variable("flowId")) : administrative(tenant);
+                case "io.kestra.webserver.controllers.api.KVController" -> keyValue(request, tenant, namespace);
+                case "io.kestra.webserver.controllers.api.NamespaceFileController" -> files(request, tenant, namespace);
+                case "io.kestra.webserver.controllers.api.TriggerController" -> switch (handler) {
+                    case "searchTriggers", "exportTriggers" -> query(Resource.TRIGGER, tenant, null);
+                    case "searchTriggersForFlow" -> query(Resource.TRIGGER, tenant, namespace);
+                    default -> administrative(tenant);
+                };
+                case "io.kestra.webserver.controllers.api.PluginController" -> Set.of("getSchemasFromType", "getPropertiesFromType", "getAllInputTypes",
+                    "getSchemaFromInputType", "listPlugins", "listTriggerPlugins", "getPluginIcons", "getPluginIcon", "getPluginIconSvg", "getPluginGroupIcons",
+                    "getPluginDocumentation", "getPluginDocumentationFromVersion", "getPluginVersions", "getPluginBySubgroups", "getPluginUiManifest", "getPluginUi").contains(handler)
+                        ? metadata(tenant) : administrative(tenant);
+                case "io.kestra.webserver.controllers.api.MiscController" -> Set.of("getConfiguration", "getUsages", "getExpressionFilters", "getExpressionFunctions").contains(handler)
+                    ? metadata(tenant) : administrative(tenant);
+                case "io.kestra.webserver.controllers.api.DashboardController" -> Set.of("searchDashboards", "getDashboard", "getDefaultDashboardDefinitions", "previewChart", "exportChart", "exportDashboardChart").contains(handler)
+                    ? metadata(tenant) : administrative(tenant);
+                case "io.kestra.webserver.controllers.api.McpServerController" -> switch (handler) {
+                    case "listMcps" -> query(Resource.MCP_SERVER, tenant, null);
+                    case "getMcp" -> single(Resource.MCP_SERVER, Action.READ, tenant, null, id);
+                    case "createMcp" -> single(Resource.MCP_SERVER, Action.CREATE, tenant, null, null);
+                    case "updateMcp", "toggleMcp" -> single(Resource.MCP_SERVER, Action.UPDATE, tenant, null, id);
+                    case "deleteMcp" -> single(Resource.MCP_SERVER, Action.DELETE, tenant, null, id);
+                    default -> administrative(tenant);
+                };
+                default -> administrative(tenant);
+            };
+        } catch (Exception invalid) {
+            return List.of();
+        }
+    }
+
+    private List<Operation> flow(Request request, String tenant, String namespace, String id) throws Exception {
+        return switch (request.route().handler()) {
+            case "getFlow", "listFlowRevisions", "getTaskFromFlow", "generateFlowGraph" -> single(Resource.FLOW, Action.READ, tenant, namespace, id);
+            case "searchFlows", "searchFlowsBySourceCode", "listDistinctNamespaces", "listDeprecated", "exportFlows", "exportFlowsByQuery" -> query(Resource.FLOW, tenant, null);
+            case "listFlowsByNamespace", "getFlowDependencies" -> query(Resource.FLOW, tenant, namespace);
+            case "createFlow", "updateFlow", "generateFlowGraphFromSource" -> {
+                JsonNode body = yaml.readTree(request.route().body());
+                if (body == null || !body.path("namespace").isTextual() || !body.path("id").isTextual() || body.has("tenantId")) yield List.of();
+                String bodyNamespace = body.path("namespace").asText();
+                String bodyId = body.path("id").asText();
+                if (namespace != null && (!namespace.equals(bodyNamespace) || !id.equals(bodyId))) yield List.of();
+                Action action = request.route().handler().equals("createFlow") ? Action.CREATE
+                    : request.route().handler().equals("updateFlow") ? Action.UPDATE : Action.READ;
+                yield single(Resource.FLOW, action, tenant, bodyNamespace, bodyId);
+            }
+            case "deleteFlow", "deleteRevisions" -> single(Resource.FLOW, Action.DELETE, tenant, namespace, id);
+            case "validateFlows", "validateTask", "validateTrigger" -> metadata(tenant);
+            default -> administrative(tenant);
+        };
+    }
+
+    private List<Operation> execution(Request request, String tenant, String namespace, String id) throws Exception {
+        return switch (request.route().handler()) {
+            case "getLatestExecutions" -> {
+                JsonNode filters = yaml.readTree(request.route().body());
+                if (filters == null || !filters.isArray() || filters.isEmpty()) yield List.of();
+                var operations = new ArrayList<Operation>();
+                for (JsonNode filter : filters) {
+                    if (!filter.path("namespace").isTextual() || !filter.path("id").isTextual()) yield List.of();
+                    operations.addAll(query(Resource.EXECUTION, tenant, filter.path("namespace").asText()));
+                }
+                yield operations;
+            }
+            case "searchExecutions", "findDistinctFieldValues", "listExecutableDistinctNamespaces", "exportExecutions" -> query(Resource.EXECUTION, tenant, null);
+            case "searchExecutionsByFlowId", "listFlowExecutionsByNamespace", "getExecutionAverageDuration" -> query(Resource.EXECUTION, tenant, namespace);
+            case "getFlowFromExecution" -> single(Resource.FLOW, Action.READ, tenant, namespace, request.variable("flowId"));
+            case "getExecution", "getExecutionFlowGraph", "getFlowFromExecutionById", "followExecution", "followDependenciesExecutions" -> ownedExecution(request, tenant, Resource.EXECUTION, Action.READ);
+            case "downloadFileFromExecution", "getFileMetadatasFromExecution", "previewFileFromExecution" -> ownedExecution(request, tenant, Resource.EXECUTION, Action.ACCESS_OUTPUTS);
+            case "deleteExecution" -> ownedExecution(request, tenant, Resource.EXECUTION, Action.DELETE);
+            case "createExecution", "validateNewExecutionInputs" -> {
+                var operations = new ArrayList<>(single(Resource.FLOW, Action.READ, tenant, namespace, id));
+                operations.addAll(single(Resource.FLOW, Action.EXECUTE, tenant, namespace, id));
+                operations.addAll(single(Resource.EXECUTION, Action.CREATE, tenant, namespace, null));
+                yield operations;
+            }
+            default -> administrative(tenant);
+        };
+    }
+
+    private List<Operation> logs(Request request, String tenant, String namespace) {
+        return switch (request.route().handler()) {
+            case "searchLogs" -> query(Resource.LOG, tenant, null);
+            case "listLogsFromExecution", "downloadLogsFromExecution", "followLogsFromExecution" -> ownedExecution(request, tenant, Resource.LOG, Action.READ);
+            case "deleteLogsFromExecution" -> ownedExecution(request, tenant, Resource.LOG, Action.DELETE);
+            case "deleteLogsFromFlow" -> single(Resource.LOG, Action.DELETE, tenant, namespace, request.variable("flowId"));
+            default -> administrative(tenant);
+        };
+    }
+
+    private List<Operation> keyValue(Request request, String tenant, String namespace) {
+        return switch (request.route().handler()) {
+            case "listAllKeys" -> query(Resource.KVSTORE, tenant, namespace);
+            case "listKeysWithInheritence" -> query(Resource.KVSTORE, tenant, null);
+            case "getKeyValue" -> single(Resource.KVSTORE, Action.READ, tenant, namespace, request.variable("key"));
+            case "setKeyValue" -> single(Resource.KVSTORE, Action.UPDATE, tenant, namespace, request.variable("key"));
+            case "deleteKeyValue" -> single(Resource.KVSTORE, Action.DELETE, tenant, namespace, request.variable("key"));
+            default -> administrative(tenant);
+        };
+    }
+
+    private List<Operation> files(Request request, String tenant, String namespace) {
+        return switch (request.route().handler()) {
+            case "searchNamespaceFiles", "listNamespaceDirectoryFiles", "exportNamespaceFiles" -> query(Resource.NAMESPACE_FILE, tenant, namespace);
+            case "getFileContent", "getFileMetadatas", "getFileRevisions" -> single(Resource.NAMESPACE_FILE, Action.READ, tenant, namespace, request.route().query().getOrDefault("path", List.of("/")).getFirst());
+            case "createNamespaceDirectory", "createNamespaceFile", "moveFileDirectory" -> single(Resource.NAMESPACE_FILE, Action.UPDATE, tenant, namespace, null);
+            case "deleteFileDirectory" -> single(Resource.NAMESPACE_FILE, Action.DELETE, tenant, namespace, null);
+            default -> administrative(tenant);
+        };
+    }
+
+    private List<Operation> ownedExecution(Request request, String tenant, Resource resource, Action action) {
+        String executionId = request.variable("executionId");
+        var execution = executions.findByIdWithoutAcl(tenant, executionId).orElse(null);
+        if (execution == null || !tenant.equals(execution.getTenantId())) return List.of();
+        if (action == Action.ACCESS_OUTPUTS && request.route().controller().endsWith(".ExecutionController") && !executionFile(request, execution)) return List.of();
+        return single(resource, action, tenant, execution.getNamespace(), executionId);
+    }
+
+    private boolean executionFile(Request request, io.kestra.core.models.executions.Execution execution) {
+        List<String> paths = request.route().query().get("path");
+        if (paths == null || paths.size() != 1) return false;
+        String raw = paths.getFirst();
+        if (raw.contains("%") || raw.contains("\\")) return false;
+        URI uri = URI.create(raw);
+        if (!"kestra".equals(uri.getScheme()) || uri.isOpaque() || uri.getRawAuthority() != null
+            || uri.getRawQuery() != null || uri.getRawFragment() != null || !uri.normalize().equals(uri)) return false;
+        String prefix = io.kestra.core.storages.StorageContext.forExecution(execution).getExecutionStorageURI().getPath();
+        prefix = prefix.endsWith("/") ? prefix : prefix + "/";
+        return uri.getPath() != null && !uri.getPath().contains("//") && uri.getPath().startsWith(prefix) && uri.getPath().length() > prefix.length();
+    }
+
+    private List<Operation> metadata(String tenant) {
+        return single(Resource.METADATA, Action.READ, tenant, null, null);
+    }
+
+    private List<Operation> administrative(String tenant) {
+        return List.of(new Operation(CONTRACT_VERSION, Source.REST, Resource.SYSTEM, Action.EXECUTE, tenant, null, null,
+            QueryDomain.unrestricted(), Coverage.COMPLETE_BATCH, Aggregate.NONE, SideEffect.EXTERNAL));
+    }
+
+    private List<Operation> single(Resource resource, Action action, String tenant, String namespace, String id) {
+        return List.of(new Operation(CONTRACT_VERSION, Source.REST, resource, action, tenant, namespace, id,
+            domain(namespace, false), Coverage.SINGLE, Aggregate.NONE, effect(resource, action)));
+    }
+
+    private List<Operation> query(Resource resource, String tenant, String namespace) {
+        QueryDomain domain = domain(namespace, true);
+        return List.of(new Operation(CONTRACT_VERSION, Source.REST, resource, Action.LIST, tenant, namespace, null,
+            domain, Coverage.COMPLETE_QUERY, Aggregate.NONE, SideEffect.READ_ONLY));
+    }
+
+    private QueryDomain domain(String namespace, boolean paginated) {
+        return namespace == null ? new QueryDomain(List.of(), List.of(), List.of(), true, paginated, DomainKind.GLOBAL)
+            : new QueryDomain(List.of(namespace), List.of(), List.of(), true, paginated);
+    }
+
+    private SideEffect effect(Resource resource, Action action) {
+        return switch (action) {
+            case READ, LIST, ACCESS_OUTPUTS -> SideEffect.READ_ONLY;
+            case EXECUTE -> SideEffect.QUEUE_WRITE;
+            default -> resource == Resource.EXECUTION ? SideEffect.QUEUE_WRITE : SideEffect.STORAGE_WRITE;
+        };
+    }
+}
