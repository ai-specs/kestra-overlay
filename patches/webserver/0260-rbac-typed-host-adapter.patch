+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import io.kestra.plugin.core.dashboard.data.Executions;
+import io.kestra.plugin.core.dashboard.data.IExecutions;
+import io.kestra.core.models.dashboards.filters.EqualTo;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.context.ServerRequestContext;
+import io.micronaut.http.exceptions.HttpStatusException;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import org.junit.jupiter.api.Test;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class TypedDashboardGateTest {
+    @Test
+    @SuppressWarnings("unchecked")
+    void shouldAuthorizeActualDatasourceFiltersAndRejectUnknownOrExpressionSources() {
+        BeanProvider<TypedAuthorizationResolver> policies = mock(BeanProvider.class);
+        when(policies.isUnique()).thenReturn(true);
+        var seen = new java.util.ArrayList<Operation>();
+        when(policies.get()).thenReturn((principal, operation) -> {
+            seen.add(operation);
+            return CompletableFuture.completedFuture(Decision.allow(QueryDomain.unrestricted()));
+        });
+        var gate = new TypedDashboardGate(new RbacConfiguration(true, false), true, new TypedAuthorizationGate(policies));
+        var request = HttpRequest.GET("/api/v1/main/dashboards/charts/preview");
+        request.setAttribute(SecurityFilter.AUTHENTICATION, Authentication.build("reader", List.of("reader")));
+        ServerRequestContext.with(request, () -> {
+            gate.authorize("main", Executions.builder().type("io.kestra.plugin.core.dashboard.data.Executions")
+                .where(List.of(EqualTo.<IExecutions.Fields>builder().field(IExecutions.Fields.NAMESPACE).value("team").build())).build());
+            assertThat(seen).hasSize(1);
+            assertThat(seen.getFirst().source()).isEqualTo(Source.DASHBOARD_AGGREGATE);
+            assertThat(seen.getFirst().queryDomain().contains("team")).isTrue();
+            assertThat(seen.getFirst().queryDomain().contains("team.child")).isFalse();
+            assertThatThrownBy(() -> gate.authorize("main", Map.of("sql", "select * from executions")))
+                .isInstanceOf(HttpStatusException.class);
+            assertThatThrownBy(() -> gate.authorize("main", Executions.builder().type("{{ secret('key') }}").build()))
+                .isInstanceOf(HttpStatusException.class);
+        });
+        assertThatThrownBy(() -> gate.authorize("main", Executions.builder().build())).isInstanceOf(HttpStatusException.class);
+    }
+}
