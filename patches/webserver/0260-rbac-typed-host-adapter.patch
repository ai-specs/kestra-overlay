@@ -0,0 +1,36 @@
+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import io.kestra.core.models.QueryFilter;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+
+public final class TypedQueryDomains {
+    private TypedQueryDomains() {}
+
+    public static QueryDomain fromFilters(List<QueryFilter> filters, boolean paginated) {
+        QueryDomain result = new QueryDomain(List.of(), List.of(), List.of(), true, paginated, DomainKind.GLOBAL);
+        for (QueryFilter filter : filters) result = result.intersect(fromFilter(filter, paginated));
+        return result;
+    }
+
+    private static QueryDomain fromFilter(QueryFilter filter, boolean paginated) {
+        if (filter.isNode()) {
+            if (filter.logical() == QueryFilter.Logical.AND) return fromFilters(filter.children(), paginated);
+            var domains = filter.children().stream().map(child -> fromFilter(child, paginated)).toList();
+            if (domains.stream().anyMatch(domain -> domain.kind() == DomainKind.GLOBAL || !domain.excludedNamespaces().isEmpty()))
+                return QueryDomain.unrestricted();
+            return new QueryDomain(domains.stream().flatMap(domain -> domain.exactNamespaces().stream()).distinct().toList(),
+                domains.stream().flatMap(domain -> domain.namespaceSubtrees().stream()).distinct().toList(), List.of(), true, paginated);
+        }
+        if (filter.field() != QueryFilter.Field.NAMESPACE) return QueryDomain.unrestricted();
+        List<String> values = filter.value() instanceof List<?> list ? list.stream().map(Object::toString).toList()
+            : List.of(String.valueOf(filter.value()));
+        return switch (filter.operation()) {
+            case EQUALS, IN -> new QueryDomain(values, List.of(), List.of(), true, paginated);
+            case PREFIX -> new QueryDomain(List.of(), values, List.of(), true, paginated);
+            case NOT_EQUALS, NOT_IN -> new QueryDomain(List.of(), List.of(), values, true, paginated, DomainKind.GLOBAL);
+            default -> QueryDomain.unrestricted();
+        };
+    }
+}
