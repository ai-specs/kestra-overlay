@@ -0,0 +1,82 @@
+package io.kestra.webserver.rbac;
+
+import java.net.http.HttpClient;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionStage;
+import io.kestra.core.junit.annotations.KestraTest;
+import io.micronaut.context.annotation.Property;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.runtime.server.EmbeddedServer;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.AuthenticationFetcher;
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+import static org.assertj.core.api.Assertions.assertThat;
+
+@KestraTest(environments = "h2")
+@Property(name = "kestra.server-type", value = "WEBSERVER")
+@Property(name = "kestra.rbac.enabled", value = "true")
+@Property(name = "kestra.rbac.typed.enabled", value = "true")
+@Property(name = "micronaut.security.enabled", value = "true")
+@Property(name = "micronaut.security.filter.enabled", value = "true")
+@Property(name = "micronaut.security.intercept-url-map[0].pattern", value = "/**")
+@Property(name = "micronaut.security.intercept-url-map[0].access[0]", value = "isAnonymous()")
+@Property(name = "mcp.http.security.fixture", value = "true")
+@Property(name = "typed.rbac.http.probe", value = "true")
+class TypedRbacHttpProbeTest {
+    @Inject
+    EmbeddedServer server;
+    @Inject
+    io.kestra.core.repositories.FlowRepositoryInterface flows;
+
+    @Test
+    void shouldActivateTypedGateForRealRoutesAndDenyBeforeFlowPersistence() throws Exception {
+        var client = HttpClient.newHttpClient();
+        var read = client.send(java.net.http.HttpRequest.newBuilder(server.getURI().resolve("/api/v1/configs"))
+            .header("X-Typed-Probe", "reader").GET().build(), java.net.http.HttpResponse.BodyHandlers.ofString());
+        assertThat(read.statusCode()).isEqualTo(200);
+        var denied = client.send(java.net.http.HttpRequest.newBuilder(server.getURI().resolve("/api/v1/main/flows"))
+            .header("X-Typed-Probe", "reader").header("Content-Type", "application/x-yaml")
+            .POST(java.net.http.HttpRequest.BodyPublishers.ofString("namespace: team\nid: denied\ntasks: []"))
+            .build(), java.net.http.HttpResponse.BodyHandlers.ofString());
+        assertThat(denied.statusCode()).isEqualTo(403);
+        assertThat(denied.headers().firstValue("content-type").orElse("")).contains("application/problem+json");
+        assertThat(flows.findById("main", "team", "denied")).isEmpty();
+        for (String namespace : List.of("team", "team.child", "team2", "other")) {
+            flows.create(io.kestra.core.models.flows.GenericFlow.fromYaml("main", "namespace: " + namespace + "\nid: probe\ntasks: []"));
+        }
+        var search = client.send(java.net.http.HttpRequest.newBuilder(server.getURI().resolve("/api/v1/main/flows/search"))
+            .header("X-Typed-Probe", "reader").GET().build(), java.net.http.HttpResponse.BodyHandlers.ofString());
+        assertThat(search.statusCode()).isEqualTo(200);
+        assertThat(search.body()).contains("\"total\":1", "\"namespace\":\"team\"")
+            .doesNotContain("team.child", "team2", "other");
+        var anonymous = client.send(java.net.http.HttpRequest.newBuilder(server.getURI().resolve("/api/v1/main/flows/search"))
+            .GET().build(), java.net.http.HttpResponse.BodyHandlers.ofString());
+        assertThat(anonymous.statusCode()).isEqualTo(401);
+    }
+
+    @Singleton
+    @Requires(property = "typed.rbac.http.probe", value = "true")
+    static class ProbeIdentity implements AuthenticationFetcher<io.micronaut.http.HttpRequest<?>> {
+        public org.reactivestreams.Publisher<Authentication> fetchAuthentication(io.micronaut.http.HttpRequest<?> request) {
+            return "reader".equals(request.getHeaders().get("X-Typed-Probe"))
+                ? Mono.just(Authentication.build("reader", List.of("reader"))) : Mono.empty();
+        }
+    }
+
+    @Singleton
+    @Requires(property = "typed.rbac.http.probe", value = "true")
+    static class ProbePolicy implements TypedAuthorizationResolver {
+        public CompletionStage<Decision> authorize(RbacAuthorizer.Principal principal, Operation operation) {
+            return CompletableFuture.completedFuture(operation.resource() == Resource.METADATA
+                ? Decision.allow(QueryDomain.unrestricted()) : operation.action() == Action.LIST
+                    ? Decision.allow(new QueryDomain(List.of("team"), List.of(), List.of(), true, false))
+                    : Decision.deny("Read-only probe"));
+        }
+    }
+}
