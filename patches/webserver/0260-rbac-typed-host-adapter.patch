+package io.kestra.webserver.rbac;
+
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import io.kestra.core.models.executions.Execution;
+import io.kestra.core.repositories.ExecutionRepositoryInterface;
+import org.junit.jupiter.api.Test;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.*;
+
+class OssRestOperationAdapterTest {
+    private final ExecutionRepositoryInterface executions = mock(ExecutionRepositoryInterface.class);
+    private final OssRestOperationAdapter adapter = new OssRestOperationAdapter(executions);
+
+    @Test
+    void shouldUseMatchedResourceIdentityAndRejectConflictingYamlBeforeMutation() {
+        var create = adapter.resolve(request("FlowController", "createFlow", "POST", Map.of("tenant", "main"), "namespace: team\nid: flow", Map.of()));
+        assertThat(create).hasSize(1);
+        assertThat(create.getFirst().namespace()).isEqualTo("team");
+        assertThat(create.getFirst().action()).isEqualTo(Action.CREATE);
+        assertThat(adapter.resolve(request("FlowController", "updateFlow", "PUT", Map.of("tenant", "main", "namespace", "other", "id", "flow"),
+            "namespace: team\nid: flow", Map.of()))).isEmpty();
+        assertThat(adapter.resolve(request("FlowController", "createFlow", "POST", Map.of("tenant", "main"),
+            "namespace: team\nnamespace: other\nid: flow", Map.of()))).isEmpty();
+        verifyNoInteractions(executions);
+    }
+
+    @Test
+    void shouldResolveExecutionOwnerAndRejectForeignStoragePaths() {
+        var execution = Execution.builder().tenantId("main").namespace("team.actual").flowId("flow").id("execution").build();
+        when(executions.findByIdWithoutAcl("main", "execution")).thenReturn(Optional.of(execution));
+        var operations = adapter.resolve(request("ExecutionController", "getExecution", "GET", Map.of("tenant", "main", "executionId", "execution"), "", Map.of()));
+        assertThat(operations).hasSize(1);
+        assertThat(operations.getFirst().namespace()).isEqualTo("team.actual");
+        var outputs = adapter.resolve(request("OutputController", "getTaskOutputsInformation", "GET",
+            Map.of("tenant", "main", "executionId", "execution"), "", Map.of()));
+        assertThat(outputs).hasSize(1);
+        assertThat(outputs.getFirst().namespace()).isEqualTo("team.actual");
+        assertThat(outputs.getFirst().action()).isEqualTo(Action.ACCESS_OUTPUTS);
+        String prefix = io.kestra.core.storages.StorageContext.forExecution(execution).getExecutionStorageURI().getPath();
+        assertThat(adapter.resolve(request("ExecutionController", "downloadFileFromExecution", "GET",
+            Map.of("tenant", "main", "executionId", "execution"), "", Map.of("path", List.of("kestra://" + prefix + "/artifact.txt"))))).hasSize(1);
+        assertThat(adapter.resolve(request("ExecutionController", "downloadFileFromExecution", "GET",
+            Map.of("tenant", "main", "executionId", "execution"), "", Map.of("path", List.of("file:/etc/passwd"))))).isEmpty();
+        assertThat(adapter.resolve(request("ExecutionController", "downloadFileFromExecution", "GET",
+            Map.of("tenant", "main", "executionId", "execution"), "", Map.of("path", List.of("kestra:/other/file"))))).isEmpty();
+    }
+
+    @Test
+    void shouldPreserveCompleteQueryDomainAndRequireInstancePolicyForUnclassifiedRoutes() {
+        var list = adapter.resolve(request("FlowController", "listFlowsByNamespace", "GET", Map.of("tenant", "main", "namespace", "team"), "", Map.of())).getFirst();
+        assertThat(list.coverage()).isEqualTo(Coverage.COMPLETE_QUERY);
+        assertThat(list.queryDomain().contains("team")).isTrue();
+        assertThat(list.queryDomain().contains("team.child")).isFalse();
+        var unknown = adapter.resolve(request("FutureController", "unknownMutation", "POST", Map.of("tenant", "main"), "", Map.of())).getFirst();
+        assertThat(unknown.resource()).isEqualTo(Resource.SYSTEM);
+        assertThat(unknown.coverage()).isEqualTo(Coverage.COMPLETE_BATCH);
+        assertThat(unknown.sideEffect()).isEqualTo(SideEffect.EXTERNAL);
+        assertThat(adapter.resolve(request("FlowController", "getFlow", "GET", Map.of("tenant", "other", "namespace", "team", "id", "flow"), "", Map.of()))).isEmpty();
+        assertThat(adapter.resolve(request("PluginController", "getPluginIcons", "GET", Map.of(), "", Map.of())).getFirst().resource())
+            .isEqualTo(Resource.METADATA);
+        var latest = adapter.resolve(request("ExecutionController", "getLatestExecutions", "POST", Map.of("tenant", "main"),
+            "[{\"namespace\":\"team\",\"id\":\"flow\"}]", Map.of()));
+        assertThat(latest).hasSize(1);
+        assertThat(latest.getFirst().resource()).isEqualTo(Resource.EXECUTION);
+        assertThat(latest.getFirst().queryDomain().contains("team.child")).isFalse();
+        assertThat(adapter.resolve(request("ExecutionController", "getLatestExecutions", "POST", Map.of("tenant", "main"),
+            "[]", Map.of()))).isEmpty();
+    }
+
+    private OssRestOperationAdapter.Request request(String controller, String handler, String method,
+        Map<String, Object> variables, String body, Map<String, List<String>> query) {
+        return new OssRestOperationAdapter.Request(new RestAuthorizationResolver.Request(method, "/api/v1/main/fixture", query,
+            "application/x-yaml", body.getBytes(StandardCharsets.UTF_8), "io.kestra.webserver.controllers.api." + controller,
+            handler, List.of()), variables);
+    }
+}
