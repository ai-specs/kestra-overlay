+package io.kestra.webserver.oidc;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.Executors;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.kestra.webserver.oidc.services.OidcRegistrationService;
+import io.kestra.webserver.oidc.services.OidcClientService;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+class OidcRegistrationServiceTest extends OidcPostgresTestBase {
+    @BeforeEach
+    void clearClients() throws Exception {
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("TRUNCATE oidc_client CASCADE");
+        }
+    }
+
+    private Map<String, Object> metadata(final String redirect) {
+        return Map.of("redirect_uris", List.of(redirect), "token_endpoint_auth_method", "none",
+            "grant_types", List.of("authorization_code", "refresh_token"));
+    }
+
+    @Test
+    void publicRegistrationCreatesUniquePersistedClientWithoutSecret() {
+        final var service = new OidcRegistrationService(dataSource(), new ObjectMapper(), 10);
+        final var result = service.register(metadata("http://127.0.0.1:9999/cb"));
+        assertEquals("none", result.get("token_endpoint_auth_method"));
+        assertFalse(result.containsKey("client_secret"));
+        final var client = new OidcClientService(dataSource(), new ObjectMapper()).find((String) result.get("client_id")).orElseThrow();
+        assertTrue(client.clientSecret().isEmpty());
+        assertEquals(List.of("http://127.0.0.1:9999/cb"), client.redirectUris());
+        assertFalse(result.get("client_id").equals(service.register(metadata("https://example.org/cb")).get("client_id")));
+    }
+
+    @Test
+    void invalidRedirectsAndPrivilegedMetadataAreRejected() {
+        final var service = new OidcRegistrationService(dataSource(), new ObjectMapper(), 10);
+        for (final String redirect : List.of("http://example.org/cb", "https://user@example.org/cb",
+            "https://example.org/cb#token", "https://*.example.org/cb", "javascript:alert(1)")) {
+            assertThrows(IllegalArgumentException.class, () -> service.register(metadata(redirect)));
+        }
+        assertThrows(IllegalArgumentException.class, () -> service.register(Map.of("redirect_uris", List.of("https://example.org/cb"))));
+        assertThrows(IllegalArgumentException.class, () -> service.register(Map.of("redirect_uris", List.of("https://example.org/cb"),
+            "token_endpoint_auth_method", "none", "roles", List.of("admin"))));
+        assertThrows(IllegalArgumentException.class, () -> service.register(Map.of("redirect_uris", List.of("https://example.org/cb"),
+            "token_endpoint_auth_method", "none", "grant_types", List.of("client_credentials"))));
+    }
+
+    @Test
+    void concurrentRegistrationsCannotExceedQuota() throws Exception {
+        final var service = new OidcRegistrationService(dataSource(), new ObjectMapper(), 1);
+        try (var executor = Executors.newFixedThreadPool(2)) {
+            final var requests = executor.invokeAll(List.of(
+                () -> attempt(service), () -> attempt(service)));
+            assertEquals(1, requests.stream().mapToInt(result -> {
+                try { return (Integer) result.get(); } catch (Exception exception) { throw new IllegalStateException(exception); }
+            }).sum());
+        }
+        assertEquals(1, new OidcClientService(dataSource(), new ObjectMapper()).list().size());
+    }
+
+    private int attempt(final OidcRegistrationService service) {
+        try { service.register(metadata("https://example.org/cb")); return 1; }
+        catch (IllegalStateException exception) { return 0; }
+    }
+}
