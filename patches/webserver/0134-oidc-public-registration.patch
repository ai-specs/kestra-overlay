+package io.kestra.webserver.oidc.controllers;
+
+import java.util.Map;
+import io.kestra.webserver.oidc.services.OidcRegistrationService;
+import io.kestra.webserver.oidc.services.OidcSetupService;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.HttpStatus;
+import io.micronaut.http.annotation.Body;
+import io.micronaut.http.annotation.Controller;
+import io.micronaut.http.annotation.Post;
+import io.micronaut.scheduling.TaskExecutors;
+import io.micronaut.scheduling.annotation.ExecuteOn;
+
+@Controller("/oidc/register")
+@Requires(property = "kestra.oidc.enabled", value = "true")
+@Requires(property = "kestra.oidc.registration.enabled", value = "true")
+@ExecuteOn(TaskExecutors.IO)
+public class OidcRegistrationController {
+    private final OidcRegistrationService registration;
+    private final OidcSetupService setup;
+
+    public OidcRegistrationController(final OidcRegistrationService registration, final OidcSetupService setup) {
+        this.registration = registration;
+        this.setup = setup;
+    }
+
+    @Post
+    public HttpResponse<?> register(@Body final Map<String, Object> metadata) {
+        try {
+            if (!setup.ready()) return HttpResponse.status(HttpStatus.SERVICE_UNAVAILABLE);
+            return HttpResponse.status(HttpStatus.CREATED).body(registration.register(metadata)).header("Cache-Control", "no-store");
+        } catch (IllegalArgumentException exception) {
+            return HttpResponse.badRequest(Map.of("error", exception.getMessage()));
+        } catch (IllegalStateException exception) {
+            final boolean quota = "registration_limit_reached".equals(exception.getMessage());
+            return HttpResponse.status(quota ? HttpStatus.TOO_MANY_REQUESTS : HttpStatus.SERVICE_UNAVAILABLE)
+                .body(Map.of("error", quota ? "temporarily_unavailable" : "registration_unavailable"));
+        }
+    }
+}
diff --git a/webserver/src/main/java/io/kestra/webserver/oidc/services/OidcRegistrationService.java b/webserver/src/main/java/io/kestra/webserver/oidc/services/OidcRegistrationService.java
