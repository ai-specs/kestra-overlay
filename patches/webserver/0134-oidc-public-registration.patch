index 0000000..ae918e2
--- /dev/null
+++ b/webserver/src/main/java/io/kestra/webserver/oidc/services/OidcRegistrationService.java
@@ -0,0 +1,122 @@
+package io.kestra.webserver.oidc.services;
+
+import java.net.URI;
+import java.sql.SQLException;
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+import javax.sql.DataSource;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.context.annotation.Value;
+import io.micronaut.data.connection.jdbc.advice.DelegatingDataSource;
+import jakarta.inject.Singleton;
+
+@Singleton
+@Requires(property = "kestra.oidc.enabled", value = "true")
+@Requires(property = "kestra.oidc.registration.enabled", value = "true")
+public class OidcRegistrationService {
+    private final DataSource source;
+    private final ObjectMapper mapper;
+    private final int maximum;
+
+    public OidcRegistrationService(final DataSource source, final ObjectMapper mapper,
+        @Value("${kestra.oidc.registration.max-clients:1000}") final int maximum) {
+        this.source = DelegatingDataSource.unwrapDataSource(source);
+        this.mapper = mapper;
+        if (maximum < 1 || maximum > 100000) {
+            throw new IllegalArgumentException("Invalid registration client limit");
+        }
+        this.maximum = maximum;
+    }
+
+    public Map<String, Object> register(final Map<String, Object> request) {
+        if (!List.of("redirect_uris", "token_endpoint_auth_method", "grant_types", "response_types", "scope", "client_name")
+            .containsAll(request.keySet())) {
+            throw new IllegalArgumentException("invalid_client_metadata");
+        }
+        if (!"none".equals(request.getOrDefault("token_endpoint_auth_method", "client_secret_basic"))) {
+            throw new IllegalArgumentException("invalid_client_metadata");
+        }
+        final List<String> redirects = strings(request.get("redirect_uris"));
+        if (redirects.isEmpty() || redirects.size() > 10 || redirects.stream().distinct().count() != redirects.size()) {
+            throw new IllegalArgumentException("invalid_redirect_uri");
+        }
+        for (final String redirect : redirects) {
+            validateRedirect(redirect);
+        }
+        final List<String> grants = strings(request.getOrDefault("grant_types", List.of("authorization_code")));
+        final List<String> responses = strings(request.getOrDefault("response_types", List.of("code")));
+        if (!grants.contains("authorization_code") || !List.of("authorization_code", "refresh_token").containsAll(grants)
+            || !responses.equals(List.of("code"))) {
+            throw new IllegalArgumentException("invalid_client_metadata");
+        }
+        final Object rawScope = request.getOrDefault("scope", "openid profile email");
+        if (!(rawScope instanceof String scope) || scope.length() > 100) {
+            throw new IllegalArgumentException("invalid_client_metadata");
+        }
+        final List<String> scopes = List.of(scope.trim().split(" +"));
+        if (!scopes.contains("openid") || !List.of("openid", "profile", "email").containsAll(scopes)) {
+            throw new IllegalArgumentException("invalid_client_metadata");
+        }
+        if (request.containsKey("client_name")
+            && (!(request.get("client_name") instanceof String name) || name.length() > 200 || name.chars().anyMatch(Character::isISOControl))) {
+            throw new IllegalArgumentException("invalid_client_metadata");
+        }
+        final String clientId = "public-" + UUID.randomUUID();
+        try (var connection = source.getConnection()) {
+            connection.setAutoCommit(false);
+            try {
+                try (var lock = connection.prepareStatement("LOCK TABLE oidc_client IN SHARE ROW EXCLUSIVE MODE")) {
+                    lock.execute();
+                }
+                try (var count = connection.prepareStatement("SELECT count(*) FROM oidc_client"); var result = count.executeQuery()) {
+                    result.next();
+                    if (result.getLong(1) >= maximum) {
+                        throw new IllegalStateException("registration_limit_reached");
+                    }
+                }
+                try (var insert = connection.prepareStatement(
+                    "INSERT INTO oidc_client (client_id,client_secret,redirect_uris,grant_types,scopes) VALUES (?,'',?::jsonb,?::jsonb,?::jsonb)")) {
+                    insert.setString(1, clientId);
+                    insert.setString(2, mapper.writeValueAsString(redirects));
+                    insert.setString(3, mapper.writeValueAsString(grants));
+                    insert.setString(4, mapper.writeValueAsString(scopes));
+                    insert.executeUpdate();
+                }
+                connection.commit();
+            } catch (Exception exception) {
+                connection.rollback();
+                if (exception instanceof IllegalStateException state) throw state;
+                throw new IllegalStateException("registration_failed");
+            }
+        } catch (SQLException exception) {
+            throw new IllegalStateException("registration_failed");
+        }
+        return Map.of("client_id", clientId, "client_id_issued_at", java.time.Instant.now().getEpochSecond(),
+            "token_endpoint_auth_method", "none", "redirect_uris", redirects, "grant_types", grants,
+            "response_types", responses, "scope", String.join(" ", scopes));
+    }
+
+    private static List<String> strings(final Object value) {
+        if (!(value instanceof List<?> list) || list.size() > 10
+            || list.stream().anyMatch(item -> !(item instanceof String text) || text.length() > 2048)) {
+            throw new IllegalArgumentException("invalid_client_metadata");
+        }
+        return list.stream().map(String.class::cast).toList();
+    }
+
+    private static void validateRedirect(final String value) {
+        try {
+            final URI uri = URI.create(value);
+            final String host = uri.getHost();
+            final boolean loopback = List.of("localhost", "127.0.0.1", "[::1]", "::1").contains(host == null ? "" : host);
+            if (host == null || uri.getUserInfo() != null || uri.getRawFragment() != null || value.contains("*")
+                || !("https".equals(uri.getScheme()) || ("http".equals(uri.getScheme()) && loopback))) {
+                throw new IllegalArgumentException("invalid_redirect_uri");
+            }
+        } catch (IllegalArgumentException exception) {
+            throw new IllegalArgumentException("invalid_redirect_uri");
+        }
+    }
+}
