+package io.kestra.webserver.rbac;
+
+import io.micronaut.http.HttpMethod;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.web.router.RouteAttributes;
+import io.micronaut.web.router.resource.StaticResourceResolver;
+import jakarta.inject.Singleton;
+
+@Singleton
+public final class PublicFavicon {
+    private final StaticResourceResolver resources;
+
+    public PublicFavicon(StaticResourceResolver resources) {
+        this.resources=resources;
+    }
+
+    public boolean matches(HttpRequest<?> request) {
+        if ((request.getMethod()!=HttpMethod.GET && request.getMethod()!=HttpMethod.HEAD)
+            || !"/favicon.ico".equals(request.getPath())
+            || !"/favicon.ico".equals(request.getUri().getRawPath())
+            || request.getUri().getRawFragment()!=null
+            || RouteAttributes.getRouteMatch(request).isPresent()) return false;
+        var expected=PublicFavicon.class.getResource("/root/favicon.ico");
+        if(expected==null || resources==null)return false;
+        try {
+            return resources.resolve("/favicon.ico")
+                .filter(resource->expected.toExternalForm().equals(resource.toExternalForm())).isPresent();
+        } catch(RuntimeException failure) {
+            return false;
+        }
+    }
+}
