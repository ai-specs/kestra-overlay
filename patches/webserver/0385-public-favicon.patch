+package io.kestra.webserver.rbac;
+
+import io.kestra.webserver.errors.ProblemFactory;
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.kestra.webserver.oidc.controllers.OidcIdentityLifecycleFilter;
+import io.kestra.webserver.oidc.services.OidcIdentityLifecycle;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.HttpStatus;
+import io.micronaut.http.filter.ServerFilterChain;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import io.micronaut.web.router.MethodBasedRouteMatch;
+import io.micronaut.web.router.RouteAttributes;
+import io.micronaut.web.router.resource.StaticResourceResolver;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class PublicFaviconTest {
+    StaticResourceResolver resources() {
+        var resources=mock(StaticResourceResolver.class);
+        when(resources.resolve("/favicon.ico")).thenReturn(Optional.ofNullable(getClass().getResource("/root/favicon.ico")));
+        return resources;
+    }
+
+    void install(Object filter,PublicFavicon favicon)throws Exception {
+        var field=filter.getClass().getDeclaredField("publicFavicon");field.setAccessible(true);field.set(filter,favicon);
+    }
+
+    @Test void onlyTheConfiguredPackagedResourceIsPublic()throws Exception {
+        var resources=resources();var favicon=new PublicFavicon(resources);
+        assertTrue(favicon.matches(HttpRequest.GET("/favicon.ico")));
+        assertTrue(favicon.matches(HttpRequest.HEAD("/favicon.ico")));
+        when(resources.resolve("/favicon.ico")).thenReturn(Optional.of(java.net.URI.create("file:/untrusted/favicon.ico").toURL()));
+        assertFalse(favicon.matches(HttpRequest.GET("/favicon.ico")));
+    }
+
+    @Test void unsafePathsMethodsAndMethodRoutesNeverUseTheStaticException() {
+        var resources=resources();var favicon=new PublicFavicon(resources);
+        for(String path:List.of("/%66avicon.ico","/favicon%2eico","/other/../favicon.ico","//favicon.ico","/favicon.ico/","/favicon2.ico","/favicon.ico#fragment","/api/v1/configs"))
+            assertFalse(favicon.matches(HttpRequest.GET(path)),path);
+        for(String method:List.of("POST","PUT","DELETE","PATCH","OPTIONS"))
+            assertFalse(favicon.matches(HttpRequest.create(io.micronaut.http.HttpMethod.valueOf(method),"/favicon.ico")),method);
+        var request=HttpRequest.GET("/favicon.ico");
+        RouteAttributes.setRouteMatch(request,mock(MethodBasedRouteMatch.class));
+        assertFalse(favicon.matches(request));
+        verifyNoInteractions(resources);
+    }
+
+    @Test void missingDisabledOrFailingResolversFailClosed() {
+        assertFalse(new PublicFavicon(null).matches(HttpRequest.GET("/favicon.ico")));
+        assertFalse(new PublicFavicon(StaticResourceResolver.EMPTY).matches(HttpRequest.GET("/favicon.ico")));
+        var resources=resources();when(resources.resolve("/favicon.ico")).thenReturn(Optional.empty());
+        assertFalse(new PublicFavicon(resources).matches(HttpRequest.GET("/favicon.ico")));
+        when(resources.resolve("/favicon.ico")).thenThrow(new IllegalStateException("Unavailable resource mapping"));
+        assertFalse(new PublicFavicon(resources).matches(HttpRequest.GET("/favicon.ico")));
+    }
+
+    @Test void bothAuthorizationFiltersRetainAnonymousBusinessDenial()throws Exception {
+        var favicon=new PublicFavicon(resources());
+        var chain=mock(ServerFilterChain.class);when(chain.proceed(any())).thenReturn(Mono.just(HttpResponse.ok()));
+        var legacy=new RestRbacFilter(new RbacConfiguration(true,false),null,null,mock(ProblemFactory.class));
+        var typed=new TypedRestRbacFilter(new RbacConfiguration(true,false),null,null,mock(ProblemFactory.class));
+        install(legacy,favicon);install(typed,favicon);
+        for(var filter:List.of(legacy,typed)) {
+            assertEquals(HttpStatus.OK,Mono.from(filter.doFilter(HttpRequest.GET("/favicon.ico"),chain)).block().getStatus());
+            assertEquals(HttpStatus.UNAUTHORIZED,Mono.from(filter.doFilter(HttpRequest.GET("/api/v1/configs"),chain)).block().getStatus());
+            assertEquals(HttpStatus.UNAUTHORIZED,Mono.from(filter.doFilter(HttpRequest.POST("/favicon.ico",""),chain)).block().getStatus());
+        }
+    }
+
+    @Test void staleSessionCanReadTheIconButStillCannotReadBusinessApis()throws Exception {
+        var configuration=new OidcConfiguration();configuration.setIssuer("https://issuer.example");
+        var lifecycle=mock(OidcIdentityLifecycle.class);var filter=new OidcIdentityLifecycleFilter(configuration,lifecycle);
+        install(filter,new PublicFavicon(resources()));
+        var chain=mock(ServerFilterChain.class);when(chain.proceed(any())).thenReturn(Mono.just(HttpResponse.ok()));
+        var authentication=Authentication.build("stale",List.of(),Map.of("iss","https://issuer.example"));
+        var icon=HttpRequest.GET("/favicon.ico").setAttribute(SecurityFilter.AUTHENTICATION,authentication);
+        assertEquals(HttpStatus.OK,Mono.from(filter.doFilter(icon,chain)).block().getStatus());
+        verifyNoInteractions(lifecycle);
+        var business=HttpRequest.GET("/api/v1/configs").setAttribute(SecurityFilter.AUTHENTICATION,authentication);
+        assertEquals(HttpStatus.UNAUTHORIZED,Mono.from(filter.doFilter(business,chain)).block().getStatus());
+    }
+}
