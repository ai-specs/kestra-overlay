+package io.kestra.webserver.rbac;
+
+import io.kestra.core.junit.annotations.KestraTest;
+import io.micronaut.context.annotation.Property;
+import io.micronaut.runtime.server.EmbeddedServer;
+import jakarta.inject.Inject;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+@KestraTest(environments = "h2")
+@Property(name = "kestra.server-type", value = "WEBSERVER")
+@Property(name = "kestra.rbac.enabled", value = "true")
+@Property(name = "kestra.rbac.typed.enabled", value = "true")
+@Property(name = "micronaut.security.enabled", value = "true")
+@Property(name = "micronaut.security.filter.enabled", value = "true")
+@Property(name = "micronaut.router.static-resources.root.paths[0]", value = "classpath:root")
+@Property(name = "micronaut.router.static-resources.root.mapping", value = "/**")
+@Property(name = "micronaut.security.intercept-url-map[0].pattern", value = "/**")
+@Property(name = "micronaut.security.intercept-url-map[0].access[0]", value = "isAnonymous()")
+class PublicFaviconHttpTest {
+    @Inject EmbeddedServer server;
+
+    @Test void anonymousGetAndHeadServeTheActualPackagedIcon() throws Exception {
+        var client=HttpClient.newHttpClient();
+        byte[] expected;
+        try(var resource=getClass().getResourceAsStream("/root/favicon.ico")) {
+            assertNotNull(resource);expected=resource.readAllBytes();
+        }
+        var response=client.send(HttpRequest.newBuilder(server.getURI().resolve("/favicon.ico")).GET().build(),HttpResponse.BodyHandlers.ofByteArray());
+        assertEquals(200,response.statusCode());assertArrayEquals(expected,response.body());
+        assertTrue(response.headers().firstValue("content-type").orElse("").startsWith("image/"));
+        var head=client.send(HttpRequest.newBuilder(server.getURI().resolve("/favicon.ico")).method("HEAD",HttpRequest.BodyPublishers.noBody()).build(),HttpResponse.BodyHandlers.ofByteArray());
+        assertEquals(200,head.statusCode());assertEquals(0,head.body().length);
+        head.headers().firstValue("content-type").ifPresent(contentType->assertEquals(response.headers().firstValue("content-type").orElseThrow(),contentType));
+    }
+
+    @Test void methodsPathVariantsAndBusinessApisDoNotBecomePublic() throws Exception {
+        var client=HttpClient.newHttpClient();
+        for(String method:List.of("POST","PUT","DELETE","PATCH")) {
+            var response=client.send(HttpRequest.newBuilder(server.getURI().resolve("/favicon.ico")).method(method,HttpRequest.BodyPublishers.noBody()).build(),HttpResponse.BodyHandlers.ofByteArray());
+            assertTrue(response.statusCode()>=400,method);
+        }
+        for(String path:List.of("/favicon.ico/","/favicon.ico/unknown","/favicon2.ico","/%66avicon.ico","/favicon%2eico","/other/../favicon.ico","//favicon.ico","/api/v1/configs","/api/v1/main/flows/search")) {
+            var uri=java.net.URI.create(server.getURI().toString()+path);
+            var response=client.send(HttpRequest.newBuilder(uri).GET().build(),HttpResponse.BodyHandlers.ofByteArray());
+            assertTrue(response.statusCode()>=400,path+": "+response.statusCode());
+        }
+    }
+}
