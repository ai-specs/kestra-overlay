+@KestraTest(environments = "h2")
+@Property(name = "kestra.server-type", value = "WEBSERVER")
+@Property(name = "kestra.oidc.enabled", value = "true")
+@Property(name = "micronaut.security.enabled", value = "true")
+@Property(name = "oauth.error.test", value = "true")
+@Property(name = "micronaut.security.redirect.login-failure", value = "/oidc/login?error=1")
+class OauthAuthorizationErrorRoutingTest {
+    @Inject EmbeddedServer server;
+
+    @Test
+    void validCookieStateUsesSpecificErrorRouteAndClearsOnlyStateCookie() throws Exception {
+        HttpClient client = HttpClient.newHttpClient();
+        var start = client.send(HttpRequest.newBuilder(server.getURI().resolve("/test/oauth-error/start")).GET().build(), HttpResponse.BodyHandlers.ofString());
+        String stateCookie = start.headers().firstValue("set-cookie").orElseThrow();
+        var callback = HttpRequest.newBuilder(server.getURI().resolve("/test/oauth-error/callback?error=access_denied&error_description=evil-description&state=" + URLEncoder.encode(start.body(), StandardCharsets.UTF_8)))
+            .header("Cookie", stateCookie.substring(0, stateCookie.indexOf(';')) + "; JWT=keep; oidc_session=keep").GET().build();
+        var result = client.send(callback, HttpResponse.BodyHandlers.ofString());
+        assertEquals(303, result.statusCode());
+        assertEquals("/oidc/login?error=1", result.headers().firstValue("location").orElseThrow());
+        assertFalse(result.headers().firstValue("location").orElse("").contains("evil-description"));
+        assertFalse(result.body().contains("evil-description"));
+        assertTrue(result.headers().allValues("set-cookie").stream().anyMatch(value -> value.contains("Max-Age=0")));
+        assertTrue(result.headers().allValues("set-cookie").stream().noneMatch(value -> value.startsWith("JWT=") || value.startsWith("oidc_session=")));
+        var replay = client.send(HttpRequest.newBuilder(server.getURI().resolve("/test/oauth-error/callback?error=invalid_scope&state=" + URLEncoder.encode(start.body(), StandardCharsets.UTF_8))).GET().build(), HttpResponse.BodyHandlers.ofString());
+        assertEquals(400, replay.statusCode());
+    }
+
+    @Test
+    void absoluteConfiguredCallbackStateMatchesTrustedResolvedOrigin() throws Exception {
+        HttpClient client = HttpClient.newHttpClient();
+        var start = client.send(HttpRequest.newBuilder(server.getURI().resolve("/test/oauth-error/start?absolute=1")).GET().build(), HttpResponse.BodyHandlers.ofString());
+        String stateCookie = start.headers().firstValue("set-cookie").orElseThrow();
+        var result = client.send(HttpRequest.newBuilder(server.getURI().resolve("/test/oauth-error/callback?error=invalid_scope&state=" + URLEncoder.encode(start.body(), StandardCharsets.UTF_8)))
+            .header("Cookie", stateCookie.substring(0, stateCookie.indexOf(';'))).GET().build(), HttpResponse.BodyHandlers.ofString());
+        assertEquals(303, result.statusCode());
+        assertEquals("/oidc/login?error=1", result.headers().firstValue("location").orElseThrow());
+    }
+
+    @Test
+    void missingCookieReturns400WithoutRedirect() throws Exception {
+        var result = HttpClient.newHttpClient().send(
+            HttpRequest.newBuilder(server.getURI().resolve("/test/oauth-error/callback-missing?error=invalid_scope")).GET().build(),
+            HttpResponse.BodyHandlers.ofString());
+        assertEquals(400, result.statusCode());
+        assertTrue(result.headers().firstValue("location").isEmpty());
+    }
+
+    @Test
+    void wrongStateReturns400AndDoesNotClearStateCookie() throws Exception {
+        HttpClient client = HttpClient.newHttpClient();
+        var start = client.send(HttpRequest.newBuilder(server.getURI().resolve("/test/oauth-error/start")).GET().build(), HttpResponse.BodyHandlers.ofString());
+        String stateCookie = start.headers().firstValue("set-cookie").orElseThrow();
+        var other = client.send(HttpRequest.newBuilder(server.getURI().resolve("/test/oauth-error/start-other")).GET().build(), HttpResponse.BodyHandlers.ofString());
+        var result = client.send(HttpRequest.newBuilder(server.getURI().resolve("/test/oauth-error/callback?error=invalid_scope&state=" + URLEncoder.encode(other.body(), StandardCharsets.UTF_8)))
+            .header("Cookie", stateCookie.substring(0, stateCookie.indexOf(';'))).GET().build(), HttpResponse.BodyHandlers.ofString());
+        assertEquals(400, result.statusCode());
+        assertTrue(result.headers().allValues("set-cookie").isEmpty());
+    }
+
+    @Test
+    void malformedStateIsSafeClientErrorAndUnknownErrorIsRejected() throws Exception {
+        HttpClient client = HttpClient.newHttpClient();
+        var malformed = client.send(HttpRequest.newBuilder(server.getURI().resolve("/test/oauth-error/callback?error=invalid_scope&state=not-a-state")).GET().build(), HttpResponse.BodyHandlers.ofString());
+        assertTrue(malformed.statusCode() == 400 || malformed.statusCode() == 422);
+        assertTrue(malformed.headers().firstValue("location").isEmpty());
+        var unknown = client.send(HttpRequest.newBuilder(server.getURI().resolve("/test/oauth-error/callback-unknown?error=invalid_scope&state=x")).GET().build(), HttpResponse.BodyHandlers.ofString());
+        assertEquals(400, unknown.statusCode());
+        assertTrue(unknown.headers().firstValue("location").isEmpty());
+    }
+
+    @Test
+    void rejectsExternalFailureUrlsAndAllowsOnlySameOriginRelativeFailurePath() {
+        var state = new DefaultState();
+        state.setNonce("url-test");
+        state.setRedirectUri(URI.create("/test/oauth-error/callback"));
+        var persistence = mock(CookieStatePersistence.class);
+        when(persistence.retrieveState(any())).thenReturn(java.util.Optional.of(state));
+        var validator = mock(StateValidator.class);
+        var cookies = mock(CookieStatePersistenceConfiguration.class);
+        when(cookies.getCookieName()).thenReturn("oauth2State");
+        var redirect = mock(RedirectService.class);
+        var hostResolver = mock(HttpHostResolver.class);
+        when(hostResolver.resolve(any())).thenReturn("localhost");
+        var request = io.micronaut.http.HttpRequest.GET(URI.create("http://localhost/test/oauth-error/callback?error=invalid_scope&state=state"));
+        var exception = new AuthorizationErrorResponseException(new ErrorResponseFixture(AuthorizationErrorCode.INVALID_SCOPE, state, "evil-description"));
+        var controller = new OauthAuthorizationErrorController(redirect, validator, persistence, cookies, hostResolver);
+        for (String url : java.util.List.of("https://evil.example/login", "//evil.example/login", "/oidc/login#fragment", "/oidc\\login")) {
+            when(redirect.loginFailureUrl()).thenReturn(url);
+            assertEquals(400, controller.handle(request, exception).getStatus().getCode());
+        }
+        when(redirect.loginFailureUrl()).thenReturn("/oidc/login?error=1");
+        var sameOriginState = new DefaultState();
+        sameOriginState.setNonce("same-origin");
+        sameOriginState.setRedirectUri(URI.create("http://localhost/test/oauth-error/callback"));
+        when(persistence.retrieveState(any())).thenReturn(java.util.Optional.of(sameOriginState));
+        assertEquals(303, controller.handle(request, new AuthorizationErrorResponseException(
+            new ErrorResponseFixture(AuthorizationErrorCode.INVALID_SCOPE, sameOriginState, "evil-description"))).getStatus().getCode());
+        reset(validator);
+        for (URI callback : java.util.List.of(
+            URI.create("https://localhost/test/oauth-error/callback"),
+            URI.create("http://evil.example/test/oauth-error/callback"),
+            URI.create("http://localhost/test/oauth-error/other"))) {
+            var wrongOriginState = new DefaultState();
+            wrongOriginState.setNonce("wrong-origin");
+            wrongOriginState.setRedirectUri(callback);
+            when(persistence.retrieveState(any())).thenReturn(java.util.Optional.of(wrongOriginState));
+            var wrongException = new AuthorizationErrorResponseException(new ErrorResponseFixture(AuthorizationErrorCode.INVALID_SCOPE, wrongOriginState, "evil-description"));
+            var response = controller.handle(request, wrongException);
+            assertEquals(400, response.getStatus().getCode());
+            assertTrue(response.getCookies().isEmpty());
+        }
+        when(hostResolver.resolve(any())).thenReturn("https://public.example");
+        var httpsState = new DefaultState();
+        httpsState.setNonce("trusted-https");
+        httpsState.setRedirectUri(URI.create("https://public.example/test/oauth-error/callback"));
+        when(persistence.retrieveState(any())).thenReturn(java.util.Optional.of(httpsState));
+        var httpsController = new OauthAuthorizationErrorController(redirect, validator, persistence, cookies, hostResolver);
+        var originFormRequest = io.micronaut.http.HttpRequest.GET(URI.create("/test/oauth-error/callback?error=invalid_scope&state=state"));
+        when(redirect.loginFailureUrl()).thenReturn("/oidc/login?error=1");
+        assertEquals(303, httpsController.handle(originFormRequest,
+            new AuthorizationErrorResponseException(new ErrorResponseFixture(AuthorizationErrorCode.INVALID_SCOPE, httpsState, "evil-description"))).getStatus().getCode());
+    }
+
+    @Controller
+    @Singleton
+    @Requires(property = "oauth.error.test", value = "true")
+    static class Fixture {
+        private final StatePersistence persistence;
+        private final StateSerDes serDes;
+        @Inject EmbeddedServer embeddedServer;
+        Fixture(StatePersistence persistence, StateSerDes serDes) { this.persistence = persistence; this.serDes = serDes; }
+
+        @Get("/test/oauth-error/start")
+        io.micronaut.http.HttpResponse<?> start(io.micronaut.http.HttpRequest<?> request, @Nullable @QueryValue("absolute") String absolute) {
+            var state = new DefaultState();
+            state.setNonce("test-nonce");
+            var callbackPath = "/test/oauth-error/callback";
+            state.setRedirectUri("1".equals(absolute)
+                ? embeddedServer.getURI().resolve(callbackPath)
+                : URI.create(request.getUri().resolve(callbackPath).toString()));
+            var response = io.micronaut.http.HttpResponse.ok(serDes.serialize(state));
+            persistence.persistState(request, response, state);
+            return response;
+        }
+
+        @Get("/test/oauth-error/callback{?error,state}")
+        io.micronaut.http.HttpResponse<?> callback(@Nullable @QueryValue("state") String encodedState, @QueryValue(value = "error", defaultValue = "invalid_scope") String error, @QueryValue(value = "error_description", defaultValue = "do-not-echo") String description) {
+            if (encodedState == null || encodedState.isBlank()) {
+                throw new AuthorizationErrorResponseException(new ErrorResponseFixture(errorCode(error), null, description));
+            }
+            throw new AuthorizationErrorResponseException(new ErrorResponseFixture(errorCode(error), serDes.deserialize(encodedState), description));
+        }
+
+        private static ErrorCode errorCode(String value) {
+            try { return AuthorizationErrorCode.valueOf(value.toUpperCase(java.util.Locale.ROOT)); }
+            catch (IllegalArgumentException ignored) { return new UnknownErrorCode(); }
+        }
+
+        @Get("/test/oauth-error/start-other")
+        io.micronaut.http.HttpResponse<?> startOther(io.micronaut.http.HttpRequest<?> request) {
+            var state = new DefaultState();
+            state.setNonce("other-nonce");
+            state.setRedirectUri(URI.create(request.getUri().resolve("/test/oauth-error/callback").toString()));
+            return io.micronaut.http.HttpResponse.ok(serDes.serialize(state));
+        }
+
+        @Get("/test/oauth-error/callback-missing{?error}")
+        io.micronaut.http.HttpResponse<?> callbackMissing() {
+            throw new AuthorizationErrorResponseException(new ErrorResponseFixture(AuthorizationErrorCode.INVALID_SCOPE, null, "do-not-echo"));
+        }
+
+        @Get("/test/oauth-error/callback-unknown{?error,state}")
+        io.micronaut.http.HttpResponse<?> callbackUnknown() {
+            throw new AuthorizationErrorResponseException(new ErrorResponseFixture(new UnknownErrorCode(), null, "evil-description"));
+        }
+    }
+
+    record ErrorResponseFixture(ErrorCode getError, State getState, String getErrorDescription) implements AuthorizationErrorResponse {
+        @Override public String getErrorUri() { return null; }
+    }
+
+    record UnknownErrorCode() implements ErrorCode {
+        @Override public String getErrorCode() { return "unknown"; }
+        @Override public String getErrorCodeDescription() { return "unknown"; }
+    }
+
+    @Replaces(io.kestra.webserver.filter.TestAuthFilter.class)
+    @io.micronaut.http.annotation.Filter("/**")
+    @Requires(env = "test")
+    static class PassThroughTestAuthFilter implements HttpClientFilter {
+        @Override public Publisher<? extends io.micronaut.http.HttpResponse<?>> doFilter(MutableHttpRequest<?> request, ClientFilterChain chain) { return chain.proceed(request); }
+        @Override public int getOrder() { return ServerFilterPhase.SECURITY.order() - 1; }
+    }
+}
