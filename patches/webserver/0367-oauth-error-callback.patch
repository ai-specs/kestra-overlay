+package io.kestra.webserver.oidc.controllers;
+
+import java.net.URI;
+import java.time.Duration;
+import java.util.Set;
+
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.MutableHttpResponse;
+import io.micronaut.http.annotation.Controller;
+import io.micronaut.http.annotation.Error;
+import io.micronaut.http.cookie.Cookie;
+import io.micronaut.security.config.RedirectService;
+import io.micronaut.http.server.util.HttpHostResolver;
+import io.micronaut.security.oauth2.endpoint.authorization.response.AuthorizationErrorCode;
+import io.micronaut.security.oauth2.endpoint.authorization.response.AuthorizationErrorResponseException;
+import io.micronaut.security.oauth2.endpoint.authorization.state.State;
+import io.micronaut.security.oauth2.endpoint.authorization.state.persistence.StatePersistence;
+import io.micronaut.security.oauth2.endpoint.authorization.state.persistence.cookie.CookieStatePersistence;
+import io.micronaut.security.oauth2.endpoint.authorization.state.persistence.cookie.CookieStatePersistenceConfiguration;
+import io.micronaut.security.oauth2.endpoint.authorization.state.validation.StateValidator;
+import jakarta.inject.Singleton;
+
+@Controller
+@Singleton
+@Requires(property = "kestra.oidc.enabled", value = "true", defaultValue = "false")
+public final class OauthAuthorizationErrorController {
+    private static final Set<String> RFC_ERROR_CODES = Set.of(
+        AuthorizationErrorCode.INVALID_REQUEST.getErrorCode(),
+        AuthorizationErrorCode.UNAUTHORIZED_CLIENT.getErrorCode(),
+        AuthorizationErrorCode.ACCESS_DENIED.getErrorCode(),
+        AuthorizationErrorCode.UNSUPPORTED_RESPONSE_TYPE.getErrorCode(),
+        AuthorizationErrorCode.INVALID_SCOPE.getErrorCode(),
+        AuthorizationErrorCode.SERVER_ERROR.getErrorCode(),
+        AuthorizationErrorCode.TEMPORARILY_UNAVAILABLE.getErrorCode()
+    );
+
+    private final RedirectService redirectService;
+    private final StateValidator stateValidator;
+    private final StatePersistence statePersistence;
+    private final CookieStatePersistenceConfiguration cookieConfiguration;
+    private final HttpHostResolver hostResolver;
+
+    public OauthAuthorizationErrorController(
+        RedirectService redirectService,
+        StateValidator stateValidator,
+        StatePersistence statePersistence,
+        CookieStatePersistenceConfiguration cookieConfiguration,
+        HttpHostResolver hostResolver
+    ) {
+        this.redirectService = redirectService;
+        this.stateValidator = stateValidator;
+        this.statePersistence = statePersistence;
+        this.cookieConfiguration = cookieConfiguration;
+        this.hostResolver = hostResolver;
+    }
+
+    @Error(global = true)
+    public HttpResponse<?> handle(HttpRequest<?> request, AuthorizationErrorResponseException exception) {
+        var error = exception.getAuthorizationErrorResponse();
+        if (!RFC_ERROR_CODES.contains(error.getError().getErrorCode())) {
+            return HttpResponse.badRequest();
+        }
+        if (!(statePersistence instanceof CookieStatePersistence)) {
+            return HttpResponse.badRequest();
+        }
+        State state = error.getState();
+        if (state == null || state.getRedirectUri() == null || !callbackUriMatches(state.getRedirectUri(), request)) {
+            return HttpResponse.badRequest();
+        }
+        try {
+            var stored = statePersistence.retrieveState(request);
+            if (stored.isEmpty() || !stored.get().equals(state)) {
+                return HttpResponse.badRequest();
+            }
+            stateValidator.validate(request, state);
+        } catch (RuntimeException invalidState) {
+            return HttpResponse.badRequest();
+        }
+
+        String failureUrl = redirectService.loginFailureUrl();
+        if (failureUrl == null || !isSameOriginPath(failureUrl)) {
+            return HttpResponse.badRequest();
+        }
+        MutableHttpResponse<?> response = HttpResponse.seeOther(URI.create(failureUrl));
+        response.cookie(Cookie.of(cookieConfiguration.getCookieName(), "")
+            .configure(cookieConfiguration, request.isSecure())
+            .maxAge(Duration.ZERO));
+        return response;
+    }
+
+    private boolean callbackUriMatches(URI configured, HttpRequest<?> request) {
+        URI callback = request.getUri();
+        if (callback.getRawQuery() == null || configured.getRawPath() == null
+            || !configured.getRawPath().equals(callback.getRawPath())) {
+            return false;
+        }
+        if (configured.getScheme() == null || configured.getRawAuthority() == null) {
+            return configured.getScheme() == null && configured.getRawAuthority() == null;
+        }
+        URI trustedOrigin = trustedOrigin(request);
+        String requestScheme = callback.getScheme() == null ? trustedOrigin.getScheme() : callback.getScheme();
+        String requestAuthority = callback.getRawAuthority() == null ? trustedOrigin.getRawAuthority() : callback.getRawAuthority();
+        return configured.getScheme().equals(requestScheme)
+            && configured.getRawAuthority().equals(requestAuthority);
+    }
+
+    private URI trustedOrigin(HttpRequest<?> request) {
+        URI resolved = URI.create(hostResolver.resolve(request));
+        if (resolved.getScheme() != null && resolved.getRawAuthority() != null) {
+            return resolved;
+        }
+        return URI.create((request.isSecure() ? "https://" : "http://") + resolved);
+    }
+
+    private static boolean isSameOriginPath(String value) {
+        try {
+            URI uri = URI.create(value);
+            return uri.getScheme() == null && uri.getRawAuthority() == null && uri.getPath() != null
+                && uri.getPath().startsWith("/") && !uri.getPath().startsWith("//")
+                && uri.getFragment() == null && !value.contains("\\");
+        } catch (IllegalArgumentException invalidUri) {
+            return false;
+        }
+    }
+}
