+package io.kestra.mcp;
+
+import java.util.List;
+import java.util.Map;
+import java.util.function.BiFunction;
+import io.kestra.core.models.flows.Flow;
+import io.kestra.core.queues.DispatchQueueInterface;
+import io.kestra.core.repositories.FlowRepositoryInterface;
+import io.kestra.core.services.ExecutionStreamingService;
+import io.kestra.core.services.ExecutionOutputService;
+import io.kestra.core.runners.FlowInputOutput;
+import io.kestra.core.runners.FlowMetaStoreInterface;
+import io.kestra.plugin.core.trigger.McpToolTrigger;
+import io.kestra.webserver.mcp.McpCapabilityGate;
+import io.modelcontextprotocol.server.McpAsyncServerExchange;
+import io.modelcontextprotocol.spec.McpSchema;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+import static org.mockito.Mockito.verifyNoInteractions;
+import static org.mockito.Mockito.any;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class McpExecutionGateTest {
+    @Test
+    @SuppressWarnings("unchecked")
+    void missingCompositeScopesCannotEmitExecutionCommand() throws Exception {
+        final var queue = mock(DispatchQueueInterface.class);
+        final var inputs = mock(FlowInputOutput.class);
+        final var outputs = mock(ExecutionOutputService.class);
+        final var provider = mock(io.micronaut.context.BeanProvider.class);
+        when(provider.isPresent()).thenReturn(true);
+        final var authorizer = mock(io.kestra.webserver.mcp.McpAuthorizer.class);
+        when(provider.get()).thenReturn(authorizer);
+        when(authorizer.authorize(any(), any(), any())).thenReturn(java.util.concurrent.CompletableFuture.failedFuture(new IllegalStateException()));
+        final var gate = new McpCapabilityGate(true, true, true, provider);
+        final var service = new McpToolService(queue, mock(FlowRepositoryInterface.class), mock(FlowToolSchemaMapper.class),
+            mock(ExecutionStreamingService.class), mock(io.micronaut.context.event.ApplicationEventPublisher.class),
+            new McpConfig(new McpConfig.ToolCacheConfig(10L, java.time.Duration.ofMinutes(5)), null, java.time.Duration.ofMinutes(5)),
+            inputs, mock(FlowMetaStoreInterface.class), outputs, new DefaultMcpToolAccessControl(), gate);
+        final var flow = Flow.builder().id("flow").namespace("private.ns").tasks(List.of()).build();
+        final var trigger = McpToolTrigger.builder().id("tool").type(McpToolTrigger.class.getName()).toolName("tool").build();
+        final var method = McpToolService.class.getDeclaredMethod("buildCallHandler", Flow.class, McpToolTrigger.class);
+        method.setAccessible(true);
+        final var handler = (BiFunction<McpAsyncServerExchange, McpSchema.CallToolRequest, Mono<McpSchema.CallToolResult>>) method.invoke(service, flow, trigger);
+        final var exchange = mock(McpAsyncServerExchange.class);
+        when(exchange.transportContext()).thenReturn(KestraMcpTransportContext.builder().tenantId("main").serverId("default")
+            .userId("alice").clientId("client").resource("resource").scopes(List.of(McpCapabilityGate.EXECUTION_WRITE)).build());
+        assertTrue(handler.apply(exchange, new McpSchema.CallToolRequest("tool", Map.of())).block().isError());
+        when(exchange.transportContext()).thenReturn(KestraMcpTransportContext.builder().tenantId("main").serverId("default")
+            .userId("alice").clientId("client").resource("resource")
+            .scopes(List.of(McpCapabilityGate.FLOW_READ, McpCapabilityGate.EXECUTION_WRITE)).build());
+        assertTrue(handler.apply(exchange, new McpSchema.CallToolRequest("tool", Map.of())).block().isError());
+        verifyNoInteractions(queue, inputs, outputs);
+    }
+}
