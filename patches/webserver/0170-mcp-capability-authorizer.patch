+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.verifyNoInteractions;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.any;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class McpSessionIdentityTest {
+    @Test
+    @SuppressWarnings("unchecked")
+    void differentUserClientAndResourceCannotReuseOrDeleteSession() {
+        final var repository = mock(McpSessionRepositoryInterface.class);
+        final var queue = mock(BroadcastQueueInterface.class);
+        final var service = new McpSessionService(repository, queue);
+        when(repository.find("main", "default", "session")).thenReturn(Optional.of(
+            new McpSession("main", "default", "session", "node", "alice", false, "client-a", "resource-a")));
+        final var alice = KestraMcpTransportContext.builder().tenantId("main").serverId("default").sessionId("session")
+            .userId("alice").clientId("client-a").resource("resource-a").build();
+        assertTrue(service.sessionExists(alice));
+        for (final var context : java.util.List.of(
+            KestraMcpTransportContext.builder().tenantId("main").serverId("default").sessionId("session").userId("bob").clientId("client-a").resource("resource-a").build(),
+            KestraMcpTransportContext.builder().tenantId("main").serverId("default").sessionId("session").userId("alice").clientId("client-b").resource("resource-a").build(),
+            KestraMcpTransportContext.builder().tenantId("main").serverId("default").sessionId("session").userId("alice").clientId("client-a").resource("resource-b").build())) {
+            assertFalse(service.sessionExists(context));
+            service.close(context);
+        }
+        verify(repository, never()).delete(any(), any());
+        verifyNoInteractions(queue);
+    }
+}
diff --git a/webserver/src/test/java/io/kestra/webserver/oidc/McpCapabilityGateTest.java b/webserver/src/test/java/io/kestra/webserver/oidc/McpCapabilityGateTest.java
