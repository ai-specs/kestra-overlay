+package io.kestra.mcp;
+
+import java.util.Optional;
+import io.kestra.core.mcp.models.McpSession;
+import io.kestra.core.mcp.repositories.McpSessionRepositoryInterface;
+import io.kestra.core.queues.BroadcastQueueInterface;
+import org.junit.jupiter.api.Test;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.verifyNoInteractions;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.any;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class McpSessionIdentityTest {
+    @Test
+    @SuppressWarnings("unchecked")
+    void differentUserClientAndResourceCannotReuseOrDeleteSession() {
+        final var repository = mock(McpSessionRepositoryInterface.class);
+        final var queue = mock(BroadcastQueueInterface.class);
+        final var service = new McpSessionService(repository, queue);
+        when(repository.find("main", "default", "session")).thenReturn(Optional.of(
+            new McpSession("main", "default", "session", "node", "alice", false, "client-a", "resource-a")));
+        final var alice = KestraMcpTransportContext.builder().tenantId("main").serverId("default").sessionId("session")
+            .userId("alice").clientId("client-a").resource("resource-a").build();
+        assertTrue(service.sessionExists(alice));
+        for (final var context : java.util.List.of(
+            KestraMcpTransportContext.builder().tenantId("main").serverId("default").sessionId("session").userId("bob").clientId("client-a").resource("resource-a").build(),
+            KestraMcpTransportContext.builder().tenantId("main").serverId("default").sessionId("session").userId("alice").clientId("client-b").resource("resource-a").build(),
+            KestraMcpTransportContext.builder().tenantId("main").serverId("default").sessionId("session").userId("alice").clientId("client-a").resource("resource-b").build())) {
+            assertFalse(service.sessionExists(context));
+            service.close(context);
+        }
+        verify(repository, never()).delete(any(), any());
+        verifyNoInteractions(queue);
+    }
+}
diff --git a/webserver/src/test/java/io/kestra/webserver/oidc/McpCapabilityGateTest.java b/webserver/src/test/java/io/kestra/webserver/oidc/McpCapabilityGateTest.java
new file mode 100644
index 0000000..4bc0fc0
--- /dev/null
+++ b/webserver/src/test/java/io/kestra/webserver/oidc/McpCapabilityGateTest.java
@@ -0,0 +1,77 @@
+package io.kestra.webserver.oidc;
+
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import io.kestra.mcp.KestraMcpTransportContext;
+import io.kestra.webserver.mcp.McpAuthorizer;
+import io.kestra.webserver.mcp.McpCapabilityGate;
+import io.micronaut.context.BeanProvider;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.any;
+import static org.mockito.Mockito.eq;
+import static org.mockito.Mockito.atLeastOnce;
+import static org.mockito.Mockito.doReturn;
+
+class McpCapabilityGateTest {
+    private KestraMcpTransportContext identity(final List<String> scopes) {
+        return KestraMcpTransportContext.builder().tenantId("main").serverId("default").userId("alice")
+            .clientId("client").resource("https://example.org/api/v1/main/mcp/default").scopes(scopes).build();
+    }
+
+    @Test
+    void scopesAreIndependentAndExecutionCanBeDisabled() {
+        final var gate = new McpCapabilityGate(true, true, false, null);
+        assertTrue(gate.visible(identity(List.of(McpCapabilityGate.FLOW_READ))));
+        assertFalse(gate.execute(identity(List.of(McpCapabilityGate.FLOW_READ)), "main", "ns", "flow").block());
+        assertFalse(gate.visible(identity(List.of(McpCapabilityGate.EXECUTION_WRITE))));
+        assertFalse(gate.execute(identity(List.of(McpCapabilityGate.EXECUTION_WRITE)), "main", "ns", "flow").block());
+        assertTrue(gate.execute(identity(List.of(McpCapabilityGate.FLOW_READ, McpCapabilityGate.EXECUTION_WRITE)), "main", "ns", "flow").block());
+        assertFalse(gate.execute(identity(List.of("mcp:executions:delete")), "main", "ns", "flow").block());
+        assertFalse(new McpCapabilityGate(true, false, false, null).execute(identity(List.of(McpCapabilityGate.EXECUTION_WRITE)), "main", "ns", "flow").block());
+    }
+
+    @Test
+    @SuppressWarnings("unchecked")
+    void compositeCallRequiresReadAndExecuteForTypedResource() {
+        final BeanProvider<McpAuthorizer> provider = mock(BeanProvider.class);
+        final var authorizer = mock(McpAuthorizer.class);
+        when(provider.isPresent()).thenReturn(true);
+        when(provider.get()).thenReturn(authorizer);
+        final var gate = new McpCapabilityGate(true, true, true, provider);
+        final var context = identity(List.of(McpCapabilityGate.FLOW_READ, McpCapabilityGate.EXECUTION_WRITE));
+        when(authorizer.authorize(any(), any(), eq(McpAuthorizer.Action.READ))).thenReturn(CompletableFuture.completedFuture(false));
+        assertFalse(gate.execute(context, "main", "private.ns", "same-id").block());
+        verify(authorizer, never()).authorize(any(), any(), eq(McpAuthorizer.Action.EXECUTE));
+        when(authorizer.authorize(any(), any(), eq(McpAuthorizer.Action.READ))).thenReturn(CompletableFuture.completedFuture(true));
+        when(authorizer.authorize(any(), any(), eq(McpAuthorizer.Action.EXECUTE))).thenReturn(CompletableFuture.completedFuture(false));
+        assertFalse(gate.execute(context, "main", "private.ns", "same-id").block());
+        when(authorizer.authorize(any(), any(), eq(McpAuthorizer.Action.EXECUTE))).thenReturn(CompletableFuture.completedFuture(true));
+        assertTrue(gate.execute(context, "main", "private.ns", "same-id").block());
+        verify(authorizer, atLeastOnce()).authorize(eq(new McpAuthorizer.Principal("alice", "client",
+            context.getResource(), context.getScopes())), eq(new McpAuthorizer.FlowResource("main", "private.ns", "same-id")),
+            eq(McpAuthorizer.Action.EXECUTE));
+    }
+
+    @Test
+    @SuppressWarnings("unchecked")
+    void authorizerAbsenceExceptionsAndEmptyDecisionsFailClosed() {
+        final BeanProvider<McpAuthorizer> provider = mock(BeanProvider.class);
+        final var gate = new McpCapabilityGate(true, true, true, provider);
+        final var context = identity(List.of(McpCapabilityGate.FLOW_READ, McpCapabilityGate.EXECUTION_WRITE));
+        assertFalse(gate.execute(context, "main", "ns", "flow").block());
+        when(provider.isPresent()).thenReturn(true);
+        when(provider.get()).thenThrow(new IllegalStateException());
+        assertFalse(gate.execute(context, "main", "ns", "flow").block());
+        final var authorizer = mock(McpAuthorizer.class);
+        doReturn(authorizer).when(provider).get();
+        when(authorizer.authorize(any(), any(), any())).thenReturn(CompletableFuture.failedFuture(new IllegalStateException()));
+        assertFalse(gate.execute(context, "main", "ns", "flow").block());
+        assertFalse(gate.execute(null, "main", "ns", "flow").block());
+    }
+}
