+package io.kestra.webserver.mcp;
+
+import java.util.List;
+import java.util.concurrent.CompletionStage;
+
+public interface McpAuthorizer {
+    enum Action { READ, EXECUTE }
+    record Principal(String subject, String clientId, String resource, List<String> scopes) {}
+    record FlowResource(String tenant, String namespace, String flowId) {}
+    CompletionStage<Boolean> authorize(Principal principal, FlowResource resource, Action action);
+}
diff --git a/webserver/src/main/java/io/kestra/webserver/mcp/McpCapabilityGate.java b/webserver/src/main/java/io/kestra/webserver/mcp/McpCapabilityGate.java
new file mode 100644
index 0000000..48417d0
--- /dev/null
+++ b/webserver/src/main/java/io/kestra/webserver/mcp/McpCapabilityGate.java
@@ -0,0 +1,64 @@
+package io.kestra.webserver.mcp;
+
+import io.kestra.mcp.KestraMcpTransportContext;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.context.annotation.Value;
+import jakarta.inject.Singleton;
+import reactor.core.publisher.Mono;
+
+@Singleton
+public class McpCapabilityGate {
+    public static final String FLOW_READ = "mcp:flows:read";
+    public static final String EXECUTION_WRITE = "mcp:executions:write";
+    private final boolean oidcEnabled;
+    private final boolean executionEnabled;
+    private final boolean rbacEnabled;
+    private final BeanProvider<McpAuthorizer> authorizers;
+
+    public McpCapabilityGate(@Value("${kestra.oidc.enabled:false}") final boolean oidcEnabled,
+        @Value("${kestra.mcp.execution.enabled:true}") final boolean executionEnabled,
+        @Value("${kestra.mcp.rbac.enabled:false}") final boolean rbacEnabled,
+        final BeanProvider<McpAuthorizer> authorizers) {
+        this.oidcEnabled = oidcEnabled;
+        this.executionEnabled = executionEnabled;
+        this.rbacEnabled = rbacEnabled;
+        this.authorizers = authorizers;
+    }
+
+    public boolean visible(final KestraMcpTransportContext context) {
+        return !oidcEnabled || valid(context) && context.getScopes().contains(FLOW_READ);
+    }
+
+    public Mono<Boolean> readable(final KestraMcpTransportContext context, final String tenant,
+        final String namespace, final String flowId) {
+        if (!visible(context) || !rbacEnabled) return Mono.just(visible(context));
+        return authorize(context, tenant, namespace, flowId, McpAuthorizer.Action.READ);
+    }
+
+    public Mono<Boolean> execute(final KestraMcpTransportContext context, final String tenant,
+        final String namespace, final String flowId) {
+        if (!executionEnabled || oidcEnabled && (!valid(context)
+            || !context.getScopes().containsAll(java.util.List.of(FLOW_READ, EXECUTION_WRITE)))) return Mono.just(false);
+        if (!rbacEnabled) return Mono.just(true);
+        return authorize(context, tenant, namespace, flowId, McpAuthorizer.Action.READ)
+            .flatMap(readAllowed -> readAllowed
+                ? authorize(context, tenant, namespace, flowId, McpAuthorizer.Action.EXECUTE) : Mono.just(false));
+    }
+
+    private Mono<Boolean> authorize(final KestraMcpTransportContext context, final String tenant,
+        final String namespace, final String flowId, final McpAuthorizer.Action action) {
+        if (!valid(context) || tenant == null || namespace == null || flowId == null) return Mono.just(false);
+        return Mono.defer(() -> {
+            if (!authorizers.isPresent()) return Mono.just(false);
+            return Mono.fromCompletionStage(authorizers.get().authorize(
+                new McpAuthorizer.Principal(context.getUserId(), context.getClientId(), context.getResource(), context.getScopes()),
+                new McpAuthorizer.FlowResource(tenant, namespace, flowId), action));
+        }).defaultIfEmpty(false).onErrorReturn(false);
+    }
+
+    private boolean valid(final KestraMcpTransportContext context) {
+        return context != null && context.getUserId() != null && !context.getUserId().isBlank()
+            && context.getClientId() != null && !context.getClientId().isBlank()
+            && context.getResource() != null && !context.getResource().isBlank() && context.getScopes() != null;
+    }
+}
