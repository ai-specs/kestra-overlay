+package io.kestra.webserver.oidc.services;
+
+import java.util.List;
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.micronaut.context.annotation.Replaces;
+import io.micronaut.context.annotation.Requires;
+import jakarta.inject.Singleton;
+
+@Singleton
+@Replaces(OidcConsentPolicy.class)
+@Requires(property = "kestra.oidc.enabled", value = "true")
+public class McpOidcConsentPolicy extends OidcConsentPolicy {
+    private final OidcConfiguration configuration;
+
+    public McpOidcConsentPolicy(final OidcConfiguration configuration) {
+        this.configuration = configuration;
+    }
+
+    @Override
+    public void validate(final List<String> scopes) {
+        if (scopes.stream().filter(scope -> scope.startsWith("mcp:")).anyMatch(scope -> !configuration.getMcpScopes().contains(scope))) {
+            throw new IllegalArgumentException("MCP capability is not exposed");
+        }
+    }
+
+    @Override
+    public String description(final String scope) {
+        return switch (scope) {
+            case "mcp:flows:read" -> " — 读取工具定义和流程输出 / Read tool definitions and flow outputs";
+            case "mcp:executions:write" -> " — 执行流程，可能产生危险副作用 / Execute flows, potentially dangerous side effects";
+            default -> "";
+        };
+    }
+}
