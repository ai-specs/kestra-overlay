+package io.kestra.webserver.mcp;
+
+import java.util.List;
+import java.util.concurrent.CompletionStage;
+
+public interface McpAuthorizer {
+    enum Action { READ, EXECUTE }
+    record Principal(String subject, String clientId, String resource, List<String> scopes) {}
+    record FlowResource(String tenant, String namespace, String flowId) {}
+    CompletionStage<Boolean> authorize(Principal principal, FlowResource resource, Action action);
+}
diff --git a/webserver/src/main/java/io/kestra/webserver/mcp/McpCapabilityGate.java b/webserver/src/main/java/io/kestra/webserver/mcp/McpCapabilityGate.java
new file mode 100644
index 0000000000000000000000000000000000000000..6f6d041622f9ead05b669e039c4bc3be25e7fa23
--- /dev/null
+++ b/webserver/src/main/java/io/kestra/webserver/mcp/McpCapabilityGate.java
@@ -0,0 +1,136 @@
+package io.kestra.webserver.mcp;
+
+import io.kestra.mcp.KestraMcpTransportContext;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.context.annotation.Value;
+import jakarta.inject.Singleton;
+import reactor.core.publisher.Mono;
+
+@Singleton
+public class McpCapabilityGate {
+    public static final String FLOW_READ = "mcp:flows:read";
+    public static final String EXECUTION_WRITE = "mcp:executions:write";
+    private final boolean oidcEnabled;
+    private final boolean executionEnabled;
+    private final boolean rbacEnabled;
+    private final BeanProvider<McpAuthorizer> authorizers;
+    private io.kestra.webserver.rbac.RbacConfiguration unified;
+    private io.kestra.webserver.rbac.RbacGate gate;
+    @jakarta.inject.Inject private io.micronaut.context.BeanProvider<io.kestra.webserver.rbac.McpAuthorizationResolver> mcpResolvers;
+
+    public McpCapabilityGate(@Value("${kestra.oidc.enabled:false}") final boolean oidcEnabled,
+        @Value("${kestra.mcp.execution.enabled:true}") final boolean executionEnabled,
+        @Value("${kestra.mcp.rbac.enabled:false}") final boolean rbacEnabled,
+        final BeanProvider<McpAuthorizer> authorizers) {
+        this.oidcEnabled = oidcEnabled;
+        this.executionEnabled = executionEnabled;
+        this.rbacEnabled = rbacEnabled;
+        this.authorizers = authorizers;
+    }
+
+    @jakarta.inject.Inject
+    public McpCapabilityGate(@Value("${kestra.oidc.enabled:false}") boolean oidcEnabled,
+        @Value("${kestra.mcp.execution.enabled:true}") boolean executionEnabled,
+        @Value("${kestra.mcp.rbac.enabled:false}") boolean legacyEnabled,
+        BeanProvider<McpAuthorizer> authorizers, io.kestra.webserver.rbac.RbacConfiguration unified,
+        io.kestra.webserver.rbac.RbacGate gate) {
+        this(oidcEnabled, executionEnabled, legacyEnabled, authorizers);
+        this.unified = unified; this.gate = gate;
+    }
+
+    private boolean unifiedEnabled() { return unified != null && unified.enabled(); }
+
+    public <Result> Mono<Result> evaluation(KestraMcpTransportContext context, String tenant,
+        java.util.function.Supplier<Mono<Result>> action) {
+        if (!unifiedEnabled()) return Mono.defer(action);
+        if (!valid(context) || !java.util.Objects.equals(tenant, context.getTenantId()))
+            return Mono.error(new IllegalStateException("Invalid MCP authorization context."));
+        return gate.boundary(principal(context), tenant, action).singleOrEmpty();
+    }
+
+    public Mono<Boolean> readOutputs(KestraMcpTransportContext context, String tenant, String namespace, String executionId) {
+        if (!unifiedEnabled()) return Mono.just(true);
+        if (!valid(context)) return Mono.just(false);
+        var resource = new io.kestra.webserver.rbac.RbacAuthorizer.Resource(
+            io.kestra.webserver.rbac.RbacAuthorizer.Kind.EXECUTION,
+            io.kestra.webserver.rbac.RbacAuthorizer.Scope.NAMESPACE, tenant, namespace, executionId);
+        return gate.authorize(principal(context), resource, io.kestra.webserver.rbac.RbacAuthorizer.Action.ACCESS_OUTPUTS);
+    }
+
+    private io.kestra.webserver.rbac.RbacAuthorizer.Principal principal(KestraMcpTransportContext context) {
+        return new io.kestra.webserver.rbac.RbacAuthorizer.Principal(context.getUserId(),
+            context.getRoles() == null ? java.util.List.of() : context.getRoles(), context.getClientId(),
+            context.getResource(), context.getScopes());
+    }
+
+    public Mono<Boolean> preflight(KestraMcpTransportContext context, String tenant, String executionId,
+        io.kestra.core.models.flows.Flow flow) {
+        if (!unifiedEnabled()) return Mono.just(true);
+        if (!valid(context)) return Mono.just(false);
+        // No expression-policy heuristics: declaration-dependent reads are resolved by the consumer.
+        return Mono.defer(() -> {
+            if (mcpResolvers == null || !mcpResolvers.isUnique()) return Mono.just(false);
+            return Mono.fromCallable(() -> new io.kestra.webserver.rbac.McpAuthorizationResolver.Invocation(tenant, flow.getNamespace(),
+                flow.getId(), executionId, io.kestra.core.serializers.JacksonMapper.ofYaml().writeValueAsString(flow)))
+                .flatMap(invocation -> Mono.fromCompletionStage(mcpResolvers.get().resolve(principal(context), invocation)))
+                .flatMap(requirements -> reactor.core.publisher.Flux.fromIterable(requirements)
+                    .concatMap(requirement -> gate.authorize(principal(context), requirement.resource(), requirement.action()))
+                    .all(Boolean.TRUE::equals));
+        }).timeout(java.time.Duration.ofSeconds(10)).defaultIfEmpty(false).onErrorReturn(false);
+    }
+
+    public Mono<Boolean> outputs(KestraMcpTransportContext context, String tenant, String namespace, String executionId) {
+        if (!unifiedEnabled()) return Mono.just(true);
+        if (!valid(context)) return Mono.just(false);
+        var resource = new io.kestra.webserver.rbac.RbacAuthorizer.Resource(
+            io.kestra.webserver.rbac.RbacAuthorizer.Kind.EXECUTION,
+            io.kestra.webserver.rbac.RbacAuthorizer.Scope.NAMESPACE, tenant, namespace, executionId);
+        return gate.authorize(principal(context), resource, io.kestra.webserver.rbac.RbacAuthorizer.Action.CREATE)
+            .flatMap(allowed -> allowed ? gate.authorize(principal(context), resource,
+                io.kestra.webserver.rbac.RbacAuthorizer.Action.ACCESS_OUTPUTS) : Mono.just(false));
+    }
+
+    public boolean visible(final KestraMcpTransportContext context) {
+        return !oidcEnabled || valid(context) && context.getScopes().contains(FLOW_READ);
+    }
+
+    public Mono<Boolean> readable(final KestraMcpTransportContext context, final String tenant,
+        final String namespace, final String flowId) {
+        if (!visible(context) || !rbacEnabled && !unifiedEnabled()) return Mono.just(visible(context));
+        return authorize(context, tenant, namespace, flowId, McpAuthorizer.Action.READ);
+    }
+
+    public Mono<Boolean> execute(final KestraMcpTransportContext context, final String tenant,
+        final String namespace, final String flowId) {
+        if (!executionEnabled || oidcEnabled && (!valid(context)
+            || !context.getScopes().containsAll(java.util.List.of(FLOW_READ, EXECUTION_WRITE)))) return Mono.just(false);
+        if (!rbacEnabled && !unifiedEnabled()) return Mono.just(true);
+        return authorize(context, tenant, namespace, flowId, McpAuthorizer.Action.READ)
+            .flatMap(readAllowed -> readAllowed
+                ? authorize(context, tenant, namespace, flowId, McpAuthorizer.Action.EXECUTE) : Mono.just(false));
+    }
+
+    private Mono<Boolean> authorize(final KestraMcpTransportContext context, final String tenant,
+        final String namespace, final String flowId, final McpAuthorizer.Action action) {
+        if (!valid(context) || tenant == null || namespace == null || flowId == null) return Mono.just(false);
+        if (unifiedEnabled()) {
+            return gate.authorize(principal(context), new io.kestra.webserver.rbac.RbacAuthorizer.Resource(
+                io.kestra.webserver.rbac.RbacAuthorizer.Kind.FLOW,
+                io.kestra.webserver.rbac.RbacAuthorizer.Scope.NAMESPACE, tenant, namespace, flowId),
+                action == McpAuthorizer.Action.READ ? io.kestra.webserver.rbac.RbacAuthorizer.Action.READ
+                    : io.kestra.webserver.rbac.RbacAuthorizer.Action.EXECUTE);
+        }
+        return Mono.defer(() -> {
+            if (!authorizers.isPresent()) return Mono.just(false);
+            return Mono.fromCompletionStage(authorizers.get().authorize(
+                new McpAuthorizer.Principal(context.getUserId(), context.getClientId(), context.getResource(), context.getScopes()),
+                new McpAuthorizer.FlowResource(tenant, namespace, flowId), action));
+        }).defaultIfEmpty(false).onErrorReturn(false);
+    }
+
+    private boolean valid(final KestraMcpTransportContext context) {
+        return context != null && context.getUserId() != null && !context.getUserId().isBlank()
+            && context.getClientId() != null && !context.getClientId().isBlank()
+            && context.getResource() != null && !context.getResource().isBlank() && context.getScopes() != null;
+    }
+}
