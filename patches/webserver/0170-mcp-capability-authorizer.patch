+package io.kestra.mcp;
+
+import java.time.Duration;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+import io.kestra.core.models.flows.Flow;
+import io.kestra.core.repositories.FlowRepositoryInterface;
+import io.kestra.core.repositories.ArrayListTotal;
+import io.kestra.core.services.ExecutionOutputService;
+import io.kestra.core.services.ExecutionStreamingService;
+import io.kestra.core.runners.FlowInputOutput;
+import io.kestra.core.runners.FlowMetaStoreInterface;
+import io.kestra.core.queues.DispatchQueueInterface;
+import io.kestra.plugin.core.trigger.McpToolTrigger;
+import io.kestra.webserver.mcp.McpCapabilityGate;
+import io.kestra.webserver.rbac.*;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.data.model.Page;
+import io.micronaut.http.*;
+import io.modelcontextprotocol.spec.McpSchema;
+import io.modelcontextprotocol.spec.McpStreamableServerSession;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+class McpDynamicToolListTest {
+    static <Bean> BeanProvider<Bean> bean(Bean value) {
+        return new BeanProvider<>() {
+            public Bean get() { return value; }
+            public boolean isPresent() { return value != null; }
+            public boolean isUnique() { return value != null; }
+        };
+    }
+
+    @Test
+    void shouldUseOneFreshSnapshotForEveryListAndKeepIdentitiesSeparate() {
+        var begins = new AtomicInteger();
+        var closes = new AtomicInteger();
+        var visibleNamespace = new AtomicReference<>("team.a");
+        AuthorizationEvaluationProviderV1 provider = (principal, tenant) -> {
+            begins.incrementAndGet();
+            String snapshot = principal.subject().equals("alice") ? visibleNamespace.get() : "team.b";
+            return CompletableFuture.completedFuture(new AuthorizationEvaluationV1() {
+                public java.util.concurrent.CompletionStage<Decision> authorize(Operation operation) {
+                    visibleNamespace.set("team.b");
+                    return CompletableFuture.completedFuture(snapshot.equals(operation.namespace())
+                        ? Decision.allow(QueryDomain.unrestricted()) : Decision.deny("outside snapshot"));
+                }
+                public java.util.concurrent.CompletionStage<Void> close() {
+                    closes.incrementAndGet();
+                    return CompletableFuture.completedFuture(null);
+                }
+            });
+        };
+        var configuration = new RbacConfiguration(true, false);
+        var typed = new TypedAuthorizationGate(bean(null), new AuthorizationEvaluations(true, configuration, true, bean(provider)));
+        var capabilities = new McpCapabilityGate(true, true, false, bean(null), configuration, new RbacGate(bean(null), typed, true));
+        var repository = mock(FlowRepositoryInterface.class);
+        var flows = List.of(flow("team.a", "first"), flow("team.b", "second"));
+        when(repository.findWithNoAcl(any(), eq("main"), eq(McpToolTrigger.class))).thenReturn(new ArrayListTotal<>(flows, flows.size()));
+        var mapper = mock(FlowToolSchemaMapper.class);
+        when(mapper.buildTool(any(), any())).thenAnswer(call -> McpSchema.Tool.builder().name(((Flow) call.getArgument(0)).getId()).build());
+        var service = new McpToolService(mock(DispatchQueueInterface.class), repository, mapper,
+            mock(ExecutionStreamingService.class), event -> {}, new McpConfig(new McpConfig.ToolCacheConfig(10L, Duration.ofMinutes(5)), null, Duration.ofSeconds(5)),
+            mock(FlowInputOutput.class), mock(FlowMetaStoreInterface.class), mock(ExecutionOutputService.class), new DefaultMcpToolAccessControl(), capabilities);
+        assertThat(service.visibleToolSpecs("main", "default", io.kestra.core.models.AccessScope.global(), identity("alice")).block())
+            .extracting(spec -> spec.tool().name()).containsExactly("first");
+        assertThat(service.visibleToolSpecs("main", "default", io.kestra.core.models.AccessScope.global(), identity("alice")).block())
+            .extracting(spec -> spec.tool().name()).containsExactly("second");
+        assertThat(service.visibleToolSpecs("main", "default", io.kestra.core.models.AccessScope.global(), identity("bob")).block())
+            .extracting(spec -> spec.tool().name()).containsExactly("second");
+        assertThat(begins.get()).isEqualTo(3);
+        assertThat(closes.get()).isEqualTo(3);
+    }
+
+    @Test
+    void shouldReturnDynamicListForLocalAndRemoteSessionsAndKeepRequestId() {
+        for (boolean remote : List.of(false, true)) {
+            var sessions = mock(McpSessionService.class);
+            when(sessions.findMcpStreamableServerSession(any())).thenReturn(remote ? Optional.empty() : Optional.of(mock(McpStreamableServerSession.class)));
+            when(sessions.sessionExists(any())).thenReturn(remote);
+            var transport = new KestraFluxStreamableServerTransportProvider(new McpErrorResponseMapper(), sessions);
+            var count = new AtomicInteger();
+            transport.setToolListProvider(context -> Mono.just(count.getAndIncrement() == 0 ? List.of(McpSchema.Tool.builder().name("first").build()) : List.of()));
+            try {
+                var first = transport.handleRequest(request("tools/list", "request-1"), identity("alice")).block();
+                org.assertj.core.api.Assertions.assertThat(first.getStatus().getCode()).isEqualTo(HttpStatus.OK.getCode());
+                var result = (McpSchema.JSONRPCResponse) first.body();
+                assertThat(result.id()).isEqualTo("request-1");
+                assertThat(((McpSchema.ListToolsResult) result.result()).tools()).extracting(McpSchema.Tool::name).containsExactly("first");
+                var second = (McpSchema.JSONRPCResponse) transport.handleRequest(request("tools/list", "request-2"), identity("alice")).block().body();
+                assertThat(((McpSchema.ListToolsResult) second.result()).tools()).isEmpty();
+            } finally { transport.closeGracefully().block(); }
+        }
+    }
+
+    @Test
+    void shouldRejectMissingSessionAndMissingVisibilityProvider() {
+        var sessions = mock(McpSessionService.class);
+        when(sessions.findMcpStreamableServerSession(any())).thenReturn(Optional.empty());
+        var transport = new KestraFluxStreamableServerTransportProvider(new McpErrorResponseMapper(), sessions);
+        try {
+            org.assertj.core.api.Assertions.assertThat(transport.handleRequest(request("tools/list", "request"), identity("alice")).block().getStatus().getCode()).isEqualTo(HttpStatus.NOT_FOUND.getCode());
+            when(sessions.sessionExists(any())).thenReturn(true);
+            var response = transport.handleRequest(request("tools/list", "request"), identity("alice")).block();
+            org.assertj.core.api.Assertions.assertThat(response.getStatus().getCode()).isEqualTo(HttpStatus.INTERNAL_SERVER_ERROR.getCode());
+            assertThat(((McpSchema.JSONRPCResponse) response.body()).id()).isEqualTo("request");
+        } finally { transport.closeGracefully().block(); }
+    }
+@Test
+    void shouldReturnStableAuthorizationDenialWithoutListingOrCallingTools() {
+        var sessions = mock(McpSessionService.class);
+        when(sessions.findMcpStreamableServerSession(any())).thenReturn(Optional.of(mock(McpStreamableServerSession.class)));
+        var transport = new KestraFluxStreamableServerTransportProvider(new McpErrorResponseMapper(), sessions);
+        transport.setToolListProvider(context -> Mono.error(new AuthorizationEvaluations.EvaluationDeniedException()));
+        try {
+            var response = transport.handleRequest(request("tools/list", "missing-provider"), identity("alice")).block();
+            assertThat(response.getStatus().getCode()).isEqualTo(HttpStatus.FORBIDDEN.getCode());
+            var rpc = (McpSchema.JSONRPCResponse) response.body();
+            assertThat(rpc.id()).isEqualTo("missing-provider");
+            assertThat(rpc.result()).isNull();
+            assertThat(rpc.error().code()).isEqualTo(-32003);
+        } finally { transport.closeGracefully().block(); }
+    }
+
+
+    private static MutableHttpRequest<String> request(String method, String id) {
+        return HttpRequest.POST("/mcp", "{\"jsonrpc\":\"2.0\",\"method\":\"" + method + "\",\"id\":\"" + id + "\",\"params\":{}}")
+            .accept(MediaType.APPLICATION_JSON_TYPE, MediaType.TEXT_EVENT_STREAM_TYPE).header("Mcp-Session-Id", "session");
+    }
+
+    private static KestraMcpTransportContext identity(String subject) {
+        return KestraMcpTransportContext.builder().tenantId("main").serverId("default").sessionId("session").userId(subject)
+            .clientId("client").resource("resource").roles(List.of()).scopes(List.of(McpCapabilityGate.FLOW_READ)).build();
+    }
+
+    private static Flow flow(String namespace, String name) {
+        return Flow.builder().tenantId("main").namespace(namespace).id(name).tasks(List.of())
+            .triggers(List.of(McpToolTrigger.builder().id("tool").type(McpToolTrigger.class.getName()).toolName(name).build())).build();
+    }
+}
