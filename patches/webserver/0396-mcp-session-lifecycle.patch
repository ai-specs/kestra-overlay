+            var message=mapper.readValue(String.valueOf(events.get(0).getData()),McpSchema.JSONRPCResponse.class);
+            require(requestMessage.id().equals(message.id()) && message.error()==null,"ephemeral response must preserve ID without JSON-RPC error");
+            var result=mapper.convertValue(message.result(),McpSchema.CallToolResult.class);
+            require(Boolean.FALSE.equals(result.isError()) && result.content().size()==1
+                && result.content().get(0) instanceof McpSchema.TextContent text && text.text().equals("echo:hello-from-remote") && invoked.get()==1,
+                "real handler must execute exactly once and return the complete expected payload");
+            require(ephemeral.get()!=null && service.listMcpStreamableServerSession().isEmpty()
+                && repository.find(context.getTenantId(),context.getServerId(),context.getSessionId()).orElseThrow().equals(remote),
+                "ephemeral tool call must not take persistent/local ownership from the remote node");
+            return response;
+        } catch(java.io.IOException error) {throw new AssertionError(error);}
+        finally {if(ephemeral.get()!=null)ephemeral.get().close();provider.closeGracefully().block(Duration.ofSeconds(2));}
+    }
+
+    static HttpResponse<?> crossNodeVisibleToolsWithoutEphemeralSession(McpSessionService service,
+        McpSessionRepositoryInterface repository, KestraMcpTransportContext context, McpSchema.JSONRPCRequest requestMessage) {
+        var remote=new McpSession(context.getTenantId(),context.getServerId(),context.getSessionId(),"other-server-instance-id",
+            context.getUserId(),false,context.getClientId(),context.getResource(),context.getRoles());
+        repository.save(remote);
+        var provider=new KestraFluxStreamableServerTransportProvider(new McpErrorResponseMapper(),service);
+        var visibilityIdentity=new AtomicReference<KestraMcpTransportContext>();var factoryCalls=new AtomicInteger();
+        provider.setToolListProvider(identity -> {visibilityIdentity.set(identity);return Mono.just(List.of(McpSchema.Tool.builder().name("visible-only").description("visible tool").build()));});
+        provider.setSessionFactory(request -> {factoryCalls.incrementAndGet();throw new AssertionError("tools/list must use visibility provider, not ephemeral session");});
+        var mapper=new io.modelcontextprotocol.json.jackson3.JacksonMcpJsonMapper(tools.jackson.databind.json.JsonMapper.builder().build());
+        try {
+            require(requestMessage.method().equals("tools/list"),"exact list branch required");
+            var request=HttpRequest.POST("/api/v1/"+context.getTenantId()+"/mcp/"+context.getServerId(),mapper.writeValueAsString(requestMessage))
+                .accept(MediaType.APPLICATION_JSON_TYPE,MediaType.TEXT_EVENT_STREAM_TYPE).header("Mcp-Session-Id",context.getSessionId());
+            var response=provider.handleRequest(request,context).block(Duration.ofSeconds(2));
+            require(response!=null && response.code()==200,"cross-node tools/list must return HTTP200 with a visibility provider");
+            var message=(McpSchema.JSONRPCResponse)response.body();var result=(McpSchema.ListToolsResult)message.result();
+            require(message.error()==null && requestMessage.id().equals(message.id()) && result.tools().size()==1
+                && result.tools().get(0).name().equals("visible-only") && result.nextCursor()==null,"tools/list must contain the exact visible payload and request ID");
+            require(visibilityIdentity.get()==context && factoryCalls.get()==0 && service.listMcpStreamableServerSession().isEmpty()
+                && repository.find(context.getTenantId(),context.getServerId(),context.getSessionId()).orElseThrow().equals(remote),
+                "tools/list must use the actual caller visibility and preserve remote ownership without an ephemeral session");
+            return response;
+        } catch(java.io.IOException error){throw new AssertionError(error);}
+        finally {provider.closeGracefully().block(Duration.ofSeconds(2));}
+    }
+
+    @Test void remoteToolCallUsesRealEphemeralHandlerAndPayload() {
+        var e=new QueueAndRepository();var service=new McpSessionService(e.repository,e.queue);service.start();
+        try {crossNodeToolCallWithPayload(service,e.repository,identity("remote-call"));}finally{service.stop();}
+    }
+
+    @Test void remoteToolsListUsesVisibilityProviderWithoutEphemeralSession() {
+        var e=new QueueAndRepository();var service=new McpSessionService(e.repository,e.queue);service.start();
+        try {crossNodeVisibleToolsWithoutEphemeralSession(service,e.repository,identity("remote-list"),new McpSchema.JSONRPCRequest("2.0","tools/list","cross-node-list",null));}finally{service.stop();}
+    }
+
+}
