+                log.warn("Failed to close deleted MCP session {}", session.getId(), failure);
+            }
+
+            @Override
+            protected void hookFinally(SignalType type) {
+                try {
+                    if (type != SignalType.ON_COMPLETE) {
+                        releaseListener.run();
