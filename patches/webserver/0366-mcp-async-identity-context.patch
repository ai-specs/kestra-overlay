+class McpAsyncIdentityContextTest {
+    record JdbcMarker() implements io.micronaut.core.propagation.PropagatedContextElement {}
+
+    static <Bean> BeanProvider<Bean> bean(Bean value) {
+        return new BeanProvider<>() {
+            public Bean get() { return value; }
+            public boolean isPresent() { return value != null; }
+            public boolean isUnique() { return value != null; }
+        };
+    }
+
+    @Test void allowedOutput() throws Exception { runCompleteHandler(false, false); }
+    @Test void epochRevokedWhileWaiting() throws Exception { runCompleteHandler(false, true); }
+    @Test void accountRevokedWhileWaiting() throws Exception { runCompleteHandler(true, true); }
+    @Test void missingHttpOrigin() throws Exception { runCompleteHandler(false, false, null); }
+    @Test void mismatchedSubject() throws Exception { runCompleteHandler(false, false, "bob"); }
+
+    void runCompleteHandler(boolean denyComposite, boolean revokeOutput) throws Exception {
+        runCompleteHandler(denyComposite, revokeOutput, "alice");
+    }
+    @SuppressWarnings("unchecked")
+    void runCompleteHandler(boolean denyComposite, boolean revokeOutput, String originSubject) throws Exception {
+        var begins = new AtomicInteger();
+        var closes = new AtomicInteger();
+        var identities = new java.util.concurrent.CopyOnWriteArrayList<RbacAuthorizer.Principal>();
+        var epoch = new AtomicInteger(7);
+        var active = new java.util.concurrent.atomic.AtomicBoolean(true);
+        var revision = new AtomicInteger();
+        AuthorizationEvaluationProviderV2 provider = (trusted, tenant) -> {
+            var principal = new RbacAuthorizer.Principal(trusted.subject(), List.of("reader"), "client", "resource", List.of());
+            assertThat(io.micronaut.core.propagation.PropagatedContext.getOrEmpty().find(JdbcMarker.class)).isEmpty();
+            int boundary = begins.incrementAndGet();
+            if (boundary != 2) assertThat(io.kestra.core.repositories.AuthorizationEvaluationContext.current()).isEmpty();
+            int snapshot = revision.get();
+            identities.add(principal);
+            return CompletableFuture.completedFuture(new AuthorizationEvaluationV1() {
+                public CompletionStage<Decision> authorize(Operation operation) {
+                    assertThat(operation.tenant()).isEqualTo("main");
+                    if (boundary == 3) assertThat(operation.action()).isEqualTo(Action.ACCESS_OUTPUTS);
+                    revision.set(1);
+
+                    return CompletableFuture.completedFuture(Decision.allow(QueryDomain.unrestricted()));
+                }
+                private final java.util.concurrent.atomic.AtomicBoolean closed = new java.util.concurrent.atomic.AtomicBoolean();
+                public CompletionStage<Void> close() { assertThat(closed.compareAndSet(false, true)).isTrue(); closes.incrementAndGet(); return CompletableFuture.completedFuture(null); }
+            });
+        };
+        var configuration = new RbacConfiguration(true, false);
+        var projection = mock(io.kestra.webserver.oidc.ApplicationGroupProtocolProjectionV1.class);
+        var protocol = mock(io.kestra.webserver.oidc.OidcProtocolStateV1.class);
+        var source = mock(javax.sql.DataSource.class);
+        var connection = mock(java.sql.Connection.class);
+        when(source.getConnection()).thenReturn(connection);
+        when(protocol.account(connection,"https://issuer.invalid","alice")).thenAnswer(call -> Optional.of(
+            new io.kestra.webserver.oidc.OidcProtocolStateV1.Account("https://issuer.invalid","alice",active.get(),active.get(),3)));
+        when(protocol.client(connection,"https://issuer.invalid","client")).thenReturn(Optional.of(
+            new io.kestra.webserver.oidc.OidcProtocolStateV1.Client("https://issuer.invalid","client",true,java.util.Set.of("openid"),false)));
+        when(projection.current(eq(connection),any())).thenAnswer(call -> new io.kestra.webserver.oidc.ApplicationGroupProtocolProjectionV1.Result(1,true,Optional.of(
+            new io.kestra.webserver.oidc.ApplicationGroupProtocolProjectionV1.Projection("applicationGroup","main","https://issuer.invalid","client","alice",
+                true,true,19,epoch.get(),java.util.Set.of("resource"),List.of(new io.kestra.webserver.oidc.ApplicationGroupProtocolProjectionV1.Scope("read","Reader","")),
+                java.util.Set.of("read"),java.util.Set.of("read")))));
+        var oidc = new io.kestra.webserver.oidc.OidcConfiguration();
+        oidc.setIssuer("https://issuer.invalid");
+        var identity = new io.kestra.webserver.oidc.services.OidcTrustedIdentity(bean(projection),protocol,oidc,source);
+        var typed = new TypedAuthorizationGate(bean(null), new AuthorizationEvaluations(true, configuration, true, bean(null), bean(provider), bean(identity), true));
+        var gate = new McpCapabilityGate(true, true, false, bean(null), configuration, new RbacGate(bean(null), typed, true));
+        var resolver = McpCapabilityGate.class.getDeclaredField("mcpResolvers");
+        resolver.setAccessible(true);
+        McpAuthorizationResolver dependencies = (principal, invocation) -> CompletableFuture.completedFuture(List.of());
+        resolver.set(gate, bean(dependencies));
+        var queue = mock(DispatchQueueInterface.class);
+        var inputs = mock(FlowInputOutput.class);
+        when(inputs.resolveInputs(any(), any(), any(), any())).thenAnswer(invocation -> {
+            assertThat(begins.get()).isEqualTo(2);
+            assertThat(closes.get()).isZero();
+            return List.of();
+        });
+        var outputs = mock(ExecutionOutputService.class);
+        when(outputs.getOutputs(any())).thenAnswer(invocation -> {
+            assertThat(begins.get()).isEqualTo(3);
+            assertThat(closes.get()).isEqualTo(2);
+            return Map.of("value", "verified");
+        });
+        var meta = mock(FlowMetaStoreInterface.class);
+        when(meta.findByIdForRuntime(any(), any(), any(), any())).thenReturn(Optional.empty());
+        var streaming = mock(ExecutionStreamingService.class);
+        var emitted = new java.util.concurrent.atomic.AtomicReference<Execution>();
+        ApplicationEventPublisher<CrudEvent<Execution>> publisher = event -> emitted.set(event.getModel());
+        doAnswer(invocation -> {
+            assertThat(closes.get()).isEqualTo(2);
+            FluxSink<Event<Execution>> sink = invocation.getArgument(2);
+            Thread.ofPlatform().name("mcp-independent-execution-event").start(() -> {
+                assertThat(io.kestra.core.repositories.AuthorizationEvaluationContext.current()).isEmpty();
+                if (revokeOutput) {
+                    if (denyComposite) active.set(false);
+                    else epoch.incrementAndGet();
+                }
+                sink.next(Event.of(emitted.get().withState(State.Type.SUCCESS)));
+                sink.complete();
+            });
+            return null;
+        }).when(streaming).registerSubscriber(anyString(), anyString(), any(), any());
+        var service = new McpToolService(queue, mock(FlowRepositoryInterface.class), mock(FlowToolSchemaMapper.class), streaming,
+            publisher, new McpConfig(new McpConfig.ToolCacheConfig(10L, java.time.Duration.ofMinutes(5)), null, java.time.Duration.ofSeconds(5)),
+            inputs, meta, outputs, new DefaultMcpToolAccessControl(), gate);
+        var flow = Flow.builder().tenantId("main").id("flow").namespace("team").tasks(List.of()).build();
+        var trigger = McpToolTrigger.builder().id("tool").type(McpToolTrigger.class.getName()).toolName("tool").build();
+        var method = McpToolService.class.getDeclaredMethod("buildCallHandler", Flow.class, McpToolTrigger.class);
+        method.setAccessible(true);
+        var handler = (BiFunction<McpAsyncServerExchange, McpSchema.CallToolRequest, Mono<McpSchema.CallToolResult>>) method.invoke(service, flow, trigger);
+        var exchange = mock(McpAsyncServerExchange.class);
+        when(exchange.transportContext()).thenReturn(KestraMcpTransportContext.builder().tenantId("main").serverId("default")
+            .sessionId("session").userId("alice").roles(List.of("reader")).clientId("client").resource("resource")
+            .scopes(List.of(McpCapabilityGate.FLOW_READ, McpCapabilityGate.EXECUTION_WRITE)).build());
+        var request = io.micronaut.http.HttpRequest.POST("/mcp", "");
+        var claim = Map.of("application_group_id", "applicationGroup", "client_id", "client", "authorization_version", 7L,
+            "application_group_scopes", java.util.Set.of("read"), "protocol_scopes", java.util.Set.of("openid"));
+        request.setAttribute("io.kestra.mcp.authentication", io.micronaut.security.authentication.Authentication.build(originSubject == null ? "alice" : originSubject, List.of(),
+            Map.of("iss", "https://issuer.invalid", "aud", List.of("resource"), "resource", "resource",
+                io.kestra.webserver.oidc.services.OidcTrustedIdentity.CLAIM, claim,
+                io.kestra.webserver.oidc.services.OidcIdentityLifecycle.CLAIM, 3L)));
+        Mono<McpSchema.CallToolResult> operation;
+        var invocation = io.micronaut.core.propagation.PropagatedContext.empty();
+        if (originSubject != null) invocation = invocation.plus(new io.kestra.core.repositories.AuthorizationInvocationContext(request, false));
+        try (var ignored = invocation
+            .plus(new JdbcMarker()).plus(new io.kestra.core.repositories.AuthorizationEvaluationContext(new Object())).propagate()) {
+            operation = handler.apply(exchange, new McpSchema.CallToolRequest("tool", Map.of()));
+        }
+        var result = operation.block(java.time.Duration.ofSeconds(10));
+        if (originSubject == null || !originSubject.equals("alice")) {
+            assertThat(result.isError()).isTrue();
+            assertThat(begins.get()).isZero();
+            assertThat(closes.get()).isZero();
+            verifyNoInteractions(queue, inputs, outputs, streaming);
+            return;
+        }
+        assertThat(result.isError()).isEqualTo(denyComposite || revokeOutput);
+        if (!denyComposite && !revokeOutput) assertThat(result.structuredContent()).isEqualTo(Map.of("value", "verified"));
+        assertThat(begins.get()).isEqualTo(revokeOutput ? 2 : 3);
+        assertThat(closes.get()).isEqualTo(begins.get());
+        assertThat(identities).allSatisfy(principal -> {
+            assertThat(principal.subject()).isEqualTo("alice");
+            assertThat(principal.clientId()).isEqualTo("client");
+            assertThat(principal.audience()).isEqualTo("resource");
+            assertThat(principal.roles()).containsExactly("reader");
+        });
+        {
+            verify(queue).emit(any(io.kestra.core.executor.command.ExecutionCommand.class));
+            verify(streaming, timeout(5000)).unregisterSubscriber(anyString(), anyString());
+            if (revokeOutput) verifyNoInteractions(outputs);
+        }
+    }
+}
