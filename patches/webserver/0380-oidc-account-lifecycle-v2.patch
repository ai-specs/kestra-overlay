@@ -0,0 +1,31 @@
+package io.kestra.webserver.oidc;
+
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.Objects;
+
+public interface IdentityLifecycleParticipantV1 {
+    int CONTRACT_VERSION = 1;
+
+    void beforeChange(Connection connection, Change change) throws SQLException;
+
+    enum Kind { ACCOUNT_DELETE, ACCOUNT_ACTIVATE, ACCOUNT_DEACTIVATE, PASSWORD_RESET, CLIENT_SECRET_ROTATE }
+
+    record Change(int contractVersion, Kind kind, String issuer, String subject, String clientId,
+                  TrustedIdentityV1.Identity actor) {
+        public Change {
+            if (contractVersion != CONTRACT_VERSION) throw new IllegalArgumentException("Unsupported lifecycle contract");
+            Objects.requireNonNull(kind);
+            Objects.requireNonNull(actor);
+            OidcProtocolValues.issuer(issuer);
+            if (!issuer.equals(actor.issuer())) throw new IllegalArgumentException("Lifecycle issuer mismatch");
+            if (kind == Kind.CLIENT_SECRET_ROTATE) {
+                OidcProtocolValues.opaque(clientId);
+                if (subject != null) throw new IllegalArgumentException("Unexpected account target");
+            } else {
+                OidcProtocolValues.opaque(subject);
+                if (clientId != null) throw new IllegalArgumentException("Unexpected client target");
+            }
+        }
+    }
+}
