+    static final String ISSUER="https://issuer.example";
+    <Value> BeanProvider<Value> provider(Value value) {
+        var provider=mock(BeanProvider.class);when(provider.isUnique()).thenReturn(true);when(provider.get()).thenReturn(value);return provider;
+    }
+
+    @Test void deletedActorWaitingForSecurityLockIsForbiddenWithoutParticipantWrites()throws Exception {race("delete");}
+    @Test void disabledActorWaitingForSecurityLockIsForbiddenWithoutParticipantWrites()throws Exception {race("disable");}
+    @Test void changedAuthenticationVersionWaitingForSecurityLockIsForbiddenWithoutParticipantWrites()throws Exception {race("version");}
+    @Test void revokedGrantWaitingForSecurityLockIsForbiddenWithoutParticipantWrites()throws Exception {race("revoke");}
+
+    void race(String mutation)throws Exception {
+        try(var fixture=new OidcAccountLifecycleGuardPostgresTest.Fixture()) {
+            try(var connection=fixture.source.getConnection();var statement=connection.createStatement()) {
+                statement.execute("CREATE TABLE trusted_identity_test_projection (singleton BOOLEAN PRIMARY KEY, granted BOOLEAN NOT NULL)");
+                statement.execute("INSERT INTO trusted_identity_test_projection VALUES(true,true)");
+            }
+            ApplicationGroupProtocolProjectionV1 projection=(connection,request)->{
+                boolean granted;
+                try(var statement=connection.createStatement();var rows=statement.executeQuery("SELECT granted FROM trusted_identity_test_projection WHERE singleton")) {
+                    assertTrue(rows.next());granted=rows.getBoolean(1);
+                }
+                return new ApplicationGroupProtocolProjectionV1.Result(1,true,Optional.of(new ApplicationGroupProtocolProjectionV1.Projection(
+                    "group","main",ISSUER,"ui","first",true,true,1,2,Set.of("ui"),
+                    List.of(new ApplicationGroupProtocolProjectionV1.Scope("manage","Manage","")),Set.of("manage"),granted?Set.of("manage"):Set.of())));
+            };
+            var attemptingLock=new CountDownLatch(1);
+            var borrowedConnection=new java.util.concurrent.atomic.AtomicReference<Connection>();
+            var protocol=spy(fixture.protocol);
+            doAnswer(call->{
+                if(call.getArgument(0)==borrowedConnection.get())attemptingLock.countDown();
+                return call.callRealMethod();
+            }).when(protocol).lockSecurityState(any(Connection.class));
+            var identity=new OidcTrustedIdentity(provider(projection),protocol,fixture.configuration,fixture.source);
+            var authentication=Authentication.build("first",List.of(),Map.of("iss",ISSUER,"aud",Set.of("ui"),"authentication_version",0L,
+                OidcTrustedIdentity.CLAIM,Map.of("application_group_id","group","client_id","ui","authorization_version",2L,
+                    "application_group_scopes",Set.of("manage"),"protocol_scopes",Set.of("openid"))));
+            assertEquals("first",identity.validate(authentication).subject());
+            var participant=mock(IdentityLifecycleParticipantV1.class);
+            var dispatch=new OidcLifecycleParticipants(provider(participant),provider((TrustedIdentityV2)identity),fixture.configuration);
+            try(var winner=fixture.source.getConnection();var borrowed=fixture.source.getConnection();var executor=Executors.newSingleThreadExecutor()) {
+                winner.setAutoCommit(false);winner.setTransactionIsolation(Connection.TRANSACTION_READ_COMMITTED);
+                borrowed.setAutoCommit(false);borrowed.setTransactionIsolation(Connection.TRANSACTION_READ_COMMITTED);
+                var checked=spy(borrowed);borrowedConnection.set(checked);
+                int backend;
+                try(var statement=borrowed.createStatement();var rows=statement.executeQuery("SELECT pg_backend_pid()")){assertTrue(rows.next());backend=rows.getInt(1);}
+                fixture.protocol.lockSecurityState(winner);
+                var task=executor.submit(()->{
+                    var request=HttpRequest.DELETE("/api/v1/test").setAttribute(SecurityFilter.AUTHENTICATION,authentication);
+                    try(var scope=PropagatedContext.getOrEmpty().plus(new AuthorizationInvocationContext(request,false)).propagate()) {
+                        return assertThrows(IdentityLifecycleGuardV1.Rejected.class,()->dispatch.beforeChange(checked,IdentityLifecycleParticipantV1.Kind.ACCOUNT_DELETE,"other",null)).failure();
+                    }
+                });
+                assertTrue(attemptingLock.await(5,TimeUnit.SECONDS));
+                boolean waiting=false;long deadline=System.nanoTime()+TimeUnit.SECONDS.toNanos(5);
+                while(System.nanoTime()<deadline&&!waiting) {
+                    try(var statement=winner.prepareStatement("SELECT wait_event_type FROM pg_stat_activity WHERE pid=?")) {
+                        statement.setInt(1,backend);try(var rows=statement.executeQuery()){waiting=rows.next()&&"Lock".equals(rows.getString(1));}
+                    }
+                    if(!waiting)Thread.sleep(10);
+                }
+                assertTrue(waiting,"Borrowed identity lookup must actually wait on PostgreSQL security lock");
+                try(var statement=winner.createStatement()) {
+                    switch(mutation) {
+                        case "delete"->{statement.executeUpdate("DELETE FROM oidc_user_auth_method WHERE user_id='first'");statement.executeUpdate("DELETE FROM oidc_user WHERE username='first'");}
+                        case "disable"->statement.executeUpdate("UPDATE oidc_user SET user_state='INACTIVE' WHERE username='first'");
+                        case "version"->statement.executeUpdate("UPDATE oidc_user SET authentication_version=authentication_version+1 WHERE username='first'");
+                        case "revoke"->statement.executeUpdate("UPDATE trusted_identity_test_projection SET granted=false WHERE singleton");
+                        default->throw new IllegalArgumentException("Unknown test mutation");
+                    }
+                }
+                winner.commit();
