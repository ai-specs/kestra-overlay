+package io.kestra.webserver.oidc.services;
+
+import io.kestra.webserver.oidc.IdentityLifecycleGuardV1;
+import io.kestra.webserver.oidc.IdentityLifecycleParticipantV1;
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.kestra.webserver.oidc.TrustedIdentityV2;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.context.annotation.Requires;
+import jakarta.inject.Singleton;
+import java.sql.Connection;
+import java.sql.SQLException;
+
+@Singleton
+@Requires(property = "kestra.oidc.enabled", value = "true")
+public final class OidcLifecycleParticipants {
+    private final BeanProvider<IdentityLifecycleParticipantV1> participants;
+    private final BeanProvider<TrustedIdentityV2> identities;
+    private final OidcConfiguration configuration;
+
+    public OidcLifecycleParticipants(BeanProvider<IdentityLifecycleParticipantV1> participants,
+                                    BeanProvider<TrustedIdentityV2> identities, OidcConfiguration configuration) {
+        this.participants = participants;
+        this.identities = identities;
+        this.configuration = configuration;
+    }
+
+    public void beforeChange(Connection connection, IdentityLifecycleParticipantV1.Kind kind,
+                             String subject, String clientId) throws SQLException {
+        if (!participants.isUnique() || !identities.isUnique()) throw unavailable();
+        try {
+            var actor = identities.get().current(connection);
+            if (actor == null) throw unavailable();
+            if (kind == IdentityLifecycleParticipantV1.Kind.ACCOUNT_DELETE && actor.subject().equals(subject))
+                throw new IdentityLifecycleGuardV1.Rejected(IdentityLifecycleGuardV1.Failure.FORBIDDEN);
+            participants.get().beforeChange(connection, new IdentityLifecycleParticipantV1.Change(
+                1, kind, configuration.getIssuer(), subject, clientId, actor));
+        } catch (IdentityLifecycleGuardV1.Rejected rejected) {
+            throw rejected;
+        } catch (SQLException | RuntimeException failure) {
+            throw unavailable();
+        }
+    }
+
+    private static IdentityLifecycleGuardV1.Rejected unavailable() {
+        return new IdentityLifecycleGuardV1.Rejected(IdentityLifecycleGuardV1.Failure.UNAVAILABLE);
+    }
+}
