@@ -0,0 +1,48 @@
+package io.kestra.webserver.oidc;
+
+import io.kestra.core.repositories.AuthorizationInvocationContext;
+import io.kestra.webserver.oidc.services.OidcTrustedIdentity;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.core.propagation.PropagatedContext;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import java.sql.Connection;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import javax.sql.DataSource;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class TrustedIdentityBorrowedConnectionTest {
+    @Test void borrowedConnectionRevalidatesWithoutOpeningOrEndingATransaction() throws Exception {
+        String issuer="https://issuer.example";
+        var source=mock(DataSource.class);var connection=mock(Connection.class);
+        var protocol=mock(OidcProtocolStateV1.class);
+        var providers=mock(BeanProvider.class);
+        var projection=mock(ApplicationGroupProtocolProjectionV1.class);
+        when(providers.isUnique()).thenReturn(true);when(providers.get()).thenReturn(projection);
+        when(protocol.account(connection,issuer,"alice")).thenReturn(Optional.of(new OidcProtocolStateV1.Account(issuer,"alice",true,true,3)));
+        when(protocol.client(connection,issuer,"ui")).thenReturn(Optional.of(new OidcProtocolStateV1.Client(issuer,"ui",true,Set.of("openid"),true)));
+        var target=new ApplicationGroupProtocolProjectionV1.Projection("group","main",issuer,"ui","alice",true,true,1,2,
+            Set.of("ui"),List.of(new ApplicationGroupProtocolProjectionV1.Scope("manage","Manager","")),Set.of("manage"),Set.of("manage"));
+        when(projection.current(eq(connection),any())).thenReturn(new ApplicationGroupProtocolProjectionV1.Result(1,true,Optional.of(target)));
+        var configuration=new OidcConfiguration();configuration.setIssuer(issuer);
+        var service=new OidcTrustedIdentity(providers,protocol,configuration,source);
+        var claim=Map.of("application_group_id","group","client_id","ui","authorization_version",2L,
+            "application_group_scopes",Set.of("manage"),"protocol_scopes",Set.of("openid"));
+        var authentication=Authentication.build("alice",List.of(),Map.of("iss",issuer,"aud",Set.of("ui"),
+            "authentication_version",3L,OidcTrustedIdentity.CLAIM,claim));
+        var request=HttpRequest.GET("/api/v1/main/extensions/test").setAttribute(SecurityFilter.AUTHENTICATION,authentication);
+        try(var scope=PropagatedContext.getOrEmpty().plus(new AuthorizationInvocationContext(request,false)).propagate()) {
+            assertEquals("alice",service.current(connection).subject());
+            when(protocol.account(connection,issuer,"alice")).thenReturn(Optional.of(new OidcProtocolStateV1.Account(issuer,"alice",false,false,4)));
+            assertThrows(IllegalStateException.class,()->service.current(connection));
+        }
+        verifyNoInteractions(source);
+        verify(connection,never()).commit();verify(connection,never()).rollback();verify(connection,never()).close();
+    }
+}
