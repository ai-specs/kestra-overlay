@@ -0,0 +1,20 @@
+package io.kestra.webserver.oidc.services;
+
+import java.sql.Connection;
+import java.sql.SQLException;
+
+public final class OidcSecurityTransactions {
+    private OidcSecurityTransactions() {}
+
+    public static void lock(Connection connection) throws SQLException {
+        if (connection.getAutoCommit() || connection.isReadOnly()
+            || connection.getTransactionIsolation() != Connection.TRANSACTION_READ_COMMITTED)
+            throw new IllegalStateException("An explicit READ_COMMITTED protocol transaction is required");
+        if (!"PostgreSQL".equals(connection.getMetaData().getDatabaseProductName()))
+            throw new IllegalStateException("Protocol security transactions require PostgreSQL");
+        try (var statement = connection.prepareStatement("SELECT pg_advisory_xact_lock(1380073797)")) {
+            statement.setQueryTimeout(5);
+            statement.execute();
+        }
+    }
+}
