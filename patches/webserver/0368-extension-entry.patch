+package io.kestra.webserver.rbac;
+
+import java.util.Set;
+
+final class ExtensionDiscovery {
+    static boolean matches(OssRestOperationAdapter.Request request) {
+        return request != null && request.route() != null
+            && "main".equals(request.variable("tenant"))
+            && "io.kestra.webserver.controllers.api.UiExtensionController".equals(request.route().controller())
+            && "manifest".equals(request.route().handler())
+            && Set.of("GET", "HEAD").contains(request.route().method())
+            && "/ui-extensions/main/manifest".equals(request.route().path());
+    }
+}
