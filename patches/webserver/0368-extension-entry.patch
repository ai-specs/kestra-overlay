+import {afterEach, beforeEach, describe, expect, it, vi} from "vitest";
+import {mount, flushPromises} from "@vue/test-utils";
+import {createPinia, setActivePinia} from "pinia";
+import {createMemoryHistory, createRouter} from "vue-router";
+import App from "../App.vue";
+import {setExtensionFallback} from "./entry";
+import {useMiscStore} from "override/stores/misc";
+
+vi.mock("../styles/vendor.scss", () => ({}));
+vi.mock("../styles/app.scss", () => ({}));
+vi.mock("override/stores/misc", async () => {
+    const {defineStore} = await import("pinia");
+    return {useMiscStore: defineStore("misc", {state: () => ({theme: "light", configs: undefined}), actions: {
+        loadConfigs: vi.fn(async () => ({version: "2.0.5", uuid: "probe"})),
+    }})};
+});
+vi.mock("../stores/api", () => ({useApiStore: () => ({loadFeeds: vi.fn()})}));
+vi.mock("../stores/layout", () => ({useLayoutStore: () => ({envName: ""})}));
+vi.mock("../stores/core", () => ({useCoreStore: () => ({})}));
+vi.mock("../stores/doc", () => ({useDocStore: () => ({initResourceUrlTemplate: vi.fn()})}));
+vi.mock("../utils/utils", () => ({uid: () => "probe", switchTheme: vi.fn()}));
+vi.mock("../utils/authentication", () => ({isLoggedIn: () => true}));
+vi.mock("../utils/appFontSize", () => ({applyFontScale: vi.fn(), getAppFontSizeMode: vi.fn()}));
+vi.mock("../utils/posthog", () => ({initPosthogIfEnabled: vi.fn()}));
+vi.mock("../utils/savedFilterTracking", () => ({SAVED_FILTER_ANALYTICS_INJECTION_KEY: "tracking", trackSavedFilter: vi.fn()}));
+vi.mock("../composables/useThemeCycle", () => ({useThemeCycle: vi.fn()}));
+vi.mock("../utils/loaderReveal", () => ({revealApp: (ready: () => void) => ready()}));
+vi.mock("../components/ErrorToast.vue", () => ({default: {template: "<div />"}}));
+vi.mock("../components/onboarding/tour/TourOverlay.vue", () => ({default: {template: '<div data-test="tour" />'}}));
+vi.mock("override/components/layout/DefaultLayout.vue", () => ({default: {template: '<div data-test="full-layout"><slot /></div>'}}));
+vi.mock("../components/layout/AppTopNavBar.vue", () => ({default: {template: '<div data-test="full-topbar" />'}}));
+vi.mock("../components/DocIdDisplay.vue", () => ({default: {template: "<div />"}}));
+vi.mock("../components/UnsavedChangesDialog.vue", () => ({default: {template: "<div />"}}));
+vi.mock("../components/VersionUpgradeNotice.vue", () => ({default: {template: '<div data-test="version" />'}}));
+vi.mock("../components/dashboard/DrillDownDrawer.vue", () => ({default: {template: '<div data-test="drilldown" />'}}));
+vi.mock("../components/PwaInstallPrompt.vue", () => ({default: {template: '<div data-test="pwa" />'}}));
+vi.mock("../components/extensions/ExtensionFallbackLayout.vue", () => ({default: {template: '<div data-test="fallback-layout"><slot /></div>'}}));
+
+let wrapper: ReturnType<typeof mount>;
+beforeEach(() => {setExtensionFallback(); localStorage.clear();});
+afterEach(() => {wrapper?.unmount(); localStorage.clear();});
+
+async function render(reduced: boolean) {
+    const pinia = createPinia();
+    setActivePinia(pinia);
+    const misc = useMiscStore();
+    vi.spyOn(misc, "loadConfigs");
+    const router = createRouter({history: createMemoryHistory(), routes: [
+        {name: "extensions/page", path: "/:tenant/extensions/:extensionId", component: {template: "<div>probe</div>"}},
+        {name: "home", path: "/:tenant/home", component: {template: "<div>home</div>"}},
+    ]});
+    if (reduced) setExtensionFallback({tenant: "main", id: "probe"});
+    await router.push("/main/extensions/probe");
+    wrapper = mount(App, {global: {plugins: [pinia, router]}});
+    await flushPromises();
+    return {router, misc};
+}
+
+describe("App extension shell initialization", () => {
+    it("mounts the fallback without any general resources or business shell components", async () => {
+        const {misc} = await render(true);
+        expect(misc.loadConfigs).not.toHaveBeenCalled();
+        expect(wrapper.find('[data-test="fallback-layout"]').exists()).toBe(true);
+        for (const component of ["full-topbar", "full-layout", "tour", "version", "drilldown", "pwa"]) {
+            expect(wrapper.find(`[data-test="${component}"]`).exists()).toBe(false);
+        }
+        expect(misc.configs).toBeUndefined();
+    });
+
+    it("preserves the full layout and normal general resources for an allowed extension", async () => {
+        const {misc} = await render(false);
+        expect(misc.loadConfigs).toHaveBeenCalledOnce();
+        expect(wrapper.find('[data-test="full-layout"]').exists()).toBe(true);
+        expect(wrapper.find('[data-test="full-topbar"]').exists()).toBe(true);
+        expect(wrapper.find('[data-test="fallback-layout"]').exists()).toBe(false);
+    });
+
+    it("resumes ordinary initialization when leaving fallback without an anonymous-state change", async () => {
+        const {router, misc} = await render(true);
+        await router.push("/main/home");
+        await flushPromises();
+        expect(misc.loadConfigs).toHaveBeenCalledOnce();
+        expect(wrapper.find('[data-test="full-layout"]').exists()).toBe(true);
+    });
+});
diff --git a/ui/src/extensions/entry.spec.ts b/ui/src/extensions/entry.spec.ts
new file mode 100644
index 0000000..59756a1
--- /dev/null
+++ b/ui/src/extensions/entry.spec.ts
@@ -0,0 +1,153 @@
+import {afterEach, beforeEach, describe, expect, it, vi} from "vitest";
+import {reactive} from "vue";
+import {extensionManifest, requireExtension, visibleExtensions} from "./access";
+import {resolveExtensionEntry, setExtensionFallback, useExtensionFallback} from "./entry";
+
+const descriptor = (id = "probe", capabilityPath: string | null = "/api/v1/main/extensions/probe/capabilities") => ({
+    contractVersion: 1, id, entry: "page.js", styles: ["page.css"], titles: {en: "Probe"}, capabilityPath,
+});
+const response = (body: unknown, status = 200) => new Response(JSON.stringify(body), {status, headers: {"Content-Type": "application/json"}});
+const configsError = (status: number) => ({response: {status}});
+let fetcher: ReturnType<typeof vi.fn>;
+
+beforeEach(() => {
+    setExtensionFallback();
+    window.KESTRA_BASE_PATH = "";
+    fetcher = vi.fn(async (path: string) => response(path.endsWith("/manifest") ? {contractVersion: 1, extensions: [descriptor()]} : {allowed: true}));
+    vi.stubGlobal("fetch", fetcher);
+});
+afterEach(() => {vi.unstubAllGlobals(); vi.useRealTimers();});
+
+describe("authenticated extension entry", () => {
+    it("checks manifest and capability before configs and falls back only on its 403", async () => {
+        const configs = vi.fn(async () => {expect(fetcher).toHaveBeenCalledTimes(2); throw configsError(403);});
+        await expect(resolveExtensionEntry("main", "probe", configs, new AbortController().signal)).resolves.toBe(true);
+        expect(configs).toHaveBeenCalledOnce();
+        expect(fetcher.mock.calls.map(([path]) => path)).toEqual(["/ui-extensions/main/manifest", "/api/v1/main/extensions/probe/capabilities"]);
+        for (const [, options] of fetcher.mock.calls) expect(options).toMatchObject({credentials: "same-origin", redirect: "error"});
+    });
+
+    it("keeps the full host layout when configs is allowed", async () => {
+        await expect(resolveExtensionEntry("main", "probe", async () => ({edition: "OSS"}), new AbortController().signal)).resolves.toBe(false);
+    });
+
+    it.each([401, 404, 500, 503])("does not swallow configs %i", async status => {
+        await expect(resolveExtensionEntry("main", "probe", async () => {throw configsError(status);}, new AbortController().signal)).rejects.toEqual(configsError(status));
+    });
+
+    it("does not swallow a configs network error", async () => {
+        const failure = new TypeError("Network unavailable");
+        await expect(resolveExtensionEntry("main", "probe", async () => {throw failure;}, new AbortController().signal)).rejects.toBe(failure);
+    });
+
+    it.each([401, 403, 500])("manifest %i cannot reach configs", async status => {
+        fetcher.mockResolvedValue(response({}, status));
+        const configs = vi.fn();
+        await expect(resolveExtensionEntry("main", "probe", configs, new AbortController().signal)).rejects.toMatchObject({status});
+        expect(configs).not.toHaveBeenCalled();
+    });
+
+    it.each([false, "true", null])("requires an explicit boolean capability allow: %s", async allowed => {
+        fetcher.mockImplementation(async (path: string) => response(path.endsWith("/manifest") ? {contractVersion: 1, extensions: [descriptor()]} : {allowed}));
+        const configs = vi.fn();
+        await expect(resolveExtensionEntry("main", "probe", configs, new AbortController().signal)).rejects.toMatchObject({status: 403});
+        expect(configs).not.toHaveBeenCalled();
+    });
+
+    it.each([401, 403, 500])("capability %i cannot select fallback", async status => {
+        fetcher.mockImplementation(async (path: string) => path.endsWith("/manifest") ? response({contractVersion: 1, extensions: [descriptor()]}) : response({}, status));
+        await expect(requireExtension("main", "probe")).rejects.toMatchObject({status});
+    });
+
+    it("does not grant a target from an empty manifest", async () => {
+        fetcher.mockImplementation(async () => response({contractVersion: 1, extensions: []}));
+        await expect(requireExtension("main", "probe")).rejects.toMatchObject({status: 403});
+        expect(await visibleExtensions("main")).toEqual([]);
+    });
+
+    it("supports existing descriptors with no capability", async () => {
+        fetcher.mockResolvedValue(response({contractVersion: 1, extensions: [descriptor("probe", null)]}));
+        expect((await requireExtension("main", "probe")).id).toBe("probe");
+        expect(fetcher).toHaveBeenCalledOnce();
+    });
+
+    it.each(["../probe", "probe%2fother", "probe/other", "Probe", "probe\\other", "", "a".repeat(65)])("rejects malicious or invalid target %s before requesting", async id => {
+        await expect(requireExtension("main", id)).rejects.toMatchObject({status: 403});
+        expect(fetcher).not.toHaveBeenCalled();
+    });
+
+    it("rejects another tenant before requesting", async () => {
+        await expect(requireExtension("other", "probe")).rejects.toMatchObject({status: 403});
+        expect(fetcher).not.toHaveBeenCalled();
+    });
+
+    it.each([
+        {contractVersion: 2, extensions: [descriptor()]},
+        {contractVersion: 1, extensions: [descriptor(), descriptor()]},
+        {contractVersion: 1, extensions: [{...descriptor(), entry: "../page.js"}]},
+        {contractVersion: 1, extensions: [{...descriptor(), capabilityPath: "https://evil.invalid"}]},
+        {contractVersion: 1, extensions: [{...descriptor(), capabilityPath: "/api/v1/../configs"}]},
+    ])("fails closed for malformed manifest %#", async manifest => {
+        fetcher.mockResolvedValue(response(manifest));
+        await expect(extensionManifest("main")).rejects.toMatchObject({status: 403});
+    });
+
+    it("hides a failed capability without hiding an unrelated allowed extension", async () => {
+        fetcher.mockImplementation(async (path: string) => path.endsWith("/manifest")
+            ? response({contractVersion: 1, extensions: [descriptor(), descriptor("other", "/api/v1/main/extensions/other/capabilities")]})
+            : response({allowed: !path.includes("/other/")}));
+        expect((await visibleExtensions("main")).map(value => value.id)).toEqual(["probe"]);
+    });
+
+    it("does not reuse a prior allow after revocation", async () => {
+        await requireExtension("main", "probe");
+        fetcher.mockResolvedValue(response({contractVersion: 1, extensions: []}));
+        await expect(requireExtension("main", "probe")).rejects.toMatchObject({status: 403});
+    });
+
+    it("does not commit a late configs 403 after navigation cancellation", async () => {
+        const controller = new AbortController();
+        let reject!: (error: unknown) => void;
+        const configs = vi.fn(() => new Promise((_, fail) => {reject = fail;}));
+        const result = resolveExtensionEntry("main", "probe", configs, controller.signal);
+        const denied = expect(result).rejects.toMatchObject({name: "AbortError"});
+        await vi.waitFor(() => expect(configs).toHaveBeenCalledOnce());
+        controller.abort();
+        reject(configsError(403));
+        await denied;
+    });
+
+    it("bounds manifest requests", async () => {
+        vi.useFakeTimers();
+        const timeout = vi.spyOn(AbortSignal, "timeout").mockImplementation(milliseconds => {
+            const controller = new AbortController();
