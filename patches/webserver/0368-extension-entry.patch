diff --git a/ui/src/extensions/access.ts b/ui/src/extensions/access.ts
new file mode 100644
index 0000000..6989fb1
--- /dev/null
+++ b/ui/src/extensions/access.ts
@@ -0,0 +1,68 @@
+import type {UiExtensionDescriptorV1} from "./protocol";
+import {hostExtensionPath} from "./runtime";
+
+export class ExtensionAccessError extends Error {
+    constructor(public readonly status: number) {super("Extension access unavailable");}
+    get response() {return {status: this.status};}
+}
+
+export function validExtensionId(id: unknown): id is string {
+    return typeof id === "string" && /^[a-z][a-z0-9-]{0,63}$/.test(id);
+}
+
+function safePath(path: unknown): path is string {
+    return typeof path === "string" && /^[A-Za-z0-9_./-]+$/.test(path) && !path.startsWith("/")
+        && !path.endsWith("/") && !path.includes("//") && !path.split("/").some(part => part === "." || part === "..");
+}
+
+async function json(path: string, signal?: AbortSignal): Promise<any> {
+    const bounded = AbortSignal.timeout(10000);
+    const response = await fetch(hostExtensionPath(path), {
+        credentials: "same-origin", redirect: "error", signal: signal ? AbortSignal.any([signal, bounded]) : bounded,
+    });
+    if (!response.ok) throw new ExtensionAccessError(response.status);
+    return response.json();
+}
+
+export async function extensionManifest(tenant: string, signal?: AbortSignal): Promise<UiExtensionDescriptorV1[]> {
+    if (tenant !== "main") throw new ExtensionAccessError(403);
+    const manifest = await json(`/ui-extensions/${tenant}/manifest`, signal);
+    if (manifest?.contractVersion !== 1 || !Array.isArray(manifest.extensions)) throw new ExtensionAccessError(403);
+    const ids = new Set<string>();
+    for (const descriptor of manifest.extensions) {
+        if (!descriptor || descriptor.contractVersion !== 1 || !validExtensionId(descriptor.id) || ids.has(descriptor.id)
+            || !safePath(descriptor.entry) || !descriptor.entry.endsWith(".js") || !Array.isArray(descriptor.styles)
+            || !descriptor.styles.every((style: unknown) => safePath(style) && style.endsWith(".css"))
+            || !descriptor.titles || typeof descriptor.titles.en !== "string"
+            || (descriptor.capabilityPath != null && (typeof descriptor.capabilityPath !== "string"
+                || !descriptor.capabilityPath.startsWith("/api/v1/") || !safePath(descriptor.capabilityPath.slice(1))))) {
+            throw new ExtensionAccessError(403);
+        }
+        ids.add(descriptor.id);
+    }
+    return manifest.extensions;
+}
+
+export async function extensionCapability(descriptor: UiExtensionDescriptorV1, signal?: AbortSignal): Promise<void> {
+    if (descriptor.capabilityPath != null && (await json(descriptor.capabilityPath, signal))?.allowed !== true) {
+        throw new ExtensionAccessError(403);
+    }
+}
+
+export async function requireExtension(tenant: string, id: string, signal?: AbortSignal): Promise<UiExtensionDescriptorV1> {
+    if (!validExtensionId(id)) throw new ExtensionAccessError(403);
+    const descriptor = (await extensionManifest(tenant, signal)).find(value => value.id === id);
+    if (!descriptor) throw new ExtensionAccessError(403);
+    await extensionCapability(descriptor, signal);
+    signal?.throwIfAborted();
+    return descriptor;
+}
+
+export async function visibleExtensions(tenant: string, signal?: AbortSignal): Promise<UiExtensionDescriptorV1[]> {
+    const descriptors = await extensionManifest(tenant, signal);
+    const visible = await Promise.all(descriptors.map(async descriptor => {
+        try {await extensionCapability(descriptor, signal); return descriptor;} catch {return null;}
+    }));
+    signal?.throwIfAborted();
+    return visible.filter((value): value is UiExtensionDescriptorV1 => value !== null);
+}
