+<template>
+    <section class="extension-fallback" data-testid="extension-fallback-shell">
+        <header>
+            <strong>{{ $t('uiExtensions') }}</strong>
+            <RouterLink :to="{name: 'home', params: {tenant: route.params.tenant}}">{{ $t('kestra') }}</RouterLink>
+            <label>
+                {{ $t('settings.blocks.theme.label') }}
+                <KsSelect :modelValue="misc.theme" :aria-label="$t('settings.blocks.theme.label')" @update:model-value="changeTheme">
+                    <KsOption v-for="theme in themes" :key="theme.value" :value="theme.value" :label="$t(theme.label)" />
+                </KsSelect>
+            </label>
+            <label>
+                {{ $t('settings.blocks.configuration.fields.language') }}
+                <KsSelect :modelValue="locale" :aria-label="$t('settings.blocks.configuration.fields.language')" @update:model-value="changeLanguage">
+                    <KsOption v-for="language in languages" :key="language[0]" :value="language[0]" :label="language[1]" />
+                </KsSelect>
+            </label>
+            <KsButton nativeType="button" @click="logout">{{ $t('setup.logout') }}</KsButton>
+        </header>
+        <ExtensionLinks />
+        <div id="topnav-title-slot" />
+        <div id="topnav-description-slot" />
+        <div id="topnav-actions-slot" />
+        <main v-if="ready"><slot /></main>
+    </section>
+</template>
+
+<script setup lang="ts">
+    import {onMounted, onBeforeUnmount, ref} from "vue";
+    import {useRoute, useRouter} from "vue-router";
+    import {useI18n} from "vue-i18n";
+    import {KsButton, KsSelect, KsOption} from "@kestra-io/design-system";
+    import {useMiscStore} from "override/stores/misc";
+    import {LANGUAGES} from "../../translations/languages";
+    import {switchTheme, type SelectedTheme} from "../../utils/utils";
+    import * as Authentication from "../../utils/authentication";
+    import ExtensionLinks from "./ExtensionLinks.vue";
+
+    const route = useRoute();
+    const ready = ref(false);
+    const router = useRouter();
+    const misc = useMiscStore();
+    const {locale} = useI18n({useScope: "global"});
+    const languages = [["en", "English"], ...LANGUAGES];
+    const themes = [
+        {value: "dark-2", label: "settings.blocks.theme.color_modes.dark_2"},
+        {value: "dark", label: "settings.blocks.theme.color_modes.dark_1"},
+        {value: "light", label: "settings.blocks.theme.color_modes.light"},
+        {value: "syncWithSystem", label: "settings.blocks.theme.color_modes.sync"},
+    ];
+    function changeTheme(value: string) {
+        if (themes.some(theme => theme.value === value)) switchTheme(misc, value as SelectedTheme);
+    }
+    function changeLanguage(value: string) {
+        if (languages.some(language => language[0] === value) && value !== locale.value) {
+            localStorage.setItem("lang", value);
+            window.location.assign(window.location.href);
+        }
+    }
+    async function logout() {
+        await Authentication.logout();
+        if (!Authentication.isOidc()) await router.push({name: "login"});
+    }
+    let media: MediaQueryList | undefined;
+    function systemTheme() {
+        if (misc.theme === "syncWithSystem") switchTheme(misc, "syncWithSystem");
+    }
+    onMounted(() => {
+        ready.value = true;
+        media = window.matchMedia("(prefers-color-scheme: dark)");
+        media.addEventListener("change", systemTheme);
+    });
+    onBeforeUnmount(() => media?.removeEventListener("change", systemTheme));
+</script>
+
+<style scoped>
+    .extension-fallback {width: 100%; min-height: 100vh; padding: var(--ks-spacing-4); background: var(--ks-bg-base); color: var(--ks-text-primary);}
+    header {display: flex; flex-wrap: wrap; align-items: center; gap: var(--ks-spacing-4);}
+    label {display: flex; align-items: center; gap: var(--ks-spacing-2);}
+    label {min-width: 0;}
+    label :deep(.kel-select) {width: 12rem; max-width: 100%;}
+    a {color: var(--ks-text-link);}
+    :is(select, button, a):focus-visible {outline: 2px solid var(--ks-border-focus); outline-offset: 3px;}
+    @media (max-width: 600px) {header, label {align-items: stretch; flex-direction: column;}}
+</style>
