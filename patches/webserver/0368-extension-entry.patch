+package io.kestra.webserver.ui;
+
+import io.kestra.core.junit.annotations.KestraTest;
+import io.kestra.webserver.rbac.RbacAuthorizer;
+import io.kestra.webserver.rbac.TypedAuthorization;
+import io.kestra.webserver.rbac.TypedAuthorizationResolver;
+import io.micronaut.context.annotation.Property;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.runtime.server.EmbeddedServer;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.AuthenticationFetcher;
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.security.MessageDigest;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionStage;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+import static org.junit.jupiter.api.Assertions.*;
+
+@KestraTest(environments = "h2")
+@Property(name = "kestra.server-type", value = "WEBSERVER")
+@Property(name = "kestra.rbac.enabled", value = "true")
+@Property(name = "kestra.rbac.typed.enabled", value = "true")
+@Property(name = "micronaut.security.enabled", value = "true")
+@Property(name = "micronaut.security.filter.enabled", value = "true")
+@Property(name = "micronaut.security.intercept-url-map[0].pattern", value = "/**")
+@Property(name = "micronaut.security.intercept-url-map[0].access[0]", value = "isAnonymous()")
+@Property(name = "mcp.http.security.fixture", value = "true")
+@Property(name = "ui.extension.entry.probe", value = "true")
+class UiExtensionEntryHttpTest {
+    @Inject EmbeddedServer server;
+
+    private HttpResponse<String> get(String path, String subject) throws Exception {
+        var request = HttpRequest.newBuilder(server.getURI().resolve(path)).GET();
+        if (subject != null) request.header("X-Entry-Probe", subject);
+        return HttpClient.newHttpClient().send(request.build(), HttpResponse.BodyHandlers.ofString());
+    }
+
+    @Test void discoversAllowedExtensionWithoutMetadataPermission() throws Exception {
+        var response = get("/ui-extensions/main/manifest", "recovery");
+        assertEquals(200, response.statusCode());
+        assertTrue(response.body().contains("http-probe"));
+        assertFalse(response.body().contains("hidden-probe"));
+        assertEquals(403, get("/api/v1/configs", "recovery").statusCode());
+        assertEquals(200, get("/ui-extensions/main/http-probe/page.js", "recovery").statusCode());
+        assertEquals(403, get("/ui-extensions/main/hidden-probe/page.js", "recovery").statusCode());
+    }
+
+    @Test void zeroGrantDiscoveryIsEmptyAndAssetsRemainDenied() throws Exception {
+        var response = get("/ui-extensions/main/manifest", "zero");
+        assertEquals(200, response.statusCode());
+        assertTrue(response.body().contains("\"extensions\":[]"));
+        assertEquals(403, get("/api/v1/configs", "zero").statusCode());
+        assertEquals(403, get("/ui-extensions/main/http-probe/page.js", "zero").statusCode());
+    }
+
+    @Test void discoveryRemainsAuthenticatedAndTenantBound() throws Exception {
+        assertEquals(401, get("/ui-extensions/main/manifest", null).statusCode());
+        assertEquals(400, get("/ui-extensions/other/manifest", "recovery").statusCode());
+        assertEquals(403, get("/ui-extensions/main/unknown/page.js", "recovery").statusCode());
+        assertEquals(404, get("/ui-extensions/main/http-probe/missing.js", "recovery").statusCode());
+    }
+
+    @Test void policyFailureCannotExposeDescriptors() throws Exception {
+        var response = get("/ui-extensions/main/manifest", "failure");
+        assertEquals(200, response.statusCode());
+        assertTrue(response.body().contains("\"extensions\":[]"));
+        assertEquals(403, get("/ui-extensions/main/http-probe/page.js", "failure").statusCode());
+    }
+
+    @Singleton
+    @Requires(property = "ui.extension.entry.probe", value = "true")
+    static class Identity implements AuthenticationFetcher<io.micronaut.http.HttpRequest<?>> {
+        @Override public org.reactivestreams.Publisher<Authentication> fetchAuthentication(io.micronaut.http.HttpRequest<?> request) {
+            var subject = request.getHeaders().get("X-Entry-Probe");
+            return subject == null ? Mono.empty() : Mono.just(Authentication.build(subject, List.of()));
+        }
+    }
+
+    @Singleton
+    @Requires(property = "ui.extension.entry.probe", value = "true")
+    static class Policy implements TypedAuthorizationResolver {
+        @Override public CompletionStage<TypedAuthorization.Decision> authorize(RbacAuthorizer.Principal principal, TypedAuthorization.Operation operation) {
+            if (principal.subject().equals("failure")) return CompletableFuture.failedFuture(new IllegalStateException());
+            boolean allowed = principal.subject().equals("recovery") && operation.resource() == TypedAuthorization.Resource.EXTENSION
+                && operation.action() == TypedAuthorization.Action.READ && "http-probe".equals(operation.resourceId());
+            return CompletableFuture.completedFuture(allowed ? TypedAuthorization.Decision.allow(operation.queryDomain()) : TypedAuthorization.Decision.deny("Probe denied"));
+        }
+    }
+
+    @Singleton
+    @Requires(property = "ui.extension.entry.probe", value = "true")
+    static class Pages implements UiExtensionProviderV1 {
+        @Override public List<UiExtensionDescriptorV1> extensions() {
+            try (var resource = getClass().getClassLoader().getResourceAsStream("ui-extensions/http-probe/page.js")) {
+                var hash = HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(resource.readAllBytes()));
+                return List.of(new UiExtensionDescriptorV1(1, "http-probe", "ui-extensions/http-probe", "page.js", List.of(),
+                    Map.of("page.js", new UiExtensionDescriptorV1.Resource(hash, "application/javascript")), Map.of("en", "Entry probe"), null),
+                    new UiExtensionDescriptorV1(1, "hidden-probe", "ui-extensions/hidden-probe", "page.js", List.of(),
+                    Map.of("page.js", new UiExtensionDescriptorV1.Resource(hash, "application/javascript")), Map.of("en", "Hidden probe"), null));
+            } catch (Exception failure) {throw new IllegalStateException(failure);}
+        }
+    }
