+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class ExtensionDiscoveryRouteTest {
+    private OssRestOperationAdapter.Request request(String method, String path, String controller, String handler, String tenant) {
+        return new OssRestOperationAdapter.Request(new RestAuthorizationResolver.Request(method, path, Map.of(), null, new byte[0],
+            controller, handler, List.of()), Map.of("tenant", tenant));
+    }
+
+    @Test void onlyActualReadOnlyMainManifestDelegatesToDescriptorFiltering() {
+        String controller = "io.kestra.webserver.controllers.api.UiExtensionController";
+        for (String method : List.of("GET", "HEAD")) assertTrue(ExtensionDiscovery.matches(
+            request(method, "/ui-extensions/main/manifest", controller, "manifest", "main")));
+        for (String method : List.of("POST", "PUT", "DELETE")) assertFalse(ExtensionDiscovery.matches(
+            request(method, "/ui-extensions/main/manifest", controller, "manifest", "main")));
+        for (String path : List.of("/api/v1/configs", "/ui-extensions/main/manifest/", "/ui-extensions/main/http-probe/page.js",
+            "/ui-extensions/main/%6danifest", "/ui-extensions/main/../main/manifest", "/ui-extensions/other/manifest")) {
+            assertFalse(ExtensionDiscovery.matches(request("GET", path, controller, "manifest", "main")));
+        }
+        assertFalse(ExtensionDiscovery.matches(request("GET", "/ui-extensions/main/manifest", controller, "asset", "main")));
+        assertFalse(ExtensionDiscovery.matches(request("GET", "/ui-extensions/main/manifest", "external.Controller", "manifest", "main")));
+        assertFalse(ExtensionDiscovery.matches(request("GET", "/ui-extensions/main/manifest", controller, "manifest", "other")));
+    }
+}
