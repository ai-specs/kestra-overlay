@@ -0,0 +1,26 @@
+import {computed, shallowRef} from "vue";
+import {requireExtension} from "./access";
+
+interface EntryRoute {name?: unknown; params: {tenant?: unknown; extensionId?: unknown}}
+interface Fallback {tenant: string; id: string}
+const fallback = shallowRef<ReadonlySet<string>>(new Set());
+
+export function isExtensionRoute(route: EntryRoute) {return route.name === "extensions/page";}
+
+export function useExtensionFallback(route: EntryRoute) {
+    return computed(() => isExtensionRoute(route) && fallback.value.has(`${route.params.tenant}/${route.params.extensionId}`));
+}
+
+export async function resolveExtensionEntry(tenant: string, id: string, loadConfigs: () => Promise<unknown>, signal: AbortSignal): Promise<boolean> {
+    await requireExtension(tenant, id, signal);
+    try {await loadConfigs(); signal.throwIfAborted(); return false;}
+    catch (error) {
+        signal.throwIfAborted();
+        if ((error as {response?: {status?: number}})?.response?.status === 403) return true;
+        throw error;
+    }
+}
+
+export function setExtensionFallback(value?: Fallback) {
+    fallback.value = value ? new Set([...fallback.value, `${value.tenant}/${value.id}`]) : new Set();
+}
