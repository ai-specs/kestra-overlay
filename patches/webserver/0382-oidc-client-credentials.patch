+package io.kestra.webserver.oidc;
+
+public interface ClientCredentialsV1 {
+    enum ClientType { PUBLIC, CONFIDENTIAL }
+    enum RotationMode { NONE, ONLINE, DEPLOYMENT_MAINTENANCE }
+    enum Failure { INVALID, NOT_FOUND, CONFLICT, FORBIDDEN, UNAVAILABLE }
+
+    final class CredentialException extends RuntimeException {
+        private final Failure failure;
+        public CredentialException(Failure failure) {super("Client credentials: "+failure);this.failure=failure;}
+        public Failure failure() {return failure;}
+    }
+
+    record CredentialStatus(String clientId,ClientType clientType,boolean secretSet,String maskedHint,
+                            long credentialRevision,RotationMode rotationMode) {}
+    record IssuedCredential(CredentialStatus status,String clientSecret) {
+        @Override public String toString() {return "IssuedCredential[credential=REDACTED]";}
+    }
+
+    CredentialStatus status(String clientId);
+    IssuedCredential rotate(String clientId,long credentialRevision);
+}
