+package io.kestra.webserver.oidc.cli;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.kestra.webserver.oidc.ClientCredentialsV1;
+import io.kestra.webserver.oidc.OidcProtocolState;
+import io.kestra.webserver.oidc.services.OidcClientCredentialMaintenance;
+import io.kestra.webserver.oidc.services.OidcInstallationReceipt;
+import java.io.PrintStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.sql.Connection;
+import java.sql.DriverManager;
+import java.sql.SQLException;
+import java.util.Map;
+import javax.sql.DataSource;
+
+public final class OidcClientCredentialsCommand {
+    private OidcClientCredentialsCommand() {}
+
+    public static void main(String[] arguments) {
+        int exit=run(arguments,System.getenv(),System.out,System.err);
+        if(exit!=0)System.exit(exit);
+    }
+
+    public static int run(String[] arguments,Map<String,String> environment,PrintStream output,PrintStream error) {
+        try {
+            if(arguments.length<2)throw new IllegalArgumentException();
+            var receipt=new OidcInstallationReceipt(Path.of(required(environment,"OIDC_MAINTENANCE_RECEIPT_PATH")));
+            String installation=receipt.read().orElseThrow(IllegalArgumentException::new);
+            String issuer=required(environment,"OIDC_MAINTENANCE_ISSUER");
+            var protocol=new OidcProtocolState(issuer,required(environment,"OIDC_MAINTENANCE_LOGIN_CLIENT_ID"),receipt,new ObjectMapper());
+            var source=new Source(required(environment,"OIDC_MAINTENANCE_JDBC_URL"),required(environment,"OIDC_MAINTENANCE_JDBC_USER"),required(environment,"OIDC_MAINTENANCE_JDBC_PASSWORD"));
+            var maintenance=new OidcClientCredentialMaintenance(source,protocol,issuer,installation,
+                Integer.parseInt(environment.getOrDefault("OIDC_MAINTENANCE_MAX_CLIENTS","1000")),
+                Integer.parseInt(environment.getOrDefault("OIDC_MAINTENANCE_MAX_CLIENTS_PER_USER","20")));
+            var mapper=new ObjectMapper();Object result;
+            if("register-confidential".equals(arguments[0]) && arguments.length==2) {
+                Path input=Path.of(arguments[1]);
+                if(!Files.isRegularFile(input) || Files.size(input)>16384)throw new IllegalArgumentException();
+                var registration=mapper.readValue(input.toFile(),OidcClientCredentialMaintenance.Registration.class);
+                result=maintenance.register(registration);
+            }else if("status".equals(arguments[0]) && arguments.length==2) {
+                result=maintenance.status(arguments[1]);
+            }else if(arguments.length==3) {
+                long revision=Long.parseLong(arguments[2]);
+                if("prepare".equals(arguments[0]))result=Map.of("clientId",arguments[1],"credentialRevision",revision,"clientSecret",maintenance.prepare(arguments[1],revision));
+                else result=maintenance.transition(arguments[0],arguments[1],revision);
+            }else throw new IllegalArgumentException();
+            output.println(mapper.writeValueAsString(result));
+            return 0;
+        }catch(ClientCredentialsV1.CredentialException failure) {
+            error.println("Client credential maintenance failed: "+failure.failure());return 1;
+        }catch(Exception failure) {
+            error.println("Client credential maintenance failed: INVALID_OR_UNAVAILABLE");return 1;
+        }
+    }
+
+    private static String required(Map<String,String> environment,String key) {
+        String value=environment.get(key);if(value==null || value.isBlank())throw new IllegalArgumentException();return value;
+    }
+
+    private record Source(String url,String username,String password) implements DataSource {
+        @Override public Connection getConnection() throws SQLException {return DriverManager.getConnection(url,username,password);}
+        @Override public Connection getConnection(String username,String password) throws SQLException {throw new SQLException("Unsupported credentials");}
+        @Override public java.io.PrintWriter getLogWriter() {return null;}
+        @Override public void setLogWriter(java.io.PrintWriter writer) {}
+        @Override public void setLoginTimeout(int seconds) {}
+        @Override public int getLoginTimeout() {return 0;}
+        @Override public java.util.logging.Logger getParentLogger() {return java.util.logging.Logger.getGlobal();}
+        @Override public boolean isWrapperFor(Class<?> type) {return type.isInstance(this);}
+        @Override public <Result> Result unwrap(Class<Result> type) throws SQLException {
+            if(type.isInstance(this))return type.cast(this);throw new SQLException("Not a wrapper");
+        }
+        @Override public String toString() {return "MaintenanceDataSource[REDACTED]";}
+    }
+}
