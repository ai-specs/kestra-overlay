+
+@KestraTest(environments="h2")
+@Property(name="kestra.server-type",value="WEBSERVER")
+@Property(name="kestra.oidc.enabled",value="true")
+@Property(name="kestra.oidc.issuer",value="http://localhost")
+@Property(name="micronaut.security.enabled",value="false")
+@Property(name="oidc.credentials.http.test",value="true")
+class OidcClientCredentialsHttpTest extends OidcPostgresTestBase {
+    private static OidcCredentialsFixture fixture;
+    @Inject EmbeddedServer server;
+    private final HttpClient client=HttpClient.newHttpClient();
+
+    private static synchronized OidcCredentialsFixture fixture() {
+        try {if(fixture==null)fixture=new OidcCredentialsFixture();return fixture;}
+        catch(Exception failure) {throw new IllegalStateException("HTTP credential fixture unavailable",failure);}
+    }
+    @AfterAll static void closeFixture() throws Exception {if(fixture!=null)fixture.close();fixture=null;}
+
+    @Test void registeredOrdinaryClientUsesProductionConsentAndOnlyRotatedSecretCanExchangeCode() throws Exception {
+        var issued=fixture().register("http-ordinary");
+        String session=login();
+        String firstCode=authorize("http-ordinary",session);
+        var first=token("http-ordinary",issued.clientSecret(),firstCode,"https://client.example/callback");
+        assertEquals(200,first.statusCode());assertTrue(first.body().contains("access_token"));
+        var rotated=fixture().credentials().rotate("http-ordinary",issued.status().credentialRevision());
+        String secondCode=authorize("http-ordinary",session);
+        var rejected=token("http-ordinary",issued.clientSecret(),secondCode,"https://client.example/callback");
+        assertEquals(401,rejected.statusCode());assertTrue(rejected.body().contains("invalid_client"));
+        var accepted=token("http-ordinary",rotated.clientSecret(),secondCode,"https://client.example/callback");
+        assertEquals(200,accepted.statusCode());assertTrue(accepted.body().contains("access_token"));
+    }
+
+    @Test void maintenanceActivationAndRollbackHaveSingleValidSecretInProductionTokenEndpoint() throws Exception {
+        long baseline=fixture().credentials().status("ui-maintenance").credentialRevision();
+        String prepared=fixture().command("prepare","ui-maintenance",Long.toString(baseline)).path("clientSecret").asText();
+        String session=login();
+        String before=authorize("ui-maintenance",session);
+        assertEquals(401,token("ui-maintenance",prepared,before,"http://localhost/oauth/callback/kestra").statusCode());
+        assertEquals(200,token("ui-maintenance","OriginalUiSecret123!",before,"http://localhost/oauth/callback/kestra").statusCode());
+        fixture().command("activate","ui-maintenance",Long.toString(baseline));
+        String after=authorize("ui-maintenance",login());
+        assertEquals(401,token("ui-maintenance","OriginalUiSecret123!",after,"http://localhost/oauth/callback/kestra").statusCode());
+        assertEquals(200,token("ui-maintenance",prepared,after,"http://localhost/oauth/callback/kestra").statusCode());
+        fixture().command("rollback","ui-maintenance",Long.toString(baseline+1));
+        String restored=authorize("ui-maintenance",login());
+        assertEquals(401,token("ui-maintenance",prepared,restored,"http://localhost/oauth/callback/kestra").statusCode());
+        assertEquals(200,token("ui-maintenance","OriginalUiSecret123!",restored,"http://localhost/oauth/callback/kestra").statusCode());
+    }
+
+    private String login() throws Exception {
+        var response=post("/oidc/login","username=owner&password=OwnerPassword123!",null,null);
+        assertEquals(303,response.statusCode());
+        return response.headers().allValues("set-cookie").stream().filter(value->value.startsWith("oidc_session=")).findFirst().orElseThrow().split(";",2)[0];
+    }
+
+    private String authorize(String clientId,String session) throws Exception {
+        String challenge=Base64.getUrlEncoder().withoutPadding().encodeToString(MessageDigest.getInstance("SHA-256").digest("a".repeat(43).getBytes(StandardCharsets.US_ASCII)));
+        String redirect="ui-maintenance".equals(clientId)?"http://localhost/oauth/callback/kestra":"https://client.example/callback";
+        String path="/oidc/authorize?response_type=code&client_id="+encode(clientId)+"&redirect_uri="+encode(redirect)+"&scope=openid&state=state&nonce=nonce&code_challenge_method=S256&code_challenge="+encode(challenge);
+        var response=client.send(HttpRequest.newBuilder(server.getURI().resolve(path)).header("Cookie",session).GET().build(),HttpResponse.BodyHandlers.ofString());
+        boolean consent=response.statusCode()==200;
+        if(consent) {
+            var interaction=Pattern.compile("name=\"interaction\" value=\"([^\"]+)\"").matcher(response.body());assertTrue(interaction.find());
+            response=post("/oidc/consent","interaction="+encode(interaction.group(1))+"&decision=approve&scope-openid=yes",session,"http://localhost");
+        }
+        assertEquals(consent?303:307,response.statusCode());
+        String query=java.net.URI.create(response.headers().firstValue("location").orElseThrow()).getRawQuery();
+        for(String parameter:query.split("&"))if(parameter.startsWith("code="))return URLDecoder.decode(parameter.substring(5),StandardCharsets.UTF_8);
+        fail("Authorization did not produce a code");return null;
+    }
+
+    private HttpResponse<String> token(String clientId,String secret,String code,String redirect) throws Exception {
+        return post("/oidc/token","grant_type=authorization_code&client_id="+encode(clientId)+"&client_secret="+encode(secret)
+            +"&code="+encode(code)+"&redirect_uri="+encode(redirect)+"&code_verifier="+"a".repeat(43),null,null);
+    }
+    private HttpResponse<String> post(String path,String body,String cookie,String origin) throws Exception {
+        var request=HttpRequest.newBuilder(server.getURI().resolve(path)).header("Content-Type","application/x-www-form-urlencoded");
+        if(cookie!=null)request.header("Cookie",cookie);if(origin!=null)request.header("Origin",origin);
+        return client.send(request.POST(HttpRequest.BodyPublishers.ofString(body)).build(),HttpResponse.BodyHandlers.ofString());
+    }
+    private static String encode(String value) {return URLEncoder.encode(value,StandardCharsets.UTF_8);}
+
+    @Factory @Requires(property="oidc.credentials.http.test",value="true")
+    static class Services {
+        @Singleton @Replaces(OidcClientService.class) OidcClientService clients() {return fixture().clients;}
+        @Singleton @Replaces(OidcJwkService.class) OidcJwkService keys() {return new OidcJwkService(fixture().source);}
+        @Singleton @Replaces(OidcUserService.class) OidcUserService users() {return new OidcUserService(fixture().source,fixture().mapper);}
+        @Singleton @Replaces(OidcIdentityLifecycle.class) OidcIdentityLifecycle lifecycle() {return new OidcIdentityLifecycle(fixture().source);}
+        @Singleton @Replaces(OidcPasswordChanges.class) OidcPasswordChanges passwords() {return new OidcPasswordChanges(fixture().source);}
+        @Singleton @Replaces(OidcTokenService.class) OidcTokenService tokens() {return new OidcTokenService(fixture().source,fixture().mapper,fixture().configuration,keys());}
+        @Singleton @Replaces(OidcAuthorizationCodeService.class) OidcAuthorizationCodeService codes() {return new OidcAuthorizationCodeService(fixture().source,fixture().mapper,fixture().configuration);}
+        @Singleton @Replaces(OidcOwnershipService.class) OidcOwnershipService ownership() {return new OidcOwnershipService(fixture().source,fixture().mapper,20,fixture().configuration);}
+        @Singleton @Replaces(OidcSetupService.class) OidcSetupService setup() {var setup=mock(OidcSetupService.class);when(setup.ready()).thenReturn(true);return setup;}
+    }
+}
