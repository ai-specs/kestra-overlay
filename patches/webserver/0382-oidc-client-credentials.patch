@@ -0,0 +1,97 @@
+package io.kestra.webserver.oidc.services;
+
+import io.kestra.webserver.oidc.ClientCredentialsV1;
+import io.kestra.webserver.oidc.IdentityLifecycleGuardV1;
+import io.kestra.webserver.oidc.IdentityLifecycleParticipantV1;
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.kestra.webserver.oidc.OidcProtocolStateV1;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.data.connection.jdbc.advice.DelegatingDataSource;
+import jakarta.inject.Singleton;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.security.SecureRandom;
+import java.util.Base64;
+import javax.sql.DataSource;
+
+@Singleton
+@Requires(property="kestra.oidc.enabled",value="true")
+public final class OidcClientCredentials implements ClientCredentialsV1 {
+    private final DataSource source;
+    private final OidcProtocolStateV1 protocol;
+    private final OidcConfiguration configuration;
+    private final OidcLifecycleParticipants participants;
+
+    public OidcClientCredentials(DataSource source,OidcProtocolStateV1 protocol,OidcConfiguration configuration,
+                                 OidcLifecycleParticipants participants) {
+        this.source=DelegatingDataSource.unwrapDataSource(source);this.protocol=protocol;
+        this.configuration=configuration;this.participants=participants;
+    }
+
+    interface Work<Result> { Result run(Connection connection) throws SQLException; }
+    static <Result> Result transaction(DataSource source,Work<Result> work) {
+        try(var connection=source.getConnection()) {
+            connection.setTransactionIsolation(Connection.TRANSACTION_READ_COMMITTED);connection.setAutoCommit(false);
+            try {
+                OidcSecurityTransactions.lock(connection);
+                Result result=work.run(connection);connection.commit();return result;
+            }catch(SQLException|RuntimeException failure) {
+                try{connection.rollback();}catch(SQLException rollback){failure.addSuppressed(rollback);}
+                if(failure instanceof CredentialException credential)throw credential;
+                if(failure instanceof IdentityLifecycleGuardV1.Rejected rejected)throw rejected;
+                if(failure instanceof SQLException sql && "23505".equals(sql.getSQLState()))throw new CredentialException(Failure.CONFLICT);
+                throw new CredentialException(Failure.UNAVAILABLE);
+            }
+        }catch(SQLException failure) {throw new CredentialException(Failure.UNAVAILABLE);}
+    }
+
+    static String identifier(String value) {
+        if(value==null || value.isBlank() || value.length()>256 || !value.equals(value.trim())
+            || value.codePoints().anyMatch(Character::isISOControl))throw new CredentialException(Failure.INVALID);
+        return value;
+    }
+
+    static String generate() {
+        byte[] bytes=new byte[32];new SecureRandom().nextBytes(bytes);
+        return Base64.getUrlEncoder().withoutPadding().encodeToString(bytes);
+    }
+
+    static String hint(String secret) {return secret.substring(0,3)+"••••••••"+secret.substring(secret.length()-4);}
+
+    static CredentialStatus read(Connection connection,OidcProtocolStateV1 protocol,String issuer,String clientId) throws SQLException {
+        var client=protocol.client(connection,issuer,identifier(clientId)).orElseThrow(()->new CredentialException(Failure.NOT_FOUND));
+        try(var statement=connection.prepareStatement("SELECT client_secret<>'',secret_hint,credential_revision FROM oidc_client WHERE client_id=?")) {
+            statement.setString(1,clientId);
+            try(var rows=statement.executeQuery()) {
+                if(!rows.next())throw new CredentialException(Failure.NOT_FOUND);
+                boolean secretSet=rows.getBoolean(1);
+                return new CredentialStatus(clientId,secretSet?ClientType.CONFIDENTIAL:ClientType.PUBLIC,secretSet,
+                    rows.getString(2),rows.getLong(3),!secretSet?RotationMode.NONE:
+                    client.configuredLoginClient()?RotationMode.DEPLOYMENT_MAINTENANCE:RotationMode.ONLINE);
+            }
+        }
+    }
+
+    @Override public CredentialStatus status(String clientId) {
+        identifier(clientId);
+        return transaction(source,connection->read(connection,protocol,configuration.getIssuer(),clientId));
+    }
+
+    @Override public IssuedCredential rotate(String clientId,long credentialRevision) {
+        identifier(clientId);if(credentialRevision<0)throw new CredentialException(Failure.INVALID);
+        return transaction(source,connection->{
+            var current=read(connection,protocol,configuration.getIssuer(),clientId);
+            if(current.rotationMode()!=RotationMode.ONLINE)throw new CredentialException(Failure.FORBIDDEN);
+            if(current.credentialRevision()!=credentialRevision)throw new CredentialException(Failure.CONFLICT);
+            participants.beforeChange(connection,IdentityLifecycleParticipantV1.Kind.CLIENT_SECRET_ROTATE,null,clientId);
+            String secret=generate();
+            try(var statement=connection.prepareStatement("UPDATE oidc_client SET client_secret=?,secret_format='pbkdf2-sha256-v1',secret_hint=?,credential_revision=credential_revision+1 "
+                + "WHERE client_id=? AND credential_revision=? AND active")) {
+                statement.setString(1,OidcClientSecrets.hash(secret));statement.setString(2,hint(secret));
+                statement.setString(3,clientId);statement.setLong(4,credentialRevision);
+                if(statement.executeUpdate()!=1)throw new CredentialException(Failure.CONFLICT);
+            }
+            return new IssuedCredential(read(connection,protocol,configuration.getIssuer(),clientId),secret);
+        });
+    }
+}
