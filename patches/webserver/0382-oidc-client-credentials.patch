diff --git a/webserver/src/main/java/io/kestra/webserver/oidc/services/OidcClientCredentialMaintenance.java b/webserver/src/main/java/io/kestra/webserver/oidc/services/OidcClientCredentialMaintenance.java
new file mode 100644
index 0000000..7792d9c
--- /dev/null
+++ b/webserver/src/main/java/io/kestra/webserver/oidc/services/OidcClientCredentialMaintenance.java
@@ -0,0 +1,152 @@
+package io.kestra.webserver.oidc.services;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.kestra.webserver.oidc.ClientCredentialsV1;
+import io.kestra.webserver.oidc.OidcProtocolStateV1;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.List;
+import java.util.Set;
+import javax.sql.DataSource;
+import static io.kestra.webserver.oidc.ClientCredentialsV1.*;
+
+public final class OidcClientCredentialMaintenance {
+    public record Registration(String clientId,String ownerSubject,List<String> redirectUris,
+                               Set<String> grantTypes,Set<String> protocolScopes) {
+        public Registration {
+            OidcClientCredentials.identifier(clientId);OidcClientCredentials.identifier(ownerSubject);
+            redirectUris=List.copyOf(redirectUris);grantTypes=Set.copyOf(grantTypes);protocolScopes=Set.copyOf(protocolScopes);
+            if(redirectUris.isEmpty() || redirectUris.size()>10 || Set.copyOf(redirectUris).size()!=redirectUris.size()
+                || !grantTypes.contains("authorization_code") || !Set.of("authorization_code","refresh_token").containsAll(grantTypes)
+                || !protocolScopes.contains("openid") || !Set.of("openid","profile","email","offline_access","mcp:flows:read","mcp:executions:write").containsAll(protocolScopes))
+                throw new CredentialException(Failure.INVALID);
+            for(String redirect:redirectUris) {
+                if(redirect.length()>2048)throw new CredentialException(Failure.INVALID);
+                try {OidcRegistrationService.validateRedirect(redirect);}
+                catch(IllegalArgumentException failure) {throw new CredentialException(Failure.INVALID);}
+            }
+        }
+    }
+
+    private final DataSource source;
+    private final OidcProtocolStateV1 protocol;
+    private final String issuer;
+    private final String installationId;
+    private final int maximum;
+    private final int perOwnerMaximum;
+    private final ObjectMapper mapper=new ObjectMapper();
+
+    public OidcClientCredentialMaintenance(DataSource source,OidcProtocolStateV1 protocol,String issuer,String installationId,int maximum) {
+        this(source,protocol,issuer,installationId,maximum,20);
+    }
+
+    public OidcClientCredentialMaintenance(DataSource source,OidcProtocolStateV1 protocol,String issuer,String installationId,int maximum,int perOwnerMaximum) {
+        if(maximum<1 || maximum>100000 || perOwnerMaximum<1 || perOwnerMaximum>1000)throw new CredentialException(Failure.INVALID);
+        this.source=source;this.protocol=protocol;this.issuer=issuer;this.installationId=installationId;this.maximum=maximum;
+        this.perOwnerMaximum=perOwnerMaximum;
+    }
+
+    private <Result> Result transaction(OidcClientCredentials.Work<Result> work) {
+        return OidcClientCredentials.transaction(source,connection->{
+            protocol.verifyInstallation(connection,issuer,installationId);
+            return work.run(connection);
+        });
+    }
+
+    public IssuedCredential register(Registration registration) {
+        return transaction(connection->{
+            var installation=protocol.verifyInstallation(connection,issuer,installationId);
+            if(installation.configuredLoginClientId().equals(registration.clientId()))throw new CredentialException(Failure.FORBIDDEN);
+            var owner=protocol.account(connection,issuer,registration.ownerSubject()).orElseThrow(()->new CredentialException(Failure.INVALID));
+            if(!owner.active() || !owner.canLogin())throw new CredentialException(Failure.INVALID);
+            try(var lock=connection.prepareStatement("SELECT pg_advisory_xact_lock(1500150)")) {lock.setQueryTimeout(5);lock.execute();}
+            try(var statement=connection.createStatement();var rows=statement.executeQuery("SELECT count(*) FROM oidc_client")) {
+                rows.next();if(rows.getLong(1)>=maximum)throw new CredentialException(Failure.CONFLICT);
+            }
+            try(var statement=connection.prepareStatement("SELECT count(*) FROM oidc_client WHERE owner_subject=? AND client_kind='owned'")) {
+                statement.setString(1,registration.ownerSubject());
+                try(var rows=statement.executeQuery()) {rows.next();if(rows.getLong(1)>=perOwnerMaximum)throw new CredentialException(Failure.CONFLICT);}
+            }
+            String secret=OidcClientCredentials.generate();
+            try(var statement=connection.prepareStatement("INSERT INTO oidc_client(client_id,client_secret,redirect_uris,grant_types,scopes,active,"
+                + "client_kind,owner_subject,secret_format,secret_hint,credential_revision) VALUES(?,?,?::jsonb,?::jsonb,?::jsonb,true,'owned',?,'pbkdf2-sha256-v1',?,1)")) {
+                statement.setString(1,registration.clientId());statement.setString(2,OidcClientSecrets.hash(secret));
+                statement.setString(3,json(registration.redirectUris()));statement.setString(4,json(registration.grantTypes()));
+                statement.setString(5,json(registration.protocolScopes()));statement.setString(6,registration.ownerSubject());
+                statement.setString(7,OidcClientCredentials.hint(secret));statement.executeUpdate();
+            }
+            return new IssuedCredential(OidcClientCredentials.read(connection,protocol,issuer,registration.clientId()),secret);
+        });
+    }
+
+    public CredentialStatus status(String clientId) {
+        OidcClientCredentials.identifier(clientId);
+        return transaction(connection->OidcClientCredentials.read(connection,protocol,issuer,clientId));
+    }
+
+    public String prepare(String clientId,long revision) {
+        OidcClientCredentials.identifier(clientId);
+        return transaction(connection->{
+            requireLoginClient(connection,clientId,revision);
+            String secret=OidcClientCredentials.generate();
+            try(var statement=connection.prepareStatement("INSERT INTO oidc_client_credential_maintenance(client_id,phase,baseline_revision,pending_hash,pending_hint) VALUES(?,'PENDING',?,?,?)")) {
+                statement.setString(1,clientId);statement.setLong(2,revision);
+                statement.setString(3,OidcClientSecrets.hash(secret));statement.setString(4,OidcClientCredentials.hint(secret));statement.executeUpdate();
+            }
+            return secret;
+        });
+    }
+
+    public CredentialStatus transition(String action,String clientId,long revision) {
+        if(!Set.of("activate","cancel","rollback","confirm").contains(action))throw new CredentialException(Failure.INVALID);
+        OidcClientCredentials.identifier(clientId);
+        return transaction(connection->{
+            requireLoginClient(connection,clientId,revision);
+            try(var statement=connection.prepareStatement("SELECT phase,baseline_revision,pending_hash,pending_hint,rollback_hash,rollback_hint FROM oidc_client_credential_maintenance WHERE client_id=? FOR UPDATE")) {
+                statement.setString(1,clientId);
+                try(var rows=statement.executeQuery()) {
+                    if(!rows.next())throw new CredentialException(Failure.CONFLICT);
+                    String phase=rows.getString(1);long baseline=rows.getLong(2);
+                    if(("activate".equals(action)||"cancel".equals(action)) && (!"PENDING".equals(phase)||baseline!=revision))
+                        throw new CredentialException(Failure.CONFLICT);
+                    if(("rollback".equals(action)||"confirm".equals(action)) && (!"ACTIVE".equals(phase)||baseline+1!=revision))
+                        throw new CredentialException(Failure.CONFLICT);
+                    if("activate".equals(action)) {
+                        try(var save=connection.prepareStatement("UPDATE oidc_client_credential_maintenance SET rollback_hash=client.client_secret,rollback_hint=client.secret_hint,phase='ACTIVE' FROM oidc_client client WHERE oidc_client_credential_maintenance.client_id=client.client_id AND client.client_id=?")) {
+                            save.setString(1,clientId);save.executeUpdate();
+                        }
+                        replace(connection,clientId,revision,rows.getString(3),rows.getString(4));
+                        try(var clear=connection.prepareStatement("UPDATE oidc_client_credential_maintenance SET pending_hash=null,pending_hint=null WHERE client_id=?")) {
+                            clear.setString(1,clientId);clear.executeUpdate();
+                        }
+                    }else {
+                        if("rollback".equals(action))replace(connection,clientId,revision,rows.getString(5),rows.getString(6));
+                        try(var remove=connection.prepareStatement("DELETE FROM oidc_client_credential_maintenance WHERE client_id=?")) {
+                            remove.setString(1,clientId);remove.executeUpdate();
+                        }
+                    }
+                }
+            }
+            return OidcClientCredentials.read(connection,protocol,issuer,clientId);
+        });
+    }
+
+    private void requireLoginClient(Connection connection,String clientId,long revision) throws SQLException {
+        var status=OidcClientCredentials.read(connection,protocol,issuer,clientId);
+        if(status.rotationMode()!=RotationMode.DEPLOYMENT_MAINTENANCE)throw new CredentialException(Failure.FORBIDDEN);
+        if(revision<0 || status.credentialRevision()!=revision)throw new CredentialException(Failure.CONFLICT);
+    }
+
+    private static void replace(Connection connection,String clientId,long revision,String hash,String hint) throws SQLException {
+        if(hash==null || !hash.startsWith("{pbkdf2-sha256-v1}"))throw new CredentialException(Failure.UNAVAILABLE);
+        try(var statement=connection.prepareStatement("UPDATE oidc_client SET client_secret=?,secret_hint=?,secret_format='pbkdf2-sha256-v1',credential_revision=credential_revision+1 WHERE client_id=? AND credential_revision=?")) {
+            statement.setString(1,hash);statement.setString(2,hint);statement.setString(3,clientId);statement.setLong(4,revision);
+            if(statement.executeUpdate()!=1)throw new CredentialException(Failure.CONFLICT);
+        }
+    }
+
+    private String json(Object value) {
+        try {return mapper.writeValueAsString(value);}
+        catch(com.fasterxml.jackson.core.JsonProcessingException failure) {throw new CredentialException(Failure.INVALID);}
+    }
+}
