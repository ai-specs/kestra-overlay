+import {describe, it, expect, vi} from "vitest"
+import {defineComponent, h, nextTick, reactive} from "vue"
+import {mount} from "@vue/test-utils"
+import {useFlowListIdentity} from "./useFlowListIdentity"
+function fixture(mode: boolean | undefined = true) {
+    const state = reactive({user: {} as unknown, isLogged: true, tenant: "main", configs: {required: mode}})
+    const invalidate = vi.fn(), reload = vi.fn<() => Promise<void>>().mockResolvedValue(), failed = vi.fn()
+    const wrapper = mount(defineComponent({setup() {
+        useFlowListIdentity({auth: state, tenant: () => state.tenant, mode: () => state.configs.required, invalidate, reload, failed})
+        return () => h("div")
+    }}))
+    return {state, invalidate, reload, failed, wrapper}
+}
+describe("Flow list identity lifecycle", () => {
+    it.each([false, true])("preserves mode %s on same-value async config replacement", async mode => {
+        const f = fixture(mode)
+        await Promise.resolve(); f.state.configs = {required: mode}; await nextTick()
+        expect(f.invalidate).not.toHaveBeenCalled(); expect(f.reload).not.toHaveBeenCalled(); f.wrapper.unmount()
+    })
+    it("invalidates synchronously and coalesces identity, tenant and mode into one reload", async () => {
+        const f = fixture()
+        f.state.user = {}; f.state.tenant = "next"; f.state.configs = {required: false}
+        expect(f.invalidate).toHaveBeenCalledTimes(3); expect(f.reload).not.toHaveBeenCalled()
+        await nextTick(); expect(f.reload).toHaveBeenCalledTimes(1); f.wrapper.unmount()
+    })
+    it.each([false, true])("recovers from unknown mode to %s without OSS fallback", async mode => {
+        const f = fixture(); f.state.configs.required = undefined
+        await nextTick(); expect(f.reload).not.toHaveBeenCalled()
+        f.state.configs = {required: mode}; expect(f.invalidate).toHaveBeenCalledTimes(2)
+        await nextTick(); expect(f.reload).toHaveBeenCalledTimes(1); f.wrapper.unmount()
+    })
+    it("does not reload after logout or without a user; reloads when identity returns", async () => {
+        const f = fixture(); f.state.isLogged = false
+        await nextTick(); expect(f.reload).not.toHaveBeenCalled()
+        f.state.user = undefined; f.state.isLogged = true
+        await nextTick(); expect(f.reload).not.toHaveBeenCalled()
+        f.state.user = {}; await nextTick(); expect(f.reload).toHaveBeenCalledTimes(1); f.wrapper.unmount()
+    })
+    it("unmount cancels a queued reload and invalidates synchronously", async () => {
+        const f = fixture(); f.state.user = {}; f.wrapper.unmount()
+        expect(f.invalidate).toHaveBeenCalledTimes(2); await nextTick(); expect(f.reload).not.toHaveBeenCalled()
+    })
+    it("reports current reload errors but ignores an old identity failure", async () => {
+        const f = fixture(); let reject!: (failure: unknown) => void
+        f.reload.mockImplementationOnce(() => new Promise((_, fail) => {reject = fail}))
+        f.state.user = {}; await nextTick(); f.state.user = {}; await nextTick()
+        reject(new Error("old identity")); await nextTick(); expect(f.failed).not.toHaveBeenCalled()
+        f.reload.mockRejectedValueOnce(new Error("current failure")); f.state.user = {}
+        await nextTick(); await nextTick(); expect(f.failed).toHaveBeenCalledWith(new Error("current failure")); f.wrapper.unmount()
+    })
+    it("retains a pre-mount change until mounted, even while native initial load is pending", async () => {
+        const state = reactive({user: {}, isLogged: true, mode: true})
+        const invalidate = vi.fn(), reload = vi.fn().mockResolvedValue(undefined)
+        const wrapper = mount(defineComponent({setup() {
+            useFlowListIdentity({auth:state,tenant:()=>"main",mode:()=>state.mode,invalidate,reload,failed:vi.fn()})
+            state.user = {}
+            expect(invalidate).toHaveBeenCalledTimes(1)
+            expect(reload).not.toHaveBeenCalled()
+            return () => h("div")
+        }}))
+        await nextTick()
+        expect(reload).toHaveBeenCalledTimes(1)
+        wrapper.unmount()
+    })
+
+})
diff --git a/ui/src/components/flows/useFlowListIdentity.ts b/ui/src/components/flows/useFlowListIdentity.ts
new file mode 100644
index 0000000..b4499b2
--- /dev/null
+++ b/ui/src/components/flows/useFlowListIdentity.ts
@@ -0,0 +1,45 @@
+import {nextTick, onBeforeUnmount, onMounted, watch} from "vue"
+
+export function useFlowListIdentity(options: {
+    auth: {user: unknown; isLogged: boolean}
+    tenant: () => unknown
+    mode: () => boolean | undefined
+    invalidate: () => void
+    reload: () => Promise<void> | undefined
+    failed: (failure: unknown) => void
+}) {
+    let mounted = false
+    let queued = false
+    let revision = 0
+    let pending = false
+    const queueCurrentQuery = () => {
+        if (!mounted || queued) return
+        queued = true
+        void nextTick(async () => {
+            queued = false
+            if (!mounted || !options.auth.isLogged || !options.auth.user || typeof options.mode() !== "boolean") return
+            pending = false
+            const current = revision
+            try {
+                await options.reload()
+            } catch (failure) {
+                if (mounted && current === revision) options.failed(failure)
+            }
+        })
+    }
+    watch([() => options.auth.user, () => options.auth.isLogged, options.tenant, options.mode], () => {
+        revision++
+        options.invalidate()
+        pending = true
+        queueCurrentQuery()
+    }, {flush: "sync"})
+    onMounted(() => {
+        mounted = true
+        if (pending) queueCurrentQuery()
+    })
+    onBeforeUnmount(() => {
+        mounted = false
+        revision++
+        options.invalidate()
+    })
+}
