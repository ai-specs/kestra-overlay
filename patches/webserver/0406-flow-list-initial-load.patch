diff --git a/ui/tests/flow-execution-capabilities/wait-for-condition.mjs b/ui/tests/flow-execution-capabilities/wait-for-condition.mjs
new file mode 100644
index 0000000..cf85d26
--- /dev/null
+++ b/ui/tests/flow-execution-capabilities/wait-for-condition.mjs
@@ -0,0 +1,21 @@
+export async function waitForCondition(page, predicate, argument, options = {}) {
+    const timeout = options.timeout ?? 30000
+    if (!Number.isFinite(timeout) || timeout <= 0) throw new Error("A finite positive condition timeout is required")
+    const deadline = Date.now() + timeout
+    while (true) {
+        const remaining = deadline - Date.now()
+        if (remaining <= 0) throw new Error(`Condition timed out after ${timeout}ms at ${page.url()}`)
+        let timer
+        try {
+            const value = await Promise.race([
+                page.evaluate(predicate, argument),
+                new Promise((_, reject) => {timer = setTimeout(() => reject(new Error(`Condition timed out after ${timeout}ms at ${page.url()}`)), remaining)}),
+            ])
+            if (value === true) return true
+        } finally {
+            clearTimeout(timer)
+        }
+        if (Date.now() >= deadline) throw new Error(`Condition timed out after ${timeout}ms at ${page.url()}`)
+        await page.waitForTimeout(Math.min(25, deadline - Date.now()))
+    }
+}
diff --git a/ui/tests/flow-execution-capabilities/wait-for-condition.test.mjs b/ui/tests/flow-execution-capabilities/wait-for-condition.test.mjs
new file mode 100644
index 0000000..ed4537c
--- /dev/null
+++ b/ui/tests/flow-execution-capabilities/wait-for-condition.test.mjs
@@ -0,0 +1,34 @@
+import {test} from "node:test"
+import assert from "node:assert/strict"
+import {waitForCondition} from "./wait-for-condition.mjs"
+const page = evaluate => ({evaluate, url:()=>"data:text/html,offline-condition-probe", waitForTimeout:delay=>new Promise(resolve=>setTimeout(resolve,delay))})
+test("awaits async false then true and forwards the argument",async()=>{
+    let attempts=0
+    const result=await waitForCondition(page(async(fn,arg)=>{await new Promise(resolve=>setTimeout(resolve,2));attempts++;return fn(arg,attempts)}),(expected,attempt)=>attempt>=expected,3,{timeout:500})
+    assert.equal(result,true);assert.equal(attempts,3)
+})
+test("async false times out instead of treating a Promise as success",async()=>{
+    let attempts=0
+    await assert.rejects(waitForCondition(page(async()=>{attempts++;return false}),()=>false,undefined,{timeout:60}),/Condition timed out after 60ms at data:/)
+    assert(attempts>=2)
+})
+test("only literal true succeeds",async()=>{
+    let attempts=0
+    await waitForCondition(page(async()=>++attempts===3?true:{truthy:true}),()=>true,undefined,{timeout:500})
+    assert.equal(attempts,3)
+})
+test("propagates predicate and document errors without retrying",async()=>{
+    for(const message of ["predicate failure","Execution context was destroyed"]){
+        const failure=new Error(message);let attempts=0
+        await assert.rejects(waitForCondition(page(async()=>{attempts++;throw failure}),()=>false),error=>error===failure)
+        assert.equal(attempts,1)
+    }
+})
+test("bounds a predicate which never settles",async()=>{
+    const started=Date.now()
+    await assert.rejects(waitForCondition(page(()=>new Promise(()=>{})),()=>false,undefined,{timeout:40}),/Condition timed out/)
+    assert(Date.now()-started<1000)
+})
+test("rejects unlimited or invalid deadlines",async()=>{
+    for(const timeout of [0,-1,Infinity,NaN])await assert.rejects(waitForCondition(page(async()=>true),()=>true,undefined,{timeout}),/finite positive/)
+})
