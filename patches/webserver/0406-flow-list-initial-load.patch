diff --git a/ui/tests/flow-execution-capabilities/lifecycle-cases.mjs b/ui/tests/flow-execution-capabilities/lifecycle-cases.mjs
new file mode 100644
index 0000000..53b5360
--- /dev/null
+++ b/ui/tests/flow-execution-capabilities/lifecycle-cases.mjs
@@ -0,0 +1,103 @@
+export const STARTUP_CASES = [
+ "mode-a-natural-first-load-same-config-in-flight",
+ "mode-a-natural-first-load-same-config-after-commit",
+ "mode-b-natural-first-load-same-config-in-flight",
+ "mode-b-natural-first-load-same-config-after-commit",
+ "unknown-to-mode-a-recovers-delayed-first-load",
+ "unknown-to-mode-b-recovers-delayed-first-load",
+]
+export const RECOVERY_CASES = [
+ "mode-b-to-a-recovers-current-query-with-stale-response",
+ "mode-a-to-b-recovers-current-query-with-stale-response",
+ "tenant-change-recovers-filter-sort-and-page",
+ "logout-suppresses-reload-and-login-recovers",
+ "unmount-cancels-queued-identity-reload",
+]
+export async function runStartupCases({record,page,control,evidence,dom,assert,baseUrl,diagnostics}) {
+ for(const name of STARTUP_CASES) await record(name,async test=>{
+    const modeA=name.includes("mode-a"), unknown=name.startsWith("unknown"), committed=name.endsWith("after-commit")
+    await control({mode:modeA?"all":"none",flowDelay:committed?0:350,rowPrefix:""})
+    await page.goto(`${baseUrl}/main/flows?configAfter=${committed?"committed":"pending"}&initialMode=${unknown?"unknown":String(!modeA)}&finalMode=${!modeA}`)
+    await page.waitForFunction(async()=>{const s=await fetch("/test/evidence").then(r=>r.json());return window.probe?.state().configApplied&&window.probe.state().total===2&&s.calls.filter(c=>c.kind==="flows").every(c=>c.completed)})
+    test.documentId=diagnostics.currentDocument()
+    const prefix=unknown?"fresh-":committed?"":"stale-"
+    await page.waitForFunction(expected=>{
+        const rows=[...document.querySelectorAll("tbody tr")]
+        return rows.length===expected.length&&expected.every((target,index)=>{
+            const row=rows[index],links=[...row.querySelectorAll("a")]
+            return row.getClientRects().length>0&&links.some(a=>a.textContent.trim()===target.id)
+                &&links.some(a=>a.textContent.trim()===target.namespace)
+        })
+    },[{id:`${prefix}one`,namespace:"company.sub"},{id:`${prefix}two`,namespace:"other"}])
+    await page.waitForFunction(()=>window.probe.state().nativeRowsReported)
+    if(modeA)await page.waitForFunction(()=>document.querySelectorAll(".row-graph canvas").length===2)
+    await page.waitForFunction(async()=>{const s=await fetch("/test/evidence").then(r=>r.json());return s.calls.every(c=>c.completed)})
+    const state=await evidence(),view=await dom(),flowCalls=state.calls.filter(c=>c.kind==="flows")
+    assert.equal(view.rows.length,2);assert.equal(view.errors.length,0)
+    assert.equal(flowCalls.length,unknown?2:1,"natural first load and only a real change may require compensation")
+    if(unknown)assert(view.rows.every(row=>row.text.includes("fresh-")&&!row.text.includes("stale-")))
+    if(modeA){assert.equal(state.calls.filter(c=>c.kind==="capability").length,0)}
+    else {assert.equal(state.calls.filter(c=>c.kind==="latest"||c.kind==="chart").length,0)}
+ })
+}
+export async function runRecoveryCases({record,page,control,evidence,dom,assert,baseUrl,diagnostics}) {
+ const settled=async(total=2)=>{
+    await page.waitForFunction(async total=>{const s=await fetch("/test/evidence").then(r=>r.json());return window.probe.state().total===total&&s.calls.filter(c=>c.kind==="flows").length>=2&&s.calls.every(c=>c.completed)},total)
+    await page.evaluate(()=>new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve))))
+ }
+ for(const [name,from,to] of [[RECOVERY_CASES[0],true,false],[RECOVERY_CASES[1],false,true]]) await record(name,async test=>{
+    await control({mode:"all",rowPrefix:""})
+    await page.goto(`${baseUrl}/main/flows?configAfter=committed&initialMode=${from}&finalMode=${from}`)
+    await page.waitForFunction(()=>window.probe?.state().configApplied&&window.probe.state().total===2)
+    test.documentId=diagnostics.currentDocument()
+    await control({mode:"all",holdKind:"flows",rowPrefix:"old-"})
+    await page.click('text="Refresh data"',{label:"start old mode request"})
+    await page.waitForFunction(async()=>{const s=await fetch("/test/evidence").then(r=>r.json());return s.calls.some(c=>c.kind==="flows"&&c.held&&!c.completed)})
+    await control({keepCalls:true,mode:to?"none":"all",rowPrefix:"fresh-"})
+    await page.evaluate(async value=>{await window.probe.replaceConfig(value);await fetch("/test/release",{method:"POST"})},to)
+    await settled()
+    const state=await evidence(),view=await dom()
+    assert.equal(view.rows.length,2);assert(view.rows.every(row=>row.text.includes("fresh-")&&!row.text.includes("old-")))
+    if(!to)assert.equal(state.calls.filter(c=>c.kind==="capability").length,0)
+    else assert.equal(state.calls.filter(c=>c.kind==="latest"||c.kind==="chart").length,0)
+ })
+ await record(RECOVERY_CASES[2],async test=>{
+    await control({mode:"none",flowTotal:50})
+    await page.goto(`${baseUrl}/main/flows?page=2&size=25&sort=id:desc&filters[q][EQUALS]=retained`)
+    await page.waitForFunction(()=>window.probe?.state().total===50)
+    test.documentId=diagnostics.currentDocument()
+    await page.evaluate(()=>window.probe.page(2))
+    await page.waitForFunction(async()=>{const s=await fetch("/test/evidence").then(r=>r.json());return s.calls.some(c=>c.kind==="flows"&&c.url.includes("page=2")&&c.completed)})
+    assert.equal(await page.evaluate(()=>new URL(location.href).searchParams.get("page")),"2")
+    assert.equal((await evidence()).calls.filter(c=>c.kind==="flows").at(-1).url.includes("page=2"),true)
+    await control({mode:"none",flowTotal:50,holdKind:"flows",rowPrefix:"old-"})
+    await page.click('text="Refresh data"',{label:"start old tenant request"})
+    await page.waitForFunction(async()=>{const s=await fetch("/test/evidence").then(r=>r.json());return s.calls.some(c=>c.kind==="flows"&&c.held&&!c.completed)})
+    await control({keepCalls:true,mode:"none",flowTotal:50,rowPrefix:"fresh-"})
+    const heldQuery=new URL((await evidence()).calls.find(c=>c.kind==="flows"&&c.held&&!c.completed).url,baseUrl).searchParams
+    assert.equal(heldQuery.get("page"),"2");assert.equal(heldQuery.get("sort"),"id:desc");assert.equal(heldQuery.get("filters[q][EQUALS]"),"retained")
+    await page.evaluate(async()=>{await window.probe.tenant();await fetch("/test/release",{method:"POST"})})
+    await settled(50)
+    const state=await evidence(),view=await dom(),query=new URL(state.calls.filter(c=>c.kind==="flows").at(-1).url,baseUrl).searchParams
+    assert.equal(query.get("page"),"2");assert.equal(query.get("sort"),"id:desc");assert.equal(query.get("filters[q][EQUALS]"),"retained")
+    const flowQueries=state.calls.filter(c=>c.kind==="flows").map(c=>new URL(c.url,baseUrl).searchParams)
+    assert.equal(flowQueries.length,2)
+    for(const actual of flowQueries){assert.equal(actual.get("page"),"2");assert.equal(actual.get("sort"),"id:desc");assert.equal(actual.get("filters[q][EQUALS]"),"retained")}
+    assert(view.rows.every(row=>row.text.includes("fresh-")&&!row.text.includes("old-")))
+    assert(state.calls.filter(c=>c.kind==="capability").some(c=>c.body.targets.every(target=>target.tenant==="next")))
+ })
+ await record(RECOVERY_CASES[3],async()=>{
+    await control({mode:"none"})
+    await page.evaluate(()=>window.probe.logout())
+    assert.equal((await dom()).rows.length,0);assert.equal((await evidence()).calls.length,0)
+    await page.evaluate(()=>window.probe.login())
+    await page.waitForFunction(()=>window.probe.state().total===2)
+    assert.equal((await evidence()).calls.filter(c=>c.kind==="flows").length,1)
+ })
+ await record(RECOVERY_CASES[4],async()=>{
+    await control({mode:"none"})
+    await page.evaluate(()=>window.probe.unmountAfterIdentity())
+    await page.evaluate(()=>new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve))))
+    assert.equal((await evidence()).calls.length,0);assert.equal((await dom()).rows.length,0)
+ })
+}
