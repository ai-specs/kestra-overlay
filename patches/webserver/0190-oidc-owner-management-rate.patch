+package io.kestra.webserver.oidc.services;
+
+import javax.sql.DataSource;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.context.annotation.Value;
+import io.micronaut.data.connection.jdbc.advice.DelegatingDataSource;
+import jakarta.inject.Singleton;
+
+@Singleton
+@Requires(property = "kestra.oidc.enabled", value = "true")
+public class OidcRegistrationRate {
+    private final DataSource source;
+    private final int maximum;
+    public OidcRegistrationRate(final DataSource source, @Value("${kestra.oidc.registration.requests-per-minute:60}") final int maximum) {
+        this.source = DelegatingDataSource.unwrapDataSource(source);
+        if (maximum < 1 || maximum > 10000) throw new IllegalArgumentException("Invalid registration rate limit");
+        this.maximum = maximum;
+    }
+    public boolean allow() {
+        try (var connection = source.getConnection(); var statement = connection.prepareStatement("""
+            INSERT INTO oidc_registration_rate(bucket,window_start,requests) VALUES ('global',now(),1)
+            ON CONFLICT(bucket) DO UPDATE SET
+              requests=CASE WHEN oidc_registration_rate.window_start<=now()-interval '1 minute' THEN 1 ELSE LEAST(oidc_registration_rate.requests+1,10001) END,
+              window_start=CASE WHEN oidc_registration_rate.window_start<=now()-interval '1 minute' THEN now() ELSE oidc_registration_rate.window_start END
+            RETURNING requests"""); var result = statement.executeQuery()) {
+            return result.next() && result.getInt(1) <= maximum;
+        } catch (java.sql.SQLException exception) { throw new IllegalStateException("registration_unavailable"); }
+    }
+}
