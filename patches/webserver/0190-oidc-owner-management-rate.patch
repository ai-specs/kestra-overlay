+package io.kestra.webserver.oidc.controllers;
+
+import java.net.URI;
+import java.util.Map;
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.kestra.webserver.oidc.services.OidcOwnershipService;
+import io.kestra.webserver.oidc.services.OidcSessionService;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.HttpStatus;
+import io.micronaut.http.annotation.Controller;
+import io.micronaut.http.annotation.Post;
+import io.micronaut.http.annotation.Body;
+import io.micronaut.scheduling.annotation.ExecuteOn;
+import io.micronaut.scheduling.TaskExecutors;
+
+@Controller("/oidc/clients")
+@Requires(property = "kestra.oidc.enabled", value = "true")
+@ExecuteOn(TaskExecutors.IO)
+public class OidcOwnedClientController {
+    private final OidcOwnershipService ownership;
+    private final OidcSessionService sessions;
+    private final OidcConfiguration configuration;
+    private final io.kestra.webserver.oidc.services.OidcUserService users;
+
+    public OidcOwnedClientController(final OidcOwnershipService ownership, final OidcSessionService sessions,
+        final OidcConfiguration configuration, final io.kestra.webserver.oidc.services.OidcUserService users) {
+        this.ownership = ownership;
+        this.sessions = sessions;
+        this.configuration = configuration;
+        this.users = users;
+    }
+
+    @Post("/{clientId}/revoke")
+    public HttpResponse<?> revoke(final String clientId, final HttpRequest<?> request, @Body final Map<String, String> form) {
+        final URI issuer = URI.create(configuration.getIssuer());
+        if (!(issuer.getScheme() + "://" + issuer.getRawAuthority()).equals(request.getHeaders().get("Origin"))) return HttpResponse.status(HttpStatus.FORBIDDEN);
+        final var subject = sessions.sessionIdFrom(request).flatMap(sessions::subject);
+        if (subject.isEmpty() || users.bySubject(subject.get()).isEmpty()) return HttpResponse.unauthorized();
+        if (!java.util.List.of("revoke", "delete").contains(form.getOrDefault("action", ""))) return HttpResponse.badRequest();
+        if (form.getOrDefault("interaction", "").isBlank()) return HttpResponse.status(HttpStatus.FORBIDDEN);
+        try {
+            ownership.revoke(clientId, subject.get(), "delete".equals(form.get("action")), form.get("interaction"), sessions.sessionIdFrom(request).orElseThrow());
+            return HttpResponse.noContent();
+        } catch (SecurityException exception) { return HttpResponse.status(HttpStatus.FORBIDDEN); }
+        catch (IllegalArgumentException exception) { return HttpResponse.notFound(); }
+    }
+
+    @io.micronaut.http.annotation.Get("/{clientId}")
+    public HttpResponse<?> detail(final String clientId, final HttpRequest<?> request) {
+        final var subject = sessions.sessionIdFrom(request).flatMap(sessions::subject);
+        if (subject.isEmpty() || users.bySubject(subject.get()).isEmpty()) return HttpResponse.unauthorized();
+        try {
+            final var state = ownership.state(clientId);
+            return HttpResponse.ok(Map.of("client_id", clientId, "client_name", state.name(), "active", state.active(),
+                "interaction", ownership.managementInteraction(clientId, subject.get(), sessions.sessionIdFrom(request).orElseThrow())))
+                .header("Cache-Control", "no-store");
+        } catch (IllegalArgumentException exception) { return HttpResponse.notFound(); }
+    }
+
+    @io.micronaut.http.annotation.Get
+    public HttpResponse<?> list(final HttpRequest<?> request,
+        @io.micronaut.http.annotation.QueryValue(defaultValue = "1") final int page,
+        @io.micronaut.http.annotation.QueryValue(defaultValue = "20") final int size) {
+        final var subject = sessions.sessionIdFrom(request).flatMap(sessions::subject);
+        if (subject.isEmpty() || users.bySubject(subject.get()).isEmpty()) return HttpResponse.unauthorized();
+        try { return HttpResponse.ok(Map.of("clients", ownership.ownedClients(subject.get(), page, size), "page", page, "size", size)).header("Cache-Control", "no-store"); }
+        catch (IllegalArgumentException exception) { return HttpResponse.badRequest(); }
+    }
+}
