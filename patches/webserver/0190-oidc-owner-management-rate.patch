+package io.kestra.webserver.oidc;
+
+import io.kestra.webserver.oidc.services.OidcRegistrationRate;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class OidcRegistrationRateTest extends OidcPostgresTestBase {
+    @Test
+    void multipleInstancesShareDatabaseRateWindow() throws Exception {
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("TRUNCATE oidc_registration_rate");
+        }
+        final var first = new OidcRegistrationRate(dataSource(), 2);
+        final var second = new OidcRegistrationRate(dataSource(), 2);
+        assertTrue(first.allow());
+        assertTrue(second.allow());
+        assertFalse(first.allow());
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("UPDATE oidc_registration_rate SET window_start=now()-interval '2 minutes'");
+        }
+        assertTrue(second.allow());
+    }
+}
