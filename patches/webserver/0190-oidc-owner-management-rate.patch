+import io.kestra.webserver.oidc.services.OidcUserService;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assumptions.assumeTrue;
+
+class OidcSecondUserFixtureTest {
+    @Test
+    void createNormalSecondUserThroughProductionService() {
+        final String url = System.getenv("OIDC_FIXTURE_JDBC");
+        assumeTrue(url != null, "Controlled image acceptance fixture only");
+        final var source = new org.postgresql.ds.PGSimpleDataSource();
+        source.setURL(url);
+        source.setUser("kestra");
+        source.setPassword("local-ci-only");
+        new OidcUserService(source, new ObjectMapper()).create(new OidcUserService.CreateUserRequest(
+            "second-user", "Second user", "second@example.test", "SecondPass123!", java.util.List.of("user")));
+    }
