+    public void revoke(final String clientId, final String subject, final boolean delete, final String interaction, final String session) {
+        if (subject == null || subject.isBlank()) throw new IllegalArgumentException("Invalid client ownership");
+        try (var connection = source.getConnection()) {
+            connection.setAutoCommit(false);
+            try {
+                try (var lock = connection.prepareStatement("SELECT pg_advisory_xact_lock(1500150)")) { lock.execute(); }
+                final var state = state(connection, clientId, true);
+                if (!"owned".equals(state.kind()) || !subject.equals(state.owner())) throw new IllegalArgumentException("Invalid client ownership");
+                requireActive(connection, subject);
+                if (interaction != null) {
+                    try (var statement = connection.prepareStatement("DELETE FROM oidc_client_management WHERE interaction=? AND client_id=? AND subject=? AND session_id=? AND expires_at>now()")) {
+                        statement.setString(1, interaction);
+                        statement.setString(2, clientId);
+                        statement.setString(3, subject);
+                        statement.setString(4, session);
+                        if (statement.executeUpdate() != 1) throw new SecurityException("Invalid management interaction");
+                    }
+                }
+                for (final String sql : List.of("UPDATE oidc_client SET active=FALSE WHERE client_id=?",
+                    "UPDATE oidc_token SET revoked=TRUE WHERE client_id=?", "UPDATE oidc_authorization_code SET used=TRUE WHERE client_id=?",
+                    "DELETE FROM oidc_consent WHERE client_id=?")) {
+                    try (var statement = connection.prepareStatement(sql)) {
+                        statement.setString(1, clientId);
+                        statement.executeUpdate();
+                    }
+                }
+                if (delete) {
+                    try (var statement = connection.prepareStatement("DELETE FROM oidc_client WHERE client_id=?")) {
+                        statement.setString(1, clientId);
+                        statement.executeUpdate();
+                    }
+                }
+                connection.commit();
+            } catch (RuntimeException | SQLException exception) {
+                connection.rollback();
+                throw exception;
+            }
+        } catch (SQLException exception) { throw new IllegalStateException("Cannot revoke client"); }
+    }
