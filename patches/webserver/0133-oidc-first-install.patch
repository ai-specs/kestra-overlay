+package io.kestra.webserver.oidc;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.anyString;
+import static org.mockito.Mockito.eq;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.util.Map;
+import java.util.Optional;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.concurrent.Executors;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.kestra.webserver.oidc.services.OidcSetupService;
+import io.kestra.webserver.oidc.services.OidcUserService;
+import io.kestra.webserver.oidc.services.OidcClientService;
+import io.micronaut.context.env.Environment;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class OidcSetupServiceTest extends OidcPostgresTestBase {
+    private Environment environment;
+    private OidcConfiguration configuration;
+    @TempDir
+    Path receiptDirectory;
+
+    @BeforeEach
+    void reset() throws Exception {
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("TRUNCATE oidc_setup,oidc_user,oidc_client CASCADE");
+        }
+        environment = mock(Environment.class);
+        when(environment.getProperty(anyString(), eq(String.class))).thenReturn(Optional.empty());
+        property("kestra.oidc.bootstrap.receipt-path", receiptDirectory.resolve("installation").toString());
+        property("micronaut.security.oauth2.clients.kestra.client-id", "setup-ui");
+        property("micronaut.security.oauth2.clients.kestra.client-secret", "setup-secret");
+        configuration = new OidcConfiguration();
+    }
+
+    private void property(final String key, final String value) {
+        when(environment.getProperty(key, String.class)).thenReturn(Optional.of(value));
+    }
+
+    private OidcSetupService service() {
+        return new OidcSetupService(dataSource(), configuration, environment);
+    }
+
+    private Map<String, String> account(final String username) {
+        return Map.of("username", username, "password", "SetupPass123!", "name", "First User", "email", "first@example.org");
+    }
+
+    @Test
+    void emptyDirectoryNeedsSetupAndStoresAccountClientAndMarkerAtomically() {
+        final var setup = service();
+        assertFalse(setup.ready());
+        assertTrue(setup.setup(account("first")));
+        final var users = new OidcUserService(dataSource(), new ObjectMapper());
+        assertTrue(users.validateCredentials("first", "SetupPass123!"));
+        assertTrue(users.storedPasswordHash("first").orElseThrow().startsWith("$2a$"));
+        final var clients = new OidcClientService(dataSource(), new ObjectMapper());
+        assertTrue(clients.authenticate("setup-ui", "setup-secret"));
+        assertEquals(java.util.List.of("http://localhost:8080/oauth/callback/kestra"),
+            clients.find("setup-ui").orElseThrow().redirectUris());
+        assertFalse(service().setup(account("second")));
+        users.delete("first");
+        assertTrue(service().ready());
+        assertFalse(service().setup(account("second")));
+    }
+
+    @Test
+    void environmentSkipsSetupAndRestartDoesNotOverwritePassword() {
+        property("KESTRA_OIDC_BOOTSTRAP_USERNAME", "environment-user");
+        property("KESTRA_OIDC_BOOTSTRAP_PASSWORD", "SetupPass123!");
+        assertTrue(service().ready());
+        property("KESTRA_OIDC_BOOTSTRAP_PASSWORD", "ChangedPass123!");
+        assertTrue(service().ready());
+        final var users = new OidcUserService(dataSource(), new ObjectMapper());
+        assertTrue(users.validateCredentials("environment-user", "SetupPass123!"));
+        assertFalse(users.validateCredentials("environment-user", "ChangedPass123!"));
+    }
+
+    @Test
+    void partialEnvironmentAndInvalidPasswordLeaveDatabaseEmpty() {
+        property("KESTRA_OIDC_BOOTSTRAP_USERNAME", "partial");
+        assertThrows(IllegalArgumentException.class, () -> service().ready());
+        assertThrows(IllegalArgumentException.class, () -> service().setup(Map.of("username", "first", "password", "short")));
+        assertTrue(new OidcUserService(dataSource(), new ObjectMapper()).list().isEmpty());
+        assertTrue(new OidcClientService(dataSource(), new ObjectMapper()).list().isEmpty());
+    }
+
+    @Test
+    void clientConflictRollsBackUserAndDoesNotChangeExistingSecret() {
+        final var clients = new OidcClientService(dataSource(), new ObjectMapper());
+        clients.create("setup-ui", "other-secret", java.util.List.of("https://other.example/cb"),
+            java.util.List.of("authorization_code"), java.util.List.of("openid"));
+        assertThrows(IllegalArgumentException.class, () -> service().setup(account("first")));
+        assertTrue(new OidcUserService(dataSource(), new ObjectMapper()).list().isEmpty());
+        assertTrue(clients.authenticate("setup-ui", "other-secret"));
+        assertFalse(service().ready());
+    }
+
+    @Test
+    void concurrentSetupCreatesOnlyOneAccount() throws Exception {
+        try (var executor = Executors.newFixedThreadPool(2)) {
+            final var first = executor.submit(() -> service().setup(account("first")));
+            final var second = executor.submit(() -> service().setup(account("second")));
+            assertNotEquals(first.get(), second.get());
+        }
+        assertEquals(1, new OidcUserService(dataSource(), new ObjectMapper()).list().size());
+    }
+
+    @Test
+    void existingUserIsPreservedAndClosesSetup() {
+        final var users = new OidcUserService(dataSource(), new ObjectMapper());
+        users.create(new OidcUserService.CreateUserRequest("existing", "Existing", "existing@example.org",
+            "ExistingPass123!", java.util.List.of("user")));
+        assertTrue(service().ready());
+        assertTrue(users.validateCredentials("existing", "ExistingPass123!"));
+        assertFalse(service().setup(account("first")));
+    }
+
+    @Test
+    void deletingDatabaseMarkerAndUsersCannotReopenSetupOrEnvironmentBootstrap() throws Exception {
+        final var installed = service();
+        assertTrue(installed.setup(account("first")));
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("TRUNCATE oidc_setup,oidc_user CASCADE");
+        }
+        property("KESTRA_OIDC_BOOTSTRAP_USERNAME", "attacker");
+        property("KESTRA_OIDC_BOOTSTRAP_PASSWORD", "AttackerPass123!");
+        assertThrows(IllegalStateException.class, installed::ready);
+        assertThrows(IllegalStateException.class, () -> service().setup(account("attacker")));
+        assertThrows(IllegalStateException.class, () -> service().ready());
+        assertTrue(new OidcUserService(dataSource(), new ObjectMapper()).list().isEmpty());
+    }
+
+    @Test
+    void deletingReceiptRestoresSameIdentityWithoutActivatingSetup() throws Exception {
+        assertTrue(service().setup(account("first")));
+        final String original = Files.readString(receiptDirectory.resolve("installation"));
+        Files.delete(receiptDirectory.resolve("installation"));
+        assertTrue(service().ready());
+        assertEquals(original, Files.readString(receiptDirectory.resolve("installation")));
+        assertFalse(service().setup(account("second")));
+    }
+
+    @Test
+    void corruptedOrReplacedReceiptFailsClosedEvenInSameProcess() throws Exception {
+        final var installed = service();
+        assertTrue(installed.setup(account("first")));
+        final Path path = receiptDirectory.resolve("installation");
+        Files.writeString(path, "deleted or corrupted");
+        assertThrows(IllegalStateException.class, installed::ready);
+        Files.writeString(path, "kestra-oidc-installation-v1\n" + java.util.UUID.randomUUID() + "\n");
+        assertThrows(IllegalStateException.class, () -> service().setup(account("attacker")));
+    }
+
+    @Test
+    void explicitDisableRejectsFormButAllowsEnvironmentFirstInstall() {
+        property("KESTRA_OIDC_SETUP_ALLOWED", "false");
+        assertThrows(IllegalStateException.class, () -> service().ready());
+        assertThrows(IllegalStateException.class, () -> service().setup(account("first")));
+        property("KESTRA_OIDC_BOOTSTRAP_USERNAME", "environment-user");
+        property("KESTRA_OIDC_BOOTSTRAP_PASSWORD", "SetupPass123!");
+        assertTrue(service().ready());
+        assertFalse(service().setup(account("second")));
+    }
+
+    @Test
+    void transactionFailureLeavesLatchAndCannotAutomaticallyRetry() throws Exception {
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("ALTER TABLE oidc_user ADD CONSTRAINT setup_reject_test CHECK (username <> 'reject')");
+        }
+        try {
+            assertThrows(IllegalStateException.class, () -> service().setup(account("reject")));
+            assertTrue(Files.exists(receiptDirectory.resolve("installation")));
+            assertTrue(new OidcUserService(dataSource(), new ObjectMapper()).list().isEmpty());
+            assertTrue(new OidcClientService(dataSource(), new ObjectMapper()).list().isEmpty());
+            assertThrows(IllegalStateException.class, () -> service().ready());
+            assertThrows(IllegalStateException.class, () -> service().setup(account("first")));
+        } finally {
+            try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+                statement.execute("ALTER TABLE oidc_user DROP CONSTRAINT setup_reject_test");
+            }
+        }
+    }
+}
