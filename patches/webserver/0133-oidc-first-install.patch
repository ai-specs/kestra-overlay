@@ -0,0 +1,83 @@
+package io.kestra.webserver.oidc.services;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.channels.FileChannel;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.util.Optional;
+import java.util.Set;
+
+public final class OidcInstallationReceipt {
+    private static final String PREFIX = "kestra-oidc-installation-v1\n";
+    private final Path path;
+
+    public OidcInstallationReceipt(final Path path) {
+        this.path = path.toAbsolutePath().normalize();
+    }
+
+    public Optional<String> read() {
+        try {
+            checkPath();
+            if (!Files.exists(path, LinkOption.NOFOLLOW_LINKS)) {
+                return Optional.empty();
+            }
+            if (!Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS) || Files.size(path) > 128) {
+                throw new IllegalStateException("OIDC installation receipt is invalid");
+            }
+            final String value = Files.readString(path, StandardCharsets.UTF_8);
+            if (!value.startsWith(PREFIX) || !value.endsWith("\n")) {
+                throw new IllegalStateException("OIDC installation receipt is invalid");
+            }
+            final String identity = value.substring(PREFIX.length(), value.length() - 1);
+            if (!identity.matches("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")) {
+                throw new IllegalStateException("OIDC installation receipt is invalid");
+            }
+            final var permissions = Files.getPosixFilePermissions(path, LinkOption.NOFOLLOW_LINKS);
+            if (!PosixFilePermissions.fromString("rw-------").containsAll(permissions)) {
+                throw new IllegalStateException("OIDC installation receipt permissions are invalid");
+            }
+            return Optional.of(identity);
+        } catch (IOException exception) {
+            throw new IllegalStateException("OIDC installation receipt is unavailable");
+        }
+    }
+
+    public void create(final String identity) {
+        try {
+            checkPath();
+            final Optional<String> existing = read();
+            if (existing.isPresent()) {
+                if (!existing.get().equals(identity)) {
+                    throw new IllegalStateException("OIDC installation identity mismatch");
+                }
+                return;
+            }
+            Files.createDirectories(path.getParent());
+            checkPath();
+            try (var channel = FileChannel.open(path, Set.of(StandardOpenOption.CREATE_NEW, StandardOpenOption.WRITE),
+                PosixFilePermissions.asFileAttribute(PosixFilePermissions.fromString("rw-------")))) {
+                final ByteBuffer bytes = ByteBuffer.wrap((PREFIX + identity + "\n").getBytes(StandardCharsets.UTF_8));
+                while (bytes.hasRemaining()) {
+                    channel.write(bytes);
+                }
+                channel.force(true);
+            }
+            try (var directory = FileChannel.open(path.getParent(), StandardOpenOption.READ)) {
+                directory.force(true);
+            }
+        } catch (IOException exception) {
+            throw new IllegalStateException("OIDC installation receipt cannot be persisted");
+        }
+    }
+
+    private void checkPath() {
+        if (Files.isSymbolicLink(path) || Files.isSymbolicLink(path.getParent())) {
+            throw new IllegalStateException("OIDC installation receipt must not be a symbolic link");
+        }
+    }
+}
diff --git a/webserver/src/main/java/io/kestra/webserver/oidc/services/OidcSetupService.java b/webserver/src/main/java/io/kestra/webserver/oidc/services/OidcSetupService.java
new file mode 100644
index 0000000..8fa17d0
--- /dev/null
+++ b/webserver/src/main/java/io/kestra/webserver/oidc/services/OidcSetupService.java
@@ -0,0 +1,205 @@
+package io.kestra.webserver.oidc.services;
+
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.Map;
+import java.util.Optional;
+import java.util.UUID;
+import java.nio.file.Path;
+import javax.sql.DataSource;
+
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.context.env.Environment;
+import io.micronaut.data.connection.jdbc.advice.DelegatingDataSource;
+import jakarta.inject.Singleton;
+import org.mindrot.jbcrypt.BCrypt;
+
+@Singleton
+@Requires(property = "kestra.oidc.enabled", value = "true")
+public class OidcSetupService {
+    private final DataSource dataSource;
+    private final OidcConfiguration configuration;
+    private final Environment environment;
+    private final OidcInstallationReceipt receipt;
+
+    public OidcSetupService(final DataSource dataSource, final OidcConfiguration configuration,
+        final Environment environment) {
+        this.dataSource = DelegatingDataSource.unwrapDataSource(dataSource);
+        this.configuration = configuration;
+        this.environment = environment;
+        final String configuredPath = property("kestra.oidc.bootstrap.receipt-path");
+        final String storagePath = property("kestra.storage.local.base-path");
+        this.receipt = new OidcInstallationReceipt(configuredPath.isEmpty()
+            ? Path.of(storagePath.isEmpty() ? "/app/storage" : storagePath, ".oidc-installation") : Path.of(configuredPath));
+    }
+
+    public boolean ready() {
+        return initialize(null);
+    }
+
+    public boolean setup(final Map<String, String> form) {
+        return initialize(form);
+    }
+
+    private boolean initialize(final Map<String, String> form) {
+        try (Connection connection = dataSource.getConnection()) {
+            connection.setAutoCommit(false);
+            try {
+                try (var statement = connection.prepareStatement("SELECT pg_advisory_xact_lock(1330133)")) {
+                    statement.execute();
+                }
+                final Optional<String> storedIdentity = storedIdentity(connection);
+                final Optional<String> receiptIdentity = receipt.read();
+                if (storedIdentity.isPresent()) {
+                    if (receiptIdentity.isPresent() && !receiptIdentity.get().equals(storedIdentity.get())) {
+                        throw new IllegalStateException("OIDC installation identity mismatch");
+                    }
+                    receipt.create(storedIdentity.get());
+                    connection.commit();
+                    return form == null;
+                }
+                if (receiptIdentity.isPresent()) {
+                    throw new IllegalStateException("OIDC installation record is missing; initialization is locked");
+                }
+                final boolean existingUsers = exists(connection, "SELECT EXISTS(SELECT 1 FROM oidc_user)");
+                if (existingUsers) {
+                    registerClient(connection, false);
+                    final String identity = UUID.randomUUID().toString();
+                    receipt.create(identity);
+                    markCompleted(connection, identity);
+                    connection.commit();
+                    return form == null;
+                }
+                final Map<String, String> values = form == null ? bootstrapValues() : form;
+                if (values == null) {
+                    if ("false".equalsIgnoreCase(property("KESTRA_OIDC_SETUP_ALLOWED"))) {
+                        throw new IllegalStateException("OIDC web setup is disabled");
+                    }
+                    connection.commit();
+                    return false;
+                }
+                if (form != null && "false".equalsIgnoreCase(property("KESTRA_OIDC_SETUP_ALLOWED"))) {
+                    throw new IllegalStateException("OIDC web setup is disabled");
+                }
+                final String username = values.getOrDefault("username", "").trim();
+                final String password = values.getOrDefault("password", "");
+                final String name = values.getOrDefault("name", username).trim();
+                final String email = values.getOrDefault("email", "").trim();
+                validate(username, password, name, email);
+                registerClient(connection, true);
+                final String identity = UUID.randomUUID().toString();
+                receipt.create(identity);
+                try (var statement = connection.prepareStatement(
+                    "INSERT INTO oidc_user (username,name,email,roles) VALUES (?,?,?,'[\"admin\"]')")) {
+                    statement.setString(1, username);
+                    statement.setString(2, name.isEmpty() ? username : name);
+                    statement.setString(3, email);
+                    statement.executeUpdate();
+                }
+                try (var statement = connection.prepareStatement(
+                    "INSERT INTO oidc_user_auth_method (user_id,type,credential) VALUES (?,'PASSWORD',?)")) {
+                    statement.setString(1, username);
+                    statement.setString(2, BCrypt.hashpw(password, BCrypt.gensalt(10)));
+                    statement.executeUpdate();
+                }
+                markCompleted(connection, identity);
+                connection.commit();
+                return true;
+            } catch (RuntimeException | SQLException exception) {
+                connection.rollback();
+                throw exception;
+            }
+        } catch (SQLException exception) {
+            throw new IllegalStateException("OIDC initialization failed");
+        }
+    }
+
+    private Map<String, String> bootstrapValues() {
+        final String username = property("KESTRA_OIDC_BOOTSTRAP_USERNAME");
+        final String password = property("KESTRA_OIDC_BOOTSTRAP_PASSWORD");
+        final String name = property("KESTRA_OIDC_BOOTSTRAP_NAME");
+        final String email = property("KESTRA_OIDC_BOOTSTRAP_EMAIL");
+        if (username.isEmpty() && password.isEmpty() && name.isEmpty() && email.isEmpty()) {
+            return null;
+        }
+        return Map.of("username", username, "password", password, "name", name, "email", email);
+    }
+
+    private String property(final String key) {
+        return environment.getProperty(key, String.class).orElse("");
+    }
+
+    private static void validate(final String username, final String password, final String name, final String email) {
+        if (!username.matches("[A-Za-z0-9._@+-]{1,128}") || password.length() < 8
+            || password.getBytes(StandardCharsets.UTF_8).length > 72 || name.length() > 200
+            || email.length() > 254 || (!email.isEmpty() && !email.matches("[^\\s@]+@[^\\s@]+\\.[^\\s@]+"))) {
+            throw new IllegalArgumentException("Provide a valid username, email and password (8 characters minimum, 72 UTF-8 bytes maximum)");
+        }
+    }
+
+    private void registerClient(final Connection connection, final boolean required) throws SQLException {
+        final String clientName = property("kestra.oidc.bootstrap.client-name").isEmpty()
+            ? "kestra" : property("kestra.oidc.bootstrap.client-name");
+        if (!clientName.matches("[a-zA-Z0-9_-]+")) {
+            throw new IllegalArgumentException("Invalid OIDC UI client configuration");
+        }
+        final String prefix = "micronaut.security.oauth2.clients." + clientName;
+        final String clientId = property(prefix + ".client-id");
+        final String secret = property(prefix + ".client-secret");
+        if (!required && clientId.isEmpty() && secret.isEmpty()) {
+            return;
+        }
+        final URI issuer = URI.create(configuration.getIssuer());
+        if (clientId.isBlank() || secret.isBlank() || issuer.getHost() == null
+            || !("http".equals(issuer.getScheme()) || "https".equals(issuer.getScheme()))
+            || issuer.getRawQuery() != null || issuer.getRawFragment() != null || issuer.getUserInfo() != null) {
+            throw new IllegalArgumentException("Configure the OIDC UI client ID, secret and public issuer before initialization");
+        }
+        final String callback = configuration.getIssuer().replaceAll("/+$", "") + "/oauth/callback/" + clientName;
+        try (var statement = connection.prepareStatement(
+            "SELECT client_secret,redirect_uris @> jsonb_build_array(?::text),active FROM oidc_client WHERE client_id=?")) {
+            statement.setString(1, callback);
+            statement.setString(2, clientId);
+            try (var result = statement.executeQuery()) {
+                if (result.next()) {
+                    if (!result.getString(1).equals(secret) || !result.getBoolean(2) || !result.getBoolean(3)) {
+                        throw new IllegalArgumentException("Existing OIDC UI client conflicts with configuration");
+                    }
+                    return;
+                }
+            }
+        }
+        try (var statement = connection.prepareStatement(
+            "INSERT INTO oidc_client (client_id,client_secret,redirect_uris,grant_types,scopes)"
+                + " VALUES (?,?,jsonb_build_array(?::text),'[\"authorization_code\",\"refresh_token\"]','[\"openid\",\"profile\",\"email\"]')")) {
+            statement.setString(1, clientId);
+            statement.setString(2, secret);
+            statement.setString(3, callback);
+            statement.executeUpdate();
+        }
+    }
+
+    private static boolean exists(final Connection connection, final String query) throws SQLException {
+        try (var statement = connection.prepareStatement(query); var result = statement.executeQuery()) {
+            result.next();
+            return result.getBoolean(1);
+        }
+    }
+
+    private static Optional<String> storedIdentity(final Connection connection) throws SQLException {
+        try (var statement = connection.prepareStatement("SELECT installation_id FROM oidc_setup");
+             var result = statement.executeQuery()) {
+            return result.next() ? Optional.of(result.getString(1)) : Optional.empty();
+        }
+    }
+
+    private static void markCompleted(final Connection connection, final String identity) throws SQLException {
+        try (var statement = connection.prepareStatement("INSERT INTO oidc_setup (singleton,installation_id) VALUES (true,?)")) {
+            statement.setString(1, identity);
+            statement.executeUpdate();
+        }
+    }
+}
