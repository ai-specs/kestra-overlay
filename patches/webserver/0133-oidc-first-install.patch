@@ -0,0 +1,77 @@
+package io.kestra.webserver.oidc;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.anyMap;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.util.Map;
+import io.kestra.webserver.oidc.controllers.OidcSetupController;
+import io.kestra.webserver.oidc.services.OidcSetupService;
+import io.micronaut.http.HttpMethod;
+import io.micronaut.http.HttpStatus;
+import io.micronaut.http.cookie.Cookie;
+import io.micronaut.http.simple.SimpleHttpRequest;
+import org.junit.jupiter.api.Test;
+
+class OidcSetupControllerTest {
+    private final OidcSetupService setup = mock(OidcSetupService.class);
+    private final OidcSetupController controller = new OidcSetupController(setup, new OidcConfiguration());
+
+    private SimpleHttpRequest<Map<String, String>> request(final String origin, final String token) {
+        final var request = new SimpleHttpRequest<Map<String, String>>(HttpMethod.POST, "/oidc/setup", Map.of());
+        request.header("Origin", origin);
+        request.cookie(Cookie.of("oidc_setup_csrf", token));
+        return request;
+    }
+
+    private String token() {
+        return controller.page(new SimpleHttpRequest<Void>(HttpMethod.GET, "/oidc/setup", null))
+            .getCookie("oidc_setup_csrf").orElseThrow().getValue();
+    }
+
+    @Test
+    void formUsesCsrfAndValidSubmissionEntersOidcLoginChain() {
+        final String token = token();
+        final var form = Map.of("csrf", token, "username", "first", "password", "FirstPass123!");
+        when(setup.setup(form)).thenReturn(true);
+        final var response = controller.submit(request("http://localhost:8080", token), form);
+        assertEquals(HttpStatus.SEE_OTHER, response.getStatus());
+        assertEquals("/ui/", response.getHeaders().get("Location"));
+        assertFalse(response.getCookies().findCookie("JWT").isPresent());
+        assertEquals("no-store", response.getHeaders().get("Cache-Control"));
+    }
+
+    @Test
+    void missingTamperedAndCrossOriginTokensCannotInitialize() {
+        final String token = token();
+        assertEquals(HttpStatus.FORBIDDEN, controller.submit(request("http://localhost:8080", token), Map.of()).getStatus());
+        assertEquals(HttpStatus.FORBIDDEN, controller.submit(request("http://localhost:8080", token), Map.of("csrf", token + "x")).getStatus());
+        assertEquals(HttpStatus.FORBIDDEN, controller.submit(request("https://attacker.example", token), Map.of("csrf", token)).getStatus());
+        final String expired = "1:" + token.substring(token.indexOf(':') + 1);
+        assertEquals(HttpStatus.FORBIDDEN, controller.submit(request("http://localhost:8080", expired), Map.of("csrf", expired)).getStatus());
+        verify(setup, never()).setup(anyMap());
+    }
+
+    @Test
+    void completedSetupIsClosedForGetAndPost() {
+        when(setup.ready()).thenReturn(true);
+        assertEquals(HttpStatus.NOT_FOUND, controller.page(new SimpleHttpRequest<Void>(HttpMethod.GET, "/oidc/setup", null)).getStatus());
+        assertEquals(HttpStatus.NOT_FOUND, controller.submit(request("http://localhost:8080", ""), Map.of()).getStatus());
+        verify(setup, never()).setup(anyMap());
+    }
+
+    @Test
+    void failuresDoNotExposeCredentials() {
+        final String token = token();
+        when(setup.setup(anyMap())).thenThrow(new IllegalArgumentException("SECRET_VALUE"));
+        final var response = controller.submit(request("http://localhost:8080", token), Map.of("csrf", token));
+        assertEquals(HttpStatus.BAD_REQUEST, response.getStatus());
+        assertTrue(response.body().toString().contains("valid account"));
+        assertFalse(response.body().toString().contains("SECRET_VALUE"));
+    }
+}
