+package io.kestra.webserver.oidc;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.attribute.PosixFilePermissions;
+import java.util.UUID;
+import io.kestra.webserver.oidc.services.OidcInstallationReceipt;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class OidcInstallationReceiptTest {
+    @TempDir
+    Path directory;
+
+    @Test
+    void receiptHasPrivatePermissionsAndCannotBeOverwritten() throws Exception {
+        final Path path = directory.resolve("receipt");
+        final var receipt = new OidcInstallationReceipt(path);
+        final String identity = UUID.randomUUID().toString();
+        receipt.create(identity);
+        assertEquals(identity, receipt.read().orElseThrow());
+        assertEquals(PosixFilePermissions.fromString("rw-------"), Files.getPosixFilePermissions(path));
+        assertThrows(IllegalStateException.class, () -> receipt.create(UUID.randomUUID().toString()));
+    }
+
+    @Test
+    void symlinkAndOversizedOrPubliclyWritableReceiptFailClosed() throws Exception {
+        final Path path = directory.resolve("receipt");
+        final Path target = directory.resolve("target");
+        Files.writeString(target, "target");
+        Files.createSymbolicLink(path, target);
+        final var receipt = new OidcInstallationReceipt(path);
+        assertThrows(IllegalStateException.class, receipt::read);
+        assertThrows(IllegalStateException.class, () -> receipt.create(UUID.randomUUID().toString()));
+        Files.delete(path);
+        Files.writeString(path, "x".repeat(200));
+        assertThrows(IllegalStateException.class, receipt::read);
+        Files.delete(path);
+        receipt.create(UUID.randomUUID().toString());
+        Files.setPosixFilePermissions(path, PosixFilePermissions.fromString("rw-rw-rw-"));
+        assertThrows(IllegalStateException.class, receipt::read);
+    }
+}
diff --git a/webserver/src/test/java/io/kestra/webserver/oidc/OidcSetupControllerTest.java b/webserver/src/test/java/io/kestra/webserver/oidc/OidcSetupControllerTest.java
