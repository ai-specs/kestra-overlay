@@ -0,0 +1,37 @@
+package io.kestra.webserver.oidc.controllers;
+
+import java.net.URI;
+import io.kestra.webserver.oidc.services.OidcSetupService;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.core.annotation.Nullable;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.annotation.RequestFilter;
+import io.micronaut.http.annotation.ServerFilter;
+import io.micronaut.scheduling.TaskExecutors;
+import io.micronaut.scheduling.annotation.ExecuteOn;
+
+@ServerFilter({"/ui/**", "/oauth/login/**", "/oidc/login", "/oidc/setup"})
+@Requires(property = "kestra.oidc.enabled", value = "true")
+@ExecuteOn(TaskExecutors.IO)
+public class OidcSetupFilter {
+    private final OidcSetupService setup;
+
+    public OidcSetupFilter(final OidcSetupService setup) {
+        this.setup = setup;
+    }
+
+    @RequestFilter
+    @Nullable
+    public HttpResponse<?> filter(final HttpRequest<?> request) {
+        try {
+            final boolean ready = setup.ready();
+            if ("/oidc/setup".equals(request.getPath())) {
+                return ready ? HttpResponse.notFound() : null;
+            }
+            return ready ? null : HttpResponse.seeOther(URI.create("/oidc/setup"));
+        } catch (IllegalArgumentException | IllegalStateException exception) {
+            return HttpResponse.serverError("OIDC initialization configuration is invalid");
+        }
+    }
+}
