+++ b/webserver/src/main/java/io/kestra/webserver/oidc/controllers/OidcSetupController.java
@@ -0,0 +1,149 @@
+package io.kestra.webserver.oidc.controllers;
+
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.SecureRandom;
+import java.time.Instant;
+import java.util.Base64;
+import java.util.Map;
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.kestra.webserver.oidc.services.OidcSetupService;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.HttpStatus;
+import io.micronaut.http.MediaType;
+import io.micronaut.http.annotation.Body;
+import io.micronaut.http.annotation.Consumes;
+import io.micronaut.http.annotation.Controller;
+import io.micronaut.http.annotation.Get;
+import io.micronaut.http.annotation.Post;
+import io.micronaut.http.annotation.Produces;
+import io.micronaut.http.cookie.Cookie;
+import io.micronaut.http.cookie.SameSite;
+import io.micronaut.scheduling.TaskExecutors;
+import io.micronaut.scheduling.annotation.ExecuteOn;
+
+@Controller("/oidc/setup")
+@Requires(property = "kestra.oidc.enabled", value = "true")
+@ExecuteOn(TaskExecutors.IO)
+public class OidcSetupController {
+    private final OidcSetupService setup;
+    private final OidcConfiguration configuration;
+    private final byte[] csrfKey = new byte[32];
+
+    public OidcSetupController(final OidcSetupService setup, final OidcConfiguration configuration) {
+        this.setup = setup;
+        this.configuration = configuration;
+        new SecureRandom().nextBytes(csrfKey);
+    }
+
+    @Get
+    @Produces(MediaType.TEXT_HTML)
+    public HttpResponse<?> page(final HttpRequest<?> request) {
+        try {
+            if (setup.ready()) {
+                return HttpResponse.notFound();
+            }
+            final String token = token();
+            return HttpResponse.ok(html(token, ""))
+                .contentType(MediaType.TEXT_HTML_TYPE)
+                .header("Cache-Control", "no-store")
+                .cookie(Cookie.of("oidc_setup_csrf", token).path("/oidc/setup").httpOnly(true)
+                    .secure(request.isSecure()).sameSite(SameSite.Strict).maxAge(600));
+        } catch (IllegalArgumentException | IllegalStateException exception) {
+            return HttpResponse.serverError("OIDC initialization configuration is invalid");
+        }
+    }
+
+    @Post
+    @Consumes(MediaType.APPLICATION_FORM_URLENCODED)
+    public HttpResponse<?> submit(final HttpRequest<?> request, @Body final Map<String, String> form) {
+        try {
+            if (setup.ready()) {
+                return HttpResponse.notFound();
+            }
+            final String token = form.getOrDefault("csrf", "");
+            final String cookie = request.getCookies().findCookie("oidc_setup_csrf").map(Cookie::getValue).orElse("");
+            if (!sameOrigin(request.getHeaders().get("Origin")) || !validToken(token)
+                || !MessageDigest.isEqual(token.getBytes(StandardCharsets.UTF_8), cookie.getBytes(StandardCharsets.UTF_8))) {
+                return HttpResponse.status(HttpStatus.FORBIDDEN);
+            }
+            if (!setup.setup(form)) {
+                return HttpResponse.status(HttpStatus.CONFLICT);
+            }
+            return HttpResponse.seeOther(URI.create("/ui/"))
+                .header("Cache-Control", "no-store")
+                .cookie(Cookie.of("oidc_setup_csrf", "").path("/oidc/setup").maxAge(0));
+        } catch (IllegalArgumentException exception) {
+            return HttpResponse.badRequest("Provide valid account fields and configure the UI client before initialization");
+        } catch (IllegalStateException exception) {
+            return HttpResponse.serverError("OIDC initialization failed");
+        }
+    }
+
+    private boolean sameOrigin(final String origin) {
+        try {
+            final URI actual = URI.create(origin == null ? "" : origin);
+            final URI expected = URI.create(configuration.getIssuer());
+            return expected.getScheme().equals(actual.getScheme()) && expected.getRawAuthority().equals(actual.getRawAuthority())
+                && (actual.getPath() == null || actual.getPath().isEmpty()) && actual.getRawQuery() == null
+                && actual.getRawFragment() == null;
+        } catch (IllegalArgumentException exception) {
+            return false;
+        }
+    }
+
+    private String token() {
+        final byte[] nonce = new byte[24];
+        new SecureRandom().nextBytes(nonce);
+        final String payload = Instant.now().plusSeconds(600).getEpochSecond() + ":"
+            + Base64.getUrlEncoder().withoutPadding().encodeToString(nonce);
+        return payload + ":" + sign(payload);
+    }
+
+    private boolean validToken(final String token) {
+        try {
+            final String[] parts = token.split(":");
+            return parts.length == 3 && token.length() < 200 && Long.parseLong(parts[0]) > Instant.now().getEpochSecond()
+                && Long.parseLong(parts[0]) <= Instant.now().plusSeconds(600).getEpochSecond()
+                && MessageDigest.isEqual(sign(parts[0] + ":" + parts[1]).getBytes(StandardCharsets.UTF_8),
+                    parts[2].getBytes(StandardCharsets.UTF_8));
+        } catch (IllegalArgumentException exception) {
+            return false;
+        }
+    }
+
+    private String sign(final String payload) {
+        try {
+            final Mac mac = Mac.getInstance("HmacSHA256");
+            mac.init(new SecretKeySpec(csrfKey, "HmacSHA256"));
+            return Base64.getUrlEncoder().withoutPadding().encodeToString(mac.doFinal(payload.getBytes(StandardCharsets.UTF_8)));
+        } catch (java.security.GeneralSecurityException exception) {
+            throw new IllegalStateException("OIDC setup token unavailable");
+        }
+    }
+
+    private static String html(final String token, final String error) {
+        return """
+            <!DOCTYPE html><html lang="en"><head><meta charset="utf-8">
+            <meta name="viewport" content="width=device-width,initial-scale=1"><title>Set up Kestra</title>
+            <style>body{margin:0;background:#f8f7fc;color:#252336;font-family:system-ui,sans-serif}
+            main{width:min(380px,calc(100vw - 48px));margin:8vh auto}h1{text-align:center}
+            label{display:block;margin:16px 0}input{box-sizing:border-box;width:100%%;padding:12px;
+            margin-top:8px;border:1px solid #d8d5e3;border-radius:6px;font:inherit}
+            button{width:100%%;padding:12px;border:0;border-radius:6px;background:#8405ff;color:white;font:inherit}</style>
+            </head><body><main><h1>Set up Kestra</h1><p>Create your first OIDC account.</p>%s
+            <form method="post" action="/oidc/setup"><input type="hidden" name="csrf" value="%s">
+            <label>Username<input name="username" required maxlength="128" autocomplete="username"></label>
+            <label>Display name<input name="name" maxlength="200" autocomplete="name"></label>
+            <label>Email<input name="email" type="email" maxlength="254" autocomplete="email"></label>
+            <label>Password<input name="password" type="password" required minlength="8" autocomplete="new-password"></label>
+            <button type="submit">Create account</button></form></main></body></html>
+            """.formatted(error, token);
+    }
+}
