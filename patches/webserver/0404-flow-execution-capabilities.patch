@@ -0,0 +1,137 @@
+package io.kestra.webserver.rbac;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import io.kestra.core.models.flows.AbstractFlow;
+import io.kestra.core.serializers.JacksonMapper;
+import io.micronaut.context.annotation.Value;
+import io.micronaut.http.*;
+import io.micronaut.http.exceptions.HttpStatusException;
+import io.micronaut.web.router.MethodBasedRouteMatch;
+import io.micronaut.web.router.RouteAttributes;
+import jakarta.inject.Singleton;
+import jakarta.validation.Validator;
+import reactor.core.publisher.Flux;
+import reactor.core.publisher.Mono;
+import java.time.Duration;
+import java.util.*;
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+
+/** Finite native-page projection of existing typed query decisions, never a permission grant. */
+@Singleton
+public final class FlowExecutionCapabilities {
+    public static final int MAX_BODY_BYTES = 128 * 1024;
+    public enum Capability { EXECUTION_STATISTICS_READ, LATEST_EXECUTIONS_LIST }
+    public enum State { AVAILABLE, UNAVAILABLE }
+    public record Target(String tenant, String namespace, String flowId, List<Capability> capabilities) {}
+    public record Result(String tenant, String namespace, String flowId, Map<Capability, State> capabilities) {}
+    public record Response(int formatVersion, List<Result> results) {}
+    private final TypedAuthorizationGate gate;
+    private final AuthorizationEvaluations evaluations;
+    private final Validator validator;
+    private final boolean typed;
+
+    public FlowExecutionCapabilities(TypedAuthorizationGate gate, AuthorizationEvaluations evaluations, Validator validator,
+        @Value("${kestra.rbac.typed.enabled:false}") boolean typed) {
+        this.gate = gate; this.evaluations = evaluations; this.validator = validator; this.typed = typed;
+    }
+
+    /** Only this authenticated POST delegates its complete finite plan to the controller. */
+    public static boolean matches(HttpRequest<?> request) {
+        var route = RouteAttributes.getRouteMatch(request).orElse(null);
+        return request.getMethod() == HttpMethod.POST
+            && request.getPath().equals("/api/v1/main/ui/flows/execution-capabilities")
+            && route instanceof MethodBasedRouteMatch<?, ?> method
+            && method.getDeclaringType().getName().equals("io.kestra.webserver.controllers.api.FlowExecutionCapabilitiesController")
+            && method.getMethodName().equals("query");
+    }
+
+    public List<Target> parse(String tenant, byte[] bytes) {
+        if (bytes.length > MAX_BODY_BYTES) throw error(HttpStatus.REQUEST_ENTITY_TOO_LARGE, "REQUEST_TOO_LARGE");
+        try {
+            JsonNode root;
+            try (var parser = JacksonMapper.ofJson().getFactory().createParser(bytes)) {
+                parser.enable(com.fasterxml.jackson.core.JsonParser.Feature.STRICT_DUPLICATE_DETECTION);
+                root = JacksonMapper.ofJson().readTree(parser);
+                if (parser.nextToken() != null) throw invalid();
+            }
+            fields(root, Set.of("formatVersion", "targets"));
+            if (!root.path("formatVersion").isIntegralNumber() || !root.path("formatVersion").canConvertToInt()
+                || root.path("formatVersion").intValue() != 1) throw error(HttpStatus.BAD_REQUEST, "UNSUPPORTED_VERSION");
+            JsonNode targets = root.path("targets");
+            if (!targets.isArray() || targets.isEmpty() || targets.size() > 100) throw invalid();
+            var result = new ArrayList<Target>();
+            var unique = new HashSet<List<String>>();
+            int count = 0;
+            for (JsonNode node : targets) {
+                fields(node, Set.of("tenant", "namespace", "flowId", "capabilities"));
+                String targetTenant = string(node, "tenant"), namespace = string(node, "namespace"), id = string(node, "flowId");
+                if (!"main".equals(tenant) || !tenant.equals(targetTenant)) throw error(HttpStatus.FORBIDDEN, "TENANT_MISMATCH");
+                // Reuse fixed upstream Flow constraints, including actual lengths and ID patterns.
+                if (!validator.validateValue(AbstractFlow.class, "id", id).isEmpty()
+                    || !validator.validateValue(AbstractFlow.class, "namespace", namespace).isEmpty()) throw invalid();
+                flowRead(new Target(tenant, namespace, id, List.of())); // existing typed namespace semantics
+                if (!unique.add(List.of(tenant, namespace, id))) throw invalid();
+                var requested = node.path("capabilities");
+                if (!requested.isArray() || requested.isEmpty() || requested.size() > 2) throw invalid();
+                var capabilities = new ArrayList<Capability>();
+                for (JsonNode value : requested) {
+                    if (!value.isTextual()) throw invalid();
+                    var capability = Capability.valueOf(value.textValue());
+                    if (capabilities.contains(capability)) throw invalid();
+                    capabilities.add(capability);
+                }
+                count += capabilities.size();
+                if (count > 200) throw invalid();
+                result.add(new Target(tenant, namespace, id, List.copyOf(capabilities)));
+            }
+            return List.copyOf(result);
+        } catch (HttpStatusException failure) { throw failure; }
+        catch (Exception invalid) { throw invalid(); }
+    }
+
+    public Mono<Response> query(RbacAuthorizer.Principal principal, String tenant, List<Target> targets) {
+        return Mono.defer(() -> {
+            if (!typed || !evaluations.ready()) return Mono.error(error(HttpStatus.SERVICE_UNAVAILABLE, "AUTHORIZATION_UNAVAILABLE"));
+            return gate.boundary(principal, tenant, () -> Flux.fromIterable(targets).concatMap(target ->
+                gate.authorize(principal, flowRead(target)).flatMap(flow -> {
+                    if (!flow.allowed()) return Mono.just(unavailable(target));
+                    return Flux.fromIterable(target.capabilities()).concatMap(capability ->
+                        gate.authorize(principal, executionQuery(target, capability)).map(decision -> Map.entry(capability,
+                            decision.allowed() && !decision.scope().intersect(domain(target, false)).effectiveDomain().terms().isEmpty()
+                                ? State.AVAILABLE : State.UNAVAILABLE)))
+                        .collect(LinkedHashMap<Capability, State>::new, (map, entry) -> map.put(entry.getKey(), entry.getValue()))
+                        .map(states -> new Result(target.tenant(), target.namespace(), target.flowId(), Collections.unmodifiableMap(states)));
+                }))).collectList().map(results -> new Response(1, List.copyOf(results)))
+                .timeout(Duration.ofSeconds(10));
+        });
+    }
+
+    static Operation flowRead(Target target) {
+        return new Operation(CONTRACT_VERSION, Source.REST, Resource.FLOW, Action.READ, target.tenant(), target.namespace(),
+            target.flowId(), domain(target, false), Coverage.SINGLE, Aggregate.NONE, SideEffect.READ_ONLY);
+    }
+    static Operation executionQuery(Target target, Capability capability) {
+        boolean latest = capability == Capability.LATEST_EXECUTIONS_LIST;
+        return new Operation(CONTRACT_VERSION, latest ? Source.REST : Source.DASHBOARD_AGGREGATE, Resource.EXECUTION,
+            latest ? Action.LIST : Action.READ, target.tenant(), latest ? target.namespace() : null, null,
+            domain(target, latest), Coverage.COMPLETE_QUERY, latest ? Aggregate.NONE : Aggregate.EXECUTION, SideEffect.READ_ONLY);
+    }
+    private static QueryDomain domain(Target target, boolean paginated) {
+        return new QueryDomain(List.of(target.namespace()), List.of(), List.of(), true, paginated);
+    }
+    private static Result unavailable(Target target) {
+        var states = new LinkedHashMap<Capability, State>();
+        target.capabilities().forEach(capability -> states.put(capability, State.UNAVAILABLE));
+        return new Result(target.tenant(), target.namespace(), target.flowId(), Collections.unmodifiableMap(states));
+    }
+    private static String string(JsonNode node, String key) {
+        if (!node.path(key).isTextual()) throw invalid();
+        return node.path(key).textValue();
+    }
+    private static void fields(JsonNode node, Set<String> expected) {
+        if (node == null || !node.isObject() || node.size() != expected.size()
+            || !expected.containsAll(node.properties().stream().map(Map.Entry::getKey).toList())) throw invalid();
+    }
+    private static HttpStatusException invalid() { return error(HttpStatus.BAD_REQUEST, "INVALID_REQUEST"); }
+    private static HttpStatusException error(HttpStatus status, String code) { return new HttpStatusException(status, code); }
+}
