index 0000000..a009816
--- /dev/null
+++ b/ui/src/components/flows/useFlowExecutionCapabilities.ts
@@ -0,0 +1,67 @@
+import {computed, onBeforeUnmount, ref} from "vue"
+import {useClient} from "@kestra-io/kestra-sdk"
+import {apiUrl} from "override/utils/route"
+
+export type Capability = "EXECUTION_STATISTICS_READ" | "LATEST_EXECUTIONS_LIST"
+export type FlowTarget = {id: string; namespace: string}
+const capabilities: Capability[] = ["EXECUTION_STATISTICS_READ", "LATEST_EXECUTIONS_LIST"]
+const key = (tenant: string, row: FlowTarget) => JSON.stringify([tenant, row.namespace, row.id])
+
+/** Current-page projection only. No policy cache, no global execution permission. */
+export function useFlowExecutionCapabilities(mode: () => boolean | undefined, tenant: () => string) {
+    const client = useClient()
+    const states = ref<Record<string, Partial<Record<Capability, boolean>>>>({})
+    const error = ref<unknown>()
+    let generation = 0
+    let controller: AbortController | undefined
+    const required = computed(() => mode() !== false) // missing config never implies OSS mode
+    const invalidate = () => {
+        generation++
+        controller?.abort()
+        controller = undefined
+        states.value = {}
+        error.value = undefined
+    }
+    const allowed = (row: FlowTarget, capability: Capability) => mode() === false
+        || states.value[key(tenant(), row)]?.[capability] === true
+    const load = async (rows: FlowTarget[]) => {
+        invalidate()
+        const current = generation
+        const currentTenant = tenant()
+        if (mode() === false || rows.length === 0) return {current: () => current === generation, rows}
+        if (mode() !== true) throw new Error("Missing flow execution capability configuration")
+        controller = new AbortController()
+        try {
+            const next: typeof states.value = {}
+            // Page sizes above 100 remain bounded HTTP batches, under this same page generation.
+            for (let offset = 0; offset < rows.length; offset += 100) {
+                const batch = rows.slice(offset, offset + 100)
+                const response = await client.post(`${apiUrl()}/ui/flows/execution-capabilities`, {
+                    formatVersion: 1,
+                    targets: batch.map(row => ({tenant: currentTenant, namespace: row.namespace, flowId: row.id, capabilities})),
+                }, {signal: controller.signal})
+                if (current !== generation) return {current: () => false, rows: []}
+                const body = response.data
+                if (body?.formatVersion !== 1 || !Array.isArray(body.results) || body.results.length !== batch.length)
+                    throw new Error("Invalid flow execution capability response")
+                for (let index = 0; index < batch.length; index++) {
+                    const result = body.results[index], row = batch[index]
+                    if (result.tenant !== currentTenant || result.namespace !== row.namespace || result.flowId !== row.id
+                        || Object.keys(result.capabilities ?? {}).length !== capabilities.length
+                        || capabilities.some(capability => !["AVAILABLE", "UNAVAILABLE"].includes(result.capabilities[capability])))
+                        throw new Error("Invalid flow execution capability target")
+                    next[key(currentTenant, row)] = Object.fromEntries(capabilities.map(capability => [capability, result.capabilities[capability] === "AVAILABLE"]))
+                }
+            }
+            if (current === generation) states.value = next
+        } catch (failure) {
+            if (current !== generation) return {current: () => false, rows: []}
+            states.value = {}
+            error.value = failure
+            throw failure // retain normal request error handling, never blanket-swallow 403
+        }
+        return {current: () => current === generation && currentTenant === tenant(), rows}
+    }
+    onBeforeUnmount(invalidate)
+    return {allowed, load, invalidate, error, required}
+}
