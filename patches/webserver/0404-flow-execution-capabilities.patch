index 0000000..5dd2030
--- /dev/null
+++ b/webserver/src/test/java/io/kestra/webserver/rbac/FlowExecutionCapabilitiesTest.java
@@ -0,0 +1,98 @@
+package io.kestra.webserver.rbac;
+
+import io.kestra.core.models.NamespaceDomain;
+import io.kestra.core.models.NamespaceDomain.*;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.http.*;
+import io.micronaut.http.exceptions.HttpStatusException;
+import jakarta.validation.Validation;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.concurrent.atomic.AtomicInteger;
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+import static io.kestra.webserver.rbac.FlowExecutionCapabilities.*;
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class FlowExecutionCapabilitiesTest {
+    private final RbacAuthorizer.Principal principal = new RbacAuthorizer.Principal("alice",List.of(),null,null,List.of());
+    private final Target target = new Target("main","company.sub","flow-one",List.of(Capability.values()));
+    private FlowExecutionCapabilities parser() {
+        return new FlowExecutionCapabilities(null,null,Validation.byDefaultProvider().configure().messageInterpolator(new org.hibernate.validator.messageinterpolation.ParameterMessageInterpolator()).buildValidatorFactory().getValidator(),true);
+    }
+    private byte[] body(String targets) { return ("{\"formatVersion\":1,\"targets\":"+targets+"}").getBytes(StandardCharsets.UTF_8); }
+    private String json(String id) { return "{\"tenant\":\"main\",\"namespace\":\"company.sub\",\"flowId\":\""+id+"\",\"capabilities\":[\"EXECUTION_STATISTICS_READ\",\"LATEST_EXECUTIONS_LIST\"]}"; }
+    @Test void validatesFiniteBatchAndUpstreamFlowConstraints() {
+        assertThat(parser().parse("main",body("["+json("a")+"]"))).hasSize(1);
+        assertThat(parser().parse("main",body("["+String.join(",",java.util.stream.IntStream.range(0,100).mapToObj(i->json("f"+i)).toList())+"]"))).hasSize(100);
+        for(String targets:List.of("[]","["+json("a")+","+json("a")+"]","["+json("a").replace("flowId","unknown")+"]","["+json("a".repeat(101))+"]","["+json("a").replace("LATEST_EXECUTIONS_LIST","EXECUTION_STATISTICS_READ")+"]","["+json("a").replace("LATEST_EXECUTIONS_LIST","UNKNOWN")+"]","["+String.join(",",java.util.stream.IntStream.range(0,101).mapToObj(i->json("f"+i)).toList())+"]"))
+            assertThatThrownBy(()->parser().parse("main",body(targets))).isInstanceOf(HttpStatusException.class);
+        assertThatThrownBy(()->parser().parse("main",new byte[MAX_BODY_BYTES+1])).isInstanceOf(HttpStatusException.class).extracting("status").isEqualTo(HttpStatus.REQUEST_ENTITY_TOO_LARGE);
+        assertThatThrownBy(()->parser().parse("main", "{\"formatVersion\":1,\"formatVersion\":1,\"targets\":[]}".getBytes(StandardCharsets.UTF_8))).isInstanceOf(HttpStatusException.class);
+        assertThatThrownBy(()->parser().parse("other",body("["+json("a")+"]"))).isInstanceOf(HttpStatusException.class);
+    }
+    @Test void preservesActualQueryOperationsAndNeverUsesFlowIdAsExecutionId() {
+        var flow=flowRead(target);assertThat(flow.resourceId()).isEqualTo("flow-one");assertThat(flow.coverage()).isEqualTo(Coverage.SINGLE);
+        var latest=executionQuery(target,Capability.LATEST_EXECUTIONS_LIST);
+        assertThat(latest.source()).isEqualTo(Source.REST);assertThat(latest.action()).isEqualTo(Action.LIST);assertThat(latest.aggregate()).isEqualTo(Aggregate.NONE);
+        var statistics=executionQuery(target,Capability.EXECUTION_STATISTICS_READ);
+        assertThat(statistics.source()).isEqualTo(Source.DASHBOARD_AGGREGATE);assertThat(statistics.action()).isEqualTo(Action.READ);assertThat(statistics.aggregate()).isEqualTo(Aggregate.EXECUTION);
+        for(var op:List.of(latest,statistics)){assertThat(op.resourceId()).isNull();assertThat(op.coverage()).isEqualTo(Coverage.COMPLETE_QUERY);assertThat(op.sideEffect()).isEqualTo(SideEffect.READ_ONLY);}
+    }
+    @Test void mixedNamespacesComplementAndRestrictedIdsUseOneFrozenEvaluationWithoutDataLookup() {
+        var begins=new AtomicInteger();var closes=new AtomicInteger();var calls=new ArrayList<Operation>();
+        var term=new Term(Universe.NAMESPACE,true,List.of(),List.of(),List.of(),List.of("company.blocked"),IdScope.RESTRICTED_IDS,List.of("execution-not-flow-one"));
+        var domain=QueryDomain.structured(new NamespaceDomain(List.of(term)),true,false);
+        var fixture=fixture(op->{calls.add(op);return op.resource()==Resource.FLOW
+            ? ("hidden".equals(op.resourceId())?Decision.deny("hidden"):Decision.allow(op.queryDomain()))
+            : Decision.allow(domain);},begins,closes);
+        var response=fixture.query(principal,"main",List.of(target,new Target("main","company.blocked","f",target.capabilities()),new Target("main","company2","f",target.capabilities()),new Target("main","company.sub","hidden",target.capabilities()))).block();
+        assertThat(response.results().get(0).capabilities().values()).containsOnly(State.AVAILABLE);
+        assertThat(response.results().get(1).capabilities().values()).containsOnly(State.UNAVAILABLE);
+        assertThat(response.results().get(2).capabilities().values()).containsOnly(State.AVAILABLE);
+        assertThat(response.results().get(3).capabilities().values()).containsOnly(State.UNAVAILABLE);
+        assertThat(begins.get()).isEqualTo(1);assertThat(closes.get()).isEqualTo(1);
+        assertThat(calls.stream().filter(op->op.resource()==Resource.EXECUTION)).hasSize(6);
+    }
+    @Test void deniedOrEmptyQueryDomainsRemainUnavailable() {
+        for(var decision:List.of(Decision.deny("query intersection empty"),Decision.allow(QueryDomain.empty()))){
+            var fixture=fixture(op->op.resource()==Resource.FLOW?Decision.allow(op.queryDomain()):decision,new AtomicInteger(),new AtomicInteger());
+            assertThat(fixture.query(principal,"main",List.of(target)).block().results().getFirst().capabilities().values()).containsOnly(State.UNAVAILABLE);
+        }
+    }
+    @Test void strictJsonRejectsNestedDuplicatesTrailingValuesAndAcceptsExactBodyLimit() {
+        String valid = new String(body("["+json("a")+"]"), StandardCharsets.UTF_8);
+        assertThat(parser().parse("main", (valid+" ".repeat(MAX_BODY_BYTES-valid.getBytes(StandardCharsets.UTF_8).length)).getBytes(StandardCharsets.UTF_8))).hasSize(1);
+        for(String invalid : List.of(valid.replace("\"flowId\":\"a\"", "\"flowId\":\"a\",\"flowId\":\"b\""), valid+" {}",valid.replace("\"formatVersion\":1", "\"formatVersion\":1.0"), valid.replace("company.sub", "company..sub"),valid.replace("\"flowId\":\"a\"", "\"flowId\":\" a\"")))
+            assertThatThrownBy(()->parser().parse("main",invalid.getBytes(StandardCharsets.UTF_8))).isInstanceOf(HttpStatusException.class);
+    }
+    @Test void scopeQueryDomainsRemainCorrelatedAcrossIdsAndNamespaces() {
+        var read = new NamespaceDomain(List.of(new Term(Universe.NAMESPACE,false,List.of("company.sub"),List.of(),List.of(),List.of(),IdScope.RESTRICTED_IDS,List.of("e-one"))));
+        var disjointList = new NamespaceDomain(List.of(new Term(Universe.NAMESPACE,false,List.of("company.sub"),List.of(),List.of(),List.of(),IdScope.RESTRICTED_IDS,List.of("e-two"))));
+        // Minimal host-owned provider input: precomputed domains, not the real plugin policy implementation.
+        for(var domain : List.of(read.intersect(disjointList),new NamespaceDomain(List.of()),read.intersect(read))) {
+            var fixture=fixture(op->op.resource()==Resource.FLOW?Decision.allow(op.queryDomain()):Decision.allow(QueryDomain.structured(domain,true,false)),new AtomicInteger(),new AtomicInteger());
+            var states=fixture.query(principal,"main",List.of(target)).block().results().getFirst().capabilities().values();
+            assertThat(states).containsOnly(domain.terms().isEmpty()?State.UNAVAILABLE:State.AVAILABLE);
+        }
+    }
+    @Test void missingFrozenProviderFails503WithoutLegacyFallback() {
+        var evaluations=mock(AuthorizationEvaluations.class);when(evaluations.ready()).thenReturn(false);
+        assertThatThrownBy(()->new FlowExecutionCapabilities(null,evaluations,null,true).query(principal,"main",List.of(target)).block()).isInstanceOf(HttpStatusException.class).extracting("status").isEqualTo(HttpStatus.SERVICE_UNAVAILABLE);
+    }
+    @SuppressWarnings("unchecked")
+    private FlowExecutionCapabilities fixture(java.util.function.Function<Operation,Decision> policy,AtomicInteger begins,AtomicInteger closes){
+        BeanProvider<AuthorizationEvaluationProviderV1> providers=mock(BeanProvider.class);when(providers.isUnique()).thenReturn(true);
+        when(providers.get()).thenReturn((p,t)->{begins.incrementAndGet();return CompletableFuture.completedFuture(new AuthorizationEvaluationV1(){
+            public CompletionStage<Decision> authorize(Operation op){return CompletableFuture.completedFuture(policy.apply(op));}
+            public CompletionStage<Void> close(){closes.incrementAndGet();return CompletableFuture.completedFuture(null);}
+        });});
+        var config=mock(RbacConfiguration.class);when(config.enabled()).thenReturn(true);
+        var evaluations=new AuthorizationEvaluations(true,config,true,providers);
+        var gate=new TypedAuthorizationGate(mock(BeanProvider.class),evaluations);
+        return new FlowExecutionCapabilities(gate,evaluations,null,true);
+    }
+}
