+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+import static org.assertj.core.api.Assertions.*;
+
+/** Real HTTP, explicit test identity/provider, H2 only; not production session acceptance. */
+@KestraTest(environments="h2")
+@Property(name="kestra.server-type",value="WEBSERVER")
+@Property(name="kestra.rbac.enabled",value="true")
+@Property(name="kestra.rbac.typed.enabled",value="true")
+@Property(name="kestra.rbac.evaluation.enabled",value="true")
+@Property(name="kestra.rbac.application-groups.enabled",value="false")
+@Property(name="micronaut.security.enabled",value="true")
+@Property(name="micronaut.security.filter.enabled",value="true")
+@Property(name="micronaut.security.intercept-url-map[0].pattern",value="/**")
+@Property(name="micronaut.security.intercept-url-map[0].access[0]",value="isAnonymous()")
+@Property(name="flow.capabilities.http.probe",value="true")
+@Property(name="flow.capabilities.http.identity",value="true")
+@Property(name="mcp.http.security.fixture",value="true")
+@Property(name="datasources.h2.url",value="jdbc:h2:mem:flow_capabilities_${random.uuid};DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE")
+class FlowExecutionCapabilitiesHttpTest {
+    static final String PATH="/api/v1/main/ui/flows/execution-capabilities";
+    static final String BODY="{\"formatVersion\":1,\"targets\":[{\"tenant\":\"main\",\"namespace\":\"company.sub\",\"flowId\":\"one\",\"capabilities\":[\"LATEST_EXECUTIONS_LIST\",\"EXECUTION_STATISTICS_READ\"]}]}";
+    @Inject EmbeddedServer server;
+    @Inject Policy policy;
+    @BeforeEach void reset(){policy.calls.set(0);policy.unavailable=false;}
+    @Test void projectsFiniteCapabilitiesWithNoStoreAndOneEvaluation() throws Exception {
+        var response=send(PATH,BODY,true,true,false);
+        assertThat(response.statusCode()).isEqualTo(200);
+        assertThat(response.headers().firstValue("Cache-Control")).contains("no-store");
+        var body=JacksonMapper.ofJson().readTree(response.body());
+        assertThat(body.path("formatVersion").asInt()).isEqualTo(1);
+        assertThat(body.path("results").get(0).path("capabilities").path("LATEST_EXECUTIONS_LIST").asText()).isEqualTo("UNAVAILABLE");
+        assertThat(policy.calls.get()).isEqualTo(3);
+    }
+    @Test void rejectsAnonymousCrossOriginDuplicateJsonAndOversizedBody() throws Exception {
+        assertThat(send(PATH,BODY,false,true,false).statusCode()).isEqualTo(401);
+        assertThat(send(PATH,BODY,true,false,false).statusCode()).isEqualTo(403);
+        assertThat(send(PATH,BODY.replace("\"formatVersion\":1","\"formatVersion\":1,\"formatVersion\":1"),true,true,false).statusCode()).isEqualTo(400);
+        assertThat(send(PATH," ".repeat(FlowExecutionCapabilities.MAX_BODY_BYTES+1),true,true,false).statusCode()).isEqualTo(413);
+        assertThat(policy.calls.get()).isZero();
+    }
+    @Test void jwtCookieWithoutCsrfCannotReachProjectionAndNearbyPathsDoNotDelegate() throws Exception {
+        assertThat(send(PATH,BODY,true,true,true).statusCode()).isEqualTo(403);
+        assertThat(send(PATH+"/other",BODY,true,true,false).statusCode()).isBetween(400,499);
+        assertThat(policy.calls.get()).isZero();
+    }
+    @Test void classifiedProviderFailureReturns503AndNeverAvailable() throws Exception {
+        policy.unavailable=true;
+        var response=send(PATH,BODY,true,true,false);
+        assertThat(response.statusCode()).isEqualTo(503);
+        var error=JacksonMapper.ofJson().readTree(response.body());
+        assertThat(error.path("code").asText()).isEqualTo("AUTHORIZATION_UNAVAILABLE");
+        assertThat(error.has("results")).isFalse();
+        assertThat(error.has("capabilities")).isFalse();
+        assertThat(response.headers().firstValue("Cache-Control")).contains("no-store");
+    }
+    @Test void publishesRequiredConfigurationBooleanFromHost() throws Exception {
+        var response=HttpClient.newHttpClient().send(HttpRequest.newBuilder(server.getURI().resolve("/api/v1/configs"))
+            .header("X-Flow-Capability-Test","alice").GET().build(),HttpResponse.BodyHandlers.ofString());
+        assertThat(response.statusCode()).isEqualTo(200);
+        assertThat(JacksonMapper.ofJson().readTree(response.body()).path("flowExecutionCapabilitiesRequired").booleanValue()).isTrue();
+    }
+    private HttpResponse<String> send(String path,String body,boolean identity,boolean origin,boolean cookie) throws Exception {
+        var builder=HttpRequest.newBuilder(server.getURI().resolve(path)).header("Content-Type","application/json");
+        if(identity)builder.header("X-Flow-Capability-Test","alice");
+        builder.header("Origin",origin?server.getURI().toString():"https://untrusted.example");
+        if(cookie)builder.header("Cookie","JWT=explicit-test-cookie");
+        return HttpClient.newHttpClient().send(builder.POST(HttpRequest.BodyPublishers.ofString(body)).build(),HttpResponse.BodyHandlers.ofString());
+    }
+    @Singleton @Requires(property="flow.capabilities.http.identity",value="true")
+    static class Identity implements AuthenticationFetcher<io.micronaut.http.HttpRequest<?>> {
+        public org.reactivestreams.Publisher<Authentication> fetchAuthentication(io.micronaut.http.HttpRequest<?> request){
+            return "alice".equals(request.getHeaders().get("X-Flow-Capability-Test"))?Mono.just(Authentication.build("alice",List.of())):Mono.empty();
+        }
+    }
+    @Singleton @Requires(property="flow.capabilities.http.probe",value="true")
+    static class Policy implements AuthorizationEvaluationProviderV1 {
+        final AtomicInteger calls=new AtomicInteger();
+        volatile boolean unavailable;
+        public CompletionStage<AuthorizationEvaluationV1> begin(RbacAuthorizer.Principal principal,String tenant){
+            if(unavailable)return CompletableFuture.failedFuture(new AuthorizationUnavailableException());
+            return CompletableFuture.completedFuture(new AuthorizationEvaluationV1(){
+                public CompletionStage<Decision> authorize(Operation operation){calls.incrementAndGet();return CompletableFuture.completedFuture((operation.resource()==Resource.FLOW || operation.resource()==Resource.METADATA)?Decision.allow(operation.queryDomain()):Decision.deny("No execution query permission"));}
+                public CompletionStage<Void> close(){return CompletableFuture.completedFuture(null);}
+            });
+        }
+    }
+}
