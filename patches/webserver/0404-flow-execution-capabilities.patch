index 0000000..93e56c3
--- /dev/null
+++ b/ui/tests/flow-execution-capabilities/diagnostics.mjs
@@ -0,0 +1,23 @@
+// Shared policy: recognize only exact, source-bound expected failures for this finite test plan.
+export function classifyDiagnostics(snapshot, caseName, currentDocument, previousIds = new Set()) {
+    const errors=snapshot.events.filter(event=>!previousIds.has(event.id)&&["console-error","page-error","http-error","request-failed","diagnostic-integrity-error"].includes(event.kind))
+    const expected=[],unexpected=[]
+    const exactCapability="http://127.0.0.1:5178/api/v1/main/ui/flows/execution-capabilities"
+    const exactLatest="http://127.0.0.1:5178/api/v1/main/executions/latest"
+    for(const event of errors){
+        let reason=null
+        const sameDocument=event.documentId===currentDocument
+        const sourceRequest=event.requestId??event.networkRequestId
+        const linked=snapshot.events.find(item=>item.kind==="request"&&item.requestId===sourceRequest&&item.documentId===currentDocument)
+        if(caseName==="provider503-native-clears-content-and-displays-error"&&sameDocument){
+            if(event.kind==="http-error"&&event.url===exactCapability&&event.status===503)reason="exact current-document capability 503"
+            if(event.kind==="console-error"&&event.source==="network"&&linked?.url===exactCapability
+                &&snapshot.events.some(item=>item.kind==="http-error"&&item.requestId===sourceRequest&&item.documentId===currentDocument&&item.status===503))reason="browser network log for the same capability 503"
+        }
+        const canceledCase=caseName==="identity-switch-cancels-pending-capability-projection"?exactCapability
+            :caseName==="identity-switch-cancels-pending-latest-and-unmounts-chart"?exactLatest:null
+        if(canceledCase&&sameDocument&&event.kind==="request-failed"&&event.url===canceledCase&&event.canceled===true&&event.error==="net::ERR_ABORTED")reason="explicit identity-switch cancellation of this exact request"
+        ;(reason?expected:unexpected).push({...event,...(reason?{expectedReason:reason}:{})})
+    }
+    return {expected,unexpected}
+}
