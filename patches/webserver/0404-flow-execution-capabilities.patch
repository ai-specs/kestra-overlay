+package io.kestra.webserver.controllers.api;
+
+import io.kestra.core.repositories.AuthorizationInvocationContext;
+import io.kestra.webserver.rbac.*;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.core.async.propagation.ReactorPropagation;
+import io.micronaut.core.propagation.PropagatedContext;
+import io.micronaut.http.*;
+import io.micronaut.http.annotation.*;
+import io.micronaut.http.server.util.HttpHostResolver;
+import io.micronaut.http.exceptions.HttpStatusException;
+import io.micronaut.scheduling.TaskExecutors;
+import io.micronaut.scheduling.annotation.ExecuteOn;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import reactor.core.publisher.Mono;
+import java.util.List;
+import java.util.Map;
+
+@Controller("/api/v1/{tenant}/ui/flows/execution-capabilities")
+@Requires(property = "kestra.rbac.enabled", value = "true")
+@ExecuteOn(TaskExecutors.IO)
+public final class FlowExecutionCapabilitiesController {
+    private final FlowExecutionCapabilities capabilities;
+    private final HttpHostResolver hostResolver;
+    public FlowExecutionCapabilitiesController(FlowExecutionCapabilities capabilities, HttpHostResolver hostResolver) {
+        this.capabilities = capabilities; this.hostResolver = hostResolver;
+    }
+
+    @Post(consumes = MediaType.APPLICATION_JSON, produces = MediaType.APPLICATION_JSON)
+    public Mono<MutableHttpResponse<?>> query(String tenant, @Body byte[] body, HttpRequest<?> request) {
+        return Mono.<MutableHttpResponse<?>>defer(() -> {
+            Authentication authentication = request.getAttribute(SecurityFilter.AUTHENTICATION, Authentication.class).orElse(null);
+            if (authentication == null) return Mono.just(error(HttpStatus.UNAUTHORIZED, "UNAUTHENTICATED"));
+            // Keep the existing API CSRF filter; additionally require the native browser's same-origin POST.
+            if (!hostResolver.resolve(request).equals(request.getHeaders().get(HttpHeaders.ORIGIN)))
+                return Mono.just(error(HttpStatus.FORBIDDEN, "ORIGIN_MISMATCH"));
+            var targets = capabilities.parse(tenant, body);
+            var principal = new RbacAuthorizer.Principal(authentication.getName(), List.copyOf(authentication.getRoles()), null, null, List.of());
+            return capabilities.query(principal, tenant, targets).map(result -> (MutableHttpResponse<?>) HttpResponse.ok(result))
+                .contextWrite(context -> ReactorPropagation.addPropagatedContext(context, PropagatedContext.empty()
+                    .plus(new AuthorizationInvocationContext(request, false))));
+        }).onErrorResume(failure -> {
+            if (failure instanceof HttpStatusException status) return Mono.just(error(status.getStatus(), status.getMessage()));
+            // Boundary failures are observable; already-folded gate denies remain UNAVAILABLE.
+            return Mono.just(error(HttpStatus.SERVICE_UNAVAILABLE, "AUTHORIZATION_UNAVAILABLE"));
+        }).map(response -> response.header(HttpHeaders.CACHE_CONTROL, "no-store"));
+    }
+    private static MutableHttpResponse<?> error(HttpStatus status, String code) {
+        return HttpResponse.status(status).body(Map.of("code", code));
+    }
+}
