+import fs from "node:fs"
+import crypto from "node:crypto"
+import {classifyDiagnostics} from "./diagnostics.mjs"
+const report=JSON.parse(fs.readFileSync(process.argv[2],"utf8"))
+const expected=[
+ "none-native-list-no-latest-no-chart-no-expected403",
+ "mixed-native-target-row-latest-and-chart",
+ "all-native-allowed-path-preserved",
+ "provider503-native-clears-content-and-displays-error",
+ "identity-switch-ignores-pending-flow-response",
+ "identity-switch-cancels-pending-latest-and-unmounts-chart",
+ "identity-switch-cancels-pending-capability-projection",
+ "pagination-ignores-older-flow-page-response",
+ "current-page-30s-expiry-rechecks-and-unmounts-revoked-content",
+ "mode-a-native-oss-without-capability-request",
+]
+if(report.transport!=="explicit-test-transport" || report.locale!=="en" || report.width!==1280 || !report.finishedAt || report.passed!==10
+ || !report.completed || !report.passedGate || !report.inputsRechecked || report.notRun!==0
+ || report.cases.some(c=>!c.diagnostics||c.diagnostics.unexpected?.length!==0)
+ || JSON.stringify(report.cases?.map(c=>c.name))!==JSON.stringify(expected) || report.cases.some(c=>c.status!=="passed"||!c.network||!c.dom||!c.finishedAt))
+ throw new Error("Native Flow list report must execute the exact ten cases without failure, skip or notRun")
+const covered=new Set()
+for(const test of report.cases){
+ if(!test.documentId||!Array.isArray(test.eventIds))throw new Error("Missing case document and diagnostic event association")
+ const delta=report.diagnostics.events.filter(event=>test.eventIds.includes(event.id))
+ if(delta.length!==test.eventIds.length||test.eventIds.some(id=>covered.has(id)))throw new Error("Missing or duplicated diagnostic events")
+ test.eventIds.forEach(id=>covered.add(id))
+ const classified=classifyDiagnostics({...report.diagnostics,events:report.diagnostics.events},test.name,test.documentId,new Set(report.diagnostics.events.filter(event=>!test.eventIds.includes(event.id)).map(event=>event.id)))
+ if(classified.unexpected.length||JSON.stringify(classified)!==JSON.stringify(test.diagnostics))throw new Error("Unclassified or forged case diagnostics")
+}
+if(report.diagnostics.events.some(event=>["console-error","page-error","http-error","request-failed","diagnostic-integrity-error"].includes(event.kind)&&!covered.has(event.id)))throw new Error("Browser error outside executed cases")
+const sources=["../../src/components/flows/Flows.vue","../../src/components/flows/useFlowExecutionCapabilities.ts","../../src/stores/executions.ts","./cases.mjs","./main.ts","./transport.ts","./serve.mjs","./diagnostics.mjs","./browser.mjs","./run-browser.mjs","./playwright.mjs","./check-report.mjs","../../package-lock.json"]
+if(JSON.stringify(Object.keys(report.inputs??{}))!==JSON.stringify([...sources,"overlay:sdk-browser-diagnostics.cjs"]))throw new Error("Missing exact native source provenance")
+for(const relative of sources){const sha=crypto.createHash("sha256").update(fs.readFileSync(new URL(relative,import.meta.url))).digest("hex");if(report.inputs[relative]!==sha)throw new Error(`Source changed since browser run: ${relative}`)}
+const diagnosticPath=process.argv[3]
+if(!diagnosticPath||report.inputs["overlay:sdk-browser-diagnostics.cjs"]!==crypto.createHash("sha256").update(fs.readFileSync(diagnosticPath)).digest("hex"))throw new Error("Missing or changed host diagnostic collector")
