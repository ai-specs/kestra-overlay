@@ -0,0 +1,28 @@
+package io.kestra.webserver.rbac;
+
+import java.util.Optional;
+import io.micronaut.http.HttpMethod;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.MutableHttpResponse;
+import org.reactivestreams.Publisher;
+
+/**
+ * Classpath bean for fallback HTTP routes. Register conditionally using the extension's own switch.
+ * Host routes and reserved/static paths always win. Duplicate IDs or overlapping matches fail closed.
+ * Metadata and match must be pure: no database, Flow lookup, schema reads, request body or authorization.
+ * The host calls handle only after authentication, applicable CSRF and EXTENSION_ROUTE/EXECUTE.
+ * Implementations must authorize concrete resources before lookup results, execution or side effects.
+ */
+public interface HttpExtensionRouteProviderV1 {
+    int CONTRACT_VERSION = 1;
+    String id();
+    Optional<Target> match(HttpMethod method, String rawPath);
+    Publisher<MutableHttpResponse<?>> handle(HttpRequest<?> request, Target target);
+    record Target(String namespace, boolean documentReturn) {
+        public Target {
+            if (namespace == null || !namespace.matches("[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*"))
+                throw new IllegalArgumentException("Invalid extension route namespace");
+        }
+        public Target(String namespace) { this(namespace, false); }
+    }
+}
