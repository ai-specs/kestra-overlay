@@ -0,0 +1,64 @@
+package io.kestra.webserver.rbac;
+
+import java.net.URI;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import io.micronaut.http.HttpMethod;
+import jakarta.inject.Singleton;
+
+/** Host implementation detail shared by dispatch and OIDC document-return validation. */
+@Singleton
+public final class HttpExtensionRouteRegistry {
+    private static final Set<String> RESERVED = Set.of("api", "ui", "ui-extensions", "oidc", ".well-known",
+        "ping", "swagger", "swagger-ui", "static", "assets", "oauth", "health", "metrics", "prometheus", "favicon.ico");
+    private final List<Registration> registrations;
+    private final boolean invalid;
+
+    public HttpExtensionRouteRegistry(List<HttpExtensionRouteProviderV1> providers) {
+        var entries=new ArrayList<Registration>();var ids=new HashSet<String>();boolean failure=false;
+        try {
+            for(var provider:providers) {
+                String id=provider.id();
+                if(id==null || !id.matches("[A-Za-z0-9][A-Za-z0-9_-]{0,127}") || !ids.add(id))
+                    throw new IllegalArgumentException("Invalid or duplicate HTTP extension ID");
+                entries.add(new Registration(id,provider));
+            }
+        } catch(RuntimeException exception){failure=true;}
+        registrations=List.copyOf(entries);invalid=failure;
+    }
+    public boolean active(){return invalid || !registrations.isEmpty();}
+    public static boolean validRawPath(String path) {
+        if (path == null || !path.startsWith("/") || path.contains("%") || path.contains("\\")
+            || path.contains("//") || path.contains(";")) return false;
+        for (String segment : path.split("/", -1)) if (segment.equals(".") || segment.equals("..")) return false;
+        return path.chars().noneMatch(value->value<32 || value==127);
+    }
+    public static boolean reserved(String path){return path.equals("/") || RESERVED.contains(path.substring(1).split("/",2)[0]);}
+    public List<Match> match(HttpMethod method,String rawPath) {
+        if(!validRawPath(rawPath))throw new IllegalArgumentException("Unsafe extension route path");
+        if(reserved(rawPath))return List.of();
+        if(invalid)throw new IllegalStateException("Invalid extension route registry");
+        var matches=new ArrayList<Match>();
+        for(var registration:registrations)registration.provider().match(method,rawPath)
+            .ifPresent(target->matches.add(new Match(registration.id(),registration.provider(),target)));
+        return List.copyOf(matches);
+    }
+    public boolean documentRequest(io.micronaut.http.HttpRequest<?> request) {
+        return request.getMethod()==HttpMethod.GET
+            && request.getHeaders().getAll("Accept").stream().anyMatch(value->value.toLowerCase(java.util.Locale.ROOT).contains("text/html"))
+            && documentReturn(request.getUri());
+    }
+    public boolean documentReturn(URI uri) {
+        try {
+            if(uri==null || uri.isAbsolute() || uri.getRawAuthority()!=null || uri.getRawFragment()!=null || uri.toString().length()>2048
+                || !validRawPath(uri.getRawPath()) || uri.toString().chars().anyMatch(codePoint -> codePoint < 32 || codePoint == 127 || codePoint == '\\')
+                || uri.getQuery()!=null && uri.getQuery().chars().anyMatch(codePoint -> codePoint < 32 || codePoint == 127 || codePoint == '\\'))return false;
+            var matches=match(HttpMethod.GET,uri.getRawPath());
+            return matches.size()==1 && matches.getFirst().target().documentReturn();
+        }catch(RuntimeException failure){return false;}
+    }
+    private record Registration(String id,HttpExtensionRouteProviderV1 provider){}
+    public record Match(String id,HttpExtensionRouteProviderV1 provider,HttpExtensionRouteProviderV1.Target target){}
+}
