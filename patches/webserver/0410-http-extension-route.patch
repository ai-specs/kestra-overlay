+@Property(name = "http.extension.probe", value = "true")
+class HttpExtensionRouteHttpTest {
+    @Inject EmbeddedServer server;
+    @Inject Policy policy;
+    @Inject First first;
+    @Inject Second second;
+    private final HttpClient client = HttpClient.newHttpClient();
+
+    private int get(String path, String subject) throws Exception {
+        var builder = java.net.http.HttpRequest.newBuilder(server.getURI().resolve(path));
+        if (subject != null) builder.header("X-Extension-Probe", subject);
+        return client.send(builder.GET().build(), java.net.http.HttpResponse.BodyHandlers.ofString()).statusCode();
+    }
+
+    @Test void realSecurityOrderScopesAndProviderIsolation() throws Exception {
+        first.calls.set(0); second.calls.set(0); policy.begins.set(0); policy.closes.set(0);
+        assertThat(get("/team.a/one", null)).isEqualTo(401);
+        assertThat(first.calls.get()).isZero();
+        assertThat(get("/team.a/one", "one")).isEqualTo(200);
+        assertThat(first.calls.get()).isEqualTo(1);
+        assertThat(get("/team.a/two", "one")).isEqualTo(403);
+        assertThat(second.calls.get()).isZero();
+        assertThat(get("/team.b/one", "one")).isEqualTo(403);
+        assertThat(first.calls.get()).isEqualTo(1);
+        assertThat(get("/team.a/two", "two")).isEqualTo(200);
+        assertThat(second.calls.get()).isEqualTo(1);
+        assertThat(policy.begins.get()).isEqualTo(policy.closes.get());
+        assertThat(policy.sawRequest).isTrue();
+        assertThat(get("/nobody/unknown", "one")).isEqualTo(403);
+        assertThat(get("/ping", "one")).isEqualTo(200);
+        assertThat(first.calls.get()).isEqualTo(1);
+    }
+
