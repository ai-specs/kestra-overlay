+package io.kestra.webserver.rbac;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import io.kestra.core.repositories.AuthorizationInvocationContext;
+import io.kestra.webserver.filter.CsrfTokenFilter;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.context.annotation.Value;
+import io.micronaut.core.async.propagation.ReactorPropagation;
+import io.micronaut.core.propagation.PropagatedContext;
+import io.micronaut.http.*;
+import io.micronaut.http.exceptions.HttpStatusException;
+import io.micronaut.http.annotation.Filter;
+import io.micronaut.http.filter.*;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import io.micronaut.web.router.MethodBasedRouteMatch;
+import io.micronaut.web.router.RouteAttributes;
+import io.micronaut.web.router.resource.StaticResourceResolver;
+import jakarta.inject.Singleton;
+import org.reactivestreams.Publisher;
+import reactor.core.publisher.Flux;
+import reactor.core.publisher.Mono;
+
+/** Host implementation detail; the public extension contract is HttpExtensionRouteProviderV1. */
+@Singleton
+@Filter("/**")
+public final class HttpExtensionRouteFilter implements HttpServerFilter {
+    private static final Set<HttpMethod> SAFE = Set.of(HttpMethod.GET, HttpMethod.HEAD, HttpMethod.OPTIONS, HttpMethod.TRACE);
+    private final HttpExtensionRouteRegistry registry;
+    private final TypedAuthorizationGate gate;
+    private final BeanProvider<CsrfTokenFilter> csrf;
+    private final BeanProvider<StaticResourceResolver> staticResources;
+    private final RbacConfiguration configuration;
+    private final boolean typedEnabled;
+
+    public HttpExtensionRouteFilter(HttpExtensionRouteRegistry registry, TypedAuthorizationGate gate,
+        BeanProvider<CsrfTokenFilter> csrf, BeanProvider<StaticResourceResolver> staticResources,
+        RbacConfiguration configuration, @Value("${kestra.rbac.typed.enabled:false}") boolean typedEnabled) {
+        this.gate = gate;
+        this.csrf = csrf;
+        this.staticResources = staticResources;
+        this.configuration = configuration;
+        this.typedEnabled = typedEnabled;
+        this.registry = registry;
+    }
+
+    @Override public int getOrder() { return ServerFilterPhase.SECURITY.order() + 2; }
+
+    @Override public Publisher<MutableHttpResponse<?>> doFilter(HttpRequest<?> request, ServerFilterChain chain) {
+        if (!registry.active()) return chain.proceed(request);
+        return dispatch(request, chain);
+    }
+
+    private Publisher<MutableHttpResponse<?>> dispatch(HttpRequest<?> request, ServerFilterChain chain) {
+        // Native routes are authoritative even if they later reject or fail. Never retry them as extensions.
+        if (RouteAttributes.getRouteMatch(request).orElse(null) instanceof MethodBasedRouteMatch<?, ?>)
+            return chain.proceed(request);
+        String rawPath = request.getUri().getRawPath();
+        if (!HttpExtensionRouteRegistry.validRawPath(rawPath)) return response(HttpStatus.FORBIDDEN);
+        if (HttpExtensionRouteRegistry.reserved(rawPath)) return chain.proceed(request);
+        if (staticResources.isPresent() && staticResources.isUnique() && staticResources.get().resolve(rawPath).isPresent())
+            return chain.proceed(request);
+        final List<HttpExtensionRouteRegistry.Match> matches;
+        try { matches = registry.match(request.getMethod(), rawPath); }
+        catch (RuntimeException failure) { return response(HttpStatus.SERVICE_UNAVAILABLE); }
+        if (matches.isEmpty()) return chain.proceed(request);
+        if (matches.size() != 1) return response(HttpStatus.SERVICE_UNAVAILABLE);
+        var selected = matches.getFirst();
+        Authentication authentication = request.getAttribute(SecurityFilter.AUTHENTICATION, Authentication.class).orElse(null);
+        if (authentication == null || authentication.getName() == null || authentication.getName().isBlank())
+            return response(HttpStatus.UNAUTHORIZED);
+        if (!SAFE.contains(request.getMethod())) {
+            if (!csrf.isPresent() || !csrf.isUnique()) return response(HttpStatus.SERVICE_UNAVAILABLE);
+            try {
+                var rejected = csrf.get().csrfFilter(request);
+                if (rejected != null) return response(rejected.getStatus());
+            } catch (RuntimeException failure) { return response(HttpStatus.SERVICE_UNAVAILABLE); }
+        }
+        if (!configuration.enabled()) return Flux.defer(() -> selected.provider().handle(request, selected.target()))
+            .<MutableHttpResponse<?>>map(result -> documentResponse(request,selected.target(),result))
+            .onErrorResume(failure -> failureResponse(request, selected.target(), failure));
+        if (!typedEnabled || !gate.evaluationEnabled()) return response(HttpStatus.SERVICE_UNAVAILABLE);
+        var principal = new RbacAuthorizer.Principal(authentication.getName(), List.copyOf(authentication.getRoles()), null, null, List.of());
+        var operation = new TypedAuthorization.Operation(TypedAuthorization.CONTRACT_VERSION,
+            TypedAuthorization.Source.REST, TypedAuthorization.Resource.EXTENSION_ROUTE, TypedAuthorization.Action.EXECUTE,
+            "main", selected.target().namespace(), selected.id(),
+            new TypedAuthorization.QueryDomain(List.of(selected.target().namespace()), List.of(), List.of(), true, false),
+            TypedAuthorization.Coverage.SINGLE, TypedAuthorization.Aggregate.NONE, TypedAuthorization.SideEffect.READ_ONLY);
+        return gate.boundary(principal, "main", () -> gate.authorize(principal, operation)
+            .flatMapMany(decision -> decision.allowed()
+                ? Flux.defer(() -> selected.provider().handle(request, selected.target()))
+                : response(HttpStatus.FORBIDDEN)))
+            .<MutableHttpResponse<?>>map(result -> documentResponse(request,selected.target(),result))
+            .contextWrite(context -> ReactorPropagation.addPropagatedContext(context,
+                PropagatedContext.empty().plus(new AuthorizationInvocationContext(request, false))))
+            .onErrorResume(failure -> failureResponse(request, selected.target(), failure));
+    }
+
+    private MutableHttpResponse<?> documentResponse(HttpRequest<?> request, HttpExtensionRouteProviderV1.Target target, MutableHttpResponse<?> result) {
+        if (target.documentReturn() && request.getMethod() == HttpMethod.GET
+            && request.getHeaders().getAll(HttpHeaders.ACCEPT).stream().anyMatch(value -> value.toLowerCase(java.util.Locale.ROOT).contains("text/html"))
+            && (result.code()==401 || result.code()==403))
+            return HttpResponse.seeOther(java.net.URI.create(result.code()==401?"/oidc/logout":"/ui/access-denied"))
+                .header(HttpHeaders.CACHE_CONTROL,"no-store");
+        return result.header(HttpHeaders.CACHE_CONTROL,"no-store");
+    }
+    private Mono<MutableHttpResponse<?>> failureResponse(HttpRequest<?> request, HttpExtensionRouteProviderV1.Target target, Throwable failure) {
+        HttpStatus status = failure instanceof HttpStatusException exception && exception.getStatus().getCode() >= 400
+            && exception.getStatus().getCode() < 600 ? exception.getStatus() : HttpStatus.SERVICE_UNAVAILABLE;
+        return Mono.just(documentResponse(request, target, HttpResponse.status(status)));
+    }
+    private static Mono<MutableHttpResponse<?>> response(HttpStatus status) {
+        return Mono.just(HttpResponse.status(status).header(HttpHeaders.CACHE_CONTROL, "no-store"));
+    }
+}
