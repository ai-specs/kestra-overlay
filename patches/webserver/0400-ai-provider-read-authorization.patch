+@Property(name = "kestra.ai.agent.model-call-timeout", value = "PT20S")
+class AiProvidersHttpTest {
+    @Inject EmbeddedServer server;
+    @Inject ProbePolicy policy;
+    @Inject AiServiceManager manager;
+    @MockBean(AiServiceManager.class)
+    AiServiceManager manager() {
+        var service = mock(AiServiceInterface.class);
+        when(service.displayName()).thenReturn("Test provider");
+        var manager = mock(AiServiceManager.class);
+        when(manager.getAllAiServices()).thenReturn(Map.of("test-provider", service));
+        when(manager.getDefaultProviderId()).thenReturn("test-provider");
+        when(manager.hasConfiguredProvider()).thenReturn(true);
+        return manager;
+    }
+    @BeforeEach void reset() { policy.allowed.set(true); clearInvocations(manager); }
+    @Test void aiReadAloneAllowsOnlyThePublicProviderFields() throws Exception {
+        var response = send("GET", "/api/v1/main/ai/providers");
+        assertThat(response.statusCode()).isEqualTo(200);
+        var json = JacksonMapper.ofJson().readTree(response.body());
+        assertThat(json.size()).isEqualTo(1);
+        assertThat(json.get(0).properties().stream().map(Map.Entry::getKey).toList())
+            .containsExactlyInAnyOrder("id", "displayName", "isDefault");
+        assertThat(json.get(0).path("id").asText()).isEqualTo("test-provider");
+        assertThat(json.get(0).path("displayName").asText()).isEqualTo("Test provider");
+        assertThat(json.get(0).path("isDefault").asBoolean()).isTrue();
+        verify(manager).getAllAiServices();
+    }
+    @Test void zeroAiPermissionDeniesBeforeReadingProviderConfiguration() throws Exception {
+        policy.allowed.set(false);
+        assertThat(send("GET", "/api/v1/main/ai/providers").statusCode()).isEqualTo(403);
+        verify(manager, never()).getAllAiServices();
+    }
+    @Test void unknownMethodsAndLegacyGenerationDoNotGainPermission() throws Exception {
+        for (String method : List.of("POST", "PUT", "DELETE", "HEAD"))
+            assertThat(send(method, "/api/v1/main/ai/providers").statusCode()).isBetween(400, 499);
+        assertThat(send("POST", "/api/v1/main/ai/generate/flow").statusCode()).isEqualTo(403);
+        verify(manager, never()).getAllAiServices();
+        verify(manager, never()).getAiService(any());
+    }
+    private HttpResponse<String> send(String method, String path) throws Exception {
+        return HttpClient.newHttpClient().send(HttpRequest.newBuilder(server.getURI().resolve(path))
+            .header("X-AI-Providers-Test", "alice").header("Content-Type", "application/json")
+            .method(method, method.equals("POST") ? HttpRequest.BodyPublishers.ofString("{}") : HttpRequest.BodyPublishers.noBody())
+            .build(), HttpResponse.BodyHandlers.ofString());
+    }
+    @Singleton @Requires(property="ai.providers.http.probe", value="true")
+    static class Identity implements AuthenticationFetcher<io.micronaut.http.HttpRequest<?>> {
+        public org.reactivestreams.Publisher<Authentication> fetchAuthentication(io.micronaut.http.HttpRequest<?> request) {
+            return "alice".equals(request.getHeaders().get("X-AI-Providers-Test"))
+                ? Mono.just(Authentication.build("alice", List.of())) : Mono.empty();
+        }
+    }
+    @Singleton @Requires(property="ai.providers.http.probe", value="true")
+    static class ProbePolicy implements AuthorizationEvaluationProviderV1 {
+        final AtomicBoolean allowed = new AtomicBoolean(true);
+        public CompletionStage<AuthorizationEvaluationV1> begin(RbacAuthorizer.Principal principal, String tenant) {
+            return CompletableFuture.completedFuture(new AuthorizationEvaluationV1() {
+                public CompletionStage<Decision> authorize(Operation operation) {
+                    return CompletableFuture.completedFuture(allowed.get() && "alice".equals(principal.subject())
+                        && "main".equals(tenant) && operation.resource()==Resource.AI && operation.action()==Action.READ
+                        ? Decision.allow(operation.queryDomain()) : Decision.deny("Test policy denied"));
+                }
+                public CompletionStage<Void> close() { return CompletableFuture.completedFuture(null); }
+            });
+        }
+    }
+}
