+package io.kestra.webserver.oidc;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verifyNoInteractions;
+import static org.mockito.Mockito.when;
+
+import java.net.URI;
+import java.util.Optional;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.kestra.webserver.oidc.controllers.OidcDiscoveryController;
+import io.kestra.webserver.oidc.services.OidcLocalMetadataFetcherFactory;
+
+import io.micronaut.http.client.HttpClient;
+import io.micronaut.security.oauth2.client.DefaultOpenIdProviderMetadataFetcher;
+import io.micronaut.security.oauth2.configuration.OpenIdClientConfiguration;
+
+import org.junit.jupiter.api.Test;
+
+class OidcLocalMetadataFetcherFactoryTest {
+    private final OidcConfiguration configuration = new OidcConfiguration();
+    private final OidcLocalMetadataFetcherFactory factory = new OidcLocalMetadataFetcherFactory(
+        configuration, new OidcDiscoveryController(configuration), new ObjectMapper());
+
+    @Test
+    void localIssuerUsesProductionDiscoveryWithoutHttpBeforeServerStarts() throws Exception {
+        final var client = mock(OpenIdClientConfiguration.class);
+        when(client.getName()).thenReturn("kestra");
+        when(client.getIssuer()).thenReturn(Optional.of(URI.create(configuration.getIssuer()).toURL()));
+        final var http = mock(HttpClient.class);
+        final var metadata = factory.create(client, http).fetch();
+        assertEquals("kestra", metadata.getName());
+        assertEquals(configuration.getIssuer(), metadata.getIssuer());
+        assertEquals(configuration.getIssuer() + "/oidc/authorize", metadata.getAuthorizationEndpoint());
+        assertEquals(configuration.getIssuer() + "/oidc/token", metadata.getTokenEndpoint());
+        assertEquals(configuration.getIssuer() + "/oidc/jwks", metadata.getJwksUri());
+        verifyNoInteractions(http);
+    }
+
+    @Test
+    void externalIssuerRetainsFrameworkDiscovery() throws Exception {
+        final var client = mock(OpenIdClientConfiguration.class);
+        when(client.getIssuer()).thenReturn(Optional.of(URI.create("https://external.example.org").toURL()));
+        assertInstanceOf(DefaultOpenIdProviderMetadataFetcher.class, factory.create(client, mock(HttpClient.class)));
+    }
+
+    @Test
+    void absentIssuerRetainsFrameworkExplicitEndpointConfiguration() {
+        final var client = mock(OpenIdClientConfiguration.class);
+        when(client.getIssuer()).thenReturn(Optional.empty());
+        assertInstanceOf(DefaultOpenIdProviderMetadataFetcher.class, factory.create(client, mock(HttpClient.class)));
+    }
+}
