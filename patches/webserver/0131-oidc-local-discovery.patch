+package io.kestra.webserver.oidc.services;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.kestra.webserver.oidc.controllers.OidcDiscoveryController;
+
+import io.micronaut.context.annotation.EachBean;
+import io.micronaut.context.annotation.Factory;
+import io.micronaut.context.annotation.Parameter;
+import io.micronaut.context.annotation.Replaces;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.client.HttpClient;
+import io.micronaut.http.client.annotation.Client;
+import io.micronaut.security.oauth2.client.DefaultOpenIdProviderMetadata;
+import io.micronaut.security.oauth2.client.DefaultOpenIdProviderMetadataFetcher;
+import io.micronaut.security.oauth2.client.OpenIdProviderMetadataFetcher;
+import io.micronaut.security.oauth2.client.OpenIdProviderMetadataFetcherFactory;
+import io.micronaut.security.oauth2.configuration.OpenIdClientConfiguration;
+import jakarta.inject.Singleton;
+
+@Factory
+@Requires(property = "kestra.oidc.enabled", value = "true", defaultValue = "false")
+public class OidcLocalMetadataFetcherFactory {
+    private final OidcConfiguration configuration;
+    private final OidcDiscoveryController discovery;
+    private final ObjectMapper mapper;
+
+    public OidcLocalMetadataFetcherFactory(
+        final OidcConfiguration configuration,
+        final OidcDiscoveryController discovery,
+        final ObjectMapper mapper
+    ) {
+        this.configuration = configuration;
+        this.discovery = discovery;
+        this.mapper = mapper;
+    }
+
+    @EachBean(OpenIdClientConfiguration.class)
+    @Singleton
+    @Replaces(value = OpenIdProviderMetadataFetcher.class, factory = OpenIdProviderMetadataFetcherFactory.class)
+    public OpenIdProviderMetadataFetcher create(
+        @Parameter final OpenIdClientConfiguration clientConfiguration,
+        @Client final HttpClient httpClient
+    ) {
+        if (clientConfiguration.getIssuer().map(Object::toString).filter(configuration.getIssuer()::equals).isEmpty()) {
+            return new DefaultOpenIdProviderMetadataFetcher(clientConfiguration, httpClient);
+        }
+        return new OpenIdProviderMetadataFetcher() {
+            @Override
+            public String getName() {
+                return clientConfiguration.getName();
+            }
+
+            @Override
+            public DefaultOpenIdProviderMetadata fetch() {
+                final var metadata = mapper.convertValue(discovery.openIdConfiguration().body(), DefaultOpenIdProviderMetadata.class);
+                metadata.setName(getName());
+                metadata.setUserinfoEndpoint(null);
+                return metadata;
+            }
+        };
+    }
+}
diff --git a/webserver/src/test/java/io/kestra/webserver/oidc/OidcInvalidCookieRecoveryHttpTest.java b/webserver/src/test/java/io/kestra/webserver/oidc/OidcInvalidCookieRecoveryHttpTest.java
