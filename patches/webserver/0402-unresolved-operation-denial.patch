+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import io.micronaut.context.BeanProvider;
+import org.junit.jupiter.api.Test;
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.*;
+
+class UnresolvedOperationTest {
+    @Test void deniesSystemEvenWhenProviderAllowsEverything() {
+        BeanProvider<TypedAuthorizationResolver> policies=mock(BeanProvider.class);
+        when(policies.isUnique()).thenReturn(true);
+        when(policies.get()).thenReturn((subject,operation)->CompletableFuture.completedFuture(Decision.allow(QueryDomain.unrestricted())));
+        var gate=new TypedAuthorizationGate(policies);
+        var principal=new RbacAuthorizer.Principal("subject",List.of(),null,null,List.of());
+        assertThat(gate.authorize(principal,new Operation(CONTRACT_VERSION,Source.REST,Resource.SYSTEM,Action.EXECUTE,"main",null,null,
+            QueryDomain.unrestricted(),Coverage.COMPLETE_BATCH,Aggregate.NONE,SideEffect.EXTERNAL)).block().allowed()).isFalse();
+    }
+}
