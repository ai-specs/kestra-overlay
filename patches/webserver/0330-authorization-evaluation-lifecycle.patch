+@Property(name="kestra.rbac.typed.enabled",value="true")
+@Property(name="kestra.rbac.evaluation.enabled",value="true")
+@Property(name="micronaut.security.enabled",value="true")
+@Property(name="micronaut.security.filter.enabled",value="true")
+@Property(name="micronaut.security.intercept-url-map[0].pattern",value="/**")
+@Property(name="micronaut.security.intercept-url-map[0].access[0]",value="isAnonymous()")
+@Property(name="mcp.http.security.fixture",value="true")
+@Property(name="authorization.unavailable.probe",value="true")
+class AuthorizationUnavailableHttpTest {
+    @Inject EmbeddedServer server;
+    @Inject FlowRepositoryInterface flows;
+
+    @Test void explicitDependencyFailuresAre503AcrossSynchronousAndAsynchronousStages()throws Exception {
+        for(String mode:List.of("identity-sql","begin-sync","begin-async","authorize-sync","authorize-async","wrapped-async")) {
+            var response=send(mode,"/api/v1/main/flows","POST");
+            assertEquals(503,response.statusCode(),mode);
+            assertTrue(response.headers().firstValue("content-type").orElse("").startsWith("application/problem+json"));
+            var problem=io.kestra.core.serializers.JacksonMapper.ofJson().readTree(response.body());
+            assertEquals(503,problem.path("status").intValue());
+            assertFalse(response.body().contains("secret-probe"));assertFalse(response.body().contains("AuthorizationUnavailableException"));
+            assertTrue(flows.findByIdWithoutAcl("main","dependency.probe","never-created",Optional.empty()).isEmpty());
+        }
+    }
+
+    @Test void unknownErrorsDecisionsAndUnknownRoutesRetain403()throws Exception {
+        for(String mode:List.of("unknown-begin","unknown-authorize","deny","unknown-wrapper")) {
+            assertEquals(403,send(mode,"/api/v1/main/flows","POST").statusCode(),mode);
+            assertTrue(flows.findByIdWithoutAcl("main","dependency.probe","never-created",Optional.empty()).isEmpty());
+        }
+        assertEquals(403,send("allow","/not-a-route","GET").statusCode());
+        assertEquals(401,send("anonymous","/api/v1/configs","GET").statusCode());
+    }
+
+    HttpResponse<String> send(String mode,String path,String method)throws Exception {
+        var builder=HttpRequest.newBuilder(server.getURI().resolve(path)).header("X-Unavailable-Probe",mode);
+        if(method.equals("POST"))builder.header("Content-Type","application/x-yaml").POST(HttpRequest.BodyPublishers.ofString("namespace: dependency.probe\nid: never-created\ntasks: []"));
+        else builder.GET();
+        return HttpClient.newHttpClient().send(builder.build(),HttpResponse.BodyHandlers.ofString());
+    }
+
+    @Singleton
+    @Requires(property="authorization.unavailable.probe",value="true")
+    static class Identity implements AuthenticationFetcher<io.micronaut.http.HttpRequest<?>> {
+        public org.reactivestreams.Publisher<Authentication> fetchAuthentication(io.micronaut.http.HttpRequest<?> request) {
+            String mode=request.getHeaders().get("X-Unavailable-Probe");
+            return mode==null||mode.equals("anonymous")?Mono.empty():Mono.just(Authentication.build(mode,List.of()));
+        }
+    }
+
+    @Singleton
+    @Requires(property="authorization.unavailable.probe",value="true")
+    static class Policy implements AuthorizationEvaluationProviderV1 {
+        public CompletionStage<AuthorizationEvaluationV1> begin(RbacAuthorizer.Principal principal,String tenant) {
+            String mode=principal.subject();
+            if(mode.equals("identity-sql"))return identitySqlFailure();
+            if(mode.equals("begin-sync"))throw new AuthorizationUnavailableException();
+            if(mode.equals("begin-async"))return CompletableFuture.failedFuture(new AuthorizationUnavailableException());
+            if(mode.equals("unknown-begin"))throw new IllegalStateException("secret-probe");
+            return CompletableFuture.completedFuture(new AuthorizationEvaluationV1() {
+                public CompletionStage<Decision> authorize(Operation operation) {
+                    if(mode.equals("authorize-sync"))throw new AuthorizationUnavailableException();
+                    if(mode.equals("authorize-async"))return CompletableFuture.failedFuture(new AuthorizationUnavailableException());
+                    if(mode.equals("wrapped-async"))return CompletableFuture.failedFuture(new java.util.concurrent.CompletionException(new AuthorizationUnavailableException()));
+                    if(mode.equals("unknown-authorize"))throw new IllegalStateException("secret-probe");
+                    if(mode.equals("unknown-wrapper"))return CompletableFuture.failedFuture(new IllegalStateException("secret-probe",new AuthorizationUnavailableException()));
+                    return CompletableFuture.completedFuture(mode.equals("allow")?Decision.allow(QueryDomain.unrestricted()):Decision.deny("denied"));
+                }
+                public CompletionStage<Void> close(){return CompletableFuture.completedFuture(null);}
+            });
+        }
+
+        CompletionStage<AuthorizationEvaluationV1> identitySqlFailure() {
+            var source=org.mockito.Mockito.mock(javax.sql.DataSource.class);
+            try {org.mockito.Mockito.when(source.getConnection()).thenThrow(new java.sql.SQLException("secret-probe SQL"));}
+            catch(java.sql.SQLException failure){throw new AssertionError(failure);}
+            var projections=org.mockito.Mockito.mock(io.micronaut.context.BeanProvider.class);
+            org.mockito.Mockito.when(projections.isUnique()).thenReturn(true);
+            var configuration=new io.kestra.webserver.oidc.OidcConfiguration();configuration.setIssuer("https://issuer.example");
+            var identity=new io.kestra.webserver.oidc.services.OidcTrustedIdentity(projections,
+                org.mockito.Mockito.mock(io.kestra.webserver.oidc.OidcProtocolStateV1.class),configuration,source);
+            identity.currentForAuthorization();throw new AssertionError("Unavailable identity must not open an evaluation");
+        }
+    }
+}
