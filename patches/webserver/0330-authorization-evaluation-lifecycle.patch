+
+    @Test
+    void shouldFailClosedForMissingProvidersAndInvalidConfiguration() {
+        assertThatThrownBy(() -> evaluations(null).boundary(PRINCIPAL, "main", () -> Mono.just(true)).blockLast())
+            .isInstanceOf(IllegalStateException.class);
+        assertThatThrownBy(() -> new AuthorizationEvaluations(true, new RbacConfiguration(false, false), true, bean(null)))
