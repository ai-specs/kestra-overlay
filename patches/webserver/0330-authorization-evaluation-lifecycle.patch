+package io.kestra.webserver.rbac;
+
+import java.time.Duration;
+import java.util.List;
+import java.util.Objects;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CompletionStage;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.function.Supplier;
+import io.kestra.core.repositories.AuthorizationEvaluationContext;
+import io.kestra.core.repositories.AuthorizationInvocationContext;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.context.annotation.Value;
+import io.micronaut.core.async.propagation.ReactorPropagation;
+import io.micronaut.core.async.propagation.ReactivePropagation;
+import io.micronaut.core.propagation.PropagatedContext;
+import jakarta.inject.Singleton;
+import org.reactivestreams.Publisher;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import reactor.core.publisher.Flux;
+import reactor.core.publisher.Mono;
+import reactor.util.context.ContextView;
+
+@Singleton
+public final class AuthorizationEvaluations {
+    private static final Logger LOGGER = LoggerFactory.getLogger(AuthorizationEvaluations.class);
+    private static final Duration TIMEOUT = Duration.ofSeconds(5);
+    private final boolean enabled;
+    private final BeanProvider<AuthorizationEvaluationProviderV1> providers;
+
+    public AuthorizationEvaluations(@Value("${kestra.rbac.evaluation.enabled:false}") boolean enabled,
+        RbacConfiguration configuration, @Value("${kestra.rbac.typed.enabled:false}") boolean typedEnabled,
+        BeanProvider<AuthorizationEvaluationProviderV1> providers) {
+        if (enabled && (!configuration.enabled() || !typedEnabled)) {
+            throw new IllegalArgumentException("Evaluation mode requires unified and typed authorization.");
+        }
+        this.enabled = enabled;
+        this.providers = providers;
+    }
+
+    public boolean enabled() { return enabled; }
+
+    public <Result> Flux<Result> boundary(RbacAuthorizer.Principal principal, String tenant,
+        Supplier<? extends Publisher<Result>> action) {
+        if (!enabled) return Flux.defer(action);
+        return Flux.defer(() -> {
+            if (!providers.isUnique() || principal == null || principal.subject() == null || principal.subject().isBlank()
+                || tenant == null || tenant.isBlank()) return Flux.error(denied());
+            var identity = new RbacAuthorizer.Principal(principal.subject(), List.copyOf(principal.roles()),
+                principal.clientId(), principal.audience(), List.copyOf(principal.scopes()));
+            var owner = new Owner(identity, tenant);
+            return Flux.usingWhen(Mono.just(owner), active -> active.acquire(providers.get()).flatMapMany(ignored -> {
+                var context = minimalContext().plus(new AuthorizationEvaluationContext(active));
+                return Flux.from(ReactivePropagation.propagate(context, Flux.defer(() -> {
+                    try (var scope = context.propagate()) { return Flux.from(action.get()); }
+                }))).contextWrite(current -> ReactorPropagation.addPropagatedContext(current, context));
+            }), Owner::finish, (active, failure) -> active.finish().onErrorResume(cleanup -> Mono.empty()),
+                active -> active.finish().onErrorResume(cleanup -> Mono.empty()));
+        });
+    }
+
+    private static PropagatedContext minimalContext() {
+        var context = PropagatedContext.empty();
+        var origin = AuthorizationInvocationContext.current().orElse(null);
+        return origin == null ? context : context.plus(origin);
+    }
+
+    static Owner current(ContextView context) {
+        var reference = ReactorPropagation.findContextElement(context, AuthorizationEvaluationContext.class)
+            .or(AuthorizationEvaluationContext::current).orElse(null);
+        return reference != null && reference.reference() instanceof Owner owner ? owner : null;
+    }
+
+    static Owner current() {
+        var reference = AuthorizationEvaluationContext.current().orElse(null);
+        return reference != null && reference.reference() instanceof Owner owner ? owner : null;
+    }
+
+    static IllegalStateException denied() { return new IllegalStateException("Authorization evaluation is unavailable."); }
+
+    static final class Owner {
+        final RbacAuthorizer.Principal principal;
+        final String tenant;
+        final ConcurrentHashMap<String, TypedAuthorization.QueryDomain> domains = new ConcurrentHashMap<>();
+        private final CompletableFuture<AuthorizationEvaluationV1> ready = new CompletableFuture<>();
+        private final CompletableFuture<Void> released = new CompletableFuture<>();
+        private AuthorizationEvaluationV1 evaluation;
+        private boolean ended;
+        private boolean closing;
+        private int pending;
+
+        Owner(RbacAuthorizer.Principal principal, String tenant) {
+            this.principal = principal;
+            this.tenant = tenant;
+        }
+
+        Mono<AuthorizationEvaluationV1> acquire(AuthorizationEvaluationProviderV1 provider) {
+            try { Objects.requireNonNull(provider.begin(principal, tenant)).whenComplete(this::arrived); }
+            catch (Throwable failure) { ready.completeExceptionally(failure); }
+            return Mono.fromFuture(ready, true).timeout(TIMEOUT);
+        }
+
+        private synchronized void arrived(AuthorizationEvaluationV1 handle, Throwable failure) {
+            if (failure != null || handle == null) {
+                ready.completeExceptionally(failure == null ? denied() : failure);
+                released.complete(null);
+                return;
+            }
+            evaluation = handle;
+            if (ended) closeOnce();
+            else ready.complete(handle);
+        }
+
+        synchronized boolean matches(RbacAuthorizer.Principal caller, String callerTenant) {
+            return !ended && evaluation != null && principal.equals(caller) && tenant.equals(callerTenant);
+        }
+
+        synchronized CompletionStage<TypedAuthorization.Decision> authorize(RbacAuthorizer.Principal caller,
+            TypedAuthorization.Operation operation) {
+            if (!matches(caller, operation.tenant())) return CompletableFuture.failedFuture(denied());
+            var result = new CompletableFuture<TypedAuthorization.Decision>();
+            pending++;
+            try {
+                Objects.requireNonNull(evaluation.authorize(operation)).whenComplete((decision, failure) -> {
+                    synchronized (this) {
+                        pending--;
+                        if (ended && pending == 0) closeOnce();
+                    }
+                    if (failure == null) result.complete(decision);
+                    else result.completeExceptionally(failure);
+                });
+            } catch (Throwable failure) {
+                pending--;
+                result.completeExceptionally(failure);
+            }
+            return result;
+        }
+
+        synchronized Mono<Void> finish() {
+            ended = true;
+            domains.clear();
+            if (evaluation == null) return Mono.empty();
+            if (pending == 0) closeOnce();
+            return Mono.fromFuture(released, true).timeout(TIMEOUT)
+                .doOnError(failure -> LOGGER.error("Authorization evaluation cleanup failed or timed out.", failure));
+        }
+
+        private void closeOnce() {
+            if (closing) return;
+            closing = true;
+            try {
+                Objects.requireNonNull(evaluation.close()).whenComplete((ignored, failure) -> {
+                    if (failure == null) released.complete(null);
+                    else failedClose(failure);
+                });
+            } catch (Throwable failure) { failedClose(failure); }
+        }
+
+        private void failedClose(Throwable failure) {
+            LOGGER.error("Authorization evaluation cleanup failed.", failure);
+            released.completeExceptionally(failure);
+        }
+    }
+}
