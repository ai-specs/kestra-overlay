+package io.kestra.webserver.rbac;
+
+import java.util.concurrent.CompletionStage;
+
+/** An opaque, boundary-owned snapshot; concurrent decisions must be safe, and close releases resources without rolling back business effects. */
+public interface AuthorizationEvaluationV1 {
+    CompletionStage<TypedAuthorization.Decision> authorize(TypedAuthorization.Operation operation);
+    CompletionStage<Void> close();
+}
