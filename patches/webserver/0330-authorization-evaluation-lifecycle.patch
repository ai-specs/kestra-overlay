+import static org.awaitility.Awaitility.await;
+
+class AuthorizationEvaluationTest {
+    static final RbacAuthorizer.Principal PRINCIPAL = new RbacAuthorizer.Principal("alice", List.of("reader"), null, null, List.of());
+
+    static <Bean> BeanProvider<Bean> bean(Bean value) {
+        return new BeanProvider<>() {
+            public Bean get() { return value; }
+            public boolean isPresent() { return value != null; }
+            public boolean isUnique() { return value != null; }
+        };
+    }
+
+    static Operation operation(Resource resource, String namespace) {
+        return new Operation(CONTRACT_VERSION, Source.REST, resource, Action.LIST, "main", namespace, null,
+            QueryDomain.unrestricted(), namespace == null ? Coverage.COMPLETE_QUERY : Coverage.SINGLE,
+            Aggregate.NONE, SideEffect.READ_ONLY);
+    }
+
+    static final class Policy implements AuthorizationEvaluationProviderV1 {
+        final AtomicReference<Set<String>> grants = new AtomicReference<>(Set.of("team.a"));
+        final AtomicInteger begins = new AtomicInteger();
+        final AtomicInteger closes = new AtomicInteger();
+        final AtomicInteger calls = new AtomicInteger();
+        Runnable afterDecision = () -> {};
+
+        public CompletionStage<AuthorizationEvaluationV1> begin(RbacAuthorizer.Principal principal, String tenant) {
+            begins.incrementAndGet();
+            Set<String> snapshot = grants.get();
+            return CompletableFuture.completedFuture(new AuthorizationEvaluationV1() {
+                public CompletionStage<Decision> authorize(Operation operation) {
+                    calls.incrementAndGet();
+                    afterDecision.run();
+                    var domain = new QueryDomain(List.copyOf(snapshot), List.of(), List.of(), true, false);
+                    return CompletableFuture.completedFuture(operation.namespace() == null || snapshot.contains(operation.namespace())
+                        ? Decision.allow(domain) : Decision.deny("snapshot denied"));
+                }
+                public CompletionStage<Void> close() {
+                    closes.incrementAndGet();
+                    return CompletableFuture.completedFuture(null);
+                }
+            });
+        }
+    }
+
+    static AuthorizationEvaluations evaluations(AuthorizationEvaluationProviderV1 provider) {
+        return new AuthorizationEvaluations(true, new RbacConfiguration(true, false), true, bean(provider));
+    }
+
+    static TypedAuthorizationGate gate(AuthorizationEvaluationProviderV1 provider) {
+        return new TypedAuthorizationGate(bean(null), evaluations(provider));
+    }
+
+    @Test
+    void shouldDenyMixedVersionsAndReadNewSnapshotAtNextBoundary() {
+        var provider = new Policy();
+        var gate = gate(provider);
+        provider.afterDecision = () -> provider.grants.set(Set.of("team.b"));
+        boolean allowed = gate.boundary(PRINCIPAL, "main", () -> gate.authorize(PRINCIPAL, operation(Resource.FLOW, "team.a"))
+            .flatMap(first -> gate.authorize(PRINCIPAL, operation(Resource.EXECUTION, "team.b")))
+            .map(Decision::allowed)).single().block();
+        assertThat(allowed).isFalse();
+        assertThat(gate.boundary(PRINCIPAL, "main", () -> gate.authorize(PRINCIPAL, operation(Resource.FLOW, "team.b")))
+            .single().block().allowed()).isTrue();
+        assertThat(provider.begins.get()).isEqualTo(2);
+        assertThat(provider.closes.get()).isEqualTo(2);
+    }
+
+    @Test
+    void shouldIsolateNestedQueryCachesAndRestoreOuterReferenceAcrossThreads() {
+        var provider = new Policy();
