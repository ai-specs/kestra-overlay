+    @Test
+    void cancelAndBlockingCloseMustNotBlockEventLoop() throws Exception {
+        var loop = new DefaultEventLoop();
+        var entered = new CountDownLatch(1); var unlock = new CountDownLatch(1); var acquired = new CountDownLatch(1);
+        var heartbeat = new CountDownLatch(1); var returned = new CountDownLatch(1); var closed = new AtomicInteger();
+        var thread = new AtomicReference<Thread>(); var context = new AtomicReference<PropagatedContext>();
+        var handle = blockingClose(entered, unlock, closed, thread, context);
+        var subscription = evaluations((principal, tenant) -> CompletableFuture.completedFuture(handle))
+            .boundary(PRINCIPAL, "main", () -> { acquired.countDown(); return Mono.never(); }).subscribe();
+        boolean heartBeats; boolean cancellationReturns;
+        try {
+            assertThat(acquired.await(3, TimeUnit.SECONDS)).isTrue();
+            loop.execute(() -> {
+                try (var scope = callerContext().propagate()) { subscription.dispose(); returned.countDown(); }
+            });
