+    @Test
+    void shouldCloseExactlyOnceDuringConcurrentCancelAndLateBegin() throws Exception {
+        for (int iteration = 0; iteration < 100; iteration++) {
+            var pending = new CompletableFuture<AuthorizationEvaluationV1>();
+            var closed = new AtomicInteger();
+            var start = new CompletableFuture<Void>();
+            var subscription = evaluations((principal, tenant) -> pending).boundary(PRINCIPAL, "main", Mono::never).subscribe();
+            var cancellation = CompletableFuture.runAsync(() -> { start.join(); subscription.dispose(); });
+            var acquisition = CompletableFuture.runAsync(() -> { start.join(); pending.complete(handle(closed, CompletableFuture.completedFuture(null))); });
+            start.complete(null);
+            CompletableFuture.allOf(cancellation, acquisition).get(2, TimeUnit.SECONDS);
+            assertThat(closed.get()).isEqualTo(1);
+        }
+    }
