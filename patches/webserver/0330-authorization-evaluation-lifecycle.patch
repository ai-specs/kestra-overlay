+package io.kestra.core.repositories;
+
+import java.util.Optional;
+import java.util.concurrent.Callable;
+import io.micronaut.core.async.propagation.ReactorPropagation;
+import io.micronaut.core.propagation.PropagatedContext;
+import io.micronaut.core.propagation.PropagatedContextElement;
+
+public record AuthorizationEvaluationContext(Object reference) implements PropagatedContextElement {
+    public static Optional<AuthorizationEvaluationContext> current() {
+        return PropagatedContext.getOrEmpty().find(AuthorizationEvaluationContext.class);
+    }
+
+    public static PropagatedContext capture(reactor.util.context.ContextView context) {
+        var captured = PropagatedContext.empty();
+        var origin = ReactorPropagation.findContextElement(context, AuthorizationInvocationContext.class)
+            .or(AuthorizationInvocationContext::current).orElse(null);
+        if (origin != null) captured = captured.plus(origin);
+        var evaluation = ReactorPropagation.findContextElement(context, AuthorizationEvaluationContext.class)
+            .or(AuthorizationEvaluationContext::current).orElse(null);
+        if (evaluation != null) captured = captured.plus(evaluation);
+        var query = ReactorPropagation.findContextElement(context, AuthorizationQueryContext.class)
+            .or(() -> PropagatedContext.getOrEmpty().find(AuthorizationQueryContext.class)).orElse(null);
+        return query == null ? captured : captured.plus(query);
+    }
+
+    public static <Result> reactor.core.publisher.Mono<Result> call(Callable<Result> action) {
+        return reactor.core.publisher.Mono.deferContextual(context -> {
+            var captured = capture(context);
+            return reactor.core.publisher.Mono.fromCallable(() -> {
+                try (var scope = captured.propagate()) { return action.call(); }
+            });
+        });
+    }
+}
