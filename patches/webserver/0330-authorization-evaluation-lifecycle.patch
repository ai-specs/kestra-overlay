+class AuthorizationUnavailableBoundaryTest {
+    @Test void applicationGroupBoundaryUsesNewDefaultCompatibleEntryAndPreservesExplicitUnavailable() {
+        var identities=mock(BeanProvider.class);var legacy=mock(BeanProvider.class);var modern=mock(BeanProvider.class);
+        var identity=mock(TrustedIdentityV2.class);
+        when(identities.isUnique()).thenReturn(true);when(identities.get()).thenReturn(identity);when(modern.isUnique()).thenReturn(true);
+        when(identity.currentForAuthorization()).thenThrow(new AuthorizationUnavailableException());
+        var evaluations=new AuthorizationEvaluations(true,new RbacConfiguration(true,false),true,legacy,modern,identities,true);
+        var principal=new RbacAuthorizer.Principal("actor",List.of(),null,null,List.of());
+        assertThrows(AuthorizationUnavailableException.class,()->evaluations.boundary(principal,"main",()->Mono.just(true)).blockLast());
+        verify(identity).currentForAuthorization();verify(identity,never()).current();
+    }
+
+    @Test void missingOrDuplicateProvidersAndLegacyUnknownFailuresKeepExistingDenial() {
+        var identities=mock(BeanProvider.class);var legacy=mock(BeanProvider.class);var modern=mock(BeanProvider.class);
+        var identity=mock(TrustedIdentityV1.class);when(identities.isUnique()).thenReturn(true);when(identities.get()).thenReturn(identity);
+        var evaluations=new AuthorizationEvaluations(true,new RbacConfiguration(true,false),true,legacy,modern,identities,true);
+        var principal=new RbacAuthorizer.Principal("actor",List.of(),null,null,List.of());
+        assertThrows(IllegalStateException.class,()->evaluations.boundary(principal,"main",()->Mono.just(true)).blockLast());
+        verifyNoInteractions(identity);
+        when(modern.isUnique()).thenReturn(true);when(identity.current()).thenThrow(new IllegalStateException("unknown"));
+        assertEquals(IllegalStateException.class,assertThrows(IllegalStateException.class,()->evaluations.boundary(principal,"main",()->Mono.just(true)).blockLast()).getClass());
+    }
+}
