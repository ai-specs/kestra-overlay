+    @Test
+    void shouldObserveCloseTimeoutWithoutCancellingOrRetryingOriginalCleanup() {
+        var closed = new AtomicInteger();
+        var cleanup = new CompletableFuture<Void>();
+        var service = evaluations((principal, tenant) -> CompletableFuture.completedFuture(handle(closed, cleanup)));
+        assertThatThrownBy(() -> service.boundary(PRINCIPAL, "main", () -> Mono.just(true)).blockLast())
+            .hasRootCauseInstanceOf(java.util.concurrent.TimeoutException.class);
+        assertThat(cleanup.isCancelled()).isFalse();
+        cleanup.complete(null);
+        assertThat(closed.get()).isEqualTo(1);
+    }
