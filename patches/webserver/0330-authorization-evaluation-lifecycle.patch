+            heartBeats = heartbeat.await(100, TimeUnit.MILLISECONDS);
+            cancellationReturns = returned.getCount() == 0;
+            System.out.printf("cancel-close barrier: heartbeat=%s cancelReturned=%s closes=%d%n", heartBeats, cancellationReturns, closed.get());
+        } finally {
+            unlock.countDown(); subscription.dispose();
+            assertThat(returned.await(3, TimeUnit.SECONDS)).isTrue();
+            loop.shutdownGracefully(0, 1, TimeUnit.SECONDS).sync();
+        }
+        assertThat(heartBeats).as("blocking close factory must not block the cancelling event loop").isTrue();
+        assertThat(cancellationReturns).isTrue(); assertThat(loop.inEventLoop(thread.get())).isFalse();
+        assertThat(context.get().getAllElements()).isEmpty();
+        await().atMost(Duration.ofSeconds(2)).untilAsserted(() -> assertThat(closed).hasValue(1));
+    }
+
+    @Test
+    void lateHandleBlockingCloseMustNotBlockCompletingEventLoop() throws Exception {
+        var loop = new DefaultEventLoop();
+        var entered = new CountDownLatch(1); var unlock = new CountDownLatch(1); var registered = new CountDownLatch(1);
+        var heartbeat = new CountDownLatch(1); var returned = new CountDownLatch(1); var closed = new AtomicInteger();
+        var thread = new AtomicReference<Thread>(); var context = new AtomicReference<PropagatedContext>();
+        var pending = new CompletableFuture<AuthorizationEvaluationV1>() {
+            @Override public CompletableFuture<AuthorizationEvaluationV1> whenComplete(
+                java.util.function.BiConsumer<? super AuthorizationEvaluationV1, ? super Throwable> callback) {
+                var result = super.whenComplete(callback); registered.countDown(); return result;
+            }
+        };
+        var subscription = evaluations((principal, tenant) -> pending).boundary(PRINCIPAL, "main", Mono::never).subscribe();
+        var handle = blockingClose(entered, unlock, closed, thread, context);
+        boolean heartBeats; boolean completionReturns;
+        try {
+            assertThat(registered.await(3, TimeUnit.SECONDS)).isTrue(); subscription.dispose();
+            loop.execute(() -> {
+                try (var scope = callerContext().propagate()) { pending.complete(handle); returned.countDown(); }
+            });
+            loop.execute(heartbeat::countDown);
+            assertThat(entered.await(3, TimeUnit.SECONDS)).isTrue();
+            heartBeats = heartbeat.await(100, TimeUnit.MILLISECONDS);
+            completionReturns = returned.getCount() == 0;
+            System.out.printf("late-close barrier: heartbeat=%s completeReturned=%s closes=%d%n", heartBeats, completionReturns, closed.get());
+        } finally {
+            unlock.countDown(); subscription.dispose();
+            assertThat(returned.await(3, TimeUnit.SECONDS)).isTrue();
+            loop.shutdownGracefully(0, 1, TimeUnit.SECONDS).sync();
+        }
+        assertThat(heartBeats).as("late close factory must not block the completion event loop").isTrue();
+        assertThat(completionReturns).isTrue(); assertThat(loop.inEventLoop(thread.get())).isFalse();
+        assertThat(context.get().getAllElements()).isEmpty(); assertThat(pending).isNotCancelled();
+        await().atMost(Duration.ofSeconds(2)).untilAsserted(() -> assertThat(closed).hasValue(1));
+    }
+}
