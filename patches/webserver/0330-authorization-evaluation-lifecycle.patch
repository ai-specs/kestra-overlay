+import io.kestra.webserver.errors.ProblemMapperRegistry;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.MediaType;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import io.micronaut.web.router.MethodBasedRouteMatch;
+import io.micronaut.web.router.RouteAttributes;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+import reactor.core.scheduler.Schedulers;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class AuthorizationEvaluationRestTest {
+
+    static io.micronaut.http.MutableHttpRequest<?> request() {
+        var request = HttpRequest.POST("/api/v1/main/executions/latest",
+            "[{\"namespace\":\"team.a\",\"id\":\"a\"},{\"namespace\":\"team.b\",\"id\":\"b\"}]".getBytes())
+            .contentType(MediaType.APPLICATION_JSON_TYPE);
+        request.setAttribute(SecurityFilter.AUTHENTICATION, Authentication.build("alice", List.of("reader")));
+        var route = (MethodBasedRouteMatch<?, ?>) Proxy.newProxyInstance(AuthorizationEvaluationRestTest.class.getClassLoader(),
+            new Class<?>[]{MethodBasedRouteMatch.class}, (proxy, method, arguments) -> switch (method.getName()) {
+                case "getDeclaringType" -> ExecutionController.class;
+                case "getMethodName" -> "getLatestExecutions";
+                case "getArgumentTypes" -> new Class<?>[0];
+                case "getVariableValues" -> Map.of("tenant", "main");
+                default -> throw new UnsupportedOperationException(method.getName());
+            });
+        RouteAttributes.setRouteMatch(request, route);
+        return request;
+    }
+
+    static TypedRestRbacFilter filter(TypedAuthorizationGate gate) {
+        return new TypedRestRbacFilter(new RbacConfiguration(true, false), new OssRestOperationAdapter(null), gate,
+            new ProblemFactory(new ProblemMapperRegistry(List.of()), new io.kestra.core.utils.EditionProvider()));
+    }
+
+    @Test
+    void shouldDenySwitchingCompositePlanBeforeBusinessContinuation() {
+        var provider = new AuthorizationEvaluationTest.Policy();
+        var gate = AuthorizationEvaluationTest.gate(provider);
+        provider.afterDecision = () -> provider.grants.set(Set.of("team.b"));
+        var effects = new AtomicInteger();
+        var response = Mono.from(filter(gate).doFilter(request(), ignored -> {
+            effects.incrementAndGet();
+            return Mono.just(HttpResponse.ok());
+        })).block();
+        assertThat(response.code()).isEqualTo(403);
+        assertThat(effects.get()).isZero();
+        assertThat(provider.begins.get()).isEqualTo(1);
+        assertThat(provider.closes.get()).isEqualTo(1);
+    }
+
+    @Test
+    void shouldKeepSnapshotAliveThroughAsyncBusinessQueryAndCloseAfterCompletion() {
+        var provider = new AuthorizationEvaluationTest.Policy();
+        provider.grants.set(Set.of("team.a", "team.b"));
+        var gate = AuthorizationEvaluationTest.gate(provider);
+        var namespaces = new TypedNamespaceAccessControl(gate);
+        var response = Mono.from(filter(gate).doFilter(request(), ignored -> io.kestra.core.repositories.AuthorizationEvaluationContext.<io.micronaut.http.MutableHttpResponse<?>>call(() -> {
+            assertThat(provider.closes.get()).isZero();
+            provider.grants.set(Set.of("other"));
+            assertThat(namespaces.domain(QueryFilter.Resource.FLOW).exactNamespaces()).containsExactlyInAnyOrder("team.a", "team.b");
+            assertThat(namespaces.domain(QueryFilter.Resource.EXECUTION).exactNamespaces()).containsExactlyInAnyOrder("team.a", "team.b");
+            return HttpResponse.ok();
+        }).subscribeOn(Schedulers.boundedElastic()))).block();
+        assertThat(response.code()).isEqualTo(200);
+        assertThat(provider.begins.get()).isEqualTo(1);
+        assertThat(provider.closes.get()).isEqualTo(1);
+    }
+}
