+import io.micronaut.security.filters.AuthenticationFetcher;
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Mono;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+import static org.assertj.core.api.Assertions.assertThat;
+
+@KestraTest(environments = "h2")
+@Property(name = "kestra.server-type", value = "WEBSERVER")
+@Property(name = "kestra.rbac.enabled", value = "true")
+@Property(name = "kestra.rbac.typed.enabled", value = "true")
+@Property(name = "kestra.rbac.evaluation.enabled", value = "true")
+@Property(name = "micronaut.security.enabled", value = "true")
+@Property(name = "micronaut.security.filter.enabled", value = "true")
+@Property(name = "micronaut.security.intercept-url-map[0].pattern", value = "/**")
+@Property(name = "micronaut.security.intercept-url-map[0].access[0]", value = "isAnonymous()")
+@Property(name = "mcp.http.security.fixture", value = "true")
+@Property(name = "evaluation.http.probe", value = "true")
+class AuthorizationEvaluationHttpTest {
+    @Inject EmbeddedServer server;
+    @Inject FlowRepositoryInterface flows;
+    @Inject SnapshotPolicy policy;
+
+    @Test
+    void shouldUseOneSnapshotThroughRealHttpControllerAndSqlPaginationThenRevokeNextRequest() throws Exception {
+        for (String namespace : List.of("evaluation.a", "evaluation.b")) {
+            flows.create(GenericFlow.fromYaml("main", "namespace: " + namespace + "\nid: snapshot\ntasks: []"));
+        }
+        policy.namespace.set("evaluation.a");
+        policy.begins.set(0);
+        policy.closes.set(0);
+        var client = HttpClient.newHttpClient();
+        var first = client.send(java.net.http.HttpRequest.newBuilder(server.getURI().resolve("/api/v1/main/flows/search"))
+            .header("X-Evaluation-Probe", "reader").GET().build(), java.net.http.HttpResponse.BodyHandlers.ofString());
+        assertThat(first.statusCode()).isEqualTo(200);
+        var firstJson = io.kestra.core.serializers.JacksonMapper.ofJson().readTree(first.body());
+        assertThat(firstJson.path("total").asLong()).isEqualTo(1);
+        assertThat(first.body()).contains("evaluation.a").doesNotContain("evaluation.b");
+        assertThat(policy.begins.get()).isEqualTo(1);
+        assertThat(policy.closes.get()).isEqualTo(1);
+        var second = client.send(java.net.http.HttpRequest.newBuilder(server.getURI().resolve("/api/v1/main/flows/search"))
+            .header("X-Evaluation-Probe", "reader").GET().build(), java.net.http.HttpResponse.BodyHandlers.ofString());
+        assertThat(second.statusCode()).isEqualTo(200);
+        assertThat(second.body()).contains("evaluation.b").doesNotContain("evaluation.a");
+        var denied = client.send(java.net.http.HttpRequest.newBuilder(server.getURI().resolve("/api/v1/main/flows"))
+            .header("X-Evaluation-Probe", "reader").header("Content-Type", "application/x-yaml")
+            .POST(java.net.http.HttpRequest.BodyPublishers.ofString("namespace: evaluation.a\nid: denied\ntasks: []")).build(),
+            java.net.http.HttpResponse.BodyHandlers.ofString());
+        assertThat(denied.statusCode()).isEqualTo(403);
+        assertThat(flows.findByIdWithoutAcl("main", "evaluation.a", "denied", Optional.empty())).isEmpty();
+        assertThat(flows.findDistinctNamespace("main")).isEmpty();
+    }
+
+    @Singleton
+    @Requires(property = "evaluation.http.probe", value = "true")
+    static class ProbeIdentity implements AuthenticationFetcher<io.micronaut.http.HttpRequest<?>> {
+        public org.reactivestreams.Publisher<Authentication> fetchAuthentication(io.micronaut.http.HttpRequest<?> request) {
+            return "reader".equals(request.getHeaders().get("X-Evaluation-Probe"))
+                ? Mono.just(Authentication.build("reader", List.of("reader"))) : Mono.empty();
+        }
+    }
+
+    @Test
+    void shouldReadSingleFlowWithoutGrantingCollectionListing() throws Exception {
+        flows.create(GenericFlow.fromYaml("main", "namespace: evaluation.detail\nid: single\ntasks: []"));
+        flows.create(GenericFlow.fromYaml("main", "namespace: evaluation.detail\nid: other\ntasks: []"));
+        policy.namespace.set("evaluation.detail");
+        policy.detailOnly.set(true);
+        try {
+            var client = HttpClient.newHttpClient();
+            for (var target : List.of("/api/v1/main/flows/evaluation.detail/single", "/api/v1/main/flows/evaluation.detail/other", "/api/v1/main/flows/search", "/api/v1/main/flows/evaluation.outside/single")) {
+                var response = client.send(java.net.http.HttpRequest.newBuilder(server.getURI().resolve(target))
+                    .header("X-Evaluation-Probe", "reader").GET().build(), java.net.http.HttpResponse.BodyHandlers.ofString());
+                if (target.equals("/api/v1/main/flows/evaluation.detail/single")) {
+                    assertThat(response.statusCode()).isEqualTo(200);
+                    assertThat(response.body()).contains("evaluation.detail");
+                } else assertThat(response.statusCode()).isEqualTo(403);
+            }
+            assertThat(flows.findById("main", "evaluation.detail", "single", Optional.empty())).isEmpty();
+        } finally {
+            policy.detailOnly.set(false);
+        }
+    }
+
+    @Singleton
+    @Requires(property = "evaluation.http.probe", value = "true")
+    static class SnapshotPolicy implements AuthorizationEvaluationProviderV1 {
+        final AtomicReference<String> namespace = new AtomicReference<>("evaluation.a");
+        final AtomicInteger begins = new AtomicInteger();
+        final AtomicInteger closes = new AtomicInteger();
+        final AtomicBoolean detailOnly = new AtomicBoolean();
+
+        public CompletionStage<AuthorizationEvaluationV1> begin(RbacAuthorizer.Principal principal, String tenant) {
+            begins.incrementAndGet();
+            String snapshot = namespace.get();
+            return CompletableFuture.completedFuture(new AuthorizationEvaluationV1() {
+                public CompletionStage<Decision> authorize(Operation operation) {
+                    if (detailOnly.get()) {
+                        boolean allowed = operation.resource() == Resource.METADATA
+                            || operation.resource() == Resource.FLOW && operation.action() == Action.READ && snapshot.equals(operation.namespace())
+                                && "single".equals(operation.resourceId());
+                        return CompletableFuture.completedFuture(allowed
+                            ? Decision.allow(new QueryDomain(List.of(snapshot), List.of(), List.of(), true, false))
+                            : Decision.deny("Collection listing is not granted"));
+                    }
+                    namespace.set("evaluation.b");
+                    return CompletableFuture.completedFuture(operation.action() == Action.LIST || operation.resource() == Resource.METADATA
+                        ? Decision.allow(new QueryDomain(List.of(snapshot), List.of(), List.of(), true, false))
+                        : Decision.deny("Read-only snapshot"));
+                }
+                public CompletionStage<Void> close() {
+                    closes.incrementAndGet();
+                    return CompletableFuture.completedFuture(null);
+                }
+            });
+        }
+    }
+}
