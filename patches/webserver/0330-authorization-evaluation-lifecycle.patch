+            (principal, tenant) -> null,
+            (principal, tenant) -> CompletableFuture.completedFuture(null),
+            (principal, tenant) -> CompletableFuture.failedFuture(new IllegalStateException("begin failed")),
+            (principal, tenant) -> { throw new IllegalStateException("begin threw"); })) {
+            assertThatThrownBy(() -> evaluations(provider).boundary(PRINCIPAL, "main", () -> Mono.fromCallable(effects::incrementAndGet)).blockLast())
+                .isInstanceOf(RuntimeException.class);
+        }
+        assertThat(effects.get()).isZero();
+    }
