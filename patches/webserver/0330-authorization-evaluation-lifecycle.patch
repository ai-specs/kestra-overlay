+    private record TransactionProbe(java.sql.Connection connection) implements PropagatedContextElement {}
+
+    private static PropagatedContext callerContext() {
+        return PropagatedContext.empty().plus(new AuthorizationInvocationContext(HttpRequest.GET("/cleanup-probe"), false))
+            .plus(new TransactionProbe(org.mockito.Mockito.mock(java.sql.Connection.class)));
+    }
+    private static AuthorizationEvaluationV1 blockingClose(CountDownLatch entered, CountDownLatch unlock,
+        AtomicInteger closed, AtomicReference<Thread> thread, AtomicReference<PropagatedContext> context) {
+        return new AuthorizationEvaluationV1() {
+            public java.util.concurrent.CompletionStage<TypedAuthorization.Decision> authorize(TypedAuthorization.Operation operation) {
+                return CompletableFuture.completedFuture(TypedAuthorization.Decision.allow(TypedAuthorization.QueryDomain.unrestricted()));
+            }
+            public java.util.concurrent.CompletionStage<Void> close() {
+                closed.incrementAndGet(); thread.set(Thread.currentThread()); context.set(PropagatedContext.getOrEmpty());
+                entered.countDown();
+                boolean interrupted = false;
+                while (true) {
+                    try { unlock.await(); break; } catch (InterruptedException ignored) { interrupted = true; }
+                }
+                if (interrupted) Thread.currentThread().interrupt();
+                return CompletableFuture.completedFuture(null);
+            }
+        };
+    }
