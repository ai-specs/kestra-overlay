+++ b/webserver/src/main/java/io/kestra/webserver/rbac/AuthorizationUnavailableException.java
@@ -0,0 +1,17 @@
+package io.kestra.webserver.rbac;
+
+public final class AuthorizationUnavailableException extends RuntimeException {
+    public AuthorizationUnavailableException() {
+        super("Authorization dependency is unavailable");
+    }
+
+    static AuthorizationUnavailableException classified(Throwable failure) {
+        for(int depth=0;depth<16;depth++) {
+            if(failure instanceof AuthorizationUnavailableException unavailable)return unavailable;
+            if(!(failure instanceof java.util.concurrent.CompletionException || failure instanceof java.util.concurrent.ExecutionException)
+                || failure.getCause()==null || failure.getCause()==failure)return null;
+            failure=failure.getCause();
+        }
+        return null;
+    }
+}
