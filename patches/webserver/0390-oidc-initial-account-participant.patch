+class OidcInitialAccountPostgresTest {
+    private static DataSource source;
+    private String schema;
+    private Environment environment;
+    private DataSource scoped;
+    private BeanProvider<OidcInitialAccountParticipantV1> providers;
+    private OidcInitialAccountParticipantV1 participant;
+    private final AtomicInteger calls = new AtomicInteger();
+    @TempDir Path directory;
+
+    @BeforeAll
+    static void database() {
+        source = OidcPostgresTestBase.dataSource();
+    }
+
+    @BeforeEach
+    void prepare() throws Exception {
+        schema = "host_onboarding_" + UUID.randomUUID().toString().replace("-", "");
+        try (var connection = source.getConnection(); var statement = connection.createStatement()) {
+            statement.execute("CREATE SCHEMA " + schema);
+        }
+        scoped = mock(DataSource.class);
+        when(scoped.getConnection()).thenAnswer(invocation -> {
+            var connection = source.getConnection();
+            connection.setSchema(schema);
+            return connection;
+        });
+        try (var connection = scoped.getConnection(); var statement = connection.createStatement()) {
+            for (String resource : List.of("90-oidc-server-jwk", "91-oidc-server-directory", "92-oidc-server-token",
+                "93-oidc-server-setup", "94-oidc-server-installation", "95-oidc-server-owner", "96-oidc-server-resource",
+                "97-oidc-server-rate", "98-oidc-server-client-secret", "99-oidc-server-user-directory",
+                "99-oidc-server-v2-account-deletion", "99-oidc-server-v2-client-credentials", "99-oidc-server-v2-password-change")) {
+                try (var input = getClass().getResourceAsStream("/migrations/2.0." + resource + "-postgres.sql")) {
+                    assertNotNull(input);
+                    statement.execute(new String(input.readAllBytes(), java.nio.charset.StandardCharsets.UTF_8));
+                }
+            }
+            statement.execute("CREATE TABLE onboarding_probe(subject TEXT PRIMARY KEY, installation_id TEXT NOT NULL)");
+        }
+        environment = mock(Environment.class);
+        when(environment.getProperty(anyString(), eq(String.class))).thenReturn(Optional.empty());
+        when(environment.getProperty(anyString(), eq(Boolean.class))).thenReturn(Optional.empty());
+        property("kestra.oidc.bootstrap.receipt-path", directory.resolve("receipt").toString());
+        property("micronaut.security.oauth2.clients.kestra.client-id", "login-ui");
+        property("micronaut.security.oauth2.clients.kestra.client-secret", "test-client-secret");
+        when(environment.getProperty("kestra.rbac.enabled", Boolean.class)).thenReturn(Optional.of(true));
+        when(environment.getProperty("kestra.rbac.application-groups.enabled", Boolean.class)).thenReturn(Optional.of(true));
+        property("kestra.rbac.application-groups.enabled", "true");
+        providers = mock(BeanProvider.class);
+        when(providers.isUnique()).thenReturn(true);
+        participant = (connection, account) -> {
+            calls.incrementAndGet();
+            assertFalse(connection.getAutoCommit());
+            assertEquals(Connection.TRANSACTION_READ_COMMITTED, connection.getTransactionIsolation());
+            assertEquals("http://localhost:8080", account.issuer());
+            assertEquals("login-ui", account.configuredLoginClientId());
+            assertEquals("first", account.subject());
+            try (var query = connection.createStatement(); var rows = query.executeQuery("SELECT count(*) FROM pg_locks WHERE locktype='advisory' AND pid=pg_backend_pid() AND granted AND objid IN (1380073797,1330133)")) {
+                assertTrue(rows.next());
+                assertEquals(2, rows.getInt(1));
+            }
+            assertEquals(0, count(connection, "oidc_user"));
+            assertEquals(0, count(connection, "oidc_client"));
+            try (var statement = connection.prepareStatement("INSERT INTO onboarding_probe VALUES (?,?)")) {
+                statement.setString(1, account.subject());
+                statement.setString(2, account.installationId());
+                statement.executeUpdate();
+            }
+        };
+        when(providers.get()).thenAnswer(invocation -> participant);
+    }
+
+    @AfterEach
+    void cleanup() throws Exception {
+        try (var connection = source.getConnection(); var statement = connection.createStatement()) {
+            statement.execute("DROP SCHEMA " + schema + " CASCADE");
+        }
+    }
+
+    private void property(String key, String value) {
+        when(environment.getProperty(key, String.class)).thenReturn(Optional.of(value));
+    }
+
+    private OidcSetupService service() {
+        return new OidcSetupService(scoped, new OidcConfiguration(), environment, OidcClientSecretCodec.plaintext(), providers);
+    }
+
+    private Map<String, String> form() {
+        return Map.of("username", "first", "password", "FirstPass123!", "issuer", "https://untrusted.invalid", "roles", "attacker");
+    }
+
+    private static int count(Connection connection, String table) throws SQLException {
+        try (var statement = connection.createStatement(); var rows = statement.executeQuery("SELECT count(*) FROM " + table)) {
+            rows.next();
+            return rows.getInt(1);
+        }
+    }
+
+    private void empty() throws Exception {
+        try (var connection = scoped.getConnection()) {
+            for (String table : List.of("oidc_user", "oidc_user_auth_method", "oidc_client", "oidc_setup", "onboarding_probe")) {
+                assertEquals(0, count(connection, table), table);
+            }
+        }
