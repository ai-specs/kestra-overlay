+        empty();
+    }
+
+    @Test
+    void participantWriteThenFailureRollsBackAndCanRetry() throws Exception {
+        var original = participant;
+        participant = (connection, account) -> { original.initialize(connection, account); throw new SQLException("private database failure"); };
+        var failure = assertThrows(IllegalStateException.class, () -> service().setup(form()));
+        assertFalse(failure.toString().contains("private"));
+        empty();
+        participant = original;
+        assertTrue(service().setup(form()));
+    }
+
+    @Test
+    void hostWriteFailureRollsBackPluginAndCanRetry() throws Exception {
+        try (var connection = scoped.getConnection(); var statement = connection.createStatement()) {
+            statement.execute("ALTER TABLE oidc_user ADD CONSTRAINT reject_initial CHECK (username <> 'first')");
+        }
+        assertThrows(IllegalStateException.class, () -> service().setup(form()));
+        empty();
+        try (var connection = scoped.getConnection(); var statement = connection.createStatement()) {
+            statement.execute("ALTER TABLE oidc_user DROP CONSTRAINT reject_initial");
