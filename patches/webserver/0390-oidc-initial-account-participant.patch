+        String token = page.getCookie("oidc_setup_csrf").orElseThrow().getValue();
+        when(setup.setup(anyMap())).thenThrow(new IllegalStateException("PRIVATE_SQL_PASSWORD"));
+        var request = new io.micronaut.http.simple.SimpleHttpRequest<Map<String, String>>(io.micronaut.http.HttpMethod.POST, "/oidc/setup", Map.of());
+        request.header("Origin", "http://localhost:8080");
+        request.cookie(io.micronaut.http.cookie.Cookie.of("oidc_setup_csrf", token));
+        var failed = controller.submit(request, Map.of("csrf", token));
+        assertEquals(HttpStatus.INTERNAL_SERVER_ERROR, failed.getStatus());
+        assertEquals("text/html", failed.getContentType().orElseThrow().getName());
+        String body = failed.getBody(String.class).orElseThrow();
+        assertTrue(body.contains("role=\"alert\""));
+        assertTrue(body.contains("href=\"/oidc/setup\""));
+        assertFalse(body.contains("PRIVATE_SQL_PASSWORD"));
+        assertFalse(body.contains("No account has been created"));
+        assertFalse(body.contains("<form"));
+        String replacement = controller.page(HttpRequest.GET("/oidc/setup")).getCookie("oidc_setup_csrf").orElseThrow().getValue();
+        assertNotEquals(token, replacement);
+        when(setup.ready()).thenThrow(new IllegalStateException("receipt is locked"));
+        var locked = controller.page(HttpRequest.GET("/oidc/setup"));
+        assertEquals(HttpStatus.INTERNAL_SERVER_ERROR, locked.getStatus());
+        assertFalse(locked.getBody(String.class).orElseThrow().contains("<form"));
+        assertTrue(locked.getCookie("oidc_setup_csrf").isEmpty());
+    }
+}
