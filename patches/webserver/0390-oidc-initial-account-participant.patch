@@ -0,0 +1,28 @@
+package io.kestra.webserver.oidc;
+
+import java.net.URI;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.UUID;
+
+public interface OidcInitialAccountParticipantV1 {
+    void initialize(Connection connection, InitialAccount account) throws SQLException;
+
+    record InitialAccount(String issuer, String installationId, String configuredLoginClientId, String subject) {
+        public InitialAccount {
+            if (issuer == null || installationId == null || configuredLoginClientId == null || subject == null) {
+                throw new IllegalArgumentException("Invalid initial account context");
+            }
+            URI address = URI.create(issuer);
+            if (!("https".equals(address.getScheme()) || "http".equals(address.getScheme()))
+                || address.getHost() == null || address.getRawUserInfo() != null || address.getRawQuery() != null
+                || address.getRawFragment() != null || !UUID.fromString(installationId).toString().equals(installationId)
+                || configuredLoginClientId.isBlank() || configuredLoginClientId.length() > 256
+                || !configuredLoginClientId.equals(configuredLoginClientId.strip())
+                || configuredLoginClientId.chars().anyMatch(Character::isISOControl)
+                || !subject.matches("[A-Za-z0-9._@+-]{1,128}")) {
+                throw new IllegalArgumentException("Invalid initial account context");
+            }
+        }
+    }
+}
diff --git a/webserver/src/main/java/io/kestra/webserver/oidc/OidcUiClientScopes.java b/webserver/src/main/java/io/kestra/webserver/oidc/OidcUiClientScopes.java
