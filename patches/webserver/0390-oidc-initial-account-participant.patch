@@ -0,0 +1,156 @@
+package io.kestra.webserver.oidc;
+
+import io.kestra.core.junit.annotations.KestraTest;
+import io.kestra.webserver.oidc.services.OidcInitialAccountUnavailable;
+import io.kestra.webserver.oidc.services.OidcSetupService;
+import io.micronaut.context.annotation.Factory;
+import io.micronaut.context.annotation.Property;
+import io.micronaut.context.annotation.Replaces;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.runtime.server.EmbeddedServer;
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@KestraTest(environments = "h2")
+@Property(name = "kestra.server-type", value = "WEBSERVER")
+@Property(name = "kestra.oidc.enabled", value = "true")
+@Property(name = "kestra.oidc.issuer", value = "http://localhost")
+@Property(name = "kestra.rbac.enabled", value = "true")
+@Property(name = "kestra.rbac.typed.enabled", value = "true")
+@Property(name = "micronaut.security.enabled", value = "false")
+@Property(name = "oidc.initial-account.http-test", value = "true")
+class OidcInitialAccountHttpTest {
+    @Inject EmbeddedServer server;
+    @Inject OidcConfiguration configuration;
+    private static final AtomicInteger STATE = new AtomicInteger();
+    private static final AtomicInteger WRITES = new AtomicInteger();
+
+    @BeforeEach
+    void reset() {
+        STATE.set(0);
+        WRITES.set(0);
+    }
+
+    private HttpResponse<String> request(String method, String body, String origin, String cookie) throws Exception {
+        var builder = HttpRequest.newBuilder(server.getURI().resolve("/oidc/setup"));
+        if (origin != null) builder.header("Origin", origin);
+        if (cookie != null) builder.header("Cookie", cookie);
+        if (method.equals("GET")) builder.GET();
+        else builder.header("Content-Type", "application/x-www-form-urlencoded").POST(HttpRequest.BodyPublishers.ofString(body));
+        return HttpClient.newHttpClient().send(builder.build(), HttpResponse.BodyHandlers.ofString());
+    }
+
+    @Test
+    void diagnosticRemainsReachableThroughTypedGateAndDoesNotWrite() throws Exception {
+        var page = request("GET", "", null, null);
+        assertEquals(200, page.statusCode());
+        assertTrue(page.body().contains("data-setup-wait"));
+        assertEquals("no-store", page.headers().firstValue("cache-control").orElseThrow());
+        assertEquals(503, request("POST", "username=first", "http://localhost", null).statusCode());
+        assertEquals(0, WRITES.get());
+        String issuer = configuration.getIssuer();
+        try {
+            configuration.setIssuer(server.getURI().toString());
+            browser();
+        } finally {
+            configuration.setIssuer(issuer);
+        }
+    }
+
+    private void browser() throws Exception {
+        String script = System.getenv("OIDC_ONBOARDING_BROWSER_SCRIPT");
+        if (script == null) return;
+        var mapper = new com.fasterxml.jackson.databind.ObjectMapper();
+        String module = mapper.writeValueAsString(java.nio.file.Path.of(script).toUri().toString());
+        String base = mapper.writeValueAsString(server.getURI().toString());
+        String report = mapper.writeValueAsString(System.getenv("OIDC_ONBOARDING_BROWSER_REPORT"));
+        var signal = java.nio.file.Path.of(System.getenv("OIDC_ONBOARDING_BROWSER_REPORT") + ".ready");
+        java.nio.file.Files.deleteIfExists(signal);
+        String signalJson = mapper.writeValueAsString(signal.toString());
+        boolean node = "node".equals(System.getenv("OIDC_ONBOARDING_BROWSER_DRIVER"));
+        String code = "const task=await taskSpace('onboarding-host-20261103');console.log('spaceId='+task.spaceId);"
+            + "const {runOnboardingBrowserChecks}=await import(" + module + ");const fs=await import('node:fs/promises');"
+            + "try{const report=await runOnboardingBrowserChecks(task.page('p1')," + base + ",()=>fs.writeFile(" + signalJson + ",'ready'));"
+            + "await fs.writeFile(" + report + ",JSON.stringify(report,null,2));console.log('onboarding browser checks='+report.checks.length);"
+            + "await task.finish({keep:[]});}catch(error){await fs.writeFile(" + report + ",JSON.stringify(error.report??{completed:false,error:String(error)},null,2));throw error;}";
+        var builder = node ? new ProcessBuilder("node", System.getenv("OIDC_ONBOARDING_BROWSER_RUNNER"))
+            : new ProcessBuilder("ego-browser", "nodejs");
+        builder.environment().put("OIDC_ONBOARDING_BROWSER_BASE", server.getURI().toString());
+        if (node) {
+            builder.environment().put("OIDC_ONBOARDING_BROWSER_SCRIPT", script);
+            builder.environment().put("OIDC_ONBOARDING_BROWSER_REPORT", System.getenv("OIDC_ONBOARDING_BROWSER_REPORT"));
+            builder.environment().put("NODE_PATH", System.getenv("NODE_PATH"));
+        }
+        var process = builder.redirectErrorStream(true).start();
+        process.onExit().orTimeout(3, java.util.concurrent.TimeUnit.MINUTES).exceptionally(failure -> { process.destroyForcibly(); return process; });
+        var watcher = Thread.ofVirtual().start(() -> {
+            while (process.isAlive()) {
+                if (java.nio.file.Files.exists(signal)) { STATE.set(1); return; }
+                try { Thread.sleep(100); } catch (InterruptedException interrupted) { Thread.currentThread().interrupt(); return; }
+            }
+        });
+        try (var input = process.getOutputStream()) { if (!node) input.write(code.getBytes(java.nio.charset.StandardCharsets.UTF_8)); }
+        var output = new StringBuilder();
+        try (var reader = process.inputReader()) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                output.append(line).append('\n');
+            }
+        }
+        assertEquals(0, process.waitFor(), output.toString());
+        watcher.join();
+        java.nio.file.Files.deleteIfExists(signal);
+        System.out.println(output);
+        assertEquals(0, WRITES.get());
+    }
+
+    @Test
+    void csrfAndOriginRejectBeforeWriteAndSuccessClosesBadBody() throws Exception {
+        STATE.set(1);
+        var page = request("GET", "", null, null);
+        assertEquals(200, page.statusCode());
+        String cookie = page.headers().allValues("set-cookie").stream().filter(value -> value.startsWith("oidc_setup_csrf=")).findFirst().orElseThrow().split(";", 2)[0];
+        String csrf = cookie.substring(cookie.indexOf('=') + 1);
+        String body = "username=first&password=FirstPass123!&csrf=" + java.net.URLEncoder.encode(csrf, java.nio.charset.StandardCharsets.UTF_8);
+        assertEquals(403, request("POST", body, "https://attacker.invalid", cookie).statusCode());
+        assertEquals(403, request("POST", "username=first&csrf=bad", "http://localhost", cookie).statusCode());
+        assertEquals(0, WRITES.get());
+        assertEquals(303, request("POST", body, "http://localhost", cookie).statusCode());
+        assertEquals(1, WRITES.get());
+        assertEquals(404, request("GET", "", null, null).statusCode());
+        assertEquals(404, request("POST", "%XX=broken", null, null).statusCode());
+        assertEquals(404, request("POST", "", null, null).statusCode());
+        assertEquals(1, WRITES.get());
+    }
+
+    @Factory
+    @Requires(property = "oidc.initial-account.http-test", value = "true")
+    static class Services {
+        @Singleton
+        @Replaces(OidcSetupService.class)
+        OidcSetupService setup() {
+            var service = mock(OidcSetupService.class);
+            when(service.ready()).thenAnswer(invocation -> {
+                if (STATE.get() == 0) throw new OidcInitialAccountUnavailable();
+                return STATE.get() == 2;
+            });
+            when(service.initialParticipantRequired()).thenReturn(true);
+            when(service.setup(anyMap())).thenAnswer(invocation -> {
+                java.util.Map<String, String> fields = invocation.getArgument(0);
+                if (fields.getOrDefault("password", "").length() < 8) throw new IllegalArgumentException("Invalid account fields");
+                WRITES.incrementAndGet();
+                STATE.set(2);
+                return true;
+            });
+            return service;
+        }
+    }
+}
