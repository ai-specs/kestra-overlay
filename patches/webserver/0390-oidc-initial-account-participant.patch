@@ -0,0 +1,36 @@
+package io.kestra.webserver.oidc;
+
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.context.env.Environment;
+import io.micronaut.context.event.BeanCreatedEvent;
+import io.micronaut.context.event.BeanCreatedEventListener;
+import io.micronaut.security.oauth2.configuration.OauthClientConfigurationProperties;
+import jakarta.inject.Singleton;
+import java.util.ArrayList;
+
+@Singleton
+@Requires(property = "kestra.oidc.enabled", value = "true")
+public final class OidcUiClientScopes implements BeanCreatedEventListener<OauthClientConfigurationProperties> {
+    private final Environment environment;
+
+    public OidcUiClientScopes(Environment environment) {
+        this.environment = environment;
+    }
+
+    @Override
+    public OauthClientConfigurationProperties onCreated(BeanCreatedEvent<OauthClientConfigurationProperties> event) {
+        var client = event.getBean();
+        String name = environment.getProperty("kestra.oidc.bootstrap.client-name", String.class).filter(value -> !value.isEmpty()).orElse("kestra");
+        String clientId = environment.getProperty("micronaut.security.oauth2.clients." + name + ".client-id", String.class).orElse("");
+        if (environment.getProperty("kestra.rbac.enabled", Boolean.class).orElse(false)
+            && environment.getProperty("kestra.rbac.application-groups.enabled", Boolean.class).orElse(false)
+            && name.equals(client.getName()) && !clientId.isBlank() && clientId.equals(client.getClientId())) {
+            var scopes = new ArrayList<>(client.getScopes());
+            if (!scopes.contains(ApplicationGroupScopeIssuance.UI_SELECTOR)) {
+                scopes.add(ApplicationGroupScopeIssuance.UI_SELECTOR);
+                client.setScopes(scopes);
+            }
+        }
+        return client;
+    }
+}
