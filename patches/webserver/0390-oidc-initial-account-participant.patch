diff --git a/webserver/src/main/java/io/kestra/webserver/oidc/OidcInitialAccountParticipantV1.java b/webserver/src/main/java/io/kestra/webserver/oidc/OidcInitialAccountParticipantV1.java
new file mode 100644
index 0000000..9f55eb8
