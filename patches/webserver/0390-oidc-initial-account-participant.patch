+package io.kestra.webserver.oidc;
+
+import io.micronaut.context.ApplicationContext;
+import io.micronaut.context.env.Environment;
+import io.micronaut.context.event.BeanCreatedEvent;
+import io.micronaut.security.oauth2.configuration.OauthClientConfigurationProperties;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class OidcUiClientScopesTest {
+    private OauthClientConfigurationProperties apply(String name, String clientId, boolean rbac, boolean groups) {
+        var environment = mock(Environment.class);
+        when(environment.getProperty("kestra.rbac.enabled", Boolean.class)).thenReturn(Optional.of(rbac));
+        when(environment.getProperty("kestra.rbac.application-groups.enabled", Boolean.class)).thenReturn(Optional.of(groups));
+        when(environment.getProperty("micronaut.security.oauth2.clients.kestra.client-id", String.class)).thenReturn(Optional.of("login-ui"));
+        var client = new OauthClientConfigurationProperties(name);
+        client.setClientId(clientId);
+        client.setScopes(List.of("openid", "email", "offline_access"));
+        var event = mock(BeanCreatedEvent.class);
+        when(event.getBean()).thenReturn(client);
+        var listener = new OidcUiClientScopes(environment);
+        assertSame(client, listener.onCreated(event));
+        listener.onCreated(event);
+        return client;
+    }
+
+    @Test
+    void mergesExplicitScopesOnce() {
+        assertEquals(List.of("openid", "email", "offline_access", ApplicationGroupScopeIssuance.UI_SELECTOR), apply("kestra", "login-ui", true, true).getScopes());
+    }
+
+    @Test
+    void leavesModeAAndDisabledGroupsUnchanged() {
+        assertEquals(List.of("openid", "email", "offline_access"), apply("kestra", "login-ui", false, true).getScopes());
+        assertEquals(List.of("openid", "email", "offline_access"), apply("kestra", "login-ui", true, false).getScopes());
+    }
+
+    @Test
+    void neverExpandsOtherClients() {
+        assertEquals(List.of("openid", "email", "offline_access"), apply("external", "login-ui", true, true).getScopes());
+        assertEquals(List.of("openid", "email", "offline_access"), apply("kestra", "external", true, true).getScopes());
+    }
+
+    @Test
+    void micronautCreatesConfiguredClientWithMergedScopesWithoutParticipant() {
+        try (var context = ApplicationContext.run(Map.of(
+            "kestra.oidc.enabled", true, "kestra.rbac.enabled", true,
+            "kestra.rbac.application-groups.enabled", true,
+            "micronaut.security.oauth2.clients.kestra.client-id", "login-ui",
+            "micronaut.security.oauth2.clients.kestra.client-secret", "test-client-secret",
+            "micronaut.security.oauth2.clients.kestra.scopes", List.of("openid", "offline_access")))) {
+            var client = context.getBean(OauthClientConfigurationProperties.class, io.micronaut.inject.qualifiers.Qualifiers.byName("kestra"));
+            assertEquals(List.of("openid", "offline_access", ApplicationGroupScopeIssuance.UI_SELECTOR), client.getScopes());
+        }
+    }
+}
