+package io.kestra.webserver.oidc;
+
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class OidcInitialAccountContractTest {
+    @Test
+    void acceptsOnlyValidatedImmutableContext() {
+        var context = new OidcInitialAccountParticipantV1.InitialAccount("https://id.example/oidc", UUID.randomUUID().toString(), "login-client", "first.user");
+        assertEquals("first.user", context.subject());
+        assertEquals(4, context.getClass().getRecordComponents().length);
+    }
+
+    @Test
+    void rejectsUntrustedIssuerAndIdentifiers() {
+        String installation = UUID.randomUUID().toString();
+        for (String issuer : new String[]{"", "file:///oidc", "https://user@id.example", "https://id.example?x=1", "https://id.example#x"}) {
+            assertThrows(IllegalArgumentException.class, () -> new OidcInitialAccountParticipantV1.InitialAccount(issuer, installation, "ui", "first"));
+        }
+        for (String client : new String[]{"", " ui", "ui\n", "x".repeat(257)}) {
+            assertThrows(IllegalArgumentException.class, () -> new OidcInitialAccountParticipantV1.InitialAccount("https://id.example", installation, client, "first"));
+        }
+        assertThrows(IllegalArgumentException.class, () -> new OidcInitialAccountParticipantV1.InitialAccount("https://id.example", "1-1-1-1-1", "ui", "first"));
+        assertThrows(IllegalArgumentException.class, () -> new OidcInitialAccountParticipantV1.InitialAccount("https://id.example", installation, "ui", " bad"));
+        assertThrows(IllegalArgumentException.class, () -> new OidcInitialAccountParticipantV1.InitialAccount(null, installation, "ui", "first"));
+    }
+}
