@@ -0,0 +1,55 @@
+import {describe, expect, it, vi} from "vitest"
+import {waitForSetup} from "./oidc-setup-wait"
+
+describe("first installation component wait", () => {
+    it("backs off through unavailable server and missing component without posting", async () => {
+        const callbacks: Array<() => void> = []
+        const delays: number[] = []
+        const request = vi.fn().mockRejectedValueOnce(new Error("offline")).mockResolvedValue(new Response("<section data-setup-wait>"))
+        const reload = vi.fn()
+        const stop = waitForSetup(request, reload, (callback, delay) => { callbacks.push(callback); delays.push(delay) }, () => true)
+        for (let attempt = 0; attempt < 6; attempt++) await callbacks.shift()!()
+        expect(delays).toEqual([2000, 4000, 8000, 16000, 30000, 30000, 30000])
+        expect(request.mock.calls.every(([url, options]) => url === "/oidc/setup" && options.method === undefined && options.cache === "no-store")).toBe(true)
+        expect(reload).not.toHaveBeenCalled()
+        stop()
+        await callbacks.shift()!()
+        expect(request).toHaveBeenCalledTimes(6)
+    })
+
+    it("reloads a restored form to obtain a fresh CSRF token", async () => {
+        const callbacks: Array<() => void> = []
+        const reload = vi.fn()
+        waitForSetup(vi.fn().mockResolvedValue(new Response("<form>")), reload, callback => callbacks.push(callback), () => true)
+        await callbacks.shift()!()
+        expect(reload).toHaveBeenCalledOnce()
+        expect(callbacks).toHaveLength(0)
+    })
+
+    it("reloads completed setup and pauses network polling in hidden pages", async () => {
+        const callbacks: Array<() => void> = []
+        const request = vi.fn().mockResolvedValue(new Response("", {status: 404}))
+        const reload = vi.fn()
+        let visible = false
+        waitForSetup(request, reload, callback => callbacks.push(callback), () => visible)
+        await callbacks.shift()!()
+        expect(request).not.toHaveBeenCalled()
+        visible = true
+        await callbacks.shift()!()
+        expect(reload).toHaveBeenCalledOnce()
+    })
+
+    it("does not reload a departed page when an in-flight request returns", async () => {
+        const callbacks: Array<() => void> = []
+        let resolve!: (response: Response) => void
+        const request = vi.fn(() => new Promise<Response>(done => { resolve = done }))
+        const reload = vi.fn()
+        const stop = waitForSetup(request, reload, callback => callbacks.push(callback), () => true)
+        const pending = callbacks.shift()!()
+        stop()
+        resolve(new Response("<form>"))
+        await pending
+        expect(reload).not.toHaveBeenCalled()
+        expect(callbacks).toHaveLength(0)
+    })
+})
diff --git a/ui/src/oidc-setup-wait.ts b/ui/src/oidc-setup-wait.ts
new file mode 100644
index 0000000..5cc6005
--- /dev/null
+++ b/ui/src/oidc-setup-wait.ts
@@ -0,0 +1,25 @@
+export function waitForSetup(
+    request: typeof fetch = fetch,
+    reload: () => void = () => location.reload(),
+    schedule: (callback: () => void, delay: number) => unknown = setTimeout,
+    active: () => boolean = () => !document.hidden,
+) {
+    let delay = 2000
+    let stopped = false
+    async function check() {
+        if (stopped) return
+        if (active()) {
+            try {
+                const response = await request("/oidc/setup", {credentials: "same-origin", cache: "no-store", signal: AbortSignal.timeout(10000)})
+                if (stopped) return
+                if (response.status === 404 || response.ok && !(await response.text()).includes("data-setup-wait")) {
+                    reload()
+                    return
+                }
+            } catch {}
+        }
+        if (!stopped) schedule(check, delay = Math.min(delay * 2, 30000))
+    }
+    schedule(check, delay)
+    return () => { stopped = true }
+}
