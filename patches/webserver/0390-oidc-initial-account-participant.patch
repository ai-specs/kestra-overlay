+        assertTrue(service().ready());
+        assertFalse(service().setup(form()));
+        assertEquals(1, calls.get());
+        try (var connection = scoped.getConnection(); var statement = connection.createStatement(); var rows = statement.executeQuery("SELECT probe.installation_id=setup.installation_id FROM onboarding_probe probe CROSS JOIN oidc_setup setup")) {
+            assertTrue(rows.next());
+            assertTrue(rows.getBoolean(1));
+        }
+    }
+
+    @Test
+    void bootstrapUsesSameTransactionAndNeverRegrants() {
