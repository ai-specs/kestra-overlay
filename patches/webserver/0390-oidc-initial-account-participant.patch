+        if (name.isEmpty()) name = "kestra";
+        if (!name.matches("[a-zA-Z0-9_-]+")) throw new IllegalArgumentException("Invalid UI client configuration");
+        String prefix = "micronaut.security.oauth2.clients." + name;
+        String clientId = property(prefix + ".client-id");
+        String secret = property(prefix + ".client-secret");
+        var account = new io.kestra.webserver.oidc.OidcInitialAccountParticipantV1.InitialAccount(
+            configuration.getIssuer(), identity, clientId, subject);
+        if (secret.isBlank()) throw new IllegalArgumentException("Invalid UI client configuration");
+        String callback = account.issuer().replaceAll("/+$", "") + "/oauth/callback/" + name;
+        try (var statement = connection.prepareStatement("SELECT client_secret,redirect_uris @> jsonb_build_array(?::text),active FROM oidc_client WHERE client_id=?")) {
