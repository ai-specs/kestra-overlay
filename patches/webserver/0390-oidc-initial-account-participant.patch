+        verifyNoInteractions(providers);
+        assertEquals(0, calls.get());
+    }
+
+    @Test
+    void missingAndDuplicateParticipantsLeaveEmptyInstallation() throws Exception {
+        when(providers.isUnique()).thenReturn(false);
