+        assertTrue(service().ready());
+        assertEquals(1, calls.get());
+    }
+
+    @Test
+    void modeADoesNotResolveOrInvokeParticipant() {
+        when(environment.getProperty("kestra.rbac.enabled", Boolean.class)).thenReturn(Optional.of(false));
