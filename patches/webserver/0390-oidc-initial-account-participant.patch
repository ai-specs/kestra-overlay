+            doThrow(new SQLException("unknown commit outcome")).when(connection).commit();
+            return connection;
+        });
+        scoped = failing;
+        assertThrows(IllegalStateException.class, () -> service().setup(form()));
+        scoped = real;
+        assertTrue(Files.exists(directory.resolve("receipt")));
+        assertThrows(IllegalStateException.class, () -> service().ready());
+        assertThrows(IllegalStateException.class, () -> service().setup(form()));
+        try (var connection = scoped.getConnection()) { assertEquals(0, count(connection, "oidc_user")); }
+    }
+
+    @Test
+    void corruptedReceiptDoesNotInitializeParticipant() throws Exception {
+        Files.writeString(directory.resolve("receipt"), "partial");
+        assertThrows(IllegalStateException.class, () -> service().ready());
