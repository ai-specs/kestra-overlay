+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import io.kestra.core.models.QueryFilter;
+import io.kestra.core.repositories.AuthorizationInvocationContext;
+import io.kestra.core.utils.AuthorizationContextExecutors;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.core.propagation.PropagatedContext;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.context.ServerRequestContext;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import io.micronaut.web.router.MethodBasedRouteMatch;
+import io.micronaut.web.router.RouteAttributes;
+import org.junit.jupiter.api.Test;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class AuthorizationInvocationContextTest {
+    private record TransactionProbe() implements io.micronaut.core.propagation.PropagatedContextElement {}
+    @Test
+    @SuppressWarnings("unchecked")
+    void shouldDenyLostContextAndPropagateActualRequestWithoutPromotingItToInternal() throws Exception {
+        BeanProvider<TypedAuthorizationResolver> policies = mock(BeanProvider.class);
+        when(policies.isUnique()).thenReturn(true);
+        when(policies.get()).thenReturn((principal, operation) -> CompletableFuture.completedFuture(
+            Decision.allow(new QueryDomain(List.of("team"), List.of(), List.of(), true, false))));
+        var access = new TypedNamespaceAccessControl(new TypedAuthorizationGate(policies));
+        assertThat(access.domain(QueryFilter.Resource.FLOW).contains("other")).isFalse();
+        var request = HttpRequest.GET("/api/v1/main/flows/search");
+        request.setAttribute(SecurityFilter.AUTHENTICATION, Authentication.build("reader", List.of("reader")));
+        MethodBasedRouteMatch<?, ?> route = mock(MethodBasedRouteMatch.class);
+        when(route.getVariableValues()).thenReturn(Map.of("tenant", "main"));
+        RouteAttributes.setRouteMatch(request, route);
+        var captured = ServerRequestContext.with(request, (java.util.function.Supplier<PropagatedContext>) AuthorizationInvocationContext::captureHostInvocation);
+        try (var raw = Executors.newSingleThreadExecutor()) {
+            assertThat(raw.submit(() -> access.domain(QueryFilter.Resource.FLOW).contains("other")).get(5, TimeUnit.SECONDS)).isFalse();
+            var scope = raw.submit(captured.wrap((java.util.concurrent.Callable<QueryDomain>) () -> access.domain(QueryFilter.Resource.FLOW))).get(5, TimeUnit.SECONDS);
+            assertThat(scope.contains("team")).isTrue();
+            assertThat(scope.contains("team.child")).isFalse();
+            assertThat(scope.contains("other")).isFalse();
+        }
+        try (var pool = AuthorizationContextExecutors.host(Executors.newSingleThreadExecutor())) {
+            var future = ServerRequestContext.with(request, (java.util.function.Supplier<java.util.concurrent.Future<QueryDomain>>)
+                () -> pool.submit(() -> access.domain(QueryFilter.Resource.FLOW)));
+            assertThat(future.get(5, TimeUnit.SECONDS).contains("other")).isFalse();
+            assertThat(pool.submit(AuthorizationInvocationContext::isInternal).get(5, TimeUnit.SECONDS)).isTrue();
+            try (var ignored = PropagatedContext.getOrEmpty().plus(new TransactionProbe()).propagate()) {
+                assertThat(pool.submit(() -> PropagatedContext.getOrEmpty().find(TransactionProbe.class).isPresent()).get(5, TimeUnit.SECONDS))
+                    .isFalse();
+            }
+        }
+        var internal = PropagatedContext.getOrEmpty().plus(new AuthorizationInvocationContext(null, true));
+        try (var ignored = internal.propagate()) {
+            assertThat(access.domain(QueryFilter.Resource.FLOW).contains("other")).isTrue();
+            ServerRequestContext.with(HttpRequest.GET("/api/v1/main/flows/search"), () -> {
+                assertThat(AuthorizationInvocationContext.isInternal()).isFalse();
+                assertThat(access.domain(QueryFilter.Resource.FLOW).contains("other")).isFalse();
+            });
+        }
+        assertThat(access.domain(QueryFilter.Resource.FLOW).contains("other")).isFalse();
+        assertThatThrownBy(() -> new AuthorizationInvocationContext(null, false)).isInstanceOf(IllegalArgumentException.class);
+    }
+}
