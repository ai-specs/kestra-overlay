@@ -0,0 +1,43 @@
+package io.kestra.core.repositories;
+
+import java.util.Optional;
+import io.micronaut.core.propagation.PropagatedContext;
+import io.micronaut.core.propagation.PropagatedContextElement;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.context.ServerRequestContext;
+
+public record AuthorizationInvocationContext(HttpRequest<?> request, boolean internal) implements PropagatedContextElement {
+    public AuthorizationInvocationContext {
+        if (internal == (request != null)) throw new IllegalArgumentException("Invocation requires either an HTTP request or explicit internal origin");
+    }
+
+    public static Optional<AuthorizationInvocationContext> current() {
+        return PropagatedContext.getOrEmpty().find(AuthorizationInvocationContext.class);
+    }
+
+    public static Optional<HttpRequest<?>> currentRequest() {
+        var request = ServerRequestContext.currentRequest().orElse(null);
+        if (request != null) return Optional.of(request);
+        return current().map(AuthorizationInvocationContext::request);
+    }
+
+    public static PropagatedContext captureHostInvocation() {
+        PropagatedContext context = PropagatedContext.getOrEmpty();
+        if (current().isPresent()) return context;
+        var request = ServerRequestContext.currentRequest().orElse(null);
+        return context.plus(new AuthorizationInvocationContext(request, request == null));
+    }
+
+    public static boolean isInternal() {
+        return current().map(AuthorizationInvocationContext::internal).orElse(false) && currentRequest().isEmpty();
+    }
+
+    public static PropagatedContext captureHostTask() {
+        var origin = captureHostInvocation().find(AuthorizationInvocationContext.class).orElseThrow();
+        return PropagatedContext.empty().plus(origin);
+    }
+
+    public static PropagatedContext internalTask() {
+        return PropagatedContext.empty().plus(new AuthorizationInvocationContext(null, true));
+    }
+}
