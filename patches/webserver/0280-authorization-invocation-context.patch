+package io.kestra.core.utils;
+
+import java.util.concurrent.Callable;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.ScheduledExecutorService;
+import io.kestra.core.repositories.AuthorizationInvocationContext;
+import io.micronaut.scheduling.instrument.InstrumentedExecutorService;
+import io.micronaut.scheduling.instrument.InstrumentedScheduledExecutorService;
+
+public final class AuthorizationContextExecutors {
+    private AuthorizationContextExecutors() {}
+
+    public static ExecutorService host(ExecutorService executor) {
+        return new HostExecutor(executor);
+    }
+
+    public static ScheduledExecutorService hostScheduled(ScheduledExecutorService executor) {
+        return new HostScheduledExecutor(executor);
+    }
+
+    private record HostExecutor(ExecutorService target) implements InstrumentedExecutorService {
+        @Override
+        public ExecutorService getTarget() { return target; }
+
+        @Override
+        public Runnable instrument(Runnable task) {
+            return AuthorizationInvocationContext.captureHostTask().wrap(task);
+        }
+
+        @Override
+        public <Result> Callable<Result> instrument(Callable<Result> task) {
+            return AuthorizationInvocationContext.captureHostTask().wrap(task);
+        }
+    }
+
+    private record HostScheduledExecutor(ScheduledExecutorService target) implements InstrumentedScheduledExecutorService {
+        @Override
+        public ScheduledExecutorService getTarget() { return target; }
+
+        @Override
+        public Runnable instrument(Runnable task) {
+            return AuthorizationInvocationContext.captureHostTask().wrap(task);
+        }
+
+        @Override
+        public <Result> Callable<Result> instrument(Callable<Result> task) {
+            return AuthorizationInvocationContext.captureHostTask().wrap(task);
+        }
+    }
+}
