@@ -0,0 +1,17 @@
+package io.kestra.core.repositories;
+
+import io.micronaut.aop.InterceptorBean;
+import io.micronaut.aop.MethodInterceptor;
+import io.micronaut.aop.MethodInvocationContext;
+import jakarta.inject.Singleton;
+
+@Singleton
+@InterceptorBean(InternalInvocation.class)
+public final class InternalInvocationInterceptor implements MethodInterceptor<Object, Object> {
+    @Override
+    public Object intercept(MethodInvocationContext<Object, Object> invocation) {
+        try (var scope = AuthorizationInvocationContext.captureHostInvocation().propagate()) {
+            return invocation.proceed();
+        }
+    }
+}
