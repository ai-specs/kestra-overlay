+package io.kestra.mcp;
+
+import java.util.Arrays;
+import java.util.stream.Collectors;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+final class McpCallDiagnostic {
+    private static final Logger LOGGER = LoggerFactory.getLogger(McpCallDiagnostic.class);
+
+    private McpCallDiagnostic() {
+    }
+
+    static void record(Throwable failure) {
+        String frames = Arrays.stream(failure.getStackTrace()).limit(12)
+            .map(frame -> symbol(frame.getClassName()) + "." + symbol(frame.getMethodName()) + ":" + frame.getLineNumber())
+            .collect(Collectors.joining(","));
+        LOGGER.warn("MCP_TOOL_CALL_FAILED exception={} frames={}", symbol(failure.getClass().getName()), frames);
+    }
+
+    private static String symbol(String value) {
+        return value.length() <= 200 && value.matches("[A-Za-z0-9_.$<>]+") ? value : "redacted";
+    }
+}
