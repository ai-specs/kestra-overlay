+package io.kestra.mcp;
+
+import java.time.Duration;
+import java.util.List;
+import java.util.Map;
+import java.util.function.BiFunction;
+import ch.qos.logback.classic.Logger;
+import ch.qos.logback.classic.LoggerContext;
+import ch.qos.logback.classic.PatternLayout;
+import ch.qos.logback.classic.spi.ILoggingEvent;
+import ch.qos.logback.core.read.ListAppender;
+import io.kestra.core.models.flows.Flow;
+import io.kestra.plugin.core.trigger.McpToolTrigger;
+import io.kestra.webserver.mcp.McpCapabilityGate;
+import io.modelcontextprotocol.server.McpAsyncServerExchange;
+import io.modelcontextprotocol.spec.McpSchema;
+import org.junit.jupiter.api.Test;
+import org.slf4j.LoggerFactory;
+import reactor.core.publisher.Mono;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+class McpCallDiagnosticTest {
+    @Test
+    @SuppressWarnings("unchecked")
+    void shouldRenderSafeDiagnosticAndKeepGenericFallbackWhenCallFails() throws Exception {
+        String secret = "malicious-secret\nFORGED_LOG";
+        var failure = new IllegalStateException(secret, new RuntimeException(secret));
+        failure.addSuppressed(new RuntimeException(secret));
+        failure.setStackTrace(new StackTraceElement[]{new StackTraceElement("io.kestra.Safe", "invoke", secret, 42)});
+        var gate = mock(McpCapabilityGate.class);
+        when(gate.evaluation(any(), anyString(), any())).thenReturn(Mono.error(failure));
+        var service = new McpToolService(null, null, null, null, null,
+            new McpConfig(new McpConfig.ToolCacheConfig(10L, Duration.ofMinutes(1)), null, Duration.ofSeconds(5)),
+            null, null, null, null, gate);
+        var flow = Flow.builder().tenantId("main").namespace("test").id("controlled").tasks(List.of()).build();
+        var trigger = McpToolTrigger.builder().id("tool").toolName("tool").build();
+        var method = McpToolService.class.getDeclaredMethod("buildCallHandler", Flow.class, McpToolTrigger.class);
+        method.setAccessible(true);
+        var handler = (BiFunction<McpAsyncServerExchange, McpSchema.CallToolRequest, Mono<McpSchema.CallToolResult>>) method.invoke(service, flow, trigger);
+        var exchange = mock(McpAsyncServerExchange.class);
+        when(exchange.transportContext()).thenReturn(KestraMcpTransportContext.builder().tenantId("main").build());
+        Logger logger = (Logger) LoggerFactory.getLogger(McpCallDiagnostic.class);
+        var appender = new ListAppender<ILoggingEvent>();
+        appender.setContext(logger.getLoggerContext());
+        appender.start();
+        logger.addAppender(appender);
+        try {
+            var result = handler.apply(exchange, new McpSchema.CallToolRequest("tool", Map.of("secret", secret))).block();
+            assertThat(result.isError()).isTrue();
+            assertThat(result.content()).containsExactly(new McpSchema.TextContent("Failed to execute flow"));
+            assertThat(appender.list).hasSize(1);
+            var event = appender.list.getFirst();
+            assertThat(event.getThrowableProxy()).isNull();
+            var layout = new PatternLayout();
+            layout.setContext((LoggerContext) LoggerFactory.getILoggerFactory());
+            layout.setPattern("%level %msg%n%ex");
+            layout.start();
+            String rendered = layout.doLayout(event);
+            layout.stop();
+            assertThat(rendered).contains("MCP_TOOL_CALL_FAILED", "exception=java.lang.IllegalStateException", "io.kestra.Safe.invoke:42")
+                .doesNotContain("malicious-secret", "FORGED_LOG", "Caused by", "Suppressed");
+        } finally {
+            logger.detachAppender(appender);
+            appender.stop();
+        }
+    }
+}
