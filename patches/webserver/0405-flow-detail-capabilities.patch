+const task = await taskSpace(browserSpace ?? "0404b native Flow detail test transport")
+const nativePage=task.page("p1")
+await nativePage.goto("about:blank")
+await nativePage.cdp("Page.stopLoading")
+await nativePage.cdp("egoAutomated.disable")
+await nativePage.events()
