+import {afterEach, beforeEach, describe, expect, it, vi} from "vitest"
+import {createApp, nextTick, reactive} from "vue"
+const mocks = vi.hoisted(() => ({post: vi.fn(), route: undefined as any, misc: undefined as any, auth: undefined as any}))
+vi.mock("@kestra-io/kestra-sdk", () => ({useClient: () => ({post: mocks.post})}))
+vi.mock("override/utils/route", () => ({apiUrl: () => "/api/v1/main"}))
+vi.mock("vue-router", () => ({useRoute: () => mocks.route}))
+vi.mock("override/stores/misc", () => ({useMiscStore: () => mocks.misc}))
+vi.mock("override/stores/auth", () => ({useAuthStore: () => mocks.auth}))
+import {DETAIL_CAPABILITIES, DEFAULT_FLOW_CHARTS, provideFlowDetailProjection} from "./useFlowDetailCapabilities"
+const reply = (available: string[] = []) => ({data: {formatVersion: 2, results: [{tenant: "main", namespace: "company.sub", flowId: "one", capabilities: Object.fromEntries(DETAIL_CAPABILITIES.map(c => [c, available.includes(c) ? "AVAILABLE" : "UNAVAILABLE"]))}]}})
+let app: ReturnType<typeof createApp> | undefined
+const mount = () => {let projection!: ReturnType<typeof provideFlowDetailProjection>; app = createApp({setup() {projection = provideFlowDetailProjection(); return () => null}}); app.mount(document.createElement("div")); return projection}
+const settle = async () => {await Promise.resolve(); await nextTick(); await Promise.resolve()}
+beforeEach(() => {mocks.route = reactive({params: {tenant: "main", namespace: "company.sub", id: "one"}}); mocks.misc = reactive({configs: {flowExecutionCapabilitiesRequired: true as boolean | undefined}}); mocks.auth = reactive({user: {}, isLogged: true}); mocks.post.mockReset().mockResolvedValue(reply())})
+afterEach(() => {app?.unmount(); app = undefined; vi.useRealTimers(); vi.restoreAllMocks()})
+describe("finite native Flow detail projection", () => {
+    it("keeps description available while every runtime datasource is denied", async () => {mocks.post.mockResolvedValue(reply(["FLOW_DESCRIPTION_READ"])); const p = mount(); await settle(); expect(p.chartState({id: "description", source: {type: "FlowDescription", namespace: "company.sub", flowId: "one"}} as any)).toBe("available"); expect(p.state("EXECUTION_STATISTICS_READ")).toBe("unavailable"); expect(mocks.post.mock.calls[0][1].formatVersion).toBe(2); expect(mocks.post.mock.calls[0][1].targets[0].capabilities).toHaveLength(9)})
