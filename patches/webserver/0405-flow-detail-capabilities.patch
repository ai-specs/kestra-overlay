diff --git a/ui/tests/flow-detail-capabilities/check-report.mjs b/ui/tests/flow-detail-capabilities/check-report.mjs
new file mode 100644
index 0000000..18c3520
--- /dev/null
+++ b/ui/tests/flow-detail-capabilities/check-report.mjs
@@ -0,0 +1,46 @@
+import fs from "node:fs"
+import crypto from "node:crypto"
+import {fileURLToPath} from "node:url"
+import {CASE_NAMES, SOURCE_PATHS} from "./cases.mjs"
+import {classifyDiagnostics} from "./diagnostics.mjs"
+const errorKinds = new Set(["console-error", "page-error", "http-error", "request-failed", "diagnostic-integrity-error"])
+const timestamp = value => typeof value === "string" && Number.isFinite(Date.parse(value))
+export function validateReport(report) {
+    if (report.transport !== "explicit-test-transport" || report.completed !== true || report.passedGate !== true || report.inputsRechecked !== true
+        || report.passed !== CASE_NAMES.length || report.notRun !== 0 || !timestamp(report.startedAt) || !timestamp(report.finishedAt)
+        || !Array.isArray(report.cases) || JSON.stringify(report.cases.map(c => c.name)) !== JSON.stringify(CASE_NAMES)) throw new Error("Exact shared native detail matrix is incomplete")
+    const events = report.diagnostics?.events, documents = report.diagnostics?.documents
+    if (!Array.isArray(events) || !Array.isArray(documents)) throw new Error("Missing diagnostic events/documents")
+    const knownDocuments = new Set(documents.map(d => d.id)), byId = new Map()
+    for (const event of events) {
+        if (typeof event.id !== "string" || !event.id || byId.has(event.id)) throw new Error("Missing or duplicate global diagnostic event ID")
+        byId.set(event.id, event)
+    }
+    const covered = new Set()
+    for (const c of report.cases) {
+        if (c.status !== "passed" || !c.network || !c.dom || !timestamp(c.startedAt) || !timestamp(c.finishedAt) || Date.parse(c.finishedAt) < Date.parse(c.startedAt)
+            || typeof c.documentId !== "string" || !c.documentId || !knownDocuments.has(c.documentId) || !Array.isArray(c.eventIds) || !c.diagnostics || c.diagnostics.unexpected?.length !== 0)
+            throw new Error(`Missing complete case/source evidence: ${c.name}`)
+        let position = -1
+        for (const id of c.eventIds) {
+            if (!byId.has(id) || covered.has(id)) throw new Error("Invented or multiply assigned case event ID")
+            const next = events.indexOf(byId.get(id))
+            if (next <= position) throw new Error("Case events are duplicated or out of order")
+            position = next; covered.add(id)
+        }
+        const ids = new Set(c.eventIds), prior = new Set(events.filter(e => !ids.has(e.id)).map(e => e.id))
+        if (JSON.stringify(classifyDiagnostics(report.diagnostics, c.name, c.documentId, prior)) !== JSON.stringify(c.diagnostics)) throw new Error("Diagnostic classification changed")
+        if (c.name.startsWith("visual-") && (!c.visual || !c.visual.surface || c.visual.background !== c.visual.surface || c.visual.border !== c.visual.borderToken)) throw new Error("Missing native computed-style evidence")
+    }
+    if (events.some(e => errorKinds.has(e.kind) && !covered.has(e.id))) throw new Error("Uncovered browser diagnostic")
+    const keys = [...SOURCE_PATHS, "overlay:sdk-browser-diagnostics.cjs"]
+    if (JSON.stringify(Object.keys(report.inputs ?? {})) !== JSON.stringify(keys) || keys.some(k => !/^[a-f0-9]{64}$/.test(report.inputs[k]))) throw new Error("Missing exact public source input inventory")
+    return {tests: CASE_NAMES.length, passed: report.passed, failed: 0, skipped: 0, notRun: 0}
+}
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+    const report = JSON.parse(fs.readFileSync(process.argv[2], "utf8"))
+    const result = validateReport(report)
+    for (const p of SOURCE_PATHS) if (report.inputs[p] !== crypto.createHash("sha256").update(fs.readFileSync(new URL(p, import.meta.url))).digest("hex")) throw new Error(`Source changed: ${p}`)
+    if (!process.argv[3] || report.inputs["overlay:sdk-browser-diagnostics.cjs"] !== crypto.createHash("sha256").update(fs.readFileSync(process.argv[3])).digest("hex")) throw new Error("Collector changed")
+    console.log(JSON.stringify(result))
+}
