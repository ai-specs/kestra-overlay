index 0000000..5ce1a37
--- /dev/null
+++ b/ui/src/components/flows/useFlowDetailCapabilities.ts
@@ -0,0 +1,102 @@
+import {computed, inject, onBeforeUnmount, onMounted, provide, ref, watch, type InjectionKey} from "vue"
+import {useRoute} from "vue-router"
+import {useClient} from "@kestra-io/kestra-sdk"
+import {apiUrl} from "override/utils/route"
+import {useMiscStore} from "override/stores/misc"
+import {useAuthStore} from "override/stores/auth"
+import chartHashes from "./defaultFlowChartHashes.json"
+import type {Chart} from "../dashboard/types"
+
+export const DETAIL_CAPABILITIES = ["EXECUTION_STATISTICS_READ", "LATEST_EXECUTIONS_LIST", "FLOW_DESCRIPTION_READ", "LOG_STATISTICS_READ", "TRIGGER_STATISTICS_READ", "FLOW_EXECUTIONS_LIST", "FLOW_LOGS_LIST", "FLOW_TRIGGERS_LIST", "FLOW_METRICS_READ"] as const
+export type DetailCapability = typeof DETAIL_CAPABILITIES[number]
+export type DetailState = "available" | "unavailable" | "loading" | "error" | "unsupported"
+export const DEFAULT_FLOW_CHARTS: Record<string, {type: string; capability: DetailCapability}> = {
+    kpi_success_ratio: {type: "ExecutionsKPI", capability: "EXECUTION_STATISTICS_READ"},
+    kpi_failed_ratio: {type: "ExecutionsKPI", capability: "EXECUTION_STATISTICS_READ"},
+    kpi_in_progress: {type: "ExecutionsKPI", capability: "EXECUTION_STATISTICS_READ"},
+    kpi_pending: {type: "ExecutionsKPI", capability: "EXECUTION_STATISTICS_READ"},
+    description: {type: "FlowDescription", capability: "FLOW_DESCRIPTION_READ"},
+    total_executions_pie: {type: "Executions", capability: "EXECUTION_STATISTICS_READ"},
+    total_executions_timeseries: {type: "Executions", capability: "EXECUTION_STATISTICS_READ"},
+    recent_executions: {type: "Executions", capability: "EXECUTION_STATISTICS_READ"},
+    next_executions: {type: "Triggers", capability: "TRIGGER_STATISTICS_READ"},
+    logs_timeseries: {type: "Logs", capability: "LOG_STATISTICS_READ"},
+}
+export interface FlowDetailProjection {
+    state(capability: DetailCapability): DetailState;
+    chartState(chart: Chart): DetailState;
+    verifyChart(chart: Chart): Promise<boolean>;
+    refresh(): Promise<void>;
+    modeA: Readonly<{value: boolean}>;
+}
+const key: InjectionKey<FlowDetailProjection> = Symbol("finite-flow-detail-projection")
+export const useOptionalFlowDetailProjection = () => inject(key, undefined)
+
+/** Local projection only; actual APIs continue authorizing every operation. */
+export function provideFlowDetailProjection() {
+    const route = useRoute(), misc = useMiscStore(), auth = useAuthStore(), client = useClient()
+    const states = ref<Partial<Record<DetailCapability, DetailState>>>({}), error = ref(false)
+    const modeA = computed(() => misc.configs?.flowExecutionCapabilitiesRequired === false)
+    let loadedAt = 0, pending = false
+    let generation = 0, controller: AbortController | undefined, timer: ReturnType<typeof setTimeout> | undefined
+    const target = () => JSON.stringify([route.params.tenant ?? "main", route.params.namespace, route.params.id])
+    const invalidate = () => {generation++; controller?.abort(); clearTimeout(timer); states.value = {}; error.value = false; loadedAt = 0; pending = false}
+    const state = (capability: DetailCapability): DetailState => modeA.value ? "available" : error.value ? "error" : states.value[capability] ?? "loading"
+    const refresh = async () => {
+        invalidate()
+        if (modeA.value) return
+        const current = generation, currentTarget = target()
+        if (misc.configs?.flowExecutionCapabilitiesRequired !== true) {error.value = true; return}
+        controller = new AbortController()
+        pending = true
+        try {
+            const tenant = String(route.params.tenant ?? "main"), namespace = String(route.params.namespace), flowId = String(route.params.id)
+            const response = await client.post(`${apiUrl()}/ui/flows/execution-capabilities`, {
+                formatVersion: 2, targets: [{tenant, namespace, flowId, capabilities: DETAIL_CAPABILITIES}],
+            }, {signal: controller.signal})
+            if (generation !== current || target() !== currentTarget) return
+            const body = response.data, result = body?.results?.[0]
+            if (body?.formatVersion !== 2 || body.results?.length !== 1 || result?.tenant !== tenant || result?.namespace !== namespace || result?.flowId !== flowId
+                || Object.keys(result?.capabilities ?? {}).length !== DETAIL_CAPABILITIES.length
+                || DETAIL_CAPABILITIES.some(capability => !["AVAILABLE", "UNAVAILABLE"].includes(result.capabilities[capability]))) throw new Error("Invalid Flow detail capability response")
+            loadedAt = Date.now()
+            states.value = Object.fromEntries(DETAIL_CAPABILITIES.map(capability => [capability, result.capabilities[capability] === "AVAILABLE" ? "available" : "unavailable"]))
+        } catch (_failure) {
+            if (generation !== current || target() !== currentTarget) return
+            states.value = {}; error.value = true; loadedAt = Date.now()
+            // The local error surface remains distinct from an authorization denial.
+        } finally {
+            if (generation === current) {
+                pending = false
+                if (!modeA.value) timer = setTimeout(() => {if (document.visibilityState === "visible") void refresh(); else invalidate()}, 30_000)
+            }
+        }
+    }
+    const chartState = (chart: Chart): DetailState => {
+        if (modeA.value) return "available"
+        if (chart.id === "description" && (chart.source?.namespace !== route.params.namespace || chart.source?.flowId !== route.params.id)) return "unsupported"
+        const expected = DEFAULT_FLOW_CHARTS[chart.id ?? ""], type = chart.source?.type ?? chart.data?.type
+        if (!expected || type !== (expected.type === "FlowDescription" ? "FlowDescription" : `io.kestra.plugin.core.dashboard.data.${expected.type}`)) return "unsupported"
+        return state(expected.capability)
+    }
+    const canonical = (value: any): any => value && typeof value === "object"
+        ? Array.isArray(value) ? value.map(canonical) : Object.fromEntries(Object.keys(value).sort().map(k => [k, canonical(value[k])])) : value
+    const verifyChart = async (chart: Chart) => {
+        const {content: _content, ...definition} = chart
+        if (chart.id === "description") {
+            if (chart.source?.namespace !== route.params.namespace || chart.source?.flowId !== route.params.id) return false
+            definition.source = {...chart.source, namespace: "--NAMESPACE--", flowId: "--FLOW--"}
+        }
+        const hash = [...new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(JSON.stringify(canonical(definition)))))].map(x => x.toString(16).padStart(2, "0")).join("")
+        return hash === (chartHashes as Record<string, string>)[chart.id ?? ""]
+    }
+    const projection: FlowDetailProjection = {state, chartState, verifyChart, refresh, modeA}
+    provide(key, projection)
+    watch(() => [target(), misc.configs?.flowExecutionCapabilitiesRequired, auth.user, auth.isLogged], () => {void refresh()}, {immediate: true, flush: "sync"})
+    // A fresh projection survives brief visibility changes; the existing timer still expires it while hidden.
+    const visible = () => {if (document.visibilityState === "visible" && !pending && (!loadedAt || Date.now() - loadedAt >= 30_000)) void refresh()}
+    const focus = visible
+    onMounted(() => {document.addEventListener("visibilitychange", visible); window.addEventListener("focus", focus)})
+    onBeforeUnmount(() => {invalidate(); document.removeEventListener("visibilitychange", visible); window.removeEventListener("focus", focus)})
+    return projection
+}
