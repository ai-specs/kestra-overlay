@@ -0,0 +1,20 @@
+export function classifyDiagnostics(snapshot, caseName, currentDocument, previousIds = new Set()) {
+    const expected = [], unexpected = [], events = snapshot.events
+    const capability = "http://127.0.0.1:5189/api/v1/main/ui/flows/execution-capabilities"
+    for (const event of events.filter(e => !previousIds.has(e.id) && ["console-error", "page-error", "http-error", "request-failed", "diagnostic-integrity-error"].includes(e.kind))) {
+        const requestId = event.requestId ?? event.networkRequestId
+        const request = events.find(e => e.kind === "request" && e.requestId === requestId && e.documentId === currentDocument && e.url === capability)
+        const own = event.documentId === currentDocument && event.url === capability && request && events.indexOf(request) < events.indexOf(event)
+        let reason = null
+        if (caseName === "provider503-is-visible-and-does-not-mount-data" && own) {
+            if (event.kind === "http-error" && event.status === 503) reason = "exact current-document capability 503 after its request"
+            const response = events.find(e => e.kind === "http-error" && e.requestId === requestId && e.documentId === currentDocument && e.url === capability && e.status === 503
+                && events.indexOf(request) < events.indexOf(e) && events.indexOf(e) < events.indexOf(event))
+            if (event.kind === "console-error" && event.source === "network" && response) reason = "network console after the same current-document capability 503"
+        }
+        if (caseName === "identity-switch-cancels-stale-projection" && own && event.kind === "request-failed" && event.canceled === true && event.error === "net::ERR_ABORTED")
+            reason = "exact pending capability canceled by test identity switch"
+        ;(reason ? expected : unexpected).push({...event, ...(reason ? {expectedReason: reason} : {})})
+    }
+    return {expected, unexpected}
+}
