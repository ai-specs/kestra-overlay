+    const projection = provideFlowDetailProjection()
+    const capabilities: Partial<Record<typeof props.tab, DetailCapability>> = {executions: "FLOW_EXECUTIONS_LIST", logs: "FLOW_LOGS_LIST", triggers: "FLOW_TRIGGERS_LIST", metrics: "FLOW_METRICS_READ"}
+    const components = {
+        executions: defineAsyncComponent(() => import("./FlowExecutions.vue")),
+        logs: defineAsyncComponent(() => import("../logs/LogsWrapper.vue")),
+        triggers: defineAsyncComponent(() => import("./FlowTriggers.vue")),
+        metrics: defineAsyncComponent(() => import("./FlowMetrics.vue")),
+        concurrency: defineAsyncComponent(() => import("./FlowConcurrency.vue")),
+    }
+    const tabState = computed(() => projection.modeA.value ? "available" : props.tab === "concurrency" ? "unsupported" : projection.state(capabilities[props.tab]!))
+</script>
