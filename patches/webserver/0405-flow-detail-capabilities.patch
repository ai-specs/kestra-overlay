+    it("keeps configuration and protocol failures distinct from denied", async () => {mocks.misc.configs.flowExecutionCapabilitiesRequired = undefined; const p = mount(); await settle(); expect(p.state("FLOW_DESCRIPTION_READ")).toBe("error"); expect(mocks.post).not.toHaveBeenCalled(); mocks.post.mockResolvedValue({data: {formatVersion: 1, results: []}}); mocks.misc.configs.flowExecutionCapabilitiesRequired = true; await settle(); expect(p.state("FLOW_DESCRIPTION_READ")).toBe("error")})
+    it("mode A does not request capabilities and preserves all native charts", async () => {mocks.misc.configs.flowExecutionCapabilitiesRequired = false; const p = mount(); await settle(); expect(mocks.post).not.toHaveBeenCalled(); expect(p.chartState({id: "oss-custom"} as any)).toBe("available"); expect(p.state("FLOW_METRICS_READ")).toBe("available")})
+    it("does not unmount current permission on fresh focus or duplicate a pending request", async () => {
