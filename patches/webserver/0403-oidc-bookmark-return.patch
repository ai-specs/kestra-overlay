@@ -0,0 +1,79 @@
+package io.kestra.webserver.oidc;
+
+import io.kestra.webserver.oidc.controllers.OidcAuthorizationExceptionHandler;
+import io.kestra.webserver.oidc.services.OidcPriorToLoginPersistence;
+import io.micronaut.context.ApplicationContext;
+import io.micronaut.http.*;
+import io.micronaut.http.simple.SimpleHttpRequestFactory;
+import io.micronaut.security.errors.PriorToLoginPersistence;
+import io.micronaut.security.oauth2.endpoint.token.response.IdTokenLoginHandler;
+import io.micronaut.security.authentication.*;
+import org.junit.jupiter.api.Test;
+import java.util.Map;
+import static org.junit.jupiter.api.Assertions.*;
+
+class OidcBookmarkContextTest {
+    private ApplicationContext context(boolean enabled) {
+        var builder = ApplicationContext.builder().packages("io.micronaut.security", "io.kestra.webserver.oidc").deduceEnvironment(false)
+            .enableDefaultPropertySources(false)
+            .properties(Map.of("kestra.server-type", "WEBSERVER", "kestra.oidc.enabled", "true", "micronaut.security.enabled", "true",
+                "micronaut.security.authentication", "idtoken", "micronaut.security.redirect.enabled", "true",
+                "micronaut.security.redirect.prior-to-login", enabled,
+                "micronaut.security.redirect.login-success", "/ui/",
+                "micronaut.security.redirect.unauthorized.url", "/oauth/login/kestra"));
+        // Isolate only application beans; framework bean discovery, conditions, replacement,
+        // injection and the real ID-token handler remain active. No repository or PG beans.
+        var context = new io.micronaut.context.DefaultApplicationContext(
+            (io.micronaut.context.ApplicationContextConfiguration) builder) {
+            @Override
+            protected java.util.List<io.micronaut.inject.BeanDefinitionReference> resolveBeanDefinitionReferences() {
+                return super.resolveBeanDefinitionReferences().stream().filter(reference -> {
+                    String name = reference.getBeanDefinitionName();
+                    return !name.startsWith("io.kestra.")
+                        || name.contains("$OidcAuthorizationExceptionHandler$")
+                        || name.contains("$OidcPriorToLoginPersistence$");
+                }).toList();
+            }
+        };
+        context.getEnvironment().addPropertySource(io.micronaut.context.env.PropertySource.of("bookmark-test", Map.of(
+            "kestra.oidc.enabled", true, "micronaut.security.enabled", true,
+            "micronaut.security.authentication", "idtoken", "micronaut.security.redirect.enabled", true,
+            "micronaut.security.redirect.prior-to-login", enabled,
+            "micronaut.security.redirect.login-success", "/ui/",
+            "micronaut.security.redirect.unauthorized.url", "/oauth/login/kestra")));
+        return context.start();
+    }
+    @Test void enabledContextInjectsUniquePersistenceAndLoginHandlerConsumesCookie() {
+        try (var context = context(true)) {
+            var persistence = context.getBeansOfType(PriorToLoginPersistence.class);
+            assertEquals(1, persistence.size());
+            assertInstanceOf(OidcPriorToLoginPersistence.class, persistence.iterator().next());
+            var handler = context.getBean(OidcAuthorizationExceptionHandler.class);
+            var request = new SimpleHttpRequestFactory().get("/ui/main/flows?q=a%20b").accept(MediaType.TEXT_HTML);
+            var response = handler.handle(request, new AuthorizationException(null));
+            var cookie = response.getCookies().get("ORIGINAL_URI");
+            assertNotNull(cookie);
+            var login = context.getBean(IdTokenLoginHandler.class);
+            // Production handler parses the ID token from Authentication attributes.
+            var auth = Authentication.build("user", Map.of("openIdToken", new com.nimbusds.jwt.PlainJWT(new com.nimbusds.jwt.JWTClaimsSet.Builder().subject("user").expirationTime(java.util.Date.from(java.time.Instant.now().plusSeconds(300))).build()).serialize()));
+            var callback = new SimpleHttpRequestFactory().get("/oauth/callback/kestra").cookie(cookie);
+            var success = login.loginSuccess(auth, callback);
+            assertEquals("/ui/main/flows?q=a%20b", success.getHeaders().get("Location"));
+            assertEquals(0, success.getCookies().get("ORIGINAL_URI").getMaxAge());
+            var fallback = login.loginSuccess(auth, new SimpleHttpRequestFactory().get("/oauth/callback/kestra"));
+            assertEquals("/ui/", fallback.getHeaders().get("Location"));
+        }
+    }
+    @Test void disabledContextKeepsDefaultWithoutSavingBookmark() {
+        try (var context = context(false)) {
+            assertTrue(context.getBeansOfType(PriorToLoginPersistence.class).isEmpty());
+            var response = context.getBean(OidcAuthorizationExceptionHandler.class).handle(
+                new SimpleHttpRequestFactory().get("/ui/main/flows").accept(MediaType.TEXT_HTML), new AuthorizationException(null));
+            assertNull(response.getCookies().get("ORIGINAL_URI"));
+            var success = context.getBean(IdTokenLoginHandler.class).loginSuccess(
+                Authentication.build("user", Map.of("openIdToken", new com.nimbusds.jwt.PlainJWT(new com.nimbusds.jwt.JWTClaimsSet.Builder().subject("user").expirationTime(java.util.Date.from(java.time.Instant.now().plusSeconds(300))).build()).serialize())),
+                new SimpleHttpRequestFactory().get("/oauth/callback/kestra"));
+            assertEquals("/ui/", success.getHeaders().get("Location"));
+        }
+    }
+}
