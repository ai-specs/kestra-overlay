@@ -0,0 +1,65 @@
+package io.kestra.webserver.oidc.services;
+
+import java.net.URI;
+import java.util.Locale;
+import java.util.Optional;
+import io.micronaut.context.annotation.Replaces;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.core.annotation.Nullable;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.MutableHttpResponse;
+import io.micronaut.security.config.TokenCookieConfiguration;
+import io.micronaut.security.errors.CookiePriorToLoginPersistence;
+import jakarta.inject.Singleton;
+
+/** Framework cookie lifecycle with same-origin validation at both trust boundaries. */
+@Singleton
+@Requires(property = "kestra.oidc.enabled", value = "true")
+@Requires(property = "micronaut.security.redirect.prior-to-login", value = "true")
+@Replaces(CookiePriorToLoginPersistence.class)
+public class OidcPriorToLoginPersistence extends CookiePriorToLoginPersistence {
+    public OidcPriorToLoginPersistence(@Nullable TokenCookieConfiguration configuration) {
+        super(configuration);
+    }
+
+    public static boolean safe(URI uri) {
+        if (uri == null || uri.isAbsolute() || uri.getRawAuthority() != null || uri.getRawFragment() != null
+            || uri.toString().length() > 2048) return false;
+        String path = uri.getRawPath();
+        if (path == null || !path.startsWith("/") || path.startsWith("//")) return false;
+        // Only the host business UI is a document return target. Auth/static/API routes
+        // are never bookmarks, even if a caller sends Accept: text/html.
+        if (!path.startsWith("/ui/") || path.equals("/ui/access-denied")) return false;
+        String lower = path.toLowerCase(Locale.ROOT);
+        if (path.contains("//")) return false;
+        String decodedPath = uri.getPath().toLowerCase(Locale.ROOT);
+        for (String excluded : new String[]{"/ui/assets", "/ui/login", "/ui/setup", "/ui/access-denied", "/ui/oauth", "/ui/oidc"}) {
+            if (decodedPath.equals(excluded) || decodedPath.startsWith(excluded + "/")) return false;
+        }
+        if (lower.contains("%2f") || lower.contains("%5c") || lower.contains("%25")) return false;
+        for (String segment : uri.getPath().split("/", -1)) {
+            if (segment.equals(".") || segment.equals("..")) return false;
+        }
+        String decoded = uri.getPath();
+        if (uri.getQuery() != null) decoded += uri.getQuery();
+        return decoded.chars().noneMatch(c -> c < 32 || c == 127 || c == '\\');
+    }
+
+    @Override
+    public void onUnauthorized(HttpRequest<?> request, MutableHttpResponse<?> response) {
+        if (safe(request.getUri())) super.onUnauthorized(request, response);
+    }
+
+    @Override
+    public Optional<URI> getOriginalUri(HttpRequest<?> request, MutableHttpResponse<?> response) {
+        // Consume even malformed cookies; framework only clears values it can parse as URI.
+        clear(request, response);
+        return super.getOriginalUri(request, response).filter(OidcPriorToLoginPersistence::safe);
+    }
+
+    public void clear(HttpRequest<?> request, MutableHttpResponse<?> response) {
+        var cookie = io.micronaut.http.cookie.Cookie.of("ORIGINAL_URI", "");
+        configure(cookie, request);
+        response.cookie(cookie.maxAge(0));
+    }
+}
