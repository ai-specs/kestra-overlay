@@ -0,0 +1,62 @@
+package io.kestra.webserver.oidc;
+
+import io.kestra.webserver.oidc.controllers.OidcAuthorizationExceptionHandler;
+import io.kestra.webserver.oidc.services.OidcPriorToLoginPersistence;
+import io.micronaut.http.*;
+import io.micronaut.http.cookie.Cookie;
+import io.micronaut.security.authentication.AuthorizationException;
+import java.net.URI;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class OidcBookmarkReturnTest {
+    @Test void targetValidation() {
+        for (String value : new String[]{"/ui/main/flows", "/ui/main/flows?q=a%20b&next=https%3A%2F%2Fexample.org", "/ui/%E4%B8%AD?x=%252f"})
+            assertTrue(OidcPriorToLoginPersistence.safe(URI.create(value)), value);
+        for (String value : new String[]{"https://evil.test/", "//evil.test/", "/%2f%2fevil", "/%5cevil", "/%252fevil", "/a/../b", "/a/%2e%2e/b", "/ui/assets/foo.js", "/ui/login", "/ui/setup", "/ui/access-denied/", "/ui//main/flows", "/ui/%61ssets/x", "/ui/%2F%2fevil", "/ui/%255Cevil", "/oidc/logout", "/assets/app.js", "/api/v1/main/flows", "/unknown", "/ui/#evil", "/ui/?q=%0d%0aLocation:evil"})
+            assertFalse(OidcPriorToLoginPersistence.safe(URI.create(value)), value);
+    }
+    @Test void frameworkCookieRoundTripAndConsumption() {
+        var persistence = new OidcPriorToLoginPersistence(null);
+        var original = new io.micronaut.http.simple.SimpleHttpRequestFactory().get("/ui/main/flows?q=a%20b&x=%252f");
+        var response = HttpResponse.ok();
+        persistence.onUnauthorized(original, response);
+        var cookie = response.getCookies().get("ORIGINAL_URI");
+        assertNotNull(cookie);
+        assertTrue(cookie.isHttpOnly());
+        assertEquals(300, cookie.getMaxAge());
+        var callback = new io.micronaut.http.simple.SimpleHttpRequestFactory().get("/oauth/callback/kestra").cookie(cookie);
+        var redirect = HttpResponse.ok();
+        assertEquals(original.getUri(), persistence.getOriginalUri(callback, redirect).orElseThrow());
+        assertEquals(0, redirect.getCookies().get("ORIGINAL_URI").getMaxAge());
+    }
+    @Test void tamperedCookiesAreCleared() {
+        var persistence = new OidcPriorToLoginPersistence(null);
+        for (String value : new String[]{"https://evil.test/", "//evil.test/", "/%2fevil", "invalid uri"}) {
+            var response = HttpResponse.ok();
+            assertTrue(persistence.getOriginalUri(new io.micronaut.http.simple.SimpleHttpRequestFactory().get("/cb").cookie(Cookie.of("ORIGINAL_URI", value)), response).isEmpty());
+            assertEquals(0, response.getCookies().get("ORIGINAL_URI").getMaxAge());
+        }
+    }
+    @Test void handlerOnlySavesAnonymousDocumentGet() throws Exception {
+        var handler = new OidcAuthorizationExceptionHandler("/oauth/login/kestra");
+        var field = handler.getClass().getDeclaredField("priorToLoginPersistence"); field.setAccessible(true);
+        field.set(handler, new OidcPriorToLoginPersistence(null));
+        var response = handler.handle(new io.micronaut.http.simple.SimpleHttpRequestFactory().get("/ui/main/flows").accept(MediaType.TEXT_HTML), new AuthorizationException(null));
+        assertNotNull(response.getCookies().get("ORIGINAL_URI"));
+        for (HttpRequest<?> request : new HttpRequest<?>[]{HttpRequest.POST("/ui/main/flows", "").accept(MediaType.TEXT_HTML), new io.micronaut.http.simple.SimpleHttpRequestFactory().get("/api/v1/main/flows").accept(MediaType.TEXT_HTML), new io.micronaut.http.simple.SimpleHttpRequestFactory().get("/ui/main/flows").accept(MediaType.APPLICATION_JSON)})
+            assertNull(handler.handle(request, new AuthorizationException(null)).getCookies().get("ORIGINAL_URI"));
+        assertNull(handler.handle(new io.micronaut.http.simple.SimpleHttpRequestFactory().get("/ui/main/flows").accept(MediaType.TEXT_HTML), new AuthorizationException(io.micronaut.security.authentication.Authentication.build("user"))).getCookies().get("ORIGINAL_URI"));
+    }
+    @Test void noBookmarkAndDisabledHandlerKeepDefault() {
+        assertTrue(new OidcPriorToLoginPersistence(null).getOriginalUri(new io.micronaut.http.simple.SimpleHttpRequestFactory().get("/cb"), HttpResponse.ok()).isEmpty());
+        var response = new OidcAuthorizationExceptionHandler("/oauth/login/kestra").handle(new io.micronaut.http.simple.SimpleHttpRequestFactory().get("/ui/main/flows").accept(MediaType.TEXT_HTML), new AuthorizationException(null));
+        assertNull(response.getCookies().get("ORIGINAL_URI"));
+    }
+    @Test void logoutClearsWithSameCookieConfiguration() {
+        var response = HttpResponse.ok();
+        new OidcPriorToLoginPersistence(null).clear(new io.micronaut.http.simple.SimpleHttpRequestFactory().get("https://host/oidc/logout"), response);
+        var cookie = response.getCookies().get("ORIGINAL_URI");
+        assertEquals(0, cookie.getMaxAge()); assertEquals("/", cookie.getPath()); assertTrue(cookie.isSecure());
+    }
+}
