+package io.kestra.webserver.oidc.controllers;
+
+import io.kestra.webserver.oidc.services.OidcPriorToLoginPersistence;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.MutableHttpResponse;
+import io.micronaut.http.annotation.ResponseFilter;
+import io.micronaut.http.annotation.ServerFilter;
+
+/** Clear the return cookie after the existing logout chain, without changing session revocation. */
+@ServerFilter("/oidc/logout")
+@Requires(property = "kestra.oidc.enabled", value = "true")
+@Requires(property = "micronaut.security.redirect.prior-to-login", value = "true")
+public class OidcBookmarkLogoutFilter {
+    private final OidcPriorToLoginPersistence persistence;
+    public OidcBookmarkLogoutFilter(OidcPriorToLoginPersistence persistence) {
+        this.persistence = persistence;
+    }
+    @ResponseFilter
+    public void clear(HttpRequest<?> request, MutableHttpResponse<?> response) {
+        persistence.clear(request, response);
+    }
+}
diff --git a/webserver/src/main/java/io/kestra/webserver/oidc/services/OidcPriorToLoginPersistence.java b/webserver/src/main/java/io/kestra/webserver/oidc/services/OidcPriorToLoginPersistence.java
