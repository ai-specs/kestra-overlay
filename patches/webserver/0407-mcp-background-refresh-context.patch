+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.Mockito.*;
+
+@KestraTest(environments = "h2")
+class McpBackgroundRefreshContextTest {
+    record JdbcMarker(String value) implements PropagatedContextElement {}
+
+    @Inject ConnectionOperations<Connection> connections;
+    @Inject ApplicationContext applicationContext;
+
+    @Test
+    void modeABackgroundRefreshDoesNotInheritCallerConnectionOrAuthorization() {
+        assertIsolation(false);
+    }
+
+    @Test
+    void modeBBackgroundRefreshDoesNotInheritCallerConnectionOrAuthorization() {
+        assertIsolation(true);
+    }
+
+    private void assertIsolation(boolean enabled) {
+        try (var fixture = new RefreshFixture(enabled)) {
+            var original = new AtomicReference<Connection>();
+            fixture.read = () -> {
+                assertClean();
+                assertThat(Thread.currentThread().getName()).startsWith("boundedElastic-");
+                connections.executeRead(status -> {
+                    assertThat(status.getConnection()).isNotSameAs(original.get());
+                    assertThat(readOne(status.getConnection())).isEqualTo(1);
+                    return null;
+                });
+                return List.of();
+            };
+            connections.executeRead(status -> {
+                original.set(status.getConnection());
+                try (var ignored = caller("queue").propagate()) {
+                    fixture.transport.refreshTools("main", "default").block(Duration.ofSeconds(10));
+                    assertThat(connections.getConnectionStatus().getConnection()).isSameAs(original.get());
+                    assertThat(PropagatedContext.getOrEmpty().find(JdbcMarker.class)).isPresent();
+                }
+                return null;
+            });
+            verify(fixture.service).listToolSpecsForServer(eq("main"), eq("default"), any());
+        }
+    }
+
+    @Test
+    void refreshReadsAfterCallerConnectionClosesAndSubscriptionOccursElsewhere() {
+        try (var fixture = new RefreshFixture(false)) {
+            var original = new AtomicReference<Connection>();
+            var operation = connections.executeRead(status -> {
+                original.set(status.getConnection());
+                try (var ignored = caller("assembly").propagate()) {
+                    return fixture.transport.refreshTools("main", "default");
+                }
+            });
+            assertThat(original.get()).satisfies(connection -> {
+                try { assertThat(connection.isClosed()).isTrue(); }
+                catch (java.sql.SQLException exception) { throw new IllegalStateException(exception); }
+            });
+            fixture.read = () -> {
+                assertClean();
+                return connections.executeRead(status -> {
+                    assertThat(status.getConnection()).isNotSameAs(original.get());
+                    assertThat(readOne(status.getConnection())).isEqualTo(1);
+                    return List.of();
+                });
+            };
+            try (var ignored = caller("subscription").propagate()) {
+                operation.block(Duration.ofSeconds(10));
+            }
+        }
+    }
+
+    @Test
+    void concurrentCallerConnectionsRemainSeparateFromBackgroundReads() throws Exception {
+        try (var fixture = new RefreshFixture(true); var executor = Executors.newFixedThreadPool(2)) {
+            var entered = new CountDownLatch(2);
+            var release = new CountDownLatch(1);
+            var originals = new java.util.concurrent.CopyOnWriteArrayList<Connection>();
+            fixture.read = () -> {
+                assertClean();
+                entered.countDown();
+                await(release);
+                return connections.executeRead(status -> {
+                    assertThat(originals).doesNotContain(status.getConnection());
+                    assertThat(readOne(status.getConnection())).isEqualTo(1);
+                    return List.of();
+                });
+            };
+            var first = executor.submit(() -> concurrentRefresh(fixture, originals, "first"));
+            var second = executor.submit(() -> concurrentRefresh(fixture, originals, "second"));
+            try { assertThat(entered.await(10, TimeUnit.SECONDS)).isTrue(); }
+            finally { release.countDown(); }
+            first.get(10, TimeUnit.SECONDS);
+            second.get(10, TimeUnit.SECONDS);
+            assertThat(originals).hasSize(2);
+            assertThat(originals.get(0)).isNotSameAs(originals.get(1));
+        }
+    }
+
+    private void concurrentRefresh(RefreshFixture fixture, List<Connection> originals, String marker) {
+        connections.executeRead(status -> {
+            originals.add(status.getConnection());
+            try (var ignored = caller(marker).propagate()) {
+                fixture.transport.refreshTools("main", "default").block(Duration.ofSeconds(10));
+                assertThat(connections.getConnectionStatus().getConnection()).isSameAs(status.getConnection());
+            }
+            return null;
+        });
+    }
+
+    @Test
+    void backgroundSqlFailureDoesNotCloseOrReplaceCallerConnection() {
+        try (var fixture = new RefreshFixture(true)) {
+            fixture.read = () -> {
+                assertClean();
+                return connections.executeRead(status -> {
+                    try (var statement = status.getConnection().createStatement()) {
+                        statement.executeQuery("select * from missing_queue_probe_table");
+                        throw new AssertionError("missing table must fail");
+                    } catch (java.sql.SQLException exception) {
+                        throw new IllegalStateException("background database read failed", exception);
+                    }
+                });
+            };
+            connections.executeRead(status -> {
+                try (var ignored = caller("queue-error").propagate()) {
+                    assertThatThrownBy(() -> fixture.transport.refreshTools("main", "default").block(Duration.ofSeconds(10)))
+                        .isInstanceOf(IllegalStateException.class).hasMessageContaining("background database read failed");
+                    assertThat(connections.getConnectionStatus().getConnection()).isSameAs(status.getConnection());
+                    assertThat(readOne(status.getConnection())).isEqualTo(1);
+                }
+                return null;
+            });
+        }
+    }
+
+    @Test
+    void subscriptionIsLazyAndCloseEvictsServerWithoutLaterRefreshReads() {
+        try (var fixture = new RefreshFixture(false)) {
+            var operation = fixture.transport.refreshTools("main", "default");
+            verify(fixture.service, never()).listToolSpecsForServer(any(), any(), any());
+            fixture.transport.close();
+            operation.block(Duration.ofSeconds(10));
+            verify(fixture.service, never()).listToolSpecsForServer(any(), any(), any());
+        }
+    }
+
+    private PropagatedContext caller(String marker) {
+        return PropagatedContext.getOrEmpty().plus(new JdbcMarker(marker))
+            .plus(new AuthorizationEvaluationContext(new Object()))
+            .plus(new AuthorizationInvocationContext(HttpRequest.GET("/queue-probe"), false));
+    }
+
+    private void assertClean() {
+        assertThat(applicationContext.isRunning()).isTrue();
+        assertThat(PropagatedContext.getOrEmpty().find(JdbcMarker.class)).isEmpty();
+        assertThat(AuthorizationEvaluationContext.current()).isEmpty();
+        assertThat(AuthorizationInvocationContext.currentRequest()).isEmpty();
+        assertThat(connections.findConnectionStatus()).isEmpty();
+    }
+
+    private static int readOne(Connection connection) {
+        try (var statement = connection.createStatement(); var rows = statement.executeQuery("select 1")) {
+            assertThat(rows.next()).isTrue();
+            return rows.getInt(1);
+        } catch (java.sql.SQLException exception) { throw new IllegalStateException(exception); }
+    }
+
+    private static void await(CountDownLatch latch) {
+        try { assertThat(latch.await(10, TimeUnit.SECONDS)).isTrue(); }
+        catch (InterruptedException exception) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException(exception);
+        }
+    }
+
+    private static final class RefreshFixture implements AutoCloseable {
+        final McpToolService service;
+        final McpServerHandlerTransport transport;
+        volatile Supplier<List<McpServerFeatures.AsyncToolSpecification>> read = List::of;
+
+        RefreshFixture(boolean enabled) {
+            var providers = mock(io.micronaut.context.BeanProvider.class);
+            var gate = new McpCapabilityGate(enabled, true, false, providers,
+                new io.kestra.webserver.rbac.RbacConfiguration(enabled, false),
+                mock(io.kestra.webserver.rbac.RbacGate.class));
+            service = spy(new McpToolService(mock(DispatchQueueInterface.class), mock(FlowRepositoryInterface.class),
+                mock(FlowToolSchemaMapper.class), mock(ExecutionStreamingService.class), mock(ApplicationEventPublisher.class),
+                new McpConfig(new McpConfig.ToolCacheConfig(10L, Duration.ofMinutes(1)), null, Duration.ofSeconds(5)),
+                mock(FlowInputOutput.class), mock(FlowMetaStoreInterface.class), mock(ExecutionOutputService.class),
+                mock(McpToolAccessControl.class), gate));
+            doAnswer(invocation -> read.get()).when(service).listToolSpecsForServer(any(), any(), any());
+            var access = new DefaultMcpToolAccessControl();
+            transport = new McpServerHandlerTransport(mock(McpErrorResponseMapper.class), service, mock(McpServerCache.class),
+                mock(McpSessionService.class), access, gate);
+            transport.getServerHandler(KestraMcpTransportContext.builder().tenantId("main").serverId("default")
+                .userId(enabled ? "verified-caller" : null).clientId("probe-client").resource("probe-resource")
+                .scopes(enabled ? List.of("mcp:flows:read") : List.of()).build());
+            clearInvocations(service);
+        }
+
+        @Override public void close() { transport.close(); }
+    }
+}
