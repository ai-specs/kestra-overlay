@@ -0,0 +1,104 @@
+package io.kestra.webserver.rbac;
+
+import io.kestra.core.ai.agent.models.AgentPrincipal;
+import io.kestra.core.repositories.AuthorizationEvaluationContext;
+import io.kestra.core.repositories.AuthorizationInvocationContext;
+import io.kestra.core.tenant.TenantService;
+import io.micronaut.core.async.propagation.ReactorPropagation;
+import io.micronaut.core.propagation.PropagatedContext;
+import io.micronaut.core.propagation.PropagatedContextElement;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpStatus;
+import io.micronaut.http.exceptions.HttpStatusException;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import jakarta.inject.Singleton;
+import java.time.Duration;
+import java.util.List;
+import java.util.Map;
+import java.util.HashMap;
+import java.util.function.Supplier;
+import reactor.core.publisher.Flux;
+import reactor.core.publisher.Mono;
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+
+/** Carries caller identity, never a request's evaluation or connection, into AI work. */
+@Singleton
+public final class AiAuthorization {
+    public record Caller(RbacAuthorizer.Principal principal, String tenant, String owner,
+                         HttpRequest<?> request) implements AgentPrincipal, PropagatedContextElement {
+        @Override public String toString() {return "AI caller [redacted]";}
+    }
+    private final RbacConfiguration configuration;
+    private final TypedAuthorizationGate gate;
+    private final TenantService tenants;
+    public AiAuthorization(RbacConfiguration configuration, TypedAuthorizationGate gate, TenantService tenants) {
+        this.configuration=configuration;this.gate=gate;this.tenants=tenants;
+    }
+    public record Cancellation(java.util.function.BooleanSupplier cancelled) implements PropagatedContextElement {}
+    public static boolean cancelled() {
+        return PropagatedContext.getOrEmpty().find(Cancellation.class).map(value->value.cancelled().getAsBoolean()).orElse(false);
+    }
+    public boolean enabled(){return configuration.enabled();}
+    public Caller capture() {
+        var active=PropagatedContext.getOrEmpty().find(Caller.class).orElse(null);
+        if(active!=null)return active;
+        var request=AuthorizationInvocationContext.currentRequest().orElse(null);
+        var authentication=request==null?null:request.getAttribute(SecurityFilter.AUTHENTICATION,Authentication.class).orElse(null);
+        if(authentication==null){if(enabled())throw denied();return null;}
+        String subject=authentication.getName(),tenant=tenants.resolveTenant();
+        if(subject==null||subject.isBlank()||tenant==null)throw denied();
+        return new Caller(new RbacAuthorizer.Principal(subject,List.copyOf(authentication.getRoles()),null,null,List.of()),tenant,subject,request);
+    }
+    public String owner(){var caller=capture();return caller==null?null:caller.owner();}
+    public void work(AgentPrincipal principal,Runnable action) {
+        if(!enabled()) {action.run();return;}
+        var caller=caller(principal);
+        var context=origin(caller).plus(caller);
+        var cancellation=PropagatedContext.getOrEmpty().find(Cancellation.class).orElse(null);
+        if(cancellation!=null)context=context.plus(cancellation);
+        try(var ignored=context.propagate()) {checkCurrent();action.run();}
+    }
+    public void checkCurrent(){if(enabled())checked(capture(),List.of(entry(capture().tenant())),()->Boolean.TRUE);}
+    public <T>T checked(AgentPrincipal principal,List<Operation> operations,Supplier<T> action) {
+        if(!enabled())return action.get();
+        var caller=caller(principal);
+        if(operations==null||operations.isEmpty()||operations.stream().anyMatch(op->op==null||!caller.tenant().equals(op.tenant())))throw denied();
+        var source=gate.boundary(caller.principal(),caller.tenant(),()->Flux.fromIterable(operations)
+            .concatMap(operation->gate.authorize(caller.principal(),operation))
+            .collectList().flatMapMany(decisions -> {
+                if (decisions.stream().anyMatch(decision -> !decision.allowed())) return Flux.error(denied());
+                return AuthorizationEvaluationContext.call(() -> {
+                    var domains = new HashMap<String, QueryDomain>();
+                    for (int index=0; index<operations.size(); index++) {
+                        var operation=operations.get(index);
+                        if (operation.coverage()==Coverage.COMPLETE_QUERY) domains.merge(operation.resource().name(),decisions.get(index).scope(),QueryDomain::intersect);
+                        else if (operation.action()==Action.READ && operation.namespace()!=null) {
+                            domains.merge(operation.resource().name(), operation.queryDomain().intersect(decisions.get(index).scope()), QueryDomain::intersect);
+                        }
+                    }
+                    var owner=AuthorizationEvaluations.current();
+                    if (owner == null || !owner.matches(caller.principal(), caller.tenant())) throw denied();
+                    var previous = new HashMap<>(owner.domains);
+                    owner.domains.putAll(domains);
+                    try {return action.get();}
+                    finally { owner.domains.clear(); owner.domains.putAll(previous); }
+                }).flux();
+            }));
+        return source.contextWrite(context->ReactorPropagation.addPropagatedContext(context,origin(caller)))
+            .single().block(Duration.ofSeconds(45));
+    }
+    public <T>T entry(AgentPrincipal principal,Supplier<T> action){
+        if (!enabled()) return action.get();
+        return checked(principal,List.of(entry(caller(principal).tenant())),action);
+    }
+    private static Caller caller(AgentPrincipal principal){
+        if(!(principal instanceof Caller caller)||caller.request()==null||caller.principal()==null||!caller.owner().equals(caller.principal().subject()))throw denied();
+        var authenticated=caller.request().getAttribute(SecurityFilter.AUTHENTICATION,Authentication.class).orElseThrow(AiAuthorization::denied);
+        if(!authenticated.getName().equals(caller.principal().subject()))throw denied();
+        return caller;
+    }
+    private static PropagatedContext origin(Caller caller){return PropagatedContext.empty().plus(new AuthorizationInvocationContext(caller.request(),false));}
+    public static Operation entry(String tenant){return new Operation(CONTRACT_VERSION,Source.REST,Resource.AI,Action.EXECUTE,tenant,null,null,QueryDomain.unrestricted(),Coverage.COMPLETE_BATCH,Aggregate.NONE,SideEffect.EXTERNAL);}
+    public static HttpStatusException denied(){return new HttpStatusException(HttpStatus.FORBIDDEN,"AI authorization denied");}
+}
