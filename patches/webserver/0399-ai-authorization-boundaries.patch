+import io.kestra.core.serializers.JacksonMapper;
+import io.micronaut.core.propagation.PropagatedContext;
+import io.kestra.webserver.services.ai.agent.AgentCallContext;
+import io.kestra.webserver.services.ai.agent.tool.ListExecutionsTool;
+import io.kestra.webserver.services.ai.agent.tool.ListFlowsTool;
+import io.kestra.webserver.services.ai.agent.tool.ReadExecutionTool;
+import io.kestra.webserver.services.ai.agent.tool.ReadExecutionLogsTool;
+import io.kestra.webserver.services.ai.agent.tool.ReadFlowTool;
+import io.kestra.webserver.services.ai.agent.tool.RestartExecutionTool;
+import io.kestra.webserver.services.ai.agent.tool.ToolCatalog;
+import jakarta.inject.Singleton;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+
+@Singleton
+public final class AiToolAuthorization {
+    private final AiAuthorization authorization;
+    private final ExecutionRepositoryInterface executions;
+    private final TypedAuthorizationGate gate;
+
+    public AiToolAuthorization(AiAuthorization authorization, ExecutionRepositoryInterface executions,
+        TypedAuthorizationGate gate) {
+        this.authorization = authorization;
+        this.executions = executions;
+        this.gate = gate;
+    }
+
+    @jakarta.inject.Inject
+    io.kestra.core.repositories.FlowRepositoryInterface flows;
+    @jakarta.inject.Inject
+    io.kestra.core.runners.FlowMetaStoreInterface flowMetaStore;
+    @jakarta.inject.Inject
+    RbacExecutionGate executionGate;
+
+    public <Result> Result checked(ToolCatalog.ToolEntry entry, ToolExecutionRequest request,
+        AgentCallContext.Context context, Supplier<Result> action) {
+        if (!authorization.enabled()) return action.get();
+        if (context == null || !(context.principal() instanceof AiAuthorization.Caller caller)
+            || !Objects.equals(caller.tenant(), context.tenant())) throw AiAuthorization.denied();
+        if (entry.tool() == null) {
+            Result result = authorization.entry(caller, action);
+            return authorization.entry(caller, () -> result);
+        }
+        JsonNode arguments;
+        try {
+            arguments = JacksonMapper.ofJson().readTree(request.arguments() == null ? "{}" : request.arguments());
+        } catch (Exception failure) {
+            throw AiAuthorization.denied();
+        }
+        if (arguments == null || !arguments.isObject()) throw AiAuthorization.denied();
+        List<Operation> plan = plan(entry.name(), arguments, context.tenant());
+        if (entry.name().equals("author-flow")) {
+            authorization.checked(caller, plan, () -> Boolean.TRUE);
+            Result authored = action.get();
+            return authorization.checked(caller, plan, () -> authored);
+        }
+        Result result = authorization.checked(caller, plan, () -> scoped(caller, plan, () -> {
+            if (entry.name().equals("restart-execution")) checkRestartDependencies(caller, arguments);
+            return action.get();
+        }));
+        List<Operation> returned = resultPlan(entry.name(), context.tenant(), plan, result);
+        return authorization.checked(caller, returned, () -> scoped(caller, returned, () -> result));
+    }
+
+    private void checkRestartDependencies(AiAuthorization.Caller caller, JsonNode arguments) {
+        if (flows == null || flowMetaStore == null || executionGate == null) throw AiAuthorization.denied();
+        String id = text(arguments, "executionId");
+        var execution = executions.findByIdWithoutAcl(caller.tenant(), id).orElseThrow(AiAuthorization::denied);
+        Integer revision = arguments.hasNonNull("revision") ? arguments.get("revision").intValue() : execution.getFlowRevision();
+        var flow = flows.findByIdWithoutAcl(caller.tenant(), execution.getNamespace(), execution.getFlowId(), java.util.Optional.ofNullable(revision))
+            .orElseThrow(AiAuthorization::denied);
+        if (!execution.getNamespace().equals(flow.getNamespace()) || !execution.getFlowId().equals(flow.getId())) throw AiAuthorization.denied();
+        var original = flowMetaStore.findByExecutionForRuntime(execution).orElseThrow(AiAuthorization::denied);
+        requireRuntime(caller, execution, original, execution.getFlowRevision());
+        checkDependencies(caller, original, id);
+        if (arguments.hasNonNull("revision")) {
+            var target = flowMetaStore.findByIdForRuntime(caller.tenant(),execution.getNamespace(),execution.getFlowId(),java.util.Optional.of(revision))
+                .orElseThrow(AiAuthorization::denied);
+            requireRuntime(caller, execution, target.flow(), revision);
+            checkDependencies(caller, target.flow(), id);
+        }
+    }
+
+    private void requireRuntime(AiAuthorization.Caller caller, Execution execution, io.kestra.core.models.flows.Flow flow, Integer revision) {
+        String tenant=flow.getTenantId()==null?"main":flow.getTenantId();
+        if (flow instanceof io.kestra.core.models.flows.FlowWithException || !caller.tenant().equals(tenant)
+            || !execution.getNamespace().equals(flow.getNamespace()) || !execution.getFlowId().equals(flow.getId())
+            || revision!=null && !revision.equals(flow.getRevision())) throw AiAuthorization.denied();
+    }
+    private void checkDependencies(AiAuthorization.Caller caller, io.kestra.core.models.flows.Flow flow, String id) {
+        if (!Boolean.TRUE.equals(executionGate.dependencies(caller.principal(),caller.tenant(),flow,id).block(java.time.Duration.ofSeconds(12))))
+            throw AiAuthorization.denied();
+    }
+
+    private <Result> Result scoped(AiAuthorization.Caller caller, List<Operation> plan, Supplier<Result> action) {
+        var owner = AuthorizationEvaluations.current();
+        if (owner == null || !owner.matches(caller.principal(), caller.tenant())) throw AiAuthorization.denied();
+        Operation primary = plan.getFirst();
+        QueryDomain primaryScope = null;
+        for (Operation operation : plan) {
+            Decision decision = gate.authorize(caller.principal(), operation).block();
+            if (decision == null || !decision.allowed()) throw AiAuthorization.denied();
+            QueryDomain scope = operation.queryDomain().intersect(decision.scope());
+            if (operation.namespace() != null) {
+                if (operation.resourceId() != null && !scope.resourceAllowed(operation.namespace(), operation.resourceId()))
+                    throw AiAuthorization.denied();
+                if (operation.resourceId() == null && (!scope.contains(operation.namespace())
+                    || !scope.resourceDomains().isEmpty() && scope.resourceDomains().stream().noneMatch(term ->
+                        term.idScope() == QueryDomain.IdScope.ALL_IDS && term.allows(operation.namespace(), "new-execution"))))
+                    throw AiAuthorization.denied();
+            }
+            if (operation == primary) primaryScope = scope;
+        }
+        var domain = new TypedDashboardGate.DatasourceDomain(owner, primary.resource(), primaryScope);
+        try (var ignored = PropagatedContext.getOrEmpty().plus(new AuthorizationQueryContext(domain)).propagate()) {
+            if (plan.stream().anyMatch(operation -> operation.resource()==Resource.METADATA)) {
+                var access = new TypedNamespaceAccessControl(gate);
+                try (var validation = PropagatedContext.getOrEmpty()
+                        .plus(new io.kestra.core.repositories.AuthorizationValidationContext(access)).propagate()) {
+                    return action.get();
+                }
+            }
+            return action.get();
+        }
+    }
+
+    private List<Operation> resultPlan(String name, String tenant, List<Operation> plan, Object result) {
+        Object value = result instanceof ToolExecutionResult executed ? executed.result() : result;
+        var operations = new ArrayList<>(plan);
+        if (name.equals("list-flows")) {
+            if (!(value instanceof ListFlowsTool.Result flows) || flows.flows() == null) throw AiAuthorization.denied();
+            for (var flow : flows.flows())
+                operations.add(single(Resource.FLOW, Action.READ, tenant, flow.namespace(), flow.id(), SideEffect.READ_ONLY));
+        } else if (name.equals("list-executions")) {
+            if (!(value instanceof ListExecutionsTool.Result executions) || executions.executions() == null)
+                throw AiAuthorization.denied();
+            for (var execution : executions.executions())
+                operations.add(single(Resource.EXECUTION, Action.READ, tenant, execution.namespace(), execution.id(), SideEffect.READ_ONLY));
+        } else if (name.equals("read-flow")) {
+            if (!(value instanceof ReadFlowTool.Result flow)) throw AiAuthorization.denied();
+            sameResource(plan.getFirst(), flow.namespace(), flow.id());
+            operations.add(single(Resource.FLOW, Action.READ, tenant, flow.namespace(), flow.id(), SideEffect.READ_ONLY));
+        } else if (name.equals("read-execution")) {
+            if (!(value instanceof ReadExecutionTool.Result execution)) throw AiAuthorization.denied();
+            sameResource(plan.getFirst(), execution.namespace(), execution.id());
+            operations.add(single(Resource.EXECUTION, Action.READ, tenant, execution.namespace(), execution.id(), SideEffect.READ_ONLY));
+        } else if (name.equals("read-execution-logs")) {
+            if (!(value instanceof ReadExecutionLogsTool.Result logs)
+                || !Objects.equals(plan.getFirst().resourceId(), logs.executionId())) throw AiAuthorization.denied();
+            operations.add(single(Resource.LOG, Action.READ, tenant, plan.getFirst().namespace(), logs.executionId(), SideEffect.READ_ONLY));
+        } else if (name.equals("restart-execution")) {
+            if (!(value instanceof RestartExecutionTool.Result restart)
+                || !Objects.equals(plan.getFirst().resourceId(), restart.executionId())) throw AiAuthorization.denied();
+        }
+        return List.copyOf(operations);
+    }
+
+    private void sameResource(Operation expected, String namespace, String id) {
+        if (!Objects.equals(expected.namespace(), namespace) || !Objects.equals(expected.resourceId(), id))
+            throw AiAuthorization.denied();
+    }
+
+    private List<Operation> plan(String name, JsonNode arguments, String tenant) {
+        return switch (name) {
+            case "list-flows" -> List.of(query(Resource.FLOW, tenant, arguments));
+            case "list-executions" -> List.of(query(Resource.EXECUTION, tenant, arguments));
+            case "read-flow" -> List.of(single(Resource.FLOW, Action.READ, tenant,
+                text(arguments, "namespace"), text(arguments, "flowId"), SideEffect.READ_ONLY));
+            case "read-execution", "read-execution-logs", "restart-execution" -> executionPlan(name, arguments, tenant);
+            case "search-plugins", "get-plugin-schema" -> List.of(single(Resource.METADATA, Action.READ,
+                tenant, null, null, SideEffect.READ_ONLY));
+            case "validate-flow", "author-flow" -> List.of(single(Resource.METADATA, Action.READ, tenant, null, null, SideEffect.READ_ONLY));
+            default -> throw AiAuthorization.denied();
+        };
+    }
+
+    private List<Operation> executionPlan(String name, JsonNode arguments, String tenant) {
+        String id = text(arguments, "executionId");
+        Execution execution = executions.findByIdWithoutAcl(tenant, id).orElseThrow(AiAuthorization::denied);
+        String actualTenant = execution.getTenantId() == null ? "main" : execution.getTenantId();
+        if (!tenant.equals(actualTenant)
+            || !id.equals(execution.getId()) || execution.getNamespace() == null) throw AiAuthorization.denied();
+        String namespace = execution.getNamespace();
+        if (name.equals("read-execution-logs")) {
+            return List.of(single(Resource.LOG, Action.READ, tenant, namespace, id, SideEffect.READ_ONLY));
+        }
+        var operations = new ArrayList<Operation>();
+        operations.add(single(Resource.EXECUTION, Action.READ, tenant, namespace, id, SideEffect.READ_ONLY));
+        if (name.equals("restart-execution")) {
+            String flowId = execution.getFlowId();
+            if (flowId == null || flowId.isBlank()) throw AiAuthorization.denied();
+            operations.add(single(Resource.EXECUTION, Action.UPDATE, tenant, namespace, id, SideEffect.QUEUE_WRITE));
+            operations.add(single(Resource.FLOW, Action.READ, tenant, namespace, flowId, SideEffect.READ_ONLY));
+            operations.add(single(Resource.FLOW, Action.EXECUTE, tenant, namespace, flowId, SideEffect.QUEUE_WRITE));
+            if (arguments.hasNonNull("revision")) {
+                if (!arguments.get("revision").isIntegralNumber() || !arguments.get("revision").canConvertToInt())
+                    throw AiAuthorization.denied();
+                operations.add(single(Resource.EXECUTION, Action.CREATE, tenant, namespace, null, SideEffect.QUEUE_WRITE));
+            }
+        }
+        return List.copyOf(operations);
+    }
+
+    private Operation query(Resource resource, String tenant, JsonNode arguments) {
+        var filters = new ArrayList<QueryFilter>();
+        JsonNode namespace = arguments.get("NAMESPACE");
+        if (namespace != null) {
+            if (!namespace.isObject() || !namespace.path("operator").isTextual() || !namespace.hasNonNull("value"))
+                throw AiAuthorization.denied();
+            var operation = QueryFilter.Op.fromString(namespace.get("operator").asText());
+            Object value = JacksonMapper.ofJson().convertValue(namespace.get("value"), Object.class);
+            filters.add(new QueryFilter(QueryFilter.Field.NAMESPACE, operation, value, null, null));
+        }
+        return new Operation(CONTRACT_VERSION, Source.REST, resource, Action.LIST, tenant, null, null,
+            TypedQueryDomains.fromFilters(filters, true), Coverage.COMPLETE_QUERY, Aggregate.NONE, SideEffect.READ_ONLY);
+    }
+
+    private Operation single(Resource resource, Action action, String tenant, String namespace, String id, SideEffect effect) {
+        QueryDomain domain = namespace == null ? QueryDomain.unrestricted()
+            : new QueryDomain(List.of(namespace), List.of(), List.of(), true, false);
+        return new Operation(CONTRACT_VERSION, Source.REST, resource, action, tenant, namespace, id,
+            domain, Coverage.SINGLE, Aggregate.NONE, effect);
+    }
+
+    private String text(JsonNode arguments, String field) {
+        JsonNode value = arguments.get(field);
+        if (value == null || !value.isTextual() || value.asText().isBlank()) throw AiAuthorization.denied();
+        return value.asText();
+    }
+}
