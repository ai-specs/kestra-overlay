+import io.kestra.webserver.services.ai.agent.AgentPrincipalResolver;
+import io.kestra.webserver.services.ai.agent.AiThreadManager;
+import io.kestra.webserver.services.ai.agent.TurnEventSink;
+import io.kestra.webserver.services.ai.agent.data.AgentEvents;
+import io.micronaut.http.sse.Event;
+import org.junit.jupiter.api.Test;
+import reactor.core.Disposable;
+import reactor.core.publisher.Flux;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.awaitility.Awaitility.await;
+import static org.mockito.Mockito.*;
+
+class AiTurnSchedulingTest {
+    @Test
+    void shouldRestoreIdleAndReleasePermitWhenCancelledBeforeWorkerStarts() throws Exception {
+        try (Harness harness = new Harness()) {
+            AtomicBoolean ran = new AtomicBoolean();
+            Disposable subscription = harness.stream(sink -> ran.set(true)).subscribe();
+            assertThat(harness.permits.availablePermits()).isZero();
+            subscription.dispose();
+            assertThat(harness.permits.availablePermits()).isZero();
+            harness.runQueued();
+            harness.idleAndReleased();
+            assertThat(ran).isFalse();
+        }
+    }
+
+    @Test
+    void shouldRestoreIdleWhenAuthorizationWorkRejectsBeforeOrchestratorStarts() throws Exception {
+        try (Harness harness = new Harness()) {
+            AtomicBoolean ran = new AtomicBoolean();
+            doThrow(AiAuthorization.denied()).when(harness.authorization).work(any(), any());
+            var errors = new java.util.concurrent.CopyOnWriteArrayList<Throwable>();
+            harness.stream(sink -> ran.set(true)).subscribe(event -> {}, errors::add);
+            harness.runQueued();
+            harness.idleAndReleased();
+            assertThat(ran).isFalse();
+            verify(harness.authorization).work(any(), any());
+        }
+    }
+
+    @Test
+    void shouldRestoreIdleAndReleaseOnlyOnceWhenExecutorRejectsSubmission() throws Exception {
+        try (Harness harness = new Harness()) {
+            harness.executor.reject = true;
+            var errors = new java.util.concurrent.CopyOnWriteArrayList<Throwable>();
+            Disposable subscription = harness.stream(sink -> fail("Work must not run")).subscribe(event -> {}, errors::add);
+            harness.idleAndReleased();
+            assertThat(errors).hasSize(1);
+            assertThat(errors.getFirst()).isInstanceOf(java.util.concurrent.RejectedExecutionException.class);
+            subscription.dispose();
+            assertThat(harness.permits.availablePermits()).isEqualTo(1);
+            verify(harness.threads, times(1)).save(any());
+        }
+    }
+
+    @Test
+    void shouldReleasePermitExactlyOnceWhenSubmissionAndIdleResetBothFail() throws Exception {
+        try (Harness harness = new Harness()) {
+            harness.executor.reject = true;
+            doThrow(new IllegalStateException("Test storage unavailable")).when(harness.threads).save(any());
+            var errors = new java.util.concurrent.CopyOnWriteArrayList<Throwable>();
+            Disposable subscription = harness.stream(sink -> fail("Work must not run")).subscribe(event -> {}, errors::add);
+            assertThat(errors).hasSize(1);
+            assertThat(errors.getFirst()).isInstanceOf(java.util.concurrent.RejectedExecutionException.class);
+            assertThat(errors.getFirst().getSuppressed()).hasSize(1);
+            assertThat(errors.getFirst().getSuppressed()[0]).hasMessage("Test storage unavailable");
+            assertThat(harness.current.get().status()).isEqualTo(AgentThreadStatus.RUNNING);
+            assertThat(harness.permits.availablePermits()).isEqualTo(1);
+            subscription.dispose();
+            assertThat(harness.permits.availablePermits()).isEqualTo(1);
+        }
+    }
+
+    @Test
+    void shouldHoldPermitUntilQueuedOutputActuallyTerminates() throws Exception {
+        try (Harness harness = new Harness()) {
+            CountDownLatch gateEntered = new CountDownLatch(1);
+            CountDownLatch gateRelease = new CountDownLatch(1);
+            doAnswer(invocation -> {
+                gateEntered.countDown();
+                if (!gateRelease.await(4, TimeUnit.SECONDS)) throw new AssertionError("Output gate not released");
+                return ((Supplier<?>) invocation.getArgument(1)).get();
+            }).when(harness.authorization).entry(any(), any());
+            var events = new java.util.concurrent.CopyOnWriteArrayList<String>();
+            AtomicBoolean complete = new AtomicBoolean();
+            harness.stream(sink -> {
+                harness.manager.resetToIdleIfExists("main", "running");
+                sink.emit(AgentEvents.TOKEN, "first");
+                sink.emit(AgentEvents.DONE, "idle");
+                sink.complete();
+            }).subscribe(event -> events.add(event.getName()), failure -> fail("Unexpected stream error", failure), () -> complete.set(true));
+            Thread worker = harness.startQueued();
+            try {
+                assertThat(gateEntered.await(3, TimeUnit.SECONDS)).isTrue();
+                assertThat(harness.current.get().status()).isEqualTo(AgentThreadStatus.IDLE);
+                assertThat(harness.permits.availablePermits()).isZero();
+                assertThat(complete).isFalse();
+            } finally {
+                gateRelease.countDown();
+            }
+            worker.join(Duration.ofSeconds(4));
+            assertThat(worker.isAlive()).isFalse();
+            harness.idleAndReleased();
+            assertThat(events).containsExactly(AgentEvents.TOKEN, AgentEvents.DONE);
+            assertThat(complete).isTrue();
+        }
+    }
+
+    private static final class Harness implements AutoCloseable {
+        final ControlledExecutor executor = new ControlledExecutor();
+        final AiThreadRepositoryInterface threads = mock(AiThreadRepositoryInterface.class);
+        final AtomicReference<AgentThread> current = new AtomicReference<>(AgentThread.builder()
+            .uid("running").tenant("main").mode(AgentMode.ASK).status(AgentThreadStatus.RUNNING).build());
+        final AiThreadManager manager = new AiThreadManager(threads, mock(AiMessageRepositoryInterface.class));
+        final AiAuthorization authorization = mock(AiAuthorization.class);
+        final AiAgentController controller;
+        final Semaphore permits;
+        final Method stream;
+
+        Harness() throws Exception {
+            when(threads.find("main", "running")).thenAnswer(invocation -> Optional.of(current.get()));
+            when(threads.save(any())).thenAnswer(invocation -> {
+                AgentThread thread = invocation.getArgument(0);
+                current.set(thread);
+                return thread;
+            });
+            when(authorization.enabled()).thenReturn(true);
+            when(authorization.entry(any(), any())).thenAnswer(invocation -> ((Supplier<?>) invocation.getArgument(1)).get());
+            doAnswer(invocation -> { ((Runnable) invocation.getArgument(1)).run(); return null; })
+                .when(authorization).work(any(), any());
+            ExecutorsUtils executors = mock(ExecutorsUtils.class);
+            when(executors.cachedVirtualThreadPool(anyString())).thenReturn(executor);
+            var configuration = new AgentConfiguration(Duration.ofSeconds(5), "http://localhost/unused", 25, 50, 1, 10, Duration.ofHours(1), 50);
+            controller = new AiAgentController(new TenantService(), mock(AiServiceManager.class), threads,
+                mock(AiMessageRepositoryInterface.class), manager, mock(AgentOrchestrator.class),
+                mock(AgentPrincipalResolver.class), configuration, executors);
+            Field auth = AiAgentController.class.getDeclaredField("authorization");
+            auth.setAccessible(true);
+            auth.set(controller, authorization);
+            Field semaphore = AiAgentController.class.getDeclaredField("turnGate");
+            semaphore.setAccessible(true);
+            permits = (Semaphore) semaphore.get(controller);
+            assertThat(permits.tryAcquire()).isTrue();
+            stream = AiAgentController.class.getDeclaredMethod("stream", AgentPrincipal.class, AgentThread.class, Consumer.class);
+            stream.setAccessible(true);
+        }
+
+        @SuppressWarnings("unchecked")
+        Flux<Event<Object>> stream(Consumer<TurnEventSink> work) throws Exception {
+            return (Flux<Event<Object>>) stream.invoke(controller, null, current.get(), work);
+        }
+
+        void runQueued() throws Exception {
+            Thread worker = startQueued();
+            worker.join(Duration.ofSeconds(5));
+            assertThat(worker.isAlive()).isFalse();
+        }
+
+        Thread startQueued() throws Exception {
+            Runnable task = executor.pending.poll(3, TimeUnit.SECONDS);
+            assertThat(task).isNotNull();
+            return Thread.ofVirtual().start(task);
+        }
+
+        void idleAndReleased() {
+            await().atMost(Duration.ofSeconds(3)).untilAsserted(() -> {
+                assertThat(current.get().status()).isEqualTo(AgentThreadStatus.IDLE);
+                assertThat(permits.availablePermits()).isEqualTo(1);
+            });
+        }
+
+        @Override
+        public void close() { executor.shutdownNow(); }
+    }
+
+    private static final class ControlledExecutor extends AbstractExecutorService {
+        final LinkedBlockingQueue<Runnable> pending = new LinkedBlockingQueue<>();
+        volatile boolean reject;
+        volatile boolean shutdown;
+        @Override
+        public void execute(Runnable task) {
+            if (reject || shutdown) throw new java.util.concurrent.RejectedExecutionException("Test submission rejected");
+            pending.add(task);
+        }
+        @Override
+        public void shutdown() { shutdown = true; }
+        @Override
+        public List<Runnable> shutdownNow() {
+            shutdown = true;
+            var remaining = new java.util.ArrayList<Runnable>();
+            pending.drainTo(remaining);
+            return remaining;
+        }
+        @Override
+        public boolean isShutdown() { return shutdown; }
+        @Override
+        public boolean isTerminated() { return shutdown && pending.isEmpty(); }
+        @Override
+        public boolean awaitTermination(long timeout, TimeUnit unit) { return isTerminated(); }
+    }
+}
