+package io.kestra.webserver.rbac;
+import io.kestra.core.repositories.AuthorizationValidationContext;
+import io.kestra.core.repositories.NamespaceAccessControl;
+import io.kestra.core.models.QueryFilter;
+import io.micronaut.core.propagation.PropagatedContext;
+import org.junit.jupiter.api.Test;
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+class AiValidationScopeTest {
+    @Test void nativeValidationDoesNotRequireAnAuthorizationProvider(){assertThatCode(()->AuthorizationValidationContext.requireReadable("main","company.a","flow")).doesNotThrowAnyException();}
+    @Test void crossNamespaceOrIdDependencyFailsWithUniformMessage(){
+        var access=mock(NamespaceAccessControl.class);
+        when(access.resourceReadAllowed(QueryFilter.Resource.FLOW,"main","company.a","allowed")).thenReturn(true);
+        try(var scope=PropagatedContext.empty().plus(new AuthorizationValidationContext(access)).propagate()){
+            assertThatCode(()->AuthorizationValidationContext.requireReadable("main","company.a","allowed")).doesNotThrowAnyException();
+            for(var target:java.util.List.of(new String[]{"company.b","secret"},new String[]{"company.a","other"}))
+                assertThatThrownBy(()->AuthorizationValidationContext.requireReadable("main",target[0],target[1])).isInstanceOf(SecurityException.class).hasMessage("Flow validation references an unavailable resource");
+        }
+    }
+}
