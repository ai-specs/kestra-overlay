+package io.kestra.core.services;
+
+import java.util.List;
+import io.kestra.core.junit.annotations.KestraTest;
+import io.kestra.core.models.flows.FlowSource;
+import io.kestra.core.repositories.AuthorizationValidationContext;
+import io.kestra.core.repositories.NamespaceAccessControl;
+import io.kestra.core.tenant.TenantService;
+import io.micronaut.core.propagation.PropagatedContext;
+import jakarta.inject.Inject;
+import org.junit.jupiter.api.Test;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+@KestraTest
+class AuthorizationValidationBoundaryTest {
+    @Inject FlowService service;
+    private static final String YAML = """
+        id: validation_boundary
+        namespace: company.validation
+        revision: 1
+        tasks:
+          - id: output
+            type: io.kestra.plugin.core.log.Log
+            message: hello
+        """;
+
+    @Test
+    void shouldKeepModeAValidationWithoutAuthorizationContext() {
+        var result = service.validate(TenantService.MAIN_TENANT, List.of(new FlowSource(null, YAML)));
+        assertThat(result).hasSize(1);
+        assertThat(result.getFirst().getConstraints()).isNull();
+    }
+
+    @Test
+    void shouldRejectUnreadableRevisionBeforeExposingRevisionStatus() {
+        NamespaceAccessControl access = mock(NamespaceAccessControl.class);
+        when(access.resourceReadAllowed(any(), any(), any(), any())).thenReturn(false);
+        try (var ignored = PropagatedContext.empty().plus(new AuthorizationValidationContext(access)).propagate()) {
+            var result = service.validate(TenantService.MAIN_TENANT, List.of(new FlowSource(null, YAML)));
+            assertThat(result.getFirst().getConstraints()).contains("Flow validation references an unavailable resource");
+            assertThat(result.getFirst().getConstraints()).doesNotContain("lastRevision", "not found");
+        }
+        verify(access).resourceReadAllowed(any(), eq(TenantService.MAIN_TENANT), eq("company.validation"), eq("validation_boundary"));
+    }
+
+    @Test
+    void shouldAllowReadableRevisionAndKeepScopeLimitedToRequestedResource() {
+        NamespaceAccessControl access = mock(NamespaceAccessControl.class);
+        when(access.resourceReadAllowed(any(), eq(TenantService.MAIN_TENANT), eq("company.validation"), eq("validation_boundary")))
+            .thenReturn(true);
+        try (var ignored = PropagatedContext.empty().plus(new AuthorizationValidationContext(access)).propagate()) {
+            var result = service.validate(TenantService.MAIN_TENANT, List.of(new FlowSource(null, YAML)));
+            assertThat(result.getFirst().getConstraints()).isNull();
+        }
+        verify(access).resourceReadAllowed(any(), eq(TenantService.MAIN_TENANT), eq("company.validation"), eq("validation_boundary"));
+        verifyNoMoreInteractions(access);
+    }
+}
