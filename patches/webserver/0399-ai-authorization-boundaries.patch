+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Supplier;
+import org.junit.jupiter.api.Test;
+import reactor.core.publisher.Flux;
+import reactor.core.publisher.Mono;
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class AiAuthorizationTest {
+    private final TenantService tenants=mock(TenantService.class);
+    private final TypedAuthorizationGate gate=mock(TypedAuthorizationGate.class);
+    AiAuthorizationTest(){when(tenants.resolveTenant()).thenReturn("main");}
+    private AiAuthorization auth(boolean enabled){return new AiAuthorization(new RbacConfiguration(enabled,false),gate,tenants);}
+    private <T>T as(String subject,Supplier<T> action){
+        var request=HttpRequest.GET("/api/v1/main/ai/threads").setAttribute(SecurityFilter.AUTHENTICATION,Authentication.build(subject));
+        return ServerRequestContext.with(request,action);
+    }
+    private void stubBoundary(AiAuthorization.Caller caller) {
+        when(gate.boundary(any(),anyString(),any())).thenAnswer(invocation -> {
+            Supplier<org.reactivestreams.Publisher<Object>> action = invocation.getArgument(2);
+            var owner = new AuthorizationEvaluations.Owner(caller.principal(), caller.tenant());
+            owner.acquire((subject, tenant) -> java.util.concurrent.CompletableFuture.completedFuture(mock(AuthorizationEvaluationV1.class))).block();
+            return Flux.defer(action).contextWrite(context -> io.micronaut.core.async.propagation.ReactorPropagation.addPropagatedContext(context,
+                PropagatedContext.empty().plus(new AuthorizationEvaluationContext(owner))));
+        });
+    }
+    @Test void modeAAllowsNativeActionWithoutPolicyProvider(){
+        var result=auth(false).checked(null,List.of(),()->"native");assertThat(result).isEqualTo("native");verifyNoInteractions(gate);
+    }
+    @Test void modeACapturesAuthenticatedOwnerButPreservesAnonymousOss(){
+        var auth=auth(false);assertThat(auth.capture()).isNull();assertThat(as("alice",auth::owner)).isEqualTo("alice");
+    }
+    @Test void modeBRejectsMissingAuthenticationBeforeWork(){
+        var auth=auth(true);assertThatThrownBy(auth::capture).isInstanceOf(io.micronaut.http.exceptions.HttpStatusException.class);verifyNoInteractions(gate);
+    }
+    @Test void workDoesNotCarryAnOldEvaluationOrInternalBypass(){
+        var auth=auth(true);var caller=as("alice",auth::capture);var context=PropagatedContext.empty().plus(new AuthorizationEvaluationContext(new Object())).plus(new AuthorizationInvocationContext(null,true));
+        stubBoundary(caller);
+        when(gate.authorize(any(),any())).thenReturn(Mono.just(TypedAuthorization.Decision.allow(TypedAuthorization.QueryDomain.unrestricted())));
+        try(var ignored=context.propagate()){
+            auth.work(caller,()->{assertThat(AuthorizationEvaluationContext.current()).isEmpty();assertThat(AuthorizationInvocationContext.isInternal()).isFalse();assertThat(auth.capture()).isSameAs(caller);});
+        }
+        assertThat(AuthorizationInvocationContext.current()).isEmpty();
+    }
+    @Test void modeBDeniesBeforeSideEffectAndChecksEveryInvocation(){
+        var auth=auth(true);var caller=as("alice",auth::capture);var writes=new AtomicInteger();
+        stubBoundary(caller);
+        when(gate.authorize(any(),any())).thenReturn(Mono.just(TypedAuthorization.Decision.allow(TypedAuthorization.QueryDomain.unrestricted())),Mono.just(TypedAuthorization.Decision.deny("revoked")));
+        assertThat(auth.checked(caller,List.of(AiAuthorization.entry("main")),writes::incrementAndGet)).isEqualTo(1);
+        assertThatThrownBy(()->auth.checked(caller,List.of(AiAuthorization.entry("main")),writes::incrementAndGet)).isInstanceOf(io.micronaut.http.exceptions.HttpStatusException.class);
+        assertThat(writes).hasValue(1);verify(gate,times(2)).boundary(any(),anyString(),any());
+    }
+    @Test void modeBRejectsMissingCallerForeignTenantAndEmptyPlans(){
+        var auth=auth(true);var caller=as("alice",auth::capture);
+        assertThatThrownBy(()->auth.checked(null,List.of(AiAuthorization.entry("main")),()->1)).isInstanceOf(io.micronaut.http.exceptions.HttpStatusException.class);
+        assertThatThrownBy(()->auth.checked(new AgentPrincipal(){},List.of(AiAuthorization.entry("main")),()->1)).isInstanceOf(io.micronaut.http.exceptions.HttpStatusException.class);
+        assertThatThrownBy(()->auth.checked(caller,List.of(AiAuthorization.entry("other")),()->1)).isInstanceOf(io.micronaut.http.exceptions.HttpStatusException.class);
+        assertThatThrownBy(()->auth.checked(caller,List.of(),()->1)).isInstanceOf(io.micronaut.http.exceptions.HttpStatusException.class);
+        verifyNoInteractions(gate);
+    }
+}
