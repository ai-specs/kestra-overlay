+import org.reactivestreams.Publisher;
+import reactor.core.publisher.Flux;
+import reactor.core.publisher.Mono;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class AiAuthorFlowBoundaryTest {
+    private static final String YAML = "namespace: company.a\nid: draft\ntasks: []\n";
+    private final TypedAuthorizationGate gate = mock(TypedAuthorizationGate.class);
+    private final AiServiceManager manager = mock(AiServiceManager.class);
+    private final AiServiceInterface service = mock(AiServiceInterface.class);
+    private final FlowService flows = mock(FlowService.class);
+    private final AtomicBoolean allowed = new AtomicBoolean(true);
+    private final AtomicBoolean cancelled = new AtomicBoolean();
+    private final AtomicInteger begins = new AtomicInteger();
+    private final AtomicInteger closes = new AtomicInteger();
+    private final RbacAuthorizer.Principal principal = new RbacAuthorizer.Principal("alice", List.of(), null, null, List.of());
+    private final AiAuthorization.Caller caller = new AiAuthorization.Caller(principal, "main", "alice",
+        HttpRequest.GET("/api/v1/main/ai").setAttribute(SecurityFilter.AUTHENTICATION, Authentication.build("alice")));
+    private final AgentCallContext.Context context = new AgentCallContext.Context("main", caller, "test", "thread");
+
+    AiAuthorFlowBoundaryTest() {
+        when(manager.getAiService("test")).thenReturn(service);
+        when(flows.validate(anyString(), anyList())).thenReturn(List.of());
+        when(gate.authorize(any(), any())).thenAnswer(invocation -> {
+            Operation operation = invocation.getArgument(1);
+            return Mono.just(allowed.get() ? Decision.allow(operation.queryDomain()) : Decision.deny("revoked"));
+        });
+        when(gate.boundary(any(), anyString(), any())).thenAnswer(invocation -> {
+            Supplier<? extends Publisher<Object>> action = invocation.getArgument(2);
+            var owner = new AuthorizationEvaluations.Owner(principal, "main");
+            owner.acquire((subject, tenant) -> CompletableFuture.completedFuture(mock(AuthorizationEvaluationV1.class))).block();
+            begins.incrementAndGet();
+            return Flux.defer(() -> Flux.from(action.get())).contextWrite(reactor -> ReactorPropagation.addPropagatedContext(reactor,
+                PropagatedContext.empty().plus(new AuthorizationEvaluationContext(owner))))
+                .doFinally(signal -> closes.incrementAndGet());
+        });
+    }
+
+    @Test
+    void shouldKeepModeAOriginalSynchronousGenerationAndValidation() {
+        when(service.generateFlow(any(), any(), anyString())).thenReturn(GenerationResult.of(YAML));
+        var tool = tool(false);
+        var result = tool.authorFlow("draft", "different.namespace", null, context);
+        assertThat(result.yaml()).isEqualTo(YAML);
+        verifyNoInteractions(gate);
+        verify(flows).validate(eq("main"), anyList());
+    }
+
+    @Test
+    void shouldStripOldEvaluationAndValidateInFreshBoundaryAfterGeneration() {
+        when(service.generateFlow(any(), any(), anyString())).thenAnswer(invocation -> {
+            assertThat(AuthorizationEvaluationContext.current()).isEmpty();
+            assertThat(PropagatedContext.getOrEmpty().find(AiAuthorization.Caller.class)).contains(caller);
+            assertThat(AuthorizationInvocationContext.currentRequest()).contains(caller.request());
+            assertThat(PropagatedContext.getOrEmpty().find(AiAuthorization.Cancellation.class)).isPresent();
+            assertThat(begins.get()).isEqualTo(closes.get());
+            return GenerationResult.of(YAML);
+        });
+        when(flows.validate(anyString(), anyList())).thenAnswer(invocation -> {
+            assertThat(AuthorizationEvaluationContext.current()).isPresent();
+            assertThat(PropagatedContext.getOrEmpty().find(AuthorizationValidationContext.class)).isPresent();
+            return List.of();
+        });
+        try (var ignored = origin().plus(new AuthorizationEvaluationContext(new Object())).propagate()) {
+            assertThat(tool(true).authorFlow("draft", "company.a", YAML, context).valid()).isTrue();
+        }
+        assertBalanced();
+    }
+
+    @Test
+    void shouldDenyUnreadableCurrentYamlBeforeSendingItToModel() {
+        doAnswer(invocation -> {
+            Operation operation = invocation.getArgument(1);
+            return Mono.just(operation.resource() == Resource.FLOW ? Decision.deny("unreadable") : Decision.allow(operation.queryDomain()));
+        }).when(gate).authorize(any(), any());
+        try (var ignored = origin().propagate()) {
+            assertThatThrownBy(() -> tool(true).authorFlow("draft", "company.a", YAML, context)).hasMessageContaining("AI authorization denied");
+        }
+        verifyNoInteractions(service, flows);
+        assertBalanced();
+    }
+
+    @Test
+    void shouldRejectGeneratedNamespaceMismatchBeforeValidation() {
+        when(service.generateFlow(any(), any(), anyString())).thenReturn(GenerationResult.of(YAML.replace("company.a", "company.b")));
+        try (var ignored = origin().propagate()) {
+            assertThatThrownBy(() -> tool(true).authorFlow("draft", "company.a", null, context)).hasMessageContaining("AI authorization denied");
+        }
+        verifyNoInteractions(flows);
+        assertBalanced();
+    }
+
+    @Test
+    void shouldCancelWaitingWorkerOnRevocationAndIgnoreItsLateResult() throws Exception {
+        deniedWhileWaiting(false);
+    }
+
+    @Test
+    void shouldCancelWaitingWorkerOnOuterCancellationAndIgnoreItsLateResult() throws Exception {
+        deniedWhileWaiting(true);
+    }
+
+    @Test
+    void shouldNotValidateWhenPermissionRevokedAsGenerationFinishes() {
+        when(service.generateFlow(any(), any(), anyString())).thenAnswer(invocation -> {
+            allowed.set(false);
+            return GenerationResult.of(YAML);
+        });
+        try (var ignored = origin().propagate()) {
+            assertThatThrownBy(() -> tool(true).authorFlow("draft", "company.a", null, context)).hasMessageContaining("AI authorization denied");
+        }
+        verifyNoInteractions(flows);
+        assertBalanced();
+    }
+
+    private void deniedWhileWaiting(boolean outerCancellation) throws Exception {
+        var started = new CountDownLatch(1);
+        var interrupted = new CountDownLatch(1);
+        var release = new CountDownLatch(1);
+        var finished = new CountDownLatch(1);
+        when(service.generateFlow(any(), any(), anyString())).thenAnswer(invocation -> {
+            started.countDown();
+            try {
+                while (release.getCount() != 0) {
+                    try { release.await(); }
+                    catch (InterruptedException failure) { interrupted.countDown(); }
+                }
+                return GenerationResult.of(YAML);
+            } finally { finished.countDown(); }
+        });
+        var result = new CompletableFuture<AuthorFlowTool.Result>();
+        Thread waiting = Thread.ofVirtual().start(() -> {
+            try (var ignored = origin().propagate()) {
+                result.complete(tool(true).authorFlow("draft", "company.a", null, context));
+            } catch (Throwable failure) { result.completeExceptionally(failure); }
+        });
+        try {
+            assertThat(started.await(3, TimeUnit.SECONDS)).isTrue();
+            if (outerCancellation) cancelled.set(true); else allowed.set(false);
+            if (outerCancellation) {
+                assertThatThrownBy(() -> result.get(5, TimeUnit.SECONDS)).isInstanceOf(java.util.concurrent.CancellationException.class);
+            } else {
+                assertThatThrownBy(() -> result.get(5, TimeUnit.SECONDS))
+                    .isInstanceOf(java.util.concurrent.ExecutionException.class)
+                    .hasCauseInstanceOf(io.micronaut.http.exceptions.HttpStatusException.class);
+            }
+            assertThat(interrupted.await(2, TimeUnit.SECONDS)).isTrue();
+            verifyNoInteractions(flows);
+        } finally {
+            release.countDown();
+            waiting.join(Duration.ofSeconds(3));
+        }
+        assertThat(finished.await(3, TimeUnit.SECONDS)).isTrue();
+        verifyNoInteractions(flows);
+        assertBalanced();
+    }
+
+    private PropagatedContext origin() {
+        return PropagatedContext.empty().plus(caller).plus(new AuthorizationInvocationContext(caller.request(), false))
+            .plus(new AiAuthorization.Cancellation(cancelled::get));
+    }
+
+    private AuthorFlowTool tool(boolean enabled) {
+        return new AuthorFlowTool(manager, flows,
+            new AiAuthorization(new RbacConfiguration(enabled, false), gate, new TenantService()), gate);
+    }
+
+    private void assertBalanced() {
+        org.awaitility.Awaitility.await().atMost(Duration.ofSeconds(3))
+            .untilAsserted(() -> assertThat(closes.get()).isEqualTo(begins.get()));
+    }
+}
