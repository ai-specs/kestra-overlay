+            .header("X-AI-Test-Transport", user).header("Content-Type", "application/json")
+            .header("Accept", path.endsWith("/chat") ? "text/event-stream" : "application/json")
+            .method(method, body == null ? HttpRequest.BodyPublishers.noBody() : HttpRequest.BodyPublishers.ofString(body)).build();
