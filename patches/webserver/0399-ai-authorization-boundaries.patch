+        try {
+            var running = pool.submit(() -> run(thread, sink));
+            assertThat(model.started.await(3, TimeUnit.SECONDS)).isTrue();
+            sink.cancelled = true;
+            running.get(5, TimeUnit.SECONDS);
+            assertThat(model.handle.isCancelled()).isTrue();
+            assertThat(reload(thread).status()).isEqualTo(AgentThreadStatus.IDLE);
+            assertThat(messages.load(TENANT, thread.uid()))
+                .anyMatch(message -> message.type() == AgentMessageType.CANCELLED);
+            model.completePending(writeRequest());
+            assertThat(writes.get()).isZero();
+            assertThat(model.calls.get()).isEqualTo(1);
+            assertThat(sink.failure).isNull();
+            AgentThread claimed = threadManager.tryMarkRunning(reload(thread), AgentMode.ASK,
+                AgentThreadStatus.IDLE).orElseThrow();
+            threadManager.finish(claimed);
+        } finally {
+            pool.shutdownNow();
+            assertThat(pool.awaitTermination(3, TimeUnit.SECONDS)).isTrue();
+        }
+    }
