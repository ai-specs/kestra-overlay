+    private AgentThread newThread(AgentMode mode) {
+        return threads.create(AgentThread.builder().uid(IdUtils.create()).tenant(TENANT)
+            .mode(mode).status(AgentThreadStatus.IDLE).createdAt(Instant.now())
+            .updatedAt(Instant.now()).deleted(false).build());
+    }
+
+    private AgentThread reload(AgentThread thread) {
+        return threads.find(TENANT, thread.uid()).orElseThrow();
+    }
+
+    private Sink turn(AgentThread thread) {
+        Sink sink = new Sink();
+        run(thread, sink);
+        return sink;
+    }
+
+    private void run(AgentThread thread, Sink sink) {
+        orchestrator.runTurn(new AgentTurnContext(thread, "Explain or update the test artefact",
+            thread.mode(), TENANT, null, null, null), sink);
+    }
+
+    private AgentThread propose() {
+        AgentThread thread = newThread(AgentMode.EDIT);
+        model.enqueue(writeRequest());
+        Sink sink = turn(thread);
+        AgentThread awaiting = reload(thread);
+        assertThat(awaiting.status()).isEqualTo(AgentThreadStatus.AWAITING_CONFIRMATION);
+        assertThat(awaiting.pendingConfirmationId()).isNotBlank();
+        assertThat(sink.names()).contains(AgentEvents.PROPOSED_ACTION);
+        assertThat(writes.get()).isZero();
+        return awaiting;
+    }
+
+    private Sink resume(AgentThread thread, boolean approve) {
+        AgentThread awaiting = reload(thread);
+        AgentThread claimed = threadManager.tryMarkRunning(awaiting, awaiting.mode(),
+            AgentThreadStatus.AWAITING_CONFIRMATION).orElseThrow();
+        Sink sink = new Sink();
+        orchestrator.resume(claimed, null, approve, approve ? null : "leave unchanged", null, sink);
+        return sink;
+    }
+
+    private void assertIdle(AgentThread thread, Sink sink) {
+        assertThat(reload(thread).status()).isEqualTo(AgentThreadStatus.IDLE);
+        assertThat(sink.completed).isTrue();
+        assertThat(sink.failure).isNull();
+    }
+
+    private static String outcome(Sink sink) {
+        return sink.events.stream().filter(event -> event.getKey().equals(AgentEvents.TOOL_RESULT))
+            .map(event -> ((AgentEvents.ToolResultEvent) event.getValue()).outcome())
+            .findFirst().orElseThrow();
+    }
+
+    private static AiMessage writeRequest() {
+        return AiMessage.from("", List.of(ToolExecutionRequest.builder().id("write-1")
+            .name("update-artefact").arguments("{\"executionId\":\"test-execution\"}").build()));
+    }
+
+    private static final class Sink implements TurnEventSink {
+        final List<Map.Entry<String, Object>> events = new CopyOnWriteArrayList<>();
+        volatile boolean cancelled;
+        volatile boolean completed;
+        volatile Throwable failure;
+
+        @Override
+        public boolean isCancelled() { return cancelled; }
+        @Override
+        public void emit(String event, Object payload) { events.add(Map.entry(event, payload)); }
+        @Override
+        public void complete() { completed = true; }
+        @Override
+        public void error(Throwable error) { failure = error; }
+        List<String> names() { return events.stream().map(Map.Entry::getKey).toList(); }
+    }
+
+    private static final class ScriptedModel implements StreamingChatModel {
+        final BlockingQueue<AiMessage> responses = new LinkedBlockingQueue<>();
+        final AtomicBoolean waitForResponse = new AtomicBoolean();
+        final AtomicInteger calls = new AtomicInteger();
+        volatile CountDownLatch started = new CountDownLatch(1);
+        volatile StreamingChatResponseHandler pending;
+        volatile Handle handle = new Handle();
+
+        void reset() {
+            responses.clear();
+            waitForResponse.set(false);
+            calls.set(0);
+            started = new CountDownLatch(1);
+            pending = null;
+            handle = new Handle();
+        }
+
+        void enqueue(AiMessage response) { responses.add(response); }
+
+        void completePending(AiMessage response) {
+            pending.onCompleteResponse(ChatResponse.builder().aiMessage(response).build());
+        }
+
+        @Override
+        public void chat(ChatRequest request, StreamingChatResponseHandler handler) {
+            calls.incrementAndGet();
+            if (waitForResponse.get()) {
+                pending = handler;
+                handler.onPartialResponse(new PartialResponse("waiting"), new PartialResponseContext(handle));
+                started.countDown();
+                return;
+            }
+            AiMessage response = responses.poll();
+            if (response == null) {
+                handler.onError(new IllegalStateException("Missing scripted response"));
+                return;
+            }
+            if (response.text() != null && !response.text().isEmpty()) {
+                handler.onPartialResponse(new PartialResponse(response.text()), new PartialResponseContext(handle));
+            }
+            handler.onCompleteResponse(ChatResponse.builder().aiMessage(response).build());
+        }
+    }
+
+    private static final class Handle implements StreamingHandle {
+        private volatile boolean cancelled;
+        @Override
+        public void cancel() { cancelled = true; }
+        @Override
+        public boolean isCancelled() { return cancelled; }
+    }
+}
