+                    new QueryDomain(List.of(expected), List.of(), List.of(), true, false),
+                    Coverage.SINGLE, Aggregate.NONE, SideEffect.READ_ONLY));
+            }
+            authorization.checked(caller, operations, () -> {
+                checkReadable(caller, operations);
+                return Boolean.TRUE;
+            });
+            var prompt = new FlowGenerationPrompt(Objects.requireNonNullElseGet(context.conversationId(), IdUtils::create),
+                instructions, currentYaml, expected);
+            String yaml = generate(service, prompt, caller, minimal);
+            checkCancelled();
+            JsonNode generated = declaration(yaml);
+            if (!expected.equals(required(generated, "namespace"))) throw AiAuthorization.denied();
+            String constraints = authorization.checked(caller, operations, () -> {
+                checkCancelled();
+                checkReadable(caller, operations);
+                try (var validation = PropagatedContext.getOrEmpty()
+                    .plus(new AuthorizationValidationContext(new TypedNamespaceAccessControl(gate))).propagate()) {
+                    return Objects.requireNonNullElse(validate(caller.tenant(), yaml), "");
+                }
+            });
+            checkCancelled();
+            return authorization.checked(caller, operations, () -> {
+                checkCancelled();
+                checkReadable(caller, operations);
+                var draft = new ArtefactDraft(IdUtils.create(), ArtefactKind.FLOW, yaml, constraints.isEmpty(),
+                    constraints.isEmpty() ? null : constraints);
+                return Result.drafted(draft, missingNamespace && creating ? expected : null);
+            });
+        }
+    }
+
+    private String generate(AiServiceInterface service, FlowGenerationPrompt prompt, AiAuthorization.Caller caller,
+        PropagatedContext minimal) {
+        checkCancelled();
+        authorization.entry(caller, () -> Boolean.TRUE);
+        var task = new FutureTask<String>(() -> {
+            try (var ignored = minimal.propagate()) {
+                checkCancelled();
+                return service.generateFlow(new UserInfo(null, "copilot-agent"), prompt, caller.tenant()).content();
+            }
+        });
+        Thread.ofVirtual().name("ai-author-flow").start(task);
+        long deadline = System.nanoTime() + generationTimeout.toNanos();
+        try {
+            while (true) {
+                checkCancelled();
+                long remaining = deadline - System.nanoTime();
+                if (remaining <= 0) throw new IllegalStateException("Flow generation timed out after " + generationTimeout);
+                try {
+                    String yaml = task.get(Math.min(remaining, TimeUnit.SECONDS.toNanos(1)), TimeUnit.NANOSECONDS);
+                    checkCancelled();
+                    authorization.entry(caller, () -> Boolean.TRUE);
+                    return yaml;
+                } catch (TimeoutException waiting) {
+                    checkCancelled();
+                    authorization.entry(caller, () -> Boolean.TRUE);
+                }
+            }
+        } catch (InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+            throw new CancellationException("Flow generation wait interrupted");
+        } catch (ExecutionException failure) {
+            throw new IllegalStateException("Flow generation failed", failure.getCause());
+        } finally {
+            task.cancel(true);
+        }
+    }
+
+    private void checkReadable(AiAuthorization.Caller caller, List<Operation> operations) {
+        checkCancelled();
+        for (var operation : operations) {
+            if (operation.resource() != Resource.FLOW) continue;
+            var decision = gate.authorize(caller.principal(), operation).block(Duration.ofSeconds(5));
+            if (decision == null || !decision.allowed()
+                || !operation.queryDomain().intersect(decision.scope()).resourceAllowed(operation.namespace(), operation.resourceId()))
+                throw AiAuthorization.denied();
+        }
+    }
+
+    private static void checkCancelled() {
+        if (Thread.currentThread().isInterrupted() || AiAuthorization.cancelled())
+            throw new CancellationException("Flow authoring cancelled");
+    }
+
+    private JsonNode declaration(String yaml) {
+        try {
+            var mapper = new ObjectMapper(new YAMLFactory()).enable(JsonParser.Feature.STRICT_DUPLICATE_DETECTION)
+                .enable(DeserializationFeature.FAIL_ON_TRAILING_TOKENS);
+            var node = mapper.readTree(yaml);
+            if (node == null || !node.isObject() || node.has("tenantId")) throw AiAuthorization.denied();
+            required(node, "id");
+            required(node, "namespace");
+            return node;
+        } catch (Exception failure) {
+            throw AiAuthorization.denied();
+        }
+    }
+
+    private String required(JsonNode node, String field) {
+        var value = node.get(field);
+        if (value == null || !value.isTextual() || value.asText().isBlank()) throw AiAuthorization.denied();
+        return value.asText();
+    }
