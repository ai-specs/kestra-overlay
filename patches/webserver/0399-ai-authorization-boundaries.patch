+import io.micronaut.core.propagation.PropagatedContext;
+import io.micronaut.core.propagation.PropagatedContextElement;
+
+/** Host validation may inspect dependency graphs, but must never expose an unreadable node. */
+public record AuthorizationValidationContext(NamespaceAccessControl access) implements PropagatedContextElement {
+    public static void requireReadable(String tenant,String namespace,String id) {
+        var context=PropagatedContext.getOrEmpty().find(AuthorizationValidationContext.class).orElse(null);
+        if(context!=null && !context.access.resourceReadAllowed(io.kestra.core.models.QueryFilter.Resource.FLOW,tenant,namespace,id))
+            throw new SecurityException("Flow validation references an unavailable resource");
+    }
+}
