+            FluxSink<Event<Object>> emitter = mock(FluxSink.class);
+            doAnswer(invocation -> {
+                events.add(((Event<?>) invocation.getArgument(0)).getName());
+                return emitter;
+            }).when(emitter).next(any());
+            doAnswer(invocation -> { completed.incrementAndGet(); return null; }).when(emitter).complete();
+            doAnswer(invocation -> { errors.add(invocation.getArgument(0)); return null; }).when(emitter).error(any());
+            Class<?> type = Class.forName(AiAgentController.class.getName() + "$FluxTurnEventSink");
+            Constructor<?> constructor = type.getDeclaredConstructor(FluxSink.class, AiAuthorization.class, AgentPrincipal.class);
+            constructor.setAccessible(true);
+            sink = (TurnEventSink) constructor.newInstance(emitter, authorization, null);
+            Field field = type.getDeclaredField("output");
+            field.setAccessible(true);
+            executor = (ExecutorService) field.get(sink);
+            cancel = type.getDeclaredMethod("markCancelled");
+            cancel.setAccessible(true);
+        }
