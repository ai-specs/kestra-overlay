+    @Singleton
+    @Requires(property = "ai.authorization.http.probe", value = "true")
+    static class TestTransportIdentity implements AuthenticationFetcher<io.micronaut.http.HttpRequest<?>> {
+        @Override
+        public org.reactivestreams.Publisher<Authentication> fetchAuthentication(io.micronaut.http.HttpRequest<?> request) {
+            String user = request.getHeaders().get("X-AI-Test-Transport");
+            return "alice".equals(user) || "bob".equals(user)
+                ? Mono.just(Authentication.build(user, List.of("ai-http-test"))) : Mono.empty();
+        }
+    }
+
+    @Singleton
+    @Requires(property = "ai.authorization.http.probe", value = "true")
+    static class ProbePolicy implements AuthorizationEvaluationProviderV1 {
+        final AtomicBoolean allowed = new AtomicBoolean(true);
+        final AtomicInteger begins = new AtomicInteger();
+        final AtomicInteger closes = new AtomicInteger();
+        final AtomicInteger toolOperations = new AtomicInteger();
+
+        @Override
+        public CompletionStage<AuthorizationEvaluationV1> begin(RbacAuthorizer.Principal principal, String tenant) {
+            begins.incrementAndGet();
+            boolean snapshot = allowed.get();
+            return CompletableFuture.completedFuture(new AuthorizationEvaluationV1() {
+                final AtomicBoolean closed = new AtomicBoolean();
+                @Override
+                public CompletionStage<Decision> authorize(Operation operation) {
+                    if (operation.resource() == Resource.FLOW) toolOperations.incrementAndGet();
+                    boolean identity = "main".equals(tenant) && ("alice".equals(principal.subject()) || "bob".equals(principal.subject()));
+                    Decision decision = Decision.deny("AI HTTP test policy denied");
+                    if (snapshot && identity) {
+                        if (operation.resource() == Resource.AI && List.of(Action.READ, Action.EXECUTE).contains(operation.action()))
+                            decision = Decision.allow(operation.queryDomain());
+                        else if (operation.resource() == Resource.FLOW && (operation.action() == Action.READ || operation.action() == Action.LIST)
+                            && (operation.namespace() == null || "company.a".equals(operation.namespace())))
+                            decision = Decision.allow(new QueryDomain(List.of("company.a"), List.of(), List.of(), true, operation.queryDomain().paginated()));
+                    }
+                    return CompletableFuture.completedFuture(decision);
+                }
+                @Override
+                public CompletionStage<Void> close() {
+                    if (!closed.compareAndSet(false, true)) return CompletableFuture.failedFuture(new AssertionError("Evaluation closed twice"));
+                    closes.incrementAndGet();
+                    return CompletableFuture.completedFuture(null);
+                }
+            });
+        }
+    }
+
+    private static final class ScriptedModel implements StreamingChatModel {
+        final BlockingQueue<AiMessage> responses = new LinkedBlockingQueue<>();
+        final AtomicBoolean waiting = new AtomicBoolean();
+        final AtomicInteger calls = new AtomicInteger();
+        volatile CountDownLatch started = new CountDownLatch(1);
+        volatile StreamingChatResponseHandler pending;
+        volatile RecordingHandle handle = new RecordingHandle();
+
+        void reset() {
+            responses.clear();
+            waiting.set(false);
+            calls.set(0);
+            started = new CountDownLatch(1);
+            pending = null;
+            handle = new RecordingHandle();
+        }
+
+        @Override
+        public void chat(ChatRequest request, StreamingChatResponseHandler handler) {
+            calls.incrementAndGet();
+            if (waiting.get()) {
+                pending = handler;
+                handler.onPartialResponse(new PartialResponse("waiting for test model"), new PartialResponseContext(handle));
+                started.countDown();
+                return;
+            }
+            AiMessage response = responses.poll();
+            if (response == null) {
+                handler.onError(new IllegalStateException("Missing scripted HTTP test response"));
+                return;
+            }
+            if (response.text() != null && !response.text().isEmpty()) handler.onPartialResponse(response.text());
+            handler.onCompleteResponse(ChatResponse.builder().aiMessage(response).build());
+        }
+    }
+
+    private static final class RecordingHandle implements StreamingHandle {
+        private volatile boolean cancelled;
+        @Override
+        public void cancel() { cancelled = true; }
+        @Override
+        public boolean isCancelled() { return cancelled; }
+    }
+}
