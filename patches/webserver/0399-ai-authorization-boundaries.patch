+        Sink first = new Sink();
+        var pool = Executors.newSingleThreadExecutor();
+        try {
+            var running = pool.submit(() -> run(thread, first));
+            assertThat(model.started.await(3, TimeUnit.SECONDS)).isTrue();
+            permitted.set(false);
+            model.waitForResponse.set(false);
+            model.completePending(writeRequest());
+            running.get(5, TimeUnit.SECONDS);
+            assertThat(reload(thread).status()).isEqualTo(AgentThreadStatus.AWAITING_CONFIRMATION);
+            assertThat(writes.get()).isZero();
+            model.enqueue(AiMessage.from("Permission denied after waiting."));
+            Sink confirmed = resume(thread, true);
+            assertThat(outcome(confirmed)).isEqualTo("rejected");
+            assertThat(writeDecisions.getLast()).isFalse();
+            assertThat(writes.get()).isZero();
