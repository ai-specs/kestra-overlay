+            await lifecycle.dispose();
+            history.destroy();
+            window.history.replaceState(originalState, "", original);
+        }
+    });
+    it("does not let an unresolved extension guard veto host public safety navigation", async () => {
+        const lifecycle = new ExtensionLifecycle(document.createElement("div"), vi.fn());
+        const guard = vi.fn(() => new Promise<boolean>(() => {}));
+        await lifecycle.start(async () => ({contractVersion: 1, mount: () => ({update() {}, unmount() {}, beforeNavigate: guard})}), {} as UiExtensionContextV1);
+        const router = createRouter({history: createMemoryHistory(), routes: [
+            {path: "/editor", component: {render: () => null}},
+            {path: "/public-safety", component: {render: () => null}, meta: {anonymous: true}},
+        ]});
+        await router.push("/editor");
+        guardExtensionNavigation(router, () => lifecycle);
+        const pending = lifecycle.beforeNavigate({fullPath: "/pending", extensionPath: null, query: {}});
+        await vi.waitFor(() => expect(guard).toHaveBeenCalledOnce());
+        await router.push("/public-safety");
+        expect(router.currentRoute.value.path).toBe("/public-safety");
+        expect(lifecycle.signal.aborted).toBe(true);
+        const allowed = await pending;
+        expect(allowed).toBe(false);
+        checkProbeCase("safety-abort", {aborted: lifecycle.signal.aborted, allowed});
+        expect(guard).toHaveBeenCalledOnce();
+    });
+});
