+import {createShadowOverlayScope, createShadowRenderer, deepActiveElement, shadowOverlayComponents} from "../../../webserver/src/main/resources/META-INF/kestra/ui-sdk/v1/shadow-overlays.mjs";
+import {checkProbeCase} from "../../../webserver/src/main/resources/META-INF/kestra/ui-sdk/v1/probe-matrix.mjs";
+
+const cleanups: (() => void)[] = [];
+afterEach(() => {while (cleanups.length) cleanups.pop()!(); vi.restoreAllMocks(); document.body.replaceChildren();});
+
+function fixture() {
+    const container = document.createElement("div");
+    document.body.append(container);
+    const root = container.attachShadow({mode: "open"});
+    const content = document.createElement("main");
+    const trigger = document.createElement("button");
+    const fallback = document.createElement("h1");
+    fallback.tabIndex = -1;
+    content.append(trigger, fallback);
+    const portal = document.createElement("div");
+    root.append(content, portal);
+    const controller = new AbortController();
+    const scope = createShadowOverlayScope({container, content, portal, signal: controller.signal, fallback: () => fallback});
+    cleanups.push(() => scope.dispose());
+    vi.spyOn(HTMLElement.prototype, "getClientRects").mockReturnValue([{}] as unknown as DOMRectList);
+    return {container, content, portal, root, trigger, fallback, controller, scope};
+}
+
+// Resolve the two published style forms numerically so the unchanged +8 baseline
+// is checked as geometry, not rejected merely because the old helper used calc().
+function mobileStyle(sheet: HTMLElement) {
+    const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
+    const oldTop = /^calc\((-?[\d.]+)px \+ var\(--ks-spacing-2\)\)$/.exec(sheet.style.top);
+    const oldHeight = /^min\(75vh, calc\(100vh - (-?[\d.]+)px - var\(--ks-spacing-2\)\)\)$/.exec(sheet.style.maxHeight);
+    return {top: oldTop ? Number(oldTop[1]) + 8 : parseFloat(sheet.style.top),
+        height: oldHeight ? Math.max(0, Math.min(viewportHeight * .75, viewportHeight - Number(oldHeight[1]) - 8)) : parseFloat(sheet.style.maxHeight)};
+}
+
+describe("pinned overlay shadow compatibility", () => {
+    it("reproduces native document focus retargeting and restores a deep trigger instead", () => {
+        const current = fixture();
+        current.trigger.focus();
+        expect(document.activeElement).toBe(current.container);
+        expect(deepActiveElement()).toBe(current.trigger);
+        const modal = document.createElement("section");
+        const input = document.createElement("input");
+        modal.append(input);
+        current.portal.append(modal);
+        const release = current.scope.activate(modal, vi.fn());
+        expect(deepActiveElement()).toBe(input);
+        release();
+        expect(deepActiveElement()).toBe(current.trigger);
+        expect(current.content.inert).not.toBe(true);
+    });
