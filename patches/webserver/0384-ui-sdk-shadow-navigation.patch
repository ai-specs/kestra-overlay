+        await router.push("/items?key=first");
+        guardExtensionNavigation(router, () => lifecycle);
+        guard.mockResolvedValue(false);
+        await router.push("/items?key=second");
+        expect(router.currentRoute.value.fullPath).toBe("/items?key=first");
+        let finish!: (allowed: boolean) => void;
+        guard.mockImplementationOnce(() => new Promise<boolean>(resolve => {finish = resolve;}));
+        const pending = router.push("/host");
+        await vi.waitFor(() => expect(finish).toBeTypeOf("function"));
+        expect(await lifecycle.beforeNavigate({fullPath: "/concurrent", extensionPath: null, query: {}})).toBe(false);
+        finish(true);
+        await pending;
+        expect(router.currentRoute.value.path).toBe("/host");
+        guard.mockRejectedValueOnce(new Error("guard failure"));
+        await router.replace("/failure");
+        expect(router.currentRoute.value.path).toBe("/host");
+        expect(error).toHaveBeenCalledOnce();
+        guard.mockImplementationOnce(() => new Promise<boolean>(resolve => {finish = resolve;}));
+        const leaving = lifecycle.beforeNavigate({fullPath: "/late", extensionPath: null, query: {}});
+        await vi.waitFor(() => expect(guard).toHaveBeenCalledTimes(4));
+        await lifecycle.dispose();
+        expect(await leaving).toBe(false);
+        finish(true);
+    });
