+export const probeMatrix = Object.freeze([
+    {id: "portal", unit: "shadow-overlays.spec.ts", actions: "Open each of four drawers; inspect owned portal and document", expected: "No document overlay; modal remains inside the extension root"},
+    {id: "popup-escape", unit: "shadow-overlays.spec.ts", actions: "Open multi-select, choose Second, press Escape from selected tag", expected: "Select closes; drawer and dirty draft remain; no confirmation"},
+    {id: "discard-cancel", unit: "shadow-overlays.spec.ts", actions: "Dirty draft; Escape; cancel discard", expected: "Confirmation closes; drawer, draft and trigger focus remain"},
+    {id: "save-lock", unit: "shadow-overlays.spec.ts", actions: "Change draft; save; attempt Escape and host navigation while saving", expected: "No close or navigation until save completes; changed value saved once"},
+    {id: "focus-return", unit: "shadow-overlays.spec.ts", actions: "Close top dialog then drawer; remove trigger and repeat", expected: "Deep trigger focus restored, or the configured fallback"},
+    {id: "query", unit: "navigation.spec.ts", actions: "Navigate with repeated, empty, null and encoded query values", expected: "Address and context agree; immutable query preserves values"},
+    {id: "leave-cancel", unit: "navigation.spec.ts", actions: "Dirty draft; click host menu; cancel discard", expected: "Host URL, extension route and draft remain unchanged"},
+    {id: "popstate-cancel", unit: "navigation.spec.ts", actions: "Push second route; dirty draft; browser Back; cancel; retry and accept", expected: "Canceled Back restores address and context; accepted Back reaches first route"},
+    {id: "safety-abort", unit: "navigation.spec.ts", actions: "Leave a guard pending; force host disposal or host public safety route", expected: "Signal aborts, pending navigation settles false, effects disappear"},
+    {id: "unmount", unit: "shadow-overlays.spec.ts", actions: "Unmount while select/dialog is open; press Escape; remount", expected: "No shadow content, document overlay, scroll lock or old focus listener"},
+    {id: "preferences", unit: null, actions: "13 locales; light/dark/dark-2/system; 390/768/1280 widths; system color changes", expected: "Real computed styles, translated shared labels and layout match the selected preferences"},
+    {id: "filter", unit: null, actions: "Use native KsFilter key/value/comparator controls; apply and remove chips; refresh; Back", expected: "All filter portals stay owned; real query and filtered generic rows agree"},
+]);
+
+export function checkProbeCase(id, actual) {
+    const require = (condition, message) => {if (!condition) throw new Error(`${id}: ${message}`);};
+    require(probeMatrix.some(row => row.id === id), "Unknown case");
+    if (id === "portal") {require(actual.documentDialogs === 0, "Document modal leaked"); require(actual.portalDialogs > 0, "Owned modal missing");}
+    else if (id === "popup-escape") {require(actual.popupOpen === false, "Popup did not close"); require(actual.drawerCloseCalls === 0, "Same Escape reached drawer");}
+    else if (id === "discard-cancel") {require(actual.draft === actual.expectedDraft && actual.confirmation === false && actual.opened !== null, "Draft or drawer lost on cancel");}
+    else if (id === "save-lock") {require(actual.saving === true && actual.opened !== null && actual.confirmation === false, "Save confinement failed");}
+    else if (id === "focus-return") require(actual.focus === actual.expectedFocus, "Deep focus was not restored");
+    else if (id === "query") require(actual.fullPath === actual.expectedFullPath && JSON.stringify(actual.query) === JSON.stringify(actual.expectedQuery), "Query or address mismatch");
+    else if (id === "leave-cancel" || id === "popstate-cancel") require(actual.fullPath === actual.expectedFullPath && actual.draft === actual.expectedDraft, "Canceled navigation changed route or draft");
+    else if (id === "safety-abort") require(actual.aborted === true && actual.allowed === false, "Safety abort was blocked");
+    else if (id === "unmount") require(actual.shadowNodes === 0 && actual.documentDialogs === 0 && actual.disposed === true, "Unmount left live nodes");
+    else if (id === "preferences") require(actual.computedStylesVerified === true && actual.translationsVerified === true && actual.viewportVerified === true, "Real preference evidence missing");
+    else if (id === "filter") require(actual.ownedPortalsVerified === true && actual.queryVerified === true && actual.rowsVerified === true, "Real filter evidence missing");
+    return {id, passed: true};
+}
