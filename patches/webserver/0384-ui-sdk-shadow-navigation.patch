+        const router = createRouter({history, routes: [{path: "/:pathMatch(.*)*", component: {render: () => null}}]});
+        const guard = vi.fn().mockResolvedValue(false);
+        const lifecycle = new ExtensionLifecycle(document.createElement("div"), vi.fn());
+        try {
+            await router.push("/first?value=one");
+            await router.push("/second?value=two");
+            await lifecycle.start(async () => ({contractVersion: 1, mount: () => ({update() {}, unmount() {}, beforeNavigate: guard})}), {} as UiExtensionContextV1);
+            const remove = guardExtensionNavigation(router, () => lifecycle);
+            window.history.back();
