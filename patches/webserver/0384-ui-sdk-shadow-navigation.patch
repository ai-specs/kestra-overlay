+            await vi.waitFor(() => expect(window.location.pathname + window.location.search).toBe("/second?value=two"));
+            expect(router.currentRoute.value.fullPath).toBe("/second?value=two");
+            guard.mockResolvedValue(true);
+            window.history.back();
+            await vi.waitFor(() => expect(router.currentRoute.value.fullPath).toBe("/first?value=one"));
+            expect(window.location.pathname + window.location.search).toBe("/first?value=one");
