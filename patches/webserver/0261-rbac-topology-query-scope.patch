+++ b/webserver/src/test/java/io/kestra/webserver/rbac/TypedTopologyScopeTest.java
@@ -0,0 +1,41 @@
+package io.kestra.webserver.rbac;
+
+import java.sql.DriverManager;
+import java.util.List;
+import io.kestra.core.models.AccessScope;
+import io.kestra.core.repositories.NamespaceAccessControl;
+import io.kestra.jdbc.repository.AbstractJdbcFlowTopologyRepository;
+import org.jooq.Condition;
+import org.jooq.SQLDialect;
+import org.jooq.impl.DSL;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class TypedTopologyScopeTest {
+    @Test
+    void shouldRequireBothTopologyOwnersInsideScopeBeforeQuery() throws Exception {
+        var repository = new AbstractJdbcFlowTopologyRepository(null) {
+            @Override
+            protected NamespaceAccessControl namespaceAccessControl() {
+                return resource -> AccessScope.namespaces(List.of(), List.of("team"));
+            }
+        };
+        var method = AbstractJdbcFlowTopologyRepository.class.getDeclaredMethod("topologyAccess");
+        method.setAccessible(true);
+        Condition condition = (Condition) method.invoke(repository);
+        try (var connection = DriverManager.getConnection("jdbc:h2:mem:;DATABASE_TO_LOWER=TRUE")) {
+            var sql = DSL.using(connection, SQLDialect.H2);
+            sql.execute("create table topology (source_namespace varchar(255), destination_namespace varchar(255))");
+            for (String source : List.of("team", "team.child", "other")) {
+                for (String destination : List.of("team", "team.child", "other")) {
+                    sql.insertInto(DSL.table("topology"), DSL.field("source_namespace"), DSL.field("destination_namespace"))
+                        .values(source, destination).execute();
+                }
+            }
+            assertThat(sql.selectCount().from("topology").where(condition).fetchOne(0, Integer.class)).isEqualTo(1);
+            assertThat(sql.select(DSL.field("source_namespace", String.class)).from("topology").where(condition).fetch(0, String.class))
+                .containsExactly("team");
+        }
+    }
+}
