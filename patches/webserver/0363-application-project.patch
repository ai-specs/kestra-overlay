+    private Snapshot mutate(String project, long expected, BiFunction<Connection, Snapshot, Snapshot> change) {
+        var identity = requireIdentity().current();
+        return transaction(connection -> {
+            lock(connection);
+            authorize(connection, identity, project, ApplicationGroupManagementV1.Action.MANAGE);
+            Snapshot old = find(connection, project).orElseThrow(() -> failure(Failure.NOT_FOUND));
+            if (expected <= 0 || expected != Long.MAX_VALUE && old.project().revision() != expected) throw failure(Failure.CONFLICT);
+            Snapshot candidate = change.apply(connection, old);
+            var previous = candidate.project();
+            Project bumped = new Project(previous.id(), previous.tenant(), previous.issuer(), previous.displayName(), previous.active(),
+                Math.addExact(old.project().revision(), 1), Math.addExact(old.project().authorizationVersion(), 1));
+            candidate = new Snapshot(bumped, candidate.scopes(), candidate.memberships(), candidate.assignments(), bumped.revision());
+            validateUniqueClients(connection, candidate);
+            var knownProjects = new HashSet<String>();
+            for (var state : all(connection)) knownProjects.add(state.project().id());
+            validateTargets(candidate, knownProjects);
+            var states = new ArrayList<>(all(connection));
+            states.removeIf(value -> value.project().id().equals(project));
+            states.add(candidate);
+            if (hasAdministrator(connection, all(connection), null) && !hasAdministrator(connection, states, null)) throw failure(Failure.LAST_ADMIN);
+            save(connection, candidate);
+            return candidate;
+        });
+    }
