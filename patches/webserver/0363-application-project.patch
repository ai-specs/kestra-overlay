+package io.kestra.webserver.oidc.projects;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.kestra.webserver.oidc.ApplicationDirectoryV1;
+import io.kestra.webserver.oidc.ApplicationGroupManagementV1;
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.kestra.webserver.oidc.TrustedIdentityV1;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.context.BeanProvider;
+import jakarta.inject.Singleton;
+import javax.sql.DataSource;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.Set;
+import java.util.HashSet;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.function.BiFunction;
+
+@Singleton
+@Requires(property = "kestra.oidc.enabled", value = "true")
+@Requires(property = "kestra.repository.type", value = "postgres")
+public final class JdbcApplicationDirectoryV1 implements ApplicationDirectoryV1, ProjectDirectoryState {
+    private final DataSource source;
+    private final BeanProvider<TrustedIdentityV1> identities;
+    private final BeanProvider<ApplicationGroupManagementV1> management;
+    private final OidcConfiguration configuration;
+    private final ObjectMapper mapper;
+    private final DirectorySnapshotCodec codec = new DirectorySnapshotCodec();
+
+    public JdbcApplicationDirectoryV1(DataSource source, TrustedIdentityV1 identities,
+                                      OidcConfiguration configuration, ObjectMapper mapper) {
+        this(source, new DirectIdentityProvider(identities), new MissingManagementProvider(), configuration, mapper);
+    }
+
+    public JdbcApplicationDirectoryV1(DataSource source, TrustedIdentityV1 identities,
+                                      ApplicationGroupManagementV1 management,
+                                      OidcConfiguration configuration, ObjectMapper mapper) {
+        this(source, new DirectIdentityProvider(identities), new DirectManagementProvider(management), configuration, mapper);
+    }
+
+    @jakarta.inject.Inject
+    public JdbcApplicationDirectoryV1(DataSource source, BeanProvider<TrustedIdentityV1> identities,
+                                      BeanProvider<ApplicationGroupManagementV1> management,
+                                      OidcConfiguration configuration, ObjectMapper mapper) {
+        this.source = Objects.requireNonNull(source);
+        this.identities = Objects.requireNonNull(identities);
+        this.management = Objects.requireNonNull(management);
+        this.configuration = Objects.requireNonNull(configuration);
+        this.mapper = Objects.requireNonNull(mapper);
+    }
+
+    public void initializeSchema() {
+        transaction(connection -> {
+            lock(connection);
+            try (var input = JdbcApplicationDirectoryV1.class.getResourceAsStream("/migrations/2.0.101-oidc-application-directory-postgres.sql")) {
+                if (input == null) throw new IllegalStateException("Directory migration resource is missing");
+                String sql = new String(input.readAllBytes(), StandardCharsets.UTF_8);
+                try (var statement = connection.createStatement()) {
+                    statement.setQueryTimeout(5);
+                    for (String command : sql.split(";")) if (!command.isBlank()) statement.execute(command);
+                }
+            } catch (java.io.IOException failure) {
+                throw new IllegalStateException("Directory migration resource cannot be read", failure);
+            }
+            return null;
+        });
+    }
+
+    public static String migrationChecksum() {
+        try (var input = JdbcApplicationDirectoryV1.class.getResourceAsStream("/migrations/2.0.101-oidc-application-directory-postgres.sql")) {
+            if (input == null) throw new IllegalStateException("Directory migration resource is missing");
+            return java.util.HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(input.readAllBytes()));
+        } catch (Exception failure) { throw new IllegalStateException("Cannot checksum directory migration", failure); }
+    }
+
+    public static void lock(Connection connection) throws SQLException {
+        try (var statement = connection.prepareStatement("SELECT pg_advisory_xact_lock(1380073797)")) {
+            statement.setQueryTimeout(5);
+            statement.execute();
+        }
+    }
+
+    public String previewBootstrap(ApplicationDirectoryBootstrap.Plan plan, java.nio.file.Path receiptPath, String registeredUiClientId) {
+        String installation = new io.kestra.webserver.oidc.services.OidcInstallationReceipt(receiptPath).read().orElseThrow(() -> failure(Failure.FORBIDDEN));
+        require(installation.equals(plan.installationId()) && registeredUiClientId.equals(plan.uiClientId()));
+        return transaction(connection -> {
+            lock(connection);
+            if (activated(connection)) throw failure(Failure.CONFLICT);
+            verifyInstallation(connection, installation);
+            verifyRegisteredUiClient(connection, registeredUiClientId);
+            var source = all(connection);
+            require(source.stream().mapToLong(value -> value.project().revision()).sum() == plan.sourceRevision());
+            require(ApplicationDirectoryBootstrap.sourceHash(source).equals(plan.sourceHash()));
+            validatePlan(connection, plan, registeredUiClientId);
+            var report = mapper.createObjectNode();
+            report.set("plan", mapper.valueToTree(plan));
+            report.set("source", mapper.valueToTree(source));
+            report.put("approvalHash", ApplicationDirectoryBootstrap.approvalHash(plan));
+            report.put("installationId", installation);
+            return report.toString();
+        });
+    }
+
+    private void validatePlan(Connection connection, ApplicationDirectoryBootstrap.Plan plan, String registeredUiClientId) throws SQLException {
+        require(plan != null && !plan.projects().isEmpty());
+        Set<String> projectIds = new HashSet<>(); Set<String> clientIds = new HashSet<>(); boolean firstParty = false;
+        for (var state : plan.projects()) {
+            validateSnapshot(state); require(projectIds.add(state.project().id()));
+            for (var member : state.memberships()) {
+                require(clientIds.add(member.clientId())); requireClient(connection, member.clientId());
+                if (member.firstPartyUi()) { require(member.clientId().equals(registeredUiClientId) && member.approved()); firstParty = true; }
+            }
+            for (var assignment : state.assignments()) requireSubject(connection, assignment.subject());
+        }
+        Set<String> knownProjects = Set.copyOf(projectIds);
+        for (var state : plan.projects()) validateTargets(state, knownProjects);
+        require(firstParty && hasBootstrapOwner(connection, plan.projects()));
+    }
+
+    public void applyBootstrap(ApplicationDirectoryBootstrap.Plan plan, String approvedHash,
+                               java.nio.file.Path receiptPath, String registeredUiClientId) {
+        String installation = new io.kestra.webserver.oidc.services.OidcInstallationReceipt(receiptPath).read()
+            .orElseThrow(() -> failure(Failure.FORBIDDEN));
+        require(plan != null && installation.equals(plan.installationId()) && registeredUiClientId.equals(plan.uiClientId()));
+        require(ApplicationDirectoryBootstrap.approvalHash(plan).equals(approvedHash));
+        transaction(connection -> {
+            lock(connection);
+            if (activated(connection)) throw failure(Failure.CONFLICT);
+            verifyInstallation(connection, installation);
+            verifyRegisteredUiClient(connection, registeredUiClientId);
+            validatePlan(connection, plan, registeredUiClientId);
+            var existing = all(connection);
+            if (!ApplicationDirectoryBootstrap.sourceHash(existing).equals(plan.sourceHash())) throw failure(Failure.CONFLICT);
+            long revision = existing.stream().mapToLong(value -> value.project().revision()).sum();
+            if (revision != plan.sourceRevision()) throw failure(Failure.CONFLICT);
+            require(!plan.projects().isEmpty());
+            Set<String> projects = new HashSet<>();
+            Set<String> clients = new HashSet<>();
+            boolean hasUi = false;
+            for (var state : plan.projects()) {
+                validateSnapshot(state);
+                require(projects.add(state.project().id()));
+                for (var member : state.memberships()) {
+                    require(clients.add(member.clientId()));
+                    requireClient(connection, member.clientId());
+                    if (member.firstPartyUi()) {
+                        require(member.clientId().equals(registeredUiClientId) && member.approved());
+                        hasUi = true;
+                    }
+                }
+                for (var assignment : state.assignments()) requireSubject(connection, assignment.subject());
+            }
+            Set<String> knownProjects = new HashSet<>();
+            for (var state : plan.projects()) knownProjects.add(state.project().id());
+            for (var state : plan.projects()) validateTargets(state, knownProjects);
+            require(hasUi && hasBootstrapOwner(connection, plan.projects()));
+            try (var statement = connection.createStatement()) { statement.executeUpdate("DELETE FROM oidc_project_state"); }
+            for (var state : plan.projects()) save(connection, state);
+            try (var statement = connection.prepareStatement("INSERT INTO oidc_project_bootstrap(singleton,approval_hash,receipt_hash,source_revision,ui_client_id,consumed) VALUES(1,?,?,?,?,TRUE)")) {
+                statement.setString(1, approvedHash);
+                statement.setString(2, ApplicationDirectoryBootstrap.digest(installation));
+                statement.setLong(3, plan.sourceRevision());
+                statement.setString(4, registeredUiClientId);
+                statement.executeUpdate();
+            }
+            try (var statement = connection.createStatement()) {
+                statement.executeUpdate("UPDATE oidc_token SET revoked=TRUE");
+                statement.executeUpdate("UPDATE oidc_authorization_code SET used=TRUE");
+                statement.executeUpdate("UPDATE oidc_user SET authentication_version=authentication_version+1");
+            }
+            invalidateCredentials(connection, 1, 1);
+            return null;
+        });
+    }
+
+    private void verifyInstallation(Connection connection, String id) throws SQLException {
+        try (var statement = connection.prepareStatement("SELECT installation_id FROM oidc_setup WHERE singleton=true FOR UPDATE")) {
+            try (var result = statement.executeQuery()) {
+                if (!result.next() || !id.equals(result.getString(1))) throw failure(Failure.FORBIDDEN);
+            }
+        }
+    }
+
+    private void verifyRegisteredUiClient(Connection connection, String id) throws SQLException {
+        try (var statement = connection.prepareStatement("SELECT client_kind,client_secret,active FROM oidc_client WHERE client_id=? FOR UPDATE")) {
+            statement.setString(1, id);
+            try (var result = statement.executeQuery()) {
+                if (!result.next() || !"system".equals(result.getString(1)) || result.getString(2) == null
+                    || result.getString(2).isBlank() || !result.getBoolean(3)) throw failure(Failure.FORBIDDEN);
+            }
+        }
+    }
+
+    @Override
+    public Snapshot snapshot(String projectId) {
+        return transaction(connection -> find(connection, projectId).orElseThrow(() -> failure(Failure.NOT_FOUND)));
+    }
+    @Override
+    public Optional<Snapshot> forClient(String clientId) {
+        return transaction(connection -> forClient(connection, clientId));
+    }
+
+    @Override
+    public Optional<Snapshot> forClient(Connection connection, String clientId) throws SQLException {
+        Snapshot found = null;
+        for (Snapshot state : all(connection)) {
+            boolean belongs = state.memberships().stream().anyMatch(member -> member.clientId().equals(clientId));
+            if (belongs) {
+                if (found != null) throw failure(Failure.CONFLICT);
+                found = state;
+            }
+        }
+        return Optional.ofNullable(found);
+    }
+
+    @Override
+    public Invalidation invalidation() {
+        return transaction(connection -> {
+            try (var statement = connection.prepareStatement("SELECT authentication_version, authorization_version FROM oidc_project_invalidation WHERE singleton=1")) {
+                try (var result = statement.executeQuery()) {
+                    if (!result.next()) return new Invalidation(0, 0);
+                    return new Invalidation(result.getLong(1), result.getLong(2));
+                }
+            }
+        });
+    }
+
+    public Invalidation invalidateCredentials(Connection connection, long authenticationVersion, long authorizationVersion) throws SQLException {
+        if (authenticationVersion < 0 || authorizationVersion < 0) throw failure(Failure.INVALID);
+        try (var statement = connection.prepareStatement("INSERT INTO oidc_project_invalidation(singleton,authentication_version,authorization_version) VALUES(1,?,?) ON CONFLICT(singleton) DO UPDATE SET authentication_version=EXCLUDED.authentication_version, authorization_version=EXCLUDED.authorization_version, updated_at=now()")) {
+            statement.setLong(1, authenticationVersion); statement.setLong(2, authorizationVersion); statement.executeUpdate();
+        }
+        return new Invalidation(authenticationVersion, authorizationVersion);
+    }
+
+    @Override
+    public boolean activated() { return transaction(this::activated); }
+
+    @Override
+    public boolean activated(Connection connection) throws SQLException {
+        try (var statement = connection.prepareStatement("SELECT singleton FROM oidc_project_bootstrap WHERE singleton=1")) {
+            statement.setQueryTimeout(5);
+            try (var result = statement.executeQuery()) { return result.next(); }
+        }
+    }
+
+    @Override
+    public Page<Project> projects(int page, int size) {
+        return transaction(connection -> page(all(connection).stream().map(Snapshot::project).toList(), page, size));
+    }
+
+    @Override
+    public Optional<Project> project(String id) {
+        return transaction(connection -> find(connection, id).map(Snapshot::project));
+    }
+
+    @Override
+    public Project createProject(ProjectInput input) {
+        var identity = requireIdentity().current();
+        return transaction(connection -> {
+            lock(connection);
+            require(input != null && "main".equals(input.tenant()) && input.displayName() != null);
+            require(input.id() != null && input.id().matches("[A-Za-z0-9][A-Za-z0-9_-]{0,127}"));
+            authorize(connection, identity, input.id(), ApplicationGroupManagementV1.Action.MANAGE);
+            if (find(connection, input.id()).isPresent()) throw failure(Failure.CONFLICT);
+            Project project = new Project(input.id(), "main", configuration.getIssuer(), input.displayName(), true, 1, 1);
+            save(connection, new Snapshot(project, List.of(), List.of(), List.of(), 1));
+            return project;
+        });
