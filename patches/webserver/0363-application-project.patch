+    @Override
+    public List<PolicyBoundary> policyBoundaries() {
+        return transaction(connection -> {
+            lock(connection);
+            var projections = new ArrayList<PolicyBoundary>();
+            for (var state : all(connection)) {
+                Set<String> audiences = new HashSet<>();
+                Set<String> reachable = new HashSet<>();
+                for (var member : state.memberships()) {
+                    if (member.approved() && isActiveClient(connection, member.clientId())) audiences.addAll(member.audiences());
+                }
+                if (state.project().active()) for (var assignment : state.assignments()) {
+                    if (!isActiveSubject(connection, assignment.subject())) continue;
+                    for (var member : state.memberships()) {
+                        if (!member.firstPartyUi() || !member.approved() || !canLogin(connection, member, assignment.subject())) continue;
+                        var available = availableScopes(state, assignment, member);
+                        for (String scope : available) if (canReach(state, assignment, member, Set.of(scope))) reachable.add(scope);
+                    }
+                }
+                projections.add(new PolicyBoundary(state.project(), state.scopes(), audiences, reachable, protocolScopes()));
+            }
+            return List.copyOf(projections);
+        });
+    }
