+    private boolean hasBootstrapOwner(Connection connection, List<Snapshot> states) throws SQLException {
+        for (var state : states) if (state.project().active()) {
+            for (var assignment : state.assignments()) if (isActiveSubject(connection, assignment.subject())) {
+                for (var member : state.memberships()) if (member.firstPartyUi() && member.approved()
+                    && canLogin(connection, member, assignment.subject())
+                    && !availableScopes(state, assignment, member).isEmpty()) return true;
+            }
+        }
+        return false;
+    }
