+    private void validateScope(ScopeInput input) {
+        require(input != null && input.description() != null && input.resourceIntents() != null && input.managementIntents() != null
+            && (!input.resourceIntents().isEmpty() || !input.managementIntents().isEmpty()));
+        new ScopeDefinition("validation", input.scope(), input.name(), input.description(), input.active(), input.resourceIntents(), input.managementIntents(), 1);
+        require(protocolScopes().stream().noneMatch(protocol -> protocol.scope().equals(input.scope())));
+        Set<String> resources = Set.of("FLOW", "EXECUTION", "TRIGGER", "NAMESPACE", "KVSTORE", "SECRET", "NAMESPACE_FILE", "LOG", "METRIC", "DASHBOARD", "BLUEPRINT", "AI", "MCP_SERVER", "METADATA");
