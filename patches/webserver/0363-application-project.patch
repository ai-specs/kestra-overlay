+            && effectiveTargets(bound, previous.projectId()).containsAll(effectiveTargets(intent, previous.projectId())))) return false;
+        for (var intent : input.resourceIntents()) if (previous.resourceIntents().stream().noneMatch(bound -> resourceCovered(bound, intent))) return false;
+        return true;
