+        try (var statement = connection.prepareStatement("SELECT client_secret, active FROM oidc_client WHERE client_id=? FOR UPDATE")) {
+            statement.setString(1, clientId); statement.setQueryTimeout(5);
+            try (var rows = statement.executeQuery()) { return rows.next() && rows.getBoolean(2) && rows.getString(1) != null && !rows.getString(1).isBlank(); }
+        }
+    }
+
+    private boolean canLogin(Connection connection, ClientMembership membership, String subject) throws SQLException {
+        try (var statement = connection.prepareStatement("SELECT active,client_kind,owner_subject,client_secret,grant_types::text,redirect_uris::text FROM oidc_client WHERE client_id=?")) {
+            statement.setQueryTimeout(5);
+            statement.setString(1, membership.clientId());
+            try (var result = statement.executeQuery()) {
+                if (!result.next() || !result.getBoolean(1)) return false;
+                String kind = result.getString(2);
+                boolean owner = "owned".equals(kind) && subject.equals(result.getString(3));
+                boolean system = false;
+                if ("system".equals(kind) && result.getString(4) != null && !result.getString(4).isBlank()) {
+                    try (var receipt = connection.prepareStatement("SELECT ui_client_id FROM oidc_project_bootstrap WHERE singleton=1 AND consumed=TRUE")) {
+                        try (var row = receipt.executeQuery()) { system = row.next() && membership.clientId().equals(row.getString(1)); }
+                    }
+                    // Before activation the approved plan itself supplies the registered UI membership.
+                    if (!activated(connection)) system = membership.firstPartyUi();
+                }
+                if (!owner && !system) return false;
+                try {
+                    var grants = mapper.readTree(result.getString(5));
+                    var redirects = mapper.readTree(result.getString(6));
+                    if (!grants.isArray() || !redirects.isArray() || redirects.isEmpty()) return false;
+                    boolean code = false;
+                    for (var grant : grants) if ("authorization_code".equals(grant.asText())) code = true;
+                    for (var redirect : redirects) {
+                        var uri = java.net.URI.create(redirect.asText());
+                        if (!uri.isAbsolute() || uri.getFragment() != null) return false;
+                    }
+                    return code && !membership.audiences().isEmpty();
+                } catch (java.io.IOException | IllegalArgumentException invalid) { return false; }
+            }
+        }
+    }
+
+    private boolean isActiveClient(Connection connection, String client) throws SQLException {
+        try (var statement = connection.prepareStatement("SELECT active FROM oidc_client WHERE client_id=? FOR UPDATE")) {
+            statement.setQueryTimeout(5);
+            statement.setString(1, client);
+            try (var rows = statement.executeQuery()) { return rows.next() && rows.getBoolean(1); }
+        }
+    }
+    private void requireClient(Connection connection, String client) {
+        try (var statement = connection.prepareStatement("SELECT active FROM oidc_client WHERE client_id=? FOR UPDATE")) {
+            statement.setQueryTimeout(5);
+            statement.setString(1, client);
+            try (var rows = statement.executeQuery()) { require(rows.next() && rows.getBoolean(1)); }
+        } catch (SQLException unavailable) { throw failure(Failure.UNAVAILABLE); }
+    }
+    private record DirectIdentityProvider(TrustedIdentityV1 value) implements BeanProvider<TrustedIdentityV1> {
+        public boolean isUnique() { return true; }
+        public TrustedIdentityV1 get() { return value; }
+    }
+
+    private record DirectManagementProvider(ApplicationGroupManagementV1 value) implements BeanProvider<ApplicationGroupManagementV1> {
+        public boolean isUnique() { return true; }
+        public ApplicationGroupManagementV1 get() { return value; }
+    }
+
+    private static final class MissingManagementProvider implements BeanProvider<ApplicationGroupManagementV1> {
+        public boolean isUnique() { return false; }
+        public ApplicationGroupManagementV1 get() { throw new IllegalStateException("Application group management is unavailable"); }
+    }
+
+    private static void exact(String value) { require(value != null && !value.isBlank() && value.equals(value.trim()) && !value.contains("*") && value.chars().noneMatch(Character::isISOControl)); }
+    private static void require(boolean condition) { if (!condition) throw failure(Failure.INVALID); }
+    private static DirectoryException failure(Failure failure) { return new DirectoryException(failure); }
+    private static <T> Page<T> page(List<T> values, int page, int size) {
+        require(page > 0 && size > 0 && size <= 100);
+        long offset = (long) (page - 1) * size;
+        return new Page<>(offset >= values.size() ? List.of() : values.subList((int) offset, (int) Math.min(values.size(), offset + size)), values.size(), page, size);
+    }
+    private interface Work<T> { T run(Connection connection) throws SQLException; }
+    private <T> T transaction(Work<T> work) {
+        try (var connection = source.getConnection()) {
+            connection.setAutoCommit(false); connection.setTransactionIsolation(Connection.TRANSACTION_READ_COMMITTED);
+            try { T result = work.run(connection); connection.commit(); return result; }
+            catch (SQLException | RuntimeException failure) { connection.rollback(); throw failure; }
+        } catch (SQLException failure) { throw failure(Failure.UNAVAILABLE); }
+    }
+}
