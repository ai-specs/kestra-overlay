+    private void validateTargets(Snapshot state, Set<String> knownProjects) {
+        for (var scope : state.scopes()) for (var intent : scope.managementIntents()) {
+            require(intent.domain() == ManagementDomain.LOCAL_POLICY || intent.projectIds().isEmpty());
