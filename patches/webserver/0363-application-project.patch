+            require(!member.audiences().isEmpty() && scopes.containsAll(member.allowedProjectScopes()));
+            member.audiences().forEach(JdbcApplicationDirectoryV1::exact);
+        }
+        Set<String> subjects = new HashSet<>();
+        for (var assignment : state.assignments()) {
+            require(assignment.projectId().equals(state.project().id()) && assignment.issuer().equals(state.project().issuer()));
