+    public void guardSubjectDeactivation(Connection connection, String issuer, String subject) throws SQLException {
+        lock(connection);
+        if (!configuration.getIssuer().equals(issuer)) throw failure(Failure.INVALID);
+        if (!activated(connection)) return;
+        var states = all(connection);
+        if (hasAdministrator(connection, states, null) && !hasAdministrator(connection, states, subject)) throw failure(Failure.LAST_ADMIN);
+    }
+
+    private boolean hasAdministrator(Connection connection, List<Snapshot> states, String excludedSubject) throws SQLException {
+        if (!management.isUnique()) throw failure(Failure.UNAVAILABLE);
+        for (Snapshot state : states) {
+            if (!state.project().active()) continue;
+            for (var assignment : state.assignments()) {
+                if (assignment.subject().equals(excludedSubject) || !isActiveSubject(connection, assignment.subject())) continue;
+                for (var member : state.memberships()) {
+                    if (!member.firstPartyUi() || !member.approved() || !canLogin(connection, member, assignment.subject())) continue;
+                    var available = availableScopes(state, assignment, member);
+                    if (!available.isEmpty() && canReach(state, assignment, member, available)) return true;
+                }
+            }
+        }
+        return false;
+    }
