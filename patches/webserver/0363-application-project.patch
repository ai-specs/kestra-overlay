@@ -0,0 +1,73 @@
+package io.kestra.webserver.oidc.projects;
+
+import com.fasterxml.jackson.core.JsonFactory;
+import com.fasterxml.jackson.core.StreamReadFeature;
+import com.fasterxml.jackson.databind.DeserializationFeature;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.nio.ByteBuffer;
+import java.nio.charset.CodingErrorAction;
+import java.nio.charset.StandardCharsets;
+
+final class DirectorySnapshotCodec {
+    private static final int MAX_BYTES = 8 * 1024 * 1024;
+    private final ObjectMapper mapper = new ObjectMapper(JsonFactory.builder()
+        .enable(StreamReadFeature.STRICT_DUPLICATE_DETECTION).build())
+        .enable(DeserializationFeature.FAIL_ON_UNKNOWN_PROPERTIES)
+        .enable(DeserializationFeature.FAIL_ON_MISSING_CREATOR_PROPERTIES)
+        .enable(DeserializationFeature.FAIL_ON_NULL_CREATOR_PROPERTIES)
+        .disable(DeserializationFeature.ACCEPT_FLOAT_AS_INT);
+
+    String encode(ProjectDirectoryState.Snapshot state) throws java.io.IOException {
+        String value = mapper.writeValueAsString(state);
+        if (value.getBytes(StandardCharsets.UTF_8).length > MAX_BYTES) throw new IllegalArgumentException("Directory snapshot exceeds its limit");
+        return value;
+    }
+
+    ApplicationDirectoryBootstrap.Plan decodePlan(byte[] input) {
+        try { return mapper.treeToValue(readTree(input), ApplicationDirectoryBootstrap.Plan.class); }
+        catch (java.io.IOException invalid) { throw new IllegalArgumentException("Invalid directory plan", invalid); }
+    }
+
+    ProjectDirectoryState.Snapshot decode(byte[] input) {
+        try { return mapper.treeToValue(readTree(input), ProjectDirectoryState.Snapshot.class); }
+        catch (java.io.IOException invalid) { throw new IllegalArgumentException("Invalid directory snapshot", invalid); }
+    }
+
+    private JsonNode readTree(byte[] input) {
+        if (input == null || input.length > MAX_BYTES) throw new IllegalArgumentException("Invalid directory snapshot size");
+        try {
+            String content = StandardCharsets.UTF_8.newDecoder().onMalformedInput(CodingErrorAction.REPORT)
+                .onUnmappableCharacter(CodingErrorAction.REPORT).decode(ByteBuffer.wrap(input)).toString();
+            JsonNode tree;
+            try (var parser = mapper.createParser(content)) {
+                tree = mapper.readTree(parser);
+                if (parser.nextToken() != null) throw new IllegalArgumentException("Only one snapshot is accepted");
+            }
+            check(tree, "snapshot", 0);
+            return tree;
+        } catch (java.io.IOException invalid) { throw new IllegalArgumentException("Invalid directory snapshot", invalid); }
+    }
+
+    private void check(JsonNode value, String path, int depth) {
+        if (depth > 32) throw new IllegalArgumentException("Snapshot nesting exceeds limit");
+        if (value == null || value.isNull()) throw new IllegalArgumentException("Null snapshot field: " + path);
+        if (value.isObject()) {
+            if (!value.fieldNames().hasNext()) throw new IllegalArgumentException("Empty snapshot object: " + path);
+            value.fields().forEachRemaining(entry -> {
+                String name = entry.getKey();
+                if (name.isBlank() || name.contains("\0")) throw new IllegalArgumentException("Invalid snapshot field");
+            });
+        }
+        if (value.isArray() && value.size() > 1000) throw new IllegalArgumentException("Snapshot collection exceeds its limit");
+        if (value.isObject()) value.fields().forEachRemaining(entry -> check(entry.getValue(), path + "." + entry.getKey(), depth + 1));
+        if (value.isArray()) {
+            var unique = new java.util.HashSet<String>();
+            for (int index = 0; index < value.size(); index++) {
+                JsonNode item = value.get(index);
+                if (!unique.add(item.toString())) throw new IllegalArgumentException("Duplicate snapshot array entry");
+                check(item, path + "[" + index + "]", depth + 1);
+            }
+        }
+    }
+}
