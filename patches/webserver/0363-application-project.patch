+package io.kestra.webserver.oidc.projects;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.micronaut.context.ApplicationContext;
+import io.micronaut.context.env.Environment;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.sql.DriverManager;
+import javax.sql.DataSource;
+
+public final class ApplicationDirectoryCommand {
+    private ApplicationDirectoryCommand() {}
+
+    public static void main(String[] arguments) throws Exception {
+        if (arguments.length < 2 || !java.util.Set.of("preview", "apply").contains(arguments[0])) {
+            throw new IllegalArgumentException("Usage: preview <plan.json> | apply <plan.json> <approvedHash>");
+        }
+        var codec = new DirectorySnapshotCodec();
+        var plan = codec.decodePlan(Files.readAllBytes(Path.of(arguments[1])));
+        var builder = ApplicationContext.builder();
+        String yaml = System.getenv("KESTRA_CONFIGURATION");
+        if (yaml != null && !yaml.isBlank()) builder.properties(new io.micronaut.context.env.yaml.YamlPropertySourceLoader()
+            .read("directory-cli", new java.io.ByteArrayInputStream(yaml.getBytes(java.nio.charset.StandardCharsets.UTF_8))));
+        String configPath = System.getenv("KESTRA_CONFIGURATION_PATH");
+        if (configPath != null && !configPath.isBlank()) {
+            try (var input = Files.newInputStream(Path.of(configPath))) {
+                builder.properties(new io.micronaut.context.env.yaml.YamlPropertySourceLoader().read("directory-cli", input));
+            }
+        }
+        try (var context = builder.build()) {
+            Environment environment = context.getEnvironment();
+            environment.start();
+            String clientName = environment.getProperty("kestra.oidc.bootstrap.client-name", String.class).orElse("kestra");
+            String clientId = environment.getRequiredProperty("micronaut.security.oauth2.clients." + clientName + ".client-id", String.class);
+            String issuer = environment.getRequiredProperty("kestra.oidc.issuer", String.class);
+            String storage = environment.getProperty("kestra.storage.local.base-path", String.class).orElse("/app/storage");
+            Path receipt = Path.of(environment.getProperty("kestra.oidc.bootstrap.receipt-path", String.class).orElse(storage + "/.oidc-installation"));
+            String url = environment.getRequiredProperty("datasources.postgres.url", String.class);
+            String user = environment.getRequiredProperty("datasources.postgres.username", String.class);
+            String secret = environment.getRequiredProperty("datasources.postgres.password", String.class);
+            var settings = new OidcConfiguration(); settings.setIssuer(issuer);
+            var directory = new JdbcApplicationDirectoryV1(source(url, user, secret), (io.kestra.webserver.oidc.TrustedIdentityV1) () -> null, settings, new ObjectMapper());
+            if ("preview".equals(arguments[0])) {
+                System.out.println(directory.previewBootstrap(plan, receipt, clientId));
+            } else {
+                if (arguments.length != 3) throw new IllegalArgumentException("Approved hash is required");
+                directory.applyBootstrap(plan, arguments[2], receipt, clientId);
+                System.out.println("Application directory activated");
+            }
+        }
+    }
+
+    private static DataSource source(String url, String user, String password) {
+        return new DataSource() {
+            public java.sql.Connection getConnection() throws java.sql.SQLException { return DriverManager.getConnection(url, user, password); }
+            public java.sql.Connection getConnection(String username, String secret) throws java.sql.SQLException { return DriverManager.getConnection(url, username, secret); }
+            public java.io.PrintWriter getLogWriter() { return null; }
+            public void setLogWriter(java.io.PrintWriter writer) {}
+            public void setLoginTimeout(int timeout) { DriverManager.setLoginTimeout(timeout); }
+            public int getLoginTimeout() { return DriverManager.getLoginTimeout(); }
+            public java.util.logging.Logger getParentLogger() { return java.util.logging.Logger.getGlobal(); }
+            public <T> T unwrap(Class<T> type) throws java.sql.SQLException { throw new java.sql.SQLException("Unsupported wrapper"); }
+            public boolean isWrapperFor(Class<?> type) { return false; }
+        };
+    }
+}
