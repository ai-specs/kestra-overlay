+    private Set<String> availableScopes(Snapshot state, SubjectAssignment assignment, ClientMembership member) {
+        var available = new HashSet<>(assignment.projectScopes());
+        available.retainAll(member.allowedProjectScopes());
+        available.retainAll(state.scopes().stream().filter(ScopeDefinition::active).map(ScopeDefinition::scope).toList());
+        return Set.copyOf(available);
+    }
