+    private void validateUniqueClients(Connection connection, Snapshot candidate) throws SQLException {
+        for (Snapshot state : all(connection)) if (!state.project().id().equals(candidate.project().id())) {
+            for (var member : candidate.memberships()) if (state.memberships().stream().anyMatch(other -> other.clientId().equals(member.clientId()))) throw failure(Failure.CONFLICT);
+        }
+    }
+    private void validateScopes(Snapshot state, Set<String> names) {
+        require(names != null);
