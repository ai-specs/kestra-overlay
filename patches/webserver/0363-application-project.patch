+package io.kestra.webserver.oidc.projects;
+
+import io.kestra.webserver.oidc.ApplicationDirectoryV1;
+import java.util.List;
+import java.util.Optional;
+import java.sql.Connection;
+
+public interface ProjectDirectoryState {
+    Snapshot snapshot(String projectId);
+    Optional<Snapshot> forClient(String clientId);
+    Optional<Snapshot> forClient(Connection connection, String clientId) throws java.sql.SQLException;
+    boolean activated();
+    boolean activated(Connection connection) throws java.sql.SQLException;
+    default List<ApplicationDirectoryV1.ProtocolScope> protocolScopes() { return List.of(); }
+    default List<ApplicationDirectoryV1.ProtocolScope> protocolScopes(Connection connection) throws java.sql.SQLException { return protocolScopes(); }
+    Invalidation invalidation();
+    record Invalidation(long authenticationVersion, long authorizationVersion) {}
+    record Snapshot(ApplicationDirectoryV1.Project project,
+                   List<ApplicationDirectoryV1.ScopeDefinition> scopes,
+                   List<ApplicationDirectoryV1.ClientMembership> memberships,
+                   List<ApplicationDirectoryV1.SubjectAssignment> assignments,
+                   long directoryRevision) {
+        public Snapshot { scopes=List.copyOf(scopes); memberships=List.copyOf(memberships); assignments=List.copyOf(assignments); }
+    }
+}
