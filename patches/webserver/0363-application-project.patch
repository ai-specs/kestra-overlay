+    private void authorize(Connection connection, TrustedIdentityV1.Identity identity,
+                           String targetApplicationGroupId, ApplicationGroupManagementV1.Action action) throws SQLException {
+        if (identity == null || !"main".equals(identity.tenant()) || !configuration.getIssuer().equals(identity.issuer())) throw failure(Failure.FORBIDDEN);
+        Snapshot state = find(connection, identity.projectId()).orElseThrow(() -> failure(Failure.FORBIDDEN));
+        var project = state.project();
+        if (!project.active() || project.revision() != identity.directoryRevision() || project.authorizationVersion() != identity.authorizationVersion()) throw failure(Failure.FORBIDDEN);
+        requireSubject(connection, identity.subject());
+        if (io.kestra.webserver.oidc.services.OidcIdentityLifecycle.activeVersion(connection, identity.subject()).orElse(-1)
+            != identity.authenticationVersion()) throw failure(Failure.FORBIDDEN);
+        requireClient(connection, identity.clientId());
+        var assignment = state.assignments().stream().filter(value -> value.issuer().equals(identity.issuer()) && value.subject().equals(identity.subject())).findFirst().orElseThrow(() -> failure(Failure.FORBIDDEN));
+        var member = state.memberships().stream().filter(value -> value.clientId().equals(identity.clientId()) && value.approved()).findFirst().orElseThrow(() -> failure(Failure.FORBIDDEN));
+        if (!member.audiences().containsAll(identity.audiences()) || identity.audiences().isEmpty()) throw failure(Failure.FORBIDDEN);
+        for (String name : identity.projectScopes()) {
+            var scope = state.scopes().stream().filter(value -> value.scope().equals(name) && value.active()).findFirst().orElseThrow(() -> failure(Failure.FORBIDDEN));
+            if (!assignment.projectScopes().contains(name) || !member.allowedProjectScopes().contains(name)) throw failure(Failure.FORBIDDEN);
+        }
+        if (!management.isUnique()) throw failure(Failure.UNAVAILABLE);
+        final boolean allowed;
+        try { allowed = management.get().authorize(identity, targetApplicationGroupId, action); }
+        catch (RuntimeException error) { throw failure(Failure.UNAVAILABLE); }
+        if (!allowed) throw failure(Failure.FORBIDDEN);
+    }
