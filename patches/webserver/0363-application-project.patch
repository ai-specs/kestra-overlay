+    private boolean resourceCovered(ResourceIntent upper, ResourceIntent lower) {
+        if (!upper.vocabularyVersion().equals(lower.vocabularyVersion()) || !upper.resourceType().equals(lower.resourceType()) || !upper.actions().containsAll(lower.actions())) return false;
+        if (upper.resourceIds().kind() != DomainKind.ALL && (lower.resourceIds().kind() == DomainKind.ALL || !upper.resourceIds().ids().containsAll(lower.resourceIds().ids()))) return false;
+        if (upper.namespaces().kind() == DomainKind.ALL) return true;
+        if (lower.namespaces().kind() == DomainKind.ALL) return false;
+        for (String exact : lower.namespaces().exact()) if (!upper.namespaces().exact().contains(exact) && upper.namespaces().subtrees().stream().noneMatch(root -> exact.equals(root) || exact.startsWith(root + "."))) return false;
+        for (String subtree : lower.namespaces().subtrees()) if (upper.namespaces().subtrees().stream().noneMatch(root -> subtree.equals(root) || subtree.startsWith(root + "."))) return false;
+        return true;
+    }
