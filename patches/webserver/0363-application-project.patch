+    private boolean canReach(Snapshot state, SubjectAssignment assignment, ClientMembership member, Set<String> scopes) {
+        if (!management.isUnique()) throw failure(Failure.UNAVAILABLE);
+        var candidate = new ApplicationGroupManagementV1.Candidate(state.project().id(), state.project().issuer(),
+            assignment.subject(), member.clientId(), member.audiences(), scopes);
+        try { return management.get().reachable(candidate, state.project().id(), ApplicationGroupManagementV1.Action.MANAGE); }
+        catch (RuntimeException error) { throw failure(Failure.UNAVAILABLE); }
+    }
