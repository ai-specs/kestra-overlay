+        for (var intent : input.resourceIntents()) {
+            require("kestra-resources-v1".equals(intent.vocabularyVersion()));
+            require(resources.contains(intent.resourceType()));
+            require(!intent.actions().isEmpty() && actions.containsAll(intent.actions()));
+            if (intent.resourceType().equals("METADATA")) {
+                require(intent.namespaces().kind() == DomainKind.ALL && intent.namespaces().exact().isEmpty() && intent.namespaces().subtrees().isEmpty());
+                require(intent.resourceIds().kind() == DomainKind.ALL && intent.resourceIds().ids().isEmpty());
+                require(intent.actions().stream().allMatch(action -> Set.of("READ", "LIST").contains(action)));
+            } else if (intent.resourceType().equals("MCP_SERVER")) {
