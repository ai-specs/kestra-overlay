@@ -0,0 +1,110 @@
+package io.kestra.webserver.oidc.services;
+
+import java.security.MessageDigest;
+import java.security.SecureRandom;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.Base64;
+import javax.crypto.SecretKeyFactory;
+import javax.crypto.spec.PBEKeySpec;
+
+public final class OidcClientSecrets {
+    private static final String PREFIX = "{pbkdf2-sha256-v1}";
+    private static final int ITERATIONS = 210000;
+    private static final int MAXIMUM_SECRET_BYTES = 1024;
+    private static final SecureRandom RANDOM = new SecureRandom();
+
+    private OidcClientSecrets() {}
+
+    public static String hash(final String secret) {
+        if (secret == null || secret.isEmpty()) return "";
+        if (!acceptable(secret)) throw new IllegalArgumentException("Client secret exceeds storage limit");
+        final byte[] salt = new byte[16];
+        RANDOM.nextBytes(salt);
+        return PREFIX + ITERATIONS + "$" + Base64.getEncoder().encodeToString(salt) + "$"
+            + Base64.getEncoder().encodeToString(derive(secret, salt));
+    }
+
+    public static boolean matches(final String stored, final String supplied) {
+        if (stored == null || supplied == null || supplied.isEmpty() || !acceptable(supplied)
+            || stored.length() > 256 || !stored.startsWith(PREFIX)) return false;
+        try {
+            final String[] parts = stored.substring(PREFIX.length()).split("\\$", -1);
+            if (parts.length != 3 || !Integer.toString(ITERATIONS).equals(parts[0])) return false;
+            final byte[] salt = Base64.getDecoder().decode(parts[1]);
+            final byte[] expected = Base64.getDecoder().decode(parts[2]);
+            return salt.length == 16 && expected.length == 32 && MessageDigest.isEqual(expected, derive(supplied, salt));
+        } catch (IllegalArgumentException exception) { return false; }
+    }
+
+    private static boolean acceptable(final String secret) {
+        return secret.length() <= MAXIMUM_SECRET_BYTES
+            && secret.getBytes(java.nio.charset.StandardCharsets.UTF_8).length <= MAXIMUM_SECRET_BYTES;
+    }
+
+    public static void migrateAll(final javax.sql.DataSource source) throws SQLException {
+        boolean finished = false;
+        while (!finished) {
+            try (var connection = source.getConnection()) {
+                connection.setAutoCommit(false);
+                try {
+                    try (var lock = connection.prepareStatement("SELECT pg_advisory_xact_lock(1980198)")) { lock.execute(); }
+                    final var clients = new java.util.ArrayList<String>();
+                    try (var statement = connection.prepareStatement("SELECT client_id FROM oidc_client WHERE secret_format='plaintext' ORDER BY client_id LIMIT 50 FOR UPDATE");
+                         var result = statement.executeQuery()) {
+                        while (result.next()) clients.add(result.getString(1));
+                    }
+                    for (final String clientId : clients) {
+                        loadAndMigrate(connection, clientId);
+                        try (var statement = connection.prepareStatement("UPDATE oidc_client SET secret_format='pbkdf2-sha256-v1' WHERE client_id=?")) {
+                            statement.setString(1, clientId);
+                            statement.executeUpdate();
+                        }
+                    }
+                    finished = clients.isEmpty();
+                    if (finished) {
+                        try (var statement = connection.prepareStatement("SELECT EXISTS(SELECT 1 FROM oidc_client WHERE secret_format<>'pbkdf2-sha256-v1')"); var result = statement.executeQuery()) {
+                            result.next();
+                            if (result.getBoolean(1)) throw new IllegalStateException("Unsupported client secret storage version");
+                        }
+                        try (var statement = connection.createStatement()) {
+                            statement.execute("ALTER TABLE oidc_client ALTER COLUMN secret_format SET DEFAULT 'pbkdf2-sha256-v1'");
+                        }
+                    }
+                    connection.commit();
+                } catch (SQLException | RuntimeException exception) {
+                    connection.rollback();
+                    throw exception;
+                }
+            }
+        }
+    }
+
+    public static String loadAndMigrate(final Connection connection, final String clientId) throws SQLException {
+        try (var statement = connection.prepareStatement("SELECT client_secret,secret_format FROM oidc_client WHERE client_id=? FOR UPDATE")) {
+            statement.setString(1, clientId);
+            try (var result = statement.executeQuery()) {
+                if (!result.next()) return null;
+                final String stored = result.getString(1);
+                final String format = result.getString(2);
+                if (stored.isEmpty()) return stored;
+                if ("pbkdf2-sha256-v1".equals(format)) return stored;
+                if (!"plaintext".equals(format)) throw new IllegalStateException("Unsupported client secret storage version");
+                final String encoded = hash(stored);
+                try (var update = connection.prepareStatement("UPDATE oidc_client SET client_secret=?,secret_format='pbkdf2-sha256-v1' WHERE client_id=?")) {
+                    update.setString(1, encoded);
+                    update.setString(2, clientId);
+                    update.executeUpdate();
+                }
+                return encoded;
+            }
+        }
+    }
+
+    private static byte[] derive(final String secret, final byte[] salt) {
+        final var specification = new PBEKeySpec(secret.toCharArray(), salt, ITERATIONS, 256);
+        try { return SecretKeyFactory.getInstance("PBKDF2WithHmacSHA256").generateSecret(specification).getEncoded(); }
+        catch (java.security.GeneralSecurityException exception) { throw new IllegalStateException("Client secret hashing unavailable", exception); }
+        finally { specification.clearPassword(); }
+    }
+}
