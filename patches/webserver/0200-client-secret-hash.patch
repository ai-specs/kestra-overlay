+package io.kestra.webserver.oidc;
+
+import java.util.List;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.kestra.webserver.oidc.services.OidcClientService;
+import io.kestra.webserver.oidc.services.OidcClientSecrets;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class OidcClientSecretHashTest extends OidcPostgresTestBase {
+    @org.junit.jupiter.api.io.TempDir
+    java.nio.file.Path receiptDirectory;
+
+    @Test
+    void shouldBootstrapAndMatchLegacySystemSecretAcrossRestartWithoutChangingKind() throws Exception {
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("TRUNCATE oidc_setup,oidc_user,oidc_client CASCADE");
+        }
+        final var configuration = new OidcConfiguration();
+        final var environment = org.mockito.Mockito.mock(io.micronaut.context.env.Environment.class);
+        org.mockito.Mockito.when(environment.getProperty(org.mockito.ArgumentMatchers.anyString(), org.mockito.ArgumentMatchers.eq(String.class)))
+            .thenReturn(java.util.Optional.empty());
+        final var properties = java.util.Map.of("kestra.oidc.bootstrap.receipt-path", receiptDirectory.resolve("identity").toString(),
+            "micronaut.security.oauth2.clients.kestra.client-id", "secret-system-ui",
+            "micronaut.security.oauth2.clients.kestra.client-secret", "unchanged-ui-secret");
+        properties.forEach((key, value) -> org.mockito.Mockito.when(environment.getProperty(key, String.class)).thenReturn(java.util.Optional.of(value)));
+        final var setup = new io.kestra.webserver.oidc.services.OidcSetupService(dataSource(), configuration, environment, new io.kestra.webserver.oidc.services.HashedOidcClientSecretCodec());
+        assertTrue(setup.setup(java.util.Map.of("username", "secret-user", "password", "SetupPass123!")));
+        assertTrue(stored("secret-system-ui").startsWith("{pbkdf2-sha256-v1}"));
+        assertTrue(new OidcClientService(dataSource(), new ObjectMapper(), new io.kestra.webserver.oidc.services.HashedOidcClientSecretCodec()).authenticate("secret-system-ui", "unchanged-ui-secret"));
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("UPDATE oidc_client SET client_secret='unchanged-ui-secret',secret_format='plaintext' WHERE client_id='secret-system-ui'");
+        }
+        new io.kestra.webserver.oidc.migration.V2_0_98OidcServerClientSecretMigration(dataSource()).migrate();
+        assertTrue(new io.kestra.webserver.oidc.services.OidcSetupService(dataSource(), configuration, environment, new io.kestra.webserver.oidc.services.HashedOidcClientSecretCodec()).ready());
+        assertTrue(stored("secret-system-ui").startsWith("{pbkdf2-sha256-v1}"));
+        org.mockito.Mockito.when(environment.getProperty("micronaut.security.oauth2.clients.kestra.client-secret", String.class))
+            .thenReturn(java.util.Optional.of("mismatching-secret"));
+        assertThrows(IllegalStateException.class, () -> new io.kestra.webserver.oidc.services.OidcSetupService(dataSource(), configuration, environment, new io.kestra.webserver.oidc.services.HashedOidcClientSecretCodec()).ready());
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement();
+             var row = statement.executeQuery("SELECT client_kind,active FROM oidc_client WHERE client_id='secret-system-ui'")) {
+            row.next(); assertEquals("system", row.getString(1)); assertTrue(row.getBoolean(2));
+        }
+    }
+
+    @Test
+    void shouldMigrateAllRowsBeforeCompletionAndResumeWithoutRehashing() throws Exception {
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("TRUNCATE oidc_client CASCADE");
+            statement.execute("INSERT INTO oidc_client(client_id,client_secret,client_kind,secret_format) VALUES ('system-upgrade','old-secret','system','plaintext'),('public-upgrade','','pending','plaintext')");
+        }
+        final var migration = new io.kestra.webserver.oidc.migration.V2_0_98OidcServerClientSecretMigration(dataSource());
+        try (var executor = java.util.concurrent.Executors.newFixedThreadPool(2)) {
+            final var futures = executor.invokeAll(List.<java.util.concurrent.Callable<Boolean>>of(() -> { migration.migrate(); return true; }, () -> { migration.migrate(); return true; }));
+            for (final var future : futures) assertTrue(future.get());
+        }
+        final String hashed = stored("system-upgrade");
+        assertTrue(hashed.startsWith("{pbkdf2-sha256-v1}"));
+        assertEquals("", stored("public-upgrade"));
+        migration.migrate();
+        assertEquals(hashed, stored("system-upgrade"));
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("INSERT INTO oidc_client(client_id,client_secret) VALUES ('post-migration-public','')");
+            try (var row = statement.executeQuery("SELECT secret_format FROM oidc_client WHERE client_id='post-migration-public'")) {
+                row.next(); assertEquals("pbkdf2-sha256-v1", row.getString(1));
+            }
+        }
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement();
+             var result = statement.executeQuery("SELECT count(*) FROM oidc_client WHERE secret_format='plaintext'")) {
+            result.next(); assertEquals(0, result.getInt(1));
+        }
+        assertTrue(new OidcClientService(dataSource(), new ObjectMapper(), new io.kestra.webserver.oidc.services.HashedOidcClientSecretCodec()).authenticate("system-upgrade", "old-secret"));
+    }
+
+    @Test
+    void shouldRollbackFailedMigrationBatchAndResumeAfterRepair() throws Exception {
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("TRUNCATE oidc_client CASCADE");
+            statement.execute("INSERT INTO oidc_client(client_id,client_secret,secret_format) VALUES ('a-valid','valid-secret','plaintext'),('b-oversized',repeat('x',1025),'plaintext')");
+        }
+        final var migration = new io.kestra.webserver.oidc.migration.V2_0_98OidcServerClientSecretMigration(dataSource());
+        assertThrows(IllegalArgumentException.class, migration::migrate);
+        assertEquals("valid-secret", stored("a-valid"));
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("DELETE FROM oidc_client WHERE client_id='b-oversized'");
+        }
+        migration.migrate();
+        assertTrue(stored("a-valid").startsWith("{pbkdf2-sha256-v1}"));
+    }
+
+    @Test
+    void shouldRejectOversizedAndMalformedSecretsWithoutFallback() {
+        assertThrows(IllegalArgumentException.class, () -> OidcClientSecrets.hash("a".repeat(1025)));
+        assertThrows(IllegalArgumentException.class, () -> OidcClientSecrets.hash("界".repeat(400)));
+        assertFalse(OidcClientSecrets.matches(OidcClientSecrets.hash("valid"), "a".repeat(1025)));
+        assertFalse(OidcClientSecrets.matches("{pbkdf2-sha256-v1}210000$malformed$malformed", "valid"));
+        assertFalse(OidcClientSecrets.matches("valid", "valid"));
+    }
+    @Test
+    void shouldStoreOnlyHashesAndRotateWithoutPlaintextFallback() throws Exception {
+        final var clients = new OidcClientService(dataSource(), new ObjectMapper(), new io.kestra.webserver.oidc.services.HashedOidcClientSecretCodec());
+        clients.delete("hash-client");
+        clients.create("hash-client", "original-secret", List.of("https://example.org/cb"), List.of("authorization_code"), List.of("openid"));
+        final String stored = stored("hash-client");
+        assertTrue(stored.startsWith("{pbkdf2-sha256-v1}"));
+        assertFalse(stored.contains("original-secret"));
+        assertTrue(clients.authenticate("hash-client", "original-secret"));
+        assertFalse(clients.authenticate("hash-client", stored));
+        clients.updateSecret("hash-client", "replacement-secret");
+        assertFalse(clients.authenticate("hash-client", "original-secret"));
+        assertTrue(clients.authenticate("hash-client", "replacement-secret"));
+        assertTrue(new OidcClientService(dataSource(), new ObjectMapper(), new io.kestra.webserver.oidc.services.HashedOidcClientSecretCodec()).authenticate("hash-client", "replacement-secret"));
+        assertFalse(OidcClientSecrets.matches("{pbkdf2-sha256-v2}malformed", "replacement-secret"));
+    }
+
+    @Test
+    void shouldMigrateLegacyPlaintextAndKeepPublicClientsEmpty() throws Exception {
+        final var clients = new OidcClientService(dataSource(), new ObjectMapper(), new io.kestra.webserver.oidc.services.HashedOidcClientSecretCodec());
+        clients.delete("legacy-secret-client");
+        clients.delete("empty-secret-client");
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("INSERT INTO oidc_client(client_id,client_secret,active,secret_format) VALUES ('legacy-secret-client','{pbkdf2-sha256-v1}legacy-secret',TRUE,'plaintext'),('empty-secret-client','',TRUE,'plaintext')");
+        }
+        new io.kestra.webserver.oidc.migration.V2_0_98OidcServerClientSecretMigration(dataSource()).migrate();
+        assertTrue(clients.authenticate("legacy-secret-client", "{pbkdf2-sha256-v1}legacy-secret"));
+        assertTrue(stored("legacy-secret-client").startsWith("{pbkdf2-sha256-v1}"));
+        assertFalse(clients.authenticate("legacy-secret-client", stored("legacy-secret-client")));
+        assertTrue(clients.isPublic(clients.require("empty-secret-client")));
+        assertEquals("", stored("empty-secret-client"));
+        assertFalse(clients.authenticate("empty-secret-client", ""));
+    }
+
+    private String stored(final String clientId) throws Exception {
+        try (var connection = dataSource().getConnection(); var statement = connection.prepareStatement("SELECT client_secret FROM oidc_client WHERE client_id=?")) {
+            statement.setString(1, clientId);
+            try (var result = statement.executeQuery()) { result.next(); return result.getString(1); }
+        }
+    }
+}
