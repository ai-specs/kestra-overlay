+package io.kestra.webserver.oidc;
+
+import io.kestra.webserver.oidc.services.HashedOidcClientSecretCodec;
+import io.kestra.webserver.oidc.services.OidcClientSecretCodec;
+import io.kestra.webserver.oidc.services.OidcClientService;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+
+class OidcHashCodecInjectionTest {
+    @Test
+    void productionContextReplacesPlaintextCodec() throws Exception {
+        try (var context = io.micronaut.context.ApplicationContext.builder()
+            .deduceEnvironment(false).environments("test", "h2")
+            .properties(java.util.Map.of("kestra.oidc.enabled", true, "kestra.server-type", "WEBSERVER"))
+            .build()) {
+            context.start();
+            final var codec = context.getBean(OidcClientSecretCodec.class);
+            assertInstanceOf(HashedOidcClientSecretCodec.class, codec);
+            assertEquals("pbkdf2-sha256-v1", codec.format());
+            final var codecs = context.getBeansOfType(OidcClientSecretCodec.class);
+            assertEquals(1, codecs.size());
+            assertSame(codec, codecs.iterator().next());
+            final var service = context.getBean(OidcClientService.class);
+            final var codecField = OidcClientService.class.getDeclaredField("secretCodec");
+            codecField.setAccessible(true);
+            assertSame(codec, codecField.get(service));
+        }
+    }
+}
