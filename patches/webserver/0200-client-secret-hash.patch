+    public void migrate() throws Exception {
+        super.migrate();
+        io.kestra.webserver.oidc.services.OidcClientSecrets.migrateAll(
+            io.micronaut.data.connection.jdbc.advice.DelegatingDataSource.unwrapDataSource(source));
+    }
