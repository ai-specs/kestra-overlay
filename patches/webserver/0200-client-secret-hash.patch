+package io.kestra.webserver.oidc.services;
+
+import io.micronaut.context.annotation.Replaces;
+import io.micronaut.context.annotation.Requires;
+import jakarta.inject.Singleton;
+
+@Singleton
+@Requires(property = "kestra.oidc.enabled", value = "true")
+@Replaces(PlaintextOidcClientSecretCodec.class)
+public class HashedOidcClientSecretCodec implements OidcClientSecretCodec {
+    @Override public String format() { return "pbkdf2-sha256-v1"; }
+    @Override public String encode(final String secret) { return OidcClientSecrets.hash(secret); }
+    @Override public boolean matches(final String secret, final String encoded) {
+        return OidcClientSecrets.matches(encoded, secret);
+    }
+}
diff --git a/webserver/src/main/java/io/kestra/webserver/oidc/services/OidcClientSecrets.java b/webserver/src/main/java/io/kestra/webserver/oidc/services/OidcClientSecrets.java
