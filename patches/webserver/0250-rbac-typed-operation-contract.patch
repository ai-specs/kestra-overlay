+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import io.micronaut.context.BeanProvider;
+import org.junit.jupiter.api.Test;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.*;
+
+class TypedAuthorizationGateTest {
+    private final RbacAuthorizer.Principal principal = new RbacAuthorizer.Principal("subject", List.of("reader"), null, null, List.of());
+
+    @Test
+    void shouldDenyMissingIdentityPolicyAndDecisions() {
+        var policies = policies();
+        var gate = new TypedAuthorizationGate(policies);
