+package io.kestra.webserver.rbac;
+
+import java.time.Duration;
+import io.micronaut.context.BeanProvider;
+import jakarta.inject.Singleton;
+import reactor.core.publisher.Mono;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+
+@Singleton
+public final class TypedAuthorizationGate {
+    private final BeanProvider<TypedAuthorizationResolver> policies;
+
+    public TypedAuthorizationGate(BeanProvider<TypedAuthorizationResolver> policies) {
+        this.policies = policies;
+    }
+
+    public Mono<Decision> authorize(RbacAuthorizer.Principal principal, Operation operation) {
+        return Mono.defer(() -> {
+            if (principal == null || principal.subject() == null || principal.subject().isBlank()
+                || operation == null || !policies.isUnique()) return Mono.just(Decision.deny("Invalid authorization context"));
+            return Mono.fromCompletionStage(policies.get().authorize(principal, operation))
+                .map(decision -> {
+                    if (!decision.allowed()) return Decision.deny(decision.reason());
+                    QueryDomain effective = operation.queryDomain().intersect(decision.scope());
+                    if (operation.namespace() != null && !effective.contains(operation.namespace()))
+                        return Decision.deny("Resource is outside authorized scope");
+                    return Decision.allow(effective);
+                });
+        }).timeout(Duration.ofSeconds(5))
+            .defaultIfEmpty(Decision.deny("Missing authorization decision"))
+            .onErrorReturn(Decision.deny("Authorization failed"));
+    }
+}
