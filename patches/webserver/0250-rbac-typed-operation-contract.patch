+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import io.micronaut.context.BeanProvider;
+import org.junit.jupiter.api.Test;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.*;
+
+class TypedAuthorizationGateTest {
+    private final RbacAuthorizer.Principal principal = new RbacAuthorizer.Principal("subject", List.of("reader"), null, null, List.of());
+
+    @Test
+    void shouldDenyMissingIdentityPolicyAndDecisions() {
+        var policies = policies();
+        var gate = new TypedAuthorizationGate(policies);
+        assertThat(gate.authorize(principal, query()).block().allowed()).isFalse();
+        when(policies.isUnique()).thenReturn(true);
+        when(policies.get()).thenReturn((subject, operation) -> CompletableFuture.completedFuture(null));
+        assertThat(gate.authorize(principal, query()).block().allowed()).isFalse();
+        assertThat(gate.authorize(null, query()).block().allowed()).isFalse();
+        when(policies.get()).thenReturn((subject, operation) -> { throw new IllegalStateException("failure"); });
+        assertThat(gate.authorize(principal, query()).block().allowed()).isFalse();
+    }
+
+    @Test
+    void shouldConstrainPolicyScopeByActualQueryDomain() {
+        var policies = policies();
+        when(policies.isUnique()).thenReturn(true);
+        when(policies.get()).thenReturn((subject, operation) -> CompletableFuture.completedFuture(Decision.allow(QueryDomain.unrestricted())));
+        var gate = new TypedAuthorizationGate(policies);
+        Decision result = gate.authorize(principal, query()).block();
+        assertThat(result.allowed()).isTrue();
+        assertThat(result.scope().contains("team")).isTrue();
+        assertThat(result.scope().contains("team.child")).isFalse();
+        assertThat(result.scope().contains("other")).isFalse();
+        when(policies.get()).thenReturn((subject, operation) -> CompletableFuture.completedFuture(Decision.allow(QueryDomain.empty())));
+        var single = new Operation(CONTRACT_VERSION, Source.REST, Resource.FLOW, Action.READ, "main", "team", "flow",
+            query().queryDomain(), Coverage.SINGLE, Aggregate.NONE, SideEffect.READ_ONLY);
+        assertThat(gate.authorize(principal, single).block().allowed()).isFalse();
+    }
+
+    private Operation query() {
+        return new Operation(CONTRACT_VERSION, Source.REST, Resource.FLOW, Action.LIST, "main", null, null,
+            new QueryDomain(List.of("team"), List.of(), List.of(), true, true), Coverage.COMPLETE_QUERY, Aggregate.NONE, SideEffect.READ_ONLY);
+    }
+
+    @SuppressWarnings("unchecked")
+    private BeanProvider<TypedAuthorizationResolver> policies() {
+        return mock(BeanProvider.class);
+    }
+}
