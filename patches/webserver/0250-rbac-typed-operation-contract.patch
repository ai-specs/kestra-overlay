+package io.kestra.webserver.rbac;
+
+import java.util.concurrent.CompletionStage;
+import io.kestra.webserver.rbac.TypedAuthorization.Decision;
+import io.kestra.webserver.rbac.TypedAuthorization.Operation;
+
+/** Consumer policy contract. The plugin receives typed operations, never OSS route details. */
+public interface TypedAuthorizationResolver {
+    CompletionStage<Decision> authorize(RbacAuthorizer.Principal principal, Operation operation);
+}
