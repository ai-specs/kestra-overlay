+package io.kestra.webserver.rbac;
+
+import java.util.Arrays;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+import static org.assertj.core.api.Assertions.*;
+
+class TypedAuthorizationContractTest {
+    @Test
+    void shouldDistinguishExplicitGlobalFromEmptyAndMissingScopes() {
+        assertThat(QueryDomain.unrestricted().contains("team.child")).isTrue();
+        assertThat(QueryDomain.empty().contains("team.child")).isFalse();
+        assertThat(Decision.deny("missing").scope().contains("team.child")).isFalse();
+        assertThatThrownBy(() -> Decision.allow(null)).isInstanceOf(NullPointerException.class);
+        assertThatThrownBy(() -> new QueryDomain(null, List.of(), List.of(), true, false)).isInstanceOf(NullPointerException.class);
+        assertThatThrownBy(() -> new QueryDomain(Arrays.asList("team", null), List.of(), List.of(), true, false))
+            .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> new QueryDomain(List.of("team.*"), List.of(), List.of(), true, false))
+            .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> operation(Resource.FLOW, "team", null, Aggregate.NONE, Coverage.SINGLE))
+            .isInstanceOf(NullPointerException.class);
+    }
+
+    @Test
+    void shouldIntersectUnionDomainsWithoutPromotingExactNamespaces() {
+        var requested = new QueryDomain(List.of("team.exact", "other"), List.of("team.tree"), List.of("team.tree.hidden"), true, true);
+        var grants = new QueryDomain(List.of("team.tree.child"), List.of("team"), List.of("team.exact"), true, false);
+        var intersection = requested.intersect(grants);
+        assertThat(intersection.paginated()).isTrue();
+        assertThat(List.of("team.exact", "team.exact.child", "team.tree", "team.tree.child", "team.tree.hidden", "team.tree2", "other")
+            .stream().filter(intersection::contains).toList()).containsExactly("team.tree", "team.tree.child");
+        var exact = new QueryDomain(List.of("team"), List.of(), List.of(), true, false);
+        assertThat(exact.intersect(grants).contains("team.child")).isFalse();
+        assertThat(QueryDomain.empty().intersect(QueryDomain.unrestricted()).contains("team")).isFalse();
+        assertThat(requested.intersect(QueryDomain.unrestricted())).isEqualTo(requested);
+        assertThat(QueryDomain.unrestricted().intersect(requested)).isEqualTo(requested);
+    }
+
+    @Test
+    void shouldRejectIncompleteOrInconsistentOperationsBeforePolicyEvaluation() {
+        var exact = new QueryDomain(List.of("team"), List.of(), List.of(), true, false);
+        assertThatThrownBy(() -> operation(Resource.FLOW, "other", exact, Aggregate.NONE, Coverage.SINGLE))
+            .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> operation(Resource.EXECUTION, null, exact, Aggregate.LOG, Coverage.COMPLETE_QUERY))
+            .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> operation(Resource.FLOW, null, exact, Aggregate.NONE, Coverage.SINGLE))
+            .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> Decision.allow(new QueryDomain(List.of("team"), List.of(), List.of(), false, false)))
+            .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> new Decision(true, exact, "", CONTRACT_VERSION + 1))
+            .isInstanceOf(IllegalArgumentException.class);
+        assertThat(operation(Resource.EXECUTION, null, exact, Aggregate.EXECUTION, Coverage.COMPLETE_QUERY).queryDomain())
+            .isEqualTo(exact);
+    }
+
+    private Operation operation(Resource resource, String namespace, QueryDomain domain, Aggregate aggregate, Coverage coverage) {
+        return new Operation(CONTRACT_VERSION, Source.REST, resource, Action.READ, "main", namespace, null,
+            domain, coverage, aggregate, SideEffect.READ_ONLY);
+    }
+}
