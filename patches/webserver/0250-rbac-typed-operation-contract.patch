+package io.kestra.webserver.rbac;
+
+import java.util.List;
+import java.util.Objects;
+
+/** Versioned typed authorization contract. Route adapters own OSS-specific parsing. */
+public final class TypedAuthorization {
+    public static final int CONTRACT_VERSION = 1;
+    private TypedAuthorization() {}
+
+    public enum Source { REST, MCP, INTERNAL, DASHBOARD_AGGREGATE }
+    public enum Resource { FLOW, EXECUTION, NAMESPACE, LOG, METRIC, TRIGGER, KVSTORE,
+        NAMESPACE_FILE, METADATA, SYSTEM, MCP_SERVER, DASHBOARD, BLUEPRINT }
+    public enum Action { READ, LIST, CREATE, UPDATE, DELETE, EXECUTE, ACCESS_OUTPUTS }
+    public enum Coverage { SINGLE, COMPLETE_QUERY, COMPLETE_BATCH }
+    public enum Aggregate { NONE, EXECUTION, LOG, TRIGGER, FLOW_DESCRIPTION }
+    public enum SideEffect { READ_ONLY, STORAGE_WRITE, QUEUE_WRITE, EXTERNAL }
+
+    public enum DomainKind { GLOBAL, RESTRICTED }
+
+    public record QueryDomain(List<String> exactNamespaces, List<String> namespaceSubtrees,
+        List<String> excludedNamespaces, boolean complete, boolean paginated, DomainKind kind) {
+        public QueryDomain {
+            exactNamespaces = clean(exactNamespaces);
+            namespaceSubtrees = clean(namespaceSubtrees);
+            excludedNamespaces = clean(excludedNamespaces);
+            Objects.requireNonNull(kind, "Domain kind is required");
+            if (kind == DomainKind.GLOBAL && (!exactNamespaces.isEmpty() || !namespaceSubtrees.isEmpty()))
+                throw new IllegalArgumentException("Global domain cannot contain namespace grants");
+            if (!complete && paginated) throw new IllegalArgumentException("Paginated domain must be complete");
+        }
+        public QueryDomain(List<String> exactNamespaces, List<String> namespaceSubtrees,
+            List<String> excludedNamespaces, boolean complete, boolean paginated) {
+            this(exactNamespaces, namespaceSubtrees, excludedNamespaces, complete, paginated, DomainKind.RESTRICTED);
+        }
+        public static QueryDomain unrestricted() {
+            return new QueryDomain(List.of(), List.of(), List.of(), true, false, DomainKind.GLOBAL);
+        }
+        public static QueryDomain empty() {
+            return new QueryDomain(List.of(), List.of(), List.of(), true, false);
+        }
+        public boolean contains(String namespace) {
+            return namespace != null && !excludedNamespaces.contains(namespace)
+                && (kind == DomainKind.GLOBAL || exactNamespaces.contains(namespace)
+                    || namespaceSubtrees.stream().anyMatch(root -> within(namespace, root)));
+        }
+        public QueryDomain intersect(QueryDomain other) {
+            Objects.requireNonNull(other, "Intersection domain is required");
+            var exclusions = java.util.stream.Stream.concat(excludedNamespaces.stream(), other.excludedNamespaces.stream()).distinct().toList();
+            boolean resultComplete = complete && other.complete;
+            boolean resultPaginated = paginated || other.paginated;
+            if (kind == DomainKind.GLOBAL && other.kind == DomainKind.GLOBAL)
+                return new QueryDomain(List.of(), List.of(), exclusions, resultComplete, resultPaginated, DomainKind.GLOBAL);
+            if (kind == DomainKind.GLOBAL)
+                return new QueryDomain(other.exactNamespaces, other.namespaceSubtrees, exclusions, resultComplete, resultPaginated);
+            if (other.kind == DomainKind.GLOBAL)
+                return new QueryDomain(exactNamespaces, namespaceSubtrees, exclusions, resultComplete, resultPaginated);
+            var exact = java.util.stream.Stream.concat(exactNamespaces.stream().filter(other::contains),
+                other.exactNamespaces.stream().filter(this::contains)).distinct().toList();
+            var subtrees = namespaceSubtrees.stream().flatMap(root -> other.namespaceSubtrees.stream()
+                .map(otherRoot -> within(root, otherRoot) ? root : within(otherRoot, root) ? otherRoot : null))
+                .filter(Objects::nonNull).distinct().toList();
+            return new QueryDomain(exact, subtrees, exclusions, resultComplete, resultPaginated);
+        }
+        private static boolean within(String namespace, String root) {
+            return namespace.equals(root) || namespace.startsWith(root + ".");
+        }
+        private static List<String> clean(List<String> values) {
+            Objects.requireNonNull(values, "Namespace collection is required");
+            if (values.stream().anyMatch(value -> value == null || !value.matches("[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*")))
+                throw new IllegalArgumentException("Invalid namespace in domain");
+            return List.copyOf(values.stream().distinct().toList());
+        }
+    }
+
+    public record Operation(int contractVersion, Source source, Resource resource, Action action,
+        String tenant, String namespace, String resourceId, QueryDomain queryDomain,
+        Coverage coverage, Aggregate aggregate, SideEffect sideEffect) {
+        public Operation {
+            if (contractVersion != CONTRACT_VERSION) throw new IllegalArgumentException("Unsupported contract version");
+            if (source == null || resource == null || action == null || coverage == null || aggregate == null || sideEffect == null)
+                throw new IllegalArgumentException("Typed authorization fields are required");
+            if (tenant == null || tenant.isBlank()) throw new IllegalArgumentException("Tenant is required");
+            Objects.requireNonNull(queryDomain, "Query domain is required");
+            if (namespace != null && !namespace.matches("[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*"))
+                throw new IllegalArgumentException("Invalid namespace");
+            if (resourceId != null && resourceId.isBlank()) throw new IllegalArgumentException("Invalid resource ID");
+            if (namespace != null && !queryDomain.contains(namespace)) throw new IllegalArgumentException("Resource is outside query domain");
+            if (coverage == Coverage.COMPLETE_QUERY && !queryDomain.complete()) throw new IllegalArgumentException("Complete query required");
+            if (coverage == Coverage.SINGLE && namespace == null && resource != Resource.METADATA && resource != Resource.SYSTEM
+                && resource != Resource.MCP_SERVER && resource != Resource.DASHBOARD && resource != Resource.BLUEPRINT)
+                throw new IllegalArgumentException("Single resource namespace is required");
+            if (aggregate != Aggregate.NONE && (coverage != Coverage.COMPLETE_QUERY && aggregate != Aggregate.FLOW_DESCRIPTION || sideEffect != SideEffect.READ_ONLY
+                || action != Action.READ && action != Action.LIST)) throw new IllegalArgumentException("Invalid aggregate operation");
+            if (aggregate == Aggregate.EXECUTION && resource != Resource.EXECUTION
+                || aggregate == Aggregate.LOG && resource != Resource.LOG
+                || aggregate == Aggregate.TRIGGER && resource != Resource.TRIGGER
+                || aggregate == Aggregate.FLOW_DESCRIPTION && resource != Resource.FLOW)
+                throw new IllegalArgumentException("Aggregate resource mismatch");
+        }
+    }
+
+    public record Decision(boolean allowed, QueryDomain scope, String reason, int contractVersion) {
+        public Decision {
+            if (contractVersion != CONTRACT_VERSION) throw new IllegalArgumentException("Unsupported contract version");
+            Objects.requireNonNull(scope, "Decision scope is required");
+            if (allowed && !scope.complete()) throw new IllegalArgumentException("Decision scope must be complete");
+            reason = reason == null ? "" : reason;
+        }
+        public static Decision deny(String reason) { return new Decision(false, QueryDomain.empty(), reason, CONTRACT_VERSION); }
+        public static Decision allow(QueryDomain scope) { return new Decision(true, scope, "", CONTRACT_VERSION); }
+    }
+}
