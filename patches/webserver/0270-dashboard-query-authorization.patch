@@ -0,0 +1,17 @@
+package io.kestra.core.services;
+
+import io.kestra.plugin.core.dashboard.data.IData;
+
+public interface DashboardQueryAccessControl {
+    void beforeQuery(String tenant, IData<?> datasource, boolean numerator);
+
+    default QueryScope openQuery(String tenant, IData<?> datasource, boolean numerator) {
+        beforeQuery(tenant, datasource, numerator);
+        return () -> {};
+    }
+
+    interface QueryScope extends AutoCloseable {
+        @Override
+        void close();
+    }
+}
