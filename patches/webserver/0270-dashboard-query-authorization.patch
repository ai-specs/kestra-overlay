+package io.kestra.webserver.rbac;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import io.kestra.core.models.dashboards.ColumnDescriptor;
+import io.kestra.core.models.dashboards.DataFilterKPI;
+import io.kestra.core.models.dashboards.filters.EqualTo;
+import io.kestra.core.repositories.ExecutionRepositoryInterface;
+import io.kestra.core.services.ChartDataService;
+import io.kestra.plugin.core.dashboard.chart.KPI;
+import io.kestra.plugin.core.dashboard.chart.kpis.KpiOption;
+import io.kestra.plugin.core.dashboard.data.ExecutionsKPI;
+import io.kestra.plugin.core.dashboard.data.IExecutions;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.context.ServerRequestContext;
+import io.micronaut.http.exceptions.HttpStatusException;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.SecurityFilter;
+import org.junit.jupiter.api.Test;
+
+import static io.kestra.webserver.rbac.TypedAuthorization.*;
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class TypedDashboardQueryTest {
+    @Test
+    @SuppressWarnings("unchecked")
+    void shouldAuthorizeNumeratorAndDenominatorSeparatelyBeforeEachQuery() throws Exception {
+        BeanProvider<TypedAuthorizationResolver> policies = mock(BeanProvider.class);
+        when(policies.isUnique()).thenReturn(true);
+        var seen = new ArrayList<Operation>();
+        when(policies.get()).thenReturn((principal, operation) -> {
+            seen.add(operation);
+            return CompletableFuture.completedFuture(Decision.allow(QueryDomain.unrestricted()));
+        });
+        var gate = new TypedDashboardGate(new RbacConfiguration(true, false), true, new TypedAuthorizationGate(policies));
+        var repository = mock(ExecutionRepositoryInterface.class);
+        when(repository.fetchValue(anyString(), any(), any(), any(), anyBoolean())).thenAnswer(invocation -> {
+            assertThat(seen).hasSize(invocation.getArgument(4, Boolean.class) ? 1 : 2);
+            return invocation.getArgument(4, Boolean.class) ? 2.0 : 4.0;
+        });
+        var service = new ChartDataService(List.of(repository), gate);
+        var data = ExecutionsKPI.<ColumnDescriptor<IExecutions.Fields>>builder().type("io.kestra.plugin.core.dashboard.data.ExecutionsKPI")
+            .numerator(List.of(EqualTo.<IExecutions.Fields>builder().field(IExecutions.Fields.NAMESPACE).value("team").build())).build();
+        var chart = KPI.<IExecutions.Fields, DataFilterKPI<IExecutions.Fields, ? extends ColumnDescriptor<IExecutions.Fields>>>builder()
+            .data(data).chartOptions(KpiOption.builder().numberType(KpiOption.NumberType.PERCENTAGE).build()).build();
+        var request = HttpRequest.GET("/api/v1/main/dashboards/charts/preview");
+        request.setAttribute(SecurityFilter.AUTHENTICATION, Authentication.build("reader", List.of("reader")));
+        ServerRequestContext.with(request, () -> {
+            assertThatCode(() -> assertThat(service.generateKPI("main", chart, null, null).getFirst().get("value")).isEqualTo(50.0))
+                .doesNotThrowAnyException();
+            assertThat(seen).hasSize(2);
+            assertThat(seen.getFirst().queryDomain().contains("other")).isFalse();
+            assertThat(seen.getLast().queryDomain().contains("other")).isTrue();
+            assertThat(seen).allMatch(operation -> operation.source() == Source.DASHBOARD_AGGREGATE);
+        });
+        clearInvocations(repository);
+        when(policies.get()).thenReturn((principal, operation) -> CompletableFuture.completedFuture(Decision.deny("Denied query")));
+        ServerRequestContext.with(request, () -> {
+            assertThatThrownBy(() -> service.generateKPI("main", chart, null, null)).isInstanceOf(HttpStatusException.class);
+        });
+        verify(repository, never()).fetchValue(anyString(), any(), any(), any(), anyBoolean());
+    }
+}
