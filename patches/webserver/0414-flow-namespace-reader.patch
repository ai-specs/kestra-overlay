+    @Test void metadataDomainIsOwnerBoundAndAbsentAfterReturn() throws Exception {
+        var h=new Harness(true,Set.of(Action.READ,Action.EXECUTE));var checked=new AtomicInteger();
+        when(h.namespace.exists(any())).thenAnswer(ignored->{
