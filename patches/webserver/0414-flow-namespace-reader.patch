+    @Test void nestedThreadLocalRestoredOnSuccessAndFailureWithoutWorkerLeak() throws Exception {
+        var field = FlowNamespaceFileReaderV1.class.getDeclaredField("CURRENT"); field.setAccessible(true);
+        @SuppressWarnings("unchecked") var local = (ThreadLocal<Object>) field.get(null);
+        var constructor = Class.forName(FlowNamespaceFileReaderV1.class.getName() + "$ReadScope")
+            .getDeclaredConstructor(AuthorizationEvaluations.Owner.class, String.class, String.class);
+        constructor.setAccessible(true);
+        Object previous = constructor.newInstance(null, "original", "/original");
+        var failures = new ConcurrentLinkedQueue<String>(); var checked = new AtomicInteger();
+        reactor.core.scheduler.Schedulers.onScheduleHook("flow-file-scope-test", task -> () -> {
+            Object original = local.get(); local.set(previous);
+            try { task.run(); } finally {
+                if (local.get() != previous) failures.add("nested scope not restored");
+                if (original == null) local.remove(); else local.set(original);
+                checked.incrementAndGet();
+            }
+        });
+        try {
+            var h = new Harness(true, Set.of(Action.READ, Action.EXECUTE));
+            assertThat(h.read("company", "/schema.json", 20).block()).isPresent();
+            doThrow(new IOException("read failed")).when(h.namespace).exists(any());
+            assertThatThrownBy(() -> h.read("company", "/schema.json", 20).block()).hasRootCauseMessage("read failed");
+            org.awaitility.Awaitility.await().atMost(Duration.ofSeconds(5)).untilAsserted(() -> assertThat(checked.get()).isGreaterThan(1));
+            assertThat(failures).isEmpty(); assertThat(local.get()).isNull();
+        } finally { reactor.core.scheduler.Schedulers.resetOnScheduleHook("flow-file-scope-test"); }
+    }
