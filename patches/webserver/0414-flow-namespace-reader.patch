+package io.kestra.webserver.rbac;
+
+import io.kestra.core.junit.annotations.KestraTest;
+import io.kestra.core.repositories.AuthorizationInvocationContext;
+import io.micronaut.context.annotation.Property;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.*;
+import io.micronaut.runtime.server.EmbeddedServer;
+import io.micronaut.security.authentication.Authentication;
+import io.micronaut.security.filters.AuthenticationFetcher;
+import io.micronaut.security.filters.SecurityFilter;
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import java.net.http.HttpClient;
+import java.util.Optional;
+import java.util.Set;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+import org.reactivestreams.Publisher;
+import reactor.core.publisher.Mono;
+import reactor.core.scheduler.Schedulers;
+import static org.assertj.core.api.Assertions.assertThat;
+
+@KestraTest(environments = "h2")
+@Property(name = "kestra.server-type", value = "WEBSERVER")
+@Property(name = "kestra.rbac.enabled", value = "false")
+@Property(name = "micronaut.security.enabled", value = "true")
+@Property(name = "micronaut.security.filter.enabled", value = "true")
+@Property(name = "micronaut.security.intercept-url-map[0].pattern", value = "/**")
+@Property(name = "micronaut.security.intercept-url-map[0].access[0]", value = "isAnonymous()")
+@Property(name = "mcp.http.security.fixture", value = "true")
+@Property(name = "flow.file.http.probe", value = "true")
+class FlowNamespaceFileReaderHttpTest {
+    @Inject EmbeddedServer server;
+    @Inject ReaderProvider provider;
+
+    @Test void authenticatedModeAOriginSurvivesRealHttpAndWorkerTransfer() throws Exception {
+        provider.lookups.set(0);
+        assertThat(get("ok", true)).isEqualTo(200);
+        assertThat(provider.lookups).hasValue(1);
+        assertThat(get("missing", true)).isEqualTo(401);
+        assertThat(get("wrong", true)).isEqualTo(401);
+        assertThat(get("ok", false)).isEqualTo(401);
+        assertThat(provider.lookups).hasValue(1);
+        assertThat(AuthorizationInvocationContext.current()).isEmpty();
+    }
+
+    private int get(String action, boolean authenticated) throws Exception {
+        var request = java.net.http.HttpRequest.newBuilder(server.getURI().resolve("/company.app/reader/" + action));
+        if (authenticated) request.header("X-File-Reader", "reader");
+        return HttpClient.newHttpClient().send(request.GET().build(), java.net.http.HttpResponse.BodyHandlers.ofString()).statusCode();
+    }
+
+    @Singleton @Requires(property = "flow.file.http.probe", value = "true")
+    static class Identity implements AuthenticationFetcher<HttpRequest<?>> {
+        public Publisher<Authentication> fetchAuthentication(HttpRequest<?> request) {
+            String subject = request.getHeaders().get("X-File-Reader");
+            return subject == null ? Mono.empty() : Mono.just(Authentication.build(subject));
+        }
+    }
+
+    @Singleton @Requires(property = "flow.file.http.probe", value = "true")
+    static class ReaderProvider implements HttpExtensionRouteProviderV1 {
+        final AtomicInteger lookups = new AtomicInteger();
+        public String id() { return "host-file-reader-probe"; }
+        public Optional<Target> match(HttpMethod method, String path) {
+            return path.startsWith("/company.app/reader/") ? Optional.of(new Target("company.app")) : Optional.empty();
+        }
+        public Publisher<MutableHttpResponse<?>> handle(HttpRequest<?> request, Target target) {
+            Authentication supplied = request.getAttribute(SecurityFilter.AUTHENTICATION, Authentication.class).orElseThrow();
+            if (request.getPath().endsWith("missing")) request.removeAttribute(SecurityFilter.AUTHENTICATION, Authentication.class);
+            if (request.getPath().endsWith("wrong")) request.setAttribute(SecurityFilter.AUTHENTICATION, Authentication.build("other"));
+            return Mono.<MutableHttpResponse<?>>defer(() -> {
+                try {
+                    assertThat(AuthorizationInvocationContext.currentRequest()).contains(request);
+                    assertThat(Thread.currentThread().getName()).contains("boundedElastic");
+                    var harness = new FlowNamespaceFileReaderV1Test.Harness(false, Set.of());
+                    return harness.reader.read(supplied, "main", FlowNamespaceFileReaderV1Test.flow(), "company", "/schema.json", 20)
+                        .map(content -> { lookups.incrementAndGet(); return (MutableHttpResponse<?>) HttpResponse.ok(); });
+                } catch (Exception failure) { return Mono.error(failure); }
+            }).subscribeOn(Schedulers.boundedElastic());
+        }
+    }
+}
