+package io.kestra.webserver.rbac;
+
+import io.kestra.core.models.QueryFilter;
+import io.kestra.core.models.flows.Flow;
+import io.kestra.core.models.flows.FlowWithException;
+import io.kestra.core.repositories.AuthorizationEvaluationContext;
+import io.kestra.core.repositories.AuthorizationInvocationContext;
+import io.kestra.core.storages.NamespaceFactory;
+import io.micronaut.context.BeanProvider;
+import io.micronaut.core.propagation.PropagatedContext;
+import io.micronaut.http.HttpStatus;
+import io.micronaut.http.exceptions.HttpStatusException;
+import io.micronaut.security.authentication.Authentication;
+import jakarta.inject.Singleton;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Optional;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicReference;
+import reactor.core.publisher.Mono;
+import reactor.core.scheduler.Schedulers;
+
+@Singleton
+public final class FlowNamespaceFileReaderV1 {
+    public static final int CONTRACT_VERSION = 1;
+    private static final ThreadLocal<ReadScope> CURRENT = new ThreadLocal<>();
+    private final RbacConfiguration configuration;
+    private final RbacGate gate;
+    private final BeanProvider<NamespaceFactory> factories;
+
+    public FlowNamespaceFileReaderV1(RbacConfiguration configuration, RbacGate gate, BeanProvider<NamespaceFactory> factories) {
+        this.configuration = configuration;
+        this.gate = gate;
+        this.factories = factories;
+    }
+
+    public Mono<Optional<Content>> read(Authentication authentication, String tenant, Flow flow,
+        String targetNamespace, String path, int maxBytes) {
+        return AuthorizationEvaluationContext.call(() -> {
+            validate(authentication, tenant, flow, targetNamespace, path, maxBytes);
+            var principal = new RbacAuthorizer.Principal(authentication.getName(), List.copyOf(authentication.getRoles()), null, null, List.of());
+            if (!configuration.enabled()) return readFile(flow.getTenantId(), targetNamespace, path, maxBytes, null);
+            var resource = new RbacAuthorizer.Resource(RbacAuthorizer.Kind.FLOW, RbacAuthorizer.Scope.NAMESPACE,
+                tenant, flow.getNamespace(), flow.getId());
+            return gate.boundary(principal, tenant, () -> gate.authorize(principal, resource, RbacAuthorizer.Action.READ)
+                .defaultIfEmpty(false).flatMap(allowed -> allowed
+                    ? gate.authorize(principal, resource, RbacAuthorizer.Action.EXECUTE).defaultIfEmpty(false) : Mono.just(false))
+                .flatMap(allowed -> allowed ? Mono.deferContextual(context -> {
+                    var owner = AuthorizationEvaluations.current(context);
+                    if (owner == null || !owner.matches(principal, tenant)) return Mono.error(unavailable());
+                    return readFile(flow.getTenantId(), targetNamespace, path, maxBytes, owner);
+                }) : Mono.error(new HttpStatusException(HttpStatus.FORBIDDEN, "Flow execution permission required"))))
+                .singleOrEmpty();
+        }).flatMap(result -> result).subscribeOn(Schedulers.boundedElastic());
+    }
+
+    private Mono<Optional<Content>> readFile(String tenant, String namespace, String path, int maxBytes,
+        AuthorizationEvaluations.Owner owner) {
+        return Mono.deferContextual(context -> {
+            var origin = AuthorizationEvaluationContext.capture(context);
+            return Mono.create(sink -> {
+                var scope = new ReadScope(owner, namespace, path);
+                var stream = new AtomicReference<InputStream>();
+                sink.onCancel(() -> {
+                    scope.active.set(false);
+                    Schedulers.boundedElastic().schedule(() -> close(stream.getAndSet(null)));
+                });
+                Schedulers.boundedElastic().schedule(() -> {
+                    try (var propagation = origin.propagate()) {
+                        if (!scope.active.get()) return;
+                        if (!factories.isUnique()) throw unavailable();
+                        var previous = CURRENT.get();
+                        CURRENT.set(scope);
+                        Optional<Content> result;
+                        try {
+                            var file = factories.get().of(tenant, namespace);
+                            if (!file.exists(Path.of(path))) {
+                                result = Optional.empty();
+                            } else {
+                            if (!scope.active.get()) return;
+                            InputStream opened = file.getFileContent(Path.of(path));
+                            if (opened == null) throw new IOException("Namespace file content stream missing");
+                            stream.set(opened);
+                            if (!scope.active.get()) { close(stream.getAndSet(null)); return; }
+                            {
+                                byte[] bytes = opened.readNBytes(maxBytes + 1);
+                                if (bytes.length > maxBytes) throw new HttpStatusException(HttpStatus.REQUEST_ENTITY_TOO_LARGE, "Namespace file exceeds byte limit");
+                                result = Optional.of(new Content(namespace, path, bytes));
+                            }
+                            }
+                        } finally {
+                            if (previous == null) CURRENT.remove(); else CURRENT.set(previous);
+                            close(stream.getAndSet(null));
+                        }
+                        if (scope.active.compareAndSet(true, false)) sink.success(result);
+                    } catch (Throwable failure) {
+                        scope.active.set(false);
+                        sink.error(failure);
+                    }
+                });
+            });
+        });
+    }
+
+    static TypedAuthorization.QueryDomain metadataDomain(QueryFilter.Resource resource, AuthorizationEvaluations.Owner owner) {
+        var scope = CURRENT.get();
+        if (scope == null || resource != QueryFilter.Resource.NAMESPACE_FILE_METADATA || scope.owner != owner
+            || owner == null || !scope.active.get() || !owner.matches(owner.principal, owner.tenant)) return null;
+        return new TypedAuthorization.QueryDomain(List.of(scope.namespace), List.of(), List.of(), true, false);
+    }
+
+    private static void validate(Authentication authentication, String tenant, Flow flow, String namespace, String path, int maxBytes) {
+        if (authentication == null || authentication.getName() == null || authentication.getName().isBlank())
+            throw new HttpStatusException(HttpStatus.UNAUTHORIZED, "Authentication required");
+        if (!"main".equals(tenant) || flow == null || flow instanceof FlowWithException || flow.isDisabled() || flow.isDeleted()
+            || flow.getRevision() == null || flow.getRevision() <= 0 || flow.isDraft()
+            || flow.getTenantId() != null && !tenant.equals(flow.getTenantId()) || flow.getId() == null
+            || !flow.getId().matches("[A-Za-z0-9_.-]+") || !validNamespace(flow.getNamespace()) || !validNamespace(namespace)
+            || !flow.getNamespace().equals(namespace) && !flow.getNamespace().startsWith(namespace + "."))
+            throw new HttpStatusException(HttpStatus.FORBIDDEN, "Invalid Flow file target");
+        if (path == null || !path.startsWith("/") || path.equals("/") || path.endsWith("/") || path.length() > 4096
+            || path.contains("%") || path.contains("\\") || path.contains("//") || path.contains("?") || path.contains("#")
+            || path.codePoints().anyMatch(codePoint -> codePoint < 32 || codePoint == 127))
+            throw new HttpStatusException(HttpStatus.BAD_REQUEST, "Invalid namespace file path");
+        for (String segment : path.split("/")) if (segment.equals(".") || segment.equals(".."))
+            throw new HttpStatusException(HttpStatus.BAD_REQUEST, "Invalid namespace file path");
+        if (maxBytes < 1 || maxBytes > 16 * 1024 * 1024) throw new IllegalArgumentException("maxBytes must be within 1..16MiB");
+        var request = AuthorizationInvocationContext.currentRequest();
+        if (request.isPresent()) {
+            var actual = request.get().getAttribute(io.micronaut.security.filters.SecurityFilter.AUTHENTICATION, Authentication.class).orElse(null);
+            if (actual == null || !actual.equals(authentication)) throw new HttpStatusException(HttpStatus.UNAUTHORIZED, "Identity mismatch");
+        }
+    }
+
+    private static boolean validNamespace(String value) { return value != null && value.matches("[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*"); }
+    private static AuthorizationUnavailableException unavailable() { return new AuthorizationUnavailableException(); }
+    private static void close(InputStream stream) { if (stream != null) try { stream.close(); } catch (IOException failure) { throw new IllegalStateException("Namespace file stream close failed", failure); } }
+    private static final class ReadScope {
+        private final AuthorizationEvaluations.Owner owner;
+        private final String namespace;
+        private final String path;
+        private final AtomicBoolean active = new AtomicBoolean(true);
+        private ReadScope(AuthorizationEvaluations.Owner owner, String namespace, String path) { this.owner = owner; this.namespace = namespace; this.path = path; }
+    }
+    public record Content(String namespace, String path, byte[] bytes) {
+        public Content { bytes = bytes.clone(); }
+        @Override public byte[] bytes() { return bytes.clone(); }
+    }
+}
