@@ -0,0 +1,135 @@
+package io.kestra.webserver.oidc;
+
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.Executors;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import io.kestra.webserver.oidc.services.OidcOwnershipService;
+import io.kestra.webserver.oidc.services.OidcRegistrationService;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class OidcOwnershipServiceTest extends OidcPostgresTestBase {
+    private final ObjectMapper mapper = new ObjectMapper();
+    private OidcOwnershipService owners;
+
+    @BeforeEach
+    void reset() throws Exception {
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("TRUNCATE oidc_client CASCADE");
+            statement.execute("INSERT INTO oidc_user(username,name,email) VALUES ('alice','Alice','alice@example.org'),('bob','Bob','bob@example.org') ON CONFLICT(username) DO UPDATE SET user_state='ACTIVE'");
+        }
+        owners = new OidcOwnershipService(dataSource(), mapper, 2);
+    }
+
+    private String register() {
+        return (String) new OidcRegistrationService(dataSource(), mapper, 10).register(Map.of(
+            "redirect_uris", List.of("https://example.org/callback"), "token_endpoint_auth_method", "none")).get("client_id");
+    }
+
+    private Map<String, List<String>> parameters() {
+        return Map.of("scope", List.of("openid profile"), "redirect_uri", List.of("https://example.org/callback"),
+            "code_challenge", List.of("a".repeat(43)), "code_challenge_method", List.of("S256"));
+    }
+
+    @Test
+    void shouldBindOnceAndRejectOtherUsers() {
+        final String client = register();
+        assertEquals("pending", owners.state(client).kind());
+        assertThrows(IllegalArgumentException.class, () -> owners.requireOwner(client, "alice"));
+        final String interaction = owners.begin(client, "alice", "session", parameters());
+        assertThrows(IllegalArgumentException.class, () -> owners.complete(interaction, "bob", "session", true));
+        owners.complete(interaction, "alice", "session", true);
+        owners.requireOwner(client, "alice");
+        assertThrows(IllegalArgumentException.class, () -> owners.requireOwner(client, "bob"));
+        assertThrows(IllegalArgumentException.class, () -> owners.complete(interaction, "alice", "session", true));
+        assertThrows(IllegalArgumentException.class, () -> owners.begin(client, "bob", "other", Map.of()));
+    }
+
+    @Test
+    void shouldDeleteDeniedPendingButPreserveOwnedClient() {
+        final String client = register();
+        final String interaction = owners.begin(client, "alice", "session", Map.of());
+        owners.complete(interaction, "alice", "session", false);
+        assertThrows(IllegalArgumentException.class, () -> owners.state(client));
+        final String owned = register();
+        owners.complete(owners.begin(owned, "alice", "session", parameters()), "alice", "session", true);
+        owners.complete(owners.begin(owned, "alice", "session", Map.of()), "alice", "session", false);
+        owners.requireOwner(owned, "alice");
+    }
+
+    @Test
+    void shouldIssueNarrowedCodeAtomicallyAndRejectNullOwner() throws Exception {
+        final String client = register();
+        final String interaction = owners.begin(client, "alice", "session", parameters());
+        assertThrows(IllegalArgumentException.class, () -> owners.complete(interaction, "alice", "session", true, List.of("email")));
+        final var result = owners.complete(interaction, "alice", "session", true, List.of("openid"));
+        owners.requireOwner(client, "alice");
+        assertThrows(IllegalArgumentException.class, () -> owners.requireOwner(client, null));
+        try (var connection = dataSource().getConnection(); var statement = connection.prepareStatement(
+            "SELECT subject,scopes FROM oidc_authorization_code WHERE code=?")) {
+            statement.setString(1, result.code());
+            try (var row = statement.executeQuery()) {
+                assertTrue(row.next());
+                assertEquals("alice", row.getString(1));
+                assertEquals(List.of("openid"), mapper.readValue(row.getString(2), List.class));
+            }
+        }
+    }
+
+    @Test
+    void shouldRejectInactiveUserAndEmptyScopeWithoutBinding() throws Exception {
+        final String client = register();
+        final String interaction = owners.begin(client, "alice", "session", parameters());
+        assertThrows(IllegalArgumentException.class, () -> owners.complete(interaction, "alice", "session", true, List.of()));
+        try (var connection = dataSource().getConnection(); var statement = connection.createStatement()) {
+            statement.execute("UPDATE oidc_user SET user_state='INACTIVE' WHERE username='alice'");
+        }
+        assertThrows(IllegalArgumentException.class, () -> owners.complete(interaction, "alice", "session", true, List.of("openid")));
+        assertEquals("pending", owners.state(client).kind());
+    }
+
+    @Test
+    void shouldSerializeRegistrationCleanupApprovalAndRejection() throws Exception {
+        final String client = register();
+        final String approval = owners.begin(client, "alice", "a", parameters());
+        final String denial = owners.begin(client, "bob", "b", parameters());
+        final String expired = register();
+        try (var connection = dataSource().getConnection(); var statement = connection.prepareStatement(
+            "UPDATE oidc_client SET pending_expires_at=now()-interval '1 second' WHERE client_id=?")) {
+            statement.setString(1, expired);
+            statement.executeUpdate();
+        }
+        try (var executor = Executors.newFixedThreadPool(3)) {
+            final var results = executor.invokeAll(List.of(
+                () -> attempt(approval, "alice", "a"),
+                () -> { try { owners.complete(denial, "bob", "b", false); return 1; } catch (IllegalArgumentException exception) { return 0; } },
+                () -> { register(); return 1; }), 10, java.util.concurrent.TimeUnit.SECONDS);
+            assertTrue(results.stream().noneMatch(java.util.concurrent.Future::isCancelled));
+            for (final var result : results) result.get();
+        }
+        assertThrows(IllegalArgumentException.class, () -> owners.state(expired));
+    }
+
+    @Test
+    void shouldAllowOnlyOneConcurrentOwner() throws Exception {
+        final String client = register();
+        final String first = owners.begin(client, "alice", "a", parameters());
+        final String second = owners.begin(client, "bob", "b", parameters());
+        try (var executor = Executors.newFixedThreadPool(2)) {
+            final var results = executor.invokeAll(List.of(
+                () -> attempt(first, "alice", "a"), () -> attempt(second, "bob", "b")));
+            assertEquals(1, (int) results.get(0).get() + (int) results.get(1).get());
+        }
+    }
+
+    private int attempt(final String interaction, final String user, final String session) {
+        try { owners.complete(interaction, user, session, true); return 1; }
+        catch (IllegalArgumentException exception) { return 0; }
+    }
+}
