+        @Value("${kestra.oidc.registration.max-clients-per-user:20}") final int ownerMaximum,
+        final io.kestra.webserver.oidc.OidcConfiguration configuration, final OidcConsentPolicy consentPolicy) {
+        this.source = DelegatingDataSource.unwrapDataSource(source);
+        this.mapper = mapper;
+        if (ownerMaximum < 1 || ownerMaximum > 1000) throw new IllegalArgumentException("Invalid owner client limit");
