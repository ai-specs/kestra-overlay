@@ -0,0 +1,21 @@
+package io.kestra.webserver.oidc.services;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+
+public interface OidcClientSecretCodec {
+    String format();
+    String encode(String secret);
+    boolean matches(String secret, String encoded);
+
+    static OidcClientSecretCodec plaintext() {
+        return new OidcClientSecretCodec() {
+            public String format() { return "plain-v1"; }
+            public String encode(final String secret) { return secret == null ? "" : secret; }
+            public boolean matches(final String secret, final String encoded) {
+                if (secret == null || encoded == null || secret.isEmpty() || encoded.isEmpty()) return false;
+                return MessageDigest.isEqual(secret.getBytes(StandardCharsets.UTF_8), encoded.getBytes(StandardCharsets.UTF_8));
+            }
+        };
+    }
+}
