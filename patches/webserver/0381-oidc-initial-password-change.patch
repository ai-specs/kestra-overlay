+class OidcPasswordChangePostgresTest extends OidcPostgresTestBase {
+    @Test void temporaryCredentialCannotCreateNormalIdentityBeforeCompletion() throws Exception {
+        try(var fixture=new OidcAccountLifecycleGuardPostgresTest.Fixture()) {
+            var directory=new OidcUserDirectory(fixture.source);
