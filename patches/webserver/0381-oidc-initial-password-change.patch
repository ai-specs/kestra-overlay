+            directory.setActive("temporary",0,false);
+            assertFalse(changes.active(interaction));
+            assertThrows(IllegalArgumentException.class,()->changes.complete(interaction,"ChangedPassword123!"));
+            directory.setActive("temporary",1,true);
+            assertThrows(IllegalArgumentException.class,()->changes.complete(interaction,"ChangedPassword123!"));
+            String current=changes.begin("temporary",created.temporaryPassword()).orElseThrow();
+            try(var connection=fixture.source.getConnection();var statement=connection.createStatement()) {
+                statement.execute("UPDATE oidc_password_change SET expires_at=now()-interval '1 second'");
+            }
+            assertFalse(changes.active(current));
+            assertThrows(IllegalArgumentException.class,()->changes.complete(current,"ChangedPassword123!"));
+        }
+    }
+
+    @Test void storageFailureRollsBackPasswordVersionAndInteractionConsumption() throws Exception {
+        try(var fixture=new OidcAccountLifecycleGuardPostgresTest.Fixture()) {
+            var created=new OidcUserDirectory(fixture.source).createTemporary("temporary",null,null);
+            var changes=new OidcPasswordChanges(fixture.source);
+            String interaction=changes.begin("temporary",created.temporaryPassword()).orElseThrow();
+            try(var connection=fixture.source.getConnection();var statement=connection.createStatement()) {
+                statement.execute("ALTER TABLE oidc_user ADD CONSTRAINT password_test_fail CHECK(password_change_required OR username<>'temporary')");
+            }
+            assertThrows(IllegalStateException.class,()->changes.complete(interaction,"ChangedPassword123!"));
+            assertTrue(changes.active(interaction));
+            assertEquals(0,fixture.count("SELECT authentication_version FROM oidc_user WHERE username='temporary'"));
+            changes.cancel(interaction);assertFalse(changes.active(interaction));
+        }
+    }
+}
