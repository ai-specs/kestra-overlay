@@ -0,0 +1,27 @@
+package io.kestra.webserver.oidc.controllers;
+
+import io.kestra.webserver.oidc.services.OidcPasswordChanges;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.MutableHttpResponse;
+import io.micronaut.http.annotation.Filter;
+import io.micronaut.http.filter.HttpServerFilter;
+import io.micronaut.http.filter.ServerFilterChain;
+import org.reactivestreams.Publisher;
+import reactor.core.publisher.Mono;
+
+@Filter("/oidc/logout")
+@Requires(property="kestra.oidc.enabled",value="true")
+public final class OidcPasswordChangeLogoutFilter implements HttpServerFilter {
+    private final OidcPasswordChanges changes;
+    public OidcPasswordChangeLogoutFilter(OidcPasswordChanges changes) {this.changes=changes;}
+
+    @Override public Publisher<MutableHttpResponse<?>> doFilter(HttpRequest<?> request,ServerFilterChain chain) {
+        return Mono.fromCallable(()->{
+            changes.cancel(OidcPasswordChangeController.interaction(request));
+            return true;
+        }).subscribeOn(reactor.core.scheduler.Schedulers.boundedElastic())
+            .flatMap(ignored->Mono.from(chain.proceed(request)))
+            .map(response->response.cookie(OidcPasswordChangeController.cookie(request,"",0)));
+    }
+}
