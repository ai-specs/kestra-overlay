+package io.kestra.webserver.oidc;
+
+import io.kestra.core.junit.annotations.KestraTest;
+import io.kestra.webserver.oidc.services.OidcIdentityLifecycle;
+import io.kestra.webserver.oidc.services.OidcPasswordChanges;
+import io.kestra.webserver.oidc.services.OidcSetupService;
+import io.kestra.webserver.oidc.services.OidcUserDirectory;
+import io.micronaut.context.annotation.Factory;
+import io.micronaut.context.annotation.Property;
+import io.micronaut.context.annotation.Replaces;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.runtime.server.EmbeddedServer;
+import jakarta.inject.Inject;
+import jakarta.inject.Singleton;
+import java.net.URI;
+import java.net.URLEncoder;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@KestraTest(environments="h2")
+@Property(name="kestra.server-type",value="WEBSERVER")
+@Property(name="kestra.oidc.enabled",value="true")
+@Property(name="kestra.oidc.issuer",value="http://localhost")
+@Property(name="micronaut.security.enabled",value="false")
+@Property(name="kestra.rbac.enabled",value="true")
+@Property(name="kestra.rbac.typed.enabled",value="true")
+@Property(name="oidc.password.http.test",value="true")
+class OidcPasswordChangeHttpTest extends OidcPostgresTestBase {
+    @Inject EmbeddedServer server;
+
+    @Test void productionLoginRestrictsTemporaryCredentialAndRequiresSameOriginSingleUseChange() throws Exception {
+        String username="temporary-"+UUID.randomUUID();
+        var created=new OidcUserDirectory(dataSource()).createTemporary(username,null,null);
+        var client=HttpClient.newHttpClient();
+        var login=client.send(HttpRequest.newBuilder(server.getURI().resolve("/oidc/login"))
+            .header("Content-Type","application/x-www-form-urlencoded")
+            .POST(HttpRequest.BodyPublishers.ofString("username="+encode(username)+"&password="+encode(created.temporaryPassword()))).build(),HttpResponse.BodyHandlers.ofString());
+        assertEquals(303,login.statusCode());assertEquals("/oidc/password",login.headers().firstValue("location").orElseThrow());
+        String cookie=login.headers().allValues("set-cookie").stream().filter(value->value.startsWith("oidc_password_change=")).findFirst().orElseThrow().split(";",2)[0];
+        assertTrue(login.headers().allValues("set-cookie").stream().noneMatch(value->value.startsWith("oidc_session=")&&!value.contains("Max-Age=0")));
+        var page=client.send(HttpRequest.newBuilder(server.getURI().resolve("/oidc/password")).header("Cookie",cookie).GET().build(),HttpResponse.BodyHandlers.ofString());
+        assertEquals(200,page.statusCode());assertTrue(page.body().contains("autocomplete=\"new-password\""));assertEquals("no-store",page.headers().firstValue("cache-control").orElseThrow());
+        String unchanged=protocolState();
+        String token=cookie.substring(cookie.indexOf('=')+1);
+        String body="csrf="+encode(token)+"&password=ChangedPassword123!&confirmation=ChangedPassword123!";
+        var rejected=client.send(HttpRequest.newBuilder(server.getURI().resolve("/oidc/password")).header("Cookie",cookie)
+            .header("Origin","https://other.example").header("Content-Type","application/x-www-form-urlencoded")
+            .POST(HttpRequest.BodyPublishers.ofString(body)).build(),HttpResponse.BodyHandlers.ofString());
+        assertEquals(403,rejected.statusCode());
+        assertEquals(unchanged,protocolState());
+        assertFalse(rejected.body().contains(created.temporaryPassword()));
+        var invalidCsrf=client.send(HttpRequest.newBuilder(server.getURI().resolve("/oidc/password")).header("Cookie",cookie)
+            .header("Origin","http://localhost").header("Content-Type","application/x-www-form-urlencoded")
+            .POST(HttpRequest.BodyPublishers.ofString(body.replace("csrf="+encode(token),"csrf="+"x".repeat(43)))).build(),HttpResponse.BodyHandlers.ofString());
+        assertEquals(403,invalidCsrf.statusCode());
+        assertEquals(unchanged,protocolState());
+        assertTrue(invalidCsrf.body().contains("role=\"alert\""));assertFalse(invalidCsrf.body().contains("name=\"csrf\""));
+        var changed=client.send(HttpRequest.newBuilder(server.getURI().resolve("/oidc/password")).header("Cookie",cookie)
+            .header("Origin","http://localhost").header("Content-Type","application/x-www-form-urlencoded")
+            .POST(HttpRequest.BodyPublishers.ofString(body)).build(),HttpResponse.BodyHandlers.ofString());
+        assertEquals(303,changed.statusCode());assertEquals("/oidc/login",changed.headers().firstValue("location").orElseThrow());
+        var replay=client.send(HttpRequest.newBuilder(server.getURI().resolve("/oidc/password")).header("Cookie",cookie)
+            .header("Origin","http://localhost").header("Content-Type","application/x-www-form-urlencoded")
+            .POST(HttpRequest.BodyPublishers.ofString(body)).build(),HttpResponse.BodyHandlers.ofString());
+        assertEquals(410,replay.statusCode());assertTrue(replay.body().contains("resource-expired"));
+        var authenticated=client.send(HttpRequest.newBuilder(server.getURI().resolve("/oidc/login"))
+            .header("Content-Type","application/x-www-form-urlencoded")
+            .POST(HttpRequest.BodyPublishers.ofString("username="+encode(username)+"&password=ChangedPassword123!&from=%2Fui%2F")).build(),HttpResponse.BodyHandlers.ofString());
+        assertEquals(303,authenticated.statusCode());assertEquals("/ui/",authenticated.headers().firstValue("location").orElseThrow());
+        assertTrue(authenticated.headers().allValues("set-cookie").stream().anyMatch(value->value.startsWith("oidc_session=")));
+        var second=new OidcUserDirectory(dataSource()).createTemporary("logout-"+UUID.randomUUID(),null,null);
+        var restricted=client.send(HttpRequest.newBuilder(server.getURI().resolve("/oidc/login"))
+            .header("Content-Type","application/x-www-form-urlencoded")
+            .POST(HttpRequest.BodyPublishers.ofString("username="+encode(second.user().subject())+"&password="+encode(second.temporaryPassword()))).build(),HttpResponse.BodyHandlers.ofString());
+        String restrictedCookie=restricted.headers().allValues("set-cookie").stream().filter(value->value.startsWith("oidc_password_change=")).findFirst().orElseThrow().split(";",2)[0];
+        var logout=client.send(HttpRequest.newBuilder(server.getURI().resolve("/oidc/logout")).header("Cookie",restrictedCookie).GET().build(),HttpResponse.BodyHandlers.ofString());
+        assertEquals(307,logout.statusCode());
+        assertTrue(logout.headers().allValues("set-cookie").stream().anyMatch(value->value.startsWith("oidc_password_change=")&&value.contains("Max-Age=0")));
+        assertFalse(new OidcPasswordChanges(dataSource()).active(restrictedCookie.substring(restrictedCookie.indexOf('=')+1)));
+        browserMatrixWhenRequested();
+    }
+
+    private void browserMatrixWhenRequested() throws Exception {
+        String script=System.getenv("OIDC_PASSWORD_BROWSER_SCRIPT");
+        if(script==null)return;
+        String browserSpace=System.getenv("OIDC_PASSWORD_BROWSER_SPACE");
+        if(browserSpace==null || !browserSpace.matches("[0-9]+"))throw new IllegalStateException("An existing browser task space is required");
+        var directory=new OidcUserDirectory(dataSource());
+        var first=directory.createTemporary("browser-"+UUID.randomUUID(),null,null);
+        var second=directory.createTemporary("browser-"+UUID.randomUUID(),null,null);
+        var mapper=new com.fasterxml.jackson.databind.ObjectMapper();
+        var translations=new java.util.LinkedHashMap<String,java.util.List<String>>();
+        var translationRoot=java.nio.file.Path.of(System.getenv("OIDC_PASSWORD_TRANSLATIONS"));
+        try(var files=java.nio.file.Files.list(translationRoot)) {
+            for(var file:files.filter(path->path.toString().endsWith(".json")).sorted().toList()) {
+                var document=mapper.readTree(file.toFile()).elements().next();
+                translations.put(file.getFileName().toString().replace(".json",""),java.util.List.of(document.path("password").asText(),
+                    document.path("confirm password").asText(),document.path("save").asText(),document.path("setup").path("logout").asText()));
+            }
+        }
+        String input=mapper.writeValueAsString(java.util.Map.of("baseUrl",server.getURI().toString(),"username",first.user().subject(),
+            "temporaryPassword",first.temporaryPassword(),"secondUsername",second.user().subject(),"secondTemporaryPassword",second.temporaryPassword(),"translations",translations));
+        String module=mapper.writeValueAsString(java.nio.file.Path.of(script).toUri().toString());
+        String report=mapper.writeValueAsString(System.getenv("OIDC_PASSWORD_BROWSER_REPORT"));
+        String code="const task=await taskSpace("+browserSpace+");console.log('spaceId='+task.spaceId);const page=task.page('p1');"
+            +"const {runPasswordChangeBrowserCases}=await import("+module+");const fs=await import('node:fs/promises');"
+            +"try{const report=await runPasswordChangeBrowserCases(page,"+input+",async(width,height,dark=false)=>{await page.cdp('Emulation.setDeviceMetricsOverride',{width,height,deviceScaleFactor:1,mobile:false});await page.cdp('Emulation.setEmulatedMedia',{features:[{name:'prefers-color-scheme',value:dark?'dark':'light'}]});});"
+            +"await fs.writeFile("+report+",JSON.stringify(report,null,2));console.log('password-browser checks='+report.checks.length);await task.finish({keep:[]});}"
+            +"catch(error){await fs.writeFile("+report+",JSON.stringify(error.report??{completed:false},null,2));throw error;}";
+        var process=new ProcessBuilder("ego-browser","nodejs").redirectErrorStream(true).start();
+        try(var stream=process.getOutputStream()) {stream.write(code.getBytes(StandardCharsets.UTF_8));}
+        String output=new String(process.getInputStream().readAllBytes(),StandardCharsets.UTF_8)
+            .replace(first.temporaryPassword(),"[REDACTED]").replace(second.temporaryPassword(),"[REDACTED]");
+        assertTrue(process.waitFor(5,java.util.concurrent.TimeUnit.MINUTES),"Browser verification timeout");
+        assertEquals(0,process.exitValue(),output);
+        System.out.println(output);
+        try(var connection=dataSource().getConnection();var statement=connection.prepareStatement("SELECT count(*) FROM oidc_password_change WHERE subject=?")) {
+            statement.setString(1,second.user().subject());try(var rows=statement.executeQuery()) {rows.next();assertEquals(0,rows.getLong(1));}
+        }
+    }
+
+    private static String encode(String value) {return URLEncoder.encode(value,StandardCharsets.UTF_8);}
+
+    private static String protocolState() throws Exception {
+        var digest=java.security.MessageDigest.getInstance("SHA-256");
+        try(var connection=dataSource().getConnection();var statement=connection.createStatement()) {
+            for(String table:java.util.List.of("oidc_user","oidc_user_auth_method","oidc_password_change","oidc_authorization_code","oidc_token")) {
+                try(var rows=statement.executeQuery("SELECT row_to_json(probe_row.*)::text FROM "+table+" probe_row ORDER BY row_to_json(probe_row.*)::text")) {
+                    while(rows.next())digest.update(rows.getString(1).getBytes(StandardCharsets.UTF_8));
+                }
+            }
+        }
+        return java.util.HexFormat.of().formatHex(digest.digest());
+    }
+
+    @Factory
+    @Requires(property="oidc.password.http.test",value="true")
+    static class Services {
+        @Singleton @Replaces(OidcPasswordChanges.class)
+        OidcPasswordChanges changes() {return new OidcPasswordChanges(dataSource());}
+        @Singleton @Replaces(OidcIdentityLifecycle.class)
+        OidcIdentityLifecycle lifecycle() {return new OidcIdentityLifecycle(dataSource());}
+        @Singleton @Replaces(OidcSetupService.class)
+        OidcSetupService setup() {var setup=mock(OidcSetupService.class);when(setup.ready()).thenReturn(true);return setup;}
+    }
+}
