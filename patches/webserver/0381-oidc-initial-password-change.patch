index 0000000..3c6c99f
--- /dev/null
+++ b/webserver/src/main/java/io/kestra/webserver/oidc/services/OidcPasswordChanges.java
@@ -0,0 +1,124 @@
+package io.kestra.webserver.oidc.services;
+
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.data.connection.jdbc.advice.DelegatingDataSource;
+import jakarta.inject.Singleton;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.SecureRandom;
+import java.sql.Connection;
+import java.sql.SQLException;
+import java.util.Base64;
+import java.util.Optional;
+import javax.sql.DataSource;
+import org.mindrot.jbcrypt.BCrypt;
+
+@Singleton
+@Requires(property="kestra.oidc.enabled",value="true")
+public final class OidcPasswordChanges {
+    private final DataSource source;
+    public OidcPasswordChanges(DataSource source) { this.source=DelegatingDataSource.unwrapDataSource(source); }
+
+    private interface Work<Result> { Result run(Connection connection) throws SQLException; }
+    private <Result> Result transaction(Work<Result> work) {
+        try(var connection=source.getConnection()) {
+            connection.setTransactionIsolation(Connection.TRANSACTION_READ_COMMITTED);connection.setAutoCommit(false);
+            try {
+                OidcSecurityTransactions.lock(connection);
+                Result result=work.run(connection);connection.commit();return result;
+            } catch(SQLException|RuntimeException failure) {
+                connection.rollback();
+                if(failure instanceof IllegalArgumentException invalid)throw invalid;
+                throw new IllegalStateException("Password change unavailable");
+            }
+        } catch(SQLException failure) { throw new IllegalStateException("Password change unavailable"); }
+    }
+
+    public Optional<String> begin(String username,String password) {
+        if(username==null || password==null || password.getBytes(StandardCharsets.UTF_8).length>72)return Optional.empty();
+        return transaction(connection -> {
+            long version;
+            try(var statement=connection.prepareStatement("SELECT account.authentication_version,method.credential FROM oidc_user account "
+                + "JOIN oidc_user_auth_method method ON method.user_id=account.username WHERE account.username=? AND account.user_state='ACTIVE' "
+                + "AND account.password_change_required AND method.type='PASSWORD' AND method.state='ACTIVE'")) {
+                statement.setString(1,username);
+                try(var rows=statement.executeQuery()) {
+                    if(!rows.next() || !BCrypt.checkpw(password,rows.getString(2)))return Optional.empty();
+                    version=rows.getLong(1);
+                }
+            }
+            try(var statement=connection.prepareStatement("DELETE FROM oidc_password_change WHERE subject=? OR expires_at<=now()")) {
+                statement.setString(1,username);statement.executeUpdate();
+            }
+            byte[] bytes=new byte[32];new SecureRandom().nextBytes(bytes);
+            String interaction=Base64.getUrlEncoder().withoutPadding().encodeToString(bytes);
+            try(var statement=connection.prepareStatement("INSERT INTO oidc_password_change(interaction_hash,subject,authentication_version,expires_at) VALUES(?,?,?,now()+interval '10 minutes')")) {
+                statement.setString(1,digest(interaction));statement.setString(2,username);statement.setLong(3,version);statement.executeUpdate();
+            }
+            return Optional.of(interaction);
+        });
+    }
+
+    public boolean active(String interaction) {
+        if(!valid(interaction))return false;
+        return transaction(connection -> {
+            try(var statement=connection.prepareStatement("SELECT 1 FROM oidc_password_change change JOIN oidc_user account ON account.username=change.subject "
+                + "WHERE change.interaction_hash=? AND change.expires_at>now() AND account.user_state='ACTIVE' AND account.password_change_required "
+                + "AND account.authentication_version=change.authentication_version")) {
+                statement.setString(1,digest(interaction));try(var rows=statement.executeQuery()) {return rows.next();}
+            }
+        });
+    }
+
+    public void complete(String interaction,String password) {
+        if(!valid(interaction) || password==null || password.length()<8 || password.getBytes(StandardCharsets.UTF_8).length>72)
+            throw new IllegalArgumentException("Invalid password change");
+        String credential=BCrypt.hashpw(password,BCrypt.gensalt());
+        transaction(connection -> {
+            String subject;long version;
+            try(var statement=connection.prepareStatement("SELECT subject,authentication_version FROM oidc_password_change WHERE interaction_hash=? AND expires_at>now() FOR UPDATE")) {
+                statement.setString(1,digest(interaction));
+                try(var rows=statement.executeQuery()) {
+                    if(!rows.next())throw new IllegalArgumentException("Invalid password change");
+                    subject=rows.getString(1);version=rows.getLong(2);
+                }
+            }
+            try(var statement=connection.prepareStatement("SELECT credential FROM oidc_user_auth_method WHERE user_id=? AND type='PASSWORD' AND state='ACTIVE'")) {
+                statement.setString(1,subject);
+                try(var rows=statement.executeQuery()) {
+                    if(!rows.next() || BCrypt.checkpw(password,rows.getString(1)))throw new IllegalArgumentException("Invalid password change");
+                }
+            }
+            try(var statement=connection.prepareStatement("UPDATE oidc_user SET password_change_required=false,authentication_version=authentication_version+1,"
+                + "directory_revision=directory_revision+1,updated_at=now() WHERE username=? AND authentication_version=? AND user_state='ACTIVE' AND password_change_required")) {
+                statement.setString(1,subject);statement.setLong(2,version);
+                if(statement.executeUpdate()!=1)throw new IllegalArgumentException("Invalid password change");
+            }
+            try(var statement=connection.prepareStatement("UPDATE oidc_user_auth_method SET credential=?,updated_at=now() WHERE user_id=? AND type='PASSWORD' AND state='ACTIVE'")) {
+                statement.setString(1,credential);statement.setString(2,subject);
+                if(statement.executeUpdate()!=1)throw new IllegalStateException("Password change unavailable");
+            }
+            for(String sql:java.util.List.of("DELETE FROM oidc_password_change WHERE subject=?",
+                "UPDATE oidc_token SET revoked=true WHERE subject=?","UPDATE oidc_authorization_code SET used=true WHERE subject=?")) {
+                try(var statement=connection.prepareStatement(sql)) {statement.setString(1,subject);statement.executeUpdate();}
+            }
+            return null;
+        });
+    }
+
+    public void cancel(String interaction) {
+        if(!valid(interaction))return;
+        transaction(connection -> {
+            try(var statement=connection.prepareStatement("DELETE FROM oidc_password_change WHERE interaction_hash=?")) {
+                statement.setString(1,digest(interaction));statement.executeUpdate();
+            }
+            return null;
+        });
+    }
+
+    public static boolean valid(String interaction) { return interaction!=null && interaction.matches("[A-Za-z0-9_-]{43}"); }
+    private static String digest(String interaction) {
+        try { return java.util.HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(interaction.getBytes(StandardCharsets.UTF_8))); }
+        catch(java.security.NoSuchAlgorithmException failure) {throw new IllegalStateException("Password change unavailable");}
+    }
+}
