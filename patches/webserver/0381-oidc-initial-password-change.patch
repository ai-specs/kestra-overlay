+            assertTrue(lifecycle.activeVersion("temporary").isEmpty());
+            String interaction=changes.begin("temporary",created.temporaryPassword()).orElseThrow();
+            assertTrue(changes.active(interaction));
+            assertThrows(IllegalArgumentException.class,()->changes.complete(interaction,created.temporaryPassword()));
+            changes.complete(interaction,"ChangedPassword123!");
+            assertFalse(changes.active(interaction));
+            assertThrows(IllegalArgumentException.class,()->changes.complete(interaction,"AnotherPassword123!"));
+            assertTrue(lifecycle.authenticate("temporary",created.temporaryPassword()).isEmpty());
