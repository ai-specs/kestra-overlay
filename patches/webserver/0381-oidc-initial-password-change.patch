+package io.kestra.webserver.oidc.controllers;
+
+import io.kestra.webserver.oidc.OidcConfiguration;
+import io.kestra.webserver.oidc.services.OidcPageTheme;
+import io.kestra.webserver.oidc.services.OidcPasswordChanges;
+import io.micronaut.context.annotation.Requires;
+import io.micronaut.http.HttpRequest;
+import io.micronaut.http.HttpResponse;
+import io.micronaut.http.HttpStatus;
+import io.micronaut.http.MediaType;
+import io.micronaut.http.annotation.Body;
+import io.micronaut.http.annotation.Consumes;
+import io.micronaut.http.annotation.Controller;
+import io.micronaut.http.annotation.Get;
+import io.micronaut.http.annotation.Post;
+import io.micronaut.http.annotation.Produces;
+import io.micronaut.http.cookie.Cookie;
+import io.micronaut.http.cookie.SameSite;
+import io.micronaut.scheduling.TaskExecutors;
+import io.micronaut.scheduling.annotation.ExecuteOn;
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.Map;
+
+@Controller("/oidc/password")
+@Produces(MediaType.TEXT_HTML)
+@Requires(property="kestra.oidc.enabled",value="true")
+@ExecuteOn(TaskExecutors.IO)
+public final class OidcPasswordChangeController {
+    private static final String COOKIE="oidc_password_change";
+    private final OidcPasswordChanges changes;
+    private final String origin;
+
+    public OidcPasswordChangeController(OidcPasswordChanges changes,OidcConfiguration configuration) {
+        this.changes=changes;
+        var issuer=URI.create(configuration.getIssuer());this.origin=issuer.getScheme()+"://"+issuer.getRawAuthority();
+    }
+
+    static String interaction(HttpRequest<?> request) {return request.getCookies().findCookie(COOKIE).map(Cookie::getValue).orElse("");}
+    static Cookie cookie(HttpRequest<?> request,String value,int seconds) {
+        return Cookie.of(COOKIE,value).path("/oidc").httpOnly(true).secure(request.isSecure()).sameSite(SameSite.Strict).maxAge(seconds);
+    }
+
+    @Get
+    public HttpResponse<?> page(HttpRequest<?> request) {
+        return form(request,null,HttpStatus.OK);
+    }
+
+    private HttpResponse<?> form(HttpRequest<?> request,String errorKey,HttpStatus status) {
+        try {
+            String interaction=interaction(request);
+            if(!changes.active(interaction))return render("","errors.problems.resource-expired.title",HttpStatus.GONE,false)
+                .cookie(cookie(request,"",0));
+            return render(interaction,errorKey,status,true);
+        }catch(IllegalStateException failure) {return render("","errors.503.content",HttpStatus.SERVICE_UNAVAILABLE,false);}
+    }
+
+    private io.micronaut.http.MutableHttpResponse<String> render(String interaction,String errorKey,HttpStatus status,boolean editable) {
+            String error=errorKey==null?"":"<p class=\"error\" role=\"alert\" data-i18n=\""+errorKey+"\">Invalid request. Please try again.</p>";
+            String fields=editable?"""
+                <form method="post" action="/oidc/password"><input type="hidden" name="csrf" value="%s">
+                <label><span data-i18n="password">Password</span><input name="password" type="password" autocomplete="new-password" minlength="8" required></label>
+                <label><span data-i18n="confirm password">Confirm password</span><input name="confirmation" type="password" autocomplete="new-password" minlength="8" required></label>
+                <button type="submit" data-i18n="save">Save</button></form>
+                """.formatted(interaction):status==HttpStatus.GONE?
+                "<a href=\"/oidc/login\" data-i18n=\"setup.login\">Login</a>":"<a href=\"/oidc/password\" data-i18n=\"file_preview.retry\">Retry</a>";
+            String html="""
+                <!DOCTYPE html><html lang="en" data-i18n-title="password"><head><meta charset="utf-8">
+                <meta name="viewport" content="width=device-width,initial-scale=1"><title>Password</title>%s
+                <style>body{margin:0;background:var(--ks-bg-base);color:var(--ks-text-primary);font-family:system-ui,sans-serif}
+                main{width:min(360px,calc(100vw - 48px));margin:12vh auto}label{display:block;margin:16px 0}
+                input{box-sizing:border-box;width:100%%;padding:12px;border:1px solid var(--ks-border-default);border-radius:6px;background:var(--ks-bg-input);color:var(--ks-text-primary);font:inherit}
+                button{width:100%%;padding:12px;border:0;border-radius:6px;background:var(--ks-btn-primary-bg-default);color:var(--ks-btn-primary-text);font:inherit}
+                a{display:block;margin-top:24px;color:var(--ks-text-primary)}.error{color:var(--ks-text-error);padding:12px;border:1px solid var(--ks-border-default);border-radius:6px;overflow-wrap:anywhere}
+                input:focus-visible,button:focus-visible,a:focus-visible{outline:3px solid var(--ks-border-focus);outline-offset:3px}</style></head>
+                <body><main><h1 data-i18n="password">Password</h1>%s%s<a href="/oidc/logout" data-i18n="setup.logout">Logout</a>
+                </main><script type="module" src="/ui/assets/oidc-login-i18n.js"></script></body></html>
+                """.formatted(OidcPageTheme.head(),error,fields);
+            return HttpResponse.ok(html).status(status).contentType(MediaType.TEXT_HTML_TYPE).header("Cache-Control","no-store")
+                .header("Content-Security-Policy","default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'");
+    }
+
+    @Post
+    @Consumes(MediaType.APPLICATION_FORM_URLENCODED)
+    public HttpResponse<?> submit(HttpRequest<?> request,@Body Map<String,String> form) {
+        String interaction=interaction(request);String csrf=form.getOrDefault("csrf","");
+        if(!origin.equals(request.getHeaders().get("Origin")) || !OidcPasswordChanges.valid(interaction) || !OidcPasswordChanges.valid(csrf)
+            || !MessageDigest.isEqual(interaction.getBytes(StandardCharsets.UTF_8),csrf.getBytes(StandardCharsets.UTF_8)))
+            return render("","errors.403.title",HttpStatus.FORBIDDEN,false);
+        try {
+            if(!java.util.Objects.equals(form.get("password"),form.get("confirmation")))throw new IllegalArgumentException();
+            changes.complete(interaction,form.get("password"));
+            return HttpResponse.seeOther(URI.create("/oidc/login")).cookie(cookie(request,"",0)).header("Cache-Control","no-store");
+        }catch(IllegalArgumentException failure) {
+            return form(request,"errors.problems.invalid-argument.title",HttpStatus.BAD_REQUEST);
+        }
+        catch(IllegalStateException failure) {return render("","errors.503.content",HttpStatus.SERVICE_UNAVAILABLE,false);}
+    }
+}
